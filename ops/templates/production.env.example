# Copy outside the checkout, chmod 0600, and supply --env-file explicitly.
# This file contains paths/settings only; do not put database URLs or passwords here.
APP_ORIGIN=https://basketball.example.invalid:8443
SCB_HTTPS_PORT=8443
SCB_IMAGE_PREFIX=small-city-basketball
SCB_SECRET_DIR=/srv/scb/secrets
SCB_BACKUP_DIR=/srv/scb/archive
POSTGRES_DB=scb
# Recovery-only directory, pointing to a separate target cluster/control DB.
SCB_RESTORE_SECRET_DIR=/srv/scb/restore-secrets
# C23 remains disabled by default. A later explicit deployment must separately mount
# its private key file into the API and use SCB_PARTICIPANT_DATA_KEY_FILE there.
# Do not put encryption key contents in this file; a path alone does not create a mount.
