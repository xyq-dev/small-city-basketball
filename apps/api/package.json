{
  "name": "@small-city-basketball/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:integration": "vitest run test/",
    "migrate": "tsx src/database/migrate-cli.ts",
    "seed": "tsx src/database/seed-cli.ts"
  },
  "dependencies": {
    "@small-city-basketball/contracts": "0.2.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vitest": "5.0.5",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/express": "5.0.6",
    "supertest": "7.3.1",
    "@types/supertest": "7.2.1"
  }
}
