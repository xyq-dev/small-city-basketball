/* UI001 T17: role filters and compact per-appearance cooperation records. */
.bookings-page { padding:16px 16px calc(24px + env(safe-area-inset-bottom)); color:#18283f; word-break:break-word; }
.booking-view-tabs { display:flex; align-items:flex-start; gap:8px; margin-bottom:12px; }
.booking-view-tabs .booking-view-tab { flex:0 0 80px; width:80px; min-height:44px; margin:0; padding:11px 8px; border-radius:12px; background:#fff; color:#63758b; font-size:14px; line-height:22px; font-weight:500; }
.booking-view-tab::after { border:0; }
.booking-view-tabs .booking-view-tab.active { color:#fff; background:#123c73; }
.booking-view-tabs .filter-toggle { width:64px; flex-basis:64px; }
.booking-view-tabs .filter-active { color:#123c73; background:#eaf0f7; }
.status-rail { width:100%; margin-bottom:12px; }
.status-tabs { display:flex; align-items:center; gap:8px; width:312px; min-width:100%; }
.status-tab,.status-more { display:flex; align-items:center; justify-content:center; flex:0 0 56px; width:56px; min-height:44px; padding:10px 0; margin:0; border-radius:12px; background:#fff; color:#63758b; font-size:14px; line-height:24px; }
.status-tab::after { border:0; }
.status-tab.selected { color:#123c73; background:#eaf0f7; }
.status-more { gap:4px; }
.active-filter { margin:0 0 12px; }
.booking-progress-card { padding:16px; margin-bottom:12px; border-radius:16px; }
.progress-heading { margin-bottom:8px; color:#18283f; font-size:18px; line-height:28px; font-weight:700; }
.cooperation-record + .cooperation-record { margin-top:8px; }
.cooperation-cell { display:flex; align-items:stretch; min-height:58px; }
.cooperation-main { display:flex; align-items:center; gap:12px; flex:1; min-width:0; width:auto; min-height:58px; padding:8px 0; margin:0; border-radius:0; background:#fff; text-align:left; font-weight:400; }
.cooperation-main::after,.cooperation-expand::after { border:0; }
.cooperation-icon { flex:0 0 22px; width:22px; height:22px; }
.cooperation-copy { flex:1; min-width:0; }
.cooperation-title { color:#18283f; font-size:14px; line-height:22px; font-weight:500; overflow-wrap:anywhere; }
.cooperation-subtitle { margin-top:2px; color:#63758b; font-size:12px; line-height:18px; font-weight:400; overflow-wrap:anywhere; }
.cooperation-expand { display:flex; align-items:center; justify-content:center; flex:0 0 44px; width:44px; min-width:44px; min-height:58px; padding:0; margin:0 -14px 0 0; border-radius:0; background:#fff; }
.cooperation-chevron { width:16px; height:16px; }
.cooperation-chevron.expanded { transform:rotate(90deg); }
.cooperation-details { padding:12px; margin-top:8px; border-radius:12px; background:#f4f6fa; }
.cooperation-details > view + view { margin-top:8px; }
.cooperation-details button { margin:12px 0 0; }
.money-atom { display:inline-block; white-space:nowrap; overflow-wrap:normal; word-break:normal; }
.appearance-status { color:#123c73; font-size:14px; line-height:24px; font-weight:500; }
.appearance-status.warning { color:#895500; background:transparent; }
.appearance-status.danger { color:#b53333; }
.appearance-status.success { color:#16734b; }
.appearance-status.neutral { color:#63758b; }
.role-notice { display:flex; flex-direction:column; gap:4px; }
.notice-title,.state-title { font-size:16px; line-height:24px; font-weight:500; }
.state-card { display:flex; flex-direction:column; gap:8px; }
.state-card .subtitle { margin:0; }
.state-card button { margin:8px 0 0; }
.skeleton { height:12px; width:88%; background:#eaf0f7; border-radius:6px; margin:6px 0; }
.skeleton.short { width:56%; }
.time-caption { margin:4px 0 12px; color:#63758b; font-size:12px; line-height:20px; }
.booking-tools { display:flex; gap:8px; margin-top:16px; }
.booking-tools button { flex:1; width:0; margin:0; min-height:44px; padding:10px 8px; font-size:14px; line-height:24px; }
