@import "../../styles/figma-pages.wxss";

.booking-tabs { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1px; width:100%; height:48px; padding:2px 3px; border-radius:12px; background:#fff; }
.booking-tab { display:flex; height:44px; align-items:center; justify-content:center; border-radius:10px; color:#51657d; font-size:13px; }
.booking-tab.is-active { background:#123c73; color:#fff; font-weight:700; }
.bookings-rebuild .booking-tabs>button.booking-tab { width:100%; min-width:0; max-width:none; height:44px; min-height:44px; margin:0; padding:0 4px; border:0; justify-self:stretch; box-sizing:border-box; background:transparent; }
.bookings-rebuild .booking-tabs>button.booking-tab.is-active { background:#123c73; color:#fff; }
.filter-toggle { display:flex; width:100%; min-height:55px; align-items:center; justify-content:space-between; gap:8px; padding:0 14px; border-radius:14px !important; background:#fff !important; }
.filter-panel { padding:8px; border-radius:12px; background:#fff; }
.status-scroll { width:100%; white-space:nowrap; }
.status-tabs { display:flex; gap:8px; }
.status-tab { display:flex; min-width:72px; height:44px; align-items:center; justify-content:center; padding:0 12px; border-radius:10px; background:#f4f6fa; color:#51657d; font-size:12px; }
.status-tab.is-active { background:#123c73; color:#fff; }
.booking-item { border-bottom:1px solid #e6ebf2; }
.booking-item:last-child { border-bottom:0; }
.booking-item__row { display:flex; align-items:center; gap:6px; }
.booking-item__main { min-width:0; flex:1; }
.bookings-rebuild .booking-item__row>button.booking-item__main { width:auto; min-width:0; max-width:none; margin:0; flex:1 1 0; box-sizing:border-box; }
.booking-item__toggle { display:flex; min-width:64px; min-height:44px; flex:none; align-items:center; justify-content:center; padding:0 10px; border-radius:999px; background:#fff1e2; color:#123c73; font-size:12px; }
.bookings-rebuild .booking-item__row>button.booking-item__toggle { width:auto; max-width:none; margin:0; box-sizing:border-box; }
.booking-item__toggle.is-green { background:#e3f5e9; color:#257347; }
.booking-item__detail { display:flex; flex-direction:column; gap:6px; padding:0 0 12px; }
.item-actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
.item-actions button { display:flex; min-height:44px; align-items:center; justify-content:center; border-radius:12px; background:#f4f6fa; color:#123c73; font-size:12px; text-align:center; }
.step-row { display:flex; min-height:55px; align-items:center; gap:8px; }
.step-index { display:flex; width:20px; height:20px; flex:none; align-items:center; justify-content:center; border-radius:50%; background:#eaf2fc; color:#123c73; font-size:11px; }
