<view class="page has-actions">
  <view class="hero">
    <view class="title">每位球员，每一场都清楚</view>
    <view>查看当前身份有权处理的合作记录</view>
  </view>
  <view class="tabs booking-tabs">
    <button class="chip {{view === 'sent' ? 'active' : ''}}" data-view="sent" bindtap="changeView">我方发出</button>
    <button class="chip {{view === 'received' ? 'active' : ''}}" data-view="received" bindtap="changeView">本人收到</button>
  </view>
  <picker mode="selector" range="{{statusLabels}}" value="{{statusIndex}}" bindchange="changeStatus">
    <view class="field row-between"><text>筛选状态</text><text>{{statusLabels[statusIndex]}}　⌄</text></view>
  </picker>
  <view wx:if="{{error}}" class="notice danger">{{error}}</view>
  <view wx:if="{{loginRequired}}" class="card empty">
    <view class="subtitle">登录后查看本人合作</view>
    <view class="muted">不显示其他账号或合成预约作为替代。</view>
    <button class="primary" bindtap="login">登录并返回预约</button>
  </view>
  <view wx:elif="{{loading}}" class="card empty">正在读取最新预约…</view>
  <view wx:elif="{{!rows.length}}" class="card empty">
    <view class="subtitle">暂无符合条件的合作记录</view>
    <view class="muted">可切换发出/收到或调整状态筛选。</view>
  </view>
  <view wx:for="{{rows}}" wx:key="id" class="card order-card">
    <view class="row-between"><view class="subtitle">{{item.eventName}}</view><text class="badge">{{item.statusText}}</text></view>
    <view class="muted">{{item.teamName}} · {{item.scopeText}}</view>
    <view class="small">{{item.playerCount}}位球员 · {{item.confirmedCount}}项确定安排 / {{item.conditionalCount}}项意向</view>
    <view class="order-summary">
      <view wx:for="{{item.appearances}}" wx:for-item="appearance" wx:key="id" class="row">
        <view class="row-between"><text>{{appearance.playerName}} · {{appearance.label}}</text><text class="badge {{appearance.tone}}">{{appearance.statusText}}</text></view>
        <view class="small muted">{{appearance.startText}}</view>
      </view>
    </view>
    <view class="money">确定报价 {{item.confirmedText}}</view>
    <view class="small muted">条件预计 {{item.conditionalText}} · 实收 {{item.paidText}}</view>
    <button class="secondary" data-id="{{item.id}}" bindtap="detail">查看合作与逐场操作</button>
  </view>
  <view wx:if="{{hasMore}}" class="notice warning">这里只显示最新100份可见预约，更早记录未计入当前列表；可用已知订单入口读取具体合作。</view>
  <view wx:if="{{paymentNotice}}" class="notice">{{paymentNotice}}</view>
  <view class="action-bar">
    <button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="load">刷新预约状态</button>
    <button class="quiet" bindtap="players">继续找球员</button>
  </view>
</view>
