<scb-header title="我的预约" disabled="{{loading}}"/>
<view class="scb-ui-page figma-page bookings-rebuild">
  <view class="figma-page__content figma-page__content--actions">
    <view class="figma-summary"><view class="figma-summary__icon"><figma-icon name="booking" size="28"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">本人合作</view><view class="figma-title">我的预约</view><view class="figma-subtitle">每位球员、每场安排分别确认并跟进。</view></view></view>

    <view class="booking-tabs" role="tablist"><button class="booking-tab {{view === 'sent' ? 'is-active' : ''}}" data-view="sent" bindtap="changeView" disabled="{{loading}}">我发出的</button><button class="booking-tab {{view === 'received' ? 'is-active' : ''}}" data-view="received" bindtap="changeView" disabled="{{loading}}">我收到的</button></view>

    <figma-skeleton wx:if="{{loading}}" rows="4"/>
    <figma-feedback wx:if="{{error}}" type="error" title="预约读取失败" body="{{error}}；保留当前筛选，可刷新后重试。" action-label="重新读取" bind:action="load"/>
    <figma-feedback wx:if="{{loginRequired}}" type="permission" title="登录后查看本人合作" body="当前身份核对后，才可读取有权查看的预约。" action-label="登录并返回" bind:action="login"/>
    <figma-feedback wx:if="{{!loading && !rows.length && !error && !loginRequired}}" type="empty" title="暂无符合条件的合作记录" body="可切换发出/收到或调整状态筛选。"/>

    <view wx:if="{{rows.length}}" class="figma-section">
      <view class="figma-section__title">当前合作</view>
      <block wx:for="{{rows}}" wx:for-item="order" wx:key="id">
        <view wx:for="{{order.appearances}}" wx:for-item="appearance" wx:key="id" class="booking-item">
          <view class="booking-item__row">
            <button class="figma-row booking-item__main" data-id="{{order.id}}" bindtap="detail" disabled="{{loading}}"><view class="figma-row__copy"><view class="figma-row__title">{{order.teamName}} × {{appearance.playerName}}</view><view class="figma-row__subtitle">{{appearance.summaryStartText || appearance.startText}} · {{appearance.venue}}</view></view></button>
            <button class="booking-item__toggle {{appearance.status === 'ACCEPTED' || appearance.status === 'COMPLETED' ? 'is-green' : ''}}" data-id="{{appearance.id}}" bindtap="toggleInfo" disabled="{{loading}}">{{appearance.statusText}}</button>
          </view>
          <view wx:if="{{expandedAppearanceId === appearance.id}}" class="booking-item__detail">
            <view class="figma-caption">{{order.eventName}} · {{appearance.label}} · {{order.scopeText}}</view>
            <view class="figma-caption">{{appearance.scheduleText || appearance.startText + ' — ' + appearance.endText}} · 报到 {{appearance.reportText}}</view>
            <view class="figma-caption">本项{{appearance.status === 'CONDITIONAL' ? '条件预计' : '报价'}} {{appearance.totalText}} · 总单确定报价 {{order.confirmedText}} · 实收 {{order.paidText}}</view>
            <view wx:if="{{appearance.conditionText}}" class="figma-caption">条件：{{appearance.conditionText}}</view>
            <view class="item-actions"><button data-id="{{appearance.id}}" bindtap="trade">查看本场资金订单</button><button data-id="{{order.id}}" bindtap="detail">查看完整合作</button></view>
          </view>
        </view>
      </block>
    </view>

    <view wx:if="{{rows.length}}" class="figma-section">
      <view class="figma-section__title">报价与资金</view>
      <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">确定场次</view><view class="figma-row__subtitle">{{rows[0].confirmedSummary || '逐人逐场的确定报价'}}</view></view><view class="figma-status figma-status--orange">{{rows[0].confirmedText || '逐项核对'}}</view></view>
      <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">条件意向</view><view class="figma-row__subtitle">尚未确定，不占档期</view></view><view class="figma-status">{{rows[0].conditionalCount ? rows[0].conditionalText : '暂无'}}</view></view>
      <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">本场资金</view><view class="figma-row__subtitle">{{paymentNotice || '到原资金订单核对'}}</view></view><view class="figma-status">查看</view></view>
    </view>

    <view wx:if="{{rows.length}}" class="figma-section"><view class="figma-section__title">合作进度</view><view class="step-row"><view class="step-index">1</view><view class="figma-row__copy"><view class="figma-row__title">接单确认</view><view class="figma-row__subtitle">球员逐人逐场处理</view></view><view class="figma-status figma-status--orange">进行中</view></view><view class="step-row"><view class="step-index">2</view><view class="figma-row__copy"><view class="figma-row__title">到场与履约</view><view class="figma-row__subtitle">接单后核对本场安排</view></view><view class="figma-status">待办理</view></view></view>
    <button class="filter-toggle" bindtap="toggleFilters" disabled="{{loading}}"><view><view class="figma-row__title">更多筛选</view><view class="figma-row__subtitle">{{statusLabels[statusIndex]}}</view></view><view class="figma-status">{{filtersOpen ? '收起' : '展开'}}</view></button>
    <view wx:if="{{filtersOpen || statusIndex > 0}}" class="filter-panel"><scroll-view scroll-x="true" enable-flex="true" class="status-scroll"><view class="status-tabs"><button wx:for="{{quickStatuses}}" wx:key="value" class="status-tab {{status === item.value ? 'is-active' : ''}}" data-index="{{item.index}}" bindtap="statusTab" disabled="{{loading}}">{{item.label}}</button><picker mode="selector" range="{{statusLabels}}" value="{{statusIndex}}" bindchange="changeStatus" disabled="{{loading}}"><view class="status-tab">更多</view></picker></view></scroll-view></view>
    <figma-feedback wx:if="{{view === 'received'}}" type="info" title="以本人球员身份处理" body="只能接受或拒绝自己的逐场安排，不代其他球员确认。"/>
    <figma-feedback wx:if="{{hasMore}}" type="info" title="当前列表只显示最新 100 份" body="更早记录未计入当前列表，可用已知订单入口读取具体合作。"/>
  </view>

  <view class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="players" disabled="{{loading}}">继续找球员</button><button class="figma-action figma-action--orange" data-id="{{rows[0].id}}" bindtap="detail" disabled="{{loading || !rows.length}}">查看本场合作</button></view>
</view>
