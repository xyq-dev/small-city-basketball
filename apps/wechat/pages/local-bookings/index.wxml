<scb-header title="同城服务预约" disabled="{{busy}}"/>
<view class="page local-private"><view class="title">我的预约与服务订单</view><view class="muted">显示当前身份最近200项。收费来源的资金状态在独立订单查询；锁位与接单以服务器状态为准；设备时间不能延长锁位期限。</view><button wx:if="{{loginRequired}}" bindtap="login">登录</button><view class="local-actions"><button bindtap="find">找球场与人员</button><button bindtap="matchups">球队约赛</button><button bindtap="load" disabled="{{busy || loading}}">刷新</button></view>
 <view wx:if="{{pending || pendingError}}" class="notice warning"><view>{{pendingError || '上次操作结果待核对，请保留原请求编号。'}}</view><input wx:if="{{pending.body.type==='REDEEM_CHECKIN'}}" class="field" data-field="checkinInput" value="{{checkinInput}}" bindinput="input" placeholder="如需重试，请重新输入同一个核销码；也可先查询回执" maxlength="40" disabled="{{busy}}"/><button bindtap="recover" disabled="{{busy}}">查询原操作回执</button><button wx:if="{{pending}}" bindtap="retry" disabled="{{busy}}">重试原操作</button></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view><view wx:if="{{loading}}">读取中…</view>
 <button wx:for="{{items}}" wx:key="id" class="card listing" data-id="{{item.id}}" bindtap="select" disabled="{{busy}}"><view class="subtitle">{{item.title}}</view><view>{{item.kindText}} · {{item.roleText}} · {{item.statusText}}</view><view>{{item.timeText}}</view><view class="muted">{{item.address}}</view><view wx:if="{{item.holdText && (item.status==='HELD' || item.status==='REQUESTED')}}" class="warning">请在{{item.holdText}}前完成确认或接单</view></button><view wx:if="{{!loading && !items.length}}" class="card muted">暂无当前可访问的订单。</view>
 <view wx:if="{{selected}}" class="card"><view class="subtitle">{{selected.title}}</view><view>{{selected.statusText}} · {{selected.timeText}}</view><button bindtap="trade" disabled="{{busy}}">核对本预约付款、退款与结算</button><view>{{selected.address}}</view><button wx:if="{{selected.location}}" bindtap="navigate">导航到本次服务地址</button><view class="section-title">下单时合作约定</view><view>{{selected.terms}}</view><view wx:if="{{selected.reason}}" class="muted">最近操作说明：{{selected.reason}}</view><block wx:if="{{selected.canIssueCheckin}}"><button bindtap="issueCheckin" disabled="{{busy || pending || pendingError}}">现场生成或换发一次性核销码</button><view wx:if="{{checkinDisplay}}" class="notice"><view>请当面向实际经营方出示：</view><view class="numeric checkin-code">{{checkinDisplay.code}}</view><view>有效至{{checkinDisplay.expiresText}}，一次有效，离开本页即清除。</view><button bindtap="copyCheckin">复制本次核销码</button></view></block><view wx:if="{{selected.kind==='COURT' && selected.canActAs==='PROVIDER' && selected.status==='CONFIRMED'}}"><input class="field" data-field="checkinInput" value="{{checkinInput}}" bindinput="input" placeholder="请粘贴需求方现场出示的本次核销码" maxlength="40" disabled="{{busy}}"/><view class="muted">只有实际经营方持当前有效码才能核销，不能用自行声明代替球场到场核销。码不会保存到本机。</view></view><view wx:if="{{selected.change}}" class="notice"><view>待双方确认的改期：{{selected.change.timeText}} · {{selected.change.reason}}</view><view class="muted">确认前保留原档期。确认时重新核对供给资格、覆盖和跨业务时段冲突。</view><block wx:if="{{selected.canRespondChange}}"><button data-type="ACCEPT_CHANGE" bindtap="command" disabled="{{busy || pending || pendingError}}">同意对方改期</button><button data-type="REJECT_CHANGE" bindtap="command" disabled="{{busy || pending || pendingError}}">拒绝对方改期</button></block></view><textarea class="field" value="{{reason}}" bindinput="input" placeholder="请写明真实履约事实、取消或改期原因（至少4字）" maxlength="500" disabled="{{busy}}"/><button wx:for="{{selected.actions}}" wx:key="type" data-type="{{item.type}}" bindtap="command" disabled="{{busy || pending || pendingError}}">{{item.label}}</button><block wx:if="{{selected.canChange && !selected.change}}"><button bindtap="choices" disabled="{{busy}}">查看可改期档期</button><button wx:for="{{changeSlots}}" wx:key="id" class="{{newSlotId===item.id?'picked':''}}" data-id="{{item.id}}" bindtap="chooseSlot" disabled="{{busy}}">{{item.timeText}}</button><button wx:if="{{newSlotId}}" data-type="PROPOSE_CHANGE" bindtap="command" disabled="{{busy || pending || pendingError}}">向另一方提出此改期</button></block><block wx:if="{{selected.canActAs!=='ADMIN'}}"><button data-kind="case" bindtap="governance" disabled="{{busy}}">反馈此订单或发起工单</button><button wx:if="{{selected.status==='COMPLETED'}}" data-kind="review" bindtap="governance" disabled="{{busy}}">评价本次已完成服务</button></block><view class="muted">球场须经营方凭需求方一次性码核销到场；人员本人声明到场。服务方登记交付，需求方确认完成。管理人员不能代替双方伪造履约；发生争议可保留订单并联系处理人员。天气取消由供给管理关闭相关档期。</view></view>
</view><scb-nav active="Local" disabled="{{busy}}"/>
