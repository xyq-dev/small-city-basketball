<scb-header title="同城服务订单" disabled="{{busy}}"/>
<view class="scb-ui-page figma-page local-private booking-workspace">
  <view class="figma-page__content">
    <view class="figma-summary"><view class="figma-summary__icon"><figma-icon name="booking" size="24"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">本人预约与履约</view><view class="figma-title">同城服务订单</view><view class="figma-subtitle">当前场地时段、履约进度和资金分别核对。</view></view></view>
    <figma-feedback wx:if="{{loginRequired}}" type="locked" title="登录后查看本人订单" body="买方与服务方权限分别由服务器返回。" action-label="登录" bind:action="login"/>
    <figma-feedback wx:if="{{pending || pendingError}}" type="warning" title="原操作结果待核对" body="{{pendingError || '请保留原请求编号，避免重复预约或核销。'}}" action-label="查询回执" bind:action="recover"/>
    <view wx:if="{{pending}}" class="pending-retry"><view wx:if="{{pending.body.type==='REDEEM_CHECKIN'}}" class="figma-field-group"><view class="figma-field-label">原核销码</view><input class="figma-field-control" data-field="checkinInput" value="{{checkinInput}}" bindinput="input" placeholder="如需重试，请重新输入同一码" maxlength="40" disabled="{{busy}}"/></view><button class="figma-action figma-action--ghost" bindtap="retry" disabled="{{busy}}">使用原请求编号重试</button></view>
    <figma-feedback wx:if="{{error}}" type="error" title="订单读取失败" body="{{error}}" action-label="重新读取" bind:action="load"/>
    <figma-feedback wx:if="{{message}}" type="success" title="最新结果" body="{{message}}"/>
    <figma-skeleton wx:if="{{loading}}" rows="4"/>

    <block wx:if="{{!selected}}">
      <view class="order-tabs" role="tablist"><button class="order-tab {{orderFilter==='ALL' ? 'is-active' : ''}}" data-key="ALL" bindtap="filterOrders" disabled="{{busy || loading}}">全部</button><button class="order-tab {{orderFilter==='BUYER' ? 'is-active' : ''}}" data-key="BUYER" bindtap="filterOrders" disabled="{{busy || loading}}">我预约的</button><button class="order-tab {{orderFilter==='PROVIDER' ? 'is-active' : ''}}" data-key="PROVIDER" bindtap="filterOrders" disabled="{{busy || loading}}">我提供的</button></view>
      <view class="figma-section">
        <view class="figma-section__title">预约列表</view>
        <block wx:for="{{items}}" wx:key="id"><button wx:if="{{orderFilter==='ALL' || item.canActAs===orderFilter}}" class="figma-row order-row" data-id="{{item.id}}" bindtap="select" disabled="{{busy}}"><view class="figma-row__copy"><view class="figma-row__title">{{item.title}}</view><view class="figma-row__subtitle">{{item.timeText}} · {{item.address}}</view><view wx:if="{{item.holdText && (item.status==='HELD' || item.status==='REQUESTED')}}" class="hold-copy">请在 {{item.holdText}} 前确认</view></view><view><view class="figma-status {{item.status==='COMPLETED' ? '' : 'figma-status--orange'}}">{{item.statusText}}</view><view class="role-copy">{{item.roleText}}</view></view></button></block>
        <figma-feedback wx:if="{{!loading && !items.length}}" type="empty" title="暂无当前可访问订单" body="从同城页选择真实供给与档期后发起预约。"/>
        <figma-feedback wx:if="{{!loading && items.length && orderFilter!=='ALL' && !filteredCount}}" type="empty" title="本分类暂无订单" body="可切换“全部”核对历史记录。"/>
      </view>
      <view wx:if="{{items.length && (orderFilter==='ALL' || items[0].canActAs===orderFilter)}}" class="figma-section"><view class="figma-section__title">本次服务</view><view class="figma-row"><figma-icon name="court-location" size="20"/><view class="figma-row__copy"><view class="figma-row__title">{{items[0].serviceLabel || '地点'}}</view><view class="figma-row__subtitle">{{items[0].serviceValue || items[0].address}}</view></view><view class="figma-status figma-status--orange">{{items[0].serviceActionLabel || '查看地址'}}</view></view><view class="figma-row"><figma-icon name="schedule" size="20"/><view class="figma-row__copy"><view class="figma-row__title">时段</view><view class="figma-row__subtitle">{{items[0].timeText}}</view></view></view></view>
      <view wx:if="{{items.length && (orderFilter==='ALL' || items[0].canActAs===orderFilter)}}" class="figma-section status-banner progress-section"><view class="figma-section__title">履约与资金</view><view class="flow-row"><view class="flow-index">1</view><view class="figma-row__copy"><view class="figma-row__title">到场进度</view><view class="figma-row__subtitle">按当前订单状态核对</view></view><view class="figma-status">{{items[0].statusText || '待核对'}}</view></view><view class="flow-row"><view class="flow-index">2</view><view class="figma-row__copy"><view class="figma-row__title">交付与确认</view><view class="figma-row__subtitle">以当前履约状态为准</view></view><view class="figma-status">{{items[0].statusText || '待核对'}}</view></view><view class="flow-row"><view class="flow-index">3</view><view class="figma-row__copy"><view class="figma-row__title">付款与退款</view><view class="figma-row__subtitle">由原资金订单返回结果</view></view><view class="figma-status figma-status--orange">可查询</view></view></view>
      <button class="figma-row supplemental-link" bindtap="matchups"><view class="figma-row__copy"><view class="figma-row__title">球队约赛</view><view class="figma-row__subtitle">继续查看与本场相关的球队约赛</view></view><view class="figma-status">进入</view></button>
    </block>

    <view wx:if="{{selected}}" class="figma-section order-detail">
      <view class="section-heading"><view><view class="figma-eyebrow">{{selected.kindText}} · {{selected.roleText}}</view><view class="figma-section__title">{{selected.title}}</view></view><button class="section-link" bindtap="closeBooking" disabled="{{busy}}">返回</button></view>
      <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{selected.timeText}}</view><view class="figma-row__subtitle">{{selected.address}}</view></view><view class="figma-status figma-status--orange">{{selected.statusText}}</view></view>
      <view class="detail-tabs"><button class="detail-tab {{serviceTab==='overview' ? 'is-active' : ''}}" data-key="overview" bindtap="serviceTab" disabled="{{busy}}">预约信息</button><button class="detail-tab {{serviceTab==='actions' ? 'is-active' : ''}}" data-key="actions" bindtap="serviceTab" disabled="{{busy}}">履约与改期</button></view>
      <block wx:if="{{serviceTab==='overview'}}"><view class="detail-grid"><view><view class="figma-field-label">当前身份</view><view>{{selected.roleText}}</view></view><view><view class="figma-field-label">当前状态</view><view>{{selected.statusText}}</view></view></view><view class="figma-field-label">下单时合作约定</view><view class="terms-copy">{{selected.terms}}</view><view wx:if="{{selected.reason}}" class="figma-info">最近操作：{{selected.reason}}</view><button wx:if="{{selected.location}}" class="figma-action figma-action--ghost" bindtap="navigate">导航到服务地址</button><button class="figma-action figma-action--ghost" bindtap="trade" disabled="{{busy}}">核对付款、退款与结算</button></block>
      <block wx:if="{{serviceTab==='actions'}}">
        <view wx:if="{{selected.canIssueCheckin}}" class="checkin-panel"><view class="figma-row__title">现场核销码</view><view class="figma-caption">仅在服务时段临近现场生成；换发会立即作废旧码。</view><button class="figma-action figma-action--orange" bindtap="issueCheckin" disabled="{{busy || pending || pendingError}}">生成或换发一次性核销码</button><view wx:if="{{checkinDisplay}}" class="checkin-code"><view class="figma-field-label">请当面出示</view><view class="code-value">{{checkinDisplay.code}}</view><view class="figma-caption">有效至 {{checkinDisplay.expiresText}}，离开本页即清除。</view><button class="figma-action figma-action--ghost" bindtap="copyCheckin">复制本次核销码</button></view></view>
        <view wx:if="{{selected.kind==='COURT' && selected.canActAs==='PROVIDER' && selected.status==='CONFIRMED'}}" class="figma-field-group"><view class="figma-field-label">需求方现场核销码</view><input class="figma-field-control" data-field="checkinInput" value="{{checkinInput}}" bindinput="input" placeholder="粘贴需求方本次出示的有效码" maxlength="40" disabled="{{busy}}"/><view class="figma-caption">仅实际经营方可核销，码不会保存到本机。</view></view>
        <view wx:if="{{selected.change}}" class="figma-info"><view class="figma-row__title">待双方确认的改期</view><view>{{selected.change.timeText}}</view><view class="figma-caption">{{selected.change.reason}}。确认前保留原档期。</view><view wx:if="{{selected.canRespondChange}}" class="inline-actions"><button class="figma-action figma-action--orange" data-type="ACCEPT_CHANGE" bindtap="command" disabled="{{busy || pending || pendingError}}">同意改期</button><button class="figma-action figma-action--ghost" data-type="REJECT_CHANGE" bindtap="command" disabled="{{busy || pending || pendingError}}">拒绝</button></view></view>
        <view class="figma-field-group"><view class="figma-field-label">履约、取消或改期说明</view><textarea class="figma-field-control" data-field="reason" value="{{reason}}" bindinput="input" placeholder="请写明真实事实（至少4字）" maxlength="500" disabled="{{busy}}"/></view>
        <view class="action-stack"><button wx:for="{{selected.actions}}" wx:key="type" class="figma-action {{index===0 ? 'figma-action--orange' : 'figma-action--ghost'}}" data-type="{{item.type}}" bindtap="command" disabled="{{busy || pending || pendingError}}">{{item.label}}</button></view>
        <view wx:if="{{selected.canChange && !selected.change}}" class="change-panel"><button class="figma-action figma-action--ghost" bindtap="choices" disabled="{{busy}}">查看可改期档期</button><button wx:for="{{changeSlots}}" wx:key="id" class="slot-choice {{newSlotId===item.id ? 'is-selected' : ''}}" data-id="{{item.id}}" bindtap="chooseSlot" disabled="{{busy}}">{{item.timeText}}</button><button wx:if="{{newSlotId}}" class="figma-action figma-action--orange" data-type="PROPOSE_CHANGE" bindtap="command" disabled="{{busy || pending || pendingError}}">向另一方提出此改期</button></view>
        <view wx:if="{{selected.canActAs!=='ADMIN'}}" class="inline-actions"><button class="figma-action figma-action--ghost" data-kind="case" bindtap="governance" disabled="{{busy}}">反馈订单</button><button wx:if="{{selected.status==='COMPLETED'}}" class="figma-action figma-action--ghost" data-kind="review" bindtap="governance" disabled="{{busy}}">评价服务</button></view>
      </block>
    </view>
  </view>
  <view wx:if="{{!selected}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="find">找球场与人员</button><button class="figma-action figma-action--orange" bindtap="openCurrent" disabled="{{busy || loading || !filteredCount}}">查看预约详情</button></view>
</view>
