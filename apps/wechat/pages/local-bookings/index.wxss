.local-private{padding-bottom:calc(100px + env(safe-area-inset-bottom));word-break:break-word}.local-actions{display:flex;gap:8px;flex-wrap:wrap}.local-actions button{flex:1;min-width:95px;min-height:48px;white-space:normal;font-size:14px;line-height:22px}.listing{text-align:left;width:100%;border-radius:16px;padding:16px}.check{display:block;margin:12px 0;min-height:44px}.slot-row{border-top:1px solid #e1e7ef;padding-top:12px;margin-top:12px}.local-private .field{min-height:48px;font-size:16px;line-height:24px;box-sizing:border-box}.local-private .card{border-radius:16px}.local-private .workflow-tabs{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0}.local-private .workflow-tabs button{flex:1;min-width:95px;min-height:48px;background:#eaf0f8;color:#123c73;font-size:14px;line-height:22px;padding:12px;white-space:normal}.local-private .workflow-tabs .active{background:#123c73;color:#fff}.local-private .status-banner{background:#eaf0f8;color:#123c73;padding:12px;border-radius:12px;font-size:14px;line-height:22px;margin:12px 0}.checkin-code{word-break:break-all;font-size:17px;letter-spacing:1px;padding:12px 0}
