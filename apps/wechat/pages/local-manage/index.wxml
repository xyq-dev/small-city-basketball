<scb-header title="供给与档期管理" disabled="{{busy}}"/>
<view class="scb-ui-page figma-page local-private manage-page">
  <view class="figma-page__content figma-page__content--actions">
    <view class="figma-summary manage-summary">
      <view class="figma-summary__icon"><figma-icon name="court" size="24"/></view>
      <view class="figma-summary__copy"><view class="figma-eyebrow">服务方工作台</view><view class="figma-title">供给与档期管理</view><view class="figma-subtitle">先确认实际服务者和覆盖范围，再提交独立审核。</view></view>
    </view>

    <figma-feedback wx:if="{{loginRequired}}" type="locked" title="登录后管理供给" body="仅展示当前账号获授权的服务与机构。" action-label="登录" bind:action="login"/>
    <figma-feedback wx:if="{{pending || pendingError}}" type="warning" title="原操作结果待核对" body="{{pendingError || '请先查询原操作回执，避免重复提交。'}}" action-label="查询回执" bind:action="recover"/>
    <button wx:if="{{pending}}" class="figma-action figma-action--ghost" bindtap="retry" disabled="{{busy}}">使用原请求编号重试</button>
    <figma-feedback wx:if="{{error}}" type="error" title="供给读取失败" body="{{error}}" action-label="重新读取" bind:action="load"/>
    <figma-feedback wx:if="{{message}}" type="success" title="操作已受理" body="{{message}}"/>
    <figma-skeleton wx:if="{{loading}}" rows="4"/>

    <view class="manage-tabs" role="tablist"><view class="manage-tab is-active">我的供给</view><view class="manage-tab">待审</view><view class="manage-tab">档期</view></view>

    <block wx:if="{{!selected && !creating && !editing && !loading}}">
      <view class="figma-section">
        <view class="figma-section__title">供给资料</view>
        <button wx:for="{{listings}}" wx:key="id" class="figma-row" data-id="{{item.id}}" bindtap="select" disabled="{{busy}}"><view class="figma-row__copy"><view class="figma-row__title">{{item.title}}</view><view class="figma-row__subtitle">{{item.kindText}} · {{item.address}}</view></view><view class="figma-status {{item.published ? 'figma-status--orange' : ''}}">{{item.statusText}}</view></button>
        <figma-feedback wx:if="{{!listings.length}}" type="empty" title="暂无可管理供给" body="实际服务人员可确认本人供给；机构管理员可新增待审申请。"/>
      </view>
      <view class="figma-section">
        <view class="figma-section__title">开放档期</view>
        <view wx:for="{{overviewSlots}}" wx:key="id" class="figma-row"><figma-icon name="schedule" size="20"/><view class="figma-row__copy"><view class="figma-row__title">{{item.timeText}}</view><view class="figma-row__subtitle">{{item.statusText}}</view></view><view class="figma-status {{item.available ? 'figma-status--orange' : ''}}">{{item.availabilityLabel || (item.available ? '开放' : '待开放')}}</view></view>
        <view wx:if="{{!overviewSlots.length}}" class="figma-caption">选择供给后可查看和维护实际开放档期。</view>
      </view>
      <view class="figma-section status-banner">
        <view class="figma-section__title">上架核验</view>
        <view class="flow-row"><view class="flow-step is-active">1</view><view class="figma-row__copy"><view class="figma-row__title">核对服务主体与地点</view><view class="figma-caption">服务者确认具体供给</view></view><view class="figma-status figma-status--orange">{{listings[0].providerConfirmed ? '已提交' : '待提交'}}</view></view>
        <view class="flow-row"><view class="flow-step">2</view><view class="figma-row__copy"><view class="figma-row__title">独立审核</view><view class="figma-caption">核验经营范围及所需资质</view></view><view class="figma-status">{{listings[0].reviewStatusText || listings[0].statusText || '待核验'}}</view></view>
        <view class="flow-row"><view class="flow-step">3</view><view class="figma-row__copy"><view class="figma-row__title">公开并添加档期</view><view class="figma-caption">审核和发布分别办理</view></view><view class="figma-status">{{listings[0].publishStatusText || (listings[0].published ? '已发布' : '未发布')}}</view></view>
      </view>
      <view wx:if="{{organizations.length > 1}}" class="figma-field-group"><view class="figma-field-label">当前工作身份</view><picker class="figma-field-control" range="{{organizations}}" range-key="name" value="{{orgIndex}}" bindchange="org" disabled="{{busy || pending}}">{{organizations[orgIndex].name}}</picker></view>
    </block>

    <view wx:if="{{selected && !editing}}" class="figma-section detail-section">
      <view class="section-heading"><view><view class="figma-eyebrow">供给详情</view><view class="figma-section__title">{{selected.listing.title}}</view></view><button class="section-link" bindtap="closeSupply" disabled="{{busy}}">返回列表</button></view>
      <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{selected.listing.kindText}} · {{selected.listing.statusText}}</view><view class="figma-row__subtitle">{{selected.listing.address}}</view></view><view class="figma-status {{selected.listing.published ? 'figma-status--orange' : ''}}">{{selected.listing.published ? '已公开' : '未公开'}}</view></view>
      <view class="figma-caption">{{selected.listing.description}}</view>
      <view class="figma-info"><view class="figma-field-label">申请人核验清单</view><view>{{selected.listing.qualificationNote}}</view><view wx:if="{{selected.listing.reviewReason}}">审核说明：{{selected.listing.reviewReason}}</view><view>{{selected.listing.qualificationText}}</view></view>
      <view class="figma-field-label">合作约定</view><view class="figma-caption terms-copy">{{selected.terms}}</view>
      <view class="figma-field-group"><view class="figma-field-label">本次操作说明</view><textarea class="figma-field-control" data-field="reason" value="{{reason}}" bindinput="input" placeholder="审核、发布或天气取消的真实说明（至少4字）" maxlength="500" disabled="{{busy}}"/></view>
      <view wx:if="{{selected.capabilities.canReview && selected.listing.status==='PENDING'}}" class="figma-info">项目标签不等于认证；医务服务须核实执业许可及有效范围。</view>

      <button wx:if="{{selected.capabilities.canConfirmProvider}}" class="figma-action figma-action--orange" data-type="CONFIRM_PROVIDER" bindtap="command" disabled="{{busy || pending || pendingError}}">本人核对并确认实际服务</button>
      <block wx:if="{{selected.capabilities.canManage}}"><button wx:if="{{selected.listing.status==='DRAFT' || selected.listing.status==='REJECTED'}}" class="figma-action figma-action--ghost" bindtap="edit" disabled="{{busy || pending}}">修改申请资料</button><button wx:if="{{selected.listing.status==='DRAFT' && selected.listing.providerConfirmed}}" class="figma-action figma-action--orange" data-type="SUBMIT" bindtap="command" disabled="{{busy || pending || pendingError}}">提交独立审核</button><button wx:if="{{selected.listing.status==='APPROVED'}}" class="figma-action figma-action--ghost" data-type="{{selected.listing.published ? 'UNPUBLISH' : 'PUBLISH'}}" bindtap="command" disabled="{{busy || pending || pendingError}}">{{selected.listing.published ? '取消公开' : '公开发布'}}</button></block>

      <view wx:if="{{selected.capabilities.canReview && selected.listing.status==='PENDING'}}" class="review-panel"><view class="figma-row__title">独立审核结论</view><view class="figma-caption">项目标签不等于认证；本页只记录核验清单和结论。</view><checkbox-group bindchange="checks"><label class="figma-check"><checkbox value="qualification" checked="{{qualificationChecked}}" disabled="{{busy}}"/>已核对主体、服务人员及所需资质</label><label class="figma-check"><checkbox value="scope" checked="{{scopeChecked}}" disabled="{{busy}}"/>已核对经营地址、覆盖范围与服务能力</label></checkbox-group><picker mode="date" class="figma-field-control" value="{{qualifiedDate}}" data-field="qualifiedDate" bindchange="input">资格截止：{{qualifiedDate || '请选择'}}</picker><picker mode="time" class="figma-field-control" value="{{qualifiedTime}}" data-field="qualifiedTime" bindchange="input">截止时间：{{qualifiedTime}}</picker><view class="inline-actions"><button class="figma-action figma-action--orange" data-type="APPROVE" bindtap="command" disabled="{{busy || pending || pendingError || !qualificationChecked || !scopeChecked || !qualifiedDate}}">审核通过</button><button class="figma-action figma-action--ghost" data-type="REJECT" bindtap="command" disabled="{{busy || pending || pendingError}}">退回申请</button></view></view>
      <button wx:if="{{selected.capabilities.canSuspend && selected.listing.status==='APPROVED'}}" class="figma-action figma-action--ghost danger-action" data-type="SUSPEND" bindtap="command" disabled="{{busy || pending || pendingError}}">暂停供给</button>

      <view wx:if="{{selected.capabilities.canManage}}" class="slot-panel"><view class="figma-row__title">开放档期（北京时间）</view><view wx:for="{{selected.slots}}" wx:key="id" class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{item.timeText}}</view><view class="figma-row__subtitle">{{item.statusText}}</view></view><button wx:if="{{item.status==='OPEN'}}" class="row-link" data-id="{{item.id}}" bindtap="closeSlot" disabled="{{busy || pending || pendingError}}">关闭</button></view><view wx:if="{{selected.listing.status==='APPROVED' && selected.listing.published}}" class="slot-form"><view class="figma-field-grid"><picker mode="date" class="figma-field-control" data-field="startDate" bindchange="input">{{startDate || '开始日期'}}</picker><picker mode="time" class="figma-field-control" value="{{startTime}}" data-field="startTime" bindchange="input">{{startTime}}</picker><picker mode="date" class="figma-field-control" data-field="endDate" bindchange="input">{{endDate || '结束日期'}}</picker><picker mode="time" class="figma-field-control" value="{{endTime}}" data-field="endTime" bindchange="input">{{endTime}}</picker></view><button class="figma-action figma-action--orange" bindtap="addSlot" disabled="{{busy || pending || pendingError}}">添加开放档期</button></view></view>
    </view>

    <view wx:if="{{(canCreate && creating) || editing}}" class="figma-section supply-form">
      <view class="section-heading"><view class="figma-section__title">{{editing ? '修订待审供给' : '新增供给申请'}}</view><button class="section-link" bindtap="closeSupply" disabled="{{busy}}">取消</button></view>
      <picker class="figma-field-control" range="{{kinds}}" range-key="label" value="{{kindIndex}}" data-field="kindIndex" bindchange="pick" disabled="{{busy || editing}}">服务项目：{{kinds[kindIndex].label}}</picker>
      <block wx:if="{{!editing}}"><picker class="figma-field-control" range="{{providers}}" range-key="name" value="{{providerIndex}}" data-field="providerIndex" bindchange="pick" disabled="{{busy}}">实际服务人员：{{providers[providerIndex].name || '暂无有效机构人员'}}</picker><picker wx:if="{{kinds[kindIndex].value==='COURT'}}" class="figma-field-control" range="{{courts}}" range-key="name" value="{{courtIndex}}" data-field="courtIndex" bindchange="pick">实际球场：{{courts[courtIndex].name || '请先建立球场'}}</picker></block>
      <view class="region-panel"><view class="figma-row__title">经营与覆盖地区</view><view class="figma-caption">经营地区：{{formRegion.label || '尚未确认'}} · 当前选择 {{selection.label}}</view><view class="inline-actions"><button class="figma-action figma-action--ghost" bindtap="chooseCity">选择地区</button><button class="figma-action figma-action--ghost" bindtap="useRegion" disabled="{{busy || editing}}">确认经营地区</button></view><button wx:if="{{kinds[kindIndex].value!=='COURT'}}" class="figma-action figma-action--ghost" bindtap="addCoverage" disabled="{{busy}}">加入当前覆盖地区</button><button wx:for="{{coverage}}" wx:key="regionId" class="region-chip" data-id="{{item.regionId}}" bindtap="removeCoverage">{{item.label}} ×</button></view>
      <view class="figma-field-group"><view class="figma-field-label">供给名称</view><input class="figma-field-control" data-field="title" value="{{title}}" bindinput="input" maxlength="100" disabled="{{busy}}"/></view>
      <view class="figma-field-group"><view class="figma-field-label">服务内容与适用范围</view><textarea class="figma-field-control" data-field="description" value="{{description}}" bindinput="input" maxlength="1000" disabled="{{busy}}"/></view>
      <view class="figma-field-group"><view class="figma-field-label">实际经营或常驻地址</view><input class="figma-field-control" data-field="address" value="{{address}}" bindinput="input" maxlength="200" disabled="{{busy}}"/></view>
      <view class="figma-field-group"><view class="figma-field-label">地图地点（可选）</view><input class="figma-field-control" data-field="placeQuery" value="{{placeQuery}}" bindinput="input" placeholder="搜索经营地区内的地点" maxlength="100"/></view><button class="figma-action figma-action--ghost" bindtap="searchPlaces" disabled="{{busy || placesBusy}}">{{placesBusy ? '正在搜索…' : '搜索地图地点'}}</button><button wx:for="{{places}}" wx:key="index" class="place-option" data-index="{{index}}" bindtap="usePlace">{{item.title}} · {{item.address}}</button>
      <view class="figma-field-group"><view class="figma-field-label">资质核验清单</view><textarea class="figma-field-control" data-field="qualificationNote" value="{{qualificationNote}}" bindinput="input" placeholder="不要填写证件号码或私密联系方式" maxlength="1000" disabled="{{busy}}"/></view>
      <view class="figma-field-group"><view class="figma-field-label">合作约定</view><textarea class="figma-field-control" data-field="terms" value="{{terms}}" bindinput="input" placeholder="服务、改期、天气取消与争议处理" maxlength="1000" disabled="{{busy}}"/></view>
      <view class="inline-actions"><button class="figma-action figma-action--ghost" bindtap="resetForm" disabled="{{busy}}">清空</button><button class="figma-action figma-action--orange" bindtap="save" disabled="{{busy || pending || pendingError}}">保存待审申请</button></view>
    </view>
  </view>
  <view wx:if="{{!selected && !creating && !editing}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="bookings">查看服务订单</button><button class="figma-action figma-action--orange" bindtap="openSupply" disabled="{{busy || loading || pending || pendingError || !canCreate}}">新增供给申请</button></view>
</view>
