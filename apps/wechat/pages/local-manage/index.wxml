<scb-header title="经营与服务方" disabled="{{busy}}"/>
<view class="page local-private">
 <view class="title">供给与档期管理</view><view class="muted">真实人员确认、独立资质审核、发布后才可预约。此版本不收款。</view>
 <button wx:if="{{loginRequired}}" bindtap="login">登录</button>
 <picker wx:if="{{organizations.length}}" class="field" range="{{organizations}}" range-key="name" value="{{orgIndex}}" bindchange="org" disabled="{{busy || pending}}">{{organizations[orgIndex].name}}</picker>
 <button bindtap="load" disabled="{{busy || loading}}">刷新授权与供给</button><button bindtap="bookings">查看服务订单</button>
 <view wx:if="{{pending || pendingError}}" class="notice warning"><view>{{pendingError || '原操作结果尚未核对。'}}</view><button bindtap="recover" disabled="{{busy}}">查询原操作回执</button><button wx:if="{{pending}}" bindtap="retry" disabled="{{busy}}">重试原操作</button></view>
 <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view>
 <view wx:if="{{loading}}">读取中…</view><button wx:for="{{listings}}" wx:key="id" data-id="{{item.id}}" bindtap="select" disabled="{{busy}}" class="card listing"><view class="subtitle">{{item.title}}</view><view>{{item.kindText}} · {{item.statusText}} · {{item.published?'已公开':'未公开'}}</view><view class="muted">{{item.address}} · {{item.providerConfirmed?'服务方已确认':'等待服务方本人确认'}}</view></button>
 <view wx:if="{{!loading && !listings.length}}" class="card muted">当前范围暂无可管理供给。实际服务人员可以在“我提供的服务”确认供给；城市审核者从运营工作台进入待审条目。</view>
 <view wx:if="{{selected}}" class="card"><view class="subtitle">{{selected.listing.title}}</view><view>{{selected.listing.statusText}} · {{selected.listing.address}}</view><view>{{selected.listing.description}}</view><view class="notice"><view class="section-title">申请人提供的核验清单</view>{{selected.listing.qualificationNote}}</view><view>{{selected.listing.reviewReason}}</view><view>{{selected.listing.qualificationText}}</view><view>覆盖地区数量：{{selected.listing.coverageRegionIds.length}}</view><view class="section-title">合作约定</view><view>{{selected.terms}}</view><textarea class="field" data-field="reason" value="{{reason}}" bindinput="input" placeholder="本次审核、发布或天气取消的说明（至少4字）" maxlength="500" disabled="{{busy}}"/>
  <button wx:if="{{selected.capabilities.canConfirmProvider}}" data-type="CONFIRM_PROVIDER" bindtap="command" disabled="{{busy || pending || pendingError}}">本人核对并确认实际服务</button>
  <block wx:if="{{selected.capabilities.canManage}}"><button wx:if="{{selected.listing.status==='DRAFT' || selected.listing.status==='REJECTED'}}" bindtap="edit" disabled="{{busy || pending}}">修改申请资料</button><button wx:if="{{selected.listing.status==='DRAFT' && selected.listing.providerConfirmed}}" data-type="SUBMIT" bindtap="command" disabled="{{busy || pending || pendingError}}">提交独立审核</button><button wx:if="{{selected.listing.status==='APPROVED'}}" data-type="{{selected.listing.published?'UNPUBLISH':'PUBLISH'}}" bindtap="command" disabled="{{busy || pending || pendingError}}">{{selected.listing.published?'取消公开':'公开发布'}}</button></block>
  <block wx:if="{{selected.capabilities.canReview && selected.listing.status==='PENDING'}}"><view class="section-title">独立审核结论</view><view class="muted">不得以项目标签替代认证。请通过线下或已授权渠道核对经营主体、实际服务者及相应资质；本页只记录清单和结论，不接收证件照片。</view><checkbox-group bindchange="checks"><label class="check"><checkbox value="qualification" checked="{{qualificationChecked}}" disabled="{{busy}}"/>已核对主体、实际服务人员与所需资质；医务需核实执业许可及有效范围</label><label class="check"><checkbox value="scope" checked="{{scopeChecked}}" disabled="{{busy}}"/>已核对实际经营地址、覆盖地区与服务能力</label></checkbox-group><picker mode="date" class="field" value="{{qualifiedDate}}" data-field="qualifiedDate" bindchange="input">资格截止日期：{{qualifiedDate || '请选择'}}</picker><picker mode="time" class="field" value="{{qualifiedTime}}" data-field="qualifiedTime" bindchange="input">截止时间（北京时间）：{{qualifiedTime}}</picker><button data-type="APPROVE" bindtap="command" disabled="{{busy || pending || pendingError || !qualificationChecked || !scopeChecked || !qualifiedDate}}">审核通过</button><button data-type="REJECT" bindtap="command" disabled="{{busy || pending || pendingError}}">退回并说明原因</button></block>
  <button wx:if="{{selected.capabilities.canSuspend && selected.listing.status==='APPROVED'}}" class="danger" data-type="SUSPEND" bindtap="command" disabled="{{busy || pending || pendingError}}">暂停供给</button>
  <block wx:if="{{selected.capabilities.canManage}}"><view class="section-title">档期（北京时间）</view><view wx:for="{{selected.slots}}" wx:key="id" class="slot-row"><view>{{item.timeText}} · {{item.statusText}}</view><button wx:if="{{item.status==='OPEN'}}" class="danger" data-id="{{item.id}}" bindtap="closeSlot" disabled="{{busy || pending || pendingError}}">天气等原因关闭此档期</button></view><block wx:if="{{selected.listing.status==='APPROVED' && selected.listing.published}}"><picker mode="date" class="field" data-field="startDate" bindchange="input">开始日期：{{startDate || '请选择'}}</picker><picker mode="time" class="field" value="{{startTime}}" data-field="startTime" bindchange="input">开始时间：{{startTime}}</picker><picker mode="date" class="field" data-field="endDate" bindchange="input">结束日期：{{endDate || '请选择'}}</picker><picker mode="time" class="field" value="{{endTime}}" data-field="endTime" bindchange="input">结束时间：{{endTime}}</picker><button class="primary" bindtap="addSlot" disabled="{{busy || pending || pendingError}}">添加开放档期</button></block></block>
 </view>
 <view wx:if="{{canCreate || editing}}" class="card"><view class="subtitle">{{editing?'修订待审供给':'新增供给申请'}}</view><picker class="field" range="{{kinds}}" range-key="label" value="{{kindIndex}}" data-field="kindIndex" bindchange="pick" disabled="{{busy || editing}}">服务项目：{{kinds[kindIndex].label}}</picker><block wx:if="{{!editing}}"><picker class="field" range="{{providers}}" range-key="name" value="{{providerIndex}}" data-field="providerIndex" bindchange="pick" disabled="{{busy}}">实际服务人员：{{providers[providerIndex].name || '暂无有效机构人员'}}</picker><view class="muted">选择具体人员后，须由该账号本人确认；同一人多个项目共用档期冲突检查。</view><picker wx:if="{{kinds[kindIndex].value==='COURT'}}" class="field" range="{{courts}}" range-key="name" value="{{courtIndex}}" data-field="courtIndex" bindchange="pick">实际球场：{{courts[courtIndex].name || '请先在赛事排程管理建立球场'}}</picker></block>
  <view class="local-actions"><button bindtap="chooseCity">选择经营或覆盖地区</button><button bindtap="useRegion" disabled="{{busy || editing}}">确认经营地区为{{selection.label}}</button></view><view>经营地区：{{formRegion.label || '尚未确认'}}</view><block wx:if="{{kinds[kindIndex].value!=='COURT'}}"><button bindtap="addCoverage" disabled="{{busy}}">把{{selection.label}}加入服务覆盖</button><button wx:for="{{coverage}}" wx:key="regionId" data-id="{{item.regionId}}" bindtap="removeCoverage">{{item.label}} · 移除</button></block>
  <input class="field" data-field="title" value="{{title}}" bindinput="input" placeholder="供给名称" maxlength="100" disabled="{{busy}}"/><textarea class="field" data-field="description" value="{{description}}" bindinput="input" placeholder="服务内容与适用范围" maxlength="1000" disabled="{{busy}}"/><input class="field" data-field="address" value="{{address}}" bindinput="input" placeholder="实际经营或常驻地址" maxlength="200" disabled="{{busy}}"/><input class="field" data-field="placeQuery" value="{{placeQuery}}" bindinput="input" placeholder="可选：搜索地图地点以确认实际地址" maxlength="100"/><button bindtap="searchPlaces" disabled="{{busy || placesBusy}}">搜索经营地区地图地点</button><button wx:for="{{places}}" wx:key="index" data-index="{{index}}" bindtap="usePlace">{{item.title}} · {{item.address}}（地图候选）</button><view class="muted">{{businessPoint?'已明确选择地址坐标。':'未提供坐标；可以按文字地址使用，公开页不显示距离。'}} 修改地址文字会清除原坐标。</view><textarea class="field" data-field="qualificationNote" value="{{qualificationNote}}" bindinput="input" placeholder="资质核验清单：主体、人员资格、有效期及可核验渠道；不要粘贴证件号码或私密联系方式" maxlength="1000" disabled="{{busy}}"/><textarea class="field" data-field="terms" value="{{terms}}" bindinput="input" placeholder="服务范围、到场与交付约定、改期、天气取消和争议处理方式" maxlength="1000" disabled="{{busy}}"/><button class="primary" bindtap="save" disabled="{{busy || pending || pendingError}}">保存待审申请</button><button bindtap="resetForm" disabled="{{busy}}">清空本次表单</button>
 </view>
</view><scb-nav active="Local" disabled="{{busy}}"/>
