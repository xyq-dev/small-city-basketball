<scb-header title="球队与长期成员" disabled="{{busy || uncertain || nameDirty || membersDirty}}"/>
<view class="figma-page team-page">
  <view class="figma-page__content figma-page__content--actions">
    <figma-feedback wx:if="{{error}}" type="error" title="请核对球队资料" body="{{error}}" action-label="重新读取" bind:action="refresh"/>
    <figma-feedback wx:if="{{message}}" type="success" title="球队状态已更新" body="{{message}}"/>
    <figma-feedback wx:if="{{loginRequired}}" type="empty" title="登录后继续管理球队" body="当前未读取私有成员资料。" action-label="登录并继续" bind:action="login"/>
    <view wx:if="{{loading}}" class="figma-section"><figma-skeleton rows="{{5}}"/></view>
    <block wx:if="{{team}}">
      <view class="figma-summary figma-summary--navy"><view class="figma-summary__icon"><figma-icon name="jersey" size="{{28}}"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">球队管理</view><view class="figma-title">{{team.name}}</view><view class="figma-subtitle">{{team.organizationName || '当前授权机构'}} · {{canRegister ? '领队身份' : '球队成员资料'}}</view></view></view>
      <view class="team-tabs"><button class="team-tab is-active">长期成员</button><button class="team-tab" bindtap="events" disabled="{{busy || !canRegister}}">本届报名</button></view>
      <view class="figma-section"><view class="profile-head"><view><view class="figma-section__title">球队名册</view><view class="figma-section__hint">长期档案与每届报名快照分别保存</view></view><view class="figma-status">{{team.members.length}} 人</view></view><figma-feedback wx:if="{{!team.members.length}}" type="empty" title="暂无长期成员" body="有权管理者可在下方添加。"/><view wx:for="{{team.members}}" wx:key="id" class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{item.jerseyNo ? item.jerseyNo + '  ' : ''}}{{item.name}}</view><view class="figma-row__subtitle">{{item.memberLabel || '长期成员 · 球衣号码在本届报名中设置'}}</view></view><view class="figma-status figma-status--green">{{item.statusLabel || '有效'}}</view></view></view>
      <view wx:if="{{team.capabilities.canManage}}" class="figma-section"><view class="figma-section__title">成员管理</view><button class="team-choice" bindtap="startAddMember" disabled="{{busy || uncertain}}"><view class="figma-row__mark"/><view class="figma-row__copy"><view class="figma-row__title">添加长期成员</view><view class="figma-row__subtitle">维护队内显示名与号码</view></view></button><button class="team-choice" bindtap="issueJoinCode" disabled="{{busy}}"><view class="figma-row__mark"/><view class="figma-row__copy"><view class="figma-row__title">签发加入码</view><view class="figma-row__subtitle">由球员本人输入</view></view></button><button class="team-choice" bindtap="scrollClaims" disabled="{{busy}}"><view class="figma-row__mark"/><view class="figma-row__copy"><view class="figma-row__title">历史成员认领</view><view class="figma-row__subtitle">定向邀请本人核对</view></view></button></view>
      <view class="figma-section"><view class="figma-section__title">本届报名</view><view class="team-notice"><view class="team-notice__mark"/><view class="figma-row__copy"><view class="figma-row__title">本届名单</view><view class="figma-row__subtitle">按届保存报名版本</view></view></view><view class="team-notice"><view class="team-notice__mark"/><view class="figma-row__copy"><view class="figma-row__title">长期成员变动</view><view class="figma-row__subtitle">不重写已存报名快照</view></view></view></view>
      <figma-feedback wx:if="{{!canRegister}}" type="pending" title="本届报名需球队领队授权" body="机构管理身份不会自动代替领队。"/>
      <view wx:if="{{team.capabilities.canInvite}}" class="figma-section"><view class="figma-row"><figma-icon name="message" size="{{22}}"/><view class="figma-row__copy"><view class="figma-row__title">管理者邀请</view><view class="figma-row__subtitle">小程序暂未开放，请由有权机构人员在网页后台办理。</view></view><view class="figma-status">未开放</view></view></view>

      <view wx:if="{{team.capabilities.canManage}}" class="figma-section"><view class="profile-head"><view><view class="figma-section__title">球队资料管理</view><view class="figma-section__hint">收起编辑不会自动保存草稿</view></view><button class="row-action" bindtap="toggleEdit" disabled="{{busy || uncertain}}">{{editMode ? '收起' : '编辑'}}</button></view><block wx:if="{{editMode}}"><view class="figma-field-group"><view class="figma-field-label">球队名称</view><input class="figma-field-control" maxlength="80" value="{{name}}" bindinput="inputName" disabled="{{busy || uncertain}}"/></view><button class="section-primary" data-mode="name" bindtap="save" disabled="{{busy || uncertain || !nameDirty}}" loading="{{busy}}">保存球队名称</button><view class="figma-section__title">编辑长期成员 · {{members.length}} / 60</view><view wx:for="{{members}}" wx:key="key" class="member-edit"><input class="figma-field-control" value="{{item.name}}" maxlength="80" placeholder="成员姓名" bindinput="memberName" data-index="{{index}}" disabled="{{busy || uncertain}}"/><button class="row-action row-action--danger" data-index="{{index}}" bindtap="removeMember" disabled="{{busy || uncertain}}">移出</button></view><button class="section-ghost" bindtap="addMember" disabled="{{busy || uncertain || members.length>=60}}">添加成员</button><button class="section-primary" data-mode="members" bindtap="save" disabled="{{busy || uncertain || !membersDirty}}" loading="{{busy}}">保存长期成员</button></block></view>

      <view wx:if="{{team.capabilities.canManage}}" class="figma-section"><view class="figma-section__title">球员账号与认领</view><view class="figma-section__hint">绑定只代表球队成员身份，不授予球队管理权限。</view><figma-feedback wx:if="{{playersError}}" type="error" title="球员账号资料读取失败" body="{{playersError}}"/><button class="section-primary" bindtap="issueJoinCode" disabled="{{busy}}">签发加入码</button><figma-feedback wx:if="{{issuedCode}}" type="success" title="本次加入码（只显示一次）" body="{{issuedCode}}"/><view wx:for="{{codes}}" wx:key="id" class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{item.stateText}} · {{item.useCount}}/{{item.maxUses}}</view><view class="figma-row__subtitle">{{item.expires}}</view></view><button wx:if="{{item.status!=='REVOKED'}}" class="row-action" data-id="{{item.id}}" bindtap="revokeJoinCode" disabled="{{busy}}">撤销</button></view>
        <block wx:if="{{roster}}"><view class="figma-section__title">已绑定账号</view><figma-feedback wx:if="{{!roster.bindings.length}}" type="empty" title="暂无球员账号"/><view wx:for="{{roster.bindings}}" wx:key="bindingId" class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{item.memberName}}</view><view class="figma-row__subtitle">{{item.accountDisplayName}} · {{item.stateText}}</view></view><button wx:if="{{item.status==='ACTIVE'}}" class="row-action row-action--danger" data-id="{{item.bindingId}}" bindtap="removeBinding" disabled="{{busy || !removeReason}}">移除</button></view><view class="figma-field-group"><view class="figma-field-label">移除原因（4–500字）</view><input class="figma-field-control" maxlength="500" value="{{removeReason}}" data-field="removeReason" bindinput="playerField" disabled="{{busy}}"/></view><view class="figma-section__title">历史成员认领</view><view class="claim-grid"><button wx:for="{{roster.claimableMembers}}" wx:key="memberId" class="claim-item {{claimMember===item.memberId ? 'is-active' : ''}}" data-id="{{item.memberId}}" bindtap="pickClaimMember" disabled="{{busy}}">{{item.name}}</button></view><view class="figma-field-group"><view class="figma-field-label">对方账号编号</view><input class="figma-field-control" maxlength="36" value="{{claimTarget}}" data-field="claimTarget" bindinput="playerField" disabled="{{busy}}"/></view><button class="section-primary" bindtap="createClaim" disabled="{{busy || !claimMember || !claimTarget}}">发起认领</button><view wx:for="{{roster.claims}}" wx:key="claimId" class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{item.memberName}} → {{item.targetDisplayName}}</view><view class="figma-row__subtitle">{{item.stateText}}</view></view><button wx:if="{{item.status==='PENDING'}}" class="row-action" data-id="{{item.claimId}}" bindtap="revokeClaim" disabled="{{busy}}">撤销</button></view></block>
      </view>
      <button wx:if="{{nameDirty || membersDirty}}" class="section-ghost" bindtap="refresh" disabled="{{busy || uncertain}}">取消未保存修改</button>
    </block>
    <figma-feedback wx:if="{{!team && !loading && !error && !loginRequired}}" type="empty" title="暂无可查看的球队资料" body="请从我的球队重新进入，或核对当前账号授权。"/>
  </view>
  <view wx:if="{{team}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="startAddMember" disabled="{{busy || loading || uncertain || !team.capabilities.canManage}}">添加成员</button><button class="figma-action figma-action--orange" bindtap="events" disabled="{{busy || !canRegister}}">管理本届报名</button></view>
</view>
