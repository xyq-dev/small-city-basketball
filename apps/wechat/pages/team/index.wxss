@import "../../styles/figma-pages.wxss";

.team-tabs{display:grid;height:48px;padding:2px;grid-template-columns:repeat(2,minmax(0,1fr));border-radius:14px;background:#fff}.team-tab{display:flex;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 8px;border:0;border-radius:12px;background:transparent;color:#51657d;font-size:14px}.team-tab::after,.row-action::after,.section-primary::after,.section-ghost::after,.claim-item::after{border:0}.team-tab.is-active{background:#123c73;color:#fff;font-weight:700}.profile-head{display:flex;min-height:44px;align-items:center;justify-content:space-between;gap:8px}.member-avatar{display:flex;width:36px;height:36px;flex:none;align-items:center;justify-content:center;border-radius:10px;background:#eaf2fc;color:#123c73;font-size:12px;font-weight:700}.row-action{display:flex;min-width:56px;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 8px;border:0;border-radius:22px;background:#eaf2fc;color:#123c73;font-size:13px}.row-action--danger{background:#fdecef;color:#c83f42}.section-primary,.section-ghost{display:flex;width:100%;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 12px;border-radius:22px;font-size:14px}.section-primary{border:0;background:#123c73;color:#fff}.section-ghost{border:1px solid #7c8ea5;background:#fff;color:#123c73}.member-edit{display:grid;align-items:center;grid-template-columns:minmax(0,1fr) 56px;gap:8px}.claim-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.claim-item{display:flex;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 8px;border:1px solid #7c8ea5;border-radius:12px;background:#fff;color:#123c73;font-size:13px}.claim-item.is-active{border-color:#123c73;background:#eaf2fc;font-weight:700}
.team-choice{display:flex;width:100%;min-height:55px;align-items:center;gap:8px;margin:0;padding:0;border:0;background:transparent;color:#18283f;text-align:left}.team-choice+.team-choice{border-top:1px solid #e6ebf2}.team-choice::after{border:0}.team-notice{display:flex;width:100%;min-height:55px;align-items:center;gap:9px;padding:0 10px;border-radius:8px;background:#eaf2fc}.team-notice+.team-notice{margin-top:0}.team-notice__mark{width:7px;height:7px;flex:none;border-radius:4px;background:#123c73}
.team-page .team-tabs>.team-tab{width:100%;min-width:0;max-width:none;justify-self:stretch;box-sizing:border-box}
