<view class="scb-ui-page account-rebuild">
  <scb-header mode="{{figmaState==='account-wechat' ? '' : 'account'}}" title="{{figmaState==='account-wechat' ? '微信登录状态' : '我的'}}" bind:layoutchange="headerLayout"/>

  <scroll-view class="account-scroll" scroll-y enhanced show-scrollbar="{{false}}" style="height:{{contentHeight}}px">
    <view class="account-content {{figmaState ? 'account-content--state' : ''}}">
    <block wx:if="{{figmaState==='account-wechat'}}">
      <view class="account-state-hero"><view class="account-state-hero__title">按实际微信状态提供入口</view><view class="account-state-hero__body">未开放、读取失败、登录中、未绑定、失败分别处理。</view></view>
      <view class="account-section account-state-section"><view class="account-section__title">登录能力</view><view class="account-state-row"><view class="account-state-dot"/><view class="account-state-copy"><view class="account-row__title">微信登录暂未开放</view><view class="account-row__subtitle">可以使用已有应用账号登录。</view></view><view class="account-status">未开放</view></view><view class="account-state-row"><view class="account-state-dot"/><view class="account-state-copy"><view class="account-row__title">暂时无法核对微信登录状态</view><view class="account-row__subtitle">恢复连接后可重试。</view></view><view class="account-status is-error">读取失败</view></view></view>
      <view class="account-section account-state-section"><view class="account-section__title">登录过程</view><view class="account-state-step"><view class="account-state-step__mark">1</view><view class="account-state-copy"><view class="account-row__title">正在登录…</view><view class="account-row__subtitle">保留当前操作，等待核验。</view></view><view class="account-status">按钮禁用</view></view><view class="account-state-step"><view class="account-state-step__mark">2</view><view class="account-state-copy"><view class="account-row__title">当前微信尚未绑定应用账号</view><view class="account-row__subtitle">先登录已有账号再明确绑定。</view></view><view class="account-status">未绑定</view></view><view class="account-state-step"><view class="account-state-step__mark">3</view><view class="account-state-copy"><view class="account-row__title">微信登录失败</view><view class="account-row__subtitle">重新核对登录状态后再操作。</view></view><view class="account-status">可重试</view></view></view>
    </block>

    <block wx:elif="{{loading && loginPhase!=='wechat'}}">
      <view class="account-sr-only" role="status">正在核对当前账号</view>
      <figma-skeleton rows="3"/><figma-skeleton rows="2"/>
    </block>

    <block wx:elif="{{loginPhase==='wechat'}}">
      <figma-feedback type="pending" title="正在核对登录结果" body="完成微信步骤后，仍需核对应用账号会话；请勿重复提交。"/>
      <button class="account-pill is-wechat" disabled="{{true}}"><view class="account-spinner" aria-hidden="true"/>正在登录</button>
    </block>

    <block wx:else>
      <figma-feedback wx:if="{{message}}" type="{{messageTone==='error' ? 'error' : messageTone==='success' ? 'success' : 'pending'}}" title="{{messageTone==='error' ? '操作未完成' : messageTone==='success' ? '操作已完成' : '请留意'}}" body="{{message}}"/>

      <block wx:if="{{user && !securityOpen}}">
        <view class="account-summary"><view class="account-summary__icon"><figma-icon name="account" size="25"/></view><view class="account-summary__copy"><view class="account-summary__eyebrow">本人账号</view><view class="account-summary__name">{{user.displayName || '未填写显示名称'}}</view><view class="account-summary__subtitle">本人信息与服务入口</view></view></view>

        <view class="account-section">
          <view class="account-section__title">我的服务</view>
          <view class="account-grid">
            <button class="account-grid__item" data-page="participant-materials" bindtap="go" disabled="{{busy}}"><figma-icon name="registration" size="20"/><view class="account-grid__title">我的报名</view><view class="account-grid__subtitle">本届资料与进度</view></button>
            <button class="account-grid__item" data-page="teams" bindtap="go" disabled="{{busy}}"><figma-icon name="teams" size="20"/><view class="account-grid__title">我的球队</view><view class="account-grid__subtitle">成员与球队授权</view></button>
            <button class="account-grid__item" bindtap="toggleOrders" disabled="{{busy}}"><figma-icon name="booking" size="20"/><view class="account-grid__title">我的预约</view><view class="account-grid__subtitle">球员及同城服务</view></button>
            <button class="account-grid__item" data-page="follows" bindtap="go" disabled="{{busy}}"><figma-icon name="follow" size="20"/><view class="account-grid__title">我的关注</view><view class="account-grid__subtitle">赛事更新</view></button>
          </view>
        </view>

        <view wx:if="{{ordersOpen}}" class="account-section account-choice-section">
          <view class="account-section__title">选择订单与预约</view>
          <button class="account-choice-row" data-page="trade-order" bindtap="go" disabled="{{busy}}"><view><view class="account-row__title">本人收付款与退款订单</view><view class="account-row__subtitle">报名费、保证金与退款进度</view></view></button>
          <button class="account-choice-row" data-page="local-bookings" bindtap="go" disabled="{{busy}}"><view><view class="account-row__title">球场与同城服务预约</view><view class="account-row__subtitle">场馆、裁判与服务订单</view></view></button>
          <button class="account-choice-row" data-page="bookings" bindtap="go" disabled="{{busy}}"><view><view class="account-row__title">我发出的球员预约</view><view class="account-row__subtitle">核对邀请和履约进度</view></view></button>
          <button class="account-choice-row" data-page="player-center" bindtap="go" disabled="{{busy}}"><view><view class="account-row__title">本人球员中心</view><view class="account-row__subtitle">查看收到的预约</view></view></button>
        </view>

        <view class="account-section account-list-section">
          <view class="account-section__title">常用服务</view>
          <button class="account-list-row" data-page="participant-materials" bindtap="go" disabled="{{busy}}"><view><view class="account-row__title">本人资料与授权</view><view class="account-row__subtitle">个人资料与公开授权</view></view></button>
          <button class="account-list-row" data-page="messages" bindtap="go" disabled="{{busy}}"><view><view class="account-row__title">消息与提醒</view><view class="account-row__subtitle">报名审核与赛程变更</view></view></button>
          <button class="account-list-row" bindtap="toggleMore" disabled="{{busy}}"><view><view class="account-row__title">更多服务与设置</view><view class="account-row__subtitle">账号安全、隐私与帮助</view></view></button>
        </view>

        <view wx:if="{{roles.length}}" class="account-section account-choice-section">
          <view class="account-section__title">角色工作台</view>
          <button class="account-choice-row" data-page="watch" bindtap="go" disabled="{{busy}}"><view class="account-choice-row__mark"/><view><view class="account-row__title">赛事工作台</view><view class="account-row__subtitle">仅限当前机构授权</view></view></button>
          <button class="account-choice-row" data-page="scoring-tasks" bindtap="go" disabled="{{busy}}"><view class="account-choice-row__mark"/><view><view class="account-row__title">记分与赛果复核</view><view class="account-row__subtitle">只显示被指派或有权管理的比赛</view></view></button>
          <button class="account-choice-row" data-page="watch" bindtap="go" disabled="{{busy}}"><view class="account-choice-row__mark"/><view><view class="account-row__title">直播与媒体</view><view class="account-row__subtitle">进入赛事后再次核验分工</view></view></button>
        </view>

        <block wx:if="{{navigationMoreOpen}}">
          <view class="account-section account-list-section">
            <view class="account-section__title">本人服务</view>
            <button class="account-list-row" data-page="public-archives" bindtap="go"><view><view class="account-row__title">公开档案与数据授权</view><view class="account-row__subtitle">长期公开档案与本人逐项同意</view></view></button>
            <button class="account-list-row" data-page="performance" bindtap="go"><view><view class="account-row__title">我的比赛数据授权</view><view class="account-row__subtitle">本人同意与主办方数据提名</view></view></button>
            <button class="account-list-row" data-page="season-grants" bindtap="go"><view><view class="account-row__title">私有赛季授权</view><view class="account-row__subtitle">查看或撤销本人授权</view></view></button>
            <button class="account-list-row" data-page="insurance" bindtap="go"><view><view class="account-row__title">本人保险订单</view><view class="account-row__subtitle">投保、查单与退保进度</view></view></button>
            <button class="account-list-row" data-page="sponsor-commerce" bindtap="go"><view><view class="account-row__title">我的广告合同</view><view class="account-row__subtitle">本人合同签署、付款与退款进度</view></view></button>
            <button class="account-list-row" data-page="notification-settings" bindtap="go"><view><view class="account-row__title">微信订阅提醒</view><view class="account-row__subtitle">逐次选择并核对记录</view></view></button>
          </view>

          <view class="account-section account-list-section">
            <view class="account-section__title">球队、撮合与培训</view>
            <button class="account-list-row" data-page="recruitment" bindtap="go"><view><view class="account-row__title">赛事招募与本届邀请</view><view class="account-row__subtitle">公开招募、申请和邀请</view></view></button>
            <button class="account-list-row" data-page="invitation" bindtap="go"><view><view class="account-row__title">接受球队邀请</view><view class="account-row__subtitle">使用发给本人的邀请</view></view></button>
            <button class="account-list-row" data-page="memberships" bindtap="go"><view><view class="account-row__title">我的成员关系</view><view class="account-row__subtitle">查看已加入球队或退出</view></view></button>
            <button class="account-list-row" data-page="team-join" bindtap="go"><view><view class="account-row__title">加入球队与成员认领</view><view class="account-row__subtitle">使用加入码或接受认领</view></view></button>
            <button class="account-list-row" data-page="team-request" bindtap="go"><view><view class="account-row__title">申请建队</view><view class="account-row__subtitle">使用机构分享的申请入口</view></view></button>
            <button class="account-list-row" data-page="matching" bindtap="go"><view><view class="account-row__title">全国撮合与合作意向</view><view class="account-row__subtitle">双方确认后转预约</view></view></button>
            <button class="account-list-row" data-page="dispatch" bindtap="go"><view><view class="account-row__title">跨城工作人员派单</view><view class="account-row__subtitle">接单、差旅报价与异常补位</view></view></button>
            <button class="account-list-row" data-page="training" bindtap="go"><view><view class="account-row__title">培训报名与我的课程</view><view class="account-row__subtitle">报名、签到、补课与退款</view></view></button>
          </view>

          <view wx:if="{{managedOrgs.length}}" class="account-section account-list-section">
            <view class="account-section__title">机构管理</view>
            <block wx:for="{{managedOrgs}}" wx:key="id">
              <button class="account-list-row" data-page="trade-manage" data-org="{{item.id}}" bindtap="go"><view><view class="account-row__title">收款条款与资金管理</view><view class="account-row__subtitle">{{item.name}}</view></view></button>
              <button class="account-list-row" data-page="public-ledgers" data-org="{{item.id}}" bindtap="go"><view><view class="account-row__title">授权经费记账与公示</view><view class="account-row__subtitle">{{item.name}}</view></view></button>
              <button class="account-list-row" data-page="training-manage" data-org="{{item.id}}" bindtap="go"><view><view class="account-row__title">培训课程与招生管理</view><view class="account-row__subtitle">{{item.name}}</view></view></button>
              <button class="account-list-row" data-page="sponsor-commerce" data-org="{{item.id}}" bindtap="go"><view><view class="account-row__title">广告合同与分账</view><view class="account-row__subtitle">{{item.name}}</view></view></button>
              <button class="account-list-row" data-page="sponsorships" data-org="{{item.id}}" bindtap="go"><view><view class="account-row__title">广告与赞助投放</view><view class="account-row__subtitle">{{item.name}}</view></view></button>
              <button class="account-list-row" data-page="staff-configuration" data-org="{{item.id}}" bindtap="go"><view><view class="account-row__title">成员与工作人员权限</view><view class="account-row__subtitle">{{item.name}}</view></view></button>
              <button class="account-list-row" data-page="local-manage" data-org="{{item.id}}" bindtap="go"><view><view class="account-row__title">球场与同城服务管理</view><view class="account-row__subtitle">{{item.name}}</view></view></button>
              <button class="account-list-row" data-page="team-requests" data-org="{{item.id}}" bindtap="go"><view><view class="account-row__title">建队申请审批</view><view class="account-row__subtitle">{{item.name}}</view></view></button>
              <button class="account-list-row" data-page="seasons" data-org="{{item.id}}" bindtap="go"><view><view class="account-row__title">私有赛季管理</view><view class="account-row__subtitle">{{item.name}}</view></view></button>
            </block>
          </view>

          <view class="account-section account-list-section">
            <view class="account-section__title">账号、帮助与治理</view>
            <button class="account-list-row" bindtap="copyMemberId" disabled="{{busy}}"><view><view class="account-row__title">本人账号编号</view><view class="account-row__subtitle">{{user.id}}</view></view></button>
            <button class="account-list-row" bindtap="showSecurity"><view><view class="account-row__title">隐私与账号</view><view class="account-row__subtitle">微信绑定、恢复与账号安全</view></view></button>
            <button class="account-list-row" data-page="account-recovery" bindtap="go"><view><view class="account-row__title">邮箱验证与账号找回</view></view></button>
            <button class="account-list-row" data-page="guardian" bindtap="go"><view><view class="account-row__title">青少年与监护确认</view></view></button>
            <button class="account-list-row" data-page="local-matchups" bindtap="go"><view><view class="account-row__title">球队约赛</view></view></button>
            <button class="account-list-row" data-page="governance" bindtap="go"><view><view class="account-row__title">客服、举报与申诉</view></view></button>
            <button class="account-list-row" data-page="governance-reviews" bindtap="go"><view><view class="account-row__title">我的服务评价</view></view></button>
            <button class="account-list-row" data-page="city-operations" bindtap="go"><view><view class="account-row__title">城市运营授权</view></view></button>
            <button class="account-list-row" data-page="account-closure" bindtap="go"><view><view class="account-row__title">账号自助注销</view><view class="account-row__subtitle">先核对未完成事项</view></view></button>
            <button wx:if="{{platformOperator}}" class="account-list-row" data-page="platform" bindtap="go"><view><view class="account-row__title">平台服务资料与独立处理</view></view></button>
          </view>
        </block>

        <button wx:if="{{hasReturn}}" class="account-pill is-navy" bindtap="continue" disabled="{{busy}}">继续刚才的操作</button>
        <view class="account-page-actions"><button class="account-pill is-ghost" bindtap="showSecurity" disabled="{{busy}}">设置</button><button class="account-pill is-orange" data-page="participant-materials" bindtap="go" disabled="{{busy}}">查看本人资料</button></view>
      </block>

      <block wx:elif="{{user}}">
        <figma-feedback type="{{connected ? 'pending' : 'empty'}}" title="{{connected ? '解绑会退出全部设备会话' : '绑定已有应用账号'}}" body="{{connected ? '请重新验证当前密码。解绑后可使用应用账号重新登录。' : '重新验证当前密码并明确同意绑定，不按昵称或同名自动合并身份。'}}"/>
        <view class="account-section account-security">
          <view class="account-section__title">{{connected ? '微信身份已绑定' : '当前应用账号'}}</view><view class="account-security__name">{{user.displayName}}</view><view class="account-row__subtitle">{{user.email}}</view>
          <figma-feedback wx:if="{{wechatState==='unknown' && !connected}}" type="error" title="暂时无法核对微信登录状态" body="绑定入口先保持关闭。可以重试核对，或继续使用应用账号。" action-label="重新核对" bind:action="retryWechat"/>
          <figma-feedback wx:elif="{{wechatState==='closed' && !connected}}" type="pending" title="微信登录尚未配置" body="当前无法绑定微信，可以继续使用应用账号。"/>
          <view class="account-field"><view class="account-field__label">重新验证应用密码</view><input class="account-field__control" data-field="password" value="{{password}}" password disabled="{{busy}}" bindinput="input" maxlength="256" placeholder="请输入当前账号密码"/><view class="account-row__subtitle">仅用于本次绑定或解绑验证</view></view>
          <checkbox-group bindchange="consent"><label class="account-check"><checkbox disabled="{{busy}}" value="yes" checked="{{consent}}"/><view>我明确同意本次微信身份认证或解绑，不按昵称合并账号。</view></label></checkbox-group>
          <view class="account-row__subtitle">微信身份只关联当前账号，不采集微信头像、昵称、手机号或 unionid。</view>
          <button wx:if="{{!connected}}" class="account-pill is-navy" bindtap="bind" disabled="{{busy || !enabled || !consent}}">确认绑定当前微信</button>
          <button wx:else class="account-pill is-danger" bindtap="unbind" disabled="{{busy || !consent}}">确认解绑并退出全部设备</button>
          <button class="account-pill is-ghost" bindtap="closeSecurity" disabled="{{busy}}">保留当前设置并返回</button>
        </view>
        <view class="account-page-actions"><button class="account-pill is-ghost" data-page="account-closure" bindtap="go" disabled="{{busy}}">账号注销</button><button class="account-pill is-orange" bindtap="logout" disabled="{{busy}}">退出登录</button></view>
      </block>

      <block wx:else>
        <view class="account-summary"><view class="account-summary__icon"><figma-icon name="account" size="25"/></view><view class="account-summary__copy"><view class="account-summary__eyebrow">游客访问</view><view class="account-summary__name">小城市篮球</view><view class="account-summary__subtitle">登录后管理报名、球队与预约</view></view></view>

        <view class="account-section account-choice-section">
          <view class="account-section__title">登录账户</view>
          <button wx:if="{{wechatState==='unknown'}}" class="account-choice-row" bindtap="retryWechat" disabled="{{busy || loading}}"><view class="account-choice-row__mark"/><view><view class="account-row__title">暂时无法核对微信登录状态</view><view class="account-row__subtitle">请恢复连接后重试</view></view><view class="account-status">读取失败</view></button>
          <button wx:elif="{{wechatState==='open'}}" class="account-choice-row" bindtap="startWechat" disabled="{{busy || loading || loginNotice==='unbound' || loginNotice==='failed'}}"><view class="account-choice-row__mark"/><view><view class="account-row__title">微信快捷登录</view><view class="account-row__subtitle">使用已绑定的微信登录</view></view><view class="account-status {{loginNotice ? '' : 'is-open'}}">{{loginNotice ? '待核对' : '可用'}}</view></button>
          <view wx:else class="account-choice-row"><view class="account-choice-row__mark"/><view><view class="account-row__title">微信登录暂未开放</view><view class="account-row__subtitle">当前能力状态</view></view><view class="account-status">未开放</view></view>
          <button class="account-choice-row" bindtap="openEmail" disabled="{{busy}}"><view class="account-choice-row__mark"/><view><view class="account-row__title">邮箱登录</view><view class="account-row__subtitle">使用已绑定的应用账号</view></view></button>
          <button class="account-choice-row" data-page="account-recovery" bindtap="go" disabled="{{busy}}"><view class="account-choice-row__mark"/><view><view class="account-row__title">找回账号</view><view class="account-row__subtitle">通过账号恢复流程核验身份</view></view></button>
        </view>

        <figma-feedback wx:if="{{loginNotice==='unbound'}}" type="pending" title="当前微信尚未绑定应用账号" body="请先登录已有账号，再从隐私与账号中明确绑定。" action-label="使用邮箱登录" bind:action="openEmail"/>
        <figma-feedback wx:elif="{{loginNotice==='failed'}}" type="error" title="本次登录尚未完成" body="未建立应用会话，可以重新发起或选择邮箱登录。" action-label="重新发起" bind:action="retryWechat"/>

        <view class="account-section account-confirm-section">
          <view class="account-section__title">阅读并确认</view>
          <checkbox-group bindchange="markTerms"><label class="account-confirm-row"><checkbox disabled="{{busy}}" value="yes" checked="{{termsRead}}"/><view><view class="account-row__title">同意用户协议与隐私说明</view><view class="account-row__subtitle">本人主动勾选</view></view><view class="account-status {{termsRead ? 'is-open' : ''}}">{{termsRead ? '已勾选' : '未勾选'}}</view></label></checkbox-group>
          <button class="account-list-row account-legal-row" data-doc="privacy" bindtap="openAgreement" disabled="{{busy}}"><view class="account-legal-row__mark" aria-hidden="true"/><view><view class="account-row__title">用户协议与隐私说明</view><view class="account-row__subtitle">阅读条款不会自动勾选</view></view></button>
          <view wx:if="{{agreement}}" class="account-agreement"><view class="account-row__title">{{agreement==='privacy' ? '隐私说明' : '用户协议'}}</view><view class="account-row__subtitle">阅读本说明不等于同意绑定、解绑或微信身份认证。微信身份只关联已绑定的应用账号，不按昵称或同名合并账号。</view><button bindtap="closeAgreement">收起说明</button></view>
          <view wx:if="{{consentOpen && wechatState==='open'}}" class="account-consent-panel"><view class="account-row__title">确认本次微信身份认证</view><view class="account-row__subtitle">仅登录已经绑定的应用账号，不会自动创建账号。</view><checkbox-group bindchange="consent"><label class="account-check"><checkbox disabled="{{busy}}" value="yes" checked="{{consent}}"/><view>我明确同意本次微信身份认证，不按昵称合并账号。</view></label></checkbox-group><button class="account-pill is-wechat" bindtap="wechatLogin" disabled="{{busy || loading || !consent}}">{{busy ? '正在核对' : '确认并继续'}}</button><button class="account-inline-link" bindtap="closeConsent" disabled="{{busy}}">返回</button></view>
        </view>

        <view wx:if="{{emailOpen || registerMode}}" class="account-section account-email-section">
          <view class="account-section__title">{{registerMode ? '创建个人账号' : '邮箱登录'}}</view><view class="account-row__subtitle">{{hasReturn ? '成功后返回本次选择和原请求核对入口' : '登录后进入本人有权的球队与球员服务'}}</view>
          <view class="account-field"><view class="account-field__label">{{registerMode ? '注册邮箱' : '账号或邮箱'}}</view><input class="account-field__control" data-field="email" value="{{email}}" bindinput="input" maxlength="254" cursor-spacing="160" placeholder="请输入已有账号或邮箱"/></view>
          <view wx:if="{{registerMode}}" class="account-field"><view class="account-field__label">显示名称</view><input class="account-field__control" data-field="displayName" value="{{displayName}}" bindinput="input" maxlength="80" cursor-spacing="160" placeholder="请输入本人显示名称"/></view>
          <view class="account-field"><view class="account-field__label">应用密码</view><input class="account-field__control" data-field="password" value="{{password}}" password bindinput="input" maxlength="256" cursor-spacing="160" placeholder="请输入应用密码"/></view>
          <button wx:if="{{!registerMode}}" class="account-pill is-orange" bindtap="login" disabled="{{busy || loading}}">{{busy ? '正在登录' : (hasReturn ? '登录并返回刚才的操作' : '登录已有账号')}}</button>
          <button wx:else class="account-pill is-orange" bindtap="register" disabled="{{busy || loading || !canRegister}}">{{busy ? '正在创建' : '创建个人账号并登录'}}</button>
          <view class="account-email-links"><button wx:if="{{canRegister || registerMode}}" bindtap="toggleRegister" disabled="{{busy}}">{{registerMode ? '返回已有账号登录' : '创建个人账号'}}</button><button bindtap="closeEmail" disabled="{{busy}}">返回</button></view>
        </view>

        <view class="account-section account-guest-section">
          <view class="account-section__title">游客可浏览</view>
          <view class="account-grid"><button class="account-grid__item" data-page="watch" bindtap="go"><figma-icon name="event" size="20"/><view class="account-grid__title">公开赛事</view><view class="account-grid__subtitle">赛程、比分与结果</view></button><button class="account-grid__item" data-page="local" bindtap="go"><figma-icon name="workbench" size="20"/><view class="account-grid__title">同城服务</view><view class="account-grid__subtitle">按浏览城市查看供给</view></button><button class="account-grid__item" data-page="public-archives" bindtap="go"><figma-icon name="teams" size="20"/><view class="account-grid__title">球队广场</view><view class="account-grid__subtitle">获授权的公开档案</view></button></view>
        </view>

        <view class="account-page-actions"><button class="account-pill is-ghost" data-page="account-recovery" bindtap="go" disabled="{{busy}}">找回账号</button><button class="account-pill is-orange" bindtap="openEmail" disabled="{{busy}}">邮箱登录</button></view>
      </block>
    </block>
    </view>
  </scroll-view>
  <view wx:if="{{figmaState==='account-wechat'}}" class="account-state-actions"><button class="account-pill is-ghost">重新核对登录状态</button><button class="account-pill is-orange">使用邮箱登录</button></view>
  <scb-nav wx:if="{{!figmaState}}" active="Account" disabled="{{busy}}"/>
</view>
