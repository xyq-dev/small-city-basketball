<view class="page account-page {{!user && !loading ? 'account-login' : ''}}">
  <view wx:if="{{loading}}" class="card account-loading" role="status"><view class="subtitle">正在核对当前账号</view><view class="muted">读取当前登录状态与微信服务能力，请稍候。</view></view>
  <block wx:else>
    <view wx:if="{{message}}" class="notice account-feedback {{messageTone==='error' ? 'danger' : messageTone==='success' ? 'success' : ''}}" role="{{messageTone==='error' ? 'alert' : 'status'}}">{{message}}</view>
    <block wx:if="{{user && !securityOpen}}">
      <view class="hero account-hero"><view class="title">我的球赛主场</view><view class="muted">{{user.displayName}} · 按实际权限进入</view></view>
      <view wx:if="{{hasReturn}}" class="account-continue"><button class="primary" bindtap="continue" disabled="{{busy}}">继续刚才的操作</button></view>
      <view class="menu-group">
        <view class="menu-title">赛事</view>
        <view class="menu-row" data-page="watch" bindtap="go"><scb-icon name="trophy" size="20"/><view class="menu-text"><view>我的赛事</view><view class="menu-sub">{{roles.length ? roleSummary : '暂无机构赛事身份，可打开主办方分享的观赛链接'}}</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></view>
        <view wx:if="{{roles.length}}" class="menu-row" data-page="watch" bindtap="go"><scb-icon name="calendar" size="20"/><view class="menu-text"><view>赛事管理</view><view class="menu-sub">选择赛事后进入排赛、晋级发布、改期与比赛媒体</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></view>
        <view wx:if="{{roles.length}}" class="menu-row" data-page="scoring-tasks" bindtap="go"><scb-icon name="clock" size="20"/><view class="menu-text"><view>记分与赛果确认</view><view class="menu-sub">被分配或可管理的比赛</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></view>
        <view class="menu-row" data-page="follows" bindtap="go"><scb-icon name="chat" size="20"/><view class="menu-text"><view>我的关注</view><view class="menu-sub">收藏公开赛事，微信提醒尚未启用</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></view>
      </view>
      <view class="menu-group">
        <view class="menu-title">球队</view>
        <view class="menu-row" data-page="teams" bindtap="go"><scb-icon name="users" size="20"/><view class="menu-text"><view>我的球队与本届报名</view><view class="menu-sub">{{teamCount ? '可管理 ' + teamCount + ' 支球队' : '接受球队邀请后在此管理'}}</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></view>
        <view class="menu-row" data-page="invitation" bindtap="go"><scb-icon name="check" size="20"/><view class="menu-text"><view>接受球队邀请</view><view class="menu-sub">使用主办方发给本人的邀请</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></view>
        <view class="menu-row" data-page="memberships" bindtap="go"><scb-icon name="users" size="20"/><view class="menu-text"><view>我的成员关系</view><view class="menu-sub">查看已加入的球队或退出</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></view>
        <view class="menu-row" data-page="team-join" bindtap="go"><scb-icon name="check" size="20"/><view class="menu-text"><view>加入球队与成员认领</view><view class="menu-sub">使用加入码，或接受发给本人的认领</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></view>
        <view class="menu-row" data-page="team-request" bindtap="go"><scb-icon name="users" size="20"/><view class="menu-text"><view>申请建队</view><view class="menu-sub">使用机构分享的申请入口，查看申请进度</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></view>
      </view>
      <view wx:if="{{managedOrgs.length}}" class="menu-group">
        <view class="menu-title">机构管理</view>
        <block wx:for="{{managedOrgs}}" wx:key="id">
          <view class="menu-row" data-page="team-requests" data-org="{{item.id}}" bindtap="go"><scb-icon name="users" size="20"/><view class="menu-text"><view>建队申请审批</view><view class="menu-sub">{{item.name}}</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></view>
          <view class="menu-row" data-page="seasons" data-org="{{item.id}}" bindtap="go"><scb-icon name="chart" size="20"/><view class="menu-text"><view>私有赛季管理</view><view class="menu-sub">{{item.name}} · 仅机构内已授权统计</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></view>
        </block>
      </view>
      <view class="menu-group">
        <view class="menu-title">我的赛季</view>
        <view class="menu-row" data-page="season-grants" bindtap="go"><scb-icon name="chart" size="20"/><view class="menu-text"><view>私有赛季授权与本人数据</view><view class="menu-sub">本人同意后计入，可查看或撤销授权</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></view>
      </view>
      <view class="menu-group">
        <view class="menu-title">扩展服务 · 球员预约</view>
        <view class="menu-row" data-page="bookings" bindtap="go"><scb-icon name="calendar" size="20"/><view class="menu-text"><view>我发出的球员预约</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></view>
        <view class="menu-row" data-page="player-center" bindtap="go"><scb-icon name="user" size="20"/><view class="menu-text"><view>本人球员中心与收到的预约</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></view>
        <view class="menu-row" data-page="performance" bindtap="go"><scb-icon name="chart" size="20"/><view class="menu-text"><view>我的比赛数据授权</view><view class="menu-sub">本人同意与主办方数据提名</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></view>
      </view>
      <view class="menu-group">
        <view class="menu-title">账号</view>
        <view class="menu-row" bindtap="showSecurity"><scb-icon name="shield" size="20"/><view class="menu-text"><view>账号与微信绑定</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></view>
        <view class="menu-row" data-page="planned" data-kind="messages" bindtap="go"><scb-icon name="chat" size="20"/><view class="menu-text"><view>微信提醒说明</view><view class="menu-sub">关注已开放，订阅消息尚未启用</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></view>
        <view wx:if="{{platformOperator}}" class="menu-row" data-page="platform" bindtap="go"><scb-icon name="info" size="20"/><view class="menu-text"><view>平台服务资料与独立处理</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></view>
      </view>
      <view class="account-actions">
        <button class="secondary" bindtap="switchAccount" disabled="{{busy}}">切换账号</button>
        <button class="quiet" bindtap="logout" disabled="{{busy}}">退出登录</button>
      </view>
    </block>
    <block wx:elif="{{user}}">
      <view class="notice {{connected ? 'warning' : ''}} account-notice"><view class="account-notice-title">{{connected ? '解绑会退出全部设备会话' : '绑定已有应用账号'}}</view><view class="small">{{connected ? '请重新验证当前密码。解绑后可使用应用账号重新登录。' : '重新验证当前密码并明确同意绑定，不按昵称或同名自动合并身份。'}}</view></view>
      <view class="card account-identity"><view class="subtitle">{{connected ? '微信身份已绑定' : '当前应用账号'}}</view><view wx:if="{{connected}}" class="badge success">已绑定当前微信身份</view><view class="account-user">{{user.displayName}}</view><view class="muted">{{user.email}}</view><view class="small muted">已有账号，不改变球队或机构授权</view></view>
      <view wx:if="{{!enabled && !connected}}" class="notice warning account-notice"><view class="account-notice-title">微信登录尚未配置</view><view class="small">当前无法绑定微信，可以继续使用应用账号。</view></view>
      <view class="account-field"><view class="field-label">重新验证应用密码</view><input disabled="{{busy}}" class="field" data-field="password" value="{{password}}" password bindinput="input" placeholder="请输入当前账号密码" maxlength="256"/><view class="account-hint">仅用于本次绑定或解绑验证</view></view>
      <checkbox-group bindchange="consent"><label class="consent account-consent"><checkbox disabled="{{busy}}" value="yes" checked="{{consent}}"/><text>我明确同意本次微信身份认证或解绑，不按昵称合并账号。</text></label></checkbox-group>
      <view class="small muted account-privacy">微信身份只关联当前账号，不采集微信头像、昵称、手机号或 unionid。重新启动后需登录。</view>
      <button wx:if="{{!connected}}" class="primary" bindtap="bind" disabled="{{busy || !enabled || !consent}}">确认绑定当前微信</button>
      <button wx:else class="danger" bindtap="unbind" disabled="{{busy || !consent}}">确认解绑并退出全部设备</button>
      <button class="secondary" bindtap="closeSecurity" disabled="{{busy}}">保留当前设置并返回</button>
      <button class="quiet" bindtap="load" disabled="{{busy || loading}}">刷新当前账号</button>
      <button class="quiet" data-page="planned" data-kind="funds" bindtap="go" disabled="{{busy}}">费用与资金说明</button>
      <button class="quiet" bindtap="logout" disabled="{{busy}}">退出当前登录</button>
    </block>
    <block wx:else>
      <view class="hero account-hero"><view class="title">{{registerMode ? '创建个人账号' : '登录你的已有账号'}}</view><view class="muted">{{hasReturn ? '成功后返回本次选择和原请求核对入口' : '登录后进入本人有权的球队与球员服务'}}</view></view>
      <view class="account-field"><view class="field-label">{{registerMode ? '注册邮箱' : '账号或邮箱'}}</view><input disabled="{{busy}}" class="field" data-field="email" value="{{email}}" bindinput="input" maxlength="254" placeholder="请输入已有账号或邮箱"/><view class="account-hint">{{registerMode ? '使用本人可接收邮件的邮箱' : '核对后继续'}}</view></view>
      <view wx:if="{{registerMode}}" class="account-field"><view class="field-label">显示名称</view><input disabled="{{busy}}" class="field" data-field="displayName" value="{{displayName}}" bindinput="input" maxlength="80" placeholder="请输入本人显示名称"/><view class="account-hint">仅创建服务端允许的个人参与账号</view></view>
      <view class="account-field"><view class="field-label">应用密码</view><input disabled="{{busy}}" class="field" data-field="password" password value="{{password}}" bindinput="input" maxlength="256" placeholder="请输入应用密码"/><view class="account-hint">不保存到预约恢复资料</view></view>
      <view class="card account-copy-card"><view class="subtitle">微信账号登录</view><view>仅绑定过的已有账号可使用</view><view>{{enabled ? '需要你明确同意本次微信身份认证' : '微信登录尚未配置，继续使用应用账号'}}</view></view>
      <view class="notice account-notice"><view class="account-notice-title">身份变化后重新核验</view><view class="small">不能用新账号重放前一个账号的预约内容。</view></view>
      <view wx:if="{{enabled}}" class="card">
        <checkbox-group bindchange="consent"><label class="consent account-consent"><checkbox disabled="{{busy}}" value="yes" checked="{{consent}}"/><text>我明确同意本次微信身份认证，不按昵称合并账号。</text></label></checkbox-group>
        <view class="small muted account-privacy">只关联已绑定的应用账号，不自动创建微信账号或授予球队权限。</view>
        <button class="secondary" bindtap="wechatLogin" disabled="{{busy || !enabled || !consent}}">使用已绑定的微信登录</button>
      </view>
      <button wx:else class="secondary" disabled>微信登录暂未开放</button>
      <button class="quiet" bindtap="load" disabled="{{busy || loading}}">刷新当前账号</button>
    </block>
  </block>
</view>
<view wx:if="{{!loading && !user}}" class="action-bar">
  <button wx:if="{{!registerMode}}" class="primary" bindtap="login" disabled="{{busy || loading}}" loading="{{busy}}">{{hasReturn ? '登录并返回刚才的操作' : '登录已有账号'}}</button>
  <button wx:else class="primary" bindtap="register" disabled="{{busy || loading || !canRegister}}" loading="{{busy}}">创建个人账号并登录</button>
  <button wx:if="{{canRegister || registerMode}}" class="quiet" bindtap="toggleRegister" disabled="{{busy}}">{{registerMode ? '返回已有账号登录' : '创建个人账号'}}</button>
  <button wx:else class="quiet" data-page="home" bindtap="go" disabled="{{busy}}">返回首页</button>
</view>
<scb-nav wx:if="{{user || loading}}" active="Account" disabled="{{busy}}"/>
