@import "../../styles/figma-system.wxss";

page { background:#f4f6fa; }
.account-rebuild { max-width:600px; margin:0 auto; overflow-x:hidden; }
.account-scroll { width:100%; background:#f4f6fa; }
.account-content { display:flex; width:100%; flex-direction:column; gap:12px; padding:12px 16px 24px; background:#f4f6fa; }
.account-content--state { padding-bottom:88px; }
.account-sr-only { position:absolute; width:1px; height:1px; margin:-1px; padding:0; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; }
.account-summary { display:flex; width:100%; min-height:97px; align-items:center; gap:12px; padding:14px; border-radius:16px; background:#123c73; color:#ffffff; }
.account-summary__icon { display:flex; width:44px; height:44px; flex:none; align-items:center; justify-content:center; border-radius:12px; background:#ffffff; }
.account-summary__copy { min-width:0; flex:1; }
.account-summary__eyebrow { font-size:11px; font-weight:400; line-height:16px; }
.account-summary__name { width:100%; overflow:hidden; font-size:21px; font-weight:700; line-height:30px; white-space:nowrap; text-overflow:ellipsis; }
.account-summary__subtitle { font-size:12px; font-weight:400; line-height:17px; }
.account-section { display:flex; width:100%; flex-direction:column; gap:8px; padding:14px; border-radius:16px; background:#ffffff; overflow:hidden; }
.account-section__title { color:#18283f; font-size:17px; font-weight:700; line-height:24px; }
.account-grid { display:grid; width:100%; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
.account-rebuild .account-grid__item { display:flex; width:100%; min-width:0; min-height:84px; flex-direction:column; align-items:flex-start; justify-content:flex-start; gap:4px; margin:0; padding:10px; border:0; border-radius:10px; background:#f4f6fa; color:#18283f; text-align:left; }
.account-grid__title, .account-row__title { width:100%; color:#18283f; font-size:14px; font-weight:700; line-height:20px; overflow-wrap:anywhere; }
.account-grid__subtitle, .account-row__subtitle { width:100%; color:#51657d; font-size:12px; font-weight:400; line-height:17px; overflow-wrap:anywhere; }
.account-list-section, .account-choice-section, .account-confirm-section { gap:0; }
.account-list-section .account-section__title, .account-choice-section .account-section__title, .account-confirm-section .account-section__title { margin-bottom:8px; }
.account-rebuild .account-list-row, .account-rebuild .account-choice-row, .account-rebuild .account-confirm-row { display:flex; width:100%; min-height:55px; align-items:center; gap:8px; margin:0; padding:0; border:0; border-radius:0; background:#ffffff; color:#18283f; text-align:left; }
.account-rebuild .account-list-row::after, .account-rebuild .account-choice-row::after { border:0; }
.account-rebuild .account-choice-row { height:55px; }
.account-choice-row + .account-choice-row { margin-top:8px; }
.account-list-row + .account-list-row { border-top:1px solid #e6ebf2; }
.account-list-row > view:first-child, .account-choice-row > view:nth-child(2), .account-confirm-row > view:nth-child(2) { min-width:0; flex:1; }
.account-choice-row__mark { width:18px; height:18px; flex:none; border:1px solid #7c8ea5; border-radius:50%; background:#ffffff; }
.account-status { flex:none; padding:3px 7px; border-radius:7px; background:#f4f6fa; color:#51657d; font-size:11px; font-weight:400; line-height:16px; white-space:nowrap; }
.account-status.is-open { background:#e5f7ee; color:#166b47; }
.account-status.is-error { background:#fdecef; color:#c83f42; }
.account-state-hero { display:flex; width:100%; min-height:112px; flex-direction:column; justify-content:center; gap:8px; padding:16px; border-radius:16px; background:#eaf2fc; }
.account-state-hero__title { color:#18283f; font-size:17px; font-weight:700; line-height:24px; }
.account-state-hero__body { color:#18283f; font-size:14px; line-height:22px; }
.account-state-section { gap:8px; }
.account-state-row,.account-state-step { display:flex; width:100%; min-height:55px; align-items:center; gap:8px; padding:0 10px; border-radius:8px; background:#eaf2fc; }
.account-state-dot { width:7px; height:7px; flex:none; border-radius:50%; background:#123c73; }
.account-state-copy { min-width:0; flex:1; }
.account-state-step { padding-right:0; padding-left:0; background:#fff; }
.account-state-step__mark { display:flex; width:20px; height:20px; flex:none; align-items:center; justify-content:center; border-radius:50%; background:#eaf2fc; color:#123c73; font-size:11px; font-weight:700; }
.account-state-actions { position:fixed; z-index:30; right:0; bottom:0; left:0; display:grid; grid-template-columns:152px minmax(0,1fr); gap:8px; padding:8px 16px calc(8px + env(safe-area-inset-bottom)); border-top:1px solid #e6ebf2; background:#fff; }
.account-state-actions .account-pill { padding-right:12px; padding-left:12px; white-space:nowrap; }
.account-page-actions { display:grid; width:100%; min-height:56px; grid-template-columns:2fr 3fr; align-items:center; gap:8px; }
.account-rebuild .account-pill { display:flex; width:100%; min-width:0; height:48px; min-height:48px; align-items:center; justify-content:center; gap:8px; margin:0; padding:0 16px; border:0; border-radius:24px; font-size:16px; font-weight:500; line-height:24px; text-align:center; }
.account-rebuild .account-pill.is-orange { background:#f28c28; color:#18283f; }
.account-rebuild .account-pill.is-navy { background:#123c73; color:#ffffff; }
.account-rebuild .account-pill.is-wechat { background:#07c160; color:#18283f; }
.account-rebuild .account-pill.is-ghost { border:1px solid #7c8ea5; background:#ffffff; color:#123c73; }
.account-rebuild .account-pill.is-danger { background:#fdecef; color:#c83f42; }
.account-rebuild .account-pill[disabled] { border-color:#e6ebf2; background:#e6ebf2; color:#7c8ea5; }
.account-spinner { width:18px; height:18px; flex:none; border:2px solid currentColor; border-right-color:transparent; border-radius:50%; animation:account-spin .8s linear infinite; }
@keyframes account-spin { to { transform:rotate(360deg); } }
.account-security { gap:12px; }
.account-security__name { color:#123c73; font-size:18px; font-weight:700; line-height:26px; }
.account-field { display:flex; width:100%; flex-direction:column; gap:6px; }
.account-field__label { color:#18283f; font-size:14px; font-weight:500; line-height:22px; }
.account-field__control { width:100%; height:48px; min-height:48px; padding:0 12px; border:1px solid #7c8ea5; border-radius:12px; background:#ffffff; color:#18283f; font-size:16px; line-height:24px; }
.account-check, .account-confirm-row { display:flex; width:100%; min-height:55px; align-items:center; gap:8px; color:#18283f; font-size:13px; line-height:20px; }
.account-check checkbox, .account-confirm-row checkbox { width:20px; height:20px; flex:none; }
.account-rebuild .account-legal-row { position:relative; margin-top:17px; border:0; }
.account-rebuild .account-legal-row::before { position:absolute; top:-9px; right:0; left:0; height:1px; background:#e6ebf2; content:""; }
.account-rebuild .account-legal-row > .account-legal-row__mark { width:18px; min-width:18px; height:18px; flex:none; border:1px solid #7c8ea5; border-radius:3px; background:#ffffff; }
.account-rebuild .account-legal-row > view:nth-child(2) { min-width:0; flex:1; }
.account-agreement, .account-consent-panel { display:flex; flex-direction:column; gap:8px; margin-top:8px; padding:12px; border-radius:12px; background:#f4f6fa; }
.account-agreement button, .account-inline-link, .account-email-links button { min-width:44px; min-height:44px; align-self:flex-start; margin:0; padding:0 8px; border:0; border-radius:0; background:transparent; color:#123c73; font-size:13px; font-weight:500; line-height:20px; }
.account-email-section { gap:12px; }
.account-email-links { display:flex; justify-content:space-between; gap:8px; }
.account-guest-section .account-grid__item:last-child { grid-column:1; }
@media (max-width:360px) {
  .account-content { padding-right:12px; padding-left:12px; }
  .account-section, .account-summary { padding:12px; }
  .account-page-actions { grid-template-columns:minmax(104px,2fr) minmax(0,3fr); }
  .account-rebuild .account-pill { padding-right:12px; padding-left:12px; font-size:15px; }
}
