.org-event-page { padding-bottom:calc(92px + env(safe-area-inset-bottom)); }
.org-event-hero { padding:16px; border-radius:16px; background:#fff; color:#18283f; margin-bottom:12px; }
.org-event-status { display:inline-block; padding:2px 10px; border-radius:24px; background:#eaf0f8; color:#123c73; font-size:12px; line-height:20px; }
.org-event-status.live { background:#f28c28; }
.org-event-name { margin:8px 0 4px; font-size:18px; line-height:28px; font-weight:700; overflow-wrap:anywhere; }
.org-event-meta { font-size:14px; line-height:22px; color:#63758b; }
.page.org-event-page button { width:100%; margin-left:0; margin-right:0; }
.org-event-tabs { display:flex; gap:8px; margin-bottom:12px; }
.org-event-tabs button { flex:1; min-width:0; margin:0; padding:10px 4px; font-size:14px; color:#63758b; background:#fff; }
.org-event-tabs button.selected { color:#fff; background:#123c73; }
.org-event-tabs button.selected::after { border:none; }
.org-bracket-head { margin:8px 0; }
.org-round-label { margin:12px 0 6px; color:#63758b; font-size:12px; line-height:20px; font-weight:600; }
.org-uncollected .subtitle { font-size:16px; }
.manage-card .subtitle { margin-bottom:8px; }
.manage-links { display:flex; flex-direction:column; gap:8px; margin:12px 0; }
.page.org-event-page .manage-links button { flex:1; min-width:0; margin:0; }
.page.org-event-page .manage-links button { text-align:left; border-radius:12px; padding:12px; }
.manage-sub { display:block; color:#63758b; font-size:12px; line-height:18px; font-weight:400; }
.page.org-event-page .mode-choice button { margin:0; }
