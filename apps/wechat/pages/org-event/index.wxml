<scb-header title="赛事工作台" disabled="{{loading}}"/>
<view class="figma-page org-event-page">
  <view class="figma-page__content figma-page__content--actions">
    <figma-skeleton wx:if="{{loading && !event}}" rows="4"/>
    <block wx:if="{{!loading && !event}}">
      <figma-feedback wx:if="{{unavailable}}" type="pending" title="无法查看该赛事" body="{{error || '请从赛事列表重新进入。'}}" action-label="返回赛事列表" bind:action="events"/>
      <figma-feedback wx:else type="error" title="暂时无法读取赛事" body="{{error || '请从赛事列表重新进入。'}}" action-label="重新读取" bind:action="load"/>
      <button wx:if="{{!unavailable}}" class="figma-action figma-action--ghost" bindtap="events">返回赛事列表</button>
    </block>

    <block wx:if="{{event}}">
      <figma-feedback wx:if="{{error}}" type="error" title="部分资料未刷新" body="{{error}}" action-label="重新读取" bind:action="load" disabled="{{loading}}"/>
      <figma-feedback wx:if="{{notice}}" type="success" title="操作已确认" body="{{notice}}"/>

      <view class="org-event-summary">
        <view class="org-event-summary__copy"><view class="figma-eyebrow">机构管理</view><view class="org-event-summary__title">{{event.name}}</view><view class="figma-subtitle">{{event.name}} · 当前机构授权赛事管理工作区。</view></view>
        <image class="org-event-summary__image" src="/assets/home/event-court.jpg" mode="aspectFill"/>
      </view>

      <view class="org-event-tabs" role="tablist">
        <button class="org-event-tab {{tab === 'manage' ? 'is-active' : ''}}" data-tab="manage" bindtap="tab" disabled="{{loading}}">办赛</button>
        <button class="org-event-tab {{tab === 'schedule' ? 'is-active' : ''}}" data-tab="schedule" bindtap="tab" disabled="{{loading}}">赛程</button>
        <button class="org-event-tab {{tab === 'ranking' || tab === 'stats' ? 'is-active' : ''}}" data-tab="ranking" bindtap="tab" disabled="{{loading}}">积分与数据</button>
      </view>

      <block wx:if="{{tab === 'manage'}}">
        <view class="figma-section">
          <view class="figma-section__title">办赛进度</view>
          <view class="org-event-step"><view class="org-event-step__mark">1</view><view class="org-event-step__copy"><view class="figma-row__title">赛事规则</view><view class="figma-row__subtitle">资料保存后开放报名</view></view><view class="figma-status figma-status--green">已完成</view></view>
          <view class="org-event-step"><view class="org-event-step__mark">2</view><view class="org-event-step__copy"><view class="figma-row__title">球队报名</view><view class="figma-row__subtitle">核对各队报名和本人资料</view></view><view class="figma-status figma-status--orange">{{manage && manage.review ? '进行中' : '待办理'}}</view></view>
          <view class="org-event-step"><view class="org-event-step__mark">3</view><view class="org-event-step__copy"><view class="figma-row__title">冻结与排程</view><view class="figma-row__subtitle">名单冻结后生成赛程</view></view><view class="figma-status {{matches.length ? 'figma-status--green' : 'figma-status--orange'}}">{{matches.length ? '已排程' : '待办理'}}</view></view>
        </view>

        <view wx:if="{{manage}}" class="figma-section">
          <view class="figma-section__title">赛事待办</view>
          <button wx:if="{{manage.review}}" class="figma-row" bindtap="openReview"><view class="figma-row__copy"><view class="figma-row__title">本届报名审核</view><view class="figma-row__subtitle">{{manage.reviewLabel}}</view></view><view class="figma-status figma-status--orange">待审核</view></button>
          <button class="figma-row" data-page="staff-configuration" bindtap="openFeature"><view class="figma-row__copy"><view class="figma-row__title">赛事工作人员</view><view class="figma-row__subtitle">核对赛事与单场人员范围</view></view><view class="figma-status figma-status--orange">查看</view></button>
        </view>

        <view wx:if="{{manage}}" class="figma-section">
          <view class="figma-section__title">办赛工具</view>
          <view class="figma-grid">
      <button class="figma-grid__item" bindtap="openSetup"><figma-icon name="event" size="20"/><view class="figma-row__title">赛事设置</view><view class="figma-row__subtitle">报名、记分与积分规则</view><view class="figma-status figma-status--orange">打开</view></button>
            <button class="figma-grid__item" bindtap="openSchedule"><figma-icon name="workbench" size="20"/><view class="figma-row__title">排赛与晋级</view><view class="figma-row__subtitle">分组、时段与冲突检查</view><view class="figma-status figma-status--orange">打开</view></button>
            <button class="figma-grid__item" data-tab="schedule" bindtap="tab"><figma-icon name="media" size="20"/><view class="figma-row__title">比赛媒体</view><view class="figma-row__subtitle">从正式比赛详情进入</view><view class="figma-status figma-status--orange">按场次</view></button>
          </view>
        </view>

        <view wx:if="{{manage}}" class="figma-section org-event-links">
          <view class="figma-section__title">相关服务</view>
          <button class="org-event-link" bindtap="openSchedule"><figma-icon name="court" size="19"/><text>赛程与场地</text></button>
          <button wx:if="{{event.format !== 'ROUND_ROBIN' && event.format !== 'DOUBLE_ROUND_ROBIN'}}" class="org-event-link" bindtap="openBracket"><figma-icon name="workbench" size="19"/><text>分组与淘汰晋级</text></button>
          <button class="org-event-link" data-tab="schedule" bindtap="tab"><figma-icon name="workbench" size="19"/><text>选择一场已排比赛</text></button>
        </view>

        <view wx:if="{{manage}}" class="figma-section org-event-links">
          <view class="figma-section__title">授权办赛工具</view>
          <button class="org-event-link" data-page="youth-review" bindtap="openFeature"><figma-icon name="guardian" size="20"/><text>青少年与监护独立审核</text></button>
          <button class="org-event-link" data-page="poster" bindtap="openFeature"><figma-icon name="poster" size="20"/><text>授权宣传海报</text></button>
          <button class="org-event-link" data-page="trade-manage" bindtap="openFeature"><figma-icon name="transaction" size="20"/><text>报名费、保证金与收款条款</text></button>
          <button class="org-event-link" data-page="recruitment" bindtap="openFeature"><figma-icon name="recruitment" size="20"/><text>公开招募与本届邀请</text></button>
          <button class="org-event-link" data-page="match-exceptions" bindtap="openFeature"><figma-icon name="whistle" size="20"/><text>弃权与取消规则</text></button>
          <button wx:if="{{manage.seasonGrants}}" class="org-event-link" bindtap="openSeasonGrants"><figma-icon name="season" size="20"/><text>私有赛季数据提名</text></button>
        </view>
      </block>

      <block wx:if="{{tab === 'schedule'}}">
        <figma-feedback wx:if="{{scheduleError}}" type="error" title="赛程暂时无法读取" body="{{scheduleError}}"/>
        <figma-feedback wx:elif="{{!matches.length}}" type="empty" title="暂无正式赛程" body="报名冻结并发布赛程后，这里显示时间、场地和对阵。"/>
        <view wx:for="{{matches}}" wx:key="id" class="org-match-card" data-id="{{item.id}}" bindtap="openMatch">
          <view class="org-match-card__meta">{{item.roundLabel}} · {{item.timeLabel}} · {{item.courtName}}</view>
          <view class="org-match-card__teams"><text>{{item.home}}</text><text class="org-match-card__vs">VS</text><text>{{item.away}}</text></view>
          <view class="org-match-card__footer"><view class="figma-status {{item.status === 'IN_PROGRESS' || item.status === 'LIVE' ? 'figma-status--orange' : ''}}">{{item.statusLabel}}</view><text>比分与记录</text></view>
        </view>
        <view wx:if="{{matchesTruncated}}" class="figma-caption">仅显示前 1000 场，请在 Web 查看完整赛程。</view>
        <view class="figma-section"><view class="figma-section__hint">点击比赛查看比分、记录与确认状态。被分配的记分员可从比赛详情进入记分台；赛果须由他人独立确认后才计入正式积分。</view></view>
      </block>

      <block wx:if="{{tab === 'ranking' || tab === 'stats'}}">
        <view class="org-data-switch"><button class="{{tab === 'ranking' ? 'is-active' : ''}}" data-tab="ranking" bindtap="tab">积分排名</button><button class="{{tab === 'stats' ? 'is-active' : ''}}" data-tab="stats" bindtap="tab">球员数据</button></view>
      </block>

      <block wx:if="{{tab === 'ranking'}}">
        <figma-feedback wx:if="{{rankingError}}" type="error" title="积分与晋级资料不可用" body="{{rankingError}}"/>
        <block wx:elif="{{ranking && ranking.kind === 'standings'}}">
          <figma-feedback wx:if="{{!ranking.rows.length}}" type="empty" title="积分榜待生成" body="需要先设置积分规则并发布正式赛程。"/>
          <view wx:else class="figma-section org-table-card"><view class="org-section-heading"><view><view class="figma-section__title">积分排名</view><view class="figma-section__hint">{{ranking.modeLabel}}</view></view><view class="figma-status">{{ranking.progress}}</view></view><scroll-view class="org-table" scroll-x="{{true}}"><view class="org-table-row is-head"><text class="rank-cell">名次</text><text class="team-cell">球队</text><text>胜负</text><text>净胜</text><text>积分</text></view><view wx:for="{{ranking.rows}}" wx:key="key" class="org-table-row"><text class="rank-cell">{{item.rankLabel}}</text><text class="team-cell">{{item.teamName}}{{item.tied ? ' · 并列' : ''}}</text><text>{{item.record}}</text><text>{{item.diff}}</text><text class="org-strong">{{item.points}}</text></view></scroll-view></view>
        </block>
        <block wx:elif="{{ranking && ranking.kind === 'groups'}}">
          <view wx:if="{{ranking.qualificationLabel}}" class="figma-section"><view class="figma-section__hint">{{ranking.qualificationLabel}}。组内同分须明确抽签，不生成跨组总排名。</view></view>
          <figma-feedback wx:if="{{!ranking.groups.length}}" type="empty" title="分组尚未发布" body="主办方发布分组赛程后显示各组排名。"/>
          <view wx:for="{{ranking.groups}}" wx:key="key" wx:for-item="group" class="figma-section org-table-card"><view class="org-section-heading"><view class="figma-section__title">{{group.label}}</view><view class="figma-status">{{group.progress}}</view></view><view wx:if="{{group.tieBreakRequired}}" class="org-alert">同分待抽签，出线资格尚未确定</view><scroll-view class="org-table" scroll-x="{{true}}"><view class="org-table-row is-head"><text class="rank-cell">名次</text><text class="team-cell">球队</text><text>胜负</text><text>积分</text></view><view wx:for="{{group.rows}}" wx:key="key" class="org-table-row"><text class="rank-cell">{{item.rankLabel}}</text><text class="team-cell">{{item.teamName}}</text><text>{{item.record}}</text><text class="org-strong">{{item.points}}</text></view></scroll-view></view>
        </block>
        <block wx:if="{{!rankingError && ranking && ranking.bracket}}">
          <view class="figma-section"><view class="org-section-heading"><view class="figma-section__title">淘汰签位</view><view class="figma-status">{{ranking.bracket.progress}}</view></view><block wx:for="{{ranking.bracket.rounds}}" wx:key="roundNo" wx:for-item="round"><view class="org-round-label">{{round.label}}{{round.published ? '' : ' · 待发布'}}</view><view wx:for="{{round.slots}}" wx:key="key" class="org-bracket-slot"><view class="figma-row__title">{{item.bye ? item.bye + ' · 轮空' : item.home + ' VS ' + item.away}}</view><view class="figma-row__subtitle">{{item.label}} {{item.statusLabel}}{{item.winner ? ' · ' + item.winnerLabel + '：' + item.winner : ''}}</view></view></block></view>
          <view wx:if="{{ranking.bracket.isComplete && ranking.bracket.placements.length}}" class="figma-section"><view class="figma-section__title">最终名次</view><view wx:for="{{ranking.bracket.placements}}" wx:key="key" class="figma-row"><view class="figma-row__title">{{item.rank}} · {{item.teamName}}{{item.tied ? '（并列）' : ''}}</view></view></view>
        </block>
        <figma-feedback wx:if="{{!rankingError && ranking && ranking.kind === 'bracket' && !ranking.bracket}}" type="empty" title="签位尚未生成" body="报名冻结并发布首轮后显示淘汰签位。"/>
        <button wx:if="{{publicEventId}}" class="figma-action figma-action--ghost" bindtap="openPublic">打开公开观赛页</button>
      </block>

      <block wx:if="{{tab === 'stats'}}">
        <figma-feedback wx:if="{{statsError}}" type="error" title="球员数据不可用" body="{{statsError}}"/>
        <figma-feedback wx:elif="{{stats && stats.empty}}" type="empty" title="暂无个人数据" body="尚无正式赛程或逐人采集的确认赛果。"/>
        <block wx:elif="{{stats}}">
          <view class="figma-section"><view class="figma-section__title">数据覆盖</view><view class="figma-section__hint">{{stats.progress}} · {{stats.coverageLabel}}</view><view wx:if="{{stats.administrativeLabel}}" class="figma-section__hint">{{stats.administrativeLabel}}</view><view wx:if="{{stats.attributionLabel}}" class="org-alert">{{stats.attributionLabel}}</view><view wx:if="{{stats.pendingLabel}}" class="org-alert">{{stats.pendingLabel}}</view></view>
          <view class="figma-section org-table-card"><view class="figma-section__title">本届得分榜</view><scroll-view class="org-table" scroll-x="{{true}}"><view class="org-table-row is-head"><text class="rank-cell">名次</text><text class="team-cell">球员</text><text>得分</text><text>犯规</text><text>名单场次</text></view><view wx:for="{{stats.rows}}" wx:key="key" class="org-table-row"><text class="rank-cell">{{item.rankLabel}}</text><view class="team-cell"><view>{{item.name}} · {{item.jerseyNo}}号</view><view class="figma-caption">{{item.teamName}}</view></view><text class="org-strong">{{item.score}}</text><text>{{item.fouls}}</text><text>{{item.samples}}</text></view></scroll-view><view wx:if="{{!stats.rows.length}}" class="figma-section__hint">已确认比赛中暂无逐人得分。</view><view wx:if="{{stats.truncated}}" class="figma-section__hint">仅显示前 50 名。</view></view>
          <view class="figma-section"><view class="figma-section__title">专业统计与实际上场时间</view><view class="figma-section__hint">本页汇总得分与犯规。投篮、篮板等专业数据和实际时间，请查看已启用专业采集的单场报表；未启用的场次显示未统计。“名单场次”不代表实际上场。</view><button class="figma-action figma-action--ghost" bindtap="openTasks">选择比赛查看记分与报表</button></view>
        </block>
      </block>

      <view wx:if="{{manage && manage.progress}}" class="figma-section org-lifecycle">
        <view class="figma-section__title">赛事管理与完赛</view>
        <view class="figma-section__hint">{{manage.progress}}{{manage.ready ? ' · 已满足完赛条件' : ''}}</view>
        <view wx:for="{{manage.blockers}}" wx:key="*this" class="org-alert">{{item}}</view>
        <view wx:if="{{manage.actions.length}}" class="org-lifecycle__choices"><button wx:for="{{manage.actions}}" wx:key="type" class="{{lifecycleAction === item.type ? 'is-active' : ''}}" data-type="{{item.type}}" bindtap="chooseLifecycle">{{item.label}}</button></view>
        <block wx:if="{{lifecycleAction}}"><label class="figma-field-group"><view class="figma-field-label">原因（4–500 字）</view><textarea class="figma-field-control" maxlength="500" value="{{lifecycleReason}}" bindinput="lifecycleInput" placeholder="例如：全部比赛已独立确认"/></label><button class="figma-action figma-action--navy" bindtap="runLifecycle" disabled="{{loading}}">确认执行</button></block>
      </view>
    </block>
  </view>

  <view wx:if="{{event}}" class="figma-fixed-actions">
    <button class="figma-action figma-action--ghost" bindtap="openSetup" disabled="{{loading || !manage}}">查看赛事设置</button>
    <button class="figma-action figma-action--orange" bindtap="openReview" disabled="{{loading || !manage || !manage.review}}">进入报名审核</button>
  </view>
</view>
