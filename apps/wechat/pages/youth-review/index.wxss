@import "../../styles/figma-pages.wxss";

.youth-review-step {
  display: flex;
  min-height: 56px;
  align-items: center;
  gap: 10px;
}

.youth-review-step__mark {
  display: flex;
  width: 22px;
  height: 22px;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eaf2fc;
  color: #123c73;
  font-size: 12px;
  font-weight: 700;
}

.youth-review-step > view:nth-child(2) {
  min-width: 0;
  flex: 1;
}

.youth-purpose,
.youth-private {
  padding: 12px;
  border-radius: 10px;
  background: #eaf2fc;
  color: #51657d;
  font-size: 12px;
  line-height: 19px;
}

.youth-review-rebuild .youth-text-action {
  display: flex;
  min-height: 44px;
  align-items: center;
  padding: 0;
  border: 0;
  background: transparent;
  color: #123c73;
  font-size: 13px;
}
