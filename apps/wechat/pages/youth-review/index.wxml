<scb-header title="监护关系审核" disabled="{{busy || pending}}"/>
<view class="figma-page youth-review-rebuild">
  <view class="figma-page__content figma-page__content--actions">
    <view class="figma-summary">
      <view class="figma-summary__icon"><figma-icon name="shield" size="28"/></view>
      <view class="figma-summary__copy"><view class="figma-eyebrow">独立审核人员</view><view class="figma-title">{{policy ? policy.eventName + ' · ' : ''}}青年报名</view><view class="figma-subtitle">只核验本届指定人员和当前证明版本</view></view>
    </view>
    <figma-tabs key1="pending" label1="待核验" key2="history" label2="历史记录" active="{{activeView}}" disabled="{{busy || loading}}" bind:change="changeView"/>
    <figma-skeleton wx:if="{{loading && !requests.length}}" rows="4"/>
    <figma-feedback wx:if="{{error}}" type="error" title="审核队列读取失败" body="{{error}}" action-label="重新读取" disabled="{{busy || loading}}" bind:action="load"/>
    <figma-feedback wx:if="{{message}}" type="success" title="审核状态已更新" body="{{message}}"/>
    <figma-feedback wx:if="{{pending}}" type="warning" title="原请求结果待核对" body="核对回执前暂停新的关系审核，避免重复处理。" action-label="重新核对" disabled="{{busy || loading}}" bind:action="load"/>

    <view wx:if="{{review && policy && policy.canConfigure}}" class="figma-section">
      <view class="figma-section__title">本届青年报名设置</view>
      <view class="figma-section__hint">仅在开放报名前配置；必要资料处理、本人确认和监护关系审核仍分别进行。</view>
      <checkbox-group data-field="policyEnabled" bindchange="checkbox"><label class="figma-check"><checkbox value="yes" checked="{{policyEnabled}}" disabled="{{busy || pending || loading}}"/><text>开放本届青年报名流程</text></label></checkbox-group>
      <view class="figma-field-group"><view class="figma-field-label">监护年龄阈值（18至21）</view><input class="figma-field-control" data-field="threshold" value="{{threshold}}" bindinput="field" type="number" maxlength="2" disabled="{{busy || pending || loading}}"/></view>
      <button class="figma-action figma-action--navy" bindtap="configure" disabled="{{busy || pending || loading}}">保存本届青年规则</button>
    </view>

    <block wx:if="{{activeView === 'pending'}}">
      <view class="figma-section">
        <view class="figma-section__title">本届申请</view>
        <block wx:if="{{figmaCompactReview && selected}}">
          <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">参与者</view><view class="figma-row__subtitle">{{selected.subjectName}} · 青年报名</view></view><view class="figma-status figma-status--orange">待核验</view></view>
          <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">监护关系</view><view class="figma-row__subtitle">本届已提交私密证明</view></view><view class="figma-status figma-status--orange">待核验</view></view>
          <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">授权版本</view><view class="figma-row__subtitle">必要处理与公开用途分别留存</view></view><view class="figma-status">查看</view></view>
        </block>
        <figma-feedback wx:elif="{{!requests.length && !loading}}" type="empty" title="暂无待核验的监护关系"/>
        <block wx:else>
          <button wx:for="{{requests}}" wx:key="id" class="figma-row" data-id="{{item.id}}" bindtap="select" disabled="{{busy || loading}}">
            <view class="figma-row__copy"><view class="figma-row__title">{{item.subjectName}}</view><view class="figma-row__subtitle">{{item.eventName}} · {{item.current ? '本届已提交私密证明' : '来源版本已变化'}}</view></view>
            <view class="figma-status figma-status--orange">{{item.statusLabel}}</view>
          </button>
        </block>
        <button wx:if="{{nextCursor}}" class="figma-action figma-action--ghost" data-more="true" bindtap="load" disabled="{{busy || loading}}">加载更多</button>
      </view>

      <view wx:if="{{selected}}" class="figma-section">
        <view class="figma-section__title">独立核对</view>
        <view class="youth-review-step"><view class="youth-review-step__mark">1</view><view><view class="figma-row__title">核对本人资格</view><view class="figma-row__subtitle">读取当前有效预审结论</view></view></view>
        <view class="youth-review-step"><view class="youth-review-step__mark">2</view><view><view class="figma-row__title">私有预览证明</view><view class="figma-row__subtitle">仅限当前授权审核人</view></view></view>
        <view class="youth-review-step"><view class="youth-review-step__mark">3</view><view class="figma-row__copy"><view class="figma-row__title">独立作出结论</view><view class="figma-row__subtitle">关联人员不得自审</view></view><view class="figma-status figma-status--orange">待处理</view></view>
      </view>

      <view wx:if="{{selected}}" class="figma-section">
        <view class="figma-section__title">{{selected.subjectName}} · {{selected.statusLabel}}</view>
        <view class="figma-section__hint">V{{selected.version}} · {{selected.eventName}}</view>
        <figma-feedback wx:if="{{selected.reviewReason}}" type="warning" title="审核说明" body="{{selected.reviewReason}}"/>
        <figma-feedback wx:if="{{selected.blockerText}}" type="warning" title="当前阻塞" body="{{selected.blockerText}}"/>
        <view class="youth-purpose">本人用途：{{selected.subjectPurposeText}}<view>监护人用途：{{selected.guardianPurposeText}}</view></view>
        <button wx:if="{{selected.capabilities.canReadProof}}" class="figma-action figma-action--ghost" bindtap="reveal" disabled="{{busy || pending}}">明确查看监护人私密证明</button>
        <view wx:if="{{privateDetails}}" class="youth-private"><view>监护姓名：{{privateDetails.realName}}</view><view>监护身份证：{{privateDetails.identityNumber}}</view><view>关系声明：{{privateDetails.relationship}} · {{privateDetails.relationshipExplanation}}</view><button class="figma-action figma-action--ghost" bindtap="viewProof" disabled="{{busy || pending}}">私有查看关系证明文件</button><button class="youth-text-action" bindtap="conceal">立即隐藏并清理预览</button></view>
      </view>

      <view wx:if="{{selected && selected.capabilities.canReview}}" class="figma-section">
        <view class="figma-section__title">独立关系核验</view>
        <view class="figma-section__hint">不得由本人、监护人或关联球队成员、领队自审。</view>
        <checkbox-group data-field="identityChecked" bindchange="checkbox"><label class="figma-check"><checkbox value="yes" checked="{{identityChecked}}" disabled="{{busy || pending}}"/><text>已独立核对监护人身份、本人及当前成年状态</text></label></checkbox-group>
        <checkbox-group data-field="relationshipChecked" bindchange="checkbox"><label class="figma-check"><checkbox value="yes" checked="{{relationshipChecked}}" disabled="{{busy || pending}}"/><text>已核对必要关系证明，确认可作为当前监护关系依据</text></label></checkbox-group>
        <view class="figma-field-group"><view class="figma-field-label">核验说明（4—500字）</view><textarea class="figma-field-control" value="{{reason}}" data-field="reason" bindinput="field" maxlength="500" placeholder="不抄录身份证或证明原文" disabled="{{busy || pending}}"/></view>
        <button class="figma-action figma-action--navy" data-decision="APPROVE" bindtap="review" disabled="{{busy || pending || !identityChecked || !relationshipChecked}}">通过当前关系证明</button>
        <button class="figma-action figma-action--ghost" data-decision="REJECT" bindtap="review" disabled="{{busy || pending}}">拒绝并说明</button>
      </view>
    </block>

    <block wx:if="{{activeView === 'history'}}">
      <view class="figma-section">
        <view class="figma-section__title">历史记录</view>
        <view wx:for="{{requests}}" wx:key="id" class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{item.subjectName}} · {{item.eventName}}</view><view class="figma-row__subtitle">{{item.reviewReason || (item.current ? '当前来源版本' : '来源版本已变化')}}</view></view><view class="figma-status">{{item.statusLabel}}</view></view>
      </view>
    </block>
  </view>

  <view class="figma-fixed-actions">
    <button class="figma-action figma-action--ghost" bindtap="load" disabled="{{busy || loading}}">核对当前状态</button>
    <button class="figma-action figma-action--orange" bindtap="reveal" disabled="{{busy || pending || !selected || !selected.capabilities.canReadProof}}">查看私有关系证明</button>
  </view>
</view>
