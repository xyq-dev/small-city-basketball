<view class="page"><scb-header title="广告与赞助"/><view class="tabs"><button data-mode="manage" bindtap="mode">机构投放</button><button data-mode="review" bindtap="mode">独立审核</button><button data-mode="public" bindtap="mode">同城赞助</button></view><view wx:if="{{error}}" class="notice warning">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{loading}}">正在核对当前投放…</view><view wx:if="{{loginRequired}}"><button bindtap="login">登录</button></view><view class="notice">{{measurementNotice}}</view>
<block wx:if="{{mode==='public'}}"><view wx:if="{{!publicCard}}" class="card"><picker range="{{regions}}" range-key="path" value="{{regionIndex}}" data-field="regionIndex" bindchange="picker"><view class="picker">地区：{{regions[regionIndex].path || '请选择地区'}}</view></picker><button disabled="{{busy || loading}}" bindtap="discover">读取当前地区与时段赞助</button></view><view wx:for="{{publicItems}}" wx:key="publicKey" class="card"><view>广告／赞助 · {{item.brand}}</view><view>{{item.title}}</view><button data-key="{{item.publicKey}}" bindtap="openPublic">打开当前投放</button></view><view wx:if="{{publicCard}}" id="sponsor-public-card" class="card"><view class="ad-label">{{publicCard.label}}</view><view class="title">{{publicCard.brand}}</view><view class="subtitle">{{publicCard.title}}</view><view>{{publicCard.body}}</view><view class="small muted">投放时段 {{publicCard.startsAt}} 至 {{publicCard.endsAt}}</view><button open-type="share">分享此投放</button></view></block>
<block wx:else><view wx:if="{{pending}}" class="card">有原操作待核对。<button bindtap="recover">查询原操作</button><button data-cancel="true" bindtap="recover">明确放弃未确认操作</button></view><picker wx:if="{{mode==='manage' && organizations.length}}" range="{{organizations}}" range-key="name" value="{{orgIndex}}" bindchange="org"><view class="picker">机构：{{organizations[orgIndex].name}}</view></picker>
<view wx:if="{{mode==='manage' && organizations.length}}" class="card"><view class="subtitle">{{selected?'编辑当前投放':'创建投放草稿'}}</view><input data-field="brand" value="{{brand}}" bindinput="field" maxlength="80" placeholder="广告／赞助方名称"/><input data-field="title" value="{{title}}" bindinput="field" maxlength="120" placeholder="投放标题"/><textarea data-field="body" value="{{body}}" bindinput="field" maxlength="1000" placeholder="公开投放文案，请勿填写私人联系资料"/><picker range="{{regions}}" range-key="path" value="{{regionIndex}}" data-field="regionIndex" bindchange="picker"><view class="picker">投放地区：{{regions[regionIndex].path}}</view></picker><input data-field="eventQuery" value="{{eventQuery}}" bindinput="field" maxlength="80" placeholder="按赛事名称查找其他投放目标"/><button disabled="{{busy}}" bindtap="searchEvents">查询赛事候选</button><picker range="{{events}}" range-key="name" value="{{eventIndex}}" data-field="eventIndex" bindchange="picker"><view class="picker">定向赛事：{{events[eventIndex].name}}</view></picker><view class="small muted">时间按本机当地日期与时间填写，服务端存储绝对时刻。</view><picker mode="date" data-field="startDate" bindchange="field" value="{{startDate}}"><view class="picker">开始日期：{{startDate || '请选择'}}</view></picker><picker mode="time" data-field="startTime" bindchange="field" value="{{startTime}}"><view class="picker">开始时间：{{startTime}}</view></picker><picker mode="date" data-field="endDate" bindchange="field" value="{{endDate}}"><view class="picker">结束日期：{{endDate || '请选择'}}</view></picker><picker mode="time" data-field="endTime" bindchange="field" value="{{endTime}}"><view class="picker">结束时间：{{endTime}}</view></picker><button wx:if="{{!selected || selected.status==='DRAFT' || selected.status==='REJECTED'}}" disabled="{{busy || !!pending}}" bindtap="save">保存草稿</button><button disabled="{{busy}}" bindtap="fresh">新建另一条投放</button></view>
<view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="edit"><view class="subtitle">{{item.brand}} · {{item.title}}</view><view>{{item.statusLabel}} · 第{{item.version}}版</view><view>去重上报展示数 {{item.reportedImpressions}}</view></view><button wx:if="{{nextCursor}}" disabled="{{busy}}" bindtap="more">读取更多</button><view wx:if="{{!loading && !items.length}}" class="notice">当前没有可查看的投放。</view>
<view wx:if="{{selected}}" class="card"><view class="subtitle">{{selected.title}} · {{selected.statusLabel}}</view><view>{{selected.body}}</view><view>{{selected.reviewReason}}</view><textarea data-field="reason" value="{{reason}}" bindinput="field" maxlength="500" placeholder="提交、审核或撤销原因，至少4字"/><block wx:if="{{mode==='manage'}}"><button wx:if="{{selected.status==='DRAFT' || selected.status==='REJECTED'}}" data-type="SUBMIT" disabled="{{busy || !!pending}}" bindtap="command">提交独立审核</button><button wx:if="{{selected.status==='APPROVED' && !selected.publicKey}}" data-type="PUBLISH" disabled="{{busy || !!pending}}" bindtap="command">发布新批次</button><button wx:if="{{selected.publicKey}}" bindtap="openPublic">查看当前公开投放</button><button wx:if="{{selected.publicKey}}" data-type="REVOKE_PUBLICATION" disabled="{{busy || !!pending}}" bindtap="command">永久撤销当前公开地址</button><button wx:if="{{selected.status!=='WITHDRAWN'}}" data-type="WITHDRAW" disabled="{{busy || !!pending}}" bindtap="command">永久撤回此投放</button></block><block wx:if="{{mode==='review' && selected.status==='SUBMITTED'}}"><button data-type="APPROVE" disabled="{{busy || !!pending}}" bindtap="command">独立审核通过</button><button data-type="REJECT" disabled="{{busy || !!pending}}" bindtap="command">退回草稿修改</button></block></view></block><button disabled="{{busy || loading}}" bindtap="load">刷新当前状态</button></view>
