@import "../../styles/figma-pages.wxss";

.two-fields,.two-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.issued-box{display:flex;padding:10px;flex-direction:column;gap:8px;border-radius:12px;background:#f4f6fa}.secret-box{padding:10px;border-radius:10px;background:#fff;color:#123c73;font-size:12px;line-height:18px;overflow-wrap:anywhere}.section-primary,.section-ghost,.section-danger,.row-action{display:flex;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 12px;border-radius:22px;font-size:14px}.section-primary,.section-ghost,.section-danger{width:100%}.section-primary{border:0;background:#123c73;color:#fff}.section-ghost{border:1px solid #7c8ea5;background:#fff;color:#123c73}.section-danger{border:1px solid #c83f42;background:#fff;color:#c83f42}.row-action{min-width:56px;border:0;background:#eaf2fc;color:#123c73}.section-primary::after,.section-ghost::after,.section-danger::after,.row-action::after,.request-tab::after{border:0}.request-tabs{display:grid;height:48px;padding:2px;grid-template-columns:repeat(4,minmax(0,1fr));border-radius:14px;background:#fff}.request-tab{display:flex;min-width:0;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 3px;border:0;border-radius:12px;background:transparent;color:#51657d;font-size:12px}.request-tab.is-active{background:#123c73;color:#fff;font-weight:700}.request-row{padding:10px 0;border-top:1px solid #e6ebf2}.request-head{display:flex;min-height:44px;align-items:center;justify-content:space-between;gap:8px}@media(max-width:360px){.two-fields{grid-template-columns:1fr}}
.request-readonly{display:flex;align-items:center}.request-row>.row-action{margin-top:6px;margin-left:auto}
.requests-page .request-tabs>.request-tab{width:100%;min-width:0;max-width:none;justify-self:stretch;box-sizing:border-box}.requests-page .request-row>button.request-select{display:block;width:100%;min-width:0;max-width:none;min-height:55px;margin:0;padding:0;border:0;background:transparent;color:#18283f;text-align:left;box-sizing:border-box}.request-select::after{border:0}.request-select[disabled]{background:transparent;color:#18283f;opacity:1}
