@import "../../styles/figma-pages.wxss";

.guardian-step {
  display: flex;
  min-height: 56px;
  align-items: center;
  gap: 10px;
}

.guardian-step__mark {
  display: flex;
  width: 22px;
  height: 22px;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eaf2fc;
  color: #123c73;
  font-size: 12px;
  font-weight: 700;
}

.guardian-step > view:nth-child(2) {
  min-width: 0;
  flex: 1;
}

.guardian-record + .guardian-record {
  padding-top: 10px;
  border-top: 1px solid #e6ebf2;
}

.guardian-record__head,
.guardian-proof {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.guardian-record__head > view:first-child,
.guardian-proof > text {
  min-width: 0;
  flex: 1;
}

.guardian-terms {
  margin: 8px 0;
  padding: 12px;
  border-radius: 10px;
  background: #eaf2fc;
  color: #51657d;
  font-size: 12px;
  line-height: 19px;
}

.guardian-rebuild .guardian-text-action {
  display: flex;
  min-height: 44px;
  align-items: center;
  padding: 0;
  border: 0;
  background: transparent;
  color: #123c73;
  font-size: 13px;
  text-align: left;
}

.guardian-radio {
  display: flex;
  flex-direction: column;
  gap: 10px;
  color: #18283f;
  font-size: 13px;
}

.guardian-radio label {
  display: flex;
  min-height: 44px;
  align-items: center;
  gap: 8px;
}

.guardian-rebuild .figma-fixed-actions {
  grid-template-columns: minmax(0, 4fr) minmax(0, 5fr);
}
