.youth-page{padding-bottom:calc(100px + env(safe-area-inset-bottom));overflow-wrap:anywhere}.youth-panel{border:1px solid #e4eaf1;border-radius:12px;padding:20px;margin:16px 0}.youth-kicker,.youth-step{color:#45617f;font-size:12px;margin:8px 0}.youth-step{padding-top:12px}.youth-row{border-bottom:1px solid #e4eaf1;padding:14px 0}.youth-row:last-child{border:0}.youth-row .badge{margin:8px 0}.youth-terms{background:#f4f7fa;border-radius:8px;padding:14px;margin:12px 0;font-size:13px;line-height:22px}.youth-private{border:1px solid #e5bd80;background:#fff8ec;padding:14px;margin:12px 0;border-radius:8px}.youth-page .consent{display:flex;align-items:flex-start;gap:8px;margin:14px 0;font-size:14px;line-height:22px}.youth-page .consent checkbox,.youth-page .consent radio{flex-shrink:0}.youth-page button{white-space:normal;height:auto;min-height:44px;overflow-wrap:anywhere}.youth-page .title{margin-bottom:10px}.youth-page .field{box-sizing:border-box}@media(max-width:360px){.youth-panel{padding:16px}}
