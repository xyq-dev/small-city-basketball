.youth-page{padding-bottom:calc(100px + env(safe-area-inset-bottom));overflow-wrap:anywhere}.youth-panel{border:1px solid #e4eaf1;border-radius:12px;padding:20px;margin:16px 0}.youth-kicker,.youth-step{color:#45617f;font-size:12px;margin:8px 0}.youth-step{padding-top:12px}.youth-row{border-bottom:1px solid #e4eaf1;padding:14px 0}.youth-row:last-child{border:0}.youth-row .badge{margin:8px 0}.youth-terms{background:#f4f7fa;border-radius:8px;padding:14px;margin:12px 0;font-size:13px;line-height:22px}.youth-private{border:1px solid #e5bd80;background:#fff8ec;padding:14px;margin:12px 0;border-radius:8px}.youth-page .consent{display:flex;align-items:flex-start;gap:8px;margin:14px 0;font-size:14px;line-height:22px}.youth-page .consent checkbox,.youth-page .consent radio{flex-shrink:0}.youth-page button{white-space:normal;height:auto;min-height:44px;overflow-wrap:anywhere}.youth-page .title{margin-bottom:10px}.youth-page .field{box-sizing:border-box}@media(max-width:360px){.youth-panel{padding:16px}}

.ui002-workspace { padding:16px 16px calc(104px + env(safe-area-inset-bottom)); background:#f4f6fa; color:#18283f; }
.ui002-workspace .card { border-radius:16px; padding:16px; margin:0 0 16px; }
.ui002-workspace input,.ui002-workspace textarea,.ui002-workspace button { font-size:16px; line-height:24px; min-height:44px; }
.ui002-workspace .page-intro .title { color:#18283f; font-size:22px; line-height:32px; margin:0 0 8px; }
.ui002-workspace .page-intro { margin-bottom:16px; }
.ui002-workspace .tabs button { min-height:44px; }

.ui002-workspace .notice { font-size:14px; line-height:22px; border-radius:12px; padding:12px; }
.youth-summary { color:#18283f; }
.youth-summary-icon { display:flex; align-items:center; justify-content:center; flex:0 0 44px; width:44px; height:44px; border-radius:12px; background:#eaf2fc; }
.youth-summary-icon image { width:25px; height:25px; }
.youth-tabs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1px; min-height:44px; margin-bottom:12px; padding:2px 3px; border-radius:12px; background:#fff; color:#63758b; font-size:14px; line-height:40px; text-align:center; }
.youth-tabs > view { min-width:0; height:40px; border-radius:10px; }
.youth-tabs .selected { color:#fff; background:#123c73; font-weight:700; }
.youth-page .youth-panel { padding:14px; border:0; border-radius:16px; background:#fff; }
@media (max-width:360px) { .fig-actions button { padding-left:6px; padding-right:6px; font-size:13px; } }
