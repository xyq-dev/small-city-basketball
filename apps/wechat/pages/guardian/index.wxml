<scb-header title="青年报名与监护" disabled="{{busy || pending}}"/>
<view class="figma-page guardian-rebuild">
  <view class="figma-page__content figma-page__content--actions">
    <view class="figma-summary">
      <view class="figma-summary__icon"><figma-icon name="shield" size="28"/></view>
      <view class="figma-summary__copy"><view class="figma-eyebrow">本人及受邀监护人</view><view class="figma-title">{{policy && policy.eventName ? policy.eventName + ' · 青年报名' : '青年报名'}}</view><view class="figma-subtitle">必要资料、监护关系与公开用途逐项授权</view></view>
    </view>
    <figma-tabs key1="required" label1="必要资料" key2="subject" label2="本人确认" key3="guardian" label3="监护确认" active="{{activeView}}" disabled="{{busy || loading}}" bind:change="changeView"/>
    <figma-skeleton wx:if="{{loading && !requests.length && !preconsents.length}}" rows="4"/>
    <figma-feedback wx:if="{{error}}" type="error" title="监护资料处理未完成" body="{{error}}" action-label="重新读取" disabled="{{busy || loading}}" bind:action="load"/>
    <figma-feedback wx:if="{{message}}" type="success" title="当前状态已更新" body="{{message}}"/>
    <figma-feedback wx:if="{{pending}}" type="warning" title="原请求结果待核对" body="原请求仍可能在途；核对回执前不新建监护操作。" action-label="重新核对" disabled="{{busy || loading}}" bind:action="load"/>
    <view wx:if="{{loginRequired}}" class="figma-section"><view class="figma-section__title">登录后查看监护事项</view><button class="figma-action figma-action--orange" bindtap="login">登录并继续</button></view>

    <block wx:if="{{activeView === 'required'}}">
      <view class="figma-section">
        <view class="figma-section__title">必要资料处理</view>
        <view class="guardian-step"><view class="guardian-step__mark">1</view><view><view class="figma-row__title">邀请监护人</view><view class="figma-row__subtitle">明确指定监护人平台账号</view></view></view>
        <view class="guardian-step"><view class="guardian-step__mark">2</view><view class="figma-row__copy"><view class="figma-row__title">独立选择</view><view class="figma-row__subtitle">监护人核对本届资料处理用途</view></view><view class="figma-status figma-status--orange">待确认</view></view>
        <view class="guardian-step"><view class="guardian-step__mark">3</view><view><view class="figma-row__title">本人资格预审</view><view class="figma-row__subtitle">核对当前版本资料</view></view></view>
      </view>

      <view class="figma-section">
        <view class="figma-section__title">监护关系</view>
        <view class="figma-field-group"><view class="figma-field-label">青年参赛者</view><view class="figma-field-control guardian-proof"><text>{{form.subjectAlias || '从本届名单选择'}}</text><view wx:if="{{!figmaHideSubjectStatus}}" class="figma-status {{hasMaterialScope ? 'figma-status--green' : 'figma-status--orange'}}">{{hasMaterialScope ? '已关联' : '待关联'}}</view></view></view>
        <view class="figma-field-group"><view class="figma-field-label">关系证明</view><view class="figma-field-control guardian-proof"><text>仅受权人员可私有查看</text><view class="figma-status figma-status--orange">{{proofName ? '已选择' : '待提交'}}</view></view></view>
      </view>

      <view class="figma-section">
        <view class="figma-section__title">可选公开用途</view>
        <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">赛事宣传照片</view><view class="figma-row__subtitle">单独授权</view></view><view class="figma-status">{{form.publicityConsent ? '已勾选' : '未勾选'}}</view></view>
        <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">公开参赛档案</view><view class="figma-row__subtitle">单独授权</view></view><view class="figma-status">{{form.archiveConsent ? '已勾选' : '未勾选'}}</view></view>
        <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">直播录像与集锦</view><view class="figma-row__subtitle">单独授权</view></view><view class="figma-status">{{form.liveConsent ? '已勾选' : '未勾选'}}</view></view>
      </view>

      <view wx:if="{{preconsents.length}}" class="figma-section">
        <view class="figma-section__title">必要资料处理邀请</view>
        <view wx:for="{{preconsents}}" wx:key="id" class="guardian-record">
          <view class="guardian-record__head"><view><view class="figma-row__title">{{item.eventName}} · {{item.subjectAlias}}</view><view class="figma-row__subtitle">监护账号：{{item.guardianName}}</view></view><view class="figma-status figma-status--orange">{{item.statusLabel}}</view></view>
          <block wx:if="{{item.role === 'GUARDIAN' && item.status === 'INVITED'}}">
            <view class="guardian-terms">仅允许平台和本届有权组委会在必要范围内私有处理身份、近期照片、资格和保障资料；不授权宣传、公开档案或直播。</view>
            <checkbox-group data-field="acceptedDataProcessing" bindchange="checkbox"><label class="figma-check"><checkbox value="yes" checked="{{form.acceptedDataProcessing}}" disabled="{{busy || pending}}"/><text>我明确同意上述本届必要资料处理</text></label></checkbox-group>
            <button class="figma-action figma-action--navy" data-id="{{item.id}}" data-decision="CONSENT" bindtap="dataDecision" disabled="{{busy || pending || !form.acceptedDataProcessing}}">监护人独立同意必要资料处理</button>
            <button class="figma-action figma-action--ghost" data-id="{{item.id}}" data-decision="DECLINE" bindtap="dataDecision" disabled="{{busy || pending}}">拒绝此邀请</button>
          </block>
          <button wx:if="{{item.status !== 'WITHDRAWN'}}" class="guardian-text-action" data-id="{{item.id}}" data-decision="WITHDRAW" bindtap="dataDecision" disabled="{{busy || pending}}">撤回此必要资料处理邀请或同意</button>
        </view>
      </view>

      <view wx:if="{{policy && (policy.canConfigure || policy.canInviteData)}}" class="figma-section">
        <view class="figma-section__title">本届青年报名设置</view>
        <block wx:if="{{policy.canConfigure}}"><checkbox-group data-field="policyEnabled" bindchange="checkbox"><label class="figma-check"><checkbox value="yes" checked="{{policyEnabled}}" disabled="{{busy || pending}}"/><text>开放本届青年报名流程</text></label></checkbox-group><view class="figma-field-group"><view class="figma-field-label">监护年龄阈值</view><input class="figma-field-control" data-field="threshold" value="{{threshold}}" bindinput="field" type="number" disabled="{{busy || pending}}"/></view><button class="figma-action figma-action--ghost" bindtap="configure" disabled="{{busy || pending}}">保存青年报名规则</button></block>
        <block wx:if="{{policy.enabled && policy.canInviteData}}"><view class="figma-field-group"><view class="figma-field-label">本人别名</view><input class="figma-field-control" data-field="subjectAlias" value="{{form.subjectAlias}}" bindinput="field" disabled="{{busy || pending}}"/></view><view class="figma-field-group"><view class="figma-field-label">监护人账号编号</view><input class="figma-field-control" data-field="guardianUserId" value="{{form.guardianUserId}}" bindinput="field" disabled="{{busy || pending}}"/></view><checkbox-group data-field="declaredYouth" bindchange="checkbox"><label class="figma-check"><checkbox value="yes" checked="{{form.declaredYouth}}" disabled="{{busy || pending}}"/><text>明确选择青年报名入口</text></label></checkbox-group><button class="figma-action figma-action--orange" bindtap="invite" disabled="{{busy || pending || !form.declaredYouth}}">邀请监护人</button></block>
      </view>
    </block>

    <block wx:if="{{activeView === 'subject'}}">
      <view class="figma-section">
        <view class="figma-section__title">本人确认</view>
        <view class="figma-section__hint">本人提出本届监护及用途确认后，监护人仍需独立确认和提交证明。</view>
        <checkbox-group data-field="acceptedTerms" bindchange="checkbox"><label class="figma-check"><checkbox value="yes" checked="{{form.acceptedTerms}}" disabled="{{busy || pending}}"/><text>本人已阅读并确认本届参赛内容</text></label></checkbox-group>
        <checkbox-group data-field="publicityConsent" bindchange="checkbox"><label class="figma-check"><checkbox value="yes" checked="{{form.publicityConsent}}" disabled="{{busy || pending}}"/><text>另行允许本届照片宣传（可选）</text></label></checkbox-group>
        <checkbox-group data-field="archiveConsent" bindchange="checkbox"><label class="figma-check"><checkbox value="yes" checked="{{form.archiveConsent}}" disabled="{{busy || pending}}"/><text>另行允许本届公开参赛与赛果档案（可选）</text></label></checkbox-group>
        <checkbox-group data-field="liveConsent" bindchange="checkbox"><label class="figma-check"><checkbox value="yes" checked="{{form.liveConsent}}" disabled="{{busy || pending}}"/><text>另行允许本届直播、录像与集锦（可选）</text></label></checkbox-group>
        <button class="figma-action figma-action--orange" bindtap="propose" disabled="{{busy || pending || !hasMaterialScope || !form.acceptedTerms}}">提交本人确认</button>
      </view>

      <view wx:if="{{adultDataScopes.length}}" class="figma-section">
        <view class="figma-section__title">成年后的本人资料处理</view>
        <button wx:for="{{adultDataScopes}}" wx:key="key" class="figma-row" data-key="{{item.key}}" bindtap="adultSelect" disabled="{{busy || pending}}"><view class="figma-row__copy"><view class="figma-row__title">{{item.eventName}}</view><view class="figma-row__subtitle">当前材料 V{{item.expectedMaterialVersion}}</view></view><view class="figma-status">{{item.lastDecision || '待确认'}}</view></button>
        <block wx:if="{{adultSelected}}"><view class="guardian-terms">仅重新确认本届当前材料的必要私有处理。本次不会恢复原有公开用途，也不代表参赛或保险审核通过。</view><checkbox-group data-field="adultAcceptedDataProcessing" bindchange="checkbox"><label class="figma-check"><checkbox value="yes" checked="{{form.adultAcceptedDataProcessing}}" disabled="{{busy || pending}}"/><text>本人已成年，重新同意当前资料处理</text></label></checkbox-group><button class="figma-action figma-action--navy" data-decision="CONSENT" bindtap="adultDataCommand" disabled="{{busy || pending || !form.adultAcceptedDataProcessing || !adultSelected.canConsent}}">本人重新同意当前资料处理</button><button wx:if="{{adultSelected.canWithdraw}}" class="guardian-text-action" data-decision="WITHDRAW" bindtap="adultDataCommand" disabled="{{busy || pending}}">撤回本人资料处理同意</button></block>
      </view>
    </block>

    <block wx:if="{{activeView === 'guardian'}}">
      <view class="figma-section">
        <view class="figma-section__title">监护关系</view>
        <view wx:if="{{!requests.length && !loading}}" class="figma-section__hint">暂无记录。监护数据同意后还需本人资格预审与参赛提案。</view>
        <button wx:for="{{requests}}" wx:key="id" class="figma-row" data-id="{{item.id}}" bindtap="select" disabled="{{busy || loading}}"><view class="figma-row__copy"><view class="figma-row__title">{{item.subjectName}} · {{item.eventName}}</view><view class="figma-row__subtitle">监护人 {{item.guardianName}} · {{item.current ? '当前来源版本' : '来源已变化'}}</view></view><view class="figma-status figma-status--orange">{{item.statusLabel}}</view></button>
        <button wx:if="{{nextCursor}}" class="figma-action figma-action--ghost" data-more="true" bindtap="load" disabled="{{busy || loading}}">加载更多</button>
      </view>

      <view wx:if="{{selected}}" class="figma-section">
        <view class="figma-section__title">{{selected.subjectName}} · {{selected.statusLabel}}</view>
        <view class="figma-section__hint">本人用途：{{selected.subjectPurposeText}}；监护人用途：{{selected.guardianPurposeText}}</view>
        <figma-feedback wx:if="{{selected.blockerText}}" type="warning" title="当前阻塞" body="{{selected.blockerText}}"/>
        <block wx:if="{{selected.capabilities.canConfirm}}">
          <view class="figma-field-group"><view class="figma-field-label">监护人真实姓名</view><input class="figma-field-control" value="{{form.realName}}" data-field="realName" bindinput="field" maxlength="80" disabled="{{busy || pending}}"/></view>
          <view class="figma-field-group"><view class="figma-field-label">监护人自己的身份证号</view><input class="figma-field-control" value="{{form.identityNumber}}" data-field="identityNumber" bindinput="field" maxlength="18" disabled="{{busy || pending}}"/></view>
          <radio-group bindchange="relationship" class="guardian-radio"><label><radio value="PARENT" checked="{{form.relationship === 'PARENT'}}" disabled="{{busy || pending}}"/>父或母</label><label><radio value="LEGAL_GUARDIAN" checked="{{form.relationship === 'LEGAL_GUARDIAN'}}" disabled="{{busy || pending}}"/>其他有证明的监护人</label></radio-group>
          <view class="figma-field-group"><view class="figma-field-label">关系证明</view><button class="figma-field-control guardian-proof" bindtap="chooseProof" disabled="{{busy || pending}}"><text>{{proofName || '仅授权人员可私有查看'}}</text><view class="figma-status figma-status--orange">{{proofName ? '已选择' : '待提交'}}</view></button></view>
          <view class="figma-field-group"><view class="figma-field-label">监护关系说明</view><textarea class="figma-field-control" value="{{form.relationshipExplanation}}" data-field="relationshipExplanation" bindinput="field" maxlength="500" disabled="{{busy || pending}}"/></view>
          <checkbox-group data-field="acceptedTerms" bindchange="checkbox"><label class="figma-check"><checkbox value="yes" checked="{{form.acceptedTerms}}" disabled="{{busy || pending}}"/><text>监护人已阅读并同意本届参赛确认</text></label></checkbox-group>
          <button class="figma-action figma-action--orange" bindtap="confirmGuardian" disabled="{{busy || pending || !form.acceptedTerms || !proofName}}">监护人独立确认并提交审核</button>
        </block>
        <button wx:if="{{selected.capabilities.canWithdraw}}" class="guardian-text-action" bindtap="withdraw" disabled="{{busy || pending}}">撤回本次监护参与与各用途确认</button>
      </view>
    </block>
  </view>

  <view class="figma-fixed-actions">
    <button class="figma-action figma-action--ghost" bindtap="materials" disabled="{{busy || pending || !hasMaterialScope}}">打开本人资格预审</button>
    <button class="figma-action figma-action--orange" bindtap="openAuthorizations" disabled="{{busy || loading}}">查看当前授权事项</button>
  </view>
</view>
