.page {
  padding: 24rpx;
}
.card {
  margin: 20rpx 0;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff;
}
.title {
  font-size: 38rpx;
  font-weight: 700;
}
.subtitle {
  font-weight: 600;
}
.small {
  font-size: 24rpx;
}
.muted {
  color: #6d7684;
}
.notice {
  padding: 16rpx;
  background: #f1f4f8;
  overflow-wrap: anywhere;
}
.warning {
  color: #933;
}
.tabs {
  display: flex;
  flex-wrap: wrap;
}
.tabs button {
  min-width: 220rpx;
  flex: 1;
}
textarea {
  box-sizing: border-box;
  width: 100%;
  padding: 16rpx;
  background: #f5f7fa;
  font-size: 16px;
  line-height: 24px;
  min-height: 96px;
}
.picker {
  box-sizing: border-box;
  min-height: 44px;
  font-size: 16px;
  line-height: 24px;
  padding: 18rpx;
  background: #f5f7fa;
}
button {
  margin-top: 14rpx;
  white-space: normal;
}

.ui002-workspace { padding:16px 16px calc(104px + env(safe-area-inset-bottom)); background:#f4f6fa; color:#18283f; }
.ui002-workspace .card { border-radius:16px; padding:16px; margin:0 0 16px; }
.ui002-workspace input,.ui002-workspace textarea,.ui002-workspace button { font-size:16px; line-height:24px; min-height:44px; }
.ui002-workspace .page-intro .title { color:#18283f; font-size:22px; line-height:32px; margin:0 0 8px; }
.ui002-workspace .page-intro { margin-bottom:16px; }
.ui002-workspace .tabs button { min-height:44px; }

.ui002-workspace .notice { font-size:14px; line-height:22px; border-radius:12px; padding:12px; }
.review-summary { color:#18283f; }
.review-summary-icon { display:flex; align-items:center; justify-content:center; flex:0 0 44px; width:44px; height:44px; border-radius:12px; background:#eaf2fc; }
.review-summary-icon image { width:25px; height:25px; }
.review-tabs { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1px; flex-wrap:nowrap; min-height:44px; margin-bottom:12px; padding:2px 3px; border-radius:12px; background:#fff; }
.review-tabs button { width:auto; min-width:0; height:44px; min-height:44px; margin:0; padding:0 6px; border-radius:10px; color:#63758b; background:#fff; box-shadow:none; }
.review-tabs button::after { border:0; }
.review-tabs button.active { color:#fff; background:#123c73; font-weight:700; }
