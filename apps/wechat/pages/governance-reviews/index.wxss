.page {
  padding: 24rpx;
}
.card {
  margin: 20rpx 0;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff;
}
.title {
  font-size: 38rpx;
  font-weight: 700;
}
.subtitle {
  font-weight: 600;
}
.small {
  font-size: 24rpx;
}
.muted {
  color: #6d7684;
}
.notice {
  padding: 16rpx;
  background: #f1f4f8;
  overflow-wrap: anywhere;
}
.warning {
  color: #933;
}
.tabs {
  display: flex;
  flex-wrap: wrap;
}
.tabs button {
  min-width: 220rpx;
  flex: 1;
}
textarea {
  box-sizing: border-box;
  width: 100%;
  padding: 16rpx;
  background: #f5f7fa;
}
.picker {
  padding: 18rpx;
  background: #f5f7fa;
}
button {
  margin-top: 14rpx;
  white-space: normal;
}
