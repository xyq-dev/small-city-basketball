@import "../../styles/figma-pages.wxss";

.reviews-tabs { display:flex; width:100%; min-height:48px; padding:2px; border-radius:12px; background:#fff; }
.reviews-tabs button { display:flex; min-height:44px; flex:1; align-items:center; justify-content:center; border:0; border-radius:10px; background:transparent; color:#51657d; font-size:14px; }
.reviews-tabs button.is-active { background:#123c73; color:#fff; }
.review-score { color:#123c73; font-size:34px; font-weight:700; line-height:42px; }
.review-score text { font-size:16px; }
.review-body { color:#18283f; font-size:14px; line-height:22px; overflow-wrap:anywhere; }
.review-picker { display:flex; align-items:center; justify-content:space-between; gap:8px; }
.review-switch { display:flex; min-height:44px; align-items:center; gap:8px; color:#18283f; font-size:13px; }
.review-item { padding:10px 0; }
.review-item + .review-item { border-top:1px solid #e6ebf2; }
.review-item__head { display:flex; align-items:center; justify-content:space-between; gap:8px; }
.reviews-rebuild .review-text-action { display:flex; width:auto; min-height:44px; align-items:center; padding:0; border:0; background:transparent; color:#123c73; font-size:13px; }
