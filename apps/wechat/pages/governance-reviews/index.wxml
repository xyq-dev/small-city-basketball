<scb-header title="服务评价" disabled="{{busy}}"/>
<view class="figma-page reviews-rebuild">
  <view class="figma-page__content {{!isPublic ? 'figma-page__content--actions' : ''}}">
    <view class="figma-summary"><view class="figma-summary__icon"><figma-icon name="governance" size="28"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">本人已完成服务</view><view class="figma-title">{{figmaSummaryTitle || '真实服务评价'}}</view><view class="figma-subtitle">{{figmaReviewPreview ? '每位参与方对每份完成的订单可评价一次' : '每位参与方对完成的订单可评价一次'}}</view></view></view>
    <figma-skeleton wx:if="{{loading && !items.length && !publicReview}}" rows="4"/>
    <figma-feedback wx:if="{{error}}" type="error" title="评价读取或操作失败" body="{{error}}" action-label="刷新" disabled="{{busy}}" bind:action="load"/>
    <figma-feedback wx:if="{{notice}}" type="success" title="评价状态已更新" body="{{notice}}"/>
    <figma-feedback wx:if="{{loginRequired}}" type="warning" title="登录查看本人评价" action-label="登录" bind:action="login"/>
    <figma-feedback wx:if="{{pending}}" type="warning" title="有原操作待核对" body="查询原操作后继续，不能更换编号重发。" action-label="查询原操作" disabled="{{busy}}" bind:action="recover"/>

    <view wx:if="{{publicReview}}" class="figma-section"><view class="review-score">{{publicReview.score}}<text>/5</text></view><view class="review-body">{{publicReview.body}}</view><view class="figma-caption">{{publicReview.authorLabel}} · {{publicReview.createdAt}}</view><figma-feedback type="warning" title="公开范围说明" body="{{publicReview.notice}}"/><button class="figma-action figma-action--ghost" open-type="share">分享当前评价</button></view>

    <block wx:if="{{!isPublic && !loginRequired}}">
      <view class="reviews-tabs"><button class="{{mode === 'mine' ? 'is-active' : ''}}" data-mode="mine" bindtap="mode">我的评价</button><button wx:if="{{isOperator}}" class="{{mode === 'platform' ? 'is-active' : ''}}" data-mode="platform" bindtap="mode">平台独立审核</button></view>
      <view wx:if="{{sourceReady && mode === 'mine'}}" class="figma-section"><view class="figma-section__title">本次服务</view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">原服务订单</view><view class="figma-row__subtitle">{{figmaSourceOrderText || '仅接受当前账号真实参与并已完成的订单'}}</view></view><view class="figma-status figma-status--green">已完成</view></view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">服务主体</view><view class="figma-row__subtitle">{{figmaSourceProviderText || '按原订单当前可读范围核对'}}</view></view><view class="figma-status figma-status--orange">本人参与</view></view></view>
      <view wx:if="{{sourceReady && mode === 'mine'}}" class="figma-section"><view class="figma-section__title">服务评价</view><block wx:if="{{figmaReviewPreview}}"><view class="figma-field-group"><view class="figma-field-label">评分</view><view class="figma-field-control review-picker"><text>选择实际服务体验</text><view class="figma-status figma-status--orange">待选择</view></view></view><view class="figma-field-group"><view class="figma-field-label">评价内容</view><view class="figma-field-control review-picker"><text>填写真实体验</text><view class="figma-status figma-status--orange">待填写</view></view></view></block><block wx:else><view class="figma-field-group"><view class="figma-field-label">评分</view><picker range="{{scores}}" value="{{score - 1}}" bindchange="score"><view class="figma-field-control review-picker">{{score}} / 5 分</view></picker></view><view class="figma-field-group"><view class="figma-field-label">评价内容</view><textarea class="figma-field-control" data-field="body" value="{{body}}" bindinput="field" maxlength="1000" placeholder="填写真实体验，不公开电话和证件"/></view></block></view>
      <view wx:if="{{sourceReady && mode === 'mine'}}" class="figma-section"><view class="figma-section__title">公开范围</view><block wx:if="{{figmaReviewPreview}}"><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">同意审核后公开</view><view class="figma-row__subtitle">由本人明确选择</view></view><view class="figma-status">未勾选</view></view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">公开评价</view><view class="figma-row__subtitle">经独立审核后可展示</view></view><view class="figma-status figma-status--orange">待审核</view></view></block><label wx:else class="review-switch"><switch checked="{{publicConsent}}" bindchange="consent"/><view class="figma-row__copy"><view class="figma-row__title">同意审核后公开</view><view class="figma-row__subtitle">由本人明确选择</view></view><view class="figma-status">{{publicConsent ? '已勾选' : '未勾选'}}</view></label></view>
      <view wx:if="{{!figmaReviewPreview}}" class="figma-section"><view class="figma-section__title">评价记录</view><figma-feedback wx:if="{{!loading && !items.length}}" type="empty" title="当前没有可查看的评价"/><view wx:for="{{items}}" wx:key="id" class="review-item"><view class="review-item__head"><view class="figma-row__title">{{item.score}} / 5 分</view><view class="figma-status">{{item.statusLabel}}</view></view><view class="review-body">{{item.body}}</view><view class="figma-caption">{{item.createdAt}}</view><button wx:if="{{mode === 'mine' && item.status !== 'WITHDRAWN'}}" class="review-text-action" data-id="{{item.id}}" data-type="WITHDRAW" disabled="{{busy || !!pending}}" bindtap="command">永久撤回公开评价</button><block wx:if="{{mode === 'platform' && item.status === 'PENDING_REVIEW'}}"><button class="figma-action figma-action--navy" data-id="{{item.id}}" data-type="PUBLISH" disabled="{{busy || !!pending}}" bindtap="command">独立审核并公开</button><button class="figma-action figma-action--ghost" data-id="{{item.id}}" data-type="REJECT" disabled="{{busy || !!pending}}" bindtap="command">退回评价</button></block><button wx:if="{{item.status === 'PUBLISHED'}}" class="review-text-action" data-id="{{item.id}}" bindtap="publicLink">打开公开评价</button></view><button wx:if="{{nextCursor}}" class="figma-action figma-action--ghost" disabled="{{busy}}" bindtap="more">读取更多</button></view>
      <view wx:if="{{!figmaReviewPreview && (mode === 'platform' || items.length)}}" class="figma-section"><view class="figma-field-group"><view class="figma-field-label">{{mode === 'platform' ? '审核原因（至少 4 字）' : '撤回原因（至少 4 字）'}}</view><textarea class="figma-field-control" data-field="reason" value="{{reason}}" bindinput="field" maxlength="500" disabled="{{busy || !!pending}}"/></view></view>
    </block>
  </view>
  <view wx:if="{{figmaReviewPreview}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost">查看原订单</button><button class="figma-action figma-action--orange">提交评价</button></view>
  <view wx:elif="{{!isPublic && !loginRequired}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="load" disabled="{{busy || loading}}">刷新评价</button><button class="figma-action figma-action--orange" bindtap="create" disabled="{{busy || !!pending || !sourceReady || !publicConsent}}">提交评价</button></view>
</view>
