<view class="page"><scb-header title="真实服务评价"/><view wx:if="{{error}}" class="notice warning">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{loading}}">正在核对当前资料…</view>
<view wx:if="{{publicReview}}" class="card"><view class="title">{{publicReview.score}}／5 分</view><view>{{publicReview.body}}</view><view class="small muted">{{publicReview.authorLabel}} · {{publicReview.createdAt}}</view><view class="notice">{{publicReview.notice}}</view><button open-type="share">分享当前评价</button></view>
<view wx:if="{{loginRequired}}" class="card"><button bindtap="login">登录查看本人评价</button></view>
<view wx:if="{{pending}}" class="card">有原操作待核对。<button bindtap="recover">查询原操作</button><button data-cancel="true" bindtap="recover">明确放弃未确认操作</button></view>
<block wx:if="{{!isPublic &amp;&amp; !loginRequired}}"><view class="tabs"><button data-mode="mine" bindtap="mode">我的评价</button><button wx:if="{{isOperator}}" data-mode="platform" bindtap="mode">平台独立审核</button></view>
<view wx:if="{{sourceReady &amp;&amp; mode==='mine'}}" class="card"><view class="subtitle">评价当前订单服务</view><view class="small muted">仅接受当前账号真实参与并已完成的订单。同一方每订单一次。</view><picker range="{{scores}}" value="{{score-1}}" bindchange="score"><view class="picker">{{score}}／5 分</view></picker><textarea data-field="body" value="{{body}}" bindinput="field" maxlength="1000" placeholder="描述实际服务体验，请勿公开电话和证件"/><switch checked="{{publicConsent}}" bindchange="consent"/>同意审核后公开内容<button disabled="{{busy || !!pending || !publicConsent}}" bindtap="create">提交评价</button></view>
<view class="card"><textarea data-field="reason" value="{{reason}}" bindinput="field" maxlength="500" placeholder="撤回或审核原因，至少4字"/></view>
<view wx:for="{{items}}" wx:key="id" class="card"><view class="subtitle">{{item.score}}／5 分 · {{item.statusLabel}}</view><view>{{item.body}}</view><view class="small muted">{{item.createdAt}}</view><button wx:if="{{mode==='mine' &amp;&amp; item.status!=='WITHDRAWN'}}" data-id="{{item.id}}" data-type="WITHDRAW" disabled="{{busy || !!pending}}" bindtap="command">永久撤回公开评价</button><block wx:if="{{mode==='platform' &amp;&amp; item.status==='PENDING_REVIEW'}}"><button data-id="{{item.id}}" data-type="PUBLISH" disabled="{{busy || !!pending}}" bindtap="command">独立审核并公开</button><button data-id="{{item.id}}" data-type="REJECT" disabled="{{busy || !!pending}}" bindtap="command">退回评价</button></block><button wx:if="{{item.status==='PUBLISHED'}}" data-id="{{item.id}}" bindtap="publicLink">打开公开评价</button></view><button wx:if="{{nextCursor}}" disabled="{{busy}}" bindtap="more">读取更多</button><view wx:if="{{!loading &amp;&amp; !items.length}}" class="notice">当前没有可查看的评价。</view><button disabled="{{busy}}" bindtap="load">刷新</button></block><button wx:if="{{isPublic}}" disabled="{{loading}}" bindtap="load">刷新公开评价</button></view>
