.seasons-page { padding:12px 16px calc(112px + env(safe-area-inset-bottom)); }
.seasons-page .row .inline { margin-top:8px; }
.season-summary { min-height:110px; padding:16px 14px; background:#eaf2fc; }
.fig-summary-icon { display:flex; flex:0 0 44px; width:44px; height:44px; align-items:center; justify-content:center; border-radius:12px; background:#fff; }
.fig-summary-icon image { width:24px; height:24px; }
.season-tabs { display:flex; gap:0; padding:3px; margin-bottom:12px; border-radius:12px; background:#fff; }
.season-tabs view { display:flex; flex:1; min-width:0; min-height:44px; align-items:center; justify-content:center; padding:8px 4px; border-radius:10px; color:#63758b; font-size:14px; line-height:20px; text-align:center; }
.season-tabs .selected { color:#fff; background:#164b88; }
.seasons-page .card { padding:14px; border:0; border-radius:16px; }
.season-profile-card .field { border:0; background:#f4f6fa; }
.season-events-card .row,.season-board-card .row { min-height:64px; }
.season-board-card .numeric { color:#164b88; font-size:18px; line-height:28px; font-weight:700; }
#season-events,#season-board { scroll-margin-top:12px; }
@media (max-width:340px) { .seasons-page { padding-left:12px; padding-right:12px; } .season-tabs view { font-size:13px; } }
