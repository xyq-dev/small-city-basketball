@import "../../styles/figma-pages.wxss";

.season-tabs { display: flex; width: 100%; min-height: 48px; padding: 2px 3px; border-radius: 12px; background: #fff; }
.season-tab { display: flex; min-width: 0; min-height: 44px; flex: 1; align-items: center; justify-content: center; margin: 0; padding: 0 6px; border: 0; border-radius: 10px; background: transparent; color: #51657d; font-size: 13px; line-height: 19px; }
.season-tab::after, .seasons-link::after { border: 0; }
.season-tab.is-active { background: #123c73; color: #fff; font-weight: 700; }
.seasons-link { display: flex; min-height: 44px; align-items: center; margin: 0; padding: 0 8px; background: transparent; color: #123c73; font-size: 13px; font-weight: 700; text-align: left; }
.seasons-date-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.seasons-control { display: flex; min-height: 48px; align-items: center; justify-content: space-between; gap: 8px; padding: 0 12px; border: 1px solid #7c8ea5; border-radius: 12px; background: #fff; color: #18283f; font-size: 14px; line-height: 22px; }
.seasons-danger { border: 1px solid #c83f42; background: #fff; color: #c83f42; }
.seasons-event { width: 100%; border-bottom: 1px solid #e6ebf2; }
.seasons-event .figma-row { border: 0; }
.seasons-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
.seasons-metrics > view { display: flex; min-width: 0; min-height: 112px; padding: 10px; flex-direction: column; align-items: flex-start; gap: 5px; border-radius: 10px; background: #f4f6fa; }
.seasons-player { display: flex; padding: 12px 0; flex-direction: column; gap: 4px; border-bottom: 1px solid #e6ebf2; }
.seasons-player__top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.seasons-score { color: #123c73; font-size: 16px; font-weight: 700; line-height: 24px; }
@media (max-width: 360px) { .season-tab { padding: 0 2px; font-size: 11px; } .seasons-date-grid { grid-template-columns: 1fr; } .seasons-metrics { grid-template-columns: 1fr; } .seasons-metrics > view { min-height: 84px; } }
