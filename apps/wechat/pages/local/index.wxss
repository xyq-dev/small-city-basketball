@import "../../styles/figma-pages.wxss";

.local-state-back { position:fixed; z-index:25; left:8px; width:44px; height:44px; min-height:44px; margin:0; padding:0; border:0; border-radius:0; background:transparent; }
.local-state-back::after { border:0; }
.local-summary { min-height:108px; }
.local-summary__image { width:128px; height:80px; flex:none; border-radius:10px; }
.local-tabs,.map-tabs { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1px; width:100%; height:48px; padding:2px 3px; border-radius:12px; background:#fff; }
.local-rebuild .local-tabs > .local-tab,.map-tabs button { display:flex; width:auto; min-width:0; max-width:none; height:44px; min-height:44px; flex:none; align-items:center; justify-content:center; margin:0; padding:0 4px; border:0; border-radius:10px; background:#fff; box-sizing:border-box; color:#51657d; font-size:11px; line-height:16px; white-space:nowrap; }
.local-rebuild .local-tabs > .local-tab::after,.map-tabs button::after { border:0; }
.local-rebuild .local-tabs > .local-tab.is-active,.map-tabs button.is-active { background:#123c73; color:#fff; font-weight:700; }
.local-rebuild .local-summary .figma-title { font-size:21px; font-weight:700; line-height:30px; }
.personnel-kinds { display:flex; flex-wrap:wrap; gap:8px; overflow:hidden; }
.personnel-chip { min-width:80px; min-height:44px; padding:0 12px; border-radius:10px; background:#f4f6fa; color:#51657d; font-size:12px; }
.personnel-chip.is-active { background:#123c73; color:#fff; }
.map-frame { overflow:hidden; width:100%; height:138px; border-radius:16px; background:#eaf2fc; }
.local-map,.local-map-preview,.map-placeholder { display:block; width:100%; height:100%; }
.map-placeholder { display:flex; align-items:center; justify-content:center; flex-direction:column; gap:8px; color:#51657d; font-size:12px; }
.map-tabs { grid-template-columns:repeat(2,minmax(0,1fr)); }
.map-actions,.place-actions { display:flex; flex-wrap:wrap; gap:8px; }
.map-actions button,.place-actions button,.row-action { display:flex; min-height:44px; align-items:center; justify-content:center; padding:0 12px; border-radius:10px; background:#f4f6fa; color:#123c73; font-size:12px; }
.picker-control { display:flex; align-items:center; }
.inline-link { min-height:44px; color:#123c73; font-size:13px; text-align:left; }
.place-card,.fee-preview { display:flex; flex-direction:column; gap:6px; padding:10px; border-radius:10px; background:#eaf2fc; }
.local-notice-row { display:flex; width:100%; min-height:55px; align-items:center; gap:8px; padding:0 10px; border-radius:8px; background:#eaf2fc; }
.local-notice-row__mark { width:7px; height:7px; flex:none; border-radius:4px; background:#123c73; }
.local-state-hero { display:flex; width:100%; min-height:112px; flex-direction:column; justify-content:center; gap:8px; padding:16px; border-radius:16px; background:#eaf2fc; }
.action-title { color:#123c73; }
.section-heading { display:flex; align-items:center; justify-content:space-between; gap:8px; }
.section-link { min-width:44px; min-height:44px; color:#123c73; font-size:13px; }
.slot-row { display:flex; width:100%; min-height:55px; align-items:center; justify-content:space-between; gap:8px; padding:0 10px; border:1px solid #e6ebf2 !important; border-radius:10px !important; font-size:13px; }
.slot-row.is-selected { border-color:#123c73 !important; background:#eaf2fc !important; }
.local-actions-row { display:grid; grid-template-columns:140px minmax(0,1fr); gap:8px; }
@media (max-width:360px) { .local-summary__image { width:108px; height:68px; } .local-actions-row { grid-template-columns:112px minmax(0,1fr); } }
