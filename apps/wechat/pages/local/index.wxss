.local-page { padding:16px 16px calc(148px + env(safe-area-inset-bottom)); }
.fig-summary { display:flex; align-items:center; gap:12px; margin-bottom:12px; padding:14px; border-radius:16px; background:#123c73; color:#fff; }
.fig-summary-copy { flex:1; min-width:0; display:flex; flex-direction:column; gap:3px; }
.fig-kicker { font-size:11px; line-height:16px; }
.fig-summary-title { font-size:21px; line-height:30px; font-weight:700; overflow-wrap:anywhere; }
.fig-summary-sub { font-size:12px; line-height:17px; overflow-wrap:anywhere; }
.fig-summary-photo { width:128px; height:80px; flex:none; border-radius:10px; }
.fig-actions { display:flex; gap:8px; margin:0 0 12px; }
.fig-actions button { flex:1; min-width:0; width:auto; height:48px; min-height:48px; margin:0; padding:8px 12px; border-radius:24px; font-size:16px; line-height:24px; font-weight:500; }
.fig-ghost { background:#fff; color:#123c73; box-shadow:inset 0 0 0 1px #e6ebf2; }
.fig-orange { background:#f28c28; color:#18283f; }
.fig-ghost::after,.fig-orange::after { border:0; }
.local-top-tabs { display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin:12px 0 18px; }
.local-top-tabs button { flex:1; min-width:0; width:auto; min-height:44px; margin:0; padding:10px 8px; border-radius:12px; color:#63758b; background:#fff; font-size:13px; line-height:22px; font-weight:500; }
.local-top-tabs .local-city-tab { flex:1.25; background:#123c73; color:#fff; overflow-wrap:anywhere; }
.local-brand { margin-bottom:18px; }
.local-brand-eyebrow { color:#a14d0a; font-size:11px; line-height:18px; letter-spacing:1.5px; font-weight:700; }
.local-brand-row { display:flex; align-items:center; gap:10px; margin-top:4px; }
.local-brand-copy { flex:1; min-width:0; }
.local-brand-title { color:#123c73; font-size:26px; line-height:34px; font-weight:800; overflow-wrap:anywhere; }
.local-brand-services { color:#63758b; font-size:12px; line-height:20px; margin-top:6px; }
.local-brand-ball { display:flex; align-items:center; justify-content:center; flex:none; width:52px; height:52px; border-radius:50%; background:#fff0df; }
.local-service-tabs { display:flex; gap:1px; height:44px; margin-bottom:12px; padding:2px 3px; border-radius:12px; background:#fff; }
.local-service-tabs button { display:flex; flex:1; align-items:center; justify-content:center; min-width:0; width:auto; min-height:44px; height:44px; margin:0; padding:0 2px; border-radius:10px; background:transparent; color:#63758b; font-size:11px; line-height:16px; font-weight:400; }
.local-service-tabs button::after { border:0; }
.local-service-tabs .local-service-icon { display:none; }
.local-service-tabs button.active { background:#123c73; color:#fff; font-weight:700; }
.local-service-tabs button.active::after { border-color:#f2bf87; }
.local-service-icon { display:flex; align-items:center; justify-content:center; width:36px; height:36px; }
.local-results-heading { display:flex; align-items:center; justify-content:space-between; gap:8px; margin:4px 0 10px; }
.local-results-heading > view { min-width:0; color:#18283f; font-size:18px; line-height:28px; font-weight:700; }
.local-page .listing-entry { margin-bottom:12px; }
.local-page .listing-card { margin:0; padding:0; overflow:hidden; border-radius:16px; }
.local-page .listing-bottom { display:flex; align-items:center; gap:8px; padding:0 14px 14px; background:#fff; }
.local-page .listing-limit { flex:1; min-width:0; color:#63758b; font-size:11px; line-height:18px; }
.local-page .listing-action { flex:none; width:auto; max-width:58%; min-height:44px; margin:0; padding:9px 10px; font-size:12px; line-height:20px; }
.local-results-heading button { display:flex; align-items:center; justify-content:center; flex:none; gap:5px; width:auto; min-height:44px; margin:0; padding:10px 6px; color:#123c73; background:transparent; font-size:12px; line-height:20px; font-weight:500; }
.local-results-heading button::after { border:0; }
.listing-entry { margin-bottom:18px; overflow:hidden; border:1px solid #e1e7ef; border-radius:18px; background:#fff; }
.listing-card { display:block; width:100%; margin:0; padding:0; border-radius:0; background:#fff; color:#18283f; text-align:left; font-weight:400; }
.listing-card::after { border:0; }
.listing-visual { position:relative; width:100%; height:140px; background:#edf2f7; }
.v3-listing-photo { display:block; width:100%; height:100%; }
.personnel-visual { height:108px; background:#edf2f7; }
.personnel-visual-icon { display:flex; width:100%; height:100%; align-items:center; justify-content:center; }
.listing-photo-caption { position:absolute; right:10px; bottom:8px; padding:2px 7px; border-radius:6px; background:rgba(16,35,58,.72); color:#fff; font-size:10px; line-height:16px; }
.listing-kind { position:absolute; top:12px; left:12px; max-width:calc(100% - 24px); padding:3px 9px; border-radius:6px; background:#fff; color:#123c73; font-size:12px; line-height:20px; font-weight:700; }
.listing-body { padding:14px 16px 10px; }
.listing-card .subtitle { margin:0 0 6px; color:#18283f; font-size:18px; line-height:28px; font-weight:700; overflow-wrap:anywhere; }
.listing-details { display:flex; flex-direction:column; gap:4px; }
.listing-meta { color:#63758b; font-size:12px; line-height:20px; }
.listing-address { display:flex; align-items:flex-start; gap:6px; color:#63758b; font-size:13px; line-height:21px; }
.listing-address scb-icon { flex:none; margin-top:3px; }
.listing-address > view { min-width:0; overflow-wrap:anywhere; }
.listing-card .muted { font-size:12px; line-height:20px; }
.listing-bottom { padding:0 16px 14px; }
.listing-limit { margin-bottom:10px; color:#63758b; font-size:11px; line-height:18px; }
.listing-action { display:flex; justify-content:space-between; align-items:center; gap:8px; min-height:44px; margin:0; padding:10px 14px; border-radius:12px; font-size:13px; line-height:22px; font-weight:600; }
.local-origin-note { display:flex; flex-direction:column; gap:4px; margin:8px 0 12px; padding:12px 14px; border-left:3px solid #d4dce8; color:#63758b; background:#edf1f6; border-radius:0 10px 10px 0; font-size:12px; line-height:20px; }
.local-origin-note > view:first-child { color:#18283f; font-size:13px; font-weight:600; }
.local-display-actions { display:flex; gap:8px; margin-bottom:18px; }
.local-display-actions button { flex:1; min-width:0; width:auto; min-height:44px; margin:0; font-size:13px; line-height:22px; }
.local-query-panel,.map-card,.detail-card { padding:16px; border-radius:18px; }
.local-actions { display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin-bottom:8px; }
.local-actions button { flex:1 1 82px; min-width:0; margin:0; min-height:44px; font-size:14px; line-height:22px; }
.local-actions .subtitle { flex:2 1 150px; min-width:0; margin:0; }
.chips { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:12px; }
.chip { flex:1 0 20%; width:auto; min-height:44px; margin:0; padding:10px 6px; }
.picked { color:#8a450c; background:#fff3e2; border:1px solid #f28c28; }
.personnel-kinds { padding:0 0 8px; }
.local-map { width:100%; height:280px; border-radius:12px; }
.map-card { position:relative; }
.map-search { display:flex; justify-content:center; margin-bottom:8px; }
.map-search button { min-height:44px; margin:0; }
.map-card .local-actions { margin-top:8px; }
.map-card .notice { margin-bottom:12px; }
.place-row { border-top:1px solid #e1e7ef; padding-top:12px; margin-top:8px; }
.location-settings { border-top:1px solid #e1e7ef; padding-top:16px; margin-top:16px; }
.detail-card { border:2px solid #f2bf87; }
.detail-card .section-title { margin-top:18px; }
.slot { text-align:left; }
@media(max-width:360px) { .local-brand-title { font-size:23px; line-height:32px; } .local-brand-ball { width:44px; height:44px; } .listing-visual { height:124px; } .personnel-visual { height:104px; } }

.local-state-content { display:flex; flex-direction:column; gap:12px; padding:12px 16px 108px; }
.local-state-map { display:block; width:100%; height:138px; border-radius:16px; overflow:hidden; background:#dfecef; }
.local-state-map-empty { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px; color:#63758b; font-size:12px; line-height:18px; }
.local-state-tabs { display:flex; gap:1px; min-height:48px; padding:2px 3px; border-radius:12px; background:#fff; }
.local-state-tabs button { flex:1; min-width:0; width:auto; height:44px; min-height:44px; margin:0; padding:0; border-radius:10px; background:transparent; color:#63758b; font-size:13px; line-height:19px; }
.local-state-tabs button::after { border:0; }
.local-state-tabs button.active,.local-state-tabs button.active[disabled] { background:#123c73; color:#fff; opacity:1; }
.local-state-card { display:flex; flex-direction:column; gap:8px; padding:14px; border-radius:16px; background:#fff; }
.local-state-title { color:#18283f; font-size:17px; line-height:24px; font-weight:700; }
.local-state-row,.local-state-notice,.local-state-supply { display:flex; align-items:center; gap:8px; width:100%; min-height:55px; margin:0; padding:0; border-radius:0; background:transparent; color:#18283f; text-align:left; font-weight:400; }
.local-state-supply + .local-state-supply,.local-state-row + .local-state-row { box-shadow:inset 0 1px 0 #e6ebf2; }
.local-state-supply::after { border:0; }
.local-state-notice { padding:0 10px; border-radius:8px; background:#eaf2fc; }
.local-state-dot { display:flex; align-items:center; justify-content:center; width:18px; height:18px; flex:none; border-radius:50%; background:#123c73; box-shadow:inset 0 0 0 6px #123c73; }
.local-state-dot::after { content:''; width:6px; height:6px; border-radius:2px; background:#fff; }
.local-state-notice-dot { width:7px; height:7px; flex:none; border-radius:4px; background:#123c73; }
.local-state-copy { flex:1; min-width:0; display:flex; flex-direction:column; gap:3px; }
.local-state-copy > view:first-child { color:#18283f; font-size:14px; line-height:20px; font-weight:700; overflow-wrap:anywhere; }
.local-state-copy > view:last-child { color:#63758b; font-size:12px; line-height:17px; overflow-wrap:anywhere; }
.local-state-pill { flex:none; max-width:92px; padding:3px 7px; border-radius:7px; background:#fff1e2; color:#18283f; font-size:11px; line-height:17px; text-align:center; overflow-wrap:anywhere; }
.local-state-empty,.local-state-note { color:#63758b; font-size:12px; line-height:19px; }
.local-state-empty { display:flex; flex-direction:column; gap:3px; padding:10px 0; }
.local-state-empty > view:first-child { color:#18283f; font-size:14px; line-height:20px; font-weight:700; }
.local-state-inline-actions { display:flex; flex-wrap:wrap; gap:8px; }
.local-state-inline-actions button { flex:1 1 120px; min-width:0; min-height:44px; margin:0; padding:9px 10px; font-size:13px; line-height:20px; }
.local-state-summary { display:flex; align-items:center; gap:12px; padding:14px; border-radius:16px; background:#fff; }
.local-state-summary-icon { display:flex; align-items:center; justify-content:center; width:44px; height:44px; flex:none; border-radius:12px; background:#eaf2fc; }
.local-state-summary > view:last-child { min-width:0; }
.local-state-summary > view:last-child > view:nth-child(1) { color:#63758b; font-size:11px; line-height:16px; }
.local-state-summary > view:last-child > view:nth-child(2) { color:#18283f; font-size:18px; line-height:26px; font-weight:700; }
.local-state-summary > view:last-child > view:nth-child(3) { color:#63758b; font-size:12px; line-height:17px; }
.local-state-query .field,.local-state-query button { margin:0; }
.local-state-actions { position:fixed; z-index:14; left:0; right:0; bottom:0; display:flex; gap:8px; padding:6px 16px calc(16px + env(safe-area-inset-bottom)); background:#fff; }
.local-state-actions button { min-width:0; height:48px; min-height:48px; margin:0; padding:8px 12px; border-radius:24px; font-size:16px; line-height:24px; white-space:nowrap; }
.local-state-actions button::after { border:0; }
.local-state-ghost { flex:0 1 140px; background:#fff; color:#123c73; box-shadow:inset 0 0 0 1px #e6ebf2; }
.local-state-primary { flex:1; background:#f28c28; color:#18283f; }
.local-state-primary[disabled] { background:#edf1f6; color:#63758b; }
@media(max-width:360px) { .local-state-content { padding-left:12px; padding-right:12px; } .local-state-actions { padding-left:12px; padding-right:12px; } .local-state-actions button { padding-left:8px; padding-right:8px; font-size:14px; } .local-state-ghost { flex-basis:128px; } }
