.local-page { padding-bottom:calc(96px + env(safe-area-inset-bottom)); } .local-heading { display:flex; align-items:flex-start; gap:10px; } .local-heading>view { flex:1; } .local-heading button { width:auto; min-width:95px; } .local-heading .title { font-size:21px; } .local-actions { display:flex; gap:8px; align-items:center; margin-bottom:8px; } .local-actions button { flex:1; min-width:0; margin:0; } .local-actions .subtitle { flex:2; margin:0; } .chips { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:12px; } .chip { width:auto; margin:0; flex:1 0 20%; padding:6px; } .picked { background:#fff0e7; border:1px solid #ef7c3e; color:#a64618; } .listing-card { text-align:left; } .kind-label { color:#b84c1d; font-size:12px; } .link { color:#b84c1d; margin-top:8px; } .local-map { width:100%; height:280px; } .place-row { border-top:1px solid #e8edf2; padding-top:12px; margin-top:8px; } .detail-card { border:2px solid #f0b591; } .slot { text-align:left; }
