.local-page { padding-bottom:calc(96px + env(safe-area-inset-bottom)); } .local-heading { display:flex; align-items:flex-start; gap:10px; } .local-heading>view { flex:1; } .local-heading button { width:auto; min-width:95px; } .local-heading .title { font-size:21px; } .local-actions { display:flex; gap:8px; align-items:center; margin-bottom:8px; } .local-actions button { flex:1; min-width:0; margin:0; } .local-actions .subtitle { flex:2; margin:0; } .chips { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:12px; } .chip { width:auto; margin:0; flex:1 0 20%; padding:6px; } .picked { background:#fff0e7; border:1px solid #f28c28; color:#a64618; } .listing-card { text-align:left; } .kind-label { color:#b84c1d; font-size:12px; } .link { color:#b84c1d; margin-top:8px; } .local-map { width:100%; height:280px; } .place-row { border-top:1px solid #e1e7ef; padding-top:12px; margin-top:8px; } .detail-card { border:2px solid #f0b591; } .slot { text-align:left; }

.map-card{position:relative}.map-search{display:flex;justify-content:center;margin-bottom:16rpx}.map-search button{min-width:260rpx}.map-card .local-actions{flex-wrap:wrap}.map-card .local-actions button{margin-top:8rpx}.map-card .notice{margin-bottom:12rpx}

.location-settings { border-top:1px solid #e1e7ef; padding-top:12px; } .local-actions { flex-wrap:wrap; } .local-actions button { flex:1 1 82px; }
.local-heading { flex-wrap:wrap; margin-bottom:12px; } .local-heading > view { flex:1 1 180px; min-width:0; } .local-heading button { flex:0 1 auto; max-width:100%; white-space:normal; overflow-wrap:anywhere; }
