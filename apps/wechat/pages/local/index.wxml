<scb-header wx:if="{{mapVisible}}" title="地图找服务" emit-back="{{true}}" bind:back="cityList"/>
<scb-header wx:elif="{{filtersOpen}}" title="选城与距离起点" emit-back="{{true}}" bind:back="toggleFilters"/>
<view class="page local-page" style="padding-top:0">
 <block wx:if="{{mapVisible}}">
  <view class="local-state-content">
   <view wx:if="{{pending || pendingError}}" class="notice warning"><view>{{pendingError || '上次操作尚未核对，请先处理。'}}</view><button bindtap="recover" disabled="{{busy}}">查询原操作回执</button><button wx:if="{{pending}}" bindtap="retry" disabled="{{busy}}">重试原操作</button></view>
   <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view>
   <map wx:if="{{mapCenter}}" id="local-map" class="local-state-map" latitude="{{mapCenter.latitude}}" longitude="{{mapCenter.longitude}}" markers="{{markers}}" bindmarkertap="marker" bindregionchange="regionChanged" binderror="mapFailed" scale="{{mapScale}}" enable-rotate="{{false}}" enable-overlooking="{{false}}" show-location="{{false}}"/>
   <view wx:else class="local-state-map local-state-map-empty"><scb-icon name="pin" size="28"/><view>当前列表暂无已确认坐标</view><view>仍可按城市与文字地址浏览</view></view>
   <view class="local-state-tabs"><button bindtap="cityList">列表</button><button class="active" disabled="{{true}}">地图</button></view>
   <view class="local-state-card">
    <view class="local-state-title">范围与起点</view>
    <view class="local-state-row"><view class="local-state-dot"></view><view class="local-state-copy"><view>浏览范围</view><view>{{selection.label}}</view></view><view class="local-state-pill">已选</view></view>
    <view class="local-state-row"><view class="local-state-dot"></view><view class="local-state-copy"><view>距离起点</view><view>{{hasOrigin ? originLabel : '尚未设置，可继续按城市浏览'}}</view></view><view class="local-state-pill">{{hasOrigin ? '已选' : '可选'}}</view></view>
   </view>
   <view class="local-state-card">
    <view class="local-state-title">区域内已发布供给</view>
    <button wx:for="{{items}}" wx:key="id" class="local-state-supply" data-id="{{item.id}}" bindtap="detail"><view class="local-state-copy"><view>{{item.title}}</view><view>{{item.kindText}} · {{item.address}}</view></view><view class="local-state-pill">查看档期</view></button>
    <view wx:if="{{!items.length}}" class="local-state-empty"><view>暂无符合条件的已审核供给</view><view>可调整地图范围，或返回城市列表。</view></view>
    <view wx:if="{{mapScopeLabel}}" class="local-state-note">{{mapScopeLabel}}{{viewportDirty ? ' · 上次搜索范围' : ''}}</view>
    <view wx:if="{{mapError}}" class="notice warning">{{mapError}}</view>
    <view wx:if="{{!viewportEnabled}}" class="local-state-note">地图区域搜索暂未开放，可继续按城市或距离起点查找。</view>
    <view class="local-state-inline-actions"><button wx:if="{{canRestoreArea}}" bindtap="restoreArea">恢复上次范围</button><button wx:if="{{viewportEnabled && selection.mode==='REGION' && !acrossRegions}}" bindtap="expandMapScope" disabled="{{viewportBusy}}">临时跨城搜索</button><button wx:if="{{acrossRegions}}" bindtap="keepCityScope" disabled="{{viewportBusy}}">仅查所选地区</button></view>
    <button wx:if="{{nextCursor}}" bindtap="more" disabled="{{loadingMore || viewportDirty || viewportBusy}}" loading="{{loadingMore}}">加载更多</button>
   </view>
  </view>
  <view class="local-state-actions"><button class="local-state-ghost" bindtap="cityList">返回城市列表</button><button class="local-state-primary" bindtap="searchThisArea" disabled="{{!viewportEnabled || !mapCenter || viewportBusy}}" loading="{{viewportBusy}}">{{viewportBusy ? '搜索中…' : '搜索此区域'}}</button></view>
 </block>
 <block wx:elif="{{filtersOpen}}">
  <view class="local-state-content">
   <view wx:if="{{pending || pendingError}}" class="notice warning"><view>{{pendingError || '上次操作尚未核对，请先处理。'}}</view><button bindtap="recover" disabled="{{busy}}">查询原操作回执</button><button wx:if="{{pending}}" bindtap="retry" disabled="{{busy}}">重试原操作</button></view>
   <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view>
   <view class="local-state-summary"><view class="local-state-summary-icon"><scb-icon name="pin" size="25"/></view><view><view>同城服务</view><view>选城与距离起点</view><view>可通过手动选择城市和起点继续浏览。</view></view></view>
   <view class="local-state-card">
    <view class="local-state-title">当前位置</view>
    <view class="local-state-notice"><view class="local-state-notice-dot"></view><view class="local-state-copy"><view>{{hasOrigin ? '已选择距离起点' : '定位未授权'}}</view><view>{{hasOrigin ? originLabel : '仅主动查询附近时请求位置。'}}</view></view><view class="local-state-pill">{{hasOrigin ? '已选择' : '可跳过'}}</view></view>
    <view class="local-state-notice"><view class="local-state-notice-dot"></view><view class="local-state-copy"><view>手动起点</view><view>搜索场馆或街道并确认地点。</view></view><view class="local-state-pill">可选择</view></view>
   </view>
   <view class="local-state-card">
    <view class="local-state-title">城市供给</view>
    <view wx:if="{{!items.length}}" class="local-state-row"><view class="local-state-copy"><view>暂无已审核供给</view><view>所选范围内没有可预约项目。</view></view><view class="local-state-pill">暂无服务</view></view>
    <button wx:else class="local-state-supply" data-id="{{items[0].id}}" bindtap="detail"><view class="local-state-copy"><view>{{items[0].title}}</view><view>{{items[0].address}}</view></view><view class="local-state-pill">查看服务</view></button>
    <button class="local-state-supply" bindtap="chooseCity"><view class="local-state-copy"><view>其他城市</view><view>切换浏览城市保留常驻地。</view></view><view class="local-state-pill">可浏览</view></button>
   </view>
   <view wx:if="{{items.length}}" class="local-state-card"><view class="local-state-title">当前查询结果</view><button wx:for="{{items}}" wx:key="id" class="local-state-supply" data-id="{{item.id}}" bindtap="detail"><view class="local-state-copy"><view>{{item.title}}</view><view>{{item.organizationName}} · {{item.address}}</view></view><view class="local-state-pill">{{item.kind==='COURT' ? '查看场馆与可约时间' : '查看人员与可约时间'}}</view></button></view>
   <view class="local-state-card local-state-query">
    <view class="local-state-title">查询与起点设置</view>
    <view class="chips"><button wx:for="{{kinds}}" wx:key="value" class="chip {{kind===item.value?'picked':''}}" data-value="{{item.value}}" bindtap="kind">{{item.label}}</button></view>
    <input class="field" value="{{q}}" data-field="q" bindinput="input" placeholder="搜索已审核供给名称" maxlength="100"/>
    <button class="primary" bindtap="search" disabled="{{loading}}">查找供给</button>
    <view wx:if="{{hasOrigin}}"><picker class="field" range="{{radii}}" range-key="label" value="{{radiusIndex}}" bindchange="radius">搜索半径：{{radii[radiusIndex].label}}</picker><button class="quiet" bindtap="clearOrigin">清除距离起点</button></view>
    <input class="field" data-field="placeQuery" value="{{placeQuery}}" bindinput="input" placeholder="输入场馆、街道等地图地点" maxlength="100"/>
    <button bindtap="searchPlaces" loading="{{placesBusy}}" disabled="{{placesBusy || !locationEnabled}}">在所选地区查地图地点</button>
    <view wx:if="{{!locationEnabled}}" class="local-state-note">地图地点解析暂未开放，仍可手动选城、输入实际服务地址。</view>
    <view wx:if="{{locationError}}" class="notice warning">{{locationError}}</view>
    <view wx:for="{{locatedRegions}}" wx:key="index" class="place-row"><view>定位建议：{{item.regionLabel}}</view><view class="muted">{{item.address}}，确认前不会切换城市。</view><button data-index="{{index}}" bindtap="confirmLocatedRegion">确认此地区并查询附近</button></view>
    <view wx:for="{{places}}" wx:key="index" class="place-row"><view>{{item.title}}</view><view class="muted">{{item.address}} · 地图候选</view><button data-index="{{index}}" data-purpose="origin" bindtap="usePlace">作为搜索起点</button></view>
   </view>
   <view class="local-state-card"><view class="local-state-title">扩展服务与经营入口</view><view class="local-state-inline-actions"><button bindtap="manage" disabled="{{busy}}">经营与服务方</button><button data-page="matching" bindtap="expansion" disabled="{{busy}}">全国撮合</button><button data-page="dispatch" bindtap="expansion" disabled="{{busy}}">跨城派单</button><button data-page="training" bindtap="expansion" disabled="{{busy}}">培训课程</button></view></view>
  </view>
  <view class="local-state-actions"><button class="local-state-ghost" bindtap="locate" disabled="{{locationBusy}}" loading="{{locationBusy}}">调整距离起点</button><button class="local-state-primary" bindtap="chooseCity">手动选择城市</button></view>
 </block>
 <block wx:else>
 <v3-chrome title="同城" tools="{{false}}"/>
 <view class="fig-summary">
  <view class="fig-summary-copy">
   <view class="fig-kicker">同城篮球</view>
   <view class="fig-summary-title">{{selection.label}}篮球服务</view>
   <view class="fig-summary-sub">{{selection.label}}</view>
  </view>
  <image class="fig-summary-photo" src="/assets/home/event-court.jpg" mode="aspectFill"/>
 </view>
 <view class="local-top-tabs"><button class="local-city-tab" bindtap="chooseCity">{{selection.label}}</button><button bindtap="openSearch">搜索</button><button bindtap="openMessages">消息</button><button bindtap="toggleFilters" disabled="{{busy || pending || pendingError}}">找附近</button></view>
 <view class="fig-card-title">按需发现</view>
 <view class="local-service-tabs">
  <button class="{{kind==='COURT' ? 'active' : ''}}" data-value="COURT" bindtap="kind"><view class="local-service-icon"><scb-icon name="court" size="26"/></view><view>球场</view></button>
  <button class="{{kind && kind!=='COURT' ? 'active' : ''}}" data-value="REFEREE" bindtap="kind"><view class="local-service-icon"><scb-icon name="shield" size="26"/></view><view>人员服务</view></button>
  <button bindtap="players" disabled="{{busy}}"><view class="local-service-icon"><scb-icon name="user" size="26"/></view><view>球员邀约</view></button>
  <button bindtap="matchups" disabled="{{busy}}"><view class="local-service-icon"><scb-icon name="users" size="26"/></view><view>球队约赛</view></button>
 </view>
 <view class="local-results-heading"><view>{{kind==='COURT' ? '球场与档期' : kind ? '人员服务' : '同城全部服务'}}</view></view>
 <view class="fig-actions"><button class="fig-ghost" bindtap="bookings" disabled="{{busy}}">我的预约</button><button class="fig-orange" bindtap="toggleMap" disabled="{{busy || pending || pendingError}}">地图找服务</button></view>
 <view wx:if="{{kind && kind!=='COURT'}}" class="chips personnel-kinds"><block wx:for="{{kinds}}" wx:key="value"><button wx:if="{{item.value && item.value!=='COURT'}}" class="chip {{kind===item.value?'picked':''}}" data-value="{{item.value}}" bindtap="kind">{{item.label}}</button></block></view>
 <view class="notice" wx:if="{{selection.mode==='LEGACY_CITY'}}">当前为历史城市标签。请从地区目录重新选择，供给覆盖和附近筛选需要具体地区。</view>
 <view wx:if="{{pending || pendingError}}" class="notice warning"><view>{{pendingError || '上次操作尚未核对，请先处理。'}}</view><button bindtap="recover" disabled="{{busy}}">查询原操作回执</button><button wx:if="{{pending}}" bindtap="retry" disabled="{{busy}}">重试原操作</button></view>
 <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view>
 <scb-state wx:if="{{loading}}" kind="loading" title="正在读取已审核供给"/>
 <view wx:for="{{items}}" wx:key="id" class="listing-entry">
  <button class="card listing-card" data-id="{{item.id}}" bindtap="detail">
   <view class="listing-visual {{item.kind==='COURT' ? '' : 'personnel-visual'}}"><image wx:if="{{item.kind==='COURT'}}" class="v3-listing-photo" src="/assets/home/event-court.jpg" mode="aspectFill" aria-label="球场示意图，非场馆实拍"/><view wx:else class="personnel-visual-icon"><scb-icon name="shield" size="52"/></view><view class="listing-photo-caption">{{item.kind==='COURT' ? '场馆配图 · 示意' : '服务插画 · 示意'}}</view><view class="listing-kind">{{item.kindText}}</view></view>
   <view class="listing-body"><view class="subtitle">{{item.title}}</view><view class="listing-details"><view class="listing-meta">{{selection.label}} · 已审核供给</view><view class="listing-address"><scb-icon name="pin" tone="gray" size="14"/><view>{{item.address}}</view></view><view class="muted">{{item.organizationName}}<text wx:if="{{item.distanceLabel}}"> · {{item.distanceLabel}}</text></view><view class="muted">{{item.qualificationText}}</view></view></view>
  </button>
  <view class="listing-bottom"><view class="listing-limit">选择档期后再次核对，提交不等于订到。</view><button class="primary listing-action" data-id="{{item.id}}" bindtap="detail">{{item.kind==='COURT' ? '查看场馆与可约时间' : '查看人员与可约时间'}}<scb-icon name="arrow-right" tone="white" size="16"/></button></view>
 </view>
 <scb-state wx:if="{{loaded && !items.length}}" kind="empty" title="暂无符合条件的已审核供给" description="{{viewportMode ? '可调整地图范围，或返回城市列表。' : '可以调整地区、类型或距离起点。'}}" action-text="重新选择城市" bind:action="chooseCity"/>
 <button wx:if="{{nextCursor}}" bindtap="more" disabled="{{loadingMore || viewportDirty || viewportBusy}}" loading="{{loadingMore}}">加载更多</button>
 <view class="local-origin-note"><view>{{hasOrigin ? originLabel : '尚未设置距离起点'}}</view><view>选择当前位置或手动地点后显示约距；仅选城市时不显示虚假米数。</view></view>
 <view class="local-display-actions"><button class="secondary" bindtap="toggleMap">{{mapVisible?'收起地图':'查看地图'}}</button><button class="secondary" bindtap="toggleFilters" disabled="{{busy || pending || pendingError}}">{{filtersOpen ? '收起查询与扩展服务' : '搜索、附近与更多服务'}}</button></view>
 <view wx:if="{{mapVisible}}" class="card map-card">
  <view class="fig-card-title">范围与起点</view>
  <view class="fig-card-title">区域内已发布供给</view>
  <view wx:if="{{viewportMode}}" class="notice">{{mapScopeLabel}}{{viewportDirty?' · 上次搜索范围':''}}</view>
  <view wx:if="{{viewportDirty && !viewportMode}}" class="muted">地图范围已改变，下方保留上次列表。</view>
  <view wx:if="{{viewportEnabled && mapCenter}}" class="map-search"><button class="primary" bindtap="searchThisArea" disabled="{{viewportBusy}}" loading="{{viewportBusy}}">{{viewportBusy?'搜索中…':'搜索此区域'}}</button></view>
  <map wx:if="{{mapCenter}}" id="local-map" class="local-map" latitude="{{mapCenter.latitude}}" longitude="{{mapCenter.longitude}}" markers="{{markers}}" bindmarkertap="marker" bindregionchange="regionChanged" binderror="mapFailed" scale="{{mapScale}}" enable-rotate="{{false}}" enable-overlooking="{{false}}" show-location="{{false}}"/>
  <view wx:else class="muted">当前列表没有已确认坐标。可选距离起点，或查看文字地址。</view>
  <view wx:if="{{!viewportEnabled}}" class="muted">地图区域搜索暂未开放，可继续按城市或距离起点查找。</view>
  <view wx:if="{{mapError}}" class="error">{{mapError}}</view>
  <view wx:if="{{viewportEnabled}}" class="muted">{{acrossRegions?'临时地图范围，不改变所选城市。':'默认搜索所选地区与地图范围的交集。'}}停止拖动后点击搜索，无需授权定位。</view>
  <view class="local-actions"><button wx:if="{{canRestoreArea}}" bindtap="restoreArea">恢复上次范围</button><button wx:if="{{viewportEnabled && selection.mode==='REGION' && !acrossRegions}}" bindtap="expandMapScope" disabled="{{viewportBusy}}">临时跨城搜索</button><button wx:if="{{acrossRegions}}" bindtap="keepCityScope" disabled="{{viewportBusy}}">仅查所选地区</button><button bindtap="cityList">返回城市列表</button></view>
  <view class="muted">标记仅来自当前已发布供给；地图背景地点不代表可预约。分页不会移动地图。供给可能更新，可重新搜索刷新。</view>
 </view>
 <view wx:if="{{filtersOpen}}" class="card local-query-panel">
  <view class="chips"><button wx:for="{{kinds}}" wx:key="value" class="chip {{kind===item.value?'picked':''}}" data-value="{{item.value}}" bindtap="kind">{{item.label}}</button></view>
  <input class="field" value="{{q}}" data-field="q" bindinput="input" placeholder="搜索已审核供给名称" maxlength="100"/>
  <button class="primary" bindtap="search" disabled="{{loading}}">查找供给</button>
 <view class="fig-card-title">定位与范围</view>
  <view wx:if="{{filtersOpen}}" class="location-settings">
  <view class="fig-card-title">当前位置</view>
  <view class="fig-card-title">城市供给</view>
  <view class="local-actions"><button bindtap="locate" loading="{{locationBusy}}" disabled="{{locationBusy}}">调整距离起点</button><button bindtap="chooseCity">手动选择城市</button><button bindtap="nationwide">浏览全国</button></view>
  <view class="muted">{{originLabel}}。位置只在本页内存使用，离开后清除；拒绝定位也可手动选城。</view>
  <view wx:if="{{hasOrigin}}"><picker class="field" range="{{radii}}" range-key="label" value="{{radiusIndex}}" bindchange="radius">搜索半径：{{radii[radiusIndex].label}}</picker><button class="quiet" bindtap="clearOrigin">清除距离起点</button></view>
  <input class="field" data-field="placeQuery" value="{{placeQuery}}" bindinput="input" placeholder="输入场馆、街道等地图地点" maxlength="100"/>
  <button bindtap="searchPlaces" loading="{{placesBusy}}" disabled="{{placesBusy}}">在所选地区查地图地点</button>
  <view class="muted">地图地点仅帮助选地址和搜索起点，可预约档期由经营方实际发布。</view>
  <view wx:if="{{!locationEnabled}}" class="muted">地图地点解析暂未开放，仍可手动选城、输入实际服务地址。</view>
  <view wx:if="{{locationError}}" class="error">{{locationError}}</view><view wx:for="{{locatedRegions}}" wx:key="index" class="place-row"><view>定位建议：{{item.regionLabel}}</view><view class="muted">{{item.address}}，确认前不会切换城市。</view><button data-index="{{index}}" bindtap="confirmLocatedRegion">确认此地区并查询附近</button></view>
  <view wx:for="{{places}}" wx:key="index" class="place-row"><view>{{item.title}}</view><view class="muted">{{item.address}} · 地图候选</view><button data-index="{{index}}" data-purpose="origin" bindtap="usePlace">作为搜索起点</button><button wx:if="{{detail && detail.listing.kind!=='COURT'}}" data-index="{{index}}" data-purpose="service" bindtap="usePlace">明确选为本次服务地址</button></view>
  </view>
 <view class="section-title">扩展服务与经营入口</view><view class="local-actions"><button bindtap="manage" disabled="{{busy}}">经营与服务方</button><button data-page="matching" bindtap="expansion" disabled="{{busy}}">全国撮合</button><button data-page="dispatch" bindtap="expansion" disabled="{{busy}}">跨城派单</button><button data-page="training" bindtap="expansion" disabled="{{busy}}">培训课程</button></view>
 </view>
 <view wx:if="{{detailLoading}}" class="notice">读取供给详情…</view>
 <view wx:if="{{detail}}" class="card detail-card"><view class="local-actions"><view class="subtitle">{{detail.listing.title}}</view><button bindtap="closeDetail" disabled="{{busy}}">关闭详情</button></view><view>{{detail.listing.description}}</view><view>{{detail.listing.address}}</view><button wx:if="{{detail.listing.point}}" bindtap="navigate">导航到已发布地址</button><view class="muted">{{detail.listing.qualificationText}}。资质由独立审核人核对，医务标签本身不代表已获执业认证。</view><view class="section-title">可预约档期（北京时间）</view><button wx:for="{{detail.slots}}" wx:key="id" class="slot {{selectedSlot===item.id?'picked':''}}" data-id="{{item.id}}" bindtap="slot" disabled="{{!item.available || busy}}">{{item.timeText}} · {{item.available?'可预约':'已被占用'}}</button><view wx:if="{{!detail.slots.length}}" class="muted">暂无有效开放档期。</view><view wx:if="{{detail.listing.kind!=='COURT'}}"><view class="field-label">本次服务地区：{{selection.label}}，如有变化请先选城</view><input class="field" data-field="serviceAddress" value="{{serviceAddress}}" bindinput="input" placeholder="请明确填写实际服务地址" maxlength="200"/><view class="muted">设备定位不会自动当作服务地址；也可在上方查地图地点后明确选择。</view></view><view class="section-title">合作约定</view><view>{{detail.terms}}</view><checkbox-group bindchange="accept"><label><checkbox value="yes" checked="{{accepted}}" disabled="{{busy}}"/>我已阅读并接受以上约定与实际服务地点</label></checkbox-group><button bindtap="previewCharge" disabled="{{busy || pending}}">读取服务器收费条款</button><view wx:if="{{feeRead}}" class="notice"><block wx:if="{{feePreview.enabled}}"><view>实际收款方：{{feePreview.merchantName}}</view><view>本次固定费用 {{feePreview.totalText}}</view><view>{{feePreview.terms}}</view><checkbox-group bindchange="chargeConsent"><label><checkbox value="yes" checked="{{chargeConsent}}" disabled="{{busy}}"/>我已明确核对并接受此收费条款</label></checkbox-group></block><view wx:else>当前来源未启用在线收费。此次创建不绑定收费，后续不会追溯收取。</view></view><view class="muted">最终可用性以服务器原子锁位为准。球场须锁位期限内付款，人员接单后付款；提交不表示付款成功。</view><button class="primary" bindtap="book" disabled="{{busy || pending || pendingError || !accepted || !selectedSlot || !feeRead || (feePreview.enabled && !chargeConsent)}}" loading="{{busy}}">提交预约</button><button wx:if="{{loginRequired}}" bindtap="book">登录后继续预约</button></view>
 </block>
</view><scb-nav wx:if="{{!mapVisible && !filtersOpen}}" active="Local" disabled="{{busy}}"/>
