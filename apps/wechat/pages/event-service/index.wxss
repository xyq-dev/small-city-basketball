.gold-page { background: #fff8f2; color: #59290f; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
.gold-hero { position: relative; min-height: 242px; padding: 24px 16px 28px; background: linear-gradient(90deg, #ffe9d9 0%, #facdb6 100%); }
.gold-tabs { display: flex; width: 252px; height: 48px; margin: 0 auto 12px; padding: 4px; border-radius: 999px; background: #fad8c3; box-sizing: border-box; }
.gold-tab { flex: 1; height: 40px; margin: 0; padding: 0; border-radius: 999px; background: transparent; color: #59290f; font-size: 15px; line-height: 40px; }
.gold-tab.is-on { background: #fff8f2; font-weight: 700; }
.gold-check { width: 22px; height: 22px; }
.gold-headline { font-size: 24px; line-height: 34px; font-weight: 700; }
.gold-sub, .gold-note, .gold-aside { color: #77665a; font-size: 13px; line-height: 20px; }
.gold-crown { position: absolute; right: 4px; top: 78px; width: 126px; height: 140px; }
.gold-sheet { margin-top: -24px; padding: 16px 16px 180px; background: #fff; border-radius: 24px 24px 0 0; }
.gold-banner { position: relative; min-height: 154px; padding: 26px 16px; border-radius: 24px; background: linear-gradient(90deg, #fff6e5 0%, #ffe0c4 100%); }
.gold-banner__title { font-size: 20px; line-height: 28px; font-weight: 700; }
.gold-ticket { position: absolute; right: 8px; top: 22px; width: 146px; height: 128px; }
.gold-section { margin: 20px 0 10px; font-size: 18px; line-height: 27px; font-weight: 700; }
.gold-cards { display: flex; gap: 10px; }
.gold-card { flex: 1; height: 194px; margin: 0; padding: 10px; border: 1px solid #e9d6c8; border-radius: 16px; background: #fff; color: #59290f; text-align: left; line-height: 1.3; }
.gold-card.is-selected { border: 1.5px solid #da5b15; background: #fff0e4; }
.gold-card__title { font-size: 16px; font-weight: 500; }
.gold-card__price { font-size: 38px; line-height: 50px; font-weight: 700; }
.gold-card__price.is-wide, .is-compact .gold-card__price.is-wide { font-size: 30px; }
.is-compact .gold-card__price { font-size: 31px; }
.is-compact .gold-card__price.is-wide { font-size: 25px; }
.gold-card__quota, .gold-card__unit { color: #77665a; font-size: 13px; }
.gold-divider { margin: 16px 0; font-size: 20px; line-height: 28px; font-weight: 700; }
.gold-table { display: flex; min-height: 52px; border-bottom: 0.5px solid #e9d6c8; }
.gold-cell { flex: 1; padding: 6px; font-size: 13px; line-height: 19px; }
.gold-cell.is-label { flex: 1.6; }
.gold-cell.is-hot { background: #fff0e4; }
.gold-dock { position: fixed; left: 0; right: 0; bottom: 0; padding: 16px; background: #fff; border-top: 0.5px solid #e9d6c8; }
.gold-action { width: 100%; height: 52px; margin: 0; border-radius: 999px; background: linear-gradient(90deg, #ffe7bd 0%, #f2a16d 100%); color: #59290f; font-size: 20px; line-height: 52px; }
.gold-link, .gold-text-btn { margin: 8px 0 0; padding: 0; background: transparent; color: #da5b15; font-size: 17px; line-height: 44px; text-align: left; }
.gold-link.is-on { font-weight: 700; }
.gold-input { box-sizing: border-box; width: 100%; min-height: 44px; margin-top: 8px; padding: 8px; border: 1px solid #e9d6c8; border-radius: 12px; }
.gold-row { padding: 8px 0; border-bottom: 0.5px solid #e9d6c8; font-size: 14px; line-height: 21px; }
.gold-demo { margin-left: 8px; color: #da5b15; font-size: 12px; }
.gold-price { font-size: 42px; line-height: 52px; font-weight: 700; }
button::after { border: none; }
