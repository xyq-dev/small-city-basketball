@import "../../styles/figma-pages.wxss";

.process-list{display:flex;flex-direction:column}.process-list>view{display:flex;min-height:55px;align-items:center;gap:10px;border-top:1px solid #e6ebf2}.process-list text{display:flex;width:28px;height:28px;flex:none;align-items:center;justify-content:center;border-radius:50%;background:#eaf2fc;color:#123c73;font-size:12px;font-weight:700}.section-primary,.row-action{display:flex;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 12px;border-radius:22px;font-size:14px}.section-primary{width:100%;border:0;background:#123c73;color:#fff}.row-action{min-width:88px;border:1px solid #7c8ea5;background:#fff;color:#123c73}.row-action--primary{border-color:#123c73;background:#123c73;color:#fff}.section-primary::after,.row-action::after{border:0}.request-row{padding:10px 0;border-top:1px solid #e6ebf2}.request-head{display:flex;min-height:44px;align-items:center;justify-content:space-between;gap:8px}.request-actions{display:flex;margin-top:8px;justify-content:flex-end;gap:8px}
.process-list>view:first-child{border-top:0}.request-note{height:48px;min-height:48px;padding-top:12px;padding-bottom:12px}
