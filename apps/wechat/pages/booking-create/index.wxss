@import "../../styles/figma-pages.wxss";

.pending-summary { background:#fff1e2; }
.recovery-copy { display:flex; flex-direction:column; gap:8px; }
.command-id { padding:10px; border-radius:10px; background:#f4f6fa; color:#123c73; font-family:monospace; font-size:12px; overflow-wrap:anywhere; }
.form-error { color:#c83f42; font-size:12px; line-height:18px; }
.scope-scroll { width:100%; white-space:nowrap; }
.scope-tabs { display:flex; width:100%; min-width:0; height:48px; padding:2px 3px; border-radius:12px; background:#fff; }
.scope-tab { display:flex; min-width:0; height:44px; flex:1; align-items:center; justify-content:center; border-radius:10px; color:#51657d; font-size:11px; }
.scope-tab.is-active { background:#123c73; color:#fff; font-weight:700; }
.booking-create-rebuild .scope-tabs>button.scope-tab { width:auto; min-width:0; max-width:none; height:44px; min-height:44px; margin:0; padding:0 3px; border:0; flex:1 1 0; box-sizing:border-box; background:transparent; }
.booking-create-rebuild .scope-tabs>button.scope-tab.is-active { background:#123c73; color:#fff; }
.booking-display-group { display:flex; width:100%; flex-direction:column; gap:4px; }
.booking-display-control { display:flex; width:100%; min-height:48px; align-items:center; gap:8px; margin:0; padding:4px 12px; border:1px solid #7c8ea5 !important; border-radius:12px !important; background:#fff; color:#18283f; text-align:left; }
.booking-create-rebuild button.booking-display-control { width:100%; min-width:0; max-width:none; box-sizing:border-box; }
.booking-display-value { min-width:0; flex:1; color:#18283f; font-size:14px; line-height:20px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.section-heading { display:flex; align-items:center; justify-content:space-between; gap:8px; }
.section-link { min-width:44px; min-height:44px; color:#123c73; font-size:13px; text-align:right; }
.picker-control { display:flex; align-items:center; }
.choice-row { display:flex; min-height:55px; align-items:center; gap:8px; border-bottom:1px solid #e6ebf2; }
.choice-row:last-child { border-bottom:0; }
.choice-row checkbox { flex:none; }
.datetime-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
.slot-card { display:flex; flex-direction:column; gap:10px; padding:12px; border-radius:12px; background:#f4f6fa; }
.switch-row { display:flex; min-height:44px; align-items:center; justify-content:space-between; gap:8px; }
.booking-fee-row { display:flex; min-height:55px; align-items:center; justify-content:space-between; gap:12px; border-bottom:1px solid #e6ebf2; }
.booking-fee-row--total { margin-top:4px; padding:10px; border:0; border-radius:10px; background:#fff1e2; }
.booking-fee-value { flex:none; color:#123c73; font-size:16px; font-weight:700; line-height:24px; }
.review-slot { display:flex; flex-direction:column; gap:4px; padding:10px 0; border-top:1px solid #e6ebf2; }
.booking-rules-note { padding:10px; border-radius:10px; background:#f4f6fa; }
@media (max-width:360px) { .datetime-grid { grid-template-columns:1fr; } .scope-tab { min-width:0; font-size:10px; } }
