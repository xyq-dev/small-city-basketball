@import "../../styles/figma-pages.wxss";

.ops-tabs {
  display: grid;
  width: 100%;
  min-height: 48px;
  padding: 2px 3px;
  border-radius: 12px;
  background: #ffffff;
}

.ops-tabs--three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.ops-tab { display:flex; min-width:0; min-height:44px; align-items:center; justify-content:center; border-radius:10px; color:#51657d; font-size:13px; line-height:19px; }
.ops-tab.is-active { background:#123c73; color:#ffffff; font-weight:700; }
.ops-field-inline { display:flex; width:100%; align-items:center; gap:10px; }
.ops-field-inline .figma-field-control { min-width:0; flex:1; }
.ops-field-suffix { width:22px; flex:none; color:#51657d; font-size:16px; text-align:center; }
.ops-inline-actions { display:grid; grid-template-columns:minmax(104px, 2fr) minmax(0, 3fr); gap:8px; }
.ops-platform .ops-primary,
.ops-platform .ops-secondary { display:flex; width:100%; min-height:44px; align-items:center; justify-content:center; padding:8px 12px; border-radius:22px; font-size:14px; line-height:20px; text-align:center; }
.ops-platform .ops-primary { background:#f28c28; color:#18283f; }
.ops-platform .ops-secondary { border:1px solid #7c8ea5; background:#ffffff; color:#123c73; }
.ops-platform .ops-primary[disabled],
.ops-platform .ops-secondary[disabled] { border-color:#e6ebf2; background:#e6ebf2; color:#7c8ea5; }
.ops-picker { display:flex; align-items:center; font-size:14px; line-height:20px; }
.ops-review-snapshot { display:flex; flex-direction:column; gap:4px; padding:10px; border-radius:10px; background:#f4f6fa; }
.ops-review-editor textarea { height:112px; }
.ops-summary--preview { background:#eaf2fc; }

@media (max-width: 360px) {
  .ops-inline-actions { grid-template-columns:minmax(0, 1fr); }
}
