.platform-notice { display:flex; flex-direction:column; gap:4px; }
.notice-title,.state-title { font-size:14px; line-height:24px; font-weight:500; }
.platform-order,.review-row { display:flex; flex-direction:column; gap:8px; border-bottom:1px solid #e8edf2; padding:16px 0; }
.platform-order:last-child,.review-row:last-child { border-bottom:0; }
.platform-order .subtitle,.review-row .subtitle { font-size:18px; line-height:28px; margin:0; font-weight:500; }
.platform-order button,.review-row button { margin:0; }
.appearance-status,.appearance-price { color:#132c49; font-size:14px; line-height:24px; font-weight:500; }
.appearance-status.danger { color:#b53333; }
.section-empty { display:flex; flex-direction:column; gap:8px; padding:12px 0 16px; }
.fee-value { display:flex; align-items:center; gap:12px; }
.fee-value .field { flex:1; min-width:0; }
.fee-value > text { flex:0 0 16px; color:#617286; }
.fee-card button { margin:16px 0 0; }
.review-summary { display:flex; flex-direction:column; gap:8px; }
.review-summary .subtitle { margin:0; }
.review-editor textarea { min-height:112px; }
.state-card { display:flex; flex-direction:column; gap:8px; }
.state-card .subtitle { margin:0; }
.state-card button { margin:8px 0 0; }
.skeleton { height:12px; width:88%; background:#eaf0f7; border-radius:6px; margin:6px 0; }
.skeleton.short { width:56%; }

.ui002-workspace { padding:16px 16px calc(104px + env(safe-area-inset-bottom)); background:#f4f6fa; color:#18283f; }
.ui002-workspace .card { border-radius:16px; padding:16px; margin:0 0 16px; }
.ui002-workspace input,.ui002-workspace textarea,.ui002-workspace button { font-size:16px; line-height:24px; min-height:44px; }
.ui002-workspace .page-intro .title { color:#18283f; font-size:22px; line-height:32px; margin:0 0 8px; }
.ui002-workspace .page-intro { margin-bottom:16px; }
.ui002-workspace .tabs button { min-height:44px; }

.ui002-workspace .notice { font-size:14px; line-height:22px; border-radius:12px; padding:12px; }
.platform-summary { color:#18283f; }
.platform-summary-icon { display:flex; align-items:center; justify-content:center; flex:0 0 44px; width:44px; height:44px; border-radius:12px; background:#fff; }
.platform-summary-icon image { width:25px; height:25px; }
.platform-tabs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1px; min-height:44px; margin-bottom:12px; padding:2px 3px; border-radius:12px; background:#fff; color:#63758b; font-size:14px; line-height:40px; text-align:center; }
.platform-tabs > view { height:40px; border-radius:10px; }
.platform-tabs .selected { color:#fff; background:#123c73; font-weight:700; }
.platform-tools { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; padding:14px !important; }
.platform-tools .fig-card-title { grid-column:1/-1; margin:0; }
.platform-tools button { display:flex; flex-direction:column; align-items:flex-start; justify-content:center; min-width:0; min-height:84px; margin:0; padding:12px; border-radius:10px; color:#18283f; background:#f4f6fa; text-align:left; font-size:16px; line-height:24px; font-weight:700; }
.platform-tools button::after { border:0; }
.platform-tools button text { color:#63758b; font-size:12px; line-height:18px; font-weight:400; }
