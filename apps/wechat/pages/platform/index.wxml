<view class="page platform-page">
  <view wx:if="{{error}}" class="notice danger state-card" role="alert"><view class="state-title">平台资料需要重新核对</view><view class="small">{{error}}</view></view>
  <button wx:if="{{error && !loading && !allowed && !loginRequired}}" class="secondary" bindtap="load" disabled="{{busy || reviewOpen || feeDirty}}">重新核对平台权限</button>
  <view wx:if="{{loading}}" class="card state-card loading-card"><view class="state-title">正在核对平台权限</view><view class="skeleton"></view><view class="skeleton short"></view><view class="small muted">核对完成后显示当前可处理的资料…</view></view>
  <view wx:elif="{{loginRequired}}" class="card state-card empty"><view class="subtitle">登录后继续平台处理</view><view class="muted">平台身份与独立处理权限由当前账号核对。</view><button class="primary" bindtap="login">登录后继续</button></view>
  <view wx:elif="{{!allowed && !error}}" class="card state-card empty"><view class="subtitle">平台权限尚未就绪</view><view class="muted">核对当前账号后，才显示有权处理的资料与预约。</view><button class="secondary" bindtap="load">核对当前权限</button></view>
  <block wx:if="{{allowed}}">
    <view class="notice warning platform-notice"><view class="notice-title">仅独立平台人员可操作</view><view class="small">拥有平台身份不代表可处理与本人或关联球队有关的订单。资料审核不等于实名、保险、参赛资格或实力认证。</view></view>
    <view wx:if="{{!reviewOpen}}" class="card platform-orders">
      <view class="subtitle">预约与争议</view>
      <view wx:if="{{!orders.length}}" class="section-empty"><view class="muted">暂无可见预约</view><view class="small muted">当前可查看的合作将在这里列出。</view></view>
      <view wx:for="{{orders}}" wx:key="id" class="platform-order">
        <view class="appearance-status {{item.disputed ? 'danger' : ''}}">{{item.disputed ? '有可独立处理的争议项' : '当前可见合作'}}</view>
        <view class="subtitle">{{item.eventName}}</view><view class="muted">{{item.teamName}}</view>
        <view class="appearance-price">确定报价 {{item.total}} · 支付未开放</view>
        <button class="secondary" data-id="{{item.id}}" bindtap="order">核对逐场记录与处理能力</button>
      </view>
      <view class="small muted">最多展示最新100份可见预约，不代表完整历史。</view>
    </view>
    <view wx:if="{{!reviewOpen}}" class="card fee-card">
      <view class="subtitle">新预约平台费率</view><view class="field-label">百分比，仅按参赛服务费计算</view>
      <view class="fee-value"><input disabled="{{busy}}" class="field" type="digit" value="{{feePercent}}" bindinput="feeInput"/><text>%</text></view>
      <view class="small muted">旧订单保留原费率与金额快照，交通食宿不计入基数。</view>
      <button class="secondary" disabled="{{busy || !feeDirty}}" bindtap="saveFee">核对并更新新费率</button><button wx:if="{{feeDirty}}" class="quiet" bindtap="discardFee" disabled="{{busy}}">放弃当前费率编辑</button>
    </view>
    <view wx:if="{{!reviewOpen}}" class="card review-queue">
      <view class="subtitle">服务资料审核</view><view wx:if="{{!reviewQueue.length}}" class="section-empty"><view class="muted">暂无可审核资料</view><view class="small muted">本人提交的服务资料可按审核范围处理。</view></view>
      <view wx:for="{{reviewQueue}}" wx:key="id" class="review-row"><view class="appearance-status">{{item.stateLabel}}</view><view class="subtitle">{{item.displayName}} · {{item.positionLabel}}</view><view class="appearance-price">{{item.price}} / 场</view><button class="secondary" data-id="{{item.id}}" bindtap="review" disabled="{{busy || reviewOpen}}">核对并处理资料</button></view>
      <view class="small muted">最多展示当前最新200份可见资料。</view>
    </view>
    <view wx:if="{{reviewOpen}}" class="review-editor">
      <view class="card review-summary"><view class="subtitle">处理：{{reviewName}}</view>
        <block wx:if="{{reviewSnapshot}}"><view class="muted">{{reviewSnapshot.city}} · {{reviewSnapshot.height}}cm</view><view>{{reviewSnapshot.bio}}</view><view class="small muted">参赛 {{reviewSnapshot.price}} · 交通 {{reviewSnapshot.travel}} · 食宿 {{reviewSnapshot.accommodation}}</view><view wx:for="{{reviewSnapshot.availability}}" wx:key="index" class="small muted">{{item}}</view></block>
      </view>
      <view class="field-label">资料处理结果</view><picker disabled="{{busy}}" class="field" range="{{statuses}}" value="{{statusIndex}}" bindchange="status"><view>{{statuses[statusIndex]}}</view></picker>
      <view class="field-label">处理依据与原因</view><textarea disabled="{{busy}}" class="field" maxlength="500" value="{{reviewReason}}" bindinput="reason" placeholder="至少2个字，保留核对依据"/>
      <view class="notice small">审核只针对本次展示版本；资料更新后须关闭并重新核对，不沿用旧声明。</view>
      <checkbox-group bindchange="agree"><label class="consent"><checkbox disabled="{{busy}}" value="yes" checked="{{consent}}"/><text>我确认按资料审核范围作出本次处理</text></label></checkbox-group>
      <button class="primary" bindtap="submitReview" disabled="{{busy || !consent || reviewReason.length < 2}}">确认处理资料</button><button class="quiet" bindtap="closeReview" disabled="{{busy}}">关闭本次处理</button>
    </view>
    <view wx:if="{{paymentNotice}}" class="notice small">{{paymentNotice}}</view>
    <button class="secondary" bindtap="load" disabled="{{busy || loading || reviewOpen || feeDirty}}">刷新平台资料</button>
  </block>
</view>
