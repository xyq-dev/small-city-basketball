<view class="page"><view class="title">平台服务与独立处理</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="muted">正在核对平台权限…</view><button wx:if="{{loginRequired}}" class="primary" bindtap="login">登录后继续</button>
<block wx:if="{{allowed}}"><view class="notice warning">资料审核不等于实名、保险、参赛资格或实力认证。争议仅由与双方无关联的平台人员处理，具体操作由服务器当前能力决定。</view>
<view class="card"><view class="subtitle">新预约平台费率</view><view class="field-label">百分比，仅按参赛服务费计算</view><input disabled="{{busy}}" class="field" type="digit" value="{{feePercent}}" bindinput="feeInput"/><view class="muted">旧订单保留原费率与金额快照，交通食宿不计入基数。</view><button class="secondary" disabled="{{busy || !feeDirty}}" bindtap="saveFee">核对并更新新费率</button><button wx:if="{{feeDirty}}" class="quiet" bindtap="discardFee" disabled="{{busy}}">放弃当前费率编辑</button></view>
<view class="card"><view class="subtitle">服务资料审核</view><view wx:if="{{!reviewQueue.length}}" class="muted">暂无可审核资料</view><view wx:for="{{reviewQueue}}" wx:key="id" class="row"><view>{{item.displayName}} · {{item.positionLabel}}</view><view class="muted">{{item.stateLabel}} · {{item.price}} / 场</view><button class="secondary" data-id="{{item.id}}" bindtap="review" disabled="{{busy || reviewOpen}}">核对并处理资料</button></view><view class="muted small">最多展示当前最新200份可见资料。</view></view>
<view wx:if="{{reviewOpen}}" class="card"><view class="subtitle">处理：{{reviewName}}</view><view wx:if="{{reviewSnapshot}}" class="card"><view>{{reviewSnapshot.city}} · {{reviewSnapshot.height}}cm</view><view>{{reviewSnapshot.bio}}</view><view>参赛 {{reviewSnapshot.price}} · 交通 {{reviewSnapshot.travel}} · 食宿 {{reviewSnapshot.accommodation}}</view><view wx:for="{{reviewSnapshot.availability}}" wx:key="index" class="muted">{{item}}</view></view><picker disabled="{{busy}}" class="field" range="{{statuses}}" value="{{statusIndex}}" bindchange="status">{{statuses[statusIndex]}}</picker><view class="field-label">处理原因</view><textarea disabled="{{busy}}" class="field" maxlength="500" value="{{reviewReason}}" bindinput="reason" placeholder="至少2个字，保留核对依据"/><checkbox-group bindchange="agree"><label class="consent"><checkbox disabled="{{busy}}" value="yes" checked="{{consent}}"/>我确认按资料审核范围作出本次处理</label></checkbox-group><button class="primary" bindtap="submitReview" disabled="{{busy || !consent || reviewReason.length &lt; 2}}">确认处理资料</button><button class="quiet" bindtap="closeReview" disabled="{{busy}}">关闭本次处理</button></view>
<view class="card"><view class="subtitle">预约与争议</view><view wx:if="{{!orders.length}}" class="muted">暂无可见预约</view><view wx:for="{{orders}}" wx:key="id" class="row"><view>{{item.eventName}} · {{item.teamName}}</view><view class="muted">确定报价 {{item.total}}</view><view wx:if="{{item.disputed}}" class="badge warning">有可独立处理的争议项</view><button class="secondary" data-id="{{item.id}}" bindtap="order">查看逐场能力与处理记录</button></view><view class="muted small">最多展示最新100份可见预约，不代表完整历史。</view></view><view class="notice">{{paymentNotice}}</view><button class="quiet" bindtap="load" disabled="{{busy || loading || reviewOpen || feeDirty}}">刷新平台资料</button></block></view>
