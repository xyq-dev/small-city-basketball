<scb-header title="{{figmaState==='scorer-readonly' || pending || reportOnly || match.closed || match.adjudication || (!held && (!canControl || !!leaseNote)) ? '记分台暂不可写' : '记分台'}}" disabled="{{busy || !!pending}}"/>

<view class="figma-page scorer-page">
  <view class="figma-page__content {{match || figmaState ? 'figma-page__content--actions' : ''}}">
    <block wx:if="{{figmaState==='scorer-readonly'}}">
      <view class="scorer-state-hero"><view class="figma-section__title">记分台暂不可写</view><view class="scorer-state-hero__body">请核对权限、比赛阶段和最新版本；当前内容保留。</view></view>
      <view class="figma-section scorer-board"><view class="figma-section__title">本场比分</view><view class="scorer-score-grid"><view class="scorer-score-card is-home"><view class="scorer-team">{{figmaStateModel.home}}</view><view class="scorer-score">{{figmaStateModel.homeScore}}</view><view class="figma-row__subtitle">{{figmaStateModel.period}}</view></view><view class="scorer-score-card is-away"><view class="scorer-team">{{figmaStateModel.away}}</view><view class="scorer-score">{{figmaStateModel.awayScore}}</view><view class="figma-row__subtitle">最近一次服务端快照</view></view></view></view>
      <view class="figma-section"><view class="figma-section__title">操作恢复</view><view class="scorer-recovery-row"><view class="scorer-dot"/><view class="figma-row__copy"><view class="figma-row__title">记分台占用</view><view class="figma-row__subtitle">等待授权记录员交接。</view></view><view class="figma-status">只读</view></view><view class="scorer-recovery-row"><view class="scorer-dot"/><view class="figma-row__copy"><view class="figma-row__title">上次加分结果</view><view class="figma-row__subtitle">先核对原命令回执与比分。</view></view><view class="figma-status figma-status--orange">待核对</view></view></view>
    </block>

    <block wx:else>
    <view wx:if="{{loading && !match}}" class="figma-section"><figma-skeleton rows="5"/><view class="figma-caption">正在读取比赛、控制权与最近服务端快照</view></view>
    <figma-feedback
      wx:elif="{{!match}}"
      type="{{unavailable ? 'pending' : 'error'}}"
      title="{{unavailable ? '无法进入记分台' : '比赛读取失败'}}"
      body="{{error || '请从比赛详情重新进入。'}}"
      action-label="{{unavailable ? '' : '重新读取'}}"
      bind:action="load"
    />

    <block wx:else>
      <figma-feedback wx:if="{{error && !pending}}" type="error" title="记分操作未完成" body="{{error}}"/>
      <figma-feedback wx:if="{{notice}}" type="success" title="状态已更新" body="{{notice}}"/>

      <figma-feedback
        wx:if="{{pending}}"
        type="pending"
        title="“{{pending.label}}”结果待核对"
        body="已暂停新的记分。先核对原命令回执；只有服务端确认未收到时才按原编号重发。"
      />
      <view wx:if="{{pending}}" class="scorer-pending-actions">
        <button class="figma-action figma-action--orange" bindtap="checkPending" disabled="{{busy}}">核对结果</button>
        <button class="figma-action figma-action--ghost" bindtap="resendPending" disabled="{{busy}}">按原编号重发</button>
      </view>

      <figma-feedback
        wx:if="{{!pending && (reportOnly || match.closed || match.adjudication || (!held && (!canControl || !!leaseNote)))}}"
        type="pending"
        title="记分台暂不可写"
        body="{{match.adjudication ? match.statusLabel + '，本场不计个人样本或出场。' : match.closed ? '本届赛事已完赛或归档，不再接受记分。' : reportOnly ? '当前是专业统计只读报表。' : leaseNote || '请核对权限、比赛阶段和最新版本；当前内容保留。'}}"
      />

      <view wx:if="{{!(reportOnly || match.closed || match.adjudication || (!held && (!canControl || !!leaseNote)))}}" class="figma-summary">
        <view class="figma-summary__icon"><figma-icon name="scoreboard" size="25"/></view>
        <view class="figma-summary__copy"><view class="figma-eyebrow">{{match.eventName ? '本场记分员 · ' + match.eventName : '本场记分员'}}</view><view class="figma-title">现场记分</view><view class="figma-subtitle">现场写入以有效控制权与服务端回执为准</view></view>
      </view>

      <view class="scorer-tabs" role="tablist">
        <button class="scorer-tab {{consoleSection === 'score' ? 'is-active' : ''}}" data-section="score" bindtap="openConsoleSection" disabled="{{busy || loading}}">记分</button>
        <button class="scorer-tab {{consoleSection === 'lineup' ? 'is-active' : ''}}" data-section="lineup" bindtap="openConsoleSection" disabled="{{busy || loading || !board.proMode}}">阵容</button>
        <button class="scorer-tab {{consoleSection === 'history' ? 'is-active' : ''}}" data-section="history" bindtap="openConsoleSection" disabled="{{busy || loading}}">更正</button>
      </view>

      <view id="scorer-board" class="figma-section scorer-board">
        <view class="scorer-section-head"><view class="figma-section__title">{{board && !board.adjudicated ? board.periodLabel + ' ' + board.clockLabel : '本场比分'}}</view><view wx:if="{{!hideScoreStatus}}" class="figma-status {{match.status === 'LIVE' ? 'figma-status--error' : 'figma-status--orange'}}">{{match.statusLabel}}</view></view>
        <view class="scorer-score-grid">
          <view class="scorer-score-card is-home"><view class="scorer-team">{{match.home}}</view><view class="scorer-score">{{board && !board.adjudicated ? board.home.score : '–'}}</view><view wx:if="{{board && !board.adjudicated && board.home.periodScore !== undefined}}" class="figma-row__subtitle">本节 {{board.home.periodScore}} 分</view></view>
          <view class="scorer-score-card is-away"><view class="scorer-team">{{match.away}}</view><view class="scorer-score">{{board && !board.adjudicated ? board.away.score : '–'}}</view><view wx:if="{{board && !board.adjudicated && board.away.periodScore !== undefined}}" class="figma-row__subtitle">本节 {{board.away.periodScore}} 分</view></view>
        </view>
        <view wx:if="{{board && !board.adjudicated && !hideBoardHint}}" class="figma-section__hint">{{board.running ? '计时中' : '时钟已暂停'}} · 犯规 {{board.home.fouls}} : {{board.away.fouls}} · 暂停 {{board.home.timeouts}} : {{board.away.timeouts}}</view>
      </view>

      <view wx:if="{{board && (canControl || offlineItems.length || offlineError)}}" id="scorer-offline" class="figma-section">
        <view class="scorer-section-head"><view class="figma-section__title">可靠离线草稿</view><view class="figma-status {{offlineItems.length ? 'figma-status--orange' : ''}}">{{offlineItems.length}} 条</view></view>
        <view class="figma-section__hint">草稿按账号与场次保存在本机，未同步不计入比分；时钟、阵容、节次与确认不可离线操作。</view>
        <figma-feedback wx:if="{{offlineError}}" type="error" title="本地草稿不可用" body="{{offlineError}}"/>
        <view wx:for="{{offlineItems}}" wx:key="id" class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">第{{item.ordinal}}条 · {{item.label}}</view><view class="figma-row__subtitle">{{item.detail}} · 未同步</view></view><view class="figma-status figma-status--orange">草稿</view></view>
        <button class="figma-action figma-action--ghost" bindtap="toggleOffline" disabled="{{busy || !!pending || !!offlineError || !canControl}}">{{offlineDraft ? '退出离线草稿模式' : '进入离线草稿模式'}}</button>
        <button wx:if="{{offlineItems.length}}" class="figma-action figma-action--navy" bindtap="syncOffline" disabled="{{busy || !held || !!pending || !!offlineError}}">按原顺序同步并核对</button>
        <view wx:if="{{offlineItems.length}}" class="scorer-inline-grid"><button class="scorer-link-action" bindtap="exportOffline" disabled="{{busy || !!offlineError}}">导出逐条核对</button><button class="scorer-link-action is-danger" bindtap="discardOffline" disabled="{{busy}}">删除本地草稿</button></view>
      </view>

      <view wx:if="{{board && board.playerMode && !board.proMode && !board.adjudicated}}" class="figma-section scorer-lineup-note">
        <view class="figma-section__title">首发与换人</view>
        <view class="figma-section__hint">本场只采集球员得分，未启用专业阵容采集；不能补造首发、换人或上场时间。</view>
      </view>

      <view wx:if="{{board && board.proMode && !board.adjudicated}}" id="scorer-lineup" class="figma-section">
        <view class="figma-section__title">首发与换人</view>
        <view class="figma-section__hint">专业统计与实际阵容时间：上场时间取最近权威时钟快照；校时不虚增时间，未登场球员不会计为出场。</view>
        <view wx:for="{{proGroups}}" wx:key="key" class="scorer-team-block">
          <view class="scorer-section-head"><view class="figma-row__title">{{item.name}}</view><view class="figma-status">阵容</view></view>
          <checkbox-group wx:if="{{held && match.status === 'READY'}}" data-side="{{item.key}}" bindchange="pickLineup"><label wx:for="{{item.players}}" wx:for-item="player" wx:key="memberId" class="figma-check"><checkbox value="{{player.memberId}}" checked="{{player.checked}}"/><text>{{player.label}}</text></label></checkbox-group>
          <button wx:if="{{held && match.status === 'READY'}}" class="figma-action figma-action--ghost" data-side="{{item.key}}" bindtap="setLineup" disabled="{{busy || !!pending}}">确认{{item.name}}首发（最多5人）</button>
          <view wx:if="{{held && match.status === 'LIVE' && !board.running}}" class="scorer-substitution"><view class="figma-field-group"><view class="figma-field-label">换下球员</view><picker class="figma-field-control scorer-picker" range="{{item.players}}" range-key="label" value="{{subOut[item.key]}}" data-side="{{item.key}}" data-role="out" bindchange="subPick">{{item.players[subOut[item.key]].label}}</picker></view><view class="figma-field-group"><view class="figma-field-label">换上球员</view><picker class="figma-field-control scorer-picker" range="{{item.players}}" range-key="label" value="{{subIn[item.key]}}" data-side="{{item.key}}" data-role="in" bindchange="subPick">{{item.players[subIn[item.key]].label}}</picker></view><button class="figma-action figma-action--navy" data-side="{{item.key}}" bindtap="substitute" disabled="{{busy || !!pending}}">确认换人</button></view>
          <view wx:for="{{item.players}}" wx:for-item="player" wx:key="memberId" class="scorer-player"><view class="scorer-section-head"><view class="figma-row__title">{{player.label}}</view><view class="figma-status {{player.onCourt ? 'figma-status--green' : ''}}">{{player.onCourt ? '在场' : player.appeared ? '已登场' : '未登场'}}</view></view><view class="figma-row__subtitle">{{player.starter ? '首发' : '替补'}} · {{player.time}} · 投篮 {{player.shooting}}（{{player.percent}}）</view><view class="figma-row__subtitle">三分 {{player.threePointersMade}}/{{player.threePointersAttempted}} · 罚球 {{player.freeThrowsMade}}/{{player.freeThrowsAttempted}}</view><view class="figma-row__subtitle">篮板 {{player.rebounds}} · 助攻 {{player.assists}} · 抢断 {{player.steals}} · 盖帽 {{player.blocks}} · 失误 {{player.turnovers}}</view></view>
        </view>
      </view>

      <view wx:if="{{!held && !offlineDraft}}" class="figma-section scorer-control-state">
        <view class="figma-section__title">操作恢复</view>
        <view wx:if="{{leaseNote}}" class="scorer-recovery-row"><view class="scorer-dot"></view><view class="figma-row__copy"><view class="figma-row__title">记分台占用</view><view class="figma-row__subtitle">{{leaseNote}}</view></view><view class="figma-status">只读</view></view>
        <view wx:if="{{pending}}" class="scorer-recovery-row"><view class="scorer-dot"></view><view class="figma-row__copy"><view class="figma-row__title">上次操作结果</view><view class="figma-row__subtitle">先核对原命令回执与比分。</view></view><view class="figma-status figma-status--orange">待核对</view></view>
        <view wx:if="{{!board}}" class="scorer-recovery-row"><view class="scorer-dot"></view><view class="figma-row__copy"><view class="figma-row__title">比赛尚未准备</view><view class="figma-row__subtitle">请赛事负责人在比赛详情中准备比赛。</view></view><view class="figma-status">只读</view></view>
        <button wx:if="{{canControl && board && !pending}}" class="figma-action figma-action--orange" bindtap="acquire" disabled="{{busy}}">取得记分控制</button>
        <view class="figma-section__hint">同一时间只有一个记分端可以写入；控制每10秒续约，断网或离开页面即停止写入。</view>
      </view>

      <block wx:if="{{held || offlineDraft}}">
        <button wx:if="{{match.status === 'READY' && !offlineDraft}}" class="figma-action figma-action--orange" bindtap="start" disabled="{{busy || !!pending}}">开始比赛</button>

        <view wx:if="{{match.status === 'LIVE'}}" class="figma-section scorer-actions">
          <view class="figma-section__title">场上操作</view>
          <view class="scorer-team-actions">
            <view class="scorer-action-title">主队 · {{match.home}}</view>
            <view class="scorer-points-grid"><button wx:for="{{board.allowedScores}}" wx:key="*this" class="scorer-point is-home" data-side="HOME" data-kind="SCORE" data-value="{{item}}" bindtap="stat" disabled="{{busy || !!pending}}">{{board.proMode ? '投中 ' : '+'}}{{item}}{{board.proMode ? '分' : ''}}</button></view>
          </view>
          <view class="scorer-team-actions">
            <view class="scorer-action-title">客队 · {{match.away}}</view>
            <view class="scorer-points-grid"><button wx:for="{{board.allowedScores}}" wx:key="*this" class="scorer-point is-away" data-side="AWAY" data-kind="SCORE" data-value="{{item}}" bindtap="stat" disabled="{{busy || !!pending}}">{{board.proMode ? '投中 ' : '+'}}{{item}}{{board.proMode ? '分' : ''}}</button></view>
          </view>
          <view class="scorer-minor-grid"><button class="scorer-minor" data-kind="FOUL" bindtap="teamStat" disabled="{{busy || !!pending}}">球队犯规</button><button class="scorer-minor" data-kind="TIMEOUT" bindtap="teamStat" disabled="{{busy || !!pending}}">球队暂停</button></view>

          <button wx:if="{{board.playerMode}}" class="scorer-more-toggle" bindtap="togglePlayerAssign" disabled="{{busy || !!pending}}">{{playerAssignOpen ? '收起球员归属' : '选择得分球员'}}</button>
          <view wx:if="{{board.playerMode && playerAssignOpen}}" class="scorer-player-assignment">
            <view class="figma-field-group"><view class="figma-field-label">{{match.home}} · 当前球员</view><picker class="figma-field-control scorer-picker" range="{{roster.home}}" range-key="label" value="{{pick.home}}" data-side="home" bindchange="pickPlayer">{{roster.home[pick.home].label}}</picker></view>
            <view class="figma-field-group"><view class="figma-field-label">{{match.away}} · 当前球员</view><picker class="figma-field-control scorer-picker" range="{{roster.away}}" range-key="label" value="{{pick.away}}" data-side="away" bindchange="pickPlayer">{{roster.away[pick.away].label}}</picker></view>
            <block wx:if="{{board.proMode}}"><view class="scorer-action-title">专业统计 · {{match.home}}</view><view class="scorer-pro-grid"><button wx:for="{{board.allowedScores}}" wx:key="*this" class="scorer-minor" data-side="HOME" data-value="{{item}}" bindtap="missShot" disabled="{{busy || !!pending}}">{{item}}分未中</button><button wx:for="{{technicalKinds}}" wx:key="kind" class="scorer-minor" data-side="HOME" data-kind="{{item.kind}}" bindtap="technical" disabled="{{busy || !!pending}}">{{item.label}}</button></view><view class="scorer-action-title">专业统计 · {{match.away}}</view><view class="scorer-pro-grid"><button wx:for="{{board.allowedScores}}" wx:key="*this" class="scorer-minor" data-side="AWAY" data-value="{{item}}" bindtap="missShot" disabled="{{busy || !!pending}}">{{item}}分未中</button><button wx:for="{{technicalKinds}}" wx:key="kind" class="scorer-minor" data-side="AWAY" data-kind="{{item.kind}}" bindtap="technical" disabled="{{busy || !!pending}}">{{item.label}}</button></view></block>
          </view>

          <button wx:if="{{!offlineDraft}}" class="scorer-more-toggle" bindtap="toggleMoreControls" disabled="{{busy || !!pending}}">{{moreControlsOpen ? '收起更多比赛控制' : '更多比赛控制'}}</button>
          <view wx:if="{{!offlineDraft && moreControlsOpen}}" class="scorer-clock-tools">
            <view class="scorer-three-grid"><button class="scorer-minor" bindtap="nextPeriod" disabled="{{busy || !!pending}}">下一节</button><button class="scorer-minor" bindtap="overtime" disabled="{{busy || !!pending}}">加时</button><button class="scorer-minor" bindtap="toggleClock" disabled="{{busy || !!pending}}">校时</button></view>
            <view wx:if="{{clockOpen}}" class="scorer-form"><view class="figma-field-group"><view class="figma-field-label">本节剩余时间（分:秒）</view><input class="figma-field-control" value="{{clockValue}}" data-field="clockValue" bindinput="clockInput" placeholder="例如 05:30"/></view><view class="figma-field-group"><view class="figma-field-label">校时原因</view><input class="figma-field-control" value="{{clockReason}}" data-field="clockReason" bindinput="clockInput" placeholder="例如 计时器漏停"/></view><button class="figma-action figma-action--orange" bindtap="submitClock" disabled="{{busy}}">确认校时</button></view>
            <button class="figma-action scorer-danger" bindtap="end" disabled="{{busy || !!pending}}">结束比赛</button>
          </view>
        </view>

        <figma-feedback wx:if="{{match.status === 'PENDING_CONFIRMATION'}}" type="pending" title="等待独立确认" body="确认前可撤销错误记录或补录更正；正式赛果须由其他授权人确认。"/>

        <view wx:if="{{match.status === 'LIVE' || match.status === 'PENDING_CONFIRMATION'}}" class="figma-section scorer-fix">
          <view class="scorer-section-head"><view class="figma-section__title">补录更正</view><button class="scorer-link-action" bindtap="toggleFix">{{fixOpen ? '收起' : '补录'}}</button></view>
          <view class="figma-section__hint">更正生成新事件并保留原事件，不直接覆盖历史。</view>
          <block wx:if="{{fixOpen}}">
            <view class="scorer-choice-grid"><button class="scorer-choice {{fix.side === 'HOME' ? 'is-active' : ''}}" data-field="side" data-value="HOME" bindtap="fixField">{{match.home}}</button><button class="scorer-choice {{fix.side === 'AWAY' ? 'is-active' : ''}}" data-field="side" data-value="AWAY" bindtap="fixField">{{match.away}}</button></view>
            <view class="scorer-three-grid"><button class="scorer-choice {{fix.kind === 'SCORE' ? 'is-active' : ''}}" data-field="kind" data-value="SCORE" bindtap="fixField">得分</button><button class="scorer-choice {{fix.kind === 'FOUL' ? 'is-active' : ''}}" data-field="kind" data-value="FOUL" bindtap="fixField">犯规</button><button class="scorer-choice {{fix.kind === 'TIMEOUT' ? 'is-active' : ''}}" data-field="kind" data-value="TIMEOUT" bindtap="fixField">暂停</button></view>
            <view wx:if="{{fix.kind === 'SCORE'}}" class="scorer-points-grid"><button wx:for="{{board.allowedScores}}" wx:key="*this" class="scorer-choice {{fix.value === item ? 'is-active' : ''}}" data-field="value" data-value="{{item}}" bindtap="fixField">{{item}}分</button></view>
            <block wx:if="{{board.proMode}}"><view class="scorer-pro-grid"><button wx:for="{{technicalKinds}}" wx:key="kind" class="scorer-choice {{fix.kind === item.kind ? 'is-active' : ''}}" data-field="kind" data-value="{{item.kind}}" bindtap="fixField">{{item.label}}</button></view><picker wx:if="{{fix.side === 'HOME'}}" class="figma-field-control scorer-picker" range="{{roster.home}}" range-key="label" value="{{pick.home}}" data-side="home" bindchange="pickPlayer">{{roster.home[pick.home].label}}</picker><picker wx:else class="figma-field-control scorer-picker" range="{{roster.away}}" range-key="label" value="{{pick.away}}" data-side="away" bindchange="pickPlayer">{{roster.away[pick.away].label}}</picker><view wx:if="{{fix.kind === 'SCORE'}}" class="scorer-choice-grid"><button class="scorer-choice {{fix.made !== false ? 'is-active' : ''}}" data-field="made" data-value="true" bindtap="fixField">命中</button><button class="scorer-choice {{fix.made === false ? 'is-active' : ''}}" data-field="made" data-value="false" bindtap="fixField">未命中</button></view></block>
            <view class="figma-field-group"><view class="figma-field-label">节次</view><input class="figma-field-control" type="number" value="{{fix.period}}" data-field="period" bindinput="fixField"/></view>
            <view class="figma-field-group"><view class="figma-field-label">补录原因</view><input class="figma-field-control" value="{{fix.reason}}" data-field="reason" bindinput="fixField" placeholder="说明漏记或需要更正的原事件"/></view>
            <button class="figma-action figma-action--orange" bindtap="submitFix" disabled="{{busy || !!pending}}">提交补录</button>
          </block>
        </view>

        <view wx:if="{{voidTarget}}" class="figma-section"><view class="figma-section__title">撤销：{{voidTarget.text}}</view><view class="figma-section__hint">撤销会新增审计事件，原记录仍保留。</view><view class="figma-field-group"><view class="figma-field-label">撤销原因</view><input class="figma-field-control" value="{{voidReason}}" bindinput="voidInput" placeholder="说明原记录错误"/></view><view class="scorer-choice-grid"><button class="figma-action scorer-danger" bindtap="submitVoid" disabled="{{busy}}">确认撤销</button><button class="figma-action figma-action--ghost" bindtap="cancelVoid">取消</button></view></view>
      </block>

      <view wx:if="{{lineupCorrection}}" class="figma-section scorer-lineup-correction"><view class="figma-section__title">更正历史阵容</view><view class="figma-section__hint">重新计算该段上场时间并保留原阵容事件。</view><checkbox-group bindchange="correctionLineupPick"><label wx:for="{{lineupCorrection.players}}" wx:key="memberId" class="figma-check"><checkbox value="{{item.memberId}}" checked="{{item.checked}}"/><text>{{item.label}}</text></label></checkbox-group><view class="figma-field-group"><view class="figma-field-label">更正原因</view><input class="figma-field-control" value="{{lineupCorrection.reason}}" bindinput="correctionLineupReason" placeholder="填写阵容更正原因"/></view><view class="scorer-choice-grid"><button class="figma-action figma-action--orange" bindtap="submitLineupCorrection" disabled="{{busy || !!pending}}">提交阵容更正</button><button class="figma-action figma-action--ghost" bindtap="cancelLineupCorrection">取消</button></view></view>

      <view id="scorer-history" class="figma-section">
        <view class="figma-section__title">{{consoleSection === 'history' ? '记录与更正' : '最近事件'}}</view>
        <view class="figma-section__hint">{{consoleSection === 'history' ? '最近记录按服务端事件顺序展示；撤销或补录会新增事件并保留原记录。' : '最近三条记录；更正入口保留原事件与审计轨迹。'}}</view>
        <figma-feedback wx:if="{{!history.length}}" type="empty" title="暂无已读取的记分事件" body="未采集的数据不会补造。"/>
        <block wx:for="{{history}}" wx:key="key"><view wx:if="{{consoleSection === 'history' || index < 3}}" class="figma-row scorer-history-row {{item.voided ? 'is-voided' : ''}}"><view class="figma-row__copy"><view class="figma-row__title">{{item.text}}{{item.voided ? '（已撤销）' : ''}}</view><view class="figma-row__subtitle">{{item.periodLabel}} {{item.time}}</view></view><button wx:if="{{held && board.proMode && item.canCorrectLineup && !board.running && (match.status === 'LIVE' || match.status === 'PENDING_CONFIRMATION')}}" class="scorer-link-action" data-id="{{item.id}}" bindtap="correctLineup">更正阵容</button><button wx:if="{{held && item.canVoid && (match.status === 'LIVE' || match.status === 'PENDING_CONFIRMATION')}}" class="scorer-link-action is-danger" data-id="{{item.id}}" bindtap="askVoid">撤销</button><view wx:if="{{!item.canVoid || !held}}" class="figma-status {{item.voided ? '' : 'figma-status--orange'}}">{{item.voided ? '已撤销' : '已记录'}}</view></view></block>
      </view>
    </block>
    </block>
  </view>

  <view wx:if="{{figmaState==='scorer-readonly'}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost">查看只读赛况</button><button class="figma-action figma-action--orange">核对结果</button></view>
  <view wx:elif="{{match}}" class="figma-fixed-actions">
    <button wx:if="{{pending}}" class="figma-action figma-action--ghost" data-section="score" bindtap="openConsoleSection">查看只读赛况</button>
    <button wx:elif="{{held && (match.status === 'LIVE' || match.status === 'PENDING_CONFIRMATION')}}" class="figma-action figma-action--ghost" bindtap="toggleFix" disabled="{{busy || !!pending}}">补录更正</button>
    <button wx:else class="figma-action figma-action--ghost" data-section="score" bindtap="openConsoleSection">查看只读赛况</button>

    <button wx:if="{{pending}}" class="figma-action figma-action--orange" bindtap="checkPending" disabled="{{busy}}">核对结果</button>
    <button wx:elif="{{held && match.status === 'LIVE' && !offlineDraft}}" class="figma-action figma-action--orange" bindtap="clock" disabled="{{busy}}">{{board.running ? '暂停时钟' : '启动时钟'}}</button>
    <button wx:elif="{{held && match.status === 'READY'}}" class="figma-action figma-action--orange" bindtap="start" disabled="{{busy}}">开始比赛</button>
    <button wx:elif="{{canControl && board && !match.closed && !match.adjudication && !reportOnly}}" class="figma-action figma-action--orange" bindtap="acquire" disabled="{{busy}}">取得记分控制</button>
    <button wx:else class="figma-action figma-action--orange" bindtap="load" disabled="{{loading || busy}}">重新读取比分</button>
  </view>
</view>
