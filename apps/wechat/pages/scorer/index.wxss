@import "../../styles/figma-pages.wxss";

.scorer-tabs {
  display: flex;
  width: 100%;
  gap: 1px;
  padding: 2px 3px;
  border-radius: 12px;
  background: #fff;
}

.scorer-tab {
  width: 0;
  min-width: 0;
  flex: 1 1 0;
  height: 44px;
  margin: 0;
  padding: 0 6px;
  border-radius: 10px;
  background: transparent;
  color: #51657d;
  font-size: 13px;
  line-height: 19px;
}

.scorer-tab.is-active {
  background: #123c73;
  color: #fff;
  font-weight: 700;
}

.scorer-section-head,
.scorer-score-grid,
.scorer-pending-actions,
.scorer-inline-grid,
.scorer-choice-grid {
  display: flex;
  width: 100%;
  min-width: 0;
  gap: 8px;
}

.scorer-section-head {
  align-items: center;
  justify-content: space-between;
}

.scorer-score-card {
  min-width: 0;
  flex: 1;
  padding: 12px;
  border-radius: 11px;
}

.scorer-score-card.is-home {
  background: #eaf2fc;
}

.scorer-score-card.is-away {
  background: #fff1e2;
}

.scorer-team {
  width: 100%;
  overflow: hidden;
  color: #18283f;
  font-size: 15px;
  font-weight: 700;
  line-height: 21px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scorer-score {
  color: #123c73;
  font-size: 36px;
  font-weight: 700;
  line-height: 51px;
}

.scorer-pending-actions .figma-action,
.scorer-choice-grid .figma-action,
.scorer-inline-grid .scorer-link-action,
.scorer-choice-grid .scorer-choice {
  min-width: 0;
  flex: 1;
}

.scorer-team-block,
.scorer-team-actions,
.scorer-clock-tools,
.scorer-form,
.scorer-substitution,
.scorer-player-assignment {
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: 8px;
}

.scorer-team-block + .scorer-team-block,
.scorer-team-actions + .scorer-team-actions {
  margin-top: 6px;
  padding-top: 12px;
  border-top: 1px solid #e6ebf2;
}

.scorer-player {
  width: 100%;
  padding: 10px;
  border-radius: 10px;
  background: #f4f6fa;
}

.scorer-picker {
  display: flex;
  align-items: center;
  line-height: 48px;
}

.scorer-recovery-row {
  display: flex;
  width: 100%;
  min-height: 55px;
  align-items: center;
  gap: 8px;
  padding: 0 10px;
  border-radius: 8px;
  background: #eaf2fc;
}

.scorer-dot {
  width: 7px;
  height: 7px;
  margin: 0 7px;
  flex: none;
  border-radius: 4px;
  background: #123c73;
}

.scorer-state-hero {
  display: flex;
  width: 100%;
  min-height: 112px;
  flex-direction: column;
  justify-content: center;
  gap: 8px;
  padding: 16px;
  border-radius: 16px;
  background: #fff1e2;
}

.scorer-state-hero__body {
  color: #18283f;
  font-size: 14px;
  line-height: 22px;
}

.scorer-action-title {
  color: #123c73;
  font-size: 13px;
  font-weight: 700;
  line-height: 19px;
}

.scorer-points-grid,
.scorer-three-grid,
.scorer-pro-grid,
.scorer-minor-grid {
  display: grid;
  width: 100%;
  gap: 8px;
}

.scorer-points-grid,
.scorer-three-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.scorer-minor-grid,
.scorer-pro-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.scorer-point,
.scorer-minor,
.scorer-choice {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 44px;
  margin: 0;
  align-items: center;
  justify-content: center;
  padding: 6px 8px;
  border-radius: 10px;
  background: #f4f6fa;
  color: #18283f;
  font-size: 14px;
  font-weight: 700;
  line-height: 20px;
  text-align: center;
}

.scorer-point {
  color: #123c73;
  font-size: 19px;
  line-height: 27px;
}

.scorer-point.is-home {
  background: #eaf2fc;
}

.scorer-point.is-away {
  background: #fff1e2;
}

.scorer-choice.is-active {
  background: #123c73;
  color: #fff;
}

.scorer-link-action {
  min-width: 56px;
  min-height: 44px;
  margin: 0;
  padding: 0 8px;
  background: transparent;
  color: #123c73;
  font-size: 13px;
  line-height: 20px;
}

.scorer-link-action.is-danger {
  color: #c83f42;
}

.scorer-more-toggle {
  display: flex;
  width: 100%;
  min-height: 44px;
  margin: 0;
  align-items: center;
  justify-content: center;
  border: 1px solid #e6ebf2;
  border-radius: 10px;
  background: #fff;
  color: #123c73;
  font-size: 13px;
  line-height: 20px;
}

.scorer-player-assignment {
  padding: 10px;
  border-radius: 10px;
  background: #f4f6fa;
}

.scorer-danger {
  background: #c83f42;
  color: #fff;
}

.scorer-history-row.is-voided .figma-row__title {
  color: #7c8ea5;
  text-decoration: line-through;
}

#scorer-board,
#scorer-lineup,
#scorer-offline,
#scorer-history {
  scroll-margin-top: 12px;
}

/* Keep the active scoring controls directly after the scoreboard. The extra
   lineup, correction and offline tools remain available lower in the same
   native page without displacing the Figma primary task. */
#scorer-lineup,
.scorer-lineup-note {
  order: 10;
}

.scorer-fix,
.scorer-lineup-correction {
  order: 20;
}

#scorer-history {
  order: 5;
}

#scorer-offline {
  order: 30;
}

@media (max-width: 360px) {
  .scorer-tab {
    padding: 0 2px;
    font-size: 12px;
  }

  .scorer-choice-grid {
    flex-direction: column;
  }

  .scorer-pro-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}
