.pad { display:flex; gap:10px; margin-bottom:12px; }
.pad-side { flex:1; min-width:0; background:#fff; border-radius:12px; padding:12px; }
.pad-team { color:#132c49; font-weight:600; font-size:14px; line-height:20px; margin-bottom:8px; text-align:center; overflow-wrap:anywhere; }
.pad-picker { margin:0 0 8px; font-size:12px; min-height:40px; }
.pad-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
.page.mgmt-page .pad-grid button { margin:0; min-height:52px; padding:8px 4px; }
.page.mgmt-page .pad-grid button.pad-score { color:#fff; background:#ff6b2d; font-size:20px; font-weight:700; }
.page.mgmt-page .pad-grid button.pad-score::after { border:none; }
.page.mgmt-page .pad-grid button.pad-minor { color:#132c49; background:#eaf0f7; }
.voided-text { color:#7c91a9; text-decoration:line-through; }
