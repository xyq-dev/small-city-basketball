.field { box-sizing: border-box; width: 100%; margin-bottom: 16rpx; } .card button { margin-top: 16rpx; } .small { margin-top: 14rpx; }

.ui002-workspace { padding:16px 16px calc(104px + env(safe-area-inset-bottom)); background:#f4f6fa; color:#18283f; }
.ui002-workspace .card { border-radius:16px; padding:16px; margin:0 0 16px; }
.ui002-workspace input,.ui002-workspace textarea,.ui002-workspace button { font-size:16px; line-height:24px; min-height:44px; }
.ui002-workspace .page-intro .title { color:#18283f; font-size:22px; line-height:32px; margin:0 0 8px; }
.ui002-workspace .page-intro { margin-bottom:16px; }
.ui002-workspace .tabs button { min-height:44px; }

.ui002-workspace .notice { font-size:14px; line-height:22px; border-radius:12px; padding:12px; }
.recovery-summary { color:#18283f; }
.recovery-summary-icon { display:flex; align-items:center; justify-content:center; flex:0 0 44px; width:44px; height:44px; border-radius:12px; background:#eaf2fc; }
.recovery-summary-icon image { width:25px; height:25px; }
.recovery-tabs { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1px; min-height:44px; margin-bottom:12px; padding:2px 3px; border-radius:12px; background:#fff; color:#63758b; font-size:14px; line-height:40px; text-align:center; }
.recovery-tabs > view { height:40px; border-radius:10px; }
.recovery-tabs .selected { color:#fff; background:#123c73; font-weight:700; }
.recovery-card { padding:14px !important; }
.recovery-card .field { min-height:44px; margin:4px 0 10px; padding:10px; border:0; border-radius:8px; background:#f4f6fa; }
.recovery-progress { padding:14px !important; }
.recovery-step { display:flex; align-items:flex-start; gap:10px; min-height:58px; padding:8px 0; }
.recovery-step > text { display:flex; align-items:center; justify-content:center; flex:0 0 20px; width:20px; height:20px; border-radius:50%; color:#123c73; background:#eaf2fc; font-size:11px; }
.recovery-step > view { flex:1; min-width:0; }
@media (max-width:360px) { .fig-actions button { padding-left:6px; padding-right:6px; font-size:13px; } }
