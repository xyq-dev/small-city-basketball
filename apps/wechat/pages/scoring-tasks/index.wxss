.scoring-tasks-page { padding:12px 16px calc(112px + env(safe-area-inset-bottom)); }
.tasks-summary { min-height:110px; padding:16px 14px; }
.fig-summary-icon { display:flex; flex:0 0 44px; width:44px; height:44px; align-items:center; justify-content:center; border-radius:12px; background:#eaf2fc; }
.fig-summary-icon image { width:24px; height:24px; }
.task-tabs { display:flex; gap:0; padding:3px; margin-bottom:12px; border-radius:12px; background:#fff; }
.task-tabs view { flex:1; min-width:0; padding:11px 4px; border-radius:10px; color:#63758b; font-size:14px; line-height:20px; text-align:center; }
.task-tabs .selected { color:#fff; background:#164b88; }
.task-section-title { margin-top:12px; }
.task-row { min-height:80px; padding:14px; border:1px solid transparent; border-radius:16px; }
.task-row .org-match-status { display:inline-block; margin-top:6px; padding:2px 8px; border-radius:7px; color:#895500; background:#fff3e6; }
.task-title { color:#18283f; font-size:14px; line-height:22px; font-weight:600; }
.task-score { color:#123c73; font-family:Inter,Arial,sans-serif; font-size:18px; line-height:28px; font-weight:700; }
.task-scope { padding:14px; border:0; border-radius:16px; }
.scope-row { display:flex; gap:10px; min-height:58px; padding:10px 12px; margin-top:8px; border-radius:10px; background:#eaf2fc; }
.scope-dot { color:#164b88; font-size:22px; }
.scope-title { color:#18283f; font-size:14px; line-height:22px; font-weight:600; }
@media (max-width:340px) { .scoring-tasks-page { padding-left:12px; padding-right:12px; } }
