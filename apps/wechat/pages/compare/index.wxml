<scb-header title="同价球员对比" disabled="{{loading}}"/>
<view class="page has-actions compare-page premium-page">
  <view wx:if="{{loading}}" class="card state-panel"><view class="state-label">状态反馈</view><view class="subtitle">正在核对球员资料与授权统计…</view><view class="muted">完成读取后再比较当前可见的报价和记录。</view><view class="loading-lines" aria-hidden="true"><view></view><view></view></view></view>
  <view wx:if="{{loginRequired}}" class="card empty"><view class="subtitle">登录后继续比较</view><button class="primary" bindtap="login">登录并返回对比</button></view>
  <view wx:if="{{error}}" class="card state-panel" role="alert"><view class="state-label">读取失败</view><view class="subtitle">暂时无法读取比较资料</view><view class="notice danger">{{error}}</view><button class="primary" bindtap="load" disabled="{{loading}}">重新读取比较资料</button><button class="quiet" bindtap="market">返回球员广场</button></view>
  <view wx:if="{{notice}}" class="notice warning">{{notice}}</view>
  <view wx:if="{{statisticsError}}" class="notice warning">统计读取失败：{{statisticsError}}。已停止展示旧统计，可刷新重试；不会用0或演示数据填补。</view>
  <block wx:if="{{columns.length &gt;= 2}}">
    <view class="comparison-intro"><block wx:if="{{sameServicePrice}}">同为 <text>{{comparisonPrice}} / 场</text>，看看差在哪里</block><block wx:else>看报价与记录，找到适合的人</block></view>
    <view class="comparison-grid">
      <view class="metric-labels"><view class="comparison-head label-head" aria-label="对比指标"></view><block wx:for="{{labels}}" wx:for-item="metric" wx:key="id"><view wx:if="{{metric.id !== 'status'}}" class="comparison-cell label-cell">{{metric.id === 'points' ? '场均记录得分' : metric.id === 'fouls' ? '场均记录犯规' : metric.id === 'services' ? '已完成服务' : metric.label}}</view></block></view>
      <scroll-view scroll-x="true" enable-flex="true" class="comparison-scroll">
        <view class="comparison-columns" style="width: {{selectedCount === 2 ? '100%' : columnsWidth}};">
          <view wx:for="{{columns}}" wx:for-item="column" wx:for-index="columnIndex" wx:key="id" class="compare-column" style="width: {{selectedCount === 2 ? '50%' : '125px'}};">
            <button class="comparison-head" data-id="{{column.id}}" bindtap="detail" aria-label="{{column.name}}，查看资料"><image class="compare-portrait" src="{{profiles[columnIndex].portrait || '/assets/approved-ui/player-placeholder.png'}}" mode="aspectFill" aria-label="{{profiles[columnIndex].portrait ? '示例球员形象' : '球员尚未提供公开头像'}}"/><view class="compare-name">{{column.name}}</view><view class="compare-position">{{profiles[columnIndex].position}} · {{profiles[columnIndex].height}}cm</view><view class="compare-city">{{profiles[columnIndex].city}}</view></button>
            <block wx:for="{{column.cells}}" wx:for-item="cell" wx:key="id"><view wx:if="{{cell.id !== 'status'}}" class="comparison-cell {{cell.id === 'price' || cell.id === 'total' ? 'price-cell' : ''}}">{{cell.displayValue || cell.value}}<text wx:if="{{cell.id === 'sample'}}">场</text><text wx:if="{{cell.id === 'services'}}">次</text></view></block>
          </view>
        </view>
      </scroll-view>
    </view>
    <view class="comparison-hint"><scb-icon name="info" tone="orange" size="18"/><view>{{selectedCount === 3 ? '左右滑动查看第3人；样本有限，含费报价仍需逐场核对' : '样本有限，含费报价仍需逐场核对'}}</view></view>
    <view class="card comparison-advice"><scb-icon name="chat" size="38"/><view><view class="advice-title">同价选择，看时间、报价与记录来源</view><view class="advice-copy">不同的比赛需求，可能适合不同的球员。</view></view></view>
    <button class="quiet comparison-more" bindtap="informationToggle">{{informationOpen ? '收起完整费用与来源' : '完整费用、来源与选择管理'}}</button>
    <block wx:if="{{informationOpen}}">
      <view class="notice"><view class="hint-title">{{selectedCount === 3 ? '左右滑动查看第3人' : '同价看记录，也看适配'}}</view><view class="small">指标名称保持可见；最多选择3人。无授权样本显示未统计，含费预计仍需逐场核对。</view></view>
      <button wx:if="{{selectedCount === 3}}" class="secondary" data-id="{{columns[2].id}}" bindtap="remove">移除{{columns[2].name}} · 返回2人对比</button>
      <view class="card comparison-notes"><view class="subtitle">有限记录与未统计项目</view><view class="muted">样本数、赛制和完整度不同，不直接作为实力排名。统计样本不代表实际出场，完成服务不代表付费成交。</view><view class="muted">只使用当前有效的本人授权与独立确认记录。篮板、助攻、时间、命中率未采集，不生成综合战力分、胜率或准时率。</view></view>
      <view wx:for="{{profiles}}" wx:for-item="profile" wx:key="id" class="card fee-breakdown"><view class="subtitle">{{profile.name}} · 费用与来源</view><view class="muted profile-position">{{profile.position}} · {{profile.city}}</view><view class="fee-row"><text>参赛服务费</text><text>{{profile.price}}</text></view><view class="fee-row"><text>平台服务费</text><text>{{profile.platformFee}}</text></view><view class="fee-row"><text>交通费</text><text>{{profile.travel}}</text></view><view class="fee-row"><text>食宿费</text><text>{{profile.accommodation}}</text></view><view class="fee-row fee-total"><text>含费预计</text><text>{{profile.total}}</text></view><view class="muted source-detail">授权来源 {{profile.performance.sourceCount}} · {{profile.performance.source}}</view><view class="muted">{{profile.performance.status}} · {{profile.performance.completeness}}</view><view class="profile-actions"><button class="secondary" data-id="{{profile.id}}" bindtap="book">预约这位</button><button class="quiet" data-id="{{profile.id}}" bindtap="remove">移出对比</button></view></view>
      <button class="secondary" bindtap="load" disabled="{{loading}}">刷新对比资料与统计</button>
    </block>
  </block>
  <view wx:if="{{!loading &amp;&amp; columns.length &lt; 2 &amp;&amp; !loginRequired &amp;&amp; !error}}" class="card empty"><view class="subtitle">继续选择合适的球员</view><view class="muted">停用或不可查看的档案不能继续比较。当前目录最多最新200位已审核球员。</view><button class="secondary" bindtap="market">返回球员广场</button></view>
  <view class="action-bar compare-action"><button class="primary" data-id="{{firstId}}" bindtap="book" disabled="{{loading || !firstId}}">{{firstId ? '选择' + firstName + '并预约' : '请选择至少2位球员'}}</button><button class="quiet" bindtap="market">继续找球员</button></view>
</view>
