<scb-header title="同价球员对比" disabled="{{loading}}"/>
<view class="scb-ui-page figma-page compare-rebuild">
  <view class="figma-page__content figma-page__content--actions">
    <figma-skeleton wx:if="{{loading}}" rows="4"/>
    <figma-feedback wx:if="{{loginRequired}}" type="permission" title="登录后继续比较" body="使用当前账号读取可见球员资料。" action-label="登录并返回" bind:action="login"/>
    <figma-feedback wx:if="{{error && !loginRequired}}" type="error" title="暂时无法读取比较资料" body="{{error}}" action-label="重新读取" bind:action="load"/>
    <figma-feedback wx:if="{{notice}}" type="info" title="对比名单已更新" body="{{notice}}"/>
    <figma-feedback wx:if="{{statisticsError}}" type="error" title="统计读取失败" body="{{statisticsError}}；旧统计已清除，不以 0 或演示数据填补。"/>

    <block wx:if="{{columns.length >= 2}}">
      <view class="figma-summary">
        <view class="figma-summary__icon"><figma-icon name="stats" size="28"/></view>
        <view class="figma-summary__copy"><view class="figma-eyebrow">选人参考</view><view class="figma-title">同价球员对比</view><view class="figma-subtitle">两名球员参赛服务费相同，交通、食宿和档期分别比较。</view></view>
      </view>

      <view class="compare-tabs" role="tablist"><button class="compare-tab is-active">费用</button><button class="compare-tab" bindtap="informationToggle">档期</button><button class="compare-tab" bindtap="informationToggle">样本</button></view>

      <view class="figma-section">
        <view class="figma-section__title">对比球员</view>
        <scroll-view scroll-x="true" enable-flex="true" class="compare-scroll">
          <view class="compare-grid">
            <view wx:for="{{profiles}}" wx:key="id" class="compare-person">
              <view class="figma-row__title">{{item.name}}</view><view class="figma-row__subtitle">{{item.position}} · {{item.city}}</view><view class="figma-status figma-status--orange">{{item.priceLabel || item.price}}/场</view>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="figma-section">
        <view class="figma-section__title">含费预计</view>
        <view wx:for="{{profiles}}" wx:key="id" class="compare-fee-row">
          <view class="figma-row__copy"><view class="figma-row__title">{{item.name}}</view><view class="figma-row__subtitle">参赛{{item.pricePlain || item.price}}＋平台{{item.platformFeePlain || item.platformFee}}＋交通{{item.travelPlain || item.travel}}＋食宿{{item.accommodationPlain || item.accommodation}}</view></view><view class="compare-total">{{item.total}}</view>
        </view>
      </view>

      <view class="figma-section">
        <view class="figma-section__title">样本与可约时间</view>
        <view wx:for="{{profiles}}" wx:key="id" class="figma-row"><figma-icon name="schedule" size="20"/><view class="figma-row__copy"><view class="figma-row__title">{{item.name}}</view><view class="figma-row__subtitle">{{item.availabilityText}}</view></view><view class="figma-status figma-status--orange">{{item.performance.sample}}场样本</view></view>
        <view class="figma-row"><figma-icon name="stats" size="20"/><view class="figma-row__copy"><view class="figma-row__title">专业统计</view><view class="figma-row__subtitle">未采集篮板、助攻和上场时间</view></view><view class="figma-status">未统计</view></view>
      </view>

      <view class="figma-section">
        <button class="figma-row" bindtap="informationToggle"><view class="figma-row__copy"><view class="figma-row__title">完整费用、来源与选择管理</view><view class="figma-row__subtitle">{{informationOpen ? '收起详情' : '展开逐人明细'}}</view></view><view class="figma-status">{{informationOpen ? '收起' : '展开'}}</view></button>
        <block wx:if="{{informationOpen}}">
          <view wx:for="{{profiles}}" wx:key="id" class="compare-detail">
            <view class="figma-row__title">{{item.name}} · {{item.position}}</view>
            <view class="figma-caption">参赛 {{item.price}} · 平台 {{item.platformFee}} · 交通 {{item.travel}} · 食宿 {{item.accommodation}} · 含费 {{item.total}}</view>
            <view class="figma-caption">每场记录 {{item.performance.points}} 分 / {{item.performance.fouls}} 犯规 · 完成服务 {{item.performance.services}} 次</view>
            <view class="figma-caption">来源 {{item.performance.source}} · {{item.performance.completeness}}</view>
            <view class="compare-detail__actions"><button data-id="{{item.id}}" bindtap="detail">查看详情</button><button data-id="{{item.id}}" bindtap="book">预约这位</button><button data-id="{{item.id}}" bindtap="remove">移出对比</button></view>
          </view>
          <view class="figma-caption">样本数、赛制和完整度不同，不直接作为实力排名；不会生成战力分或虚构命中率。</view>
        </block>
      </view>
    </block>

    <figma-feedback wx:if="{{!loading && columns.length < 2 && !loginRequired && !error}}" type="empty" title="继续选择合适的球员" body="至少选择 2 位、最多 3 位不同球员进行比较。" action-label="返回球员目录" bind:action="market"/>
  </view>

  <view class="figma-fixed-actions">
    <button class="figma-action figma-action--ghost" bindtap="market">继续选人</button>
    <button class="figma-action figma-action--orange" data-id="{{firstId}}" bindtap="book" disabled="{{loading || !firstId || columns.length < 2}}">{{firstId ? '预约这位球员' : '至少选择2位'}}</button>
  </view>
</view>
