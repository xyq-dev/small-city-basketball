page { background: #f4f6fa; color: #18283f; }
.compare-page { padding: 16px; padding-bottom: calc(124px + env(safe-area-inset-bottom)); max-width: 600px; margin: 0 auto; box-sizing: border-box; }
.comparison-card { padding: 16px; border-radius: 16px; margin-bottom: 12px; }
.comparison-intro { font-size: 18px; line-height: 28px; font-weight: 700; margin-bottom: 8px; overflow-wrap: anywhere; }
.comparison-scroll { width: 100%; }
.comparison-table { width: 100%; min-width: 326px; }
.comparison-table.three-columns { width: 475px; }
.comparison-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; min-height: 38px; margin-bottom: 8px; padding: 8px; box-sizing: border-box; font-size: 14px; line-height: 22px; }
.three-columns .comparison-row { grid-template-columns: 98px repeat(3, minmax(0, 1fr)); }
.comparison-header { min-height: 34px; background: #eaf0f8; color: #63758b; font-size: 12px; line-height: 18px; }
.label-cell { position: sticky; left: 8px; z-index: 2; min-width: 0; background: #fff; overflow-wrap: anywhere; }
.comparison-header .label-cell { background: #eaf0f8; }
.comparison-value { min-width: 0; overflow-wrap: anywhere; }
.compare-name { color: #63758b; }
.money { white-space: nowrap; font-family: Inter, -apple-system, sans-serif; font-variant-numeric: tabular-nums; font-weight: inherit; color: inherit; }
.comparison-footnote { margin-top: 0; color: #63758b; font-size: 12px; line-height: 18px; }
.comparison-hint { padding: 16px; border-radius: 12px; margin-bottom: 12px; color: #63758b; background: #eaf0f8; font-size: 12px; line-height: 18px; }
.comparison-more { margin: 0 0 12px; }
.comparison-notes, .fee-breakdown { padding: 16px; border-radius: 16px; margin-bottom: 12px; }
.fee-breakdown { overflow-wrap: anywhere; }
.profile-position { margin-bottom: 12px; }
.fee-row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 12px; padding: 8px 0; border-bottom: 1px solid #e1e7ef; font-size: 14px; line-height: 22px; }
.fee-total { font-weight: 600; color: #123c73; }
.source-detail { margin-top: 12px; }
.profile-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.profile-actions button { flex: 1; min-width: 80px; min-height: 44px; margin: 0; padding: 8px; font-size: 14px; line-height: 22px; }
.compare-action { padding: 12px 16px calc(28px + env(safe-area-inset-bottom)); background: #fff; }
.comparison-actions { display: flex; gap: 12px; max-width: 568px; margin: 0 auto; }
.comparison-actions button { flex: 1; width: 0; min-width: 0; min-height: 48px; margin: 0; padding: 12px; border-radius: 12px; font-size: 14px; line-height: 22px; font-weight: 600; }
.comparison-actions .primary { background: #123c73; color: #fff; }
.comparison-actions .secondary { background: #eaf0f8; color: #123c73; }
.comparison-actions button::after { border: none; }
.book-label { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
