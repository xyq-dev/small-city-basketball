@import "../../styles/figma-pages.wxss";

.compare-tabs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1px; width:100%; height:48px; padding:2px 3px; border-radius:12px; background:#fff; }
.compare-tab { display:flex; height:44px; align-items:center; justify-content:center; border-radius:10px; color:#51657d; font-size:13px; }
.compare-tab.is-active { background:#123c73; color:#fff; font-weight:700; }
.compare-rebuild .compare-tabs>button.compare-tab { width:100%; min-width:0; max-width:none; height:44px; min-height:44px; margin:0; padding:0 4px; border:0; justify-self:stretch; box-sizing:border-box; background:transparent; }
.compare-rebuild .compare-tabs>button.compare-tab.is-active { background:#123c73; color:#fff; }
.compare-scroll { width:100%; white-space:nowrap; }
.compare-grid { display:flex; min-width:100%; gap:8px; }
.compare-person { display:flex; width:161px; min-height:88px; flex:none; flex-direction:column; gap:4px; padding:10px; border-radius:10px; background:#eaf2fc; white-space:normal; }
.compare-fee-row { display:flex; min-height:72px; align-items:center; gap:12px; border-bottom:1px solid #e6ebf2; }
.compare-fee-row:last-child { border-bottom:0; }
.compare-total { flex:none; color:#123c73; font-size:16px; font-weight:700; line-height:24px; }
.compare-detail { display:flex; flex-direction:column; gap:6px; padding-top:10px; border-top:1px solid #e6ebf2; }
.compare-detail__actions { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:6px; }
.compare-detail__actions button { display:flex; min-height:44px; align-items:center; justify-content:center; border-radius:12px; background:#f4f6fa; color:#123c73; font-size:12px; text-align:center; }
@media (max-width:360px) { .compare-detail__actions { grid-template-columns:1fr; } }
