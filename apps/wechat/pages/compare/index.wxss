.comparison-grid { display:flex; width:100%; align-items:flex-start; margin-bottom:16rpx; }
.metric-labels { flex:0 0 180rpx; width:180rpx; }
.comparison-scroll { flex:1; width:0; min-width:0; }
.comparison-columns { display:flex; align-items:flex-start; }
.compare-column { flex:0 0 246rpx; width:246rpx; box-sizing:border-box; }
.comparison-head { height:64px; box-sizing:border-box; padding:16rpx 20rpx; border-radius:28rpx; background:#132c49; color:#fff; }
.label-head { display:flex; align-items:center; background:#eaf0f7; color:#132c49; font-weight:600; }
.compare-name { font-size:14px; font-weight:600; line-height:22px; height:22px; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.position { font-size:12px; line-height:18px; }
.comparison-cell { height:64px; box-sizing:border-box; padding:20rpx; background:#fff; border:1rpx solid #e8edf2; border-radius:28rpx; display:flex; align-items:center; justify-content:center; color:#152c43; font-size:12px; line-height:18px; white-space:normal; overflow-wrap:anywhere; }
.label-cell { justify-content:flex-start; color:#617286; }
.column-actions { height:128px; padding:12rpx 10rpx; box-sizing:border-box; background:#fff; }
.column-actions button { font-size:12px; padding-left:8rpx; padding-right:8rpx; }
.scroll-hint { margin-bottom:24rpx; }
