@import "../../styles/figma-pages.wxss";

.detail-tabs { display:grid; width:100%; height:48px; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1px; padding:2px 3px; border-radius:12px; background:#fff; }
.detail-tab { display:flex; min-width:0; height:44px; align-items:center; justify-content:center; border-radius:10px; background:transparent; color:#51657d; font-size:13px; }
.detail-tab.is-active { background:#123c73; color:#fff; font-weight:700; }
.booking-detail-rebuild .detail-tabs>button.detail-tab { width:100%; min-width:0; max-width:none; height:44px; min-height:44px; margin:0; padding:0 4px; border:0; justify-self:stretch; box-sizing:border-box; background:transparent; }
.booking-detail-rebuild .detail-tabs>button.detail-tab.is-active { background:#123c73; color:#fff; }
.detail-anchor { display:flex; flex-direction:column; gap:12px; }
.pending-panel { background:#fff1e2; }
.command-id { padding:10px; border-radius:10px; background:#fff; color:#123c73; font-family:monospace; font-size:12px; overflow-wrap:anywhere; }

.progress-row { display:flex; width:100%; min-height:55px; align-items:center; gap:8px; }
.step-index { display:flex; width:20px; height:20px; flex:none; align-items:center; justify-content:center; border-radius:10px; background:#eaf2fc; color:#123c73; font-size:11px; font-weight:700; }
.finance-row { display:flex; min-height:55px; align-items:center; justify-content:space-between; gap:12px; border-bottom:1px solid #e6ebf2; }
.finance-row:last-of-type { border-bottom:0; }
.fee-value { flex:none; color:#123c73; font-size:15px; font-weight:700; line-height:21px; }
.funds-state { flex:none; color:#123c73; font-size:14px; font-weight:700; line-height:20px; }
.finance-values { max-width:150px; color:#123c73; font-size:12px; font-weight:700; line-height:18px; text-align:right; overflow-wrap:anywhere; }

.detail-secondary { margin-top:4px; }
.secondary-heading { display:flex; min-height:44px; align-items:center; justify-content:space-between; gap:8px; }
.card-actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; padding-bottom:8px; border-bottom:1px solid #e6ebf2; }
.card-actions:last-child { padding-bottom:0; border-bottom:0; }
.card-actions button,.dynamic-actions button { display:flex; min-height:44px; align-items:center; justify-content:center; padding:0 10px; border-radius:12px; background:#f4f6fa; color:#123c73; font-size:12px; text-align:center; }
.dynamic-actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
.dynamic-actions button.is-danger { background:#fdecef; color:#c83f42; }
.change-card,.selected-card { display:flex; flex-direction:column; gap:6px; padding:10px; border-radius:10px; background:#eaf2fc; }
.schedule-form,.command-form { gap:12px; }
.date-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
.picker-control { display:flex; align-items:center; }
.form-error { color:#c83f42; font-size:12px; line-height:18px; }

@media (max-width:360px) {
  .card-actions,.dynamic-actions,.date-grid { grid-template-columns:1fr; }
  .finance-row { gap:8px; }
  .finance-values { max-width:118px; }
}
