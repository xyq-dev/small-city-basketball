<scb-header title="球员合作详情" disabled="{{busy || loading}}"/>
<view class="scb-ui-page figma-page booking-detail-rebuild">
  <view class="figma-page__content {{!form ? 'figma-page__content--actions' : ''}}">
    <figma-feedback wx:if="{{error}}" type="error" title="当前合作需要重新核对" body="{{error}}"/>
    <figma-feedback wx:if="{{message}}" type="info" title="处理结果" body="{{message}}"/>
    <figma-feedback wx:if="{{loginRequired}}" type="permission" title="登录后查看这份合作" body="仅当前有权身份可读取本单记录。" action-label="登录并返回" bind:action="login"/>
    <figma-skeleton wx:if="{{loading}}" rows="4"/>
    <figma-feedback wx:if="{{!order && !loading && !loginRequired && !error}}" type="empty" title="暂未读取到合作记录" body="请从本人预约选择当前有权查看的合作。" action-label="返回我的预约" bind:action="list"/>

    <block wx:if="{{order}}">
      <view class="figma-summary"><view class="figma-summary__icon"><figma-icon name="receipt" size="28"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">授权球队与本人</view><view class="figma-title">球员合作详情</view><view class="figma-subtitle">{{order.teamName}} × {{order.playerSummary}} · {{order.scopeText}}。</view></view></view>
      <view class="detail-tabs" role="tablist"><button class="detail-tab {{activeTab==='arrangement' ? 'is-active' : ''}}" data-tab="arrangement" bindtap="changeTab" disabled="{{busy || form}}">安排</button><button class="detail-tab {{activeTab==='fulfillment' ? 'is-active' : ''}}" data-tab="fulfillment" bindtap="changeTab" disabled="{{busy || form}}">履约</button><button class="detail-tab {{activeTab==='fees' ? 'is-active' : ''}}" data-tab="fees" bindtap="changeTab" disabled="{{busy || form}}">费用</button></view>

      <view wx:if="{{!form && order.appearances.length > 1}}" class="figma-section"><view class="figma-section__title">逐人逐场独立处理</view><view class="figma-caption">{{order.playerCount}} 位球员 · 已确定 {{order.confirmedCount}} 项 / 意向 {{order.conditionalCount}} 项</view></view>

      <view wx:if="{{pending}}" class="figma-section pending-panel">
        <view class="figma-section__title">{{pending.kind === 'INVALID' ? '恢复记录损坏，先核对本场' : '原操作结果待核对'}}</view>
        <view wx:if="{{pending.kind === 'PENDING'}}" class="command-id">原操作编号：{{pending.payload.commandId}}</view>
        <view class="figma-caption">网络异常不代表操作没有保存。核对期间不换新编号重复执行，也不自动后台重发。</view>
        <figma-feedback wx:if="{{pending.storageWarning}}" type="error" title="本机记录提示" body="{{pending.storageWarning}}"/>
        <button wx:if="{{pending.kind === 'PENDING'}}" class="figma-action figma-action--navy" disabled="{{busy}}" bindtap="recover">{{busy ? '正在核对…' : '用原编号核对结果'}}</button>
        <checkbox-group bindchange="pendingConsent"><label class="figma-check"><checkbox value="yes" checked="{{pendingAcknowledged}}" disabled="{{busy || pending.inFlight}}"/>我已核对当前本场记录，确认不再重试这条原操作</label></checkbox-group>
        <button class="figma-action figma-action--ghost" disabled="{{busy || !pendingAcknowledged || pending.inFlight}}" bindtap="clearPending">核对后移除本机标记</button>
      </view>

      <block wx:if="{{!form}}">
        <view id="detail-arrangement" class="detail-anchor">
          <view wx:for="{{order.appearances}}" wx:key="id" class="figma-section arrangement-card">
            <view class="figma-section__title">{{order.appearances.length > 1 ? '本场安排 · ' + item.playerName : '本场安排'}}</view>
            <view wx:if="{{order.appearances.length > 1}}" class="figma-section__hint">{{item.label}} · {{item.positionText}}</view>
            <view class="figma-row"><figma-icon name="schedule" size="{{18}}"/><view class="figma-row__copy"><view class="figma-row__title">报到</view><view class="figma-row__subtitle">{{item.reportDisplay}}</view></view><view class="figma-status figma-status--orange">北京时间</view></view>
            <view class="figma-row"><figma-icon name="schedule" size="{{18}}"/><view class="figma-row__copy"><view class="figma-row__title">服务时段</view><view class="figma-row__subtitle">{{item.serviceDisplay}}</view></view><view class="figma-status figma-status--orange">{{item.status === 'CONDITIONAL' ? '待补齐' : '已约定'}}</view></view>
            <view class="figma-row"><figma-icon name="schedule" size="{{18}}"/><view class="figma-row__copy"><view class="figma-row__title">实际地点</view><view class="figma-row__subtitle">{{item.venue || '地点待补齐'}}</view></view><view class="figma-status figma-status--orange">查看</view></view>
          </view>
        </view>

        <view id="detail-fulfillment" class="detail-anchor">
          <view wx:for="{{order.appearances}}" wx:key="id" class="figma-section progress-card">
            <view class="figma-section__title">{{order.appearances.length > 1 ? '逐场合作进度 · ' + item.playerName : '逐场合作进度'}}</view>
            <view wx:if="{{order.appearances.length > 1}}" class="figma-section__hint">{{item.label}}</view>
            <view class="progress-row"><view class="step-index">1</view><view class="figma-row__copy"><view class="figma-row__title">接受本场安排</view><view class="figma-row__subtitle">{{item.playerName}}本人确认</view></view><view class="figma-status {{item.progress.acceptDone ? 'figma-status--green' : 'figma-status--orange'}}">{{item.progress.acceptLabel}}</view></view>
            <view class="progress-row"><view class="step-index">2</view><view class="figma-row__copy"><view class="figma-row__title">本人声明到场</view><view class="figma-row__subtitle">按实际报到记录</view></view><view class="figma-status {{item.progress.arriveDone ? 'figma-status--green' : 'figma-status--orange'}}">{{item.progress.arriveLabel}}</view></view>
            <view class="progress-row"><view class="step-index">3</view><view class="figma-row__copy"><view class="figma-row__title">确认完成</view><view class="figma-row__subtitle">时段结束并有本人到场记录</view></view><view class="figma-status {{item.progress.completeDone ? 'figma-status--green' : 'figma-status--orange'}}">{{item.progress.completeLabel}}</view></view>
          </view>
        </view>

        <view id="detail-fees" class="detail-anchor">
          <view class="figma-section">
            <view class="figma-section__title">本场费用</view>
            <view wx:for="{{order.appearances}}" wx:key="id" class="finance-row"><view class="figma-row__copy"><view class="figma-row__title">{{item.status === 'CONDITIONAL' ? '条件预计' : '确定报价'}} · {{item.playerName}}</view><view class="figma-row__subtitle">参赛{{item.serviceText}}＋平台{{item.platformFeeText}}＋交通{{item.travelText}}＋食宿{{item.accommodationText}}</view></view><view class="fee-value">{{item.totalText}}</view></view>
            <view class="finance-row"><view class="figma-row__copy"><view class="figma-row__title">实际资金</view><view class="figma-row__subtitle">查询原资金订单</view></view><view class="funds-state">逐场查看</view></view>
          </view>
        </view>

        <view class="figma-section detail-secondary">
          <view class="figma-section__title">更多本场操作</view>
          <figma-feedback wx:if="{{order.stateTitle}}" type="info" title="{{order.stateTitle}}" body="{{order.stateHint}}"/>
          <block wx:for="{{order.appearances}}" wx:key="id">
            <view class="secondary-heading"><view><view class="figma-row__title">{{item.playerName}} · {{item.label}}</view><view class="figma-row__subtitle">{{item.statusText}}</view></view></view>
            <view class="card-actions"><button data-id="{{item.id}}" bindtap="trade" disabled="{{busy}}">查看资金订单</button><button data-id="{{item.id}}" data-kind="report" bindtap="governance" disabled="{{busy}}">举报或工单</button><button wx:if="{{item.status === 'COMPLETED'}}" data-id="{{item.id}}" data-kind="review" bindtap="governance" disabled="{{busy}}">评价服务</button><button data-id="{{item.id}}" bindtap="toggleAppearance" disabled="{{busy || pending || form}}">{{expandedId === item.id ? '收起核对' : '核对与操作'}}</button></view>
          </block>
        </view>

        <block wx:for="{{order.appearances}}" wx:key="id">
          <view wx:if="{{expandedId === item.id || pending}}" class="figma-section appearance-detail">
            <view class="figma-section__title">本场约定与操作</view>
            <figma-feedback wx:if="{{item.status === 'CONDITIONAL'}}" type="info" title="意向不占具体档期" body="{{item.conditionText}}；条件满足后补齐实际时间地点，再由本人接单。"/>
            <view class="figma-caption">{{order.eligibilityNotice}} · 入驻审核不等于本场资格或保险已经核验。</view>
            <figma-feedback wx:if="{{item.scheduleChanged}}" type="error" title="正式比赛安排已变化" body="不能按过期约定继续处理，请核对当前赛事安排。"/>
            <view class="figma-caption">服务费 {{item.serviceText}} · 平台费 {{item.platformFeeText}} · 交通 {{item.travelText}} · 食宿 {{item.accommodationText}}</view>
            <view wx:if="{{item.change}}" class="change-card"><view class="figma-row__title">待另一方确认的变更 · {{item.change.role}}</view><view class="figma-caption">新报到 {{item.change.reportText}} · 新开始 {{item.change.startText}} · 新结束 {{item.change.endText}}</view><view class="figma-caption">{{item.change.venue}} · 原因：{{item.change.reason}}</view></view>
            <view wx:if="{{item.arrivedText}}" class="figma-caption">本人声明到场 {{item.arrivedText}}（非 GPS 核验）</view><view wx:if="{{item.completedText}}" class="figma-caption">完成记录 {{item.completedText}}（不等于付款）</view><view wx:if="{{item.cancellationReason}}" class="figma-caption">处理原因：{{item.cancellationReason}}</view>
            <figma-feedback wx:if="{{item.status === 'DISPUTED'}}" type="info" title="争议处理中" body="争议保留相关档期与记录并阻断结算，仅满足独立条件的平台人员可裁定。"/>
            <view wx:if="{{!item.actions.length}}" class="figma-caption">当前身份或本场状态没有可执行操作，请以刷新后的权限为准。</view>
            <view class="dynamic-actions"><button wx:for="{{item.actions}}" wx:for-item="action" wx:key="type" class="{{action.danger ? 'is-danger' : ''}}" disabled="{{busy || pending}}" data-id="{{item.id}}" data-type="{{action.type}}" bindtap="chooseAction">{{action.label}}</button></view>
          </view>
        </block>
      </block>

      <view wx:if="{{form}}" id="command-form" class="figma-section command-form">
        <view class="figma-section__title">{{form.title}}</view>
        <view class="selected-card"><view class="secondary-heading"><view><view class="figma-row__title">{{selected.playerName}} · {{selected.label}}</view><view class="figma-row__subtitle">{{selected.status === 'CONDITIONAL' ? '条件满足后补齐具体时间' : selected.startText + ' — ' + selected.endText}}</view></view><view class="figma-status figma-status--orange">{{selected.statusText}}</view></view><view class="figma-caption">{{selected.venue}} · 本场报价 {{selected.totalText}}</view></view>
        <view wx:if="{{order.eventName}}" class="figma-caption">关联赛事：{{order.eventName}}</view>
        <view wx:if="{{selected.change}}" class="change-card"><view class="figma-row__title">待确认的新安排 · {{selected.change.role}}</view><view class="figma-caption">新报到 {{selected.change.reportText}} · 新开始 {{selected.change.startText}} · 新结束 {{selected.change.endText}}</view><view class="figma-caption">{{selected.change.venue}} · 原因：{{selected.change.reason}}</view><view class="figma-caption">确认前仍以本页上方原安排为当前约定。</view></view>
        <figma-feedback wx:if="{{selected.conditionText}}" type="info" title="条件意向说明" body="{{selected.conditionText}}"/>
        <view wx:if="{{selected.arrivedText}}" class="figma-caption">本人声明到场 {{selected.arrivedText}}（非 GPS 核验）</view>
        <view wx:if="{{selected.completedText}}" class="figma-caption">完成记录 {{selected.completedText}}（不等于付款）</view>
        <figma-feedback wx:if="{{selected.scheduleChanged}}" type="error" title="正式比赛安排已变化" body="不能按过期约定继续处理。"/>
        <view class="figma-caption">{{order.eligibilityNotice}} · 资金以独立交易记录及渠道核验为准。</view>
        <view wx:if="{{form.needsSchedule}}" class="schedule-form">
          <view class="figma-field-label">报到日期与时间 · 北京时间</view><view class="date-grid"><picker mode="date" value="{{formFields.reportDate}}" data-field="reportDate" bindchange="input"><view class="figma-field-control picker-control">{{formFields.reportDate}}</view></picker><picker mode="time" value="{{formFields.reportTime}}" data-field="reportTime" bindchange="input"><view class="figma-field-control picker-control">{{formFields.reportTime}}</view></picker></view>
          <view class="figma-field-label">比赛开始日期与时间</view><view class="date-grid"><picker mode="date" value="{{formFields.startDate}}" data-field="startDate" bindchange="input"><view class="figma-field-control picker-control">{{formFields.startDate}}</view></picker><picker mode="time" value="{{formFields.startTime}}" data-field="startTime" bindchange="input"><view class="figma-field-control picker-control">{{formFields.startTime}}</view></picker></view>
          <view class="figma-field-label">服务结束日期与时间</view><view class="date-grid"><picker mode="date" value="{{formFields.endDate}}" data-field="endDate" bindchange="input"><view class="figma-field-control picker-control">{{formFields.endDate}}</view></picker><picker mode="time" value="{{formFields.endTime}}" data-field="endTime" bindchange="input"><view class="figma-field-control picker-control">{{formFields.endTime}}</view></picker></view>
          <view class="figma-field-group"><view class="figma-field-label">实际地点</view><input class="figma-field-control" value="{{formFields.venue}}" maxlength="120" data-field="venue" bindinput="input" placeholder="请填写具体场地" disabled="{{busy}}"/></view>
        </view>
        <view wx:if="{{form.needsResolution}}" class="figma-field-group"><view class="figma-field-label">独立处理结果</view><picker mode="selector" range="{{resolutionLabels}}" bindchange="resolution"><view class="figma-field-control picker-control">{{form.resolutionLabel}}</view></picker><view class="figma-caption">平台身份不覆盖利益冲突限制，最终仍由服务端核验。</view></view>
        <view wx:if="{{form.needsReason}}" class="figma-field-group"><view class="figma-field-label">实际原因</view><textarea class="figma-field-control" value="{{formFields.reason}}" maxlength="500" data-field="reason" bindinput="input" placeholder="填写 2 至 500 字原因" disabled="{{busy}}"/></view>
        <checkbox-group bindchange="confirm"><label class="figma-check"><checkbox value="yes" checked="{{formConfirmed}}" disabled="{{busy}}"/>{{form.consentLabel}}</label></checkbox-group>
        <view wx:if="{{validation}}" class="form-error">{{validation}}</view>
        <button class="figma-action figma-action--orange" disabled="{{busy || !canSubmit}}" bindtap="submit">{{busy ? '正在处理…' : form.title}}</button><button class="figma-action figma-action--ghost" disabled="{{busy}}" bindtap="closeForm">暂不执行，保留原记录</button>
      </view>

      <view wx:if="{{!form}}" class="figma-section detail-secondary"><view class="figma-section__title">更多合作操作</view><view wx:if="{{order.eventName}}" class="figma-caption">关联赛事：{{order.eventName}}</view><button class="figma-row" bindtap="list" disabled="{{busy}}"><view class="figma-row__copy"><view class="figma-row__title">返回我的预约</view><view class="figma-row__subtitle">查看其他已发出或收到的合作</view></view></button><button class="figma-row" bindtap="load" disabled="{{loading || busy}}"><view class="figma-row__copy"><view class="figma-row__title">刷新本场合作</view><view class="figma-row__subtitle">重新读取当前权限、安排和资金状态</view></view></button></view>
    </block>
  </view>

  <view wx:if="{{order && !form}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost" disabled="{{busy || pending || !order.changeAppearanceId}}" bindtap="requestChange">提出改期</button><button class="figma-action figma-action--orange" disabled="{{busy || !order.primaryAppearanceId}}" bindtap="primaryTrade">查看本场资金订单</button></view>
  <view wx:elif="{{!order}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost" disabled="{{busy}}" bindtap="list">返回我的预约</button><button class="figma-action figma-action--orange" disabled="{{loading || busy || !orderId}}" bindtap="load">{{loading ? '正在读取…' : '重新读取'}}</button></view>
</view>
