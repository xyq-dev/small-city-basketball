<view class="page"><scb-header title="独立资格预审"/><view wx:if="{{error}}" class="notice warning">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view><view class="notice">先保存本人身份、照片与签署，再明确申请本届资格预审。无需先买保险；预审通过不等于最终报名或投保成功。</view><button class="secondary" bindtap="materials" disabled="{{busy}}">打开受控本人资料与照片</button><view wx:if="{{pending}}" class="card"><view class="subtitle">原请求结果待核对</view><button class="primary" bindtap="recover" disabled="{{busy}}">核对并恢复原请求</button></view><button wx:if="{{workspace && !workspace.canReview}}" class="secondary" bindtap="consent" disabled="{{busy || pending}}">{{consent ? '已同意提交当前版本资料用于本届资格预审' : '明确同意提交当前身份、照片及签署资料预审'}}</button><view wx:for="{{workspace.participants}}" wx:key="memberId" class="card"><view class="subtitle">本届成员资格资料</view><view>姓名资料：{{item.hasRealName ? '已保存' : '待补'}}</view><view>身份：{{item.hasIdentity ? '已保存' : '待补'}} · 照片：{{item.hasPortrait ? '已保存' : '待补'}} · 签署：{{item.hasSignature ? '已保存' : '待补'}}</view><view>本人预审申请：{{item.requestCurrent ? '当前版本已明确申请' : '待本人提交当前版本'}}</view><view wx:if="{{item.qualification}}">独立预审：{{item.qualification.status}} · {{item.qualification.current ? '材料版本匹配' : '来源已改变须重新申请'}}</view><view wx:if="{{item.qualification.reason}}" class="small">{{item.qualification.reason}}</view><button wx:if="{{item.canRequest}}" class="primary" data-id="{{item.memberId}}" bindtap="request" disabled="{{busy || pending || !consent || !item.hasIdentity || !item.hasPortrait || !item.hasSignature}}">本人明确申请独立资格预审</button><block wx:if="{{workspace.canReview}}"><view class="notice small">请在受控本人资料页逐项核对，不以“已保存”代替核验；不能审核自己或关联球队。</view><button class="primary" data-id="{{item.memberId}}" data-decision="APPROVED" bindtap="review" disabled="{{busy || pending || !item.requestCurrent}}">已逐项人工核对，通过预审</button><button class="secondary" data-id="{{item.memberId}}" data-decision="REJECTED" bindtap="review" disabled="{{busy || pending || !item.requestCurrent}}">退回补充</button></block></view><button class="secondary" bindtap="load" disabled="{{busy || loading}}">重新读取</button></view>
