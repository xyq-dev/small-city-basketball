<scb-header title="独立资格预审" disabled="{{busy || pending || uncertain || dirty}}"/>
<view class="page fig-page precheck-page">
  <view class="fig-summary light precheck-fig-summary"><view class="precheck-summary-icon"><image src="/assets/figma/shield.svg" mode="aspectFit" aria-hidden="true"/></view><view class="fig-summary-copy"><view class="fig-kicker">本人及独立审核人</view><view class="fig-summary-title">{{workspace && workspace.eventName ? workspace.eventName + ' · 本人资格' : '独立资格预审'}}</view><view class="fig-summary-sub">核对当前版资料、本人照片与规程签署。</view></view></view>
  <view class="precheck-tabs"><view class="selected">当前资料</view><view>预审记录</view></view>
  <scb-steps items="{{registrationSteps}}" current="qualification" busy="{{busy || loading || pending}}" bind:change="registrationStepChange"/>
  <scb-state wx:if="{{loading && !workspace}}" kind="loading" title="正在读取资格资料" description="仅核对当前登录账号可查看的参赛材料。"/>
  <scb-state wx:if="{{!loading && workspace && !workspace.participants.length}}" kind="empty" title="暂无可核对的本届成员" description="请先保存本人资料并由领队确认本届名单。" action-text="打开本人资料" bind:action="materials"/>
  <view wx:if="{{error}}" class="notice warning" role="alert">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view>
  <view wx:if="{{pending}}" class="card pending-card"><view class="subtitle">原请求结果待核对</view><view class="muted">暂停新的申请和审核，核对当前账号保留的原请求。</view><button class="primary" bindtap="recover" disabled="{{busy || loading}}">核对并恢复原请求</button></view>
  <view wx:if="{{selectedParticipant && selectedParticipant.qualification}}" class="card qualification-progress-card">
    <view class="fig-card-title">本人材料</view>
    <view class="precheck-progress-row"><view class="precheck-progress-index">1</view><view class="precheck-progress-copy"><view class="fig-row-title">身份、照片与签署</view><view class="small muted">{{selectedParticipant.hasIdentity && selectedParticipant.hasPortrait && selectedParticipant.hasSignature ? '本人已提交当前版本。' : '当前版本仍有资料待补充。'}}</view></view><view class="fig-pill">{{selectedParticipant.hasIdentity && selectedParticipant.hasPortrait && selectedParticipant.hasSignature ? '已提交' : '待补充'}}</view></view>
    <view class="precheck-progress-row"><view class="precheck-progress-index">2</view><view class="precheck-progress-copy"><view class="fig-row-title">资格预审</view><view class="small muted">已受理当前版本申请。</view></view><view class="fig-pill">{{selectedParticipant.qualification.status}}</view></view>
    <view class="fig-card-title precheck-condition-title">参赛条件</view>
    <view class="precheck-progress-row"><view class="precheck-progress-copy"><view class="fig-row-title">外部保障凭证</view><view class="small muted">保障范围与最终参赛资格分别核对。</view></view><button class="precheck-row-action" bindtap="externalPolicy" disabled="{{busy || loading || pending}}">查看</button></view>
    <button class="primary precheck-material-action" bindtap="materials" disabled="{{busy || loading || pending}}">查看本人资料</button>
  </view>
  <view wx:if="{{selectedParticipant}}" class="card precheck-summary"><view class="subtitle">当前资料版本 {{selectedParticipant.materialVersion ? 'V' + selectedParticipant.materialVersion : ''}}</view><view>姓名资料：{{selectedParticipant.hasRealName ? '已保存' : '待补'}} · 身份：{{selectedParticipant.hasIdentity ? '已保存' : '待补'}}</view><view>本人照片：{{selectedParticipant.hasPortrait ? '已保存' : '待补'}} · 规程签署：{{selectedParticipant.hasSignature ? '已保存' : '待补'}}</view><view class="muted">姓名、身份、本人照片和规程签署待独立核验。</view><view>本人预审申请：{{selectedParticipant.requestCurrent ? '当前版本已明确申请' : '待本人提交当前版本'}}</view><view wx:if="{{selectedParticipant.qualification}}">独立预审：{{selectedParticipant.qualification.status}} · {{selectedParticipant.qualification.current ? '材料版本匹配' : '来源已改变须重新申请'}}</view><view wx:if="{{selectedParticipant.qualification.reason}}" class="muted">{{selectedParticipant.qualification.reason}}</view></view>
  <view wx:if="{{workspace && !workspace.canReview && selectedParticipant}}" class="card precheck-confirm"><checkbox-group bindchange="consent"><label class="consent"><checkbox value="yes" checked="{{consent}}" disabled="{{busy || loading || pending}}"/><text>本人同意提交当前版本资料用于本届预审</text></label></checkbox-group></view>
  <view class="notice precheck-notice">先核身份，再核保障。先保存本人身份、照片与签署，再明确申请本届资格预审。无需先买保险；预审通过不等于最终报名或投保成功。</view>
  <view wx:if="{{workspace.canReview || workspace.participants.length > 1 || (workspace && !selectedParticipant && workspace.participants.length)}}" class="card precheck-members"><view class="subtitle">选择本次核对的成员</view><view wx:for="{{workspace.participants}}" wx:key="memberId" class="precheck-member"><button class="secondary" data-id="{{item.memberId}}" bindtap="selectParticipant" disabled="{{busy || loading || pending}}">{{selectedMemberId === item.memberId ? '当前已选' : '查看当前资料'}} · V{{item.materialVersion}}</button><view class="muted">身份 {{item.hasIdentity ? '已保存' : '待补'}} · 照片 {{item.hasPortrait ? '已保存' : '待补'}} · 签署 {{item.hasSignature ? '已保存' : '待补'}}</view><view>本人预审申请：{{item.requestCurrent ? '当前版本已明确申请' : '待本人提交当前版本'}}</view><view wx:if="{{item.qualification}}">独立预审：{{item.qualification.status}} · {{item.qualification.current ? '材料版本匹配' : '来源已改变须重新申请'}}</view><view wx:if="{{item.qualification.reason}}" class="small">{{item.qualification.reason}}</view><block wx:if="{{workspace.canReview}}"><view class="notice small">请在受控本人资料页逐项核对，不以“已保存”代替核验；不能审核自己或关联球队。</view><button class="primary" data-id="{{item.memberId}}" data-decision="APPROVED" bindtap="review" disabled="{{busy || loading || pending || !item.requestCurrent}}">已逐项人工核对，通过预审</button><button class="secondary" data-id="{{item.memberId}}" data-decision="REJECTED" bindtap="review" disabled="{{busy || loading || pending || !item.requestCurrent}}">退回补充</button></block></view></view>
  <view class="card precheck-followup"><view class="subtitle">后续办理</view>
    <button class="precheck-cell" bindtap="externalPolicy" disabled="{{busy || loading || pending}}"><image class="precheck-icon" src="/assets/ui002/account-shield.svg" mode="aspectFit" aria-hidden="true"/><view class="precheck-copy"><view class="precheck-cell-title">已有外部保单</view><view class="precheck-cell-note">上传本届有效凭证，按实际保障人工核对</view></view><image class="precheck-chevron" src="/assets/ui002/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></button>
    <view class="precheck-cell closed" aria-disabled="true"><image class="precheck-icon" src="/assets/ui002/account-shield.svg" mode="aspectFit" aria-hidden="true"/><view class="precheck-copy"><view class="precheck-cell-title">在线保险</view><view class="precheck-cell-note">服务尚未正式开放，真实供应商未接入</view></view><image class="precheck-chevron" src="/assets/ui002/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></view>
  </view>
  <view wx:if="{{workspace && !workspace.canReview}}" class="card precheck-submit-card"><view class="fig-card-title">提交本人预审</view><view class="small muted">确认资料、本人照片与规程签署均为当前版本后提交；重复点击不会创建第二份申请。</view><button class="primary" data-id="{{selectedMemberId}}" bindtap="request" disabled="{{busy || loading || pending || !consent || !selectedParticipant || !selectedParticipant.canRequest || !selectedParticipant.hasIdentity || !selectedParticipant.hasPortrait || !selectedParticipant.hasSignature}}">{{selectedParticipant ? '提交预审并看进度' : '请选择本次申请的成员'}}</button></view>
  <button class="quiet" bindtap="materials" disabled="{{busy || loading || pending}}">打开受控本人资料与照片</button><button class="quiet" bindtap="load" disabled="{{busy || loading}}">重新读取</button>
</view>
<view class="fig-actions dock"><button class="fig-ghost" bindtap="load" disabled="{{busy || loading}}">重新读取预审</button><button class="fig-confirm" bindtap="materials" disabled="{{busy || loading || pending || !workspace}}">查看本人资料与照片</button></view>
