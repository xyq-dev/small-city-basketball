page { background:#f4f6fa; color:#18283f; }
.precheck-page { padding:16px; padding-bottom:calc(124px + env(safe-area-inset-bottom)); }
.precheck-page .card { padding:16px; border-radius:16px; margin-bottom:12px; }
.precheck-page .subtitle { color:#18283f; font-size:18px; line-height:28px; font-weight:700; }
.precheck-summary { font-size:14px; line-height:22px; }
.precheck-summary > view + view { margin-top:8px; }
.precheck-confirm .consent { padding:0; margin:0; color:#18283f; background:transparent; min-height:44px; font-size:14px; line-height:22px; }
.precheck-confirm checkbox { flex:0 0 44px; min-height:44px; transform:none; }
.precheck-notice { padding:16px; margin-bottom:12px; font-size:12px; line-height:18px; color:#63758b; background:#eaf0f8; }
.precheck-member + .precheck-member { margin-top:12px; padding-top:12px; border-top:1px solid #e1e7ef; }
.precheck-cell { display:flex; align-items:center; gap:12px; min-height:58px; margin:0; padding:8px 0; border-radius:0; background:transparent; text-align:left; font-weight:400; }
.precheck-cell + .precheck-cell { margin-top:8px; }
.precheck-cell::after { border:0; }
.precheck-icon { flex:0 0 22px; width:22px; height:22px; }
.precheck-chevron { flex:0 0 16px; width:16px; height:16px; }
.precheck-copy { flex:1; min-width:0; }
.precheck-cell-title { color:#18283f; font-size:14px; line-height:22px; font-weight:500; }
.precheck-cell-note { color:#63758b; font-size:12px; line-height:18px; margin-top:2px; overflow-wrap:anywhere; }
.precheck-submit-card .primary { min-height:48px; margin:12px 0 0; padding:12px; border-radius:12px; font-size:14px; line-height:22px; }
.small { overflow-wrap:anywhere; }
.precheck-fig-summary { color:#18283f; }
.precheck-summary-icon { display:flex; align-items:center; justify-content:center; flex:0 0 44px; width:44px; height:44px; border-radius:12px; background:#eaf2fc; }
.precheck-summary-icon image { width:25px; height:25px; }
.precheck-tabs { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1px; min-height:44px; margin-bottom:12px; padding:2px 3px; border-radius:12px; background:#fff; color:#63758b; font-size:14px; line-height:40px; text-align:center; }
.precheck-tabs > view { min-width:0; height:40px; border-radius:10px; }
.precheck-tabs .selected { color:#fff; background:#123c73; font-weight:700; }
.qualification-progress-card { padding:14px !important; }
.precheck-progress-row { display:flex; align-items:center; gap:10px; min-height:64px; padding:8px 0; border-bottom:1px solid #e6ebf2; }
.precheck-progress-index { display:flex; align-items:center; justify-content:center; flex:0 0 20px; width:20px; height:20px; border-radius:50%; background:#eaf2fc; color:#123c73; font-size:11px; line-height:20px; }
.precheck-progress-copy { flex:1; min-width:0; }
.precheck-condition-title { margin-top:14px; }
.precheck-row-action { flex:0 0 auto; width:auto; min-height:44px; height:44px; margin:0; padding:0 14px; border-radius:10px; color:#123c73; background:#eaf2fc; font-size:12px; line-height:44px; }
.precheck-row-action::after { border:0; }
.precheck-material-action { width:100%; margin:12px 0 0; }
@media (max-width:360px) { .fig-actions button { padding-left:6px; padding-right:6px; font-size:13px; } }
