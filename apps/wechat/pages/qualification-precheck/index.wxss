@import "../../styles/figma-pages.wxss";

.precheck-step {
  display: flex;
  width: 100%;
  min-height: 56px;
  align-items: center;
  gap: 10px;
}

.precheck-step__mark {
  display: flex;
  width: 22px;
  height: 22px;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eaf2fc;
  color: #123c73;
  font-size: 12px;
  font-weight: 700;
}

.precheck-step > view:nth-child(2) {
  min-width: 0;
  flex: 1;
}

.precheck-progress-row {
  display: flex;
  width: 100%;
  min-height: 68px;
  align-items: center;
  gap: 10px;
  border-bottom: 1px solid #e6ebf2;
}

.precheck-progress-row:last-child {
  border-bottom: 0;
}

.precheck-progress-mark {
  display: flex;
  width: 20px;
  height: 20px;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eaf2fc;
  color: #123c73;
  font-size: 11px;
  font-weight: 700;
}

.precheck-choice {
  display: flex;
  width: 100%;
  min-height: 55px;
  margin: 0;
  align-items: center;
  gap: 8px;
  padding: 0;
  background: transparent;
  color: #18283f;
  text-align: left;
}

.precheck-choice + .precheck-choice {
  border-top: 1px solid #e6ebf2;
}
