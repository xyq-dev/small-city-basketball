<scb-header title="{{enrollment ? '我的课程与课次' : detail ? (signupStep==='review' ? '学员与报名授权' : '课程与班次详情') : '同城篮球课程'}}" disabled="{{busy}}"/>
<view class="screen training-page {{detail && signupStep==='review'?'has-fixed-actions':''}}">
 <view wx:if="{{!detail && !enrollment}}" class="hero page-intro"><text class="eyebrow">篮球训练</text><text class="title">把每一节课练扎实</text><text>成人固定短班 · 明确课次、教练与退费规则</text></view>
 <view wx:if="{{!detail && !enrollment}}" class="workflow-tabs actions"><button class="{{viewTab==='catalog'?'active':''}}" bindtap="showCatalog" disabled="{{busy}}">发现课程</button><button class="{{viewTab==='mine'?'active':''}}" bindtap="loadMine" disabled="{{busy || mineLoading}}">我的报名</button><button bindtap="manage">教练 / 机构工作台</button><button wx:if="{{loginRequired}}" bindtap="login">登录</button></view>
 <button wx:if="{{detail || enrollment}}" class="back-link" bindtap="backToList" disabled="{{busy}}">‹ 返回{{viewTab==='mine'?'我的报名':'课程列表'}}</button>
 <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view>
 <view wx:if="{{pending}}" class="notice">上次操作尚待核对，不要重复报名。<button bindtap="recover" disabled="{{busy}}">核对回执</button><button bindtap="retry" disabled="{{busy}}">使用原编号重试</button></view>
 <scb-state wx:if="{{!enabled && !loading}}" kind="closed" title="培训招生尚未开放" description="已有报名与退款记录仍可查看。首期仅成人固定短课，青少年招生与课包暂未开放。"/>
 <scb-state wx:if="{{loading || mineLoading}}" kind="loading" title="{{mineLoading?'正在读取我的报名':'正在读取课程'}}"/>
 <block wx:if="{{viewTab==='catalog' && !detail && !enrollment}}"><view wx:for="{{items}}" wx:key="id" class="card"><view class="row"><text class="heading">{{item.title}}</text><text>{{item.amount}}</text></view><text>{{item.address}} · 剩余 {{item.available}} 位</text><button data-id="{{item.id}}" bindtap="select">查看课次与合同</button></view>
 <view wx:if="{{enabled && !loading && !items.length}}" class="card">暂无开放班期。可稍后刷新。</view>
</block>
 <view wx:if="{{detail}}" class="card"><scb-steps items="{{signupSteps}}" current="{{signupStep}}" busy="{{busy || pending}}" bindchange="signupStep"/><block wx:if="{{signupStep==='course'}}"><text class="heading">{{detail.title}}</text><text>{{detail.description}}</text><text>{{detail.address}} · {{detail.amount}} · {{detail.stateLabel}}</text><view wx:for="{{detail.sessions}}" wx:key="id" class="lesson"><text>{{item.time}}</text><text wx:for="{{item.coaches}}" wx:for-item="coach" wx:key="id">教练 {{coach.name}}</text></view><view class="terms">{{detail.termsText}}</view><text class="small">本人报名，首期不开放青少年。名额最多暂留10分钟；付款不等于已取得名额。</text><button class="primary" bindtap="reviewSignup" disabled="{{busy || pending || !enabled || !detail.capabilities.canEnroll}}">核对学员资料与合同</button></block><block wx:if="{{signupStep==='review'}}"><view class="status-banner"><view class="heading">首期仅支持成年学员本人报名</view><view>青少年招生与培训专用监护授权尚未开放，不能使用赛事监护确认替代。</view></view><view class="review-field"><text class="field-caption">本次学员</text><text>当前登录的成年学员本人</text></view><view class="review-field"><text class="field-caption">班次与合同金额</text><text>{{detail.title}} · {{detail.sessions.length}} 课次 · {{detail.amount}}</text></view><view class="review-field"><text class="field-caption">付款人（不填为本人）</text><input placeholder="另设付款人账户编号（选填）" data-field="payerUserId" bindinput="input" value="{{payerUserId}}"/><text class="small">付款人与学员资格分别核对，不因代付取得学员资料或接送权限。</text></view><view class="terms">{{detail.termsText}}</view><checkbox-group bindchange="consent"><label><checkbox value="adult" checked="{{adult}}"/>我是成年学员本人</label><label><checkbox value="terms" checked="{{accepted}}"/>已阅读并接受本次课程合同</label><label wx:if="{{detail.totalFen > 0}}"><checkbox value="payment" checked="{{chargeConsent}}"/>明确同意上述冻结金额及付款条款</label><label><checkbox value="waitlist" checked="{{waitlist}}"/>无位时加入候补，候补不收费</label></checkbox-group></block></view>
 <block wx:if="{{viewTab==='mine' && !detail && !enrollment}}"><scb-state wx:if="{{mineLoaded && !mineLoading && !mine.length}}" kind="empty" title="暂无报名与课次" description="选择真实开放的课程，核对合同后再报名。"/><view wx:for="{{mine}}" wx:key="id" class="card"><text class="heading">{{item.stateLabel}}</text><text>{{item.amount}} · 报名 {{item.id}}</text><button data-id="{{item.id}}" bindtap="selectEnrollment">课次、消费与退费</button></view>
</block>
 <view wx:if="{{enrollment}}" class="card"><view wx:if="{{enrollment.state==='WAITLISTED'}}" class="status-banner"><view class="heading">候补登记已受理</view><view>尚未报名成功、未锁位、未扣款；有名额后须按顺序重新领取。</view></view><view wx:if="{{enrollment.state==='PAID_UNALLOCATED'}}" class="status-banner warning"><view class="heading">付款已确认，名额待处理</view><view>当前未取得名额，不代表已入班；消费与原款退款分别核对。</view></view><view wx:if="{{enrollment.state==='HOLDING'}}" class="status-banner"><view class="heading">名额已暂时保留</view><view>锁位截止以服务器记录为准；付款后请核对名额与报名状态。</view></view><text class="heading">{{enrollment.stateLabel}}</text><text>{{enrollment.amount}} · 报名 {{enrollment.id}}</text><text wx:if="{{enrollment.deadline}}">锁位截止 {{enrollment.deadline}}</text><view class="terms">{{enrollment.termsSnapshot.termsText}}</view><view class="actions"><button wx:if="{{enrollment.state === 'WAITLISTED'}}" data-action="CLAIM" bindtap="enrollmentAction" disabled="{{busy || pending}}">按候补顺序领取名额</button><button wx:if="{{enrollment.capabilities.canConfirm}}" data-action="CONFIRM" bindtap="enrollmentAction" disabled="{{busy || pending}}">核对资格并确认入班</button><button wx:if="{{enrollment.totalFen > 0 && !enrollment.tradeOrderId && enrollment.state === 'HOLDING'}}" data-action="AUTHORIZE_PAYMENT" bindtap="enrollmentAction" disabled="{{busy || pending}}">付款人确认冻结合同</button><button wx:if="{{enrollment.tradeOrderId}}" bindtap="openTrade">支付 / 真实退款进度</button><button wx:if="{{enrollment.tradeOrderId}}" data-action="REFRESH" bindtap="enrollmentAction" disabled="{{busy || pending}}">核对支付与名额</button><button wx:if="{{enrollment.capabilities.canCancel}}" data-action="CANCEL" bindtap="enrollmentAction" disabled="{{busy || pending}}">取消未付款报名</button></view>
 <checkbox-group wx:if="{{enrollment.totalFen > 0 && !enrollment.tradeOrderId}}" bindchange="consent"><label><checkbox value="payment" checked="{{chargeConsent}}"/>付款人已阅读并明确接受本次冻结合同</label></checkbox-group>
 <textarea placeholder="请假、退费或消费异议的具体原因" data-field="reason" bindinput="input" value="{{reason}}"/>
 <view wx:for="{{enrollment.entitlements}}" wx:key="id" class="lesson"><text>{{item.stateLabel}} · {{item.amount}}</text><text class="small">课次 {{item.sessionId}}</text><view class="actions"><button wx:if="{{item.state === 'AVAILABLE'}}" data-id="{{item.id}}" data-action="LEAVE" bindtap="entitlementAction" disabled="{{busy || pending}}">请假保留补课权益</button><button wx:if="{{item.state === 'MAKEUP_DUE' && isLearner}}" data-id="{{item.id}}" bindtap="chooseMakeup" disabled="{{busy || pending || makeupLoading}}">选择补课课次</button><button wx:if="{{item.state === 'AVAILABLE' || item.state === 'MAKEUP_DUE'}}" data-id="{{item.id}}" bindtap="refund" disabled="{{busy || pending}}">申请本课退费</button></view></view>
 <view wx:if="{{makeupLoading}}" class="notice">正在核对可补课时间、教练与名额…</view>
 <view wx:if="{{makeup}}" class="makeup-picker"><text class="heading">选择补课安排</text><text class="small">沿用原有课次权益与退费金额；确认时再次核验名额和本人档期。</text>
 <block wx:if="{{makeup.items.length}}"><picker range="{{makeup.items}}" range-key="label" value="{{makeup.selectedIndex}}" bindchange="selectMakeup"><view class="makeup-choice">{{makeup.selected.cohortTitle}} · 更换课次 ›</view></picker><text>{{makeup.selected.time}}</text><text>教练：{{makeup.selected.coachNames}}</text><text>{{makeup.selected.address}} · 当前剩余 {{makeup.selected.availableSeats}} 位</text><button class="primary" bindtap="confirmMakeup" disabled="{{busy || pending}}">确认这节补课</button></block>
 <text wx:else>暂无符合当前资格、名额和本人档期的补课课次，可稍后刷新或申请原课退费。</text><text wx:if="{{makeup.truncated}}" class="small">优先展示最近50个可选课次。</text><button data-id="{{makeup.entitlementId}}" bindtap="chooseMakeup" disabled="{{busy || pending || makeupLoading}}">刷新可选课次</button></view>
 <view wx:for="{{enrollment.consumptions}}" wx:key="id" class="lesson"><text>{{item.stateLabel}} · {{item.reason}}</text><button wx:if="{{item.status === 'REVIEWED'}}" data-id="{{item.id}}" data-action="ACKNOWLEDGE" bindtap="consumptionAction" disabled="{{busy || pending}}">本人确认本次课已完成</button><button wx:if="{{item.status === 'PROPOSED' || item.status === 'REVIEWED' || item.status === 'FINALIZED'}}" data-id="{{item.id}}" data-action="DISPUTE" bindtap="consumptionAction" disabled="{{busy || pending}}">提交消费异议</button></view>
 <view wx:for="{{enrollment.refunds}}" wx:key="id" class="lesson"><text>{{item.amount}} · {{item.stateLabel}}</text><button wx:if="{{item.status === 'PENDING' || item.status === 'UNKNOWN'}}" data-id="{{item.id}}" bindtap="refreshRefund" disabled="{{busy || pending}}">核对真实退款回执</button></view></view>
</view>
<view wx:if="{{detail && signupStep==='review'}}" class="fixed-actions training-fixed"><button class="primary" bindtap="enroll" disabled="{{busy || pending || !enabled || !adult || !accepted || !detail.capabilities.canEnroll || (detail.totalFen > 0 && (!detail.capabilities.paidEnrollmentEnabled || !chargeConsent))}}">确认报名并暂留名额</button></view>
