<scb-header title="{{enrollment ? '我的课程与课次' : detail ? '成人篮球短课' : '同城篮球课程'}}" disabled="{{busy}}"/>
<view class="scb-ui-page figma-page training-page {{detail && signupStep==='review' ? 'has-enroll-bar' : ''}}">
  <view class="figma-page__content">
    <view wx:if="{{!detail && !enrollment}}" class="training-hero">
      <image class="training-hero__image" src="/assets/home/event-court.jpg" mode="aspectFill"/>
      <view class="training-hero__shade"></view>
      <view class="training-hero__copy"><view class="figma-eyebrow">篮球训练</view><view class="training-hero__title title">把每一节课练扎实</view><view class="training-hero__body">成人固定短班 · 明确课次、教练与退费规则</view></view>
    </view>
    <figma-feedback wx:if="{{loginRequired}}" type="locked" title="登录后查看我的报名" body="查看本人报名与课次需要登录；公开课程仍可浏览。" action-label="登录并继续" disabled="{{busy || loading || mineLoading || pending}}" bind:action="login"/>
    <figma-feedback wx:if="{{error}}" type="error" title="培训读取失败" body="{{error}}" action-label="重新读取" bind:action="load"/>
    <figma-feedback wx:if="{{message}}" type="success" title="最新结果" body="{{message}}"/>
    <figma-feedback wx:if="{{pending}}" type="warning" title="原操作结果待核对" body="上次操作尚待服务器确认，请勿重复报名。" action-label="核对回执" bind:action="recover"/>
    <button wx:if="{{pending}}" class="figma-action figma-action--ghost" bindtap="retry" disabled="{{busy}}">使用原请求编号重试</button>
    <figma-feedback wx:if="{{!enabled && !loading}}" type="closed" title="培训招生尚未开放" body="已有报名与退款记录仍可查看；首期仅成人固定短班。"/>
    <figma-skeleton wx:if="{{loading || mineLoading}}" rows="4"/>
    <button wx:if="{{enrollment}}" class="back-action" bindtap="backToList" disabled="{{busy}}"><image class="back-action__icon" src="/assets/approved-ui/icon-chevron-left-navy.png" mode="aspectFit" aria-hidden="true"/>返回我的报名</button>

    <block wx:if="{{!detail && !enrollment}}">
      <view class="training-tabs"><button class="training-tab {{viewTab==='catalog' ? 'is-active' : ''}}" bindtap="showCatalog" disabled="{{busy}}">发现课程</button><button class="training-tab {{viewTab==='mine' ? 'is-active' : ''}}" bindtap="loadMine" disabled="{{busy || mineLoading}}">我的报名</button></view>
      <view wx:if="{{viewTab==='catalog'}}" class="figma-section">
        <view class="section-heading"><view><view class="figma-eyebrow">固定短班</view><view class="figma-section__title">开放课程</view></view><button class="section-link" bindtap="load" disabled="{{busy || loading}}">刷新</button></view>
        <button wx:for="{{items}}" wx:key="id" class="course-card" data-id="{{item.id}}" bindtap="select"><view class="course-cover"><figma-icon name="training" size="24"/></view><view class="course-copy"><view class="section-heading"><view class="figma-row__title">{{item.title}}</view><view class="price-copy">{{item.amount}}</view></view><view class="figma-row__subtitle">{{item.address}}</view><view class="figma-caption">剩余 {{item.available}} 位 · 查看固定课次与合同</view></view></button>
        <figma-feedback wx:if="{{enabled && !loading && !items.length}}" type="empty" title="暂无开放班期" body="机构完成资质、教练与固定课次核验后才会公开。"/>
      </view>
      <view wx:if="{{viewTab==='mine'}}" class="figma-section">
        <view class="figma-eyebrow">本人记录</view><view class="figma-section__title">报名与课次</view>
        <button wx:for="{{mine}}" wx:key="id" class="figma-row" data-id="{{item.id}}" bindtap="selectEnrollment"><view class="figma-row__copy"><view class="figma-row__title">{{item.stateLabel}}</view><view class="figma-row__subtitle">报名 {{item.id}}</view></view><view class="price-copy">{{item.amount}}</view></button>
        <figma-feedback wx:if="{{mineLoaded && !mineLoading && !mine.length}}" type="empty" title="暂无报名与课次" body="选择真实开放课程，核对合同后再报名。"/>
      </view>
    </block>

    <block wx:if="{{detail}}">
      <view class="figma-summary figma-summary--navy training-detail-summary"><view class="figma-summary__copy"><view class="figma-eyebrow">本人报名</view><view class="figma-title">成人篮球短课</view><view class="figma-subtitle">{{detail.title}}</view></view><image class="training-detail-summary__image" src="/assets/home/event-court.jpg" mode="aspectFill"/></view>
      <view class="training-tabs"><button class="training-tab is-active" bindtap="showCatalog" disabled="{{busy}}">发现课程</button><button class="training-tab" bindtap="loadMine" disabled="{{busy || mineLoading}}">我的报名</button></view>
      <block wx:if="{{signupStep==='course'}}">
        <view class="figma-section"><view class="figma-section__title">课程信息</view><view class="figma-row"><figma-icon name="training" size="20"/><view class="figma-row__copy"><view class="figma-row__title">{{detail.title}}</view><view class="figma-row__subtitle">{{detail.description}}</view></view><view class="figma-status figma-status--orange">{{detail.scheduleLabel || detail.amount}}</view></view><view class="figma-row"><figma-icon name="court-location" size="20"/><view class="figma-row__copy"><view class="figma-row__title">{{detail.locationLabel || '上课地点'}}</view><view class="figma-row__subtitle">{{detail.address}}</view></view><view wx:if="{{detail.audienceLabel}}" class="figma-status">{{detail.audienceLabel}}</view></view><view class="figma-row"><figma-icon name="player" size="20"/><view class="figma-row__copy"><view class="figma-row__title">授课教练</view><view class="figma-row__subtitle">{{detail.sessions[0].coaches[0].name}}</view></view><view class="figma-status">查看课次</view></view></view>
        <view class="figma-section"><view class="figma-section__title">固定课表</view><view wx:for="{{detail.sessions}}" wx:key="id" class="session-row"><view><view class="figma-row__title">{{item.title || ('第' + (index+1) + '课')}}</view><view class="figma-row__subtitle">{{item.time}}</view></view><view class="figma-status {{index===0 ? 'figma-status--orange' : ''}}">{{item.stateLabel || '待核对'}}</view></view></view>
        <view class="figma-section"><view class="figma-section__title">报名确认</view><view class="figma-row"><view class="figma-row__mark"/><view class="figma-row__copy"><view class="figma-row__title">本人已成年</view><view class="figma-row__subtitle">本期仅接受成年学员本人</view></view><view class="figma-status">未勾选</view></view><view class="figma-row"><view class="figma-row__mark"/><view class="figma-row__copy"><view class="figma-row__title">接受本次课程合同</view><view class="figma-row__subtitle">核对课次与退费条款</view></view></view><view class="figma-row"><view class="figma-row__mark"/><view class="figma-row__copy"><view class="figma-row__title">无名额时进入候补</view><view class="figma-row__subtitle">候补不收费、不锁位</view></view></view></view>
        <view class="figma-section"><view class="figma-section__title">相关服务</view><button class="figma-row" bindtap="loadMine"><view class="figma-row__copy"><view class="figma-row__title">查看本班原订单</view></view><view class="figma-status">进入</view></button></view>
      </block>
      <view wx:if="{{signupStep==='review'}}" class="figma-section course-detail"><view class="figma-info"><view class="figma-row__title">首期仅支持成年学员本人报名</view><view class="figma-caption">青少年培训与专用监护授权尚未开放，不能以赛事监护确认替代。</view></view><view class="review-row"><view class="figma-field-label">本次学员</view><view>当前登录的成年学员本人</view></view><view class="review-row"><view class="figma-field-label">班次与金额</view><view>{{detail.title}} · {{detail.sessions.length}} 课次 · {{detail.amount}}</view></view><view class="figma-field-group"><view class="figma-field-label">付款人（不填为本人）</view><input class="figma-field-control" placeholder="另设付款人账户编号（选填）" data-field="payerUserId" bindinput="input" value="{{payerUserId}}"/><view class="figma-caption">代付不会取得学员资料或接送权限。</view></view><view class="contract-box">{{detail.termsText}}</view><checkbox-group bindchange="consent"><label class="figma-check"><checkbox value="adult" checked="{{adult}}"/>我是成年学员本人</label><label class="figma-check"><checkbox value="terms" checked="{{accepted}}"/>已阅读并接受本次课程合同</label><label wx:if="{{detail.totalFen>0}}" class="figma-check"><checkbox value="payment" checked="{{chargeConsent}}"/>明确同意上述冻结金额及付款条款</label><label class="figma-check"><checkbox value="waitlist" checked="{{waitlist}}"/>无位时加入候补，候补不收费</label></checkbox-group></view>
    </block>

    <view wx:if="{{enrollment}}" class="figma-section enrollment-detail">
      <view class="section-heading"><view><view class="figma-eyebrow">报名 {{enrollment.id}}</view><view class="figma-section__title">{{enrollment.stateLabel}}</view></view><view class="price-copy">{{enrollment.amount}}</view></view>
      <figma-feedback wx:if="{{enrollment.state==='WAITLISTED'}}" type="warning" title="候补登记已受理" body="尚未报名成功、未锁位、未扣款；有名额后须按顺序重新领取。"/>
      <figma-feedback wx:if="{{enrollment.state==='PAID_UNALLOCATED'}}" type="warning" title="付款已确认，名额待处理" body="当前未取得名额；消费与原款退款分别核对。"/>
      <figma-feedback wx:if="{{enrollment.state==='HOLDING'}}" type="info" title="名额暂时保留" body="锁位截止以服务器记录为准；付款后请再次核对报名状态。"/>
      <view wx:if="{{enrollment.deadline}}" class="figma-info">锁位截止 {{enrollment.deadline}}</view><view class="contract-box">{{enrollment.termsSnapshot.termsText}}</view>
      <view class="action-stack"><button wx:if="{{enrollment.state==='WAITLISTED'}}" class="figma-action figma-action--orange" data-action="CLAIM" bindtap="enrollmentAction" disabled="{{busy || pending}}">按候补顺序领取名额</button><button wx:if="{{enrollment.capabilities.canConfirm}}" class="figma-action figma-action--orange" data-action="CONFIRM" bindtap="enrollmentAction" disabled="{{busy || pending}}">核对资格并确认入班</button><button wx:if="{{enrollment.totalFen>0 && !enrollment.tradeOrderId && enrollment.state==='HOLDING'}}" class="figma-action figma-action--orange" data-action="AUTHORIZE_PAYMENT" bindtap="enrollmentAction" disabled="{{busy || pending}}">付款人确认冻结合同</button><button wx:if="{{enrollment.tradeOrderId}}" class="figma-action figma-action--ghost" bindtap="openTrade">支付 / 真实退款进度</button><button wx:if="{{enrollment.tradeOrderId}}" class="figma-action figma-action--ghost" data-action="REFRESH" bindtap="enrollmentAction" disabled="{{busy || pending}}">核对支付与名额</button><button wx:if="{{enrollment.capabilities.canCancel}}" class="figma-action figma-action--ghost danger-action" data-action="CANCEL" bindtap="enrollmentAction" disabled="{{busy || pending}}">取消未付款报名</button></view>
      <checkbox-group wx:if="{{enrollment.totalFen>0 && !enrollment.tradeOrderId}}" bindchange="consent"><label class="figma-check"><checkbox value="payment" checked="{{chargeConsent}}"/>付款人已阅读并接受本次冻结合同</label></checkbox-group>
      <view class="figma-field-group"><view class="figma-field-label">请假、退费或消费异议原因</view><textarea class="figma-field-control" data-field="reason" bindinput="input" value="{{reason}}"/></view>
      <view class="figma-row__title">课次权益</view>
      <view wx:for="{{enrollment.entitlements}}" wx:key="id" class="entitlement-row"><view><view class="figma-row__title">{{item.stateLabel}}</view><view class="figma-row__subtitle">{{item.amount}} · 课次 {{item.sessionId}}</view></view><view class="row-actions"><button wx:if="{{item.state==='AVAILABLE'}}" data-id="{{item.id}}" data-action="LEAVE" bindtap="entitlementAction" disabled="{{busy || pending}}">请假</button><button wx:if="{{item.state==='MAKEUP_DUE' && isLearner}}" data-id="{{item.id}}" bindtap="chooseMakeup" disabled="{{busy || pending || makeupLoading}}">选择补课课次</button><button wx:if="{{item.state==='AVAILABLE' || item.state==='MAKEUP_DUE'}}" data-id="{{item.id}}" bindtap="refund" disabled="{{busy || pending}}">退费</button></view></view>
      <figma-feedback wx:if="{{makeupLoading}}" type="loading" title="正在核对补课名额与本人档期"/>
      <view wx:if="{{makeup}}" class="makeup-panel"><view class="figma-row__title">选择补课课次</view><block wx:if="{{makeup.items.length}}"><picker class="figma-field-control" range="{{makeup.items}}" range-key="label" value="{{makeup.selectedIndex}}" bindchange="selectMakeup">{{makeup.selected.cohortTitle}} · 更换课次</picker><view>{{makeup.selected.time}}</view><view class="figma-caption">教练 {{makeup.selected.coachNames}} · {{makeup.selected.address}} · 剩余 {{makeup.selected.availableSeats}} 位</view><button class="figma-action figma-action--orange" bindtap="confirmMakeup" disabled="{{busy || pending}}">确认这节补课</button></block><view wx:else class="figma-caption">暂无符合当前资格、名额和本人档期的补课课次。</view><button class="figma-action figma-action--ghost" data-id="{{makeup.entitlementId}}" bindtap="chooseMakeup" disabled="{{busy || pending || makeupLoading}}">刷新可选课次</button></view>
      <view class="figma-row__title">消费与退款记录</view>
      <view wx:for="{{enrollment.consumptions}}" wx:key="id" class="record-row"><view>{{item.stateLabel}} · {{item.reason}}</view><view class="row-actions"><button wx:if="{{item.status==='REVIEWED'}}" data-id="{{item.id}}" data-action="ACKNOWLEDGE" bindtap="consumptionAction" disabled="{{busy || pending}}">确认完成</button><button wx:if="{{item.status==='PROPOSED' || item.status==='REVIEWED' || item.status==='FINALIZED'}}" data-id="{{item.id}}" data-action="DISPUTE" bindtap="consumptionAction" disabled="{{busy || pending}}">提交异议</button></view></view>
      <view wx:for="{{enrollment.refunds}}" wx:key="id" class="record-row"><view>{{item.amount}} · {{item.stateLabel}}</view><button wx:if="{{item.status==='PENDING' || item.status==='UNKNOWN'}}" data-id="{{item.id}}" bindtap="refreshRefund" disabled="{{busy || pending}}">核对真实退款回执</button></view>
    </view>
  </view>
  <view wx:if="{{!detail && !enrollment}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="loadMine" disabled="{{busy || mineLoading}}">我的报名</button><button class="figma-action figma-action--orange" bindtap="manage">培训工作台</button></view>
  <view wx:if="{{detail && signupStep==='course'}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="loadMine" disabled="{{busy || mineLoading}}">我的报名</button><button class="figma-action figma-action--orange" bindtap="reviewSignup" disabled="{{busy || pending || !enabled || !detail.capabilities.canEnroll}}">查看课次与合同</button></view>
  <view wx:if="{{detail && signupStep==='review'}}" class="enroll-bar"><button class="figma-action figma-action--orange" bindtap="enroll" disabled="{{busy || pending || !enabled || !adult || !accepted || !detail.capabilities.canEnroll || (detail.totalFen>0 && (!detail.capabilities.paidEnrollmentEnabled || !chargeConsent))}}">确认报名并暂留名额</button></view>
</view>
