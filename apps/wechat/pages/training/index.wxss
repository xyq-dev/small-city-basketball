.screen{padding:28rpx;background:#f5f6f8;min-height:100vh;color:#17212b}.hero{padding:36rpx 8rpx;display:flex;flex-direction:column;gap:16rpx}.eyebrow{color:#bd4b1d;font-size:24rpx;letter-spacing:3rpx}.title{font-size:44rpx;font-weight:700}.card{background:#fff;border-radius:22rpx;padding:28rpx;margin:22rpx 0;display:flex;flex-direction:column;gap:18rpx}.heading{font-size:32rpx;font-weight:600}.row{display:flex;justify-content:space-between;gap:18rpx}.actions{display:flex;flex-wrap:wrap;gap:12rpx}.actions button{font-size:24rpx;margin:0}.primary{background:#c65025;color:white;width:100%;font-weight:600}.lesson{border-top:1rpx solid #e4e8eb;padding-top:20rpx;display:flex;flex-direction:column;gap:14rpx;word-break:break-all}.terms{white-space:pre-wrap;background:#f3f6f8;padding:22rpx;border-radius:14rpx;font-size:26rpx}.notice{background:#fff3d8;padding:22rpx;border-radius:16rpx;margin:14rpx 0}.error{background:#ffeded;color:#942929;padding:22rpx;border-radius:16rpx}.small{font-size:23rpx;color:#637381;word-break:break-all}input,textarea{box-sizing:border-box;width:100%;background:#f3f5f7;padding:20rpx;border-radius:12rpx;font-size:26rpx}input{min-height:82rpx}textarea{height:150rpx}checkbox-group,label{display:flex;flex-direction:column;gap:20rpx;font-size:25rpx}label{display:block;line-height:1.8}button{font-size:26rpx}

.makeup-picker{display:flex;flex-direction:column;gap:18rpx;background:#f4f8fa;padding:24rpx;border-radius:16rpx}.makeup-choice{padding:24rpx;background:white;border:1rpx solid #cbd8df;border-radius:12rpx;font-weight:600;word-break:break-word}
