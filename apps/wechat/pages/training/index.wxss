@import "../../styles/figma-pages.wxss";
.title{font-size:24px;line-height:34px}.danger-action{border-color:#d97474;color:#a83b31}
.training-detail-summary{position:relative;min-height:190rpx;overflow:hidden}.training-detail-summary .figma-summary__copy{position:relative;z-index:1;max-width:62%}.training-detail-summary__image{position:absolute;right:0;bottom:0;width:38%;height:100%;object-fit:cover}.training-detail-summary::after{position:absolute;z-index:0;top:0;right:28%;bottom:0;width:24%;background:linear-gradient(90deg,#123c73,rgba(18,60,115,0));content:""}
.training-page{padding-bottom:calc(124rpx + env(safe-area-inset-bottom))}.training-page.has-enroll-bar{padding-bottom:calc(176rpx + env(safe-area-inset-bottom))}.training-hero{position:relative;overflow:hidden;height:300rpx;border-radius:32rpx;background:#123c73}.training-hero__image,.training-hero__shade{position:absolute;inset:0;width:100%;height:100%}.training-hero__shade{background:linear-gradient(90deg,rgba(12,37,70,.94),rgba(12,37,70,.3))}.training-hero__copy{position:relative;z-index:1;display:flex;height:100%;box-sizing:border-box;flex-direction:column;justify-content:center;padding:40rpx;color:#fff}.training-hero__copy .figma-eyebrow{color:#f6a623}.training-hero__title{font-size:42rpx;font-weight:700;line-height:56rpx}.training-hero__body{margin-top:12rpx;font-size:26rpx;line-height:40rpx}.back-action{display:flex;width:100%;min-height:88rpx;align-items:center;gap:12rpx;margin:0;text-align:left;background:transparent;color:#123c73;font-size:28rpx}.back-action__icon{width:32rpx;height:32rpx;flex:none}.back-action::after,.training-tab::after,.section-link::after,.course-card::after,.row-actions button::after,.record-row button::after{border:0}.training-tabs{display:flex;gap:8rpx;padding:8rpx;border-radius:28rpx;background:#e6ebf2}.training-tab{min-height:80rpx;flex:1;margin:0;border-radius:20rpx;background:transparent;color:#51657d;font-size:28rpx}.training-tab.is-active{background:#fff;color:#123c73;box-shadow:0 2rpx 6rpx rgba(18,60,115,.12)}.section-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.section-link{min-width:88rpx;min-height:88rpx;margin:0;padding:0;background:transparent;color:#123c73;font-size:26rpx}.course-card{display:flex;width:100%;min-height:152rpx;margin:0;padding:24rpx;text-align:left;border-top:1rpx solid #e1e7ef;border-radius:0;background:#fff;color:#243b57}.course-cover{display:flex;width:96rpx;height:96rpx;flex:none;align-items:center;justify-content:center;border-radius:24rpx;background:#e9f2ff}.course-copy{min-width:0;flex:1;padding-left:24rpx}.price-copy{color:#9a5d0b;font-size:28rpx;font-weight:700}.course-detail,.enrollment-detail,.action-stack{display:flex;flex-direction:column;gap:24rpx}.course-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.course-facts>view,.review-row,.figma-info,.contract-box,.makeup-panel{padding:24rpx;border-radius:24rpx;background:#f4f7fb}.session-row,.entitlement-row,.record-row{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx;padding:24rpx 0;border-top:1rpx solid #e1e7ef}.contract-box{white-space:pre-wrap;color:#51657d;font-size:28rpx;line-height:44rpx}.figma-check{display:flex;min-height:88rpx;align-items:center;gap:16rpx;font-size:28rpx;line-height:42rpx}.row-actions{display:flex;flex:none;gap:8rpx}.row-actions button,.record-row button{min-height:72rpx;margin:0;padding:0 18rpx;border-radius:18rpx;background:#e9f2ff;color:#123c73;font-size:24rpx}.makeup-panel{display:flex;flex-direction:column;gap:16rpx}.enroll-bar{position:fixed;right:0;bottom:0;left:0;z-index:30;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid #dce3ec;background:#fff}.enroll-bar .figma-action{width:100%}@media(max-width:340px){.course-facts{grid-template-columns:1fr}.training-hero{height:280rpx}.training-hero__copy{padding:28rpx}.training-hero__title{font-size:36rpx}.entitlement-row,.record-row{display:block}.row-actions{margin-top:16rpx;flex-wrap:wrap}}
