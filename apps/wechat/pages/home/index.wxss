button.home-primary { color:#fff; }
.home-hero-content .home-primary { width:214px; margin-left:auto; margin-right:auto; }
.home-section-head .home-more-toggle { width:94px; margin:0; }
.home-content .home-event { width:100%; }
.home-service-grid .home-service,.position-grid .position-button,.home-event-actions button,.home-extension-actions button { width:auto; margin:0; }
.home-service-grid { flex-wrap:wrap; margin-top:12px; }
.home-service-grid .home-service { flex:1 1 calc(50% - 6px); height:88px; }
.home-service-title { font-size:16px; line-height:24px; }
button.home-event { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:0 0 8px; padding:12px; border-radius:12px; background:#f5f8fb; text-align:left; font-weight:400; }
button.home-event::after { border:none; }
.home-event-main { flex:1; min-width:0; }
.home-event-name { font-size:15px; line-height:22px; font-weight:600; color:#132c49; overflow-wrap:anywhere; }
.home-event-meta { font-size:12px; line-height:20px; color:#617286; }
.home-event-status { flex:none; padding:2px 8px; border-radius:24px; font-size:12px; line-height:20px; background:#e7f5ee; color:#16734b; }
.home-event-status.live { background:#ff6b2d; color:#fff; }
.home-event-state { padding:12px; border-radius:12px; background:#f5f8fb; }
.home-event-actions { display:flex; gap:8px; margin-top:8px; }
.home-event-actions button { flex:1; margin:0; }
.home-extension { margin-top:16px; padding-top:4px; border-top:1px solid #e8edf2; }
.home-extension-tag { display:inline-block; padding:0 6px; border-radius:4px; background:#fff3eb; color:#c2541f; font-size:10px; line-height:16px; }
.home-extension .position-button { min-height:68px; height:68px; }
.home-extension-actions { display:flex; gap:8px; margin-bottom:4px; }
.home-extension-actions button { flex:1; min-width:0; margin:0; font-size:13px; }
.home-extension-actions button.secondary { background:#f5f8fb; border-radius:12px; font-weight:600; }
.home-extension-actions button.secondary::after { border:0; }
