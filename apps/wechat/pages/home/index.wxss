@import "../../styles/figma-system.wxss";

page { background:#f4f6fa; }
.home-rebuild { max-width:600px; margin:0 auto; overflow-x:hidden; }
.home-scroll { width:100%; background:#f4f6fa; }
.home-rebuild button { display:flex; width:auto; min-height:44px; margin:0; padding:0; border-radius:0; background:transparent; color:inherit; font-family:inherit; font-size:inherit; font-weight:inherit; line-height:inherit; text-align:inherit; box-sizing:border-box; }
.home-rebuild button::after { border:0; border-radius:0; }
.home-hero { position:relative; width:100%; height:204px; overflow:hidden; background:#123c73; }
.home-hero__image { position:absolute; inset:0; width:100%; height:100%; }
.home-hero__copy { position:absolute; z-index:1; right:20px; bottom:20px; left:20px; color:#ffffff; }
.home-hero__title { font-size:28px; font-weight:700; line-height:38px; }
.home-hero__subtitle { margin-top:4px; font-size:13px; font-weight:400; line-height:18px; }
.home-quick { display:grid; width:100%; height:152px; grid-template-columns:repeat(4,minmax(0,1fr)); grid-template-rows:repeat(2,68px); padding:8px 15px; background:#ffffff; }
.home-rebuild .home-quick__item { display:flex; width:100%; min-width:0; min-height:68px; flex-direction:column; align-items:center; justify-content:center; gap:2px; background:#ffffff; color:#18283f; font-size:12px; font-weight:700; line-height:17px; text-align:center; }
.home-quick__icon { display:flex; width:38px; height:36px; align-items:center; justify-content:center; border-radius:12px; background:#eaf2fc; }
.home-quick__icon.is-orange { background:#fff1e2; }
.home-content { display:flex; width:100%; flex-direction:column; gap:10px; padding:12px 16px 34px; }
.home-section__head { display:flex; width:100%; height:32px; min-height:32px; align-items:center; justify-content:space-between; gap:8px; }
.home-section__head--local { margin-top:0; }
.home-section__title { color:#18283f; font-size:20px; font-weight:700; line-height:27px; }
.home-rebuild .home-section__more { width:auto; min-width:44px; min-height:44px; flex:none; align-items:center; justify-content:flex-end; gap:2px; margin:0; padding:0 0 0 8px; background:transparent; color:#51657d; font-size:12px; font-weight:400; line-height:18px; }
.home-section__more image { width:14px; height:14px; flex:none; }
.home-rebuild .home-event-card { display:flex; width:100%; height:96px; min-height:96px; align-items:center; gap:12px; padding:10px 19px 10px 10px; border-radius:14px; background:#ffffff; text-align:left; overflow:hidden; }
.home-event-card__image { display:block; width:101px; height:76px; flex:none; border-radius:8px; }
.home-event-card__copy { display:flex; min-width:0; flex:1; flex-direction:column; align-items:flex-start; justify-content:center; }
.home-event-card__name { width:100%; overflow:hidden; color:#18283f; font-size:17px; font-weight:700; line-height:23px; white-space:nowrap; text-overflow:ellipsis; }
.home-event-card__meta { display:flex; width:100%; min-width:0; margin-top:3px; align-items:center; gap:6px; overflow:hidden; color:#51657d; font-size:12px; font-weight:400; line-height:17px; white-space:nowrap; }
.home-event-card__location { min-width:0; max-width:50%; overflow:hidden; flex:0 1 auto; text-overflow:ellipsis; }
.home-event-card__date { min-width:0; overflow:hidden; flex:1; text-overflow:ellipsis; }
.home-event-card__status { display:flex; min-width:58px; max-width:100%; height:20px; align-items:center; justify-content:center; margin-top:3px; padding:0 8px; overflow:hidden; border-radius:5px; background:#fff1e2; color:#18283f; font-size:11px; font-weight:400; line-height:15px; white-space:nowrap; text-overflow:ellipsis; }
.home-local-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
.home-rebuild .home-local-card { display:flex; width:100%; height:103px; min-height:103px; flex-direction:column; align-items:stretch; justify-content:flex-start; padding:0; border-radius:12px; background:#ffffff; text-align:left; overflow:hidden; }
.home-local-card image { display:block; width:100%; height:65px; flex:none; background:#f1f6fc; }
.home-local-card--referee image { background:#fff7ee; }
.home-local-card__title { display:flex; height:38px; flex:none; align-items:center; padding:0 12px; color:#18283f; font-size:14px; font-weight:700; line-height:19px; }
.home-extra { display:flex; width:100%; flex-direction:column; gap:12px; padding:16px; border-radius:16px; background:#ffffff; }
.home-private-event { display:flex; width:100%; min-height:88px; flex-direction:column; align-items:flex-start; gap:3px; padding:12px; border-radius:12px; background:#f4f6fa; text-align:left; }
.home-private-event__status { color:#16734b; font-size:12px; line-height:18px; }
.home-private-event__name { width:100%; color:#18283f; font-size:16px; font-weight:700; line-height:24px; overflow-wrap:anywhere; }
.home-private-event__meta { color:#51657d; font-size:12px; line-height:18px; }
.home-extra__caption { margin-top:-8px; }
.home-position-grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:6px; }
.home-rebuild .home-position-grid button { width:auto; min-width:0; min-height:44px; align-items:center; justify-content:center; margin:0; padding:0 4px; border-radius:10px; background:#edf4fc; color:#123c73; font-size:12px; line-height:18px; }
.home-extra__links { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
.home-rebuild .home-extra__links button { width:auto; min-width:0; min-height:44px; align-items:center; justify-content:center; margin:0; padding:4px 8px; border:1px solid #e6ebf2; border-radius:12px; background:#ffffff; color:#123c73; font-size:13px; font-weight:500; line-height:20px; text-align:center; }
@media (max-width:360px) {
  .home-content { padding-right:12px; padding-left:12px; }
  .home-quick { padding-right:5px; padding-left:5px; }
  .home-hero__copy { right:20px; left:20px; }
  .home-event-card { gap:10px; padding-right:10px; }
  .home-local-grid { gap:8px; }
  .home-local-card image { width:82px; height:70px; }
}
