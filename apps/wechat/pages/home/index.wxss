page { background:#f4f6fa; }
.home-ui { max-width:600px; padding:0 0 calc(132px + env(safe-area-inset-bottom)); background:#f4f6fa; }
.home-ui button { width:auto; min-height:44px; margin:0; padding:0; background:transparent; color:#18283f; font-weight:500; }
.home-ui button::after { border:0; }
.home-top { display:flex; flex-direction:column; gap:6px; padding:20px 16px 10px; background:#123c73; }
.home-brand { min-height:48px; display:flex; align-items:center; gap:8px; }
.home-brand-mark { width:31px; height:31px; flex:none; }
.home-brand-name { flex:none; white-space:nowrap; color:#fff; font-size:20px; line-height:27px; font-weight:700; }
.home-city,.home-search,.home-bell { min-height:44px; display:flex; align-items:center; }
.home-ui .home-city { flex:0 1 70px; width:auto; min-width:44px; max-width:70px; overflow:hidden; gap:3px; justify-content:center; color:#fff; font-size:14px; line-height:19px; font-weight:700; }
.home-city view { flex:1; }
.home-city view,.home-search view { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.home-city image { width:13px; height:13px; flex:none; }
.home-ui .home-search { width:100%; min-width:0; gap:8px; height:44px; padding:0 14px 0 15px; border-radius:22px; background:#fff; color:#63758b; font-size:14px; line-height:19px; text-align:left; font-weight:400; }
.home-search image { width:18px; height:18px; flex:none; }
.home-ui .home-bell { flex:none; width:44px; min-width:44px; height:44px; border-radius:0; justify-content:center; background:transparent; }
.home-bell image { width:22px; height:22px; }
.home-hero { position:relative; height:204px; margin:0; border-radius:0; overflow:hidden; background:#123c73; }
.home-hero-photo,.home-hero-shade { position:absolute; inset:0; width:100%; height:100%; }
.home-hero-photo { opacity:.83; }
.home-hero-shade { background:linear-gradient(90deg,rgba(8,28,58,.94),rgba(8,28,58,.64) 48%,rgba(8,28,58,.08)); }
.home-hero-copy { position:relative; z-index:1; height:100%; display:flex; flex-direction:column; align-items:flex-start; justify-content:flex-end; gap:4px; padding:12px 14px 21px 20px; color:#fff; }
.home-headline { font-size:28px; line-height:38px; font-weight:700; }
.home-tagline { font-size:13px; line-height:18px; color:#fff; font-weight:400; }
.home-hero-caption { position:absolute; right:12px; bottom:12px; padding:2px 6px; border-radius:4px; background:rgba(8,28,58,.55); color:#fff; font-size:10px; line-height:14px; }
.home-quick { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); padding:8px 15px; background:#fff; }
.home-quick button { width:100%; min-width:0; height:68px; min-height:68px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px; font-size:12px; line-height:17px; font-weight:700; color:#18283f; }
.home-quick-icon { display:flex; align-items:center; justify-content:center; width:38px; height:36px; border-radius:12px; background:#eaf2fc; }
.home-quick-icon image { width:22px; height:22px; }
.home-quick-icon.orange { background:#fff1e2; }
.home-section-head { display:flex; align-items:center; justify-content:space-between; gap:8px; margin:0 0 12px; }
.home-kicker { color:#63758b; font-size:10px; line-height:16px; letter-spacing:1px; font-weight:600; }
.home-section-title { color:#18283f; font-size:20px; line-height:27px; font-weight:700; }
.home-section-head button { flex:none; display:flex; align-items:center; justify-content:flex-end; gap:2px; min-height:44px; font-size:12px; line-height:20px; color:#63758b; }
.home-section-head button image { width:14px; height:14px; }
.home-public-scope { display:flex; align-items:center; gap:6px; min-height:44px; margin:-8px 0 10px; color:#63758b; font-size:12px; line-height:18px; }
.home-public-scope > view:nth-child(2) { flex:1; min-width:0; overflow-wrap:anywhere; }
.home-scope-dot { width:6px; height:6px; border-radius:50%; background:#f28c28; flex:none; }
.home-public-scope button { flex:none; color:#123c73; font-size:12px; line-height:18px; }
.home-ui .home-hot { width:100%; height:auto; min-height:96px; display:flex; gap:12px; align-items:center; padding:10px; margin-bottom:10px; border-radius:14px; border:0; background:#fff; text-align:left; }
.home-hot:last-of-type { margin-bottom:24px; }
.home-hot-photo { position:relative; width:101px; height:76px; min-height:76px; flex:none; border-radius:8px; overflow:hidden; background:#edf3fa; }
.home-hot-photo image { position:absolute; inset:0; width:100%; height:100%; }
.home-hot-photo view { position:absolute; left:6px; bottom:6px; padding:0 5px; border-radius:4px; background:rgba(18,40,63,.72); color:#fff; font-size:10px; line-height:18px; }
.home-hot-body { flex:1; min-width:0; display:flex; flex-direction:column; align-items:flex-start; }
.home-hot-status { padding:1px 7px; border-radius:5px; background:#fff1df; color:#8a4b08; font-size:11px; line-height:18px; font-weight:600; }
.home-hot-name { width:100%; margin-top:6px; color:#18283f; font-size:16px; line-height:23px; font-weight:700; overflow-wrap:anywhere; }
.home-hot-meta { width:100%; margin-top:5px; display:flex; align-items:flex-start; gap:4px; color:#63758b; font-size:11px; line-height:18px; }
.home-hot-meta image { width:14px; height:14px; margin-top:2px; flex:none; }
.home-hot-meta view { min-width:0; overflow-wrap:anywhere; }
.home-hot-more { display:flex; align-items:center; gap:6px; margin-top:10px; color:#123c73; font-size:12px; line-height:20px; font-weight:600; }
.home-hot-more image { width:14px; height:14px; }
.home-local { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
.home-ui .home-local button { width:100%; min-width:0; height:103px; min-height:103px; display:flex; flex-direction:column; align-items:flex-start; justify-content:space-between; gap:8px; padding:12px; border-radius:12px; text-align:left; }
.home-ui .home-local-court { background:#e9f0f9; }
.home-ui .home-local-referee { background:#fff1df; }
.home-local-copy view:first-child { color:#18283f; font-size:15px; line-height:23px; font-weight:700; }
.home-local-copy view:last-child { margin-top:4px; color:#63758b; font-size:11px; line-height:18px; font-weight:400; }
.home-local-link { display:flex; align-items:center; gap:4px; font-size:11px; line-height:18px; color:#123c73; font-weight:600; }
.home-local-note { margin:10px 0 24px; color:#63758b; font-size:11px; line-height:18px; }
.home-private,.home-services { padding:16px; margin-bottom:24px; border:1px solid #e3e9f1; border-radius:18px; background:#fff; }
.home-ui .home-event { width:100%; display:flex; flex-direction:column; align-items:flex-start; gap:6px; padding:14px; margin-bottom:12px; border-radius:12px; background:#f4f6fa; text-align:left; }
.home-event-status { color:#16734b; font-size:11px; line-height:18px; }
.home-event-name { width:100%; color:#18283f; font-size:16px; line-height:24px; font-weight:700; overflow-wrap:anywhere; }
.home-event-meta { color:#63758b; font-size:12px; line-height:20px; overflow-wrap:anywhere; }
.position-grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:6px; margin:12px 0; }
.home-ui .position-grid button { width:100%; min-width:0; min-height:60px; padding:8px 0; border-radius:10px; background:#edf3fa; color:#63758b; font-size:11px; line-height:18px; }
.position-code { color:#123c73; font-size:17px; line-height:24px; font-weight:700; }
.home-shortcuts { margin-top:14px; border-top:1px solid #e3e9f1; }
.home-ui .home-shortcuts button { width:100%; min-height:48px; display:flex; justify-content:space-between; align-items:center; gap:8px; text-align:left; font-size:13px; line-height:22px; border-bottom:1px solid #e3e9f1; }
.home-shortcuts button:last-child { border-bottom:0; }
.home-ui > .notice,
.home-ui > .home-section-head,
.home-ui > .home-public-scope,
.home-ui > .home-local,
.home-ui > .home-local-note,
.home-ui > .home-private,
.home-ui > .home-services,
.home-ui > .home-footer { margin-left:16px; margin-right:16px; }
.home-ui > .home-hot { width:auto; margin-left:16px; margin-right:16px; }
.home-footer { display:flex; align-items:center; justify-content:center; gap:10px; margin:8px 16px 0; color:#63758b; font-size:11px; line-height:18px; }
.home-footer-line { width:24px; height:1px; background:#cbd6e3; }
@media(max-width:360px) {
 .home-brand-mark { width:28px; height:28px; }
 .home-ui .home-city { width:auto; max-width:64px; }
 .home-ui .home-search { padding:0 8px; gap:5px; font-size:12px; }
 .home-hero { height:204px; }
 .home-headline { font-size:26px; line-height:34px; }
 .home-hero-copy { padding:12px 16px 16px; }
 .home-hot-photo { width:76px; }
 .home-local { gap:8px; }
 .home-ui .home-local button { padding:12px; }
 .home-local-copy view:first-child { font-size:14px; line-height:22px; }
 .home-private,.home-services { padding:14px; }
}
