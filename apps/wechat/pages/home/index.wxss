.home-ui { max-width:600px; padding:16px 16px calc(108px + env(safe-area-inset-bottom)); }
.home-filters { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:12px; }
.home-filters button { width:auto; min-width:64px; min-height:44px; margin:0; padding:10px 12px; color:#63758b; background:#fff; font-size:14px; line-height:24px; font-weight:500; }
.home-filters .active { color:#fff; background:#123c73; }
.home-filters button::after { border:0; }
.home-hero { padding:16px; min-height:186px; border-radius:16px; background:#123c73; color:#fff; margin-bottom:12px; }
.home-brand-row { display:flex; gap:12px; min-height:68px; align-items:flex-start; }
.home-brand-copy { min-width:0; flex:1; }
.home-eyebrow { font-size:12px; line-height:18px; }
.home-headline { margin-top:4px; font-size:24px; line-height:34px; font-weight:700; }
.home-brand-ball { flex:none; width:68px; height:68px; }
.home-tagline { font-size:14px; line-height:22px; margin:8px 0; }
.home-hero .home-primary { width:100%; min-height:48px; margin:0; padding:12px; border-radius:12px; background:#f28c28; color:#123c73; font-size:14px; line-height:24px; font-weight:600; }
.home-primary::after { border:0; }
.home-event { width:100%; display:flex; flex-direction:column; gap:8px; align-items:flex-start; text-align:left; padding:16px; margin:0 0 12px; border-radius:12px; background:#fff; }
.home-event::after { border:0; }
.home-event-status { color:#16734b; font-size:12px; line-height:18px; font-weight:400; }
.home-event-name { width:100%; color:#18283f; font-size:18px; line-height:28px; font-weight:700; overflow-wrap:anywhere; }
.home-event-meta { color:#63758b; font-size:12px; line-height:18px; font-weight:400; overflow-wrap:anywhere; }
.home-services,.home-private { background:#fff; border-radius:16px; padding:16px; margin-bottom:12px; }
.home-section-title { color:#18283f; font-size:18px; line-height:28px; font-weight:700; }
.home-service { width:100%; min-height:58px; display:flex; align-items:center; gap:12px; margin:8px 0 0; padding:8px 0; background:#fff; color:#18283f; text-align:left; font-size:16px; line-height:24px; font-weight:500; }
.home-service::after { border:0; }
.home-service > view { flex:1; min-width:0; }
.home-service-copy { color:#63758b; font-size:12px; line-height:18px; font-weight:400; }
.home-section-head { display:flex; justify-content:space-between; gap:8px; align-items:center; margin-bottom:12px; }
.home-section-head button { width:auto; min-width:72px; margin:0; padding:10px 0; font-size:14px; background:transparent; color:#123c73; }
.home-section-head button::after { border:0; }
.home-shortcuts { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; margin-top:12px; }
.home-shortcuts button { margin:0; background:#edf3fa; font-size:14px; }
.position-grid { display:flex; gap:6px; margin:12px 0; }
.position-grid button { flex:1; min-width:0; padding:10px 2px; margin:0; font-size:12px; background:#edf3fa; }
@media(max-width:360px) { .home-brand-row { gap:8px; } .home-headline { font-size:22px; line-height:32px; } }
