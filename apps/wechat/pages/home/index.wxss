.home-page { display:flex; flex-direction:column; gap:16px; padding:20px 20px calc(92px + env(safe-area-inset-bottom)); }
.home-page > .hero,.home-page > .card,.home-page > .notice,.home-page > button { width:100%; margin:0; }
.home-hero { display:flex; flex-direction:column; gap:12px; padding:24px; border-radius:16px; }
.home-hero .title { margin:0; font-size:22px; line-height:34px; }
.home-hero .muted { font-size:14px; line-height:24px; color:#fff; }
.home-card { display:flex; flex-direction:column; gap:8px; padding:16px; border-radius:16px; }
.home-card .subtitle { margin:0; font-size:18px; line-height:28px; font-weight:500; }
.home-copy { color:#617286; font-size:14px; line-height:24px; }
