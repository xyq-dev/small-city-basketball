<scb-header home="{{true}}" back="{{false}}" bind:search="openSearch"/>
<view class="page home-page home-ui">
 <view class="home-filters"><button class="{{citySelection.mode==='NATIONWIDE' ? 'active' : ''}}" bindtap="nationwide">全国</button><button bindtap="chooseCity">{{citySelection.mode==='NATIONWIDE' ? '切换城市' : citySelection.label}}</button><button bindtap="openSearch">搜索</button><button data-page="messages" bindtap="go">消息</button></view>
 <view class="home-hero"><view class="home-brand-row"><view class="home-brand-copy"><view class="home-eyebrow">SMALL CITY · BIG GAME</view><view class="home-headline">每一场，都值得被看见</view></view><image class="home-brand-ball" src="/assets/ui002/node-4-43-0.svg" mode="aspectFit" aria-hidden="true"/></view><view class="home-tagline">全国找赛事，同城一起上场。</view><button class="home-primary" bindtap="openEvents">发现正在进行的赛事</button></view>
 <view wx:if="{{citySelection.warning}}" class="notice warning">{{citySelection.warning}}</view>
 <scb-state wx:if="{{publicLoading}}" kind="loading" title="正在读取公开赛事" description="按当前浏览地区核对主办方已公开的赛事。"/>
 <scb-state wx:elif="{{publicError}}" kind="error" title="公开赛事暂时无法读取" description="{{publicError}}" action-text="重新读取" bind:action="loadPublicEvents"/>
 <scb-state wx:elif="{{publicLoaded && !publicEvents.length}}" kind="empty" title="{{citySelection.label}}暂无进行中赛事" description="可查看其他阶段，或选择其他城市。" action-text="查看全部赛事" secondary-text="切换城市" bind:action="openEvents" bind:secondary="chooseCity"/>
 <button wx:for="{{publicEvents}}" wx:key="publicEventId" class="home-event" data-id="{{item.publicEventId}}" bindtap="openPublicEvent"><view class="home-event-status">{{item.statusLabel}}</view><view class="home-event-name">{{item.name}}</view><view class="home-event-meta">{{item.dateLabel}} · {{item.venueName}}</view><view wx:if="{{item.displayCity}}" class="home-event-meta">{{item.displayCity}}</view></button>
 <view class="home-services"><view class="home-section-title">篮球就在身边</view><button class="home-service" data-page="recruitment" bindtap="go"><scb-icon name="trophy" size="22"/><view><view>赛事招募</view><view class="home-service-copy">查看真实招募与参赛要求</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></button><button class="home-service" data-page="public-archive" bindtap="go"><scb-icon name="chart" size="22"/><view><view>球队与球员数据</view><view class="home-service-copy">仅展示当前有效公开来源</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></button><button class="home-service" bindtap="openLocal"><scb-icon name="pin" size="22"/><view><view>找球场与人员</view><view class="home-service-copy">可预约范围以当地真实供给为准</view></view><scb-icon name="chevron-right" tone="gray" size="16"/></button></view>
 <sponsorship-slot region-id="{{citySelection.regionId || ''}}" catalog-version="{{citySelection.catalogVersion || ''}}" visible="{{sponsorVisible}}"/>
 <view class="home-private"><view class="home-section-head"><view class="home-section-title">我的赛事</view><button bindtap="openEvents">全部赛事</button></view><scb-state wx:if="{{eventsLoading && !featured.length}}" kind="loading" title="正在读取你的赛事"/><button wx:for="{{featured}}" wx:key="key" class="home-event" data-org="{{item.orgId}}" data-id="{{item.id}}" bindtap="openEvent"><view class="home-event-status">{{item.statusLabel}}</view><view class="home-event-name">{{item.name}}</view><view class="home-event-meta">{{item.dateLabel}} · {{item.orgName}}</view></button><scb-state wx:if="{{!eventsLoading && !signedIn}}" kind="permission" title="登录后查看你参与的赛事" description="浏览全国公开赛事无需登录。" action-text="登录并继续" bind:action="login"/><scb-state wx:elif="{{eventsError}}" kind="error" title="我的赛事暂时无法读取" description="{{eventsError}}" action-text="重新读取" bind:action="loadEvents"/><view wx:elif="{{!eventsLoading && !featured.length}}" class="home-event-meta">{{hasOrganizations ? '暂无进行中或即将开赛的赛事，可查看全部赛事。' : '当前账号没有机构赛事身份。'}}</view></view>
 <view class="home-services"><view class="home-section-title">我的篮球生活</view><view class="home-shortcuts"><button data-page="teams" bindtap="go">我的球队</button><button data-page="bookings" bindtap="go">查看我的预约</button><button data-page="media" bindtap="go">比赛视频</button><button data-page="player-center" bindtap="go">进入本人球员中心</button></view></view>
 <view class="home-services"><view class="eyebrow">扩展服务</view><view class="home-section-title">按位置找球员</view><button class="secondary" bindtap="openPlayers">找球员</button><view class="position-grid"><button wx:for="{{positions}}" wx:key="code" data-position="{{item.code}}" bindtap="position">{{item.name}}</button></view><view class="home-event-meta">合作预约不自动加入赛事报名名单。</view></view>
</view>
<scb-nav active="Home"/>
