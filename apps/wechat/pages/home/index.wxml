<view class="page home-page home-ui" style="padding-top:{{statusBarHeight}}px">
 <view class="home-top">
 <view class="home-brand" style="padding-right:{{capsuleGap}}px;margin-top:{{brandOffset}}px">
  <image class="home-brand-mark" src="/assets/home/brandmark.svg" mode="aspectFit"/>
  <view class="home-brand-name">小城市篮球</view>
  <button class="home-city" bindtap="chooseCity" aria-label="选择城市"><view>{{citySelection.mode==='NATIONWIDE' ? '全国' : citySelection.label}}</view><image src="/assets/figma/chevron-down-white.svg" mode="aspectFit"/></button>
  <button class="home-bell" data-page="messages" bindtap="go" aria-label="消息"><image src="/assets/figma/bell-on-navy.svg" mode="aspectFit"/></button>
 </view>
 <button class="home-search" bindtap="openSearch" aria-label="搜索"><image src="/assets/home/search.svg" mode="aspectFit"/><view>搜赛事、球队、球员</view></button>
 </view>
 <view wx:if="{{citySelection.warning}}" class="notice warning">{{citySelection.warning}}</view>
 <view class="home-hero">
  <image class="home-hero-photo" src="/assets/home/hero.jpg" mode="aspectFill" aria-label="篮球品牌主题示意图"/>
  <view class="home-hero-shade"></view>
  <view class="home-hero-copy">
   <view class="home-headline">让热爱，有主场。</view>
   <view class="home-tagline">小城市篮球赛事与同城服务</view>
  </view>
  <view class="home-hero-caption">品牌主题 · 示意图</view>
 </view>
 <view class="home-quick">
  <button bindtap="openEvents"><view class="home-quick-icon orange"><image src="/assets/figma/event.svg" mode="aspectFit"/></view><view>看赛事</view></button>
  <button data-page="recruitment" bindtap="go"><view class="home-quick-icon"><image src="/assets/figma/recruitment.svg" mode="aspectFit"/></view><view>赛事招募</view></button>
  <button bindtap="openTeamData"><view class="home-quick-icon"><image src="/assets/figma/team-archive.svg" mode="aspectFit"/></view><view>球队档案</view></button>
  <button data-page="media" bindtap="go"><view class="home-quick-icon orange"><image src="/assets/figma/media.svg" mode="aspectFit"/></view><view>图片视频</view></button>
  <button bindtap="openPlayers"><view class="home-quick-icon"><image src="/assets/figma/player.svg" mode="aspectFit"/></view><view>找球员</view></button>
  <button data-page="teams" bindtap="go"><view class="home-quick-icon"><image src="/assets/figma/jersey.svg" mode="aspectFit"/></view><view>我的球队</view></button>
  <button bindtap="openCourt"><view class="home-quick-icon"><image src="/assets/figma/court.svg" mode="aspectFit"/></view><view>找球场</view></button>
  <button bindtap="openLocal"><view class="home-quick-icon"><image src="/assets/figma/local.svg" mode="aspectFit"/></view><view>同城服务</view></button>
 </view>
 <view class="home-section-head"><view class="home-section-title">精选赛事</view><button bindtap="openEvents">更多赛事<image src="/assets/home/chevron-right.svg" mode="aspectFit"/></button></view>
 <view class="home-public-scope"><view class="home-scope-dot"></view><view>{{citySelection.mode==='NATIONWIDE' ? '全国公开赛事' : citySelection.label + ' · 进行中'}}</view><button bindtap="chooseCity">选择城市</button></view>
 <scb-state wx:if="{{publicLoading}}" kind="loading" title="正在读取公开赛事" description="精彩即将上场，请稍候。"/>
 <scb-state wx:elif="{{publicError}}" kind="error" title="公开赛事暂时无法读取" description="{{publicError}}" action-text="重新读取" bind:action="loadPublicEvents"/>
 <scb-state wx:elif="{{publicLoaded && !publicEvents.length}}" kind="empty" title="{{citySelection.label}}暂无进行中赛事" description="看看即将开始的比赛，或发现其他城市的热爱。" action-text="查看全部赛事" secondary-text="切换城市" bind:action="openEvents" bind:secondary="chooseCity"/>
 <button wx:for="{{publicEvents}}" wx:key="publicEventId" class="home-hot" data-id="{{item.publicEventId}}" bindtap="openPublicEvent">
  <view class="home-hot-photo"><image src="/assets/home/event-court.jpg" mode="aspectFill"/><view>示意图</view></view>
  <view class="home-hot-body">
   <view class="home-hot-status">{{item.statusLabel}}</view>
   <view class="home-hot-name">{{item.name}}</view>
   <view class="home-hot-meta"><image src="/assets/home/pin.svg" mode="aspectFit"/><view>{{item.displayCity || item.venueName}}</view></view>
   <view class="home-hot-meta"><image src="/assets/home/calendar.svg" mode="aspectFit"/><view>{{item.dateLabel}}</view></view>
   <view class="home-hot-more">进入赛事<image src="/assets/home/chevron-right.svg" mode="aspectFit"/></view>
  </view>
 </button>
 <view class="home-section-head"><view class="home-section-title">同城服务</view><button bindtap="openLocal">查看全部<image src="/assets/home/chevron-right.svg" mode="aspectFit"/></button></view>
 <view class="home-local">
  <button class="home-local-court" bindtap="openCourt"><view class="home-local-copy"><view>下一场，去哪里？</view><view>找球场 · 查看场地与档期</view></view><scb-icon name="court" size="32"/><view class="home-local-link">查看本地场馆<scb-icon name="chevron-right" size="14"/></view></button>
  <button class="home-local-referee" bindtap="openReferee"><view class="home-local-copy"><view>好比赛，一起办</view><view>约裁判 · 查看人员与档期</view></view><scb-icon name="users" size="32"/><view class="home-local-link">发现赛事服务<scb-icon name="chevron-right" size="14"/></view></button>
 </view>
 <view class="home-local-note">服务按真实覆盖地区与开放档期提供。</view>
 <sponsorship-slot region-id="{{citySelection.regionId || ''}}" catalog-version="{{citySelection.catalogVersion || ''}}" visible="{{sponsorVisible}}"/>
 <view class="home-private">
  <view class="home-section-head"><view class="home-section-title">我的赛事</view><button bindtap="openEvents">查看全部<image src="/assets/home/chevron-right.svg" mode="aspectFit"/></button></view>
  <scb-state wx:if="{{eventsLoading && !featured.length}}" kind="loading" title="正在读取你的赛事"/>
  <button wx:for="{{featured}}" wx:key="key" class="home-event" data-org="{{item.orgId}}" data-id="{{item.id}}" bindtap="openEvent"><view class="home-event-status">{{item.statusLabel}}</view><view class="home-event-name">{{item.name}}</view><view class="home-event-meta">{{item.dateLabel}} · {{item.orgName}}</view></button>
  <scb-state wx:if="{{!eventsLoading && !signedIn}}" kind="permission" title="登录后查看你参与的赛事" description="浏览全国公开赛事无需登录。" action-text="登录并继续" bind:action="login"/>
  <scb-state wx:elif="{{eventsError}}" kind="error" title="我的赛事暂时无法读取" description="{{eventsError}}" action-text="重新读取" bind:action="loadEvents"/>
  <view wx:elif="{{!eventsLoading && !featured.length}}" class="home-event-meta">{{hasOrganizations ? '暂无进行中或即将开赛的赛事，可查看全部赛事。' : '当前账号没有机构赛事身份。'}}</view>
 </view>
 <view class="home-services">
  <view class="home-kicker">扩展服务</view>
  <view class="home-section-head"><view class="home-section-title">按位置找球员</view><button bindtap="openPlayers">全部球员<image src="/assets/home/chevron-right.svg" mode="aspectFit"/></button></view>
  <view class="position-grid"><button wx:for="{{positions}}" wx:key="code" data-position="{{item.code}}" bindtap="position"><view class="position-code">{{item.code}}</view><view>{{item.name}}</view></button></view>
  <view class="home-event-meta">合作预约不自动加入赛事报名名单。</view>
  <view class="home-shortcuts"><button data-page="bookings" bindtap="go">查看我的预约<scb-icon name="chevron-right" size="16"/></button><button data-page="player-center" bindtap="go">进入本人球员中心<scb-icon name="chevron-right" size="16"/></button></view>
 </view>
 <view class="home-footer"><view class="home-footer-line"></view><view>每一场，都值得被看见</view><view class="home-footer-line"></view></view>
</view>
<scb-nav active="Home"/>
