<scb-header title="直播工作台" disabled="{{busy}}"/>
<view class="figma-page live-studio">
  <view class="figma-page__content figma-page__content--actions">
    <figma-skeleton wx:if="{{loading}}" rows="4"/>
    <figma-feedback wx:if="{{error}}" type="error" title="直播工作台读取或操作失败" body="{{error}}" action-label="重新读取" disabled="{{loading || busy}}" bind:action="load"/>
    <figma-feedback wx:if="{{notice}}" type="success" title="操作已确认" body="{{notice}}"/>
    <figma-feedback wx:if="{{pending}}" type="pending" title="原操作结果待核对" body="已保留原操作编号。核对完成前不会创建第二次采集或停流请求。" action-label="核对原操作结果" disabled="{{busy}}" bind:action="retry"/>

    <block wx:if="{{capabilities}}">
      <view class="live-hero">
        <image class="live-hero__image" src="/assets/home/hero.jpg" mode="aspectFill"/>
        <view class="live-hero__title">{{heroTitle || (matchSummary ? '本场直播 · ' + matchSummary.status : '本场直播')}}</view>
      </view>

      <view class="live-tabs" role="tablist">
        <button wx:for="{{workflowSteps}}" wx:key="key" class="live-tab {{activeSection === item.key ? 'is-active' : ''}}" data-key="{{item.key}}" disabled="{{busy}}" bindtap="changeSection">{{item.label}}</button>
      </view>

      <view wx:if="{{!capabilities.providerReady}}" class="figma-section live-provider-blocked">
        <view class="figma-section__title">正式能力尚未开放</view>
        <view class="figma-section__hint">当前不能开始新的采集；已有直播和原操作仍可继续核对。</view>
        <view wx:for="{{capabilities.blockers}}" wx:key="*this" class="live-blocker">{{item}}</view>
      </view>

      <view id="live-setup" class="figma-section live-match-summary">
        <view class="figma-section__title">本场准备</view>
        <view class="figma-row">
          <view class="figma-row__copy"><view class="figma-row__title">比赛来源</view><view class="figma-row__subtitle">{{eventSourceText || (matchSummary && matchSummary.eventId ? '赛事 ' + matchSummary.eventId : '当前赛事与场地以云端资料为准')}}</view></view>
        </view>
        <view class="figma-row">
          <view class="figma-row__copy"><view class="figma-row__title">权威比分</view><view class="figma-row__subtitle">来自本场记分台，直播端只读</view></view><view class="figma-status">只读</view>
        </view>
        <view class="figma-row">
          <view class="figma-row__copy"><view class="figma-row__title">独立录制</view><view class="figma-row__subtitle">录制用途须由独立有权管理者批准</view></view><view class="figma-status {{session && session.recordingApproved ? 'figma-status--green' : 'figma-status--orange'}}">{{session && session.recordingApproved ? '已批准' : '待批准'}}</view>
        </view>
      </view>

      <view id="live-channels" class="figma-section">
        <view class="figma-section__title">目标频道</view>
        <block wx:if="{{channels.length}}">
          <view wx:for="{{channels}}" wx:key="id" class="figma-row">
            <view class="figma-row__copy"><view class="figma-row__title">{{item.label}}</view><view class="figma-row__subtitle">{{item.subtitle || (item.platform + ' · ' + (item.revoked ? '授权已撤销' : '正式同播权限以云端为准'))}}</view></view><view class="figma-status {{item.selected && !item.revoked ? 'figma-status--green' : ''}}">{{item.statusText || (item.revoked ? '不可用' : item.selected ? '已选择' : '未选择')}}</view>
          </view>
        </block>
        <view wx:else class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">暂无可用频道</view><view class="figma-row__subtitle">请先完成正式目标账号与同播权限核验</view></view><view class="figma-status">未开放</view></view>
      </view>

      <view id="live-capture" class="figma-section live-distribution">
        <view class="figma-section__title">采集与分发</view>
        <view class="live-step"><view class="live-step__mark">1</view><view><view class="figma-row__title">核对设备</view><view class="figma-row__subtitle">摄像头和麦克风按需授权</view></view></view>
        <view class="live-step"><view class="live-step__mark">2</view><view><view class="figma-row__title">批准直播用途</view><view class="figma-row__subtitle">核对时长、费用上限与频道</view></view></view>
        <view class="live-step"><view class="live-step__mark">3</view><view class="live-step__copy"><view class="figma-row__title">核验外站开播</view><view class="figma-row__subtitle">逐渠道核对真实分发结果</view></view><view class="figma-status figma-status--orange">待核验</view></view>
      </view>

      <block wx:if="{{!session || session.desired === 'STOPPED'}}">
        <view class="figma-section live-preparation-form">
          <view class="figma-section__title">直播申请</view>
          <button class="live-channel-field" bindtap="toggleChannelPicker" disabled="{{busy || pending}}"><view class="figma-field-label">目标频道</view><view class="live-channel-field__value">{{selected.length ? '已选择 ' + selected.length + ' 个真实频道' : '选择当前已批准的真实频道'}}</view></button>
          <checkbox-group wx:if="{{channelsOpen}}" class="live-channel-picker" bindchange="selectChannels">
            <label wx:for="{{channels}}" wx:key="id" class="figma-check"><checkbox value="{{item.id}}" checked="{{item.selected}}" disabled="{{item.revoked || busy || pending || !capabilities.providerReady}}"/><text>{{item.label}} · {{item.platform}}</text></label>
            <view wx:if="{{!channels.length}}" class="figma-section__hint">暂无当前可用频道。</view>
          </checkbox-group>
          <label class="figma-field-group"><view class="figma-field-label">最长直播时长（分钟）</view><input class="figma-field-control" type="number" data-field="minutes" value="{{minutes}}" bindinput="input" disabled="{{busy || pending}}"/></label>
          <label class="figma-field-group"><view class="figma-field-label">费用上限（分，100 分 = 1 元）</view><input class="figma-field-control" type="number" data-field="budgetFen" value="{{budgetFen}}" bindinput="input" disabled="{{busy || pending}}"/></label>
        </view>

        <view class="figma-section recording-choice-card">
          <view class="figma-section__title">录像用途</view>
          <label class="live-record-choice"><switch checked="{{record}}" bindchange="setRecord" disabled="{{busy || pending}}"/><text>申请独立录制本场录像</text></label>
          <checkbox-group wx:if="{{record}}" bindchange="recordConsentChange"><label class="figma-check"><checkbox value="record" checked="{{recordConsent}}" disabled="{{busy || pending}}"/><text>本次申请包含录制；已核对费用与用途，并知晓仍需独立批准。</text></label></checkbox-group>
          <view wx:else class="figma-section__hint">本次创建不申请录制，不改变直播与频道的独立授权。</view>
        </view>

        <view class="figma-section capability-notice">
          <view class="figma-section__title">{{capabilities.providerReady ? '仍须独立批准' : '正式能力未开放'}}</view>
          <view class="figma-section__hint">{{capabilities.providerReady ? '创建后由独立有权管理者核对直播与录像用途，再显式开始采集。' : '当前不能开始新的采集；已有原操作仍可继续核对。'}}</view>
          <view wx:for="{{capabilities.blockers}}" wx:key="*this" class="live-blocker">{{item}}</view>
          <view class="live-create-actions"><button class="figma-action figma-action--navy" bindtap="create" disabled="{{busy || loading || pending || !selected.length || !capabilities.providerReady || (record && !recordConsent)}}">{{busy ? '正在提交…' : '创建待批准直播'}}</button></view>
        </view>
      </block>

      <view wx:if="{{session && session.desired !== 'STOPPED'}}" class="figma-section live-session-controls">
        <view class="figma-section__title">采集控制</view>
        <view class="figma-grid">
          <view class="figma-grid__item"><view class="figma-eyebrow">云端目标</view><view class="figma-row__title">{{session.desired}}</view></view>
          <view class="figma-grid__item"><view class="figma-eyebrow">当前观测</view><view class="figma-row__title">{{session.observed}}</view></view>
        </view>
        <view class="figma-section__hint">源代次 {{session.sourceEpoch}} · 最长 {{session.maximumSeconds}} 秒</view>
        <button wx:if="{{capabilities.canManage}}" class="figma-action figma-action--ghost" data-type="APPROVE" bindtap="action" disabled="{{busy || pending}}">批准直播与所选录像用途</button>
        <live-pusher id="basketball-source" url="{{pushUrl}}" mode="RTC" autopush="{{false}}" muted="{{false}}" enable-camera="{{true}}" auto-focus="{{true}}" bindstatechange="pusherState" binderror="pusherError"/>
        <view class="live-phone-state">{{phoneState}}</view>
        <button class="figma-action figma-action--orange" data-type="START" bindtap="action" disabled="{{busy || pending || !cameraReady || !capabilities.providerReady || (session.desired !== 'DRAFT' && session.desired !== 'PAUSED')}}">显式开始／恢复本机采集</button>
        <label class="figma-field-group"><view class="figma-field-label">暂停、停止或撤权说明</view><input class="figma-field-control" data-field="reason" value="{{reason}}" bindinput="input" placeholder="填写本次操作的真实原因" disabled="{{busy || pending}}"/></label>
        <view class="live-control-grid"><button class="figma-action figma-action--ghost" data-type="PAUSE" bindtap="action" disabled="{{busy || pending || session.desired !== 'RUNNING'}}">暂停并确认停流</button><button class="figma-action live-danger" data-type="STOP" bindtap="action" disabled="{{busy || pending}}">结束整场直播</button></view>
        <button wx:if="{{capabilities.canManage}}" class="figma-action live-danger" data-type="REVOKE" bindtap="action" disabled="{{busy || pending}}">撤销直播与录像授权</button>
        <view wx:for="{{session.targets}}" wx:key="channelId" class="live-target">
          <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{item.label}}</view><view class="figma-row__subtitle">外站平台状态须单独核验</view></view><view class="figma-status">{{item.stateText}}</view></view>
          <view class="live-control-grid"><button class="figma-action figma-action--ghost" data-type="STOP_TARGET" data-id="{{item.channelId}}" bindtap="target" disabled="{{busy || pending}}">停止该频道</button><button class="figma-action figma-action--ghost" data-type="RECONNECT_TARGET" data-id="{{item.channelId}}" bindtap="target" disabled="{{busy || pending || session.desired !== 'RUNNING' || item.state !== 'STOPPED'}}">显式重连</button></view>
        </view>
      </view>
    </block>

    <view class="figma-section live-safety-note"><view class="figma-section__hint">切到后台会停止本机采集并申请暂停。网络中断时由采集租约保护停流；结果未知时保留原频道占用，刷新不会自动恢复。</view></view>
  </view>

  <view class="figma-fixed-actions">
    <button class="figma-action figma-action--ghost" bindtap="media" disabled="{{busy || (!session && !figmaEnableMediaAction)}}">查看媒体作业</button>
    <button class="figma-action figma-action--orange" bindtap="load" disabled="{{loading || busy}}">{{loading ? '正在刷新…' : '刷新云端状态'}}</button>
  </view>
</view>
