.live-workspace { padding:16px 16px calc(24px + env(safe-area-inset-bottom)); }
.live-workspace .card { padding:16px; border:0; border-radius:16px; margin:12px 0; }
.live-workspace .subtitle { font-size:18px; line-height:28px; font-weight:700; }
.live-workspace .form-field { display:block; padding:12px; border:1px solid #e1e7ef; border-radius:12px; margin-top:12px; background:#fff; }
.live-workspace input { width:100%; min-height:44px; margin:4px 0 0; padding:4px 0; border:0; box-sizing:border-box; font-size:16px; line-height:24px; }
.live-workspace .channel-choice { display:flex; align-items:center; min-height:44px; padding:8px 0; overflow-wrap:anywhere; }
.live-workspace .record-choice { display:flex; gap:12px; align-items:flex-start; padding:16px 0; }
.live-workspace .record-choice text { flex:1; min-width:0; }
.live-workspace live-pusher { display:block; width:100%; height:200px; background:#18283f; border-radius:12px; margin:16px 0; }
.live-workspace .target { border-top:1px solid #e1e7ef; padding-top:16px; margin-top:16px; }
.live-workspace button { margin-top:12px; min-height:48px; font-size:16px; white-space:normal; overflow-wrap:anywhere; }
