@import "../../styles/figma-pages.wxss";

.live-hero { width:100%; height:174px; overflow:hidden; border-radius:16px; background:#123c73; }
.live-hero__image { display:block; width:100%; height:117px; }
.live-hero__title { display:flex; height:57px; align-items:center; padding:0 14px; color:#fff; font-size:18px; font-weight:700; line-height:26px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.live-tabs { display:flex; width:100%; min-height:48px; padding:2px 3px; border-radius:12px; background:#fff; }
.live-tab { display:flex; min-width:0; min-height:44px; flex:1; align-items:center; justify-content:center; margin:0; padding:0 8px; border-radius:10px; background:#fff; color:#51657d; font-size:13px; line-height:19px; }
.live-tab::after { border:0; }
.live-tab.is-active { background:#123c73; color:#fff; font-weight:700; }
.live-step { display:flex; width:100%; min-height:55px; align-items:center; gap:8px; }
.live-step__mark { display:flex; width:20px; height:20px; flex:none; align-items:center; justify-content:center; border-radius:10px; background:#eaf2fc; color:#123c73; font-size:11px; font-weight:700; line-height:16px; }
.live-step__copy { min-width:0; flex:1; }
.live-channel-field { display:block; width:100%; min-height:64px; margin:0; padding:8px 12px; border:1px solid #7c8ea5; border-radius:12px; background:#fff; color:#18283f; text-align:left; }
.live-channel-field::after { border:0; }
.live-channel-field__value { margin-top:4px; color:#51657d; font-size:13px; line-height:20px; }
.live-channel-picker { display:flex; width:100%; flex-direction:column; gap:4px; padding:8px 0; }
.live-record-choice { display:flex; min-height:44px; align-items:center; gap:10px; color:#18283f; font-size:14px; line-height:22px; }
.live-blocker { padding:8px 10px; border-radius:10px; background:#fff1e2; color:#18283f; font-size:12px; line-height:18px; }
.live-create-actions { width:100%; margin-top:4px; }
.live-session-controls live-pusher { display:block; width:100%; height:200px; margin:4px 0; border-radius:12px; background:#18283f; }
.live-phone-state { padding:10px 12px; border-radius:10px; background:#f4f6fa; color:#51657d; font-size:12px; line-height:18px; }
.live-control-grid { display:grid; width:100%; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
.live-danger { border:1px solid #c83f42; background:#fff; color:#c83f42; }
.live-target { padding-top:8px; border-top:1px solid #e6ebf2; }
.live-safety-note { margin-bottom:0; }

@media (max-width:360px) {
  .live-tab { padding:0 4px; font-size:12px; }
  .live-control-grid { grid-template-columns:minmax(0,1fr); }
}
