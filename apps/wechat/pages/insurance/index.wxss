.insurance-workspace { padding-bottom:calc(104px + env(safe-area-inset-bottom)); }
.insurance-workspace .card { margin:12px 0; padding:16px; border-radius:16px; }
.insurance-workspace .small,.insurance-workspace .muted { overflow-wrap:anywhere; }
.insurance-workspace button { min-height:48px; font-size:16px; }
.insurance-workspace .subtitle { font-weight:700; }
.insurance-workspace .status-banner { margin:8px 0; }
.insurance-summary { color:#18283f; }
.insurance-summary-icon { display:flex; align-items:center; justify-content:center; flex:0 0 44px; width:44px; height:44px; border-radius:12px; background:#eaf2fc; }
.insurance-summary-icon image { width:25px; height:25px; }
.insurance-tabs { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1px; min-height:44px; margin-bottom:12px; padding:0 3px; border-radius:12px; background:#fff; }
.insurance-tabs button { min-width:0; height:44px; min-height:44px; margin:0; padding:0 8px; border-radius:10px; background:#fff; color:#63758b; font-size:14px; line-height:20px; font-weight:400; }
.insurance-tabs button::after { border:0; }
.insurance-tabs button.selected { color:#fff; background:#123c73; font-weight:700; }
.insurance-options-card { padding:14px !important; }
.insurance-option { display:flex; align-items:center; gap:10px; min-height:62px; padding:6px 0; }
.insurance-option + .insurance-option { border-top:1px solid #e6ebf2; }
.insurance-radio { flex:0 0 18px; width:18px; height:18px; border:1px solid #8aa0b8; border-radius:50%; }
.insurance-option-copy { flex:1; min-width:0; }
.insurance-option-copy .subtitle { margin:0; font-size:16px; line-height:24px; }
.insurance-option-action { width:100%; margin:4px 0 10px !important; }
.muted-pill { background:#f2f4f7; color:#63758b; }
@media (max-width:360px) { .fig-actions button { padding-left:6px; padding-right:6px; font-size:13px; } }
