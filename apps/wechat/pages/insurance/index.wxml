<web-view wx:if="{{checkoutUrl}}" src="{{checkoutUrl}}" bindmessage="returnFromCheckout"/>
<view wx:else class="page">
 <scb-header title="保险与保障"/>
 <view wx:if="{{error}}" class="notice warning">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view>
 <view class="notice">保费由实际保险服务方收取。付款、出单、保障有效与报名通过分别判断；已有有效外部保险无需重复购买。</view>
 <view wx:if="{{pending}}" class="card"><view class="subtitle">原请求结果待核对</view><view class="small">保留原编号与原内容，不重新创建投保或退保。</view><button class="primary" bindtap="recover" disabled="{{busy}}">核对并恢复原请求</button></view>
 <view wx:if="{{workspace && !workspace.enabled}}" class="notice warning">{{workspace.reason}}</view>
 <button wx:if="{{orgId && entryId}}" class="secondary" bindtap="qualification" disabled="{{busy}}">身份、照片与签署独立资格预审</button>
 <view wx:for="{{workspace.products}}" wx:key="id" class="card"><view class="subtitle">{{item.name}}</view><view>{{item.insurer}}</view><view class="small">条款版本：{{item.termsVersion}} · {{item.basketballCovered ? '包含篮球活动保障' : '不满足篮球保障要求'}}</view><view class="small">产品条款：{{item.termsUrl}}</view><button class="secondary" data-id="{{item.id}}" bindtap="terms" disabled="{{busy || pending}}">阅读服务方产品条款</button><button class="secondary" data-id="{{item.id}}" bindtap="select" disabled="{{busy || pending || !item.basketballCovered}}">{{selectedProduct===item.id ? '已选产品' : '选择此产品'}}</button></view>
 <button wx:if="{{workspace.enabled && entryId && memberId}}" class="primary" bindtap="quote" disabled="{{busy || pending || !selectedProduct}}">按本人当前资料与赛事日期申请报价</button>
 <view wx:if="{{quote}}" class="card"><view class="subtitle">服务方当前报价</view><view>保费 {{quote.premiumFen}} 分 CNY</view><view>{{quote.coverageStartDate}} 至 {{quote.coverageEndDate}}</view><view class="small">到期：{{quote.expiresAt}}</view><view class="notice small">真正投保前须独立资格预审及必要监护确认通过。</view><button class="secondary" bindtap="consent" disabled="{{busy || pending}}">{{consent ? '已明确同意投保条款和本次资料用途' : '阅读产品条款后，明确同意本次投保'}}</button><button class="primary" bindtap="purchase" disabled="{{busy || pending || !consent}}">确认本次报价并创建投保申请</button></view>
 <view wx:for="{{workspace.orders}}" wx:key="id" class="card"><view class="subtitle">本届投保记录</view><view>支付：{{item.paymentStatus}} · 保单：{{item.policyStatus}}</view><view>保费 {{item.premiumFen}} 分 · {{item.coverageStartDate}} 至 {{item.coverageEndDate}}</view><view wx:if="{{item.maskedPolicyNumber}}">保单号 {{item.maskedPolicyNumber}}</view><view class="small">最近服务方核实：{{item.verifiedAt || '尚未核实'}}</view><view wx:if="{{!item.currentMaterial}}" class="notice warning">本人资料版本已改变，旧保单不能自动通过当前资格。</view><view wx:if="{{item.pendingOperation}}" class="small">原操作结果尚未确认。<text wx:if="{{item.canRefresh}}">自动核对已暂停，可点击查询原单继续核对；不会重复投保或退保。</text><text wx:else>请等待核对。</text></view><button class="secondary" data-id="{{item.id}}" data-type="REFRESH" bindtap="command" disabled="{{busy || pending || !item.canRefresh}}">向服务方查询原单</button><button wx:if="{{item.paymentStatus==='UNPAID' || item.paymentStatus==='PENDING'}}" class="primary" data-id="{{item.id}}" bindtap="checkout" disabled="{{busy || pending}}">在保险服务方付款</button><button wx:if="{{item.canDownloadDocument}}" class="secondary" data-id="{{item.id}}" bindtap="document" disabled="{{busy || pending}}">查看私有保单 PDF</button><view wx:if="{{item.canDownloadDocument}}" class="small">历史保单文件仅供记录，当前保障以最新查单结果为准。</view><button class="secondary" data-id="{{item.id}}" data-type="REQUEST_CANCELLATION" bindtap="command" disabled="{{busy || pending || !item.canRequestCancellation}}">明确申请退保</button></view>
 <button class="secondary" bindtap="load" disabled="{{busy || loading}}">重新读取</button>
</view>
