<scb-header title="保险与保障" disabled="{{busy}}"/>
<web-view wx:if="{{checkoutUrl}}" src="{{checkoutUrl}}" bindmessage="returnFromCheckout"/>
<view wx:else class="page has-actions insurance-workspace ui002-workspace">
 <view class="page-intro"><view class="eyebrow">赛事保障</view><view class="title">两种办理方式</view><view class="muted">购买保险与参赛资格分别审核。已持有效保单，无需重复购买。</view></view>
 <scb-steps items="{{workflowSteps}}" current="{{activeSection}}" busy="{{busy}}" bindchange="changeSection"/>
 <scb-state wx:if="{{loading}}" kind="loading" title="正在读取本人保障记录" description="付款、承保与本届资格分别核对。"/>
 <view id="insurance-options"/>
 <view wx:if="{{error}}" class="notice warning">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view>
 <view class="notice">保费由实际保险服务方收取。付款、出单、保障有效与报名通过分别判断；已有有效外部保险无需重复购买。</view>
 <view wx:if="{{pending}}" class="card"><view class="subtitle">原请求结果待核对</view><view class="small">保留原编号与原内容，不重新创建投保或退保。</view><button class="primary" bindtap="recover" disabled="{{busy}}">核对并恢复原请求</button></view>
 <scb-state wx:if="{{workspace && !workspace.enabled}}" kind="closed" title="在线投保暂未开放" description="服务主体与销售模式确认后开放。未成年人在线投保尚未开放；已有保单仍可提交赛事审核。"/>
 <view wx:if="{{workspace && !workspace.enabled && workspace.reason}}" class="small muted">{{workspace.reason}}</view>
 <button wx:if="{{workspace.providerEntryUrl}}" class="primary" bindtap="providerEntry" disabled="{{busy || pending}}">前往已审核保险服务方办理</button>
 <button wx:if="{{orgId && entryId}}" class="secondary" bindtap="externalPolicy" disabled="{{busy}}">提交已有外部保单审核</button>
 <button wx:if="{{orgId && entryId}}" class="secondary" bindtap="qualification" disabled="{{busy}}">身份、照片与签署独立资格预审</button>
 <view id="insurance-quote" class="section-label">产品与本次报价</view>
 <view wx:for="{{workspace.products}}" wx:key="id" class="card"><view class="subtitle">{{item.name}}</view><view>{{item.insurer}}</view><view class="small">条款版本：{{item.termsVersion}} · {{item.basketballCovered ? '仅适用于已审核赛事、年龄与保障范围' : '不满足篮球保障要求'}}</view><view class="small">产品条款：{{item.termsUrl}}</view><button class="secondary" data-id="{{item.id}}" bindtap="terms" disabled="{{busy || pending}}">阅读服务方产品条款</button><button class="secondary" data-id="{{item.id}}" bindtap="select" disabled="{{busy || pending || !item.basketballCovered}}">{{selectedProduct===item.id ? '已选产品' : '选择此产品'}}</button></view>
 <button wx:if="{{workspace.enabled && entryId && memberId}}" class="primary" bindtap="quote" disabled="{{busy || pending || !selectedProduct}}">按本人当前资料与赛事日期申请报价</button>
 <view wx:if="{{quote}}" class="card"><view class="subtitle">服务方当前报价</view><view>保费 {{quote.premiumFen}} 分 CNY</view><view>{{quote.coverageStartDate}} 至 {{quote.coverageEndDate}}</view><view class="small">到期：{{quote.expiresAt}}</view><view class="notice small">真正投保前须独立资格预审及必要监护确认通过。</view><button class="secondary" bindtap="consent" disabled="{{busy || pending}}">{{consent ? '已明确同意投保条款和本次资料用途' : '阅读产品条款后，明确同意本次投保'}}</button><button class="primary" bindtap="purchase" disabled="{{busy || pending || !consent || !workspace.enabled}}">确认本次报价并创建投保申请</button></view>
 <view id="insurance-records" class="section-label">本届投保与原单进度</view>
 <scb-state wx:if="{{workspace && !workspace.orders.length && !loading}}" kind="empty" title="本届暂无在线投保记录" description="已有外部保单可从上方入口提交；没有记录不等于参赛资格已通过。"/>
 <view wx:for="{{workspace.orders}}" wx:key="id" class="card"><view class="subtitle">本届投保记录</view><view class="status-banner">支付：{{paymentLabels[item.paymentStatus] || item.paymentStatus}} · 保单：{{policyLabels[item.policyStatus] || item.policyStatus}}</view><view>保费 {{item.premiumFen}} 分 · {{item.coverageStartDate}} 至 {{item.coverageEndDate}}</view><view wx:if="{{item.maskedPolicyNumber}}">保单号 {{item.maskedPolicyNumber}}</view><view class="small">最近服务方核实：{{item.verifiedAt || '尚未核实'}}</view><view wx:if="{{!item.currentMaterial}}" class="notice warning">本人资料版本已改变，旧保单不能自动通过当前资格。</view><view wx:if="{{item.reconciliationRequired}}" class="notice warning">自动核对次数已用完，原单结果仍未知。请查询原单或联系平台核对，勿重复购买。</view><view wx:if="{{item.pendingOperation}}" class="small">原操作结果尚未确认。<text wx:if="{{item.canRefresh}}">自动核对已暂停，可点击查询原单继续核对；不会重复投保或退保。</text><text wx:else>请等待核对。</text></view><button class="secondary" data-id="{{item.id}}" data-type="REFRESH" bindtap="command" disabled="{{busy || pending || !item.canRefresh}}">向服务方查询原单</button><button wx:if="{{item.paymentStatus==='UNPAID' || item.paymentStatus==='PENDING'}}" class="primary" data-id="{{item.id}}" bindtap="checkout" disabled="{{busy || pending || !workspace.enabled}}">在保险服务方付款</button><button wx:if="{{item.canDownloadDocument}}" class="secondary" data-id="{{item.id}}" bindtap="document" disabled="{{busy || pending}}">查看私有保单 PDF</button><view wx:if="{{item.canDownloadDocument}}" class="small">历史保单文件仅供记录，当前保障以最新查单结果为准。</view><button class="secondary" data-id="{{item.id}}" data-type="REQUEST_CANCELLATION" bindtap="command" disabled="{{busy || pending || !item.canRequestCancellation}}">明确申请退保</button></view>
 <button class="secondary" bindtap="load" disabled="{{busy || loading}}">重新读取</button>
 <view wx:if="{{workspace}}" class="fixed-actions"><button class="primary" bindtap="showRecords" disabled="{{busy}}">查看已有保单办理</button></view>
</view>
