@import "../../styles/figma-pages.wxss";

.center-tabs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1px; height:48px; padding:2px 3px; border-radius:12px; background:#fff; }
.center-tab { display:flex; height:44px; align-items:center; justify-content:center; border-radius:10px; color:#51657d; font-size:13px; }
.center-tab.is-active { background:#123c73; color:#fff; font-weight:700; }
.player-center-rebuild .center-tabs>button.center-tab { width:100%; min-width:0; max-width:none; height:44px; min-height:44px; margin:0; padding:0 4px; border:0; justify-self:stretch; box-sizing:border-box; background:transparent; }
.player-center-rebuild .center-tabs>button.center-tab.is-active { background:#123c73; color:#fff; }
.display-field { display:grid; min-height:70px; grid-template-columns:minmax(0,1fr) auto; gap:4px 8px; align-items:center; padding:10px 12px; border:1px solid #7c8ea5; border-radius:12px; }
.display-field .figma-field-label { grid-column:1/-1; }
.display-field__value { min-width:0; font-size:16px; line-height:24px; overflow-wrap:anywhere; }
.fee-row { display:flex; min-height:64px; align-items:center; justify-content:space-between; gap:12px; border-bottom:1px solid #e6ebf2; }
.fee-row:last-child { border-bottom:0; }
.fee-value { color:#123c73; font-size:16px; font-weight:700; line-height:24px; }
.pending-state { display:flex; flex-direction:column; gap:10px; padding:18px 14px; border-radius:16px; background:#fff1e2; }
.form-pair,.window-pair { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
.picker-control { display:flex; align-items:center; }
.quote-preview,.window-card { display:flex; flex-direction:column; gap:8px; padding:10px; border-radius:10px; background:#f4f6fa; }
.section-heading { display:flex; align-items:center; justify-content:space-between; gap:8px; }
.section-link { min-width:44px; min-height:44px; color:#123c73; font-size:13px; text-align:right; }
.player-center-rebuild .figma-fixed-actions .figma-action:first-child { padding-right:8px; padding-left:8px; }
@media (max-width:360px) { .form-pair,.window-pair { grid-template-columns:1fr; } }
