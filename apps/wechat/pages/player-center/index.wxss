.center-hero { display:flex; flex-direction:column; gap:12px; padding:24px; }
.center-hero .title { margin:0; }
.center-card { display:flex; flex-direction:column; gap:8px; }
.center-card .subtitle { margin:0; }
.center-copy { color:#63758b; font-size:14px; line-height:24px; }
.center-link { margin-bottom:16px; }
.notice-title { font-size:14px; line-height:24px; font-weight:500; margin-bottom:4px; }
.profile-fields { margin-bottom:16px; }
.profile-field { margin:0 0 16px; }
.profile-fields .field-label { color:#18283f; }
.profile-fields .field { margin:4px 0 0; }
.editor-pair { display:flex; gap:8px; align-items:stretch; }
.editor-pair > input,.editor-pair > picker { flex:1; width:0; min-width:0; }
.editor-pair > .height-field { flex:0 0 88px; width:88px; }
.editor-pair > picker { margin-top:4px; }
.availability-row { border-top:1px solid #e1e7ef; padding-top:16px; margin-top:16px; }
.availability-row .row-between > button { flex:0 0 64px; width:64px; margin:0; }
.window-pair { display:flex; gap:8px; margin-top:8px; }
.window-pair picker { flex:1; min-width:0; }
.picker-value { min-height:44px; font-size:14px; line-height:24px; padding:9px 12px; border:1px solid #e1e7ef; border-radius:8px; background:white; }
.profile-bio { min-height:88px; height:auto; width:100%; box-sizing:border-box; }
.profile-subnote { margin-top:8px; }
.field-help { margin-top:4px; }
.profile-consent { border-radius:0; margin:0 0 16px; font-weight:500; }
.profile-consent checkbox { flex-shrink:0; }

.pricing-fields .profile-field { margin:0 0 16px; }
.pricing-fields .field-label { color:#18283f; }
.pricing-fields .field { margin:4px 0 0; }
.center-tabs { display:flex; gap:1px; margin-bottom:12px; padding:2px 3px; border-radius:12px; background:#fff; }
.center-tabs button { flex:1; width:auto; min-width:0; min-height:44px; margin:0; padding:8px; border-radius:10px; background:transparent; color:#63758b; font-size:13px; line-height:24px; font-weight:400; }
.center-tabs button::after { border:0; }
.center-tabs .active { background:#123c73; color:#fff; font-weight:700; }
.center-design-card { gap:0; padding:14px; border-radius:16px; box-shadow:none; }
.center-field { position:relative; min-height:66px; padding:8px 68px 8px 10px; border-radius:10px; background:#f4f6fa; margin-top:8px; }
.center-field .field-label { margin:0 0 4px; }
.center-field-value { color:#18283f; font-size:14px; line-height:22px; overflow-wrap:anywhere; }
.center-state { flex:none; padding:4px 7px; border-radius:7px; background:#fff1e2; color:#18283f; font-size:11px; line-height:16px; }
.center-field > .center-state { position:absolute; top:50%; right:8px; transform:translateY(-50%); }
.center-bill { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:64px; padding:8px 0; border-top:1px solid #e6ebf2; }
.center-bill:nth-child(2) { border-top:0; }
.center-bill > view:first-child { flex:1; min-width:0; }
.center-amount { flex:none; color:#123c73; font-size:16px; line-height:24px; font-weight:700; white-space:nowrap; }
.center-window { display:flex; align-items:center; gap:8px; min-height:55px; padding:8px 0; border-top:1px solid #e6ebf2; color:#18283f; font-size:13px; line-height:20px; }
.center-window > view:nth-child(2) { flex:1; min-width:0; overflow-wrap:anywhere; }
.center-card-action { margin:8px 0 0; }
.center-secondary-links,.center-status-tools { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:12px; }
.center-secondary-links button,.center-status-tools button { flex:1 1 140px; width:auto; min-width:0; margin:0; }
.center-availability-status { display:inline-block; align-self:flex-start; margin-bottom:8px; padding:4px 8px; border-radius:8px; background:#eaf2fc; color:#123c73; font-size:12px; line-height:18px; }
@media(max-width:360px) { .center-amount { font-size:14px; white-space:normal; text-align:right; } .center-field { padding-right:62px; } }
