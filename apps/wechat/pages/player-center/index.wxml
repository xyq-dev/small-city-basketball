<scb-header title="我的球员中心" disabled="{{busy || pending || dirty}}"/>
<view class="scb-ui-page figma-page player-center-rebuild">
  <view class="figma-page__content figma-page__content--actions">
    <figma-skeleton wx:if="{{loading}}" rows="4"/>
    <figma-feedback wx:if="{{error}}" type="error" title="本人资料需要重新核对" body="{{error}}" action-label="重新读取" bind:action="refresh"/>
    <figma-feedback wx:if="{{message}}" type="info" title="处理结果" body="{{message}}"/>
    <figma-feedback wx:if="{{loginRequired}}" type="permission" title="登录后管理本人服务资料" body="不会根据姓名猜测球员账号，也不会展示其他账号的私有资料。" action-label="登录并返回" bind:action="login"/>

    <block wx:if="{{authorized}}">
      <block wx:if="{{profile && !editing}}">
        <view class="figma-summary figma-summary--navy"><view class="figma-summary__copy"><view class="figma-eyebrow">本人服务档案</view><view class="figma-title">{{profile.displayName}}</view><view class="figma-subtitle">服务资料、报价与可约窗口由本人维护。</view></view></view>
        <view class="center-tabs"><button class="center-tab is-active">资料</button><button class="center-tab" data-section="FEES" bindtap="edit">报价</button><button class="center-tab" data-section="AVAILABILITY" bindtap="edit">可约时间</button></view>

        <figma-feedback wx:if="{{profile.status === 'PENDING'}}" type="info" title="资料已提交，等待审核" body="待审核期间不进入可约公开目录；提交成功不代表实名、保险或参赛资格已核验。"/>
        <figma-feedback wx:elif="{{profile.status === 'REJECTED'}}" type="error" title="当前资料不能公开预约" body="{{profile.reviewReason || '暂无审核意见，请刷新后核对。'}}"/>
        <figma-feedback wx:elif="{{profile.status === 'DISABLED'}}" type="info" title="服务档案已停用" body="停止公开预约资料和公开统计；已有合作仍按实际状态与权限处理。"/>

        <view class="figma-section">
          <view class="figma-section__title">本人服务资料</view>
          <view class="display-field"><view class="figma-field-label">显示名称与位置</view><view class="display-field__value">{{profile.displayName}} · {{profile.positionText}}</view><view class="figma-status figma-status--orange">可编辑</view></view>
          <view class="display-field"><view class="figma-field-label">服务地区</view><view class="display-field__value">{{profile.city}}</view><view class="figma-status figma-status--orange">可编辑</view></view>
          <view class="display-field"><view class="figma-field-label">服务介绍</view><view class="display-field__value">{{profile.bio || '暂未填写'}}</view><view class="figma-status figma-status--orange">可编辑</view></view>
        </view>

        <view class="figma-section"><view class="figma-section__title">当前报价</view><view class="fee-row"><view><view class="figma-row__title">参赛服务费</view><view class="figma-row__subtitle">每场</view></view><view class="fee-value">{{profile.priceText}}</view></view><view class="fee-row"><view><view class="figma-row__title">交通与食宿</view><view class="figma-row__subtitle">{{profile.travelSummary || '以当前服务资料为准'}}</view></view><view class="fee-value">{{profile.travelText || (quote.travel + ' + ' + quote.accommodation)}}</view></view></view>

        <view class="figma-section"><view class="figma-section__title">可约窗口</view><view wx:for="{{form.availability}}" wx:key="key" class="figma-row"><figma-icon name="schedule" size="20"/><view class="figma-row__copy"><view class="figma-row__title">{{item.displayDate || item.startDate}}</view><view class="figma-row__subtitle">{{item.startTime}}–{{item.endTime}}</view></view><view class="figma-status {{profile.status === 'APPROVED' ? 'figma-status--orange' : ''}}">{{profile.status === 'APPROVED' ? '北京时间' : '未公开'}}</view></view><view wx:if="{{!form.availability.length}}" class="figma-caption">暂未设置可约窗口。</view></view>

        <view class="figma-section"><view class="figma-section__title">本人服务</view><button class="figma-row" data-section="PROFILE" bindtap="edit"><view class="figma-row__copy"><view class="figma-row__title">编辑资料与报价</view><view class="figma-row__subtitle">修改后按当前状态重新提交或更新</view></view></button><button class="figma-row" bindtap="received"><view class="figma-row__copy"><view class="figma-row__title">查看收到的预约</view><view class="figma-row__subtitle">只处理本人逐场安排</view></view></button><button class="figma-row" bindtap="performance"><view class="figma-row__copy"><view class="figma-row__title">我的比赛数据授权</view><view class="figma-row__subtitle">逐项决定有限公开范围</view></view></button><view class="figma-caption">可约不等于保证到场；删除窗口不会取消已经接受的预约。在线支付与个人分账未开放。</view></view>
      </block>

      <block wx:if="{{editing}}">
        <view class="figma-summary"><view class="figma-summary__icon"><figma-icon name="player" size="28"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">本人维护</view><view class="figma-title">编辑球员服务档案</view><view class="figma-subtitle">资料、报价与可约时间分别核对后统一保存。</view></view></view>
        <view class="center-tabs"><button class="center-tab {{editorSection === 'PROFILE' ? 'is-active' : ''}}" data-section="PROFILE" bindtap="editSection">资料</button><button class="center-tab {{editorSection === 'FEES' ? 'is-active' : ''}}" data-section="FEES" bindtap="editSection">报价</button><button class="center-tab {{editorSection === 'AVAILABILITY' ? 'is-active' : ''}}" data-section="AVAILABILITY" bindtap="editSection">可约时间</button></view>

        <view wx:if="{{pending}}" class="pending-state"><view class="figma-title">提交结果待核对</view><view class="figma-caption">遇到断网或版本冲突，当前内容已锁定。使用原编号继续核对，不自动重发或另建提交。</view><view class="figma-grid"><view class="figma-grid__item"><view class="figma-row__title">本地草稿</view><view class="figma-row__subtitle">当前编辑版本</view><view class="figma-status figma-status--orange">已保留</view></view><view class="figma-grid__item"><view class="figma-row__title">服务器资料</view><view class="figma-row__subtitle">恢复连接后重读</view><view class="figma-status">待核对</view></view></view></view>

        <view wx:if="{{editorSection === 'PROFILE'}}" class="figma-section">
          <view class="figma-section__title">本人服务资料</view>
          <view class="form-pair"><view class="figma-field-group"><view class="figma-field-label">显示名称</view><input class="figma-field-control" value="{{form.displayName}}" maxlength="40" data-field="displayName" bindinput="input" disabled="{{busy || pending}}" placeholder="本人显示名称"/></view><view class="figma-field-group"><view class="figma-field-label">位置</view><picker range="{{positions}}" value="{{positionIndex}}" bindchange="position" disabled="{{busy || pending}}"><view class="figma-field-control picker-control">{{positions[positionIndex]}}</view></picker></view></view>
          <view class="form-pair"><view class="figma-field-group"><view class="figma-field-label">身高（厘米）</view><input class="figma-field-control" type="number" value="{{form.heightCm}}" maxlength="3" data-field="heightCm" bindinput="input" disabled="{{busy || pending}}" placeholder="120–250"/></view><view class="figma-field-group"><view class="figma-field-label">服务地区</view><input class="figma-field-control" value="{{form.city}}" maxlength="60" data-field="city" bindinput="input" disabled="{{busy || pending}}" placeholder="例如高州 / 石鼓"/></view></view>
          <view class="figma-field-group"><view class="figma-field-label">服务介绍</view><textarea class="figma-field-control" value="{{form.bio}}" maxlength="500" data-field="bio" bindinput="input" disabled="{{busy || pending}}" placeholder="说明打法与服务范围；不要填写证件或联系方式"/></view>
          <view class="figma-caption">本人填写，不作为实力认证；本次声明不是身份证自动核验。</view>
          <checkbox-group bindchange="consent"><label class="figma-check"><checkbox value="yes" checked="{{form.adultConfirmed}}" disabled="{{busy || pending}}"/>本人已成年，并确认上述资料真实</label></checkbox-group>
        </view>

        <view wx:elif="{{editorSection === 'FEES'}}" class="figma-section">
          <view class="figma-section__title">当前报价</view>
          <view class="figma-field-group"><view class="figma-field-label">参赛服务费（元 / 场）</view><input class="figma-field-control" type="digit" value="{{form.price}}" data-field="price" bindinput="input" disabled="{{busy || pending}}"/></view>
          <view class="figma-field-group"><view class="figma-field-label">交通费（元）</view><input class="figma-field-control" type="digit" value="{{form.travel}}" data-field="travel" bindinput="input" disabled="{{busy || pending}}"/></view>
          <view class="figma-field-group"><view class="figma-field-label">食宿费（元）</view><input class="figma-field-control" type="digit" value="{{form.accommodation}}" data-field="accommodation" bindinput="input" disabled="{{busy || pending}}"/></view>
          <view wx:if="{{quote}}" class="quote-preview"><view class="figma-row__title">报价预览</view><view class="figma-caption">参赛 {{quote.service}} · 平台 {{quote.platform}}（费率 {{feeText}}）· 交通 {{quote.travel}} · 食宿 {{quote.accommodation}} · 含费 {{quote.total}}</view></view>
          <figma-feedback type="info" title="价格变动不改旧单" body="新报价需重新审阅；既有订单保留原报价和费率快照。"/>
          <checkbox-group bindchange="consent"><label class="figma-check"><checkbox value="yes" checked="{{form.adultConfirmed}}" disabled="{{busy || pending}}"/>本人已成年，并确认完整服务资料与报价真实</label></checkbox-group>
        </view>

        <view wx:else class="figma-section">
          <view class="figma-section__title">可约时间 · 北京时间</view><view class="figma-caption">填写 1 至 60 个不重叠窗口；单段最多 31 天。</view>
          <view wx:for="{{form.availability}}" wx:key="key" class="window-card"><view class="section-heading"><view class="figma-row__title">可约窗口 {{index + 1}}</view><button class="section-link" bindtap="removeWindow" data-index="{{index}}" disabled="{{busy || pending}}">删除</button></view><view class="window-pair"><picker mode="date" value="{{item.startDate}}" bindchange="windowInput" data-field="startDate" data-index="{{index}}" disabled="{{busy || pending}}"><view class="figma-field-control picker-control">{{item.startDate}}</view></picker><picker mode="time" value="{{item.startTime}}" bindchange="windowInput" data-field="startTime" data-index="{{index}}" disabled="{{busy || pending}}"><view class="figma-field-control picker-control">{{item.startTime}}</view></picker></view><view class="figma-caption">至</view><view class="window-pair"><picker mode="date" value="{{item.endDate}}" bindchange="windowInput" data-field="endDate" data-index="{{index}}" disabled="{{busy || pending}}"><view class="figma-field-control picker-control">{{item.endDate}}</view></picker><picker mode="time" value="{{item.endTime}}" bindchange="windowInput" data-field="endTime" data-index="{{index}}" disabled="{{busy || pending}}"><view class="figma-field-control picker-control">{{item.endTime}}</view></picker></view></view>
          <button class="figma-action figma-action--ghost" bindtap="addWindow" disabled="{{busy || pending || form.availability.length >= 60}}">添加可约时间段</button>
          <view class="figma-caption">修改窗口不会取消已有合作；接单仍核验已有订单和场后 30 分钟交通缓冲。</view>
          <checkbox-group bindchange="consent"><label class="figma-check"><checkbox value="yes" checked="{{form.adultConfirmed}}" disabled="{{busy || pending}}"/>本人已成年，并确认完整资料与可约时间真实</label></checkbox-group>
        </view>
      </block>
    </block>

    <figma-feedback wx:if="{{!loading && !authorized && !loginRequired}}" type="permission" title="当前无法管理本人资料" body="核对当前账号与访问权限后重新读取，不展示其他账号的服务档案。" action-label="重新读取" bind:action="refresh"/>
  </view>

  <view class="figma-fixed-actions">
    <block wx:if="{{editing}}"><button class="figma-action figma-action--ghost" bindtap="cancelEdit" disabled="{{busy || pending}}">返回本人资料</button><button class="figma-action figma-action--orange" bindtap="save" disabled="{{busy || pendingInFlight || (!pending && !form.adultConfirmed)}}">{{busy ? '正在保存…' : pending ? '重新读取核对' : '保存并提交资料'}}</button></block>
    <block wx:elif="{{profile}}"><button class="figma-action figma-action--ghost" bindtap="received">查看收到的预约</button><button class="figma-action figma-action--orange" data-section="PROFILE" bindtap="edit" disabled="{{busy || pending}}">{{profile.status === 'REJECTED' ? '修改并重新提交' : '编辑资料与报价'}}</button></block>
    <block wx:else><button class="figma-action figma-action--ghost" bindtap="account">返回我的</button><button class="figma-action figma-action--orange" bindtap="refresh" disabled="{{loading}}">重新读取</button></block>
  </view>
</view>
