<view class="page has-actions">
  <view wx:if="{{loading}}" class="notice">正在核对当前账号与本人资料…</view>
  <view wx:if="{{error}}" class="notice danger" role="alert">{{error}}</view>
  <view wx:if="{{message}}" class="notice">{{message}}</view>
  <view wx:if="{{loginRequired}}" class="card empty">
    <view class="title">登录后管理本人服务资料</view><view class="muted">不会根据姓名猜测球员账号，也不会展示其他账号的私有资料。</view>
    <button class="primary" bindtap="login">登录并返回球员中心</button>
  </view>
  <block wx:if="{{authorized}}">
    <block wx:if="{{profile && !editing}}">
      <block wx:if="{{profile.status === 'PENDING'}}">
        <view class="hero center-hero"><view class="title">资料已提交</view><view>等待平台审核服务资料</view></view>
        <view class="card center-card"><view class="subtitle">当前状态</view><view class="center-copy">{{profile.displayName}} · {{profile.statusText}}</view><view class="center-copy">待审核期间不进入可约公开广场</view><view class="center-copy">提交成功不代表实名、保险或参赛资格已核验</view></view>
        <view class="card center-card"><view class="subtitle">可继续操作</view><view class="center-copy">按当前权限核对本人资料与已有预约</view><view class="center-copy">审核结果以刷新后状态为准</view></view>
        <button class="secondary" bindtap="edit">编辑本人资料与报价</button>
      </block>
      <block wx:elif="{{profile.status === 'REJECTED'}}">
        <view class="notice warning"><view class="notice-title">当前资料不能公开预约</view><view class="small">请以实际审核意见或停用状态为准。</view></view>
        <view class="card center-card"><view class="subtitle">审核意见</view><view class="center-copy">{{profile.reviewReason || '暂无审核意见，请刷新后核对。'}}</view><view class="small muted">{{profile.displayName}} · {{profile.statusText}}</view></view>
        <view class="card center-card"><view class="subtitle">修改后重新提交</view><view class="center-copy">补充本人服务资料、报价和可约窗口，再明确确认声明。</view></view>
      </block>
      <block wx:elif="{{profile.status === 'DISABLED'}}">
        <view class="notice warning"><view class="notice-title">服务档案已停用</view><view class="small">停止公开预约资料和公开统计，不以旧页面继续展示。</view></view>
        <view class="card center-card"><view class="subtitle">已有合作</view><view class="center-copy">订单仍按实际状态与当前权限处理</view><view class="center-copy">停用档案不自动取消已有约定</view></view>
        <view class="card center-card"><view class="subtitle">后续处理</view><view class="center-copy">{{profile.reviewReason || '核对停用原因，并按平台流程处理。'}}</view><view class="center-copy">不把刷新成功视为资料重新上架</view></view>
        <button class="secondary" bindtap="edit">查看并编辑本人服务资料</button>
      </block>
      <block wx:else>
        <view class="hero center-hero"><view class="title">{{profile.displayName}} · {{profile.positionText}}</view><view>{{profile.statusText}} · 当前可预约</view></view>
        <view class="card center-card"><view class="subtitle">本人的服务资料</view><view class="center-copy">参赛费 {{profile.priceText}} / 场 · {{profile.city}}</view><view class="center-copy">本人填写，审核不代表实名、实力、保险或参赛资格认证。</view></view>
        <button class="secondary center-link" bindtap="edit" data-section="PROFILE">编辑资料与报价</button>
        <button class="secondary center-link" bindtap="edit" data-section="AVAILABILITY">管理可约时间 · {{profile.windowCount}}个窗口</button>
        <button class="secondary center-link" bindtap="received">查看收到的预约</button>
        <button class="secondary center-link" bindtap="performance">我的比赛数据授权</button>
        <view class="card center-card"><view class="subtitle">资金状态</view><view class="center-copy">实收 ¥0 / 已结算 ¥0</view><view class="center-copy">在线支付与个人分账暂未开放</view></view>
        <view class="notice small">可约不等于保证到场；删除窗口不会取消已经接受的预约。</view>
        <button class="quiet" bindtap="refresh" disabled="{{busy || pending}}">刷新本人资料</button>
      </block>
      <view class="action-bar">
        <button wx:if="{{profile.status === 'PENDING'}}" class="primary" bindtap="refresh" disabled="{{busy || pending}}">刷新审核状态</button>
        <button wx:elif="{{profile.status === 'REJECTED'}}" class="primary" bindtap="edit" disabled="{{busy || pending}}">修改并重新提交</button>
        <button wx:else class="primary" bindtap="received">{{profile.status === 'DISABLED' ? '查看已有合作' : '处理收到的预约'}}</button>
        <button class="quiet" bindtap="account">返回我的</button>
      </view>
    </block>
    <block wx:if="{{editing}}">
      <block wx:if="{{editorSection === 'PROFILE'}}">
      <view class="profile-fields">
        <view class="profile-field"><view class="field-label">显示名称 / 位置</view><view class="editor-pair"><input class="field" value="{{form.displayName}}" maxlength="40" data-field="displayName" bindinput="input" disabled="{{busy || pending}}" placeholder="本人显示名称" /><picker range="{{positions}}" value="{{positionIndex}}" bindchange="position" disabled="{{busy || pending}}"><view class="picker-value">{{positions[positionIndex]}}</view></picker></view></view>
        <view class="profile-field"><view class="field-label">身高（厘米）/ 服务地区</view><view class="editor-pair"><input class="field height-field" type="number" value="{{form.heightCm}}" maxlength="3" data-field="heightCm" bindinput="input" disabled="{{busy || pending}}" placeholder="120–250" /><input class="field" value="{{form.city}}" maxlength="60" data-field="city" bindinput="input" disabled="{{busy || pending}}" placeholder="例如：高州 / 石鼓" /></view><view class="small muted field-help">本人填写，不作为实力认证。</view></view>
        <view class="profile-field"><view class="field-label">服务介绍</view><textarea class="field profile-bio" value="{{form.bio}}" maxlength="500" data-field="bio" bindinput="input" disabled="{{busy || pending}}" placeholder="说明打法与服务范围" /><view class="small muted field-help">不要填写身份证、联系方式或保单。</view></view>
      </view>
      <view class="card center-card"><view class="subtitle">成人与资料声明</view><view class="center-copy">本人已满18周岁</view><view class="center-copy">资料由本人提交并对真实性负责</view><view class="center-copy">本次声明不是身份证自动核验</view></view>
      <checkbox-group bindchange="consent"><label class="consent profile-consent"><checkbox value="yes" checked="{{form.adultConfirmed}}" disabled="{{busy || pending}}" />本人已成年，并确认上述资料真实</label></checkbox-group>
      <button class="secondary" bindtap="editSection" data-section="FEES" disabled="{{busy || pending}}">下一步填写服务报价</button><button class="quiet" bindtap="editSection" data-section="AVAILABILITY" disabled="{{busy || pending}}">管理可约时间</button>
      </block>
      <block wx:elif="{{editorSection === 'FEES'}}"><view class="pricing-fields">
        <view class="profile-field"><view class="field-label">参赛服务费（元 / 场）</view><input class="field" type="digit" value="{{form.price}}" data-field="price" bindinput="input" disabled="{{busy || pending}}" /></view>
        <view class="profile-field"><view class="field-label">交通费（元）</view><input class="field" type="digit" value="{{form.travel}}" data-field="travel" bindinput="input" disabled="{{busy || pending}}" /></view>
        <view class="profile-field"><view class="field-label">食宿费（元）</view><input class="field" type="digit" value="{{form.accommodation}}" data-field="accommodation" bindinput="input" disabled="{{busy || pending}}" /></view>
        </view>
        <view wx:if="{{quote}}" class="card center-card"><view class="subtitle">报价预览</view><view class="center-copy">参赛服务费 {{quote.service}}</view><view class="center-copy">按当前 {{feeText}} 费率预计平台费 {{quote.platform}}</view><view class="center-copy">交通 {{quote.travel}} · 食宿 {{quote.accommodation}} · 含费估算 {{quote.total}}</view></view>
        <view class="notice"><view class="notice-title">价格变动不改旧单</view><view class="small">新报价需重新审阅；既有订单保留原报价和费率快照。</view></view>
        <checkbox-group bindchange="consent"><label class="consent profile-consent"><checkbox value="yes" checked="{{form.adultConfirmed}}" disabled="{{busy || pending}}" />本人已成年，并确认完整服务资料与报价真实</label></checkbox-group>
        <button class="secondary" bindtap="editSection" data-section="AVAILABILITY" disabled="{{busy || pending}}">继续管理可约时间</button><button class="quiet" bindtap="editSection" data-section="PROFILE" disabled="{{busy || pending}}">继续编辑服务资料</button>
      </block>
      <block wx:else>
      <view class="card"><view class="subtitle">可约时间 · 北京时间</view><view class="muted">填写1至60个不重叠窗口；单段最多31天。</view>
        <view wx:for="{{form.availability}}" wx:key="key" class="availability-row">
          <view class="row-between"><text>可约窗口 {{index + 1}}</text><button class="quiet" size="mini" bindtap="removeWindow" data-index="{{index}}" disabled="{{busy || pending}}">删除</button></view>
          <view class="window-pair"><picker mode="date" value="{{item.startDate}}" bindchange="windowInput" data-field="startDate" data-index="{{index}}" disabled="{{busy || pending}}"><view class="picker-value">{{item.startDate}}</view></picker><picker mode="time" value="{{item.startTime}}" bindchange="windowInput" data-field="startTime" data-index="{{index}}" disabled="{{busy || pending}}"><view class="picker-value">{{item.startTime}}</view></picker></view>
          <view class="muted">至</view>
          <view class="window-pair"><picker mode="date" value="{{item.endDate}}" bindchange="windowInput" data-field="endDate" data-index="{{index}}" disabled="{{busy || pending}}"><view class="picker-value">{{item.endDate}}</view></picker><picker mode="time" value="{{item.endTime}}" bindchange="windowInput" data-field="endTime" data-index="{{index}}" disabled="{{busy || pending}}"><view class="picker-value">{{item.endTime}}</view></picker></view>
        </view>
        <button class="secondary" bindtap="addWindow" disabled="{{busy || pending || form.availability.length >= 60}}">添加可约时间段</button>
        <view class="muted profile-subnote">实际接单仍核验已有订单和场后30分钟交通缓冲；不能以修改窗口取消已有合作。</view>
      </view>
      <checkbox-group bindchange="consent"><label class="consent profile-consent"><checkbox value="yes" checked="{{form.adultConfirmed}}" disabled="{{busy || pending}}" />本人已成年，并确认完整服务资料与可约时间真实</label></checkbox-group><button class="quiet" bindtap="editSection" data-section="PROFILE" disabled="{{busy || pending}}">继续编辑服务资料</button>
      </block>
      <view wx:if="{{pending}}" class="notice warning">原资料提交结果待核对，当前内容已锁定。使用原编号继续核对，不会自动重发或另外创建提交。</view>
      <button class="quiet" bindtap="refresh" disabled="{{busy || pending}}">重新读取本人资料</button>
      <view class="action-bar"><button class="primary" bindtap="save" disabled="{{busy || pendingInFlight || (!pending && !form.adultConfirmed)}}">{{busy ? '正在保存…' : pending ? '核对原资料提交' : '保存并提交资料审核'}}</button><button class="quiet" bindtap="cancelEdit" disabled="{{busy || pending}}">返回本人资料</button></view>
    </block>
  </block>
  <view wx:if="{{!loading && !authorized && !loginRequired}}" class="card center-card"><view class="subtitle">当前无法管理本人资料</view><view class="center-copy">请核对当前账号与访问权限后重新读取，不展示其他账号的服务档案。</view><button class="secondary" bindtap="refresh">重新读取本人资料</button></view>
</view>
