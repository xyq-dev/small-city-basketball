<scb-header title="比赛数据授权" disabled="{{busy || pending || dirty}}"/>
<view class="scb-ui-page figma-page performance-rebuild">
  <view class="figma-page__content figma-page__content--actions">
    <figma-skeleton wx:if="{{loading}}" rows="4"/>
    <figma-feedback wx:if="{{error}}" type="error" title="数据授权读取失败" body="{{error}}" action-label="重新读取" bind:action="refresh"/>
    <figma-feedback wx:if="{{message}}" type="info" title="处理结果" body="{{message}}"/>
    <figma-feedback wx:if="{{loginRequired}}" type="permission" title="登录后管理比赛数据授权" body="只读取本人或当前有权管理赛事的授权记录。" action-label="登录并返回" bind:action="login"/>

    <block wx:if="{{authorized}}">
      <view class="figma-summary"><view class="figma-summary__icon"><figma-icon name="shield" size="28"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">本人授权</view><view class="figma-title">比赛数据授权</view><view class="figma-subtitle">核对本人参赛来源，逐项决定有限公开的范围。</view></view></view>

      <block wx:if="{{pending}}">
        <view class="figma-section"><view class="figma-section__title">{{pending.type === 'CONSENT' ? '核对本人参赛记录' : pending.link.status === 'PENDING' ? '拒绝本次公开' : '撤销当前授权'}}</view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{pending.link.eventName}}</view><view class="figma-row__subtitle">{{pending.link.teamName}} · {{pending.link.memberName}}</view></view><view class="figma-status figma-status--orange">{{pending.link.profileName}}</view></view><view class="figma-caption">{{pending.link.sourceText}}</view></view>
        <view wx:if="{{pending.type === 'CONSENT'}}" class="figma-section"><view class="figma-section__title">有限公开的内容</view><view class="figma-row"><view class="figma-row__mark is-active"/><view class="figma-row__copy"><view class="figma-row__title">赛事与日期</view><view class="figma-row__subtitle">仅本次选中的来源</view></view><view class="figma-status figma-status--orange">已列明</view></view><view class="figma-row"><view class="figma-row__mark is-active"/><view class="figma-row__copy"><view class="figma-row__title">本人得分与犯规</view><view class="figma-row__subtitle">统计样本和记录完整度</view></view><view class="figma-status figma-status--orange">已列明</view></view><view class="figma-caption">不公开其他名单、联系方式、私有凭据或私有赛事接口。</view></view>
        <view class="figma-section"><view class="figma-section__title">本人声明</view><checkbox-group wx:if="{{pending.type === 'CONSENT'}}" bindchange="playerConsent"><label class="figma-check"><checkbox value="yes" checked="{{pending.consent}}" disabled="{{busy || pendingUnknown}}"/>这是本人的参赛记录，并同意按上述有限范围公开</label></checkbox-group><view class="figma-field-group"><view class="figma-field-label">{{pending.type === 'CONSENT' ? '处理原因' : pending.link.status === 'PENDING' ? '拒绝原因' : '撤销原因'}}</view><textarea class="figma-field-control" value="{{pending.reason}}" bindinput="dialogReason" maxlength="500" disabled="{{busy || pendingUnknown}}" placeholder="填写 2 至 500 字；不要包含私密证件或联系方式"/></view><figma-feedback wx:if="{{pendingUnknown}}" type="info" title="原处理结果待核对" body="保留原编号及内容，继续核对不会生成新的授权处理。"/></view>
      </block>

      <block wx:else>
        <view class="performance-tabs" role="tablist"><button class="performance-tab {{filter === 'PENDING' ? 'is-active' : ''}}" data-filter="PENDING" bindtap="filter" disabled="{{dirty || busy || pageLoading || sourceLoading || checking || nominationUnknown}}">待本人确认</button><button class="performance-tab {{filter === 'APPROVED' ? 'is-active' : ''}}" data-filter="APPROVED" bindtap="filter" disabled="{{dirty || busy || pageLoading || sourceLoading || checking || nominationUnknown}}">已同意</button><button class="performance-tab {{filter === 'ALL' ? 'is-active' : ''}}" data-filter="ALL" bindtap="filter" disabled="{{dirty || busy || pageLoading || sourceLoading || checking || nominationUnknown}}">历史</button></view>

        <figma-feedback wx:if="{{!links.length}}" type="empty" title="本页暂无符合条件的记录" body="当前页没有本人记录时，仍可继续加载完整历史；较早有效授权不会失去撤销入口。"/>

        <block wx:if="{{filter === 'PENDING' && links.length}}">
          <view class="figma-section">
            <view class="figma-section__title">本次提名</view>
            <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{links[0].eventName}}</view><view class="figma-row__subtitle">{{links[0].teamName}} · {{links[0].memberName}}</view></view><view class="figma-status figma-status--orange">{{links[0].statusText || '待本人确认'}}</view></view>
            <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">来源比赛</view><view class="figma-row__subtitle">{{links[0].profileName}} · {{links[0].sourceText}}</view></view><view class="figma-status figma-status--green">{{links[0].sourceStatusText || '已核对'}}</view></view>
            <figma-feedback wx:if="{{!links[0].sourceCurrentlyAvailable}}" type="error" title="当前来源不再满足公开条件" body="个人统计不会回退到旧确认；仍可按当前权限处理拒绝。"/>
          </view>
          <view class="figma-section">
            <view class="figma-section__title">有限公开的内容</view>
            <view class="figma-row"><view class="figma-row__mark"/><view class="figma-row__copy"><view class="figma-row__title">赛事与日期</view><view class="figma-row__subtitle">仅本次选中的来源</view></view><view class="figma-status figma-status--orange">已列明</view></view>
            <view class="figma-row"><view class="figma-row__mark"/><view class="figma-row__copy"><view class="figma-row__title">本人得分与犯规</view><view class="figma-row__subtitle">有效样本数、记录完整度</view></view><view class="figma-status figma-status--orange">已列明</view></view>
          </view>
          <view class="figma-section">
            <view class="figma-section__title">本人声明</view>
            <view class="figma-row"><view class="figma-row__mark declaration-mark"/><view class="figma-row__copy"><view class="figma-row__title">这是我的参赛记录</view><view class="figma-row__subtitle">请核对球队、赛事与本人姓名</view></view><view class="figma-status">未勾选</view></view>
            <view class="figma-row"><view class="figma-row__mark declaration-mark"/><view class="figma-row__copy"><view class="figma-row__title">同意有限公开</view><view class="figma-row__subtitle">仅本次比赛来源</view></view></view>
          </view>
          <view wx:for="{{links}}" wx:key="id" wx:if="{{index > 0 && item.status === 'PENDING'}}" class="figma-section authorization-card">
            <view class="section-heading"><view><view class="figma-row__title">{{item.eventName}}</view><view class="figma-row__subtitle">{{item.teamName}} · {{item.memberName}}</view></view><view class="figma-status figma-status--orange">{{item.statusText}}</view></view>
            <view class="authorization-actions"><button wx:if="{{item.capabilities.canConsent}}" data-id="{{item.id}}" data-type="CONSENT" bindtap="checkLink" disabled="{{dirty || busy || pageLoading || sourceLoading || checking || nominationUnknown}}">核对本人记录并同意</button><button wx:if="{{item.capabilities.canRevoke}}" data-id="{{item.id}}" data-type="REVOKE" bindtap="checkLink" disabled="{{dirty || busy || pageLoading || sourceLoading || checking || nominationUnknown}}">{{item.revokeText}}</button></view>
          </view>
        </block>

        <view wx:if="{{filter !== 'PENDING'}}" wx:for="{{links}}" wx:key="id" class="figma-section authorization-card">
          <view class="section-heading"><view><view class="figma-row__title">{{item.eventName}}</view><view class="figma-row__subtitle">{{item.teamName}} · {{item.memberName}}</view></view><view class="figma-status {{item.status === 'APPROVED' ? 'figma-status--green' : 'figma-status--orange'}}">{{item.statusText}}</view></view>
          <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">来源比赛</view><view class="figma-row__subtitle">档案：{{item.profileName}} · {{item.sourceText}}</view></view><view class="figma-status">{{item.createdText}}</view></view>
          <figma-feedback wx:if="{{!item.sourceCurrentlyAvailable}}" type="error" title="当前来源不再满足公开条件" body="个人统计不会回退到旧确认；仍可按当前权限处理撤销。"/>
          <view class="authorization-actions"><button wx:if="{{item.capabilities.canConsent}}" data-id="{{item.id}}" data-type="CONSENT" bindtap="checkLink" disabled="{{dirty || busy || pageLoading || sourceLoading || checking || nominationUnknown}}">核对本人记录并同意</button><button wx:if="{{item.capabilities.canRevoke}}" data-id="{{item.id}}" data-type="REVOKE" bindtap="checkLink" disabled="{{dirty || busy || pageLoading || sourceLoading || checking || nominationUnknown}}">{{item.revokeText}}</button></view>
        </view>

        <figma-feedback wx:if="{{checking}}" type="loading" title="正在重新核对" body="正在读取这条记录的当前权限与版本。"/>
        <figma-feedback wx:if="{{pageError}}" type="error" title="历史分页读取失败" body="{{pageError}}"/>
        <button wx:if="{{linksHasMore}}" class="figma-action figma-action--ghost" bindtap="more" disabled="{{dirty || busy || loading || pageLoading || sourceLoading || checking || nominationUnknown}}">{{pageLoading ? '正在加载…' : pageError ? '重试同一页' : '加载更多授权历史'}}</button>
        <button wx:if="{{filter !== 'PENDING'}}" class="history-filter" data-filter="REVOKED" bindtap="filter" disabled="{{dirty || busy || pageLoading || sourceLoading || checking || nominationUnknown}}">仅看已拒绝 / 已撤销</button>
        <figma-feedback wx:if="{{disclosureNotice}}" type="info" title="公开范围说明" body="{{disclosureNotice}}"/>

        <view wx:if="{{!ownOnly}}" id="nomination-section" class="figma-section nomination-section">
          <view class="figma-section__title">主办方提名本人参赛记录</view><view class="figma-caption">由当前有赛事数据管理权的主办方精确选择固定名单成员；不能按同名自动认领。</view>
          <figma-feedback wx:if="{{!manageableEvents.length}}" type="empty" title="当前没有可管理数据授权的赛事" body="平台身份不会自动获得发布权。"/>
          <block wx:else>
            <view class="figma-field-group"><view class="figma-field-label">有权管理的赛事</view><picker range="{{manageableEvents}}" range-key="name" value="{{eventIndex < 0 ? 0 : eventIndex}}" bindchange="chooseEvent" disabled="{{loading || pageLoading || checking || pending || busy || nominationUnknown}}"><view class="figma-field-control picker-control">{{selectedEvent || '请选择赛事'}}</view></picker></view>
            <figma-feedback wx:if="{{sourceLoading}}" type="loading" title="正在读取名单" body="正在读取该届明确报名名单。"/>
            <button wx:if="{{selectedEvent && !sourceLoading && !teams.length}}" class="figma-action figma-action--ghost" bindtap="retrySources">重新读取所选赛事名单</button>
            <view class="figma-field-group"><view class="figma-field-label">所属球队</view><picker range="{{teams}}" range-key="name" value="{{teamIndex < 0 ? 0 : teamIndex}}" bindchange="chooseTeam" disabled="{{loading || pageLoading || checking || pending || busy || sourceLoading || nominationUnknown || !teams.length}}"><view class="figma-field-control picker-control">{{selectedTeam || '先选择赛事，再选择球队'}}</view></picker></view>
            <view class="figma-field-group"><view class="figma-field-label">固定报名名单成员</view><picker range="{{members}}" range-key="label" value="{{memberIndex < 0 ? 0 : memberIndex}}" bindchange="chooseMember" disabled="{{loading || pageLoading || checking || pending || busy || sourceLoading || nominationUnknown || !members.length}}"><view class="figma-field-control picker-control">{{selectedMember || '请选择明确的名单成员'}}</view></picker></view>
            <view class="figma-field-group"><view class="figma-field-label">提名到已审核球员档案</view><picker range="{{profiles}}" range-key="displayName" value="{{profileIndex < 0 ? 0 : profileIndex}}" bindchange="chooseProfile" disabled="{{loading || pageLoading || checking || pending || busy || sourceLoading || nominationUnknown || !profiles.length}}"><view class="figma-field-control picker-control">{{selectedProfile || '请选择已审核档案并核对编号'}}</view></picker></view>
            <view class="figma-field-group"><view class="figma-field-label">提名依据与原因</view><textarea class="figma-field-control" value="{{draft.reason}}" bindinput="draftReason" maxlength="500" disabled="{{loading || pageLoading || checking || pending || busy || nominationUnknown}}" placeholder="填写 2 至 500 字，说明如何核对对象"/></view>
            <checkbox-group bindchange="publisherConsent"><label class="figma-check"><checkbox value="yes" checked="{{draft.publisherConsent}}" disabled="{{loading || pageLoading || checking || pending || busy || sourceLoading || nominationUnknown}}"/>我确认有权提供本次名单成员的有限比赛统计</label></checkbox-group>
            <figma-feedback wx:if="{{nominationUnknown}}" type="info" title="原提名结果待核对" body="当前内容已锁定，继续使用原编号核对，不换号重复提名。"/>
            <button class="figma-action figma-action--orange" bindtap="nominate" disabled="{{loading || pageLoading || checking || pending || busy || sourceLoading || (!nominationUnknown && (!draft.publisherConsent || !draft.eventId || !draft.teamId || !draft.memberId || !draft.profileId || draft.reason.length < 2))}}">{{busy ? '正在处理…' : nominationUnknown ? '核对原提名结果' : '提名给球员本人确认'}}</button><button class="figma-action figma-action--ghost" bindtap="discardDraft" disabled="{{loading || pageLoading || checking || pending || busy || sourceLoading || nominationUnknown}}">放弃当前草稿</button>
          </block>
        </view>
        <figma-feedback wx:if="{{dirty || nominationUnknown}}" type="info" title="当前暂停刷新与分页" body="先完成或关闭正在编辑的草稿和确认记录，避免丢失输入。"/>
      </block>
    </block>

    <figma-feedback wx:if="{{!loading && !authorized && !loginRequired}}" type="permission" title="当前无法读取数据授权" body="核对当前账号和赛事权限后重新读取，不展示其他账号的旧记录。" action-label="重新读取" bind:action="refresh"/>
  </view>

  <view class="figma-fixed-actions">
    <block wx:if="{{pending}}"><button class="figma-action figma-action--ghost" bindtap="closeDialog" disabled="{{busy || pendingUnknown}}">返回授权列表</button><button class="figma-action figma-action--orange" bindtap="submitDialog" disabled="{{busy || (!pendingUnknown && (pending.reason.length < 2 || (pending.type === 'CONSENT' && !pending.consent)))}}">{{busy ? '正在核对…' : pendingUnknown ? '核对原结果' : pending.type === 'CONSENT' ? '核对并同意' : '确认拒绝或撤销'}}</button></block>
    <block wx:elif="{{filter === 'PENDING' && links.length && links[0].capabilities.canConsent}}"><button class="figma-action figma-action--ghost" data-id="{{links[0].id}}" data-type="REVOKE" bindtap="checkLink" disabled="{{dirty || busy || pageLoading || sourceLoading || checking || nominationUnknown || !links[0].capabilities.canRevoke}}">拒绝授权</button><button class="figma-action figma-action--orange" data-id="{{links[0].id}}" data-type="CONSENT" bindtap="checkLink" disabled="{{dirty || busy || pageLoading || sourceLoading || checking || nominationUnknown}}">核对本人记录并同意</button></block>
    <block wx:else><button wx:if="{{ownOnly}}" class="figma-action figma-action--ghost" bindtap="center" disabled="{{dirty || busy || pageLoading || sourceLoading || checking || nominationUnknown}}">返回球员中心</button><button wx:else class="figma-action figma-action--ghost" bindtap="nomination" disabled="{{dirty || busy || pageLoading || sourceLoading || checking || nominationUnknown}}">主办方提名</button><button class="figma-action figma-action--orange" bindtap="refresh" disabled="{{dirty || busy || pageLoading || sourceLoading || checking || nominationUnknown}}">刷新数据授权</button></block>
  </view>
</view>
