@import "../../styles/figma-pages.wxss";

.performance-tabs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1px; height:48px; padding:2px 3px; border-radius:12px; background:#fff; }
.performance-tab { display:flex; height:44px; align-items:center; justify-content:center; border-radius:10px; color:#51657d; font-size:12px; }
.performance-tab.is-active { background:#123c73; color:#fff; font-weight:700; }
.performance-rebuild .performance-tabs>button.performance-tab { width:100%; min-width:0; max-width:none; height:44px; min-height:44px; margin:0; padding:0 4px; border:0; justify-self:stretch; box-sizing:border-box; background:transparent; }
.performance-rebuild .performance-tabs>button.performance-tab.is-active { background:#123c73; color:#fff; }
.performance-rebuild .declaration-mark { border-radius:4px; }
.section-heading { display:flex; align-items:center; justify-content:space-between; gap:8px; }
.authorization-actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
.authorization-actions button,.history-filter { display:flex; min-height:44px; align-items:center; justify-content:center; padding:0 10px; border-radius:12px; background:#f4f6fa; color:#123c73; font-size:12px; text-align:center; }
.history-filter { width:100%; }
.nomination-section { gap:12px; }
.picker-control { display:flex; align-items:center; }
@media (max-width:360px) { .authorization-actions { grid-template-columns:1fr; } }
