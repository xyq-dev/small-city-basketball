.reschedule-page { padding:12px 16px calc(112px + env(safe-area-inset-bottom)); }
.reschedule-summary { min-height:110px; padding:16px 14px; }
.fig-summary-icon { display:flex; flex:0 0 44px; width:44px; height:44px; align-items:center; justify-content:center; border-radius:12px; background:#eaf2fc; }
.fig-summary-icon image { width:24px; height:24px; }
.reschedule-tabs { display:flex; gap:0; padding:3px; margin-bottom:12px; border-radius:12px; background:#fff; }
.reschedule-tabs view { display:flex; flex:1; min-width:0; min-height:44px; align-items:center; justify-content:center; padding:8px 4px; border-radius:10px; color:#63758b; font-size:14px; line-height:20px; text-align:center; }
.reschedule-tabs .selected { color:#fff; background:#164b88; }
.reschedule-current { color:#18283f; background:#fff; }
.reschedule-current .board-meta,.reschedule-current .board-result { color:#63758b; text-align:left; }
.reschedule-current .board-meta { display:flex; align-items:center; min-height:44px; }
.reschedule-current .org-match-teams { margin:10px 0; }
.reschedule-form,.reschedule-history,.reschedule-uncertain,.reschedule-changed { padding:14px; border:0; border-radius:16px; }
.reschedule-form .field { border:0; background:#f4f6fa; }
.state-notice { display:flex; align-items:center; gap:10px; min-height:66px; padding:10px 12px; margin-top:8px; border-radius:10px; background:#eaf2fc; }
.state-notice > view { flex:1; min-width:0; }
.state-dot { color:#164b88; font-size:22px; }
.state-title { color:#18283f; font-size:14px; line-height:22px; font-weight:600; }
.state-chip { flex:none; padding:2px 8px; border-radius:7px; color:#895500; background:#fff3e6; font-size:12px; line-height:20px; }
.compare-title { margin-top:14px; }
.plan-compare { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; margin:8px 0 12px; }
.plan-compare > view { min-height:88px; padding:12px; border-radius:10px; background:#eaf2fc; }
.reschedule-uncertain button,.reschedule-changed button { margin-top:8px; }
#reschedule-log { scroll-margin-top:12px; }
@media (max-width:340px) { .reschedule-page { padding-left:12px; padding-right:12px; } .reschedule-tabs view { font-size:13px; } .plan-compare { grid-template-columns:1fr; } .setup-pair { grid-template-columns:1fr; } }
