.match-page { display:flex; flex-direction:column; gap:12px; padding-bottom:calc(164px + env(safe-area-inset-bottom)); }
.match-page > button,.match-page > .notice { margin:0; }
.match-page > .fig-summary,.match-page > .match-panel { margin:0; }
.match-context-summary { margin:0; }
.match-context-summary .fig-summary-mark { order:-1; width:44px; height:44px; border-radius:12px; background:#eaf2fc; }
.match-context-summary .fig-summary-mark image { width:25px; height:25px; }
.match-context-summary .fig-summary-title { margin-top:3px; color:#18283f; font-size:18px; line-height:26px; }
.match-context-summary .fig-kicker,.match-context-summary .fig-summary-sub { color:#63758b; }
.match-hero { display:flex; flex-direction:column; align-items:flex-start; gap:12px; padding:24px; border-radius:16px; color:#fff; background:#123c73; }
.match-badge { display:flex; align-items:center; justify-content:center; min-height:28px; width:112px; max-width:100%; padding:4px 12px; border-radius:999px; color:#16734b; background:#e7f5ee; font-size:12px; line-height:20px; }
.match-teams { color:#18283f; font-size:18px; line-height:28px; font-weight:500; overflow-wrap:anywhere; }
.match-hero .match-teams { color:#fff; }
.match-hero .score { color:#fff; font-family:Inter,Arial,sans-serif; font-size:56px; line-height:70px; font-weight:700; padding:0; text-align:left; }
.match-hero .clock { font-family:inherit; color:#fff; font-size:22px; line-height:34px; font-weight:700; text-align:left; }
.scoreboard-caption { color:#a8b7c7; font-size:12px; line-height:20px; }
.confirmed-result { display:flex; flex-direction:column; align-items:flex-start; gap:16px; }
.confirmed-result .subtitle { margin:0; }
.result-score { font-size:22px; line-height:34px; font-weight:700; color:#123c73; overflow-wrap:anywhere; }
.match-tabs { display:flex; gap:1px; padding:2px 3px; border-radius:12px; background:#fff; }
.match-tabs button { flex:1; min-width:0; min-height:44px; margin:0; padding:10px 4px; border-radius:8px; color:#63758b; background:transparent; font-size:14px; line-height:24px; }
.match-tabs button::after { border:0; }
.match-tabs button.selected { color:#fff; background:#123c73; border-radius:10px; }
.match-panel { padding:14px; border:0; border-radius:16px; background:#fff; overflow-wrap:anywhere; }
.live-score-panel { display:flex; flex-direction:column; gap:8px; }
.score-pair { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
.score-team { min-width:0; padding:12px; border-radius:11px; background:#eaf2fc; }
.score-team.away { background:#fff1e2; }
.score-team-name { color:#18283f; font-size:15px; line-height:21px; font-weight:700; overflow-wrap:anywhere; }
.score-number { color:#123c73; font-family:Inter,Arial,sans-serif; font-size:36px; line-height:51px; font-weight:700; }
.score-readable { position:absolute; width:1px; height:1px; overflow:hidden; opacity:0; pointer-events:none; }
.score-status { display:flex; align-items:center; justify-content:space-between; gap:8px; }
.score-status .clock { color:#123c73; font-size:16px; line-height:24px; font-weight:600; }
.detail-panel { display:flex; flex-direction:column; gap:16px; }
.detail-item { display:flex; align-items:flex-start; gap:12px; }
.detail-bullet { color:#f28c28; font-size:14px; line-height:24px; flex-shrink:0; }
.detail-content { flex:1; min-width:0; display:flex; flex-direction:column; gap:4px; }
.detail-title { color:#18283f; font-size:14px; line-height:24px; font-weight:500; }
.periods-panel .subtitle { margin-bottom:16px; }
.period-row { display:flex; justify-content:space-between; gap:12px; min-height:44px; padding:12px 0; border-bottom:1px solid #e1e7ef; font-size:14px; line-height:24px; }
.period-row:last-child { border-bottom:0; }
.period-row.table-head { color:#63758b; font-size:12px; line-height:20px; }
.published-media { display:flex; flex-direction:column; gap:16px; }
.published-media .subtitle,.published-media button { margin:0; }
.published-media .media-image,.published-media .media-video { margin:0; width:100%; }
.marker-heading { color:#18283f; font-size:18px; line-height:28px; font-weight:500; margin-top:4px; }
.public-state { display:flex; flex-direction:column; gap:16px; }
.public-state .title,.public-state .subtitle,.public-state .notice,.public-state button { margin:0; }
.state-tag { align-self:flex-start; padding:4px 16px; border-radius:999px; background:#eaf0f7; color:#123c73; font-size:12px; line-height:20px; }
.state-tag.warning { background:#fff3dc; color:#895500; }
.state-strong { font-size:14px; line-height:24px; font-weight:500; margin-bottom:4px; }
.public-skeleton { height:12px; border-radius:4px; background:#eaf0f7; }
.public-skeleton.short { width:82%; }
@media (max-width:360px) { .match-panel { padding:12px; } .match-hero .score { font-size:48px; line-height:64px; } }
