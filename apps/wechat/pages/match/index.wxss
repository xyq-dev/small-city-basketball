@import "../../styles/figma-pages.wxss";

.match-tabs{display:grid;height:48px;padding:2px 3px;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;border-radius:12px;background:#fff}.match-tab{display:flex;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 8px;border:0;border-radius:10px;background:transparent;color:#51657d;font-size:13px}.match-tab::after,.section-action::after,.match-share::after{border:0}.match-tab.is-active{background:#123c73;color:#fff;font-weight:700}.score-cards{display:grid;width:100%;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.score-card{display:flex;min-width:0;height:116px;padding:12px;flex-direction:column;justify-content:center;border-radius:12px}.score-card--home{background:#eaf2fc}.score-card--away{background:#fff1e2}.score-card__team{overflow:hidden;font-size:15px;font-weight:700;line-height:22px;text-overflow:ellipsis;white-space:nowrap}.score-card__value{color:#123c73;font-size:36px;font-weight:700;line-height:44px}.match-notice{display:flex;width:100%;min-height:55px;align-items:center;gap:9px;padding:0 10px;border-radius:8px;background:#eaf2fc}.match-notice__mark{width:7px;height:7px;flex:none;border-radius:4px;background:#123c73}.media-image,.media-video{width:100%;border-radius:12px;overflow:hidden}.section-action,.match-share{display:flex;width:100%;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 12px;border:0;border-radius:22px;background:#123c73;color:#fff;font-size:14px}@media(max-width:360px){.match-page .figma-fixed-actions{grid-template-columns:minmax(128px,2fr) minmax(0,3fr)}.match-page .figma-action{font-size:13px}}
.match-a11y{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.match-clock{margin-top:8px;color:#51657d;font-size:13px;line-height:20px;text-align:center}
