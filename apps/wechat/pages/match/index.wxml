<view class="page match-page">
  <view wx:if="{{error}}" class="notice warning">{{error}} <text wx:if="{{stale}}">比分和计时资料已陈旧，请恢复连接后刷新。</text></view>
  <block wx:if="{{snapshot}}">
    <view class="hero match-hero"><view class="badge success">{{snapshot.statusLabel}}</view><view class="subtitle">{{snapshot.home.teamName}} 对 {{snapshot.away.teamName}}</view><view class="score">{{snapshot.score ? snapshot.score.home + ' : ' + snapshot.score.away : '尚未准备'}}</view><view class="clock">{{snapshot.clock ? '第' + snapshot.clock.period + '节 ' : ''}}{{clock}}</view><view class="muted">{{snapshot.resultLabel}} · 比分与计时已同步，网络更新可能延迟。</view></view>
    <view class="tabs"><button class="chip {{tab==='info'?'active':''}}" data-tab="info" bindtap="tab">赛况</button><button class="chip" bindtap="ranking">排名</button><button class="chip {{tab==='media'?'active':''}}" data-tab="media" bindtap="tab">视频与图片</button></view>
    <block wx:if="{{tab==='info'}}"><view class="card"><view class="subtitle">本场资料</view><view class="row">{{snapshot.courtName || '场地待确认'}} · {{snapshot.startLabel}}</view><view class="row">{{snapshot.resultLabel}}</view><view class="row"><view>未采集个人技术统计</view><view class="muted">不从球队比分推算个人数据。正式结果以当前独立确认的赛果为准。</view></view></view><view wx:if="{{snapshot.periods}}" class="card"><view class="subtitle">分节比分</view><view wx:for="{{snapshot.periods}}" wx:key="period" class="row-between row"><text>第{{item.period}}节</text><text>{{item.home.score}} : {{item.away.score}}</text></view></view></block>
    <view wx:if="{{tab==='media'}}" class="card"><view class="subtitle">主办方公开媒体</view><view wx:if="{{!media.length}}" class="empty">尚未发布媒体</view><view wx:for="{{media}}" wx:key="publicMediaId" class="row"><view class="subtitle">{{item.title}}</view><image wx:if="{{item.kind==='IMAGE' && item.src}}" class="media-image" src="{{item.src}}" mode="widthFix"/><video wx:if="{{item.kind==='VIDEO' && item.src}}" id="media-{{item.publicMediaId}}" class="media-video" src="{{item.src}}" controls/><button wx:if="{{item.externalUrl}}" class="secondary" data-id="{{item.publicMediaId}}" bindtap="copyExternal">复制外部媒体链接</button><view wx:if="{{item.externalUrl}}" class="muted small">外链由主办方提供，不保证微信内播放；复制后无法收回已传播链接。</view><view wx:for="{{item.markers}}" wx:key="publicMarkerId" wx:for-item="marker"><button wx:if="{{item.kind==='VIDEO'}}" class="quiet" data-id="{{item.publicMediaId}}" data-marker="{{marker.publicMarkerId}}" bindtap="seekMarker">{{marker.label}} · 定位本场片段</button></view></view></view>
    <button class="secondary" bindtap="ranking">查看分组、排名与晋级</button><button class="secondary" open-type="share">分享此场公开比赛</button>
  </block>
  <button class="quiet" bindtap="load" disabled="{{loading}}" loading="{{loading}}">刷新比赛资料</button>
</view>
