<view class="page"><view wx:if="{{error}}" class="notice">{{error}} <text wx:if="{{stale}}">比分和计时资料已陈旧，请恢复连接后刷新。</text></view><button bindtap="load">刷新比赛</button><block wx:if="{{snapshot}}"><view class="card"><view class="title">{{snapshot.eventName}}</view><view>{{snapshot.home.teamName}} 对 {{snapshot.away.teamName}}</view><view class="score">{{snapshot.score ? snapshot.score.home + ' : ' + snapshot.score.away : '尚未准备'}}</view><view class="clock">{{clock}}</view><view class="muted">{{snapshot.status}} · {{snapshot.resultStatus}} · 计时以记录台为准，网络更新可能延迟</view><button open-type="share">分享此场比赛</button></view><view class="card"><view class="title">主办方公开媒体</view><view wx:if="{{!media.length}}" class="muted">尚未发布媒体</view><view wx:for="{{media}}" wx:key="publicMediaId" class="row"><view class="subtitle">{{item.title}}</view><image wx:if="{{item.kind==='IMAGE' && item.src}}" class="media-image" src="{{item.src}}" mode="widthFix"/><video wx:if="{{item.kind==='VIDEO' && item.src}}" id="media-{{item.publicMediaId}}" class="media-video" src="{{item.src}}" controls/><block wx:if="{{item.kind==='EXTERNAL_LINK'}}"><view class="muted">{{item.externalNotice}}</view><button data-id="{{item.publicMediaId}}" bindtap="copyExternal">复制主办方公开的外部地址</button></block><view wx:for="{{item.markers}}" wx:key="publicMarkerId" wx:for-item="marker" class="muted">{{marker.label}} · {{marker.startMs}}–{{marker.endMs}}ms<button wx:if="{{item.kind==='VIDEO'}}" data-id="{{item.publicMediaId}}" data-marker="{{marker.publicMarkerId}}" bindtap="seekMarker">跳到此片段</button></view></view></view></block></view>
