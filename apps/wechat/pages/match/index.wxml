<scb-header title="比赛详情" disabled="{{loading}}"/>
<view class="figma-page match-page">
  <view class="figma-page__content figma-page__content--actions">
    <view wx:if="{{loading && !snapshot}}" class="figma-section"><view class="figma-section__title">比赛实况</view><figma-skeleton rows="{{5}}"/></view>
    <figma-feedback wx:elif="{{!snapshot && unavailable}}" type="error" title="该比赛已停止公开" body="{{error}}" action-label="返回观赛入口" bind:action="watch"/>
    <figma-feedback wx:elif="{{!snapshot && error}}" type="error" title="暂时无法读取比赛" body="{{error}}" action-label="重新读取" bind:action="load"/>
    <figma-feedback wx:elif="{{!snapshot}}" type="empty" title="比赛资料尚未读取" body="请从有效公开赛事选择一场比赛。" action-label="返回观赛入口" bind:action="watch"/>

    <block wx:if="{{snapshot}}">
      <view class="figma-summary"><view class="figma-summary__icon"><figma-icon name="scoreboard" size="{{25}}"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">现场比分</view><view class="figma-title">比赛详情</view><view class="figma-subtitle">{{snapshot.eventName}} · {{snapshot.roundLabel || ('第' + snapshot.roundNo + '轮')}}</view></view></view>
      <view class="match-tabs"><button class="match-tab {{tab==='info' ? 'is-active' : ''}}" data-tab="info" bindtap="tab" disabled="{{loading}}">赛况</button><button class="match-tab" bindtap="ranking" disabled="{{loading}}">排名</button><button class="match-tab {{tab==='media' ? 'is-active' : ''}}" data-tab="media" bindtap="tab" disabled="{{loading}}">视频</button></view>
      <figma-feedback wx:if="{{error}}" type="error" title="比赛资料更新失败" body="{{stale ? '当前比分可能已陈旧：' : ''}}{{error}}"/>

      <block wx:if="{{tab==='info'}}">
        <view class="figma-section"><view class="figma-section__title">实时比分</view><text wx:if="{{snapshot.score}}" class="match-a11y">{{snapshot.score.home}} : {{snapshot.score.away}}</text><view class="score-cards"><view class="score-card score-card--home"><view class="score-card__team">{{snapshot.home.teamName}}</view><view class="score-card__value">{{snapshot.score ? snapshot.score.home : '—'}}</view><view class="figma-row__subtitle">主队</view></view><view class="score-card score-card--away"><view class="score-card__team">{{snapshot.away.teamName}}</view><view class="score-card__value">{{snapshot.score ? snapshot.score.away : '—'}}</view><view class="figma-row__subtitle">客队</view></view></view><view wx:if="{{snapshot.clock}}" class="match-clock">第 {{snapshot.clock.period}} 节 · {{clock}}</view></view>
        <view class="figma-section"><view class="figma-section__title">分节比分</view><figma-feedback wx:if="{{!snapshot.periods || !snapshot.periods.length}}" type="empty" title="暂无分节比分" body="当前仅公开总比分。"/><view wx:for="{{snapshot.periods}}" wx:key="period" class="figma-row"><figma-icon name="schedule" size="{{20}}"/><view class="figma-row__copy"><view class="figma-row__title">第{{item.period}}节</view><view class="figma-row__subtitle">{{snapshot.home.teamName}} {{item.home.score}} : {{item.away.score}} {{snapshot.away.teamName}}</view></view><view class="figma-status figma-status--orange">{{snapshot.status==='FINISHED' || (snapshot.clock && item.period < snapshot.clock.period) ? '已结束' : clock}}</view></view></view>
        <view class="figma-section"><view class="figma-section__title">数据公开范围</view><view class="match-notice"><view class="match-notice__mark"/><view class="figma-row__copy"><view class="figma-row__title">{{snapshot.resultStatus==='CONFIRMED' ? '正式赛果' : '当前赛果'}}</view><view class="figma-row__subtitle">{{snapshot.resultLabel}}</view></view></view><view class="match-notice"><view class="match-notice__mark"/><view class="figma-row__copy"><view class="figma-row__title">篮板与助攻</view><view class="figma-row__subtitle">{{snapshot.collected && snapshot.collected.playerStatistics ? '按实际采集公开' : '未统计'}}</view></view><view class="figma-status">{{snapshot.collected && snapshot.collected.playerStatistics ? '已采集' : '未统计'}}</view></view><button class="match-share" open-type="share">分享本场比赛</button></view>
      </block>

      <block wx:if="{{tab==='media'}}">
        <figma-feedback wx:if="{{!media.length}}" type="empty" title="尚未发布媒体" body="主办方明确发布且授权有效的图片、视频与片段定位会显示在这里。"/>
        <view wx:for="{{media}}" wx:key="publicMediaId" wx:for-item="mediaItem" class="figma-section"><view class="figma-section__title">{{mediaItem.title}}</view><view class="figma-section__hint">已发布媒体 · 不改变原比赛记录</view><image wx:if="{{mediaItem.kind==='IMAGE' && mediaItem.src}}" class="media-image" src="{{mediaItem.src}}" mode="widthFix"/><video wx:if="{{mediaItem.kind==='VIDEO' && mediaItem.src}}" id="media-{{mediaItem.publicMediaId}}" class="media-video" src="{{mediaItem.src}}" controls/><button wx:if="{{mediaItem.externalUrl}}" class="section-action" data-id="{{mediaItem.publicMediaId}}" bindtap="copyExternal">复制外部媒体链接</button><block wx:if="{{mediaItem.markers.length}}"><button wx:for="{{mediaItem.markers}}" wx:key="publicMarkerId" wx:for-item="marker" class="figma-row" data-id="{{mediaItem.publicMediaId}}" data-marker="{{marker.publicMarkerId}}" bindtap="seekMarker"><view class="figma-row__copy"><view class="figma-row__title">{{marker.label}}</view><view class="figma-row__subtitle">定位已发布片段</view></view><figma-icon name="media" size="{{20}}"/></button></block></view>
      </block>
    </block>
  </view>
  <view wx:if="{{snapshot}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost" data-tab="media" bindtap="tab">查看比赛视频与图片</button><button class="figma-action figma-action--orange" bindtap="ranking">查看分组排名与晋级</button></view>
</view>
