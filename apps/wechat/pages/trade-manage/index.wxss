.trade .card {
  margin: 24rpx 0;
  padding: 24rpx;
}
.trade button {
  margin-top: 16rpx;
}
.trade .field {
  border: 1rpx solid #ccd3df;
  padding: 16rpx;
  margin: 16rpx 0;
}
.trade .small {
  font-size: 22rpx;
  word-break: break-all;
}
.trade .warning {
  color: #9e4f00;
}

.ui002-workspace { padding:16px 16px calc(104px + env(safe-area-inset-bottom)); background:#f4f6fa; color:#18283f; }
.ui002-workspace .card { border-radius:16px; padding:16px; margin:0 0 16px; }
.ui002-workspace input,.ui002-workspace textarea,.ui002-workspace button { font-size:16px; line-height:24px; min-height:44px; }
.ui002-workspace .page-intro .title { color:#18283f; font-size:22px; line-height:32px; margin:0 0 8px; }
.ui002-workspace .page-intro { margin-bottom:16px; }
.ui002-workspace .tabs button { min-height:44px; }

.ui002-workspace .notice { font-size:14px; line-height:22px; border-radius:12px; padding:12px; }
.trade-manage-summary { color:#18283f; }
.trade-manage-summary-icon { display:flex; align-items:center; justify-content:center; flex:0 0 44px; width:44px; height:44px; border-radius:12px; background:#fff; }
.trade-manage-summary-icon image { width:25px; height:25px; }
.trade-manage-tabs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1px; min-height:44px; margin-bottom:12px; padding:2px 3px; border-radius:12px; background:#fff; color:#63758b; font-size:13px; line-height:40px; text-align:center; }
.trade-manage-tabs > view { height:40px; border-radius:10px; }
.trade-manage-tabs .selected { color:#fff; background:#123c73; font-weight:700; }
.trade.ui002-workspace .card { margin:0 0 12px; padding:14px; border-radius:16px; }
.trade.ui002-workspace .field { border:0; border-radius:8px; background:#f4f6fa; }
