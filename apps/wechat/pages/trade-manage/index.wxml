<scb-header title="交易与资金管理" disabled="{{busy}}"/><view class="page trade"><view wx:if="{{error}}" class="notice danger">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view><input class="field" data-field="orgId" value="{{orgId}}" bindinput="input" placeholder="机构编号（服务端验证权限）"/><button bindtap="load" disabled="{{busy}}">读取本机构交易</button><view wx:if="{{pending}}" class="card warning">原操作 {{pending.body.clientRequestId}} 待核对<button bindtap="recover" disabled="{{busy}}">查原回执</button><button wx:if="{{!pending.invalid}}" bindtap="retry" disabled="{{busy}}">使用原编号重试</button><checkbox-group bindchange="pendingConsent"><label><checkbox value="yes" checked="{{pendingAcknowledged}}" disabled="{{busy}}"/>我已核对最新记录，移除标记不取消服务端原操作</label></checkbox-group><button bindtap="clearPending" disabled="{{busy || !pendingAcknowledged}}">核对后移除本机标记</button></view>
<view class="card"><view class="subtitle">新增后续来源收费条款</view><view class="muted">需独立审核。只影响此后明确同意的新订单，既有免费来源不会追溯收费。实际收款主体与分账接收方由服务端配置。</view><button data-kind="LOCAL_BOOKING" bindtap="kind">同城供给费</button><button data-kind="ENTRY_FEE" bindtap="kind">报名费</button><button data-kind="ENTRY_DEPOSIT" bindtap="kind">保证金</button><view>当前 {{kind}}</view><input class="field" data-field="sourceId" value="{{sourceId}}" bindinput="input" placeholder="供给或赛事编号"/><input class="field" data-field="amount" value="{{amount}}" bindinput="input" type="number" placeholder="费用（整数分，100分=1元）"/><textarea class="field" data-field="termsText" value="{{termsText}}" bindinput="input" maxlength="2000" placeholder="收费、履约、取消、退款与保证金扣减条款"/><button bindtap="create" disabled="{{busy || pending}}">提交待审条款</button><textarea class="field" data-field="reason" value="{{reason}}" bindinput="input" placeholder="独立审核理由（至少4字）"/></view>
<view wx:for="{{terms}}" wx:key="id" class="card"><view>{{item.kind}} · {{item.amountText}} · {{item.status}}</view><view>{{item.terms}}</view><button data-id="{{item.id}}" data-version="{{item.version}}" data-decision="APPROVE" bindtap="review" disabled="{{busy || pending}}">独立发布</button><button data-id="{{item.id}}" data-version="{{item.version}}" data-decision="REJECT" bindtap="review" disabled="{{busy || pending}}">独立退回</button><button data-id="{{item.id}}" data-version="{{item.version}}" data-decision="REVOKE" bindtap="review" disabled="{{busy || pending}}">撤销后续收费</button></view>
<view class="card"><view class="subtitle">渠道日账核对</view><input class="field" data-field="date" value="{{date}}" bindinput="input" placeholder="YYYY-MM-DD（北京时间账日）"/><button bindtap="reconcile" disabled="{{busy || pending}}">下载并核对真实渠道账单</button><view class="muted">通道未配置时关闭执行；差异未消除不能分账。</view></view><button wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="open">{{item.title}} · {{item.totalText}} · {{item.status}}</button></view>
