@import "../../styles/figma-pages.wxss";

.exception-tabs { display: flex; width: 100%; min-height: 48px; padding: 2px 3px; border-radius: 12px; background: #fff; }
.exception-tab { display: flex; min-width: 0; min-height: 44px; flex: 1; align-items: center; justify-content: center; margin: 0; padding: 0 8px; border: 0; border-radius: 10px; background: transparent; color: #51657d; font-size: 13px; line-height: 19px; }
.exception-tab::after, .exception-choice::after, .exception-side::after, .exception-link::after { border: 0; }
.exception-tab.is-active { background: #123c73; color: #fff; font-weight: 700; }
.exception-rule { color: #18283f; font-size: 14px; line-height: 22px; }
.exception-two-fields, .exception-side-row, .exception-review-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.exception-choice { display: flex; width: 100%; min-height: 64px; align-items: center; gap: 10px; margin: 0; padding: 8px 0; background: transparent; text-align: left; }
.exception-side { min-height: 44px; margin: 0; padding: 0 10px; border: 1px solid #7c8ea5; border-radius: 10px; background: #fff; color: #123c73; font-size: 14px; }
.exception-side.is-active { border-color: #123c73; background: #eaf2fc; font-weight: 700; }
.exception-readonly { display: flex; width: 100%; min-height: 48px; align-items: center; justify-content: space-between; gap: 8px; padding: 0 12px; border: 1px solid #7c8ea5; border-radius: 12px; background: #fff; color: #18283f; font-size: 14px; line-height: 22px; }
.exception-active { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 12px; padding: 12px; border-radius: 10px; background: #eaf2fc; }
.exception-link { min-width: 44px; min-height: 44px; margin: 0; padding: 0 8px; background: transparent; color: #123c73; font-size: 13px; }
.exception-danger { border: 1px solid #c83f42; background: #fff; color: #c83f42; }
.exception-step { display: flex; min-height: 55px; align-items: center; gap: 8px; }
.exception-step__number { display: flex; width: 20px; height: 20px; flex: none; align-items: center; justify-content: center; border-radius: 10px; background: #eaf2fc; color: #123c73; font-size: 11px; font-weight: 700; }
@media (max-width: 360px) { .exception-tab { padding: 0 4px; font-size: 12px; } .exception-two-fields, .exception-review-actions { grid-template-columns: 1fr; } }
