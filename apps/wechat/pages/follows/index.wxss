.follows-page {
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding-bottom: calc(92px + env(safe-area-inset-bottom));
}
.follows-page > button,
.follows-page > .notice {
  margin: 0;
}
.follows-panel {
  padding: 24px;
  border: 1px solid #e8edf2;
  border-radius: 12px;
  margin: 0;
  overflow-wrap: anywhere;
}
.follow-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.follow-card .subtitle,
.follow-card button {
  margin: 0;
}
.follow-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.follow-state {
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 12px;
  line-height: 20px;
}
.follow-state.active {
  background: #e7f5ee;
  color: #16734b;
}
.follow-state.invalid {
  background: #fff3dc;
  color: #895500;
}
.feedback-title {
  font-size: 14px;
  line-height: 24px;
  font-weight: 500;
  margin-bottom: 4px;
}
.state-panel .muted {
  margin: 8px 0 16px;
}
.skeleton-line {
  height: 12px;
  border-radius: 4px;
  background: #eaf0f7;
  margin-top: 8px;
}
.skeleton-line.short {
  width: 78%;
}

.ui002-workspace { padding:16px 16px calc(104px + env(safe-area-inset-bottom)); background:#f4f6fa; color:#18283f; }
.ui002-workspace .card { border-radius:16px; padding:16px; margin:0 0 16px; }
.ui002-workspace input,.ui002-workspace textarea,.ui002-workspace button { font-size:16px; line-height:24px; min-height:44px; }
.ui002-workspace .page-intro .title { color:#18283f; font-size:22px; line-height:32px; margin:0 0 8px; }
.ui002-workspace .page-intro { margin-bottom:16px; }
.ui002-workspace .tabs button { min-height:44px; }

.ui002-workspace .notice { font-size:14px; line-height:22px; border-radius:12px; padding:12px; }
