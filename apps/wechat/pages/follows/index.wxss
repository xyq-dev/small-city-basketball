.follows-page {
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding-bottom: calc(92px + env(safe-area-inset-bottom));
}
.follows-page > button,
.follows-page > .notice {
  margin: 0;
}
.follows-panel {
  padding: 24px;
  border: 1px solid #e8edf2;
  border-radius: 12px;
  margin: 0;
  overflow-wrap: anywhere;
}
.follow-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.follow-card .subtitle,
.follow-card button {
  margin: 0;
}
.follow-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.follow-state {
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 12px;
  line-height: 20px;
}
.follow-state.active {
  background: #e7f5ee;
  color: #16734b;
}
.follow-state.invalid {
  background: #fff3dc;
  color: #895500;
}
.feedback-title {
  font-size: 14px;
  line-height: 24px;
  font-weight: 500;
  margin-bottom: 4px;
}
.state-panel .muted {
  margin: 8px 0 16px;
}
.skeleton-line {
  height: 12px;
  border-radius: 4px;
  background: #eaf0f7;
  margin-top: 8px;
}
.skeleton-line.short {
  width: 78%;
}
