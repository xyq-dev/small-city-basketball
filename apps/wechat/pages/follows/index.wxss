@import "../../styles/figma-pages.wxss";

.follow-row{display:flex;width:100%;height:55px;align-items:center;gap:8px;border-top:1px solid #e6ebf2}.follow-row:first-of-type{border-top:0}.follow-open{display:flex;min-width:0;min-height:44px;flex:1;align-items:flex-start;justify-content:center;margin:0;padding:0;flex-direction:column;border:0;background:transparent;color:#18283f;text-align:left}.follow-cancel{display:flex;width:62px;min-width:62px;max-width:62px;min-height:44px;flex:none;align-items:center;justify-content:flex-end;margin:0;padding:0;border:0;background:transparent;color:#18283f;font-size:11px}.follow-cancel__pill{display:flex;height:23px;align-items:center;justify-content:center;padding:0 7px;border-radius:7px;background:#fff1e2;white-space:nowrap}.follow-open::after,.follow-cancel::after,.section-ghost::after{border:0}.follows-notice{display:flex;width:100%;min-height:55px;align-items:center;gap:9px;padding:0 10px;border-radius:8px;background:#eaf2fc}.follows-notice__mark{width:7px;height:7px;flex:none;border-radius:4px;background:#123c73}.section-ghost{display:flex;width:100%;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 12px;border:1px solid #7c8ea5;border-radius:22px;background:#fff;color:#123c73;font-size:14px}
.follow-a11y{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
