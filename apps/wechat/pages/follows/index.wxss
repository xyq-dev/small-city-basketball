.follows-page {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding-bottom: calc(164px + env(safe-area-inset-bottom));
}
.follows-page > button,
.follows-page > .notice {
  margin: 0;
}
.follows-panel {
  padding: 14px;
  border: 0;
  border-radius: 16px;
  margin: 0;
  overflow-wrap: anywhere;
}
.follows-page > .fig-summary,.follows-page > .fig-card { margin:0; }
.identity-summary .fig-summary-mark { order:-1; width:44px; height:44px; border-radius:12px; background:#eaf2fc; }
.identity-summary .fig-summary-mark image { width:25px; height:25px; }
.identity-summary .fig-summary-title { color:#18283f; font-size:18px; line-height:26px; }
.identity-summary .fig-kicker,.identity-summary .fig-summary-sub { color:#63758b; }
.follows-reminder-card { margin:0; }
.follows-choice { display:flex; align-items:center; gap:8px; min-height:55px; }
.choice-dot { flex:0 0 18px; width:18px; height:18px; border:1px solid #63758b; border-radius:50%; }
.follows-choice > view:last-child { min-width:0; }
.follows-stop-card .fig-note { display:flex; align-items:center; gap:8px; min-height:55px; margin-top:8px; }
.follows-stop-card .fig-note::before { content:''; flex:0 0 7px; width:7px; height:7px; border-radius:4px; background:#123c73; }
.follow-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.follow-card .subtitle,
.follow-card button {
  margin: 0;
}
.follow-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.follow-state {
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 12px;
  line-height: 20px;
}
.follow-state.active {
  background: #e7f5ee;
  color: #16734b;
}
.follow-state.invalid {
  background: #fff3dc;
  color: #895500;
}
.feedback-title {
  font-size: 14px;
  line-height: 24px;
  font-weight: 500;
  margin-bottom: 4px;
}
.state-panel .muted {
  margin: 8px 0 16px;
}
.skeleton-line {
  height: 12px;
  border-radius: 4px;
  background: #eaf0f7;
  margin-top: 8px;
}
.skeleton-line.short {
  width: 78%;
}

.ui002-workspace { padding:16px 16px calc(164px + env(safe-area-inset-bottom)); background:#f4f6fa; color:#18283f; }
.ui002-workspace .card { border-radius:16px; padding:16px; margin:0 0 16px; }
.ui002-workspace input,.ui002-workspace textarea,.ui002-workspace button { font-size:16px; line-height:24px; min-height:44px; }
.ui002-workspace .page-intro .title { color:#18283f; font-size:22px; line-height:32px; margin:0 0 8px; }
.ui002-workspace .page-intro { margin-bottom:16px; }
.ui002-workspace .tabs button { min-height:44px; }

.ui002-workspace .notice { font-size:14px; line-height:22px; border-radius:12px; padding:12px; }
