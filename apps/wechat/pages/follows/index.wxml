<scb-header title="我的关注" disabled="{{busy}}"/>
<view class="page fig-page follows-page ui002-workspace">
  <view class="fig-summary light identity-summary">
    <view class="fig-summary-copy">
      <view class="fig-kicker">账号</view>
      <view class="fig-summary-title">我的关注</view>
      <view class="fig-summary-sub">关注与微信提醒分开。关注成功只表示可在此处查看。</view>
    </view>
    <view class="fig-summary-mark"><image src="/assets/figma/event.svg" mode="aspectFit"/></view>
  </view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view wx:if="{{error}}" class="notice danger" role="alert"><view class="feedback-title">操作未完成</view><view class="small">{{error}}</view></view>
  <view wx:if="{{loginRequired}}" class="card follows-panel state-panel"><view class="subtitle">登录后查看我的关注</view><view class="muted">关注只属于本人账号；切换账号后只显示新账号的关注。</view><button class="primary" bindtap="login">登录并继续</button></view>
  <view wx:elif="{{loading}}" class="card follows-panel state-panel"><view class="badge">状态反馈</view><view class="subtitle">正在读取我的关注</view><view class="muted">读取完成前不显示旧资料。</view><view class="skeleton-line"></view><view class="skeleton-line short"></view></view>
  <block wx:else>
    <view class="fig-card-title">关注赛事</view>
    <view wx:if="{{!items.length && !error}}" class="fig-note"><view class="fig-row-title">停止公开</view><view class="muted">已停止公开的赛事会单独标出，不再打开旧链接。</view></view>
    <block wx:for="{{items}}" wx:key="followId">
      <view class="card follows-panel follow-card">
        <view class="follow-row"><view class="follow-state {{item.status==='ACTIVE' ? 'active' : 'invalid'}}">{{item.statusLabel}}</view><view wx:if="{{item.event}}" class="small muted">{{item.eventLabel}}</view></view>
        <block wx:if="{{item.status==='ACTIVE'}}">
          <view class="subtitle">{{item.event.name}}</view>
          <view class="muted">{{item.dateLabel}} · {{item.event.purpose==='HISTORY' ? '历史赛事' : '实时观赛'}}</view>
          <button class="secondary" data-id="{{item.publicEventId}}" bindtap="openEvent" disabled="{{busy}}">打开赛事</button>
        </block>
        <block wx:else>
          <view class="fig-card-title">停止公开</view>
          <view class="subtitle">公开赛事已停止公开</view>
          <view class="muted">主办方已撤销或暂停该公开发布，原赛事资料已收回，不再显示；重新公开会使用新的链接，不会继承这条关注。</view>
        </block>
        <button class="quiet" data-id="{{item.followId}}" bindtap="cancel" disabled="{{busy}}" loading="{{cancelling===item.followId}}">{{cancelling===item.followId ? '正在取消' : '取消关注'}}</button>
      </view>
    </block>
    <view wx:if="{{!items.length && !error}}" class="card follows-panel state-panel"><view class="subtitle">暂无关注</view><view class="muted">在主办方分享的公开赛事页可关注赛事。</view></view>
    <view wx:if="{{moreError}}" class="notice warning">{{moreError}}</view>
    <button wx:if="{{nextCursor}}" class="secondary" bindtap="more" disabled="{{loadingMore || busy}}" loading="{{loadingMore}}">{{moreError ? '重试加载更多' : '加载更多关注'}}</button>
  </block>
  <view class="fig-card follows-stop-card"><view class="fig-card-title">停止公开</view><view class="fig-note"><view class="fig-row-title">原赛事已停止公开</view><view class="muted">保留关注记录，但不再显示已撤回的旧资料。</view></view><view class="fig-note"><view class="fig-row-title">赛事恢复公开后</view><view class="muted">刷新可核对最新状态，不沿用已失效链接。</view></view></view>
  <view class="fig-card follows-reminder-card"><view class="fig-card-title">消息与提醒</view><view class="follows-choice"><view class="choice-dot"></view><view><view class="fig-row-title">站内关注</view><view class="muted">查看当前已关注的赛事</view></view></view><view class="follows-choice"><view class="choice-dot"></view><view><view class="fig-row-title">微信订阅提醒</view><view class="muted">{{reminderOff}}</view></view></view></view>
  <button class="quiet" bindtap="load" disabled="{{busy || loading}}">刷新我的关注</button>
</view>
<view class="fig-actions">
  <button wx:if="{{loginRequired}}" class="fig-confirm" bindtap="login">登录并继续</button>
  <block wx:else>
    <button class="fig-ghost" bindtap="load" disabled="{{busy || loading}}">刷新我的关注</button>
    <button class="fig-confirm" bindtap="openFirst" disabled="{{busy || loading || !activeFollowCount}}">打开赛事</button>
  </block>
</view>
<scb-nav active="Account" disabled="{{busy}}"/>
