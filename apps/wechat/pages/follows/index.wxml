<scb-header title="我的关注" disabled="{{busy}}"/>
<view class="figma-page follows-page">
  <view class="figma-page__content figma-page__content--actions">
    <view class="figma-summary"><view class="figma-summary__icon"><figma-icon name="event" size="{{25}}"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">本人订阅</view><view class="figma-title">我关注的赛事</view><view class="figma-subtitle">关注过的公开赛事</view></view></view>
    <figma-feedback wx:if="{{notice}}" type="success" title="关注已更新" body="{{notice}}"/>
    <figma-feedback wx:if="{{error}}" type="error" title="操作未完成" body="{{error}}" action-label="重新读取" bind:action="load"/>
    <figma-feedback wx:if="{{loginRequired}}" type="empty" title="登录后查看我的关注" body="切换账号后只显示新账号的关注。" action-label="登录并继续" bind:action="login"/>
    <view wx:elif="{{loading}}" class="figma-section"><figma-skeleton rows="{{4}}"/></view>
    <block wx:else>
      <view class="figma-section"><view class="figma-section__title">关注赛事</view><figma-feedback wx:if="{{!activeItems.length && !error}}" type="empty" title="暂无关注" body="可在有效公开赛事页关注赛事。"/><view wx:for="{{activeItems}}" wx:key="followId" class="follow-row"><button class="follow-open" data-id="{{item.publicEventId}}" bindtap="openEvent" disabled="{{busy}}"><view class="figma-row__title">{{item.event.name}}</view><view class="figma-row__subtitle">{{item.dateLabel}}</view></button><button class="follow-cancel" aria-label="取消关注" data-id="{{item.followId}}" bindtap="cancel" disabled="{{busy}}"><text class="follow-a11y">关注中</text><view class="follow-cancel__pill">{{cancelling===item.followId ? '处理中' : '已关注'}}</view></button></view></view>
      <view class="figma-section"><view class="figma-section__title">停止公开</view><view class="follows-notice"><view class="follows-notice__mark"/><view class="figma-row__copy"><view class="figma-row__title">原赛事已停止公开</view><view class="figma-row__subtitle">保留关注记录，隐藏旧资料</view></view></view><view class="follows-notice"><view class="follows-notice__mark"/><view class="figma-row__copy"><view class="figma-row__title">赛事恢复公开后</view><view class="figma-row__subtitle">刷新可核对最新状态</view></view></view><view wx:for="{{inactiveItems}}" wx:key="followId" class="follow-row"><view class="follow-open"><view class="figma-row__title">已停止公开的赛事</view><view class="figma-row__subtitle">原公开资料不再显示</view></view><view class="figma-status">已失效</view><button class="follow-cancel" data-id="{{item.followId}}" bindtap="cancel" disabled="{{busy}}">取消关注</button></view></view>
      <view class="figma-section"><view class="figma-section__title">消息与提醒</view><view class="figma-row"><view class="figma-row__mark is-active"/><view class="figma-row__copy"><view class="figma-row__title">站内关注</view><view class="figma-row__subtitle">查看当前已关注的赛事</view></view></view><view class="figma-row"><view class="figma-row__mark"/><view class="figma-row__copy"><view class="figma-row__title">微信订阅提醒</view><view class="figma-row__subtitle">按实际场景单独授权</view></view></view><view class="figma-caption">{{reminderOff}}</view></view>
      <figma-feedback wx:if="{{moreError}}" type="error" title="后续关注读取失败" body="{{moreError}}" action-label="重试加载更多" bind:action="more"/>
      <button wx:if="{{nextCursor}}" class="section-ghost" bindtap="more" disabled="{{loadingMore || busy}}" loading="{{loadingMore}}">加载更多关注</button>
    </block>
  </view>
  <view class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="load" disabled="{{busy || loading}}">刷新我的关注</button><button class="figma-action figma-action--orange" bindtap="openFirst" disabled="{{!activeItems.length || busy}}">打开赛事</button></view>
</view>
