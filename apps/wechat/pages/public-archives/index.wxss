@import "../../styles/figma-pages.wxss";

.archives-summary{background:#eaf2fc}.archives-summary .figma-summary__icon{background:#eaf2fc}.archives-readonly{display:flex;align-items:center}.source-row,.consent-row{display:flex;width:100%;align-items:center;gap:8px}.source-row{min-height:55px;padding:0;border-top:1px solid #e6ebf2}.source-row:first-of-type{border-top:0}.consent-row{min-height:44px;align-items:flex-start;color:#18283f;font-size:13px;line-height:20px}.consent-row switch{flex:none}.archives-notice{display:flex;width:100%;min-height:55px;align-items:center;gap:9px;padding:0 10px;border-radius:8px;background:#eaf2fc}.archives-notice__mark{width:7px;height:7px;flex:none;border-radius:4px;background:#123c73}.choice-tabs{display:grid;height:48px;padding:2px;grid-template-columns:repeat(2,minmax(0,1fr));border-radius:14px;background:#f4f6fa}.choice-tab{display:flex;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 8px;border:0;border-radius:12px;background:transparent;color:#51657d;font-size:13px}.choice-tab::after,.row-action::after,.section-primary::after,.section-ghost::after{border:0}.choice-tab.is-active{background:#123c73;color:#fff;font-weight:700}.row-action{display:flex;min-width:64px;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 8px;border:0;background:transparent;color:#123c73;font-size:13px}.picker-control{display:flex;align-items:center}.section-primary,.section-ghost{display:flex;width:100%;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 12px;border-radius:22px;font-size:14px}.section-primary{background:#123c73;color:#fff}.section-ghost{border:1px solid #7c8ea5;background:#fff;color:#123c73}
.section-danger{display:flex;width:100%;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 12px;border:1px solid #c83f42;border-radius:22px;background:#fff;color:#c83f42;font-size:14px}.section-danger::after{border:0}
.archives-a11y{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.source-action{display:flex;width:62px;min-width:62px;max-width:62px;min-height:44px;flex:none;align-items:center;justify-content:flex-end;margin:0;padding:0;border:0;background:transparent}.source-action::after{border:0}
