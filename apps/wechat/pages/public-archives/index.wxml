<view class="page mgmt-page">
  <view class="card"><view class="subtitle">公开长期档案</view><view class="muted">球员与球队跨届档案须单独授权；同名不会自动关联。</view></view>
  <view wx:if="{{error}}" class="notice warning">{{error}}</view><view wx:if="{{notice}}" class="notice success-notice">{{notice}}</view>
  <view wx:if="{{loginRequired}}" class="card">请先登录后管理公开授权。</view>
  <view wx:elif="{{loading}}" class="card">正在读取授权与档案</view>
  <block wx:else>
    <view wx:if="{{pending}}" class="card"><view>{{pending.label}}结果待核对</view><button bindtap="retry" disabled="{{busy}}">按原编号重试</button></view>
    <view wx:if="{{optionsTruncated}}" class="notice warning">当前管理选择超过页面容量，列表未完整展示；请联系运营按明确档案编号处理。</view>
    <view class="card"><view class="subtitle">独立公开授权</view><view class="muted small">{{disclosureNotice}}</view><switch checked="{{publicConsent}}" data-field="publicConsent" bindchange="consent"/><text>我明确同意发布PUBLIC_ARCHIVE公开档案</text></view>
    <view wx:for="{{profiles}}" wx:key="id" class="card">
      <view class="subtitle">{{item.displayName}} · {{item.kind==='PLAYER'?'球员':'球队'}}</view><button class="quiet" data-id="{{item.id}}" bindtap="editProfile" disabled="{{busy || !!pending}}">修改公开显示名</button><view class="muted">{{item.status==='PUBLISHED'?'已公开':item.status==='REVOKED'?'已撤销':'未发布'}}</view>
      <button wx:if="{{item.status!=='PUBLISHED'}}" class="primary" data-id="{{item.id}}" data-type="PUBLISH" bindtap="profileCommand" disabled="{{busy || !!pending}}">明确授权并发布</button>
      <block wx:else><button class="secondary" data-key="{{item.publicKey}}" bindtap="openPublic">查看公开主页</button><button class="danger" data-id="{{item.id}}" data-type="REVOKE" bindtap="profileCommand" disabled="{{busy || !!pending}}">撤销公开并使旧链接失效</button></block>
      <view wx:for="{{item.sources}}" wx:for-item="source" wx:key="id" class="section"><view>{{source.eventName}} · {{source.teamName}} {{source.memberName || ''}}</view><view class="muted small">{{source.status==='PENDING'?'待本人同意':source.currentlyEffective?'来源有效':'来源当前不可用'}}</view><button wx:if="{{source.canConsent}}" data-id="{{source.id}}" data-type="CONSENT" bindtap="sourceCommand" disabled="{{busy || !!pending}}">本人同意此公开来源</button><button wx:if="{{source.canRevoke}}" data-id="{{source.id}}" data-type="REVOKE" bindtap="sourceCommand" disabled="{{busy || !!pending}}">撤销此来源</button></view>
    </view>
    <view wx:if="{{profileEdit}}" class="card"><text class="field-label">新的公开显示名</text><input class="field" value="{{profileEdit.name}}" bindinput="editName" maxlength="80"/><button class="primary" bindtap="saveProfile" disabled="{{busy || !!pending}}">保存公开显示名</button></view>
    <view wx:for="{{pendingSources}}" wx:key="id" class="card"><view>{{item.eventName}} · {{item.teamName}} · {{item.memberName}}</view><view class="muted">{{item.status==='PENDING'?'独立公共档案来源待本人同意':item.currentlyEffective?'公开来源当前有效':'公开来源当前不可用'}}</view><button wx:if="{{item.canConsent}}" data-id="{{item.id}}" data-type="CONSENT" bindtap="sourceCommand" disabled="{{busy || !!pending}}">本人明确同意公开</button><button wx:if="{{item.canRevoke}}" data-id="{{item.id}}" data-type="REVOKE" bindtap="sourceCommand" disabled="{{busy || !!pending}}">撤销此来源</button></view>
    <view class="card"><view class="subtitle">创建长期档案</view><view class="mode-choice"><button data-kind="PLAYER" bindtap="kind">{{kind==='PLAYER'?'已选择：':''}}本人球员档案</button><button data-kind="TEAM" bindtap="kind">{{kind==='TEAM'?'已选择：':''}}球队档案</button></view><text class="field-label">公开显示名</text><input class="field" value="{{displayName}}" data-field="displayName" bindinput="input" maxlength="80"/><picker wx:if="{{kind==='TEAM'}}" class="field" range="{{teams}}" range-key="name" value="{{teamIndex}}" bindchange="selectTeam">{{teams[teamIndex].name || '请选择管理的球队'}}</picker><button class="primary" bindtap="create" disabled="{{busy || !!pending}}">创建档案草稿</button></view>
    <view wx:if="{{events.length}}" class="card"><view class="subtitle">主办方提名精确公开来源</view><view class="muted small">球员须先建立本人档案和明确身份绑定；提名后仍须本人独立同意。</view><picker class="field" range="{{events}}" range-key="name" value="{{eventIndex}}" bindchange="selectEvent">{{events[eventIndex].name || '选择赛事'}}</picker><button class="secondary" bindtap="selectEvent" data-index="{{eventIndex}}">读取所选赛事身份</button><picker class="field" range="{{options}}" range-key="label" value="{{optionIndex}}" bindchange="selectOption">{{options[optionIndex].label || '请选择精确球员或球队档案'}}</picker><text class="field-label">公开来源原因</text><input class="field" value="{{reason}}" data-field="reason" bindinput="input" maxlength="500"/><switch checked="{{publisherConsent}}" data-field="publisherConsent" bindchange="consent"/><text>本届主办方明确同意公开此精确来源</text><button class="primary" bindtap="nominate" disabled="{{busy || !!pending}}">提交本届公开来源</button></view>
    <button class="secondary" bindtap="rankings">查看公开跨届榜单</button><button class="quiet" bindtap="load" disabled="{{busy}}">重新读取</button>
  </block>
</view>
