<scb-header title="公开档案管理" disabled="{{busy || !!pending}}"/>
<view class="figma-page archives-page">
  <view class="figma-page__content figma-page__content--actions">
    <view class="figma-summary archives-summary"><view class="figma-summary__icon"><figma-icon name="team-archive" size="{{25}}"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">本人授权</view><view class="figma-title">{{primaryProfile ? primaryProfile.displayName + ' · ' + (primaryProfile.kind==='PLAYER' ? '球员档案' : '球队档案') : '公开档案管理'}}</view><view class="figma-subtitle">管理公开显示名和逐条授权来源</view></view></view>
    <view class="archives-a11y">PUBLIC_ARCHIVE 授权可撤销，撤销后旧链接失效</view>
    <figma-feedback wx:if="{{error}}" type="error" title="公开档案读取失败" body="{{error}}" action-label="重新读取" bind:action="load"/>
    <figma-feedback wx:if="{{notice}}" type="success" title="操作已完成" body="{{notice}}"/>
    <figma-feedback wx:if="{{loginRequired}}" type="empty" title="登录后管理公开授权" body="本页只管理当前账号有权处理的公开档案。"/>
    <view wx:if="{{loading}}" class="figma-section"><figma-skeleton rows="{{4}}"/></view>
    <block wx:if="{{!loading && !loginRequired}}">
      <figma-feedback wx:if="{{pending}}" type="pending" title="{{pending.label}}结果待核对" body="使用原请求编号查询，不要重复创建。" action-label="按原编号重试" bind:action="retry"/>
      <figma-feedback wx:if="{{optionsTruncated}}" type="pending" title="管理选项未完整展示" body="当前选择超过页面容量，请按明确档案编号处理。"/>

      <block wx:if="{{primaryProfile}}">
        <view class="figma-section"><view class="figma-section__title">公开设置</view><view class="figma-field-group"><view class="figma-field-label">公开显示名</view><view class="figma-field-control archives-readonly">{{primaryProfile.displayName}}</view></view><view class="figma-field-group"><view class="figma-field-label">主体</view><view class="figma-field-control archives-readonly">{{primaryProfile.kind==='PLAYER' ? '本人球员档案' : '本人管理的球队档案'}}</view></view><view class="figma-field-group"><view class="figma-field-label">公开状态</view><view class="figma-field-control archives-readonly">{{primaryProfile.status==='PUBLISHED' ? '已公开' : primaryProfile.status==='REVOKED' ? '已撤销' : '草稿'}}</view></view></view>
        <view class="figma-section"><view class="figma-section__title">可授权来源</view><figma-feedback wx:if="{{!primaryProfile.sources.length}}" type="empty" title="暂无可授权来源" body="需由有权主办方提名精确赛事来源。"/><view wx:for="{{primaryProfile.sources}}" wx:key="id" wx:for-item="source" class="source-row"><view class="figma-row__copy"><view class="figma-row__title">{{source.displayName || source.eventName}}{{!source.displayName && source.teamName ? ' · ' + source.teamName : ''}}</view><view class="figma-row__subtitle">{{source.summaryLabel || ((source.memberName || '') + ' · ' + (source.status==='PENDING' ? '待本人同意' : source.currentlyEffective ? '来源有效' : '来源不可用'))}}</view></view><button wx:if="{{source.canConsent}}" class="source-action" aria-label="本人同意此来源" data-id="{{source.id}}" data-type="CONSENT" bindtap="sourceCommand" disabled="{{busy || !!pending}}"><view class="figma-status figma-status--orange">{{source.statusLabel || '待同意'}}</view></button><button wx:if="{{source.canRevoke}}" class="source-action" aria-label="撤销此来源" data-id="{{source.id}}" data-type="REVOKE" bindtap="sourceCommand" disabled="{{busy || !!pending}}"><view class="figma-status">撤销</view></button></view></view>
        <view class="figma-section"><view class="figma-section__title">本次授权</view><checkbox-group wx:if="{{primaryProfile.status!=='PUBLISHED'}}" bindchange="consent" data-field="publicConsent"><label class="figma-check"><checkbox value="yes" checked="{{publicConsent}}" disabled="{{busy || !!pending}}"/>本人明确同意公开</label></checkbox-group><view class="archives-notice"><view class="archives-notice__mark"/><view class="figma-row__copy"><view class="figma-row__title">保留撤销权</view><view class="figma-row__subtitle">撤销后旧链接失效，公开资料不再显示</view></view></view><button wx:if="{{primaryProfile.status==='PUBLISHED' && primaryProfile.canRevoke}}" class="section-danger" data-id="{{primaryProfile.id}}" data-type="REVOKE" bindtap="profileCommand" disabled="{{busy || !!pending}}">撤销当前公开授权</button></view>
      </block>
      <figma-feedback wx:else type="empty" title="暂无公开档案草稿" body="可在下方创建本人球员档案或有权球队档案。"/>

      <view wx:if="{{secondaryProfiles.length}}" class="figma-section"><view class="figma-section__title">其他公开档案</view><button wx:for="{{secondaryProfiles}}" wx:key="id" class="figma-row" data-key="{{item.publicKey}}" bindtap="openPublic"><view class="figma-row__copy"><view class="figma-row__title">{{item.displayName}}</view><view class="figma-row__subtitle">{{item.kind==='PLAYER' ? '球员档案' : '球队档案'}}</view></view><view class="figma-status {{item.status==='PUBLISHED' ? 'figma-status--green' : ''}}">{{item.status==='PUBLISHED' ? '已公开' : '草稿'}}</view></button></view>

      <view wx:if="{{profileEdit}}" class="figma-section"><view class="figma-section__title">修改公开显示名</view><view class="figma-field-group"><view class="figma-field-label">新的公开显示名</view><input class="figma-field-control" value="{{profileEdit.name}}" bindinput="editName" maxlength="80"/></view><button class="section-primary" bindtap="saveProfile" disabled="{{busy || !!pending}}">保存显示名</button></view>

      <view wx:if="{{pendingSources.length}}" class="figma-section"><view class="figma-section__title">待处理公开来源</view><view wx:for="{{pendingSources}}" wx:key="id" class="source-row"><view class="figma-row__copy"><view class="figma-row__title">{{item.eventName}} · {{item.teamName}}</view><view class="figma-row__subtitle">{{item.memberName}} · {{item.status==='PENDING' ? '待本人同意' : item.currentlyEffective ? '来源有效' : '来源不可用'}}</view></view><button wx:if="{{item.canConsent}}" class="row-action" data-id="{{item.id}}" data-type="CONSENT" bindtap="sourceCommand" disabled="{{busy || !!pending}}">本人同意</button><button wx:if="{{item.canRevoke}}" class="row-action" data-id="{{item.id}}" data-type="REVOKE" bindtap="sourceCommand" disabled="{{busy || !!pending}}">撤销</button></view></view>

      <view class="figma-section"><view class="figma-section__title">创建长期档案</view><view class="choice-tabs"><button class="choice-tab {{kind==='PLAYER' ? 'is-active' : ''}}" data-kind="PLAYER" bindtap="kind">本人球员档案</button><button class="choice-tab {{kind==='TEAM' ? 'is-active' : ''}}" data-kind="TEAM" bindtap="kind">球队档案</button></view><view class="figma-field-group"><view class="figma-field-label">公开显示名</view><input class="figma-field-control" value="{{displayName}}" data-field="displayName" bindinput="input" maxlength="80"/></view><picker wx:if="{{kind==='TEAM'}}" range="{{teams}}" range-key="name" value="{{teamIndex}}" bindchange="selectTeam"><view class="figma-field-control picker-control">{{teams[teamIndex].name || '请选择管理的球队'}}</view></picker><button class="section-primary" bindtap="create" disabled="{{busy || !!pending}}">创建档案草稿</button></view>

      <view wx:if="{{events.length}}" class="figma-section"><view class="figma-section__title">主办方提名精确来源</view><view class="figma-section__hint">提名后仍须本人独立同意；不会自动关联同名球员。</view><picker range="{{events}}" range-key="name" value="{{eventIndex}}" bindchange="selectEvent"><view class="figma-field-control picker-control">{{events[eventIndex].name || '选择赛事'}}</view></picker><button class="section-ghost" bindtap="selectEvent" data-index="{{eventIndex}}">读取所选赛事身份</button><picker range="{{options}}" range-key="label" value="{{optionIndex}}" bindchange="selectOption"><view class="figma-field-control picker-control">{{options[optionIndex].label || '选择精确球员或球队'}}</view></picker><view class="figma-field-group"><view class="figma-field-label">公开来源原因</view><input class="figma-field-control" value="{{reason}}" data-field="reason" bindinput="input" maxlength="500"/></view><view class="consent-row"><switch checked="{{publisherConsent}}" data-field="publisherConsent" bindchange="consent"/><view>本届主办方明确同意公开此精确来源</view></view><button class="section-primary" bindtap="nominate" disabled="{{busy || !!pending || !publisherConsent || !options.length}}">提交本届公开来源</button></view>
    </block>
  </view>
  <view wx:if="{{primaryProfile}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost" data-id="{{primaryProfile.id}}" bindtap="editProfile" disabled="{{busy || loading}}">修改公开显示名</button><button wx:if="{{primaryProfile.status!=='PUBLISHED'}}" class="figma-action figma-action--orange" data-id="{{primaryProfile.id}}" data-type="PUBLISH" bindtap="profileCommand" disabled="{{busy || !!pending || !publicConsent}}">明确授权并发布</button><button wx:else class="figma-action figma-action--orange" data-key="{{primaryProfile.publicKey}}" bindtap="openPublic">查看公开主页</button></view>
  <view wx:else class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="load" disabled="{{busy || loading}}">重新读取</button><button class="figma-action figma-action--orange" bindtap="rankings" disabled="{{busy}}">查看公开榜单</button></view>
</view>
