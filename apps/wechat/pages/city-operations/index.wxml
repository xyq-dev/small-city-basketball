<view class="page"><scb-header title="城市运营权限"/><view wx:if="{{loginRequired}}"><button bindtap="login">登录</button></view><view wx:if="{{error}}" class="notice warning">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{loading}}">正在读取当前授权…</view><view class="notice">权限按机构、地区范围、具体操作和有效期生效；不授予全城私有资料访问权。</view><view wx:if="{{pending}}" class="card">有原操作待核对<button bindtap="recover">查询原操作</button><button data-cancel="true" bindtap="recover">明确放弃未确认操作</button></view><view class="tabs"><button data-platform="false" bindtap="scope">我的授权</button><button wx:if="{{canManage}}" data-platform="true" bindtap="scope">平台授权维护</button></view>
<view wx:if="{{platform && canManage}}" class="card"><view class="subtitle">授予有限权限</view><input data-field="orgQuery" value="{{orgQuery}}" bindinput="field" placeholder="按机构名称筛选"/><input data-field="userQuery" value="{{userQuery}}" bindinput="field" placeholder="按人员显示名筛选"/><button disabled="{{busy}}" bindtap="load">查询可选人员</button><view wx:if="{{directoryTruncated.people}}" class="notice">人员目录超过100项，请输入显示名缩小范围。</view><view wx:if="{{directoryTruncated.organizations}}" class="notice">本页机构目录最多200项；请输入机构名称缩小范围。</view><picker range="{{organizations}}" range-key="name" value="{{orgIndex}}" data-field="orgIndex" bindchange="picker"><view class="picker">机构：{{organizations[orgIndex].name || '请选择'}}</view></picker><picker range="{{people}}" range-key="displayName" value="{{userIndex}}" data-field="userIndex" bindchange="picker"><view class="picker">人员：{{people[userIndex].displayName || '请选择'}}</view></picker><picker range="{{regions}}" range-key="path" value="{{regionIndex}}" data-field="regionIndex" bindchange="picker"><view class="picker">地区：{{regions[regionIndex].path || '请选择'}}</view></picker><picker range="{{actionNames}}" value="{{actionIndex}}" data-field="actionIndex" bindchange="picker"><view class="picker">操作：{{actionNames[actionIndex]}}</view></picker><picker mode="date" data-field="date" value="{{date}}" bindchange="field"><view class="picker">到期日期：{{date || '请选择'}}</view></picker><picker mode="time" data-field="time" value="{{time}}" bindchange="field"><view class="picker">本机当地时间：{{time}}</view></picker><textarea data-field="reason" value="{{reason}}" bindinput="field" maxlength="500" placeholder="授权或撤销原因，至少4字"/><button disabled="{{busy || !!pending}}" bindtap="create">授予权限</button></view>
<view wx:for="{{items}}" wx:key="id" class="card"><view class="subtitle">{{item.actionLabel}} · {{item.effective?'当前有效':'已失效'}}</view><view>{{item.organizationName}} ／ {{item.regionName}}</view><view>到期：{{item.expiresAt}}</view><view>{{item.reason}}</view><button wx:if="{{platform && canManage && item.status==='ACTIVE'}}" data-id="{{item.id}}" disabled="{{busy || !!pending}}" bindtap="revoke">永久撤销</button></view><view wx:if="{{!loading && !items.length}}" class="notice">当前没有可查看的授权。</view><button wx:if="{{nextCursor}}" disabled="{{busy}}" bindtap="more">读取更多</button><button bindtap="assigned">处理明确分派的工单</button><button disabled="{{busy}}" bindtap="load">刷新</button></view>
