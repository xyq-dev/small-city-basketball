<view class="page">
  <view class="page-title">我的球队</view>
  <view class="notice">球队授权与机构工作人员分开。此处仅展示当前账号有权管理的球队。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{message}}" class="notice warning">{{message}}</view>
  <button wx:if="{{loginRequired}}" class="primary" bindtap="login">登录后查看我的球队</button>
  <picker
    wx:if="{{organizations.length}}"
    range="{{organizations}}"
    range-key="name"
    value="{{orgIndex}}"
    bindchange="selectOrg"
    disabled="{{busy}}"
    ><view class="field">{{organizations[orgIndex].name}} ▾</view></picker
  >
  <view wx:if="{{loading}}" class="muted">正在读取当前授权…</view>
  <view wx:for="{{teams}}" wx:key="id" class="card">
    <view class="row-between"
      ><view class="subtitle">{{item.name}}</view
      ><view class="team-avatar">{{item.name}}</view></view
    >
    <view class="muted">{{item.members.length}}名长期成员 · 本届名单独立保存</view>
    <button class="primary" data-id="{{item.id}}" bindtap="team">进入球队</button>
    <button wx:if="{{item.canRegister}}" class="secondary" data-id="{{item.id}}" bindtap="events">
      选择可报名赛事
    </button>
    <view wx:else class="muted">本届报名需由持本队领队授权的账号操作。</view>
  </view>
  <view wx:if="{{!loading &amp;&amp; !teams.length &amp;&amp; !loginRequired}}" class="card empty"
    >当前暂无可管理球队。请由主办方授予本账号球队权限，或接受发送给本账号的有效邀请。</view
  >
  <button wx:if="{{nextCursor}}" class="secondary" bindtap="more" disabled="{{loading || busy}}">
    加载更多球队
  </button>
  <view wx:if="{{canCreateTeam}}" class="card"
    ><view class="subtitle">创建球队</view
    ><view class="muted">仅当前机构有权管理员可创建，不会自动代替球队领队报名。</view
    ><input
      class="field"
      maxlength="80"
      value="{{newName}}"
      bindinput="input"
      placeholder="球队名称"
      disabled="{{busy || uncertain}}"
    /><button
      class="primary"
      bindtap="create"
      disabled="{{busy || uncertain || !newName}}"
      loading="{{busy}}"
    >
      创建球队
    </button></view
  >
  <button
    wx:if="{{uncertain}}"
    class="secondary"
    bindtap="acknowledgeUnknown"
    disabled="{{busy || loading}}"
  >
    先核对创建结果
  </button>
  <button class="secondary" bindtap="invitation">接受球队邀请</button>
  <button class="quiet" bindtap="load" disabled="{{busy || loading}}">刷新当前授权与球队</button>
</view>
