<scb-header mode="account" title="球队" back="{{false}}" disabled="{{busy || loading || uncertain || newName!==''}}"/>
<view class="figma-page teams-page">
  <view class="figma-page__content figma-page__content--nav">
    <view class="figma-summary teams-summary">
      <view class="figma-summary__icon"><figma-icon name="teams" size="{{25}}"/></view>
      <view class="figma-summary__copy"><view class="figma-eyebrow">我的球队</view><view class="figma-title">{{primaryTeam ? primaryTeam.name : '球队与报名'}}</view><view class="figma-subtitle">{{primaryTeam ? '按当前账号的球队授权显示' : '长期成员、球队授权与本届报名分别管理'}}</view></view>
    </view>

    <view class="teams-tabs"><button class="teams-tab is-active" bindtap="load" disabled="{{busy || loading || uncertain || newName!==''}}">我的球队</button><button class="teams-tab" data-page="public-archive" bindtap="openTeamEntry" disabled="{{busy || loading || uncertain || newName!==''}}">球队广场</button></view>

    <figma-feedback wx:if="{{error}}" type="error" title="暂时无法读取球队" body="{{error}}" action-label="重新读取" bind:action="load"/>
    <figma-feedback wx:if="{{message}}" type="pending" title="操作结果待核对" body="{{message}}"/>
    <figma-feedback wx:if="{{loginRequired}}" type="empty" title="登录后查看我的球队" body="登录不会自动获得球队权限。" action-label="登录并继续" bind:action="login"/>
    <view wx:if="{{loading}}" class="figma-section"><figma-skeleton rows="{{3}}"/></view>

    <view wx:if="{{organizations.length>1}}" class="figma-section"><view class="figma-field-group"><view class="figma-field-label">当前机构</view><picker range="{{organizations}}" range-key="name" value="{{orgIndex}}" bindchange="selectOrg" disabled="{{busy}}"><view class="figma-field-control picker-control">{{organizations[orgIndex].name}}</view></picker></view></view>

    <view wx:if="{{primaryTeam}}" class="figma-section">
      <view class="figma-section__title">球队身份</view>
      <view class="team-metrics">
        <view><text>{{primaryTeam.canRegister ? '领队' : '成员'}}</text><view>我的角色</view></view>
        <view><text>{{primaryTeam.members ? primaryTeam.members.length : 0}} 人</text><view>长期成员</view></view>
        <view><text>{{teamLocationLabel || organizations[orgIndex].name}}</text><view>{{teamLocationLabel ? '所在城市' : '所属机构'}}</view></view>
      </view>
    </view>

    <view class="figma-section">
      <view class="figma-section__title">球队事务</view>
      <view class="figma-grid">
        <button class="figma-grid__item" data-id="{{primaryTeam.id}}" bindtap="team" disabled="{{busy || !primaryTeam}}"><figma-icon name="teams" size="{{20}}"/><view class="figma-row__title">球队主页与成员</view><view class="figma-row__subtitle">查看长期成员</view></button>
        <button class="figma-grid__item" data-id="{{primaryTeam.id}}" bindtap="events" disabled="{{busy || !primaryTeam || !primaryTeam.canRegister}}"><figma-icon name="registration" size="{{20}}"/><view class="figma-row__title">本届赛事报名</view><view class="figma-row__subtitle">选择可报名赛事</view></button>
        <button class="figma-grid__item" bindtap="invitation" disabled="{{busy}}"><figma-icon name="workbench" size="{{20}}"/><view class="figma-row__title">邀请与加入</view><view class="figma-row__subtitle">处理本账号邀请</view></button>
        <button class="figma-grid__item" data-page="team-request" bindtap="openTeamEntry" disabled="{{busy || loading || uncertain || newName!==''}}"><figma-icon name="workbench" size="{{20}}"/><view class="figma-row__title">申请建队</view><view class="figma-row__subtitle">提交至选定机构</view></button>
      </view>
    </view>

    <view class="figma-section">
      <view class="figma-section__title">我的球队</view>
      <button wx:for="{{teams}}" wx:key="id" class="figma-row" data-id="{{item.id}}" bindtap="team" disabled="{{busy || loading || uncertain || newName!==''}}"><view class="figma-row__copy"><view class="figma-row__title">{{item.name}}</view><view class="figma-row__subtitle">{{organizations[orgIndex].name}} · {{item.canRegister ? '领队' : '已授权成员'}}</view></view><view class="figma-status figma-status--orange">已授权</view></button>
      <figma-feedback wx:if="{{!loading && !teams.length && !loginRequired && !error}}" type="empty" title="暂无可管理球队" body="可申请建队、输入加入码或接受发给本账号的邀请。" action-label="接受球队邀请" bind:action="invitation"/>
      <button wx:if="{{nextCursor}}" class="wide-ghost" bindtap="more" disabled="{{loading || busy}}" loading="{{loading}}">加载更多球队</button>
    </view>

    <view class="figma-section"><view class="figma-section__title">相关服务</view><button class="figma-row" data-page="team-join" bindtap="openTeamEntry" disabled="{{busy || loading || uncertain || newName!==''}}"><figma-icon name="join" size="{{20}}"/><view class="figma-row__copy"><view class="figma-row__title teams-related-title">输入球队加入码</view></view></button></view>

    <view wx:if="{{canCreateTeam}}" class="figma-section">
      <view class="figma-section__title">创建球队</view><view class="figma-section__hint">仅当前机构有权管理员可创建，不会自动代替球队领队报名。</view>
      <view class="figma-field-group"><view class="figma-field-label">球队名称</view><input class="figma-field-control" maxlength="80" value="{{newName}}" bindinput="input" placeholder="填写球队名称" disabled="{{busy || uncertain}}"/></view>
      <button class="wide-primary" bindtap="create" disabled="{{busy || uncertain || !newName}}" loading="{{busy}}">创建球队</button>
      <button wx:if="{{newName && !uncertain}}" class="wide-ghost" bindtap="cancelDraft" disabled="{{busy}}">取消输入</button>
    </view>
    <button wx:if="{{uncertain}}" class="wide-primary" bindtap="acknowledgeUnknown" disabled="{{busy || loading}}">先核对创建结果</button>
    <view class="figma-section"><view class="figma-row"><figma-icon name="shield" size="{{22}}"/><view class="figma-row__copy"><view class="figma-row__title">球队授权与机构身份分开</view><view class="figma-row__subtitle">球队广场只展示已授权公开档案，不授予成员或报名权限。</view></view></view></view>

    <view class="teams-actions"><button class="figma-action figma-action--ghost" data-id="{{primaryTeam.id}}" bindtap="events" disabled="{{busy || !primaryTeam || !primaryTeam.canRegister}}">选择可报名赛事</button><button class="figma-action figma-action--orange" data-id="{{primaryTeam.id}}" bindtap="team" disabled="{{busy || !primaryTeam}}">进入球队</button></view>
  </view>
</view>
<scb-nav active="Teams" disabled="{{busy}}"/>
