<view class="page teams-page" style="padding-top:0">
 <v3-chrome title="球队" tools="{{false}}"/>
 <view class="fig-summary soft">
  <image class="fig-summary-icon" src="/assets/figma/teams.svg" mode="aspectFit"/>
  <view class="fig-summary-copy">
   <view class="fig-kicker">我的球队</view>
   <view wx:if="{{teams.length}}" class="fig-summary-title">{{teams[0].name}}</view>
   <view wx:elif="{{loginRequired}}" class="fig-summary-title">登录后查看我的球队</view>
   <view wx:elif="{{loading}}" class="fig-summary-title">正在读取当前授权</view>
   <view wx:else class="fig-summary-title">暂无可管理球队</view>
   <view class="fig-summary-sub">按当前账号的球队授权显示</view>
  </view>
 </view>
 <view class="teams-tabs"><button class="selected" bindtap="load" disabled="{{busy || loading || uncertain || newName !== ''}}">我的球队</button><button data-page="public-archive" bindtap="openTeamEntry" disabled="{{busy || loading || uncertain || newName !== ''}}">球队广场</button><button class="teams-add" data-page="team-request" bindtap="openTeamEntry" aria-label="申请建队" disabled="{{busy || loading || uncertain || newName !== ''}}"><scb-icon name="plus" size="22" tone="navy"/></button></view>
 <view wx:if="{{error}}" class="notice danger" role="alert"><view class="feedback-title">暂时无法读取球队</view><view class="small">{{error}}</view></view>
 <view wx:if="{{message}}" class="notice warning">{{message}}</view>
 <view wx:if="{{loginRequired}}" class="card team-panel state-panel team-welcome"><view class="team-welcome-icon"><scb-icon name="users" size="32" tone="white"/></view><view class="team-welcome-kicker">你的球队，从这里开始</view><view class="subtitle">登录后查看我的球队</view><view class="muted">查看球队成员、处理报名与邀请，继续你和队友的下一场。</view><button class="primary" bindtap="login">登录并继续</button><view class="team-welcome-note">登录不自动获得球队权限。</view></view>
 <picker wx:if="{{organizations.length > 1}}" range="{{organizations}}" range-key="name" value="{{orgIndex}}" bindchange="selectOrg" disabled="{{busy}}"><view class="field">{{organizations[orgIndex].name}} ▾</view></picker>
 <view wx:if="{{loading}}" class="card team-panel state-panel"><view class="subtitle">正在读取当前授权</view><view class="muted">读取完成前，不显示过期球队资料。</view><view class="skeleton-line"></view><view class="skeleton-line short"></view></view>
 <view class="fig-card-title">球队身份</view>
 <block wx:for="{{teams}}" wx:key="id">
  <view class="card team-profile"><view class="team-profile-top"><view class="team-profile-label">MY TEAM · 我的球队</view><view class="team-profile-badge">{{item.canRegister ? '领队授权' : '当前可访问'}}</view></view><view class="team-person"><view class="team-avatar"><scb-icon name="users" size="28" tone="white"/></view><view class="team-identity-copy"><view class="team-name">{{item.name}}</view><view class="team-meta">{{item.members ? item.members.length + '名长期成员' : '成员资料待读取'}} · {{item.canRegister ? '领队报名授权' : '报名需独立领队授权'}}</view></view></view><view class="team-profile-foot"><scb-icon name="shield" size="16" tone="white"/><view>长期成员与本届赛事报名名单分别保存。</view></view></view>
  <view class="card team-transactions"><view class="subtitle">球队事务</view><button class="team-cell" data-id="{{item.id}}" bindtap="team" disabled="{{busy || loading || uncertain || newName !== ''}}"><scb-icon name="users" size="22"/><view class="team-cell-copy"><view>球队主页与成员</view><view class="muted">进入球队，管理本人当前授权内容</view></view><image class="team-chevron" src="/assets/ui002/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></button><button wx:if="{{item.canRegister}}" class="team-cell" data-id="{{item.id}}" bindtap="events" disabled="{{busy || loading || uncertain || newName !== ''}}"><scb-icon name="trophy" size="22"/><view class="team-cell-copy"><view>本届赛事报名</view><view class="muted">选择可报名赛事</view></view><image class="team-chevron" src="/assets/ui002/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></button><view wx:else class="team-copy">本届报名需由持本队领队授权的账号操作。</view><button class="team-cell" bindtap="invitation" disabled="{{busy || loading || uncertain || newName !== ''}}"><scb-icon name="plus" size="22"/><view class="team-cell-copy"><view>邀请与加入</view><view class="muted">接受发送给本账号的有效邀请</view></view><image class="team-chevron" src="/assets/ui002/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></button></view>
 </block>
 <view wx:if="{{!loading && !teams.length && !loginRequired && !error}}" class="card team-panel state-panel"><view class="subtitle">暂无可管理球队</view><view class="muted">可向机构申请建队、输入加入码，或接受本账号的有效邀请。</view><button class="secondary" bindtap="invitation">接受球队邀请</button></view>
 <view class="fig-card-title">相关服务</view>
 <view class="teams-section-heading">找到你的球队</view>
 <view class="teams-actions"><button class="secondary" data-page="team-request" bindtap="openTeamEntry" disabled="{{busy || loading || uncertain || newName !== ''}}">向机构申请建队</button><button class="secondary" data-page="team-join" bindtap="openTeamEntry" disabled="{{busy || loading || uncertain || newName !== ''}}">输入球队加入码</button></view>
 <button wx:if="{{nextCursor}}" class="secondary team-action" bindtap="more" disabled="{{loading || busy}}">加载更多球队</button>
 <view class="team-discover"><view class="team-discover-copy"><view class="team-discover-label">认识更多球队</view><view class="team-discover-title">热爱，不止一支队</view><view class="muted">查看已授权公开的球队档案。</view></view><button class="team-discover-action" data-page="public-archive" bindtap="openTeamEntry" disabled="{{busy || loading || uncertain || newName !== ''}}" aria-label="浏览球队广场"><scb-icon name="chevron-right" size="22" tone="navy"/></button></view>
 <view class="notice team-access"><view class="feedback-title">球队授权与机构工作人员分开</view><view class="small">球队广场展示已授权公开档案；不会授予球队成员或报名权限。</view></view>
 <view wx:if="{{canCreateTeam}}" class="card team-panel create-team"><view class="subtitle">创建球队</view><view class="muted">仅当前机构有权管理员可创建，不会自动代替球队领队报名。</view><view class="field-label">球队名称</view><input class="field" maxlength="80" value="{{newName}}" bindinput="input" placeholder="填写球队名称" disabled="{{busy || uncertain}}"/><button class="primary" bindtap="create" disabled="{{busy || uncertain || !newName}}" loading="{{busy}}">创建球队</button></view>
 <button wx:if="{{newName && !uncertain}}" class="quiet" bindtap="cancelDraft" disabled="{{busy}}">取消创建输入</button><button wx:if="{{uncertain}}" class="secondary team-action" bindtap="acknowledgeUnknown" disabled="{{busy || loading}}">先核对创建结果</button><button class="quiet" bindtap="load" disabled="{{busy || loading}}">刷新当前授权与球队</button>
</view><scb-nav active="Teams" disabled="{{busy || loading || uncertain || newName !== ''}}"/>
