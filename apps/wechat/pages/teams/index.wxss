@import "../../styles/figma-pages.wxss";

.teams-summary{background:#eaf2fc}.teams-summary .figma-summary__icon{background:#eaf2fc}.teams-tabs{display:grid;height:48px;padding:2px 3px;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;border-radius:12px;background:#fff}.teams-tab{display:flex;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 12px;border:0;border-radius:10px;background:transparent;color:#51657d;font-size:13px;line-height:19px}.teams-tab::after,.wide-primary::after,.wide-ghost::after{border:0}.teams-tab.is-active{background:#123c73;color:#fff;font-weight:700}.teams-tab[disabled]{background:#e6ebf2;color:#7c8ea5}.picker-control{display:flex;align-items:center;justify-content:space-between}.team-metrics{display:grid;width:100%;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.team-metrics>view{display:flex;min-width:0;padding:10px;flex-direction:column;gap:4px;border-radius:10px;background:#f4f6fa}.team-metrics text{overflow:hidden;color:#123c73;font-size:21px;font-weight:700;line-height:30px;text-overflow:ellipsis;white-space:nowrap}.team-metrics view view{color:#51657d;font-size:12px;line-height:17px}.teams-related-title{color:#123c73}.wide-primary,.wide-ghost{display:flex;width:100%;min-height:48px;align-items:center;justify-content:center;margin:0;padding:0 16px;border-radius:24px;font-size:16px}.wide-primary{border:0;background:#123c73;color:#fff}.wide-ghost{border:1px solid #7c8ea5;background:#fff;color:#123c73}.wide-primary[disabled],.wide-ghost[disabled]{border-color:#e6ebf2;background:#e6ebf2;color:#7c8ea5}.teams-actions{display:grid;width:100%;height:56px;align-items:center;grid-template-columns:140px minmax(0,1fr);gap:8px}@media(max-width:360px){.team-metrics{gap:6px}.team-metrics>view{padding:8px}.team-metrics text{font-size:18px}.teams-actions{grid-template-columns:128px minmax(0,1fr)}.teams-actions .figma-action{font-size:14px}}
