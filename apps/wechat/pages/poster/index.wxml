<view class="page"><view class="title">授权赛事海报</view><view class="notice">每次生成和下载均核对当前公开来源、赛果和逐人宣传许可；仅当前有权人员可下载。保存或转发后的图片无法保证追回。</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view><button wx:if="{{loginRequired}}" bindtap="login">登录</button><button bindtap="load" disabled="{{busy||loading}}">重新读取</button>
<view wx:if="{{pending}}" class="card"><view>待核对原请求{{pending.body.clientRequestId}}</view><button bindtap="recover" disabled="{{busy}}">查询原回执</button><button bindtap="recover" data-replay="yes" disabled="{{busy}}">原编号重试</button></view>
<view wx:if="{{workspace}}" class="card"><view class="title">{{workspace.event.name}}</view><view>{{workspace.notice}}</view><picker range="{{labels}}" bindchange="kind" disabled="{{busy||pending}}"><view class="field">海报类型：{{kind}}（点击选择）</view></picker><picker wx:if="{{kind==='ROSTER'}}" range="{{workspace.participants}}" range-key="teamName" bindchange="entry" disabled="{{busy||pending}}"><view class="field">球队：{{entryName||'点击选择本届冻结球队'}}</view></picker><picker wx:if="{{kind==='MATCHUP'||kind==='RESULT'}}" range="{{workspace.matches}}" range-key="displayName" bindchange="match" disabled="{{busy||pending}}"><view class="field">比赛：{{matchName||'点击选择正式比赛'}}</view></picker><view wx:if="{{kind==='ROSTER'}}">使用逐人已授权照片 <switch checked="{{includePortraits}}" bindchange="portraits" disabled="{{busy||pending}}"/></view><view wx:if="{{kind==='ROSTER'}}">未授权或当前资料不符的队员会从宣传海报中省略；不提供身份证明、签字或保单。</view><button bindtap="generate" disabled="{{busy||pending||!workspace.capabilities.canGenerate}}">生成当前授权海报</button><view wx:if="{{!workspace.capabilities.canGenerate}}">请先正式发布本届观赛内容。</view></view>
<view wx:if="{{workspace}}" class="card"><view class="title">本届导出记录</view><textarea placeholder="撤销理由（至少4字）" value="{{reason}}" bindinput="reason" maxlength="500" disabled="{{busy||pending}}"/><view wx:for="{{workspace.exports}}" wx:key="id" class="row"><view>{{item.kind}} · {{item.width}}×{{item.height}}</view><view>有效至{{item.expiresAt}}{{item.revokedAt?' · 已撤销':''}}</view><button bindtap="image" data-id="{{item.id}}" disabled="{{busy||pending||item.revokedAt}}">重新核权并预览</button><button bindtap="image" data-id="{{item.id}}" data-save="yes" disabled="{{busy||pending||item.revokedAt}}">重新核权并保存相册</button><button bindtap="revoke" data-id="{{item.id}}" disabled="{{busy||pending||item.revokedAt}}">撤销本次导出</button></view><view wx:if="{{workspace.historyTruncated}}">仅展示最近100笔记录。</view></view></view>
