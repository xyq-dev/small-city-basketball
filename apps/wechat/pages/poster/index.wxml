<scb-header title="授权赛事海报" disabled="{{busy || !!pending}}"/>
<view class="figma-page poster-page">
  <view class="figma-page__content figma-page__content--actions">
    <view class="poster-preview"><image src="/assets/home/hero.jpg" mode="aspectFill"/><view class="poster-preview__copy"><view>{{workspace ? workspace.event.name + ' · ' + kindLabel : '城市邀请赛 · 赛程海报'}}</view></view></view>
    <figma-feedback wx:if="{{error}}" type="error" title="海报操作未完成" body="{{error}}" action-label="重新读取" bind:action="load"/>
    <figma-feedback wx:if="{{message}}" type="success" title="状态已更新" body="{{message}}"/>
    <figma-feedback wx:if="{{loginRequired}}" type="empty" title="登录后继续" body="仅当前有权人员可生成或下载。" action-label="登录" bind:action="login"/>
    <view wx:if="{{loading}}" class="figma-section"><figma-skeleton rows="{{4}}"/></view>
    <view wx:if="{{pending}}" class="figma-section"><figma-feedback type="pending" title="原请求结果待核对" body="请求编号：{{pending.body.clientRequestId}}"/><view class="two-actions"><button class="section-ghost" bindtap="recover" disabled="{{busy}}">查询原回执</button><button class="section-primary" bindtap="recover" data-replay="yes" disabled="{{busy}}">原编号重试</button></view></view>
    <view wx:if="{{workspace}}" class="figma-section"><view class="figma-section__title">海报内容</view><view class="figma-field-group"><view class="figma-field-label">比赛</view><view class="figma-field-control poster-readonly">{{matchName || entryName || workspace.event.name}}</view></view><view class="figma-field-group"><view class="figma-field-label">日期与场馆</view><view class="figma-field-control poster-readonly">{{workspace.posterDateLabel || workspace.event.startDate || '以本届正式赛程为准'}}{{workspace.posterDateLabel ? '' : (workspace.event.endDate ? '—' + workspace.event.endDate : '')}}</view></view></view>
    <view wx:if="{{workspace}}" class="figma-section"><view class="figma-section__title">授权核对</view><view class="poster-auth-row"><view class="poster-check is-checked"/><view class="figma-row__copy"><view class="figma-row__title">已发布赛事资料</view><view class="figma-row__subtitle">来源当前有效</view></view><view class="figma-status figma-status--orange">{{workspace.capabilities.canGenerate ? '已公开' : '未开放'}}</view></view><view class="poster-auth-row"><switch type="checkbox" checked="{{includePortraits}}" bindchange="portraits" disabled="{{busy || !!pending || kind!=='ROSTER'}}"/><view class="figma-row__copy"><view class="figma-row__title">使用逐人已授权照片</view><view class="figma-row__subtitle">选中前逐人核权</view></view><view class="figma-status">{{includePortraits ? '已勾选' : '未勾选'}}</view></view></view>
    <view wx:if="{{workspace}}" class="figma-section"><view class="figma-section__title">生成设置</view><view class="figma-section__hint">{{workspace.notice}}</view><view class="figma-field-group"><view class="figma-field-label">海报类型</view><picker range="{{labels}}" bindchange="kind" disabled="{{busy || !!pending}}"><view class="figma-field-control picker-control">{{kindLabel}}</view></picker></view><view wx:if="{{kind==='ROSTER'}}" class="figma-field-group"><view class="figma-field-label">本届冻结球队</view><picker range="{{workspace.participants}}" range-key="teamName" bindchange="entry" disabled="{{busy || !!pending}}"><view class="figma-field-control picker-control">{{entryName || '点击选择球队'}}</view></picker></view><view wx:if="{{kind==='MATCHUP' || kind==='RESULT'}}" class="figma-field-group"><view class="figma-field-label">正式比赛</view><picker range="{{workspace.matches}}" range-key="displayName" bindchange="match" disabled="{{busy || !!pending}}"><view class="figma-field-control picker-control">{{matchName || '点击选择比赛'}}</view></picker></view><figma-feedback wx:if="{{!workspace.capabilities.canGenerate}}" type="pending" title="当前不能生成" body="请先正式发布本届观赛内容。"/></view>
    <figma-feedback wx:if="{{workspace}}" type="pending" title="每次生成都重新核权" body="只使用当前有效的公开来源、赛果与逐人宣传许可；保存或转发后的图片无法保证追回。"/>
    <view id="poster-exports" wx:if="{{workspace}}" class="figma-section"><view class="figma-section__title">本届导出记录</view><view class="figma-field-group"><view class="figma-field-label">撤销理由</view><textarea class="figma-field-control" value="{{reason}}" bindinput="reason" maxlength="500" disabled="{{busy || !!pending}}" placeholder="至少4字"/></view><figma-feedback wx:if="{{!workspace.exports.length}}" type="empty" title="暂无导出记录"/><view wx:for="{{workspace.exports}}" wx:key="id" class="export-row"><view class="profile-head"><view><view class="figma-row__title">{{item.kind}} · {{item.width}}×{{item.height}}</view><view class="figma-row__subtitle">有效至 {{item.expiresAt}}</view></view><view class="figma-status {{item.revokedAt ? 'figma-status--error' : 'figma-status--green'}}">{{item.revokedAt ? '已撤销' : '有效'}}</view></view><view class="export-actions"><button class="row-action" bindtap="image" data-id="{{item.id}}" disabled="{{busy || !!pending || item.revokedAt}}">预览</button><button class="row-action" bindtap="image" data-id="{{item.id}}" data-save="yes" disabled="{{busy || !!pending || item.revokedAt}}">保存相册</button><button class="row-action row-action--danger" bindtap="revoke" data-id="{{item.id}}" disabled="{{busy || !!pending || item.revokedAt}}">撤销</button></view></view><view wx:if="{{workspace.historyTruncated}}" class="figma-caption">仅展示最近100笔记录。</view></view>
  </view>
  <view class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="scrollExports" disabled="{{busy || loading}}">查看导出记录</button><button class="figma-action figma-action--orange" bindtap="generate" disabled="{{busy || !!pending || !workspace || !workspace.capabilities.canGenerate}}" loading="{{busy}}">生成当前授权海报</button></view>
</view>
