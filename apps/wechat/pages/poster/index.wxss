.page{padding:28rpx;background:#f2f5f9;min-height:100vh;color:#173553}.title{font-size:36rpx;font-weight:600;margin:16rpx 0}.card{background:#fff;padding:24rpx;border-radius:16rpx;margin:24rpx 0}.notice{padding:20rpx;background:#e8f1ff;line-height:1.7}.error{padding:16rpx;color:#a62424;background:#fff0ed}.row{padding:20rpx 0;border-bottom:1rpx solid #dce5ef}input,textarea{box-sizing:border-box;border:1rpx solid #c9d5e4;padding:16rpx;margin:18rpx 0;width:100%;background:#fff}textarea{min-height:140rpx}button{margin:18rpx 0;font-size:28rpx}

/* Keep native form text and touch targets readable at every supported screen width. */
input, textarea, button { font-size: 16px; line-height: 24px; min-height: 44px; }

.ui002-workspace { padding:16px 16px calc(104px + env(safe-area-inset-bottom)); background:#f4f6fa; color:#18283f; }
.ui002-workspace .card { border-radius:16px; padding:16px; margin:0 0 16px; }
.ui002-workspace input,.ui002-workspace textarea,.ui002-workspace button { font-size:16px; line-height:24px; min-height:44px; }
.ui002-workspace .page-intro .title { color:#18283f; font-size:22px; line-height:32px; margin:0 0 8px; }
.ui002-workspace .page-intro { margin-bottom:16px; }
.ui002-workspace .tabs button { min-height:44px; }

.ui002-workspace .notice { font-size:14px; line-height:22px; border-radius:12px; padding:12px; }
