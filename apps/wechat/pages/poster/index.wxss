@import "../../styles/figma-pages.wxss";

.poster-preview{position:relative;width:100%;height:174px;overflow:hidden;border-radius:16px;background:#123c73}.poster-preview image{width:100%;height:117px}.poster-preview__copy{position:absolute;right:0;bottom:0;left:0;display:flex;height:57px;align-items:center;justify-content:space-between;padding:0 16px;background:#123c73;color:#fff}.poster-preview__copy view{font-size:16px;font-weight:700}.poster-preview__copy text{color:#dce7f5;font-size:11px}.picker-control{display:flex;align-items:center}.consent-row,.profile-head{display:flex;width:100%;align-items:center;gap:8px}.consent-row{min-height:44px;align-items:flex-start;color:#18283f;font-size:13px;line-height:20px}.profile-head{min-height:44px;justify-content:space-between}.section-primary,.section-ghost,.row-action{display:flex;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 12px;border-radius:22px;font-size:14px}.section-primary,.section-ghost{width:100%}.section-primary{border:0;background:#123c73;color:#fff}.section-ghost{border:1px solid #7c8ea5;background:#fff;color:#123c73}.row-action{min-width:0;border:0;background:#eaf2fc;color:#123c73}.row-action--danger{background:#fdecef;color:#c83f42}.section-primary::after,.section-ghost::after,.row-action::after{border:0}.two-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.export-row{padding:8px 0;border-top:1px solid #e6ebf2}.export-actions{display:grid;margin-top:8px;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}
.poster-preview__copy{justify-content:flex-start}.poster-readonly{display:flex;align-items:center}.poster-auth-row{display:flex;width:100%;min-height:55px;align-items:center;gap:8px}.poster-auth-row+.poster-auth-row{border-top:1px solid #e6ebf2}.poster-check{width:20px;height:20px;flex:none;border:1px solid #7c8ea5;border-radius:4px;background:#fff}.poster-check.is-checked{border:6px solid #123c73}
