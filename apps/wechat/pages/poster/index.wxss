.poster-page { display:flex; flex-direction:column; gap:12px; padding:12px 16px calc(116px + env(safe-area-inset-bottom)); color:#18283f; background:#f4f6fa; }
.poster-page > .card,.poster-page > .notice,.poster-page > .error,.poster-page > button { margin:0; }
.poster-hero { position:relative; height:174px; overflow:hidden; border-radius:16px; background:#123c73; }
.poster-hero image { display:block; width:100%; height:116px; }
.poster-hero::after { content:''; position:absolute; left:0; right:0; top:0; height:116px; background:linear-gradient(90deg,rgba(18,60,115,.15),rgba(18,60,115,.02)); pointer-events:none; }
.poster-hero-title { position:absolute; left:0; right:0; bottom:0; min-height:58px; padding:14px; color:#fff; background:#123c73; font-size:18px; line-height:28px; font-weight:700; overflow-wrap:anywhere; }
.poster-notice { padding:10px 12px; font-size:12px; line-height:20px; }
.poster-panel { padding:14px; border-radius:16px; box-shadow:none; }
.poster-panel .title { margin:0 0 8px; color:#18283f; font-size:18px; line-height:26px; }
.poster-panel .field,.poster-panel textarea { box-sizing:border-box; width:100%; min-height:44px; margin:8px 0 12px; padding:10px 12px; border:0; border-radius:8px; background:#f4f6fa; color:#18283f; font-size:14px; line-height:22px; }
.poster-toggle { display:flex; align-items:flex-start; gap:8px; min-height:55px; margin:8px 0; padding:10px 0; border-bottom:1px solid #e6ebf2; }
.poster-toggle switch { flex:none; transform:scale(.78); transform-origin:left top; }
.poster-panel button { min-height:44px; margin:8px 0 0; font-size:14px; line-height:22px; }
.export-row { padding:12px 0; border-bottom:1px solid #e6ebf2; }
.export-row button { margin-top:8px; }
.ui002-workspace .card { margin:0; padding:14px; border-radius:16px; }
.ui002-workspace .notice { padding:10px 12px; border-radius:8px; font-size:12px; line-height:20px; }
@media(max-width:360px) { .poster-page { padding-left:12px; padding-right:12px; } .poster-hero { height:166px; } .poster-hero image { height:108px; } }
