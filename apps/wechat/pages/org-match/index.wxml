<scb-header title="比赛管理" disabled="{{busy || !!pending}}"/>

<view class="figma-page org-match-page">
  <view class="figma-page__content figma-page__content--actions">
    <view wx:if="{{loading && !match}}" class="figma-section"><figma-skeleton rows="5"/><view class="figma-caption">正在核对当前身份可查看的比分、记录与确认状态</view></view>
    <figma-feedback
      wx:elif="{{!match}}"
      type="{{unavailable ? 'pending' : 'error'}}"
      title="{{unavailable ? '无法查看该比赛' : '比赛资料读取失败'}}"
      body="{{error || '请从赛事赛程重新进入。'}}"
      action-label="{{unavailable ? '' : '重新读取'}}"
      bind:action="refresh"
    />

    <block wx:else>
      <figma-feedback wx:if="{{error && !pending}}" type="error" title="本页操作未完成" body="{{error}}"/>
      <figma-feedback wx:if="{{notice}}" type="success" title="操作已完成" body="{{notice}}"/>
      <figma-feedback wx:if="{{pending}}" type="pending" title="{{pending.label}} · 结果待核对" body="保留原操作编号。先核对服务端结果；只有确认未执行时才按原编号重发。"/>
      <view wx:if="{{pending}}" class="org-match-pending-actions">
        <button class="figma-action figma-action--navy" bindtap="checkPending" disabled="{{busy}}">核对结果</button>
        <button class="figma-action figma-action--ghost" bindtap="resendPending" disabled="{{busy}}">按原编号重发</button>
      </view>

      <view class="figma-summary">
        <view class="figma-summary__icon"><figma-icon name="scoreboard" size="25"/></view>
        <view class="figma-summary__copy">
          <view class="figma-eyebrow">赛事工作台{{match.eventName ? ' · ' + match.eventName : ''}}</view>
          <view class="figma-title">比赛管理</view>
          <view class="figma-subtitle">{{match.summarySubtitle || (match.round + ' · ' + match.time + ' · ' + match.court)}}</view>
        </view>
      </view>

      <view class="org-match-tabs" role="tablist">
        <button class="org-match-tab {{matchTab === 'score' ? 'is-active' : ''}}" data-tab="score" bindtap="changeMatchTab">比分</button>
        <button class="org-match-tab {{matchTab === 'staff' ? 'is-active' : ''}}" data-tab="staff" bindtap="changeMatchTab">工作人员</button>
        <button class="org-match-tab {{matchTab === 'confirmations' ? 'is-active' : ''}}" data-tab="confirmations" bindtap="changeMatchTab">确认记录</button>
      </view>

      <figma-feedback wx:if="{{match.adjudication}}" type="pending" title="{{match.statusLabel}}" body="本场不生成比赛比分或个人统计；请查看独立裁定记录。"/>

      <view id="match-score" class="figma-section org-match-score-section">
        <view class="org-match-section-head"><view class="figma-section__title">分节得分</view><view wx:if="{{!hideScoreStatus}}" class="figma-status {{match.status === 'LIVE' ? 'figma-status--error' : 'figma-status--orange'}}">{{match.statusLabel}}</view></view>
        <view wx:if="{{board}}" class="org-match-score-grid">
          <view class="org-match-score-card is-home">
            <view class="org-match-team">{{board.home.name || match.home}}</view>
            <view class="org-match-score">{{board.home.score}}</view>
            <view class="org-match-periods"><text wx:for="{{board.periods}}" wx:key="key">{{index ? ' · ' : ''}}{{item.home}}</text></view>
          </view>
          <view class="org-match-score-card is-away">
            <view class="org-match-team">{{board.away.name || match.away}}</view>
            <view class="org-match-score">{{board.away.score}}</view>
            <view class="org-match-periods"><text wx:for="{{board.periods}}" wx:key="key">{{index ? ' · ' : ''}}{{item.away}}</text></view>
          </view>
        </view>
        <view wx:else class="org-match-score-grid">
          <view class="org-match-score-card is-home"><view class="org-match-team">{{match.home}}</view><view class="org-match-score">–</view></view>
          <view class="org-match-score-card is-away"><view class="org-match-team">{{match.away}}</view><view class="org-match-score">–</view></view>
        </view>
        <view wx:if="{{board && !hideBoardHint}}" class="figma-section__hint">{{board.periodLabel}} · {{board.clockLabel}} · 犯规 {{board.home.fouls}} : {{board.away.fouls}} · 暂停 {{board.home.timeouts}} : {{board.away.timeouts}}</view>
        <view wx:elif="{{!board}}" class="figma-section__hint">{{match.rulesLabel}} · 比赛尚未准备，暂无比分。</view>
      </view>

      <view wx:if="{{caps.prepare}}" class="figma-section">
        <view class="figma-section__title">准备比赛</view>
        <view class="figma-section__hint">{{match.rulesLabel}}。准备后规则与采集方式锁定。</view>
        <view class="org-match-mode-grid">
          <button class="org-match-mode {{collectionMode === 'TEAM_ONLY' ? 'is-active' : ''}}" data-mode="TEAM_ONLY" bindtap="setMode"><view class="figma-row__title">只记球队</view><view class="figma-row__subtitle">比分、犯规与暂停</view></button>
          <button class="org-match-mode {{collectionMode === 'PLAYER_BASIC' ? 'is-active' : ''}}" data-mode="PLAYER_BASIC" bindtap="setMode"><view class="figma-row__title">逐人记分</view><view class="figma-row__subtitle">球员得分与犯规</view></button>
        </view>
        <view wx:if="{{collectionMode === 'PLAYER_BASIC'}}" class="org-match-switch"><view><view class="figma-row__title">专业统计与阵容时间</view><view class="figma-row__subtitle">准备后锁定</view></view><switch checked="{{technicalCollection}}" bindchange="setTechnical"/></view>
        <button class="figma-action figma-action--navy" bindtap="prepare" disabled="{{busy || !!pending}}">准备比赛</button>
      </view>
      <figma-feedback wx:elif="{{match.status === 'SCHEDULED'}}" type="empty" title="比赛尚未准备" body="{{match.rulesLabel}}。需由赛事负责人准备后才能记分。"/>

      <view id="match-staff" class="figma-section">
        <view class="figma-section__title">场次人员</view>
        <view wx:if="{{!staff.length && !hideEmptyStaffHint}}" class="figma-section__hint">尚未分配记分员或赛果复核人。</view>
        <view wx:for="{{staff}}" wx:key="key" class="figma-row">
          <view class="figma-row__copy"><view class="figma-row__title">{{item.name}}</view><view class="figma-row__subtitle">{{item.role}}</view></view>
          <button wx:if="{{caps.staff}}" class="org-match-inline-action" data-key="{{item.key}}" bindtap="disable" disabled="{{busy}}">停用</button>
          <view wx:else class="figma-status figma-status--orange">已分配</view>
        </view>
        <block wx:if="{{caps.staff && members.length}}">
          <view class="org-match-divider"></view>
          <view class="figma-field-group"><view class="figma-field-label">选择机构成员</view><picker class="figma-field-control org-match-picker" range="{{members}}" range-key="label" value="{{memberIndex}}" bindchange="pickMember">{{members[memberIndex].label}}</picker></view>
          <view class="figma-field-group"><view class="figma-field-label">本场角色</view><picker class="figma-field-control org-match-picker" range="{{roles}}" range-key="label" value="{{roleIndex}}" bindchange="pickRole">{{roles[roleIndex].label}}</picker></view>
          <button class="figma-action figma-action--ghost" bindtap="assign" disabled="{{busy}}">分配人员</button>
          <view class="figma-section__hint">记分员不能确认本场赛果；复核人与记分员应为不同人员。</view>
        </block>
        <view wx:elif="{{caps.staff && staffNote}}" class="figma-section__hint">{{staffNote}}</view>
      </view>

      <view id="match-confirmations" class="figma-section">
        <view class="figma-section__title">赛果核对</view>
        <view class="figma-row"><view class="org-match-step">1</view><view class="figma-row__copy"><view class="figma-row__title">现场记录</view><view class="figma-row__subtitle">查看事件、更正与原记录</view></view><view class="figma-status {{match.status === 'SCHEDULED' || match.status === 'READY' ? '' : 'figma-status--green'}}">{{match.status === 'SCHEDULED' || match.status === 'READY' ? '未开始' : '已记录'}}</view></view>
        <view class="figma-row"><view class="org-match-step">2</view><view class="figma-row__copy"><view class="figma-row__title">独立确认</view><view class="figma-row__subtitle">由未参与记分的授权人核对</view></view><view class="figma-status {{confirmations.length ? 'figma-status--green' : 'figma-status--orange'}}">{{confirmations.length ? '已确认' : '待确认'}}</view></view>
        <view class="figma-row"><view class="org-match-step">3</view><view class="figma-row__copy"><view class="figma-row__title">确认后归档</view><view class="figma-row__subtitle">保留赛果版本及更正记录</view></view><view class="figma-status {{match.status === 'CONFIRMED' ? 'figma-status--green' : ''}}">{{match.status === 'CONFIRMED' ? '已完成' : '待完成'}}</view></view>
        <figma-feedback wx:if="{{match.status === 'PENDING_CONFIRMATION' && !caps.confirm}}" type="pending" title="等待独立确认" body="确认前赛果不计入正式积分。"/>
      </view>

      <view wx:if="{{confirmations.length}}" class="figma-section">
        <view class="figma-section__title">确认记录</view>
        <view wx:for="{{confirmations}}" wx:key="key" class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{item.score}} · {{item.by}}</view><view class="figma-row__subtitle">{{item.time}}</view></view><view class="figma-status figma-status--green">有效</view></view>
      </view>

      <view wx:if="{{board}}" class="figma-section">
        <view class="figma-section__title">比赛记录</view>
        <figma-feedback wx:if="{{historyError}}" type="error" title="记录读取失败" body="{{historyError}}"/>
        <view wx:elif="{{!history.length}}" class="figma-section__hint">尚无记录。</view>
        <view wx:for="{{history}}" wx:key="key" class="figma-row org-match-history {{item.voided ? 'is-voided' : ''}}"><view class="figma-row__copy"><view class="figma-row__title">{{item.text}}{{item.voided ? '（已撤销）' : ''}}</view><view class="figma-row__subtitle">{{item.periodLabel}} {{item.time}}{{item.reason ? ' · ' + item.reason : ''}}</view></view></view>
      </view>

      <view wx:if="{{caps.reopen}}" class="figma-section">
        <view class="org-match-section-head"><view class="figma-section__title">赛果更正</view><button class="org-match-inline-action" bindtap="toggleReopen">{{reopenOpen ? '收起' : '需要更正'}}</button></view>
        <view class="figma-section__hint">重开时保留原确认和原事件；更正后必须重新独立确认。</view>
        <block wx:if="{{reopenOpen}}"><view class="figma-field-group"><view class="figma-field-label">重开原因（必填）</view><textarea class="figma-field-control" maxlength="500" value="{{reopenReason}}" bindinput="reopenInput" placeholder="说明需要更正的原记录"/></view><button class="figma-action org-match-danger" bindtap="reopen" disabled="{{busy || !!pending}}">重开赛果</button></block>
      </view>

      <view class="figma-section org-match-services">
        <view class="figma-section__title">相关服务</view>
        <button wx:if="{{caps.score && (match.status === 'READY' || match.status === 'LIVE' || match.status === 'PENDING_CONFIRMATION')}}" class="org-match-service" bindtap="openScorer" disabled="{{busy}}"><figma-icon name="scoreboard" size="19"/><text>进入本场记分台{{match.leaseHeld ? '（当前有人持有控制）' : ''}}</text></button>
        <button wx:if="{{board && board.proMode && !board.adjudicated}}" class="org-match-service" bindtap="openProfessionalReport" disabled="{{busy}}"><figma-icon name="scoreboard" size="19"/><text>查看专业统计与上场时间</text></button>
        <button wx:if="{{(caps.staff || caps.prepare || caps.confirm || caps.reopen) && (match.status === 'SCHEDULED' || match.status === 'READY')}}" class="org-match-service" bindtap="openReschedule" disabled="{{busy}}"><figma-icon name="workbench" size="19"/><text>正式改期</text></button>
        <button class="org-match-service" bindtap="openExceptions" disabled="{{busy}}"><figma-icon name="workbench" size="19"/><text>比赛异常裁定</text></button>
        <button wx:if="{{caps.live}}" class="org-match-service" bindtap="openLive" disabled="{{busy}}"><figma-icon name="live" size="19"/><text>直播工作台</text></button>
      </view>
    </block>
  </view>

  <view wx:if="{{match}}" class="figma-fixed-actions">
    <button class="figma-action figma-action--ghost" bindtap="openMedia" disabled="{{busy}}">查看比赛媒体</button>
    <button wx:if="{{caps.confirm && board}}" class="figma-action figma-action--orange" bindtap="confirmResult" disabled="{{busy || !!pending}}">独立确认赛果</button>
    <button wx:else class="figma-action figma-action--orange" bindtap="refresh" disabled="{{loading || busy}}">刷新比赛</button>
  </view>
</view>
