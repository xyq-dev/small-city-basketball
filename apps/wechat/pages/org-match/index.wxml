<view class="page mgmt-page">
  <view wx:if="{{loading && !match}}" class="card state-panel">
    <text class="state-label">机构比赛</text>
    <view class="subtitle">正在读取比赛资料</view>
    <view class="muted">核对当前身份可查看的比分、记录与确认状态。</view>
    <view class="loading-lines"><view></view><view></view></view>
  </view>
  <view wx:elif="{{!match}}" class="card state-panel">
    <text class="state-label">{{unavailable ? '请核对' : '读取未完成'}}</text>
    <view class="subtitle">{{unavailable ? '无法查看该比赛' : '暂时无法读取比赛'}}</view>
    <view class="notice warning">{{error || '请从赛事赛程重新进入。'}}</view>
    <button wx:if="{{!unavailable}}" class="primary" bindtap="load">重新读取</button>
  </view>
  <block wx:else>
    <view wx:if="{{error}}" class="notice warning">{{error}}</view>
    <view wx:if="{{notice}}" class="notice success-notice">{{notice}}</view>
    <view wx:if="{{pending}}" class="card">
      <view class="subtitle">{{pending.label}} · 结果待核对</view>
      <view class="muted">保留原操作编号。先核对服务端结果；只有确认未执行时才按原编号重发。</view>
      <button class="primary" bindtap="checkPending" disabled="{{busy}}">核对结果</button>
      <button class="secondary" bindtap="resendPending" disabled="{{busy}}">按原编号重发</button>
    </view>

    <view class="board">
      <view class="board-meta" bindtap="openEvent">{{match.eventName}} · {{match.round}}</view>
      <view class="board-meta">{{match.time}} · {{match.court}}</view>
      <view class="board-row">
        <view class="board-team"><view class="board-name">{{match.home}}</view><view class="board-score">{{board ? board.home.score : '–'}}</view></view>
        <view class="board-mid"><view class="board-status {{match.status === 'LIVE' ? 'live' : ''}}">{{match.statusLabel}}</view><view wx:if="{{board}}" class="board-clock">{{board.clockLabel}}</view><view wx:if="{{board}}" class="board-period">{{board.periodLabel}}</view></view>
        <view class="board-team"><view class="board-name">{{match.away}}</view><view class="board-score">{{board ? board.away.score : '–'}}</view></view>
      </view>
      <view wx:if="{{board}}" class="board-sub">犯规 {{board.home.fouls}} : {{board.away.fouls}} · 暂停 {{board.home.timeouts}} : {{board.away.timeouts}}</view>
      <view class="board-result {{board && board.final ? 'final' : ''}}">{{board ? board.resultLabel : '比赛尚未准备，暂无比分'}}</view>
    </view>

    <view wx:if="{{caps.prepare}}" class="card">
      <view class="subtitle">准备比赛</view>
      <view class="muted">{{match.rulesLabel}}。准备后本场进入记录台，可由已分配的记分员开始比赛。</view>
      <view class="mode-choice">
        <button class="{{collectionMode === 'TEAM_ONLY' ? 'selected' : ''}}" data-mode="TEAM_ONLY" bindtap="setMode">只记球队</button>
        <button class="{{collectionMode === 'PLAYER_BASIC' ? 'selected' : ''}}" data-mode="PLAYER_BASIC" bindtap="setMode">逐人记分</button>
      </view>
      <button class="primary" bindtap="prepare" disabled="{{busy || !!pending}}">准备比赛</button>
    </view>
    <view wx:elif="{{match.status === 'SCHEDULED'}}" class="notice small">{{match.rulesLabel}}。比赛由赛事负责人准备后才能记分。</view>

    <button wx:if="{{caps.score && (match.status === 'READY' || match.status === 'LIVE' || match.status === 'PENDING_CONFIRMATION')}}" class="accent" bindtap="openScorer" disabled="{{busy}}">进入记分台{{match.leaseHeld ? '（当前有人持有控制）' : ''}}</button>

    <view wx:if="{{caps.confirm}}" class="card">
      <view class="subtitle">独立确认赛果</view>
      <view class="muted">确认人不能是本场开始、记分、计时或更正的操作者，也不能是双方领队；由服务端核验。</view>
      <button class="primary" bindtap="confirmResult" disabled="{{busy || !!pending}}">确认 {{board.home.score}} : {{board.away.score}} 为正式赛果</button>
    </view>
    <view wx:elif="{{match.status === 'PENDING_CONFIRMATION'}}" class="notice small">比赛已结束，等待赛果复核人或赛事负责人独立确认；确认前不计入正式积分。</view>

    <view wx:if="{{caps.reopen}}" class="card">
      <view class="row-between"><view class="subtitle">重开赛果</view><button class="quiet small-button" bindtap="toggleReopen">{{reopenOpen ? '收起' : '需要更正'}}</button></view>
      <block wx:if="{{reopenOpen}}">
        <text class="field-label">重开原因（必填）</text>
        <textarea class="field" maxlength="500" value="{{reopenReason}}" bindinput="reopenInput" placeholder="例如：第三节一次得分记错球队"/>
        <button class="danger" bindtap="reopen" disabled="{{busy || !!pending}}">重开赛果</button>
      </block>
    </view>

    <view wx:if="{{board && board.periods.length}}" class="card">
      <view class="subtitle">分节比分</view>
      <view class="org-table">
        <view class="org-table-row head"><text class="team-cell">节次</text><text class="num-cell">{{match.home}}</text><text class="num-cell">{{match.away}}</text></view>
        <view wx:for="{{board.periods}}" wx:key="key" class="org-table-row"><text class="team-cell">{{item.label}}</text><text class="num-cell">{{item.home}}</text><text class="num-cell">{{item.away}}</text></view>
      </view>
    </view>

    <view wx:if="{{confirmations.length}}" class="card">
      <view class="subtitle">确认记录</view>
      <view wx:for="{{confirmations}}" wx:key="key" class="row"><view>{{item.score}} · {{item.by}}</view><view class="muted">{{item.time}}</view></view>
    </view>

    <view wx:if="{{board}}" class="card">
      <view class="subtitle">比赛记录</view>
      <view wx:if="{{historyError}}" class="notice warning small">{{historyError}}</view>
      <view wx:elif="{{!history.length}}" class="muted">尚无记录。</view>
      <view wx:for="{{history}}" wx:key="key" class="row history-row {{item.voided ? 'voided' : ''}}"><view>{{item.text}}{{item.voided ? '（已撤销）' : ''}}</view><view class="muted">{{item.periodLabel}} {{item.time}}{{item.reason ? ' · ' + item.reason : ''}}</view></view>
    </view>

    <view wx:if="{{staff.length}}" class="card">
      <view class="subtitle">本场工作人员</view>
      <view wx:for="{{staff}}" wx:key="key" class="row-between row"><text>{{item.name}}</text><text class="muted">{{item.role}}</text></view>
    </view>
    <view wx:else class="notice small">本场尚未分配记分员或复核人。人员分配在Web赛事工作台完成。</view>

    <button class="quiet" bindtap="load" disabled="{{loading}}" loading="{{loading}}">刷新比赛</button>
  </block>
</view>
