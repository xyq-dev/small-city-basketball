<scb-header title="排赛与发布" disabled="{{busy || loading}}"/>
<view class="figma-page schedule-page">
  <view class="figma-page__content figma-page__content--actions">
    <view class="figma-summary schedule-summary">
      <view class="figma-summary__icon"><figma-icon name="schedule" size="25"/></view>
      <view class="figma-summary__copy"><view class="figma-eyebrow">机构赛事工作台</view><view class="figma-title">排赛与发布</view><view class="figma-subtitle">从已冻结名单生成对阵，检查冲突后发布。</view></view>
    </view>

    <view class="schedule-tabs" role="tablist"><button class="schedule-tab {{scheduleTab === 'groups' ? 'is-active' : ''}}" data-tab="groups" bindtap="changeScheduleTab" disabled="{{busy}}">分组与种子</button><button class="schedule-tab {{scheduleTab === 'slots' ? 'is-active' : ''}}" data-tab="slots" bindtap="changeScheduleTab" disabled="{{busy}}">场地与时段</button><button class="schedule-tab {{scheduleTab === 'draft' ? 'is-active' : ''}}" data-tab="draft" bindtap="changeScheduleTab" disabled="{{busy}}">排程草稿</button></view>

    <figma-skeleton wx:if="{{loading && !event}}" rows="4"/>
    <figma-feedback wx:if="{{error}}" type="error" title="排赛资料或操作失败" body="{{error}}" action-label="重新读取" bind:action="load" disabled="{{busy || loading}}"/>
    <figma-feedback wx:if="{{notice}}" type="success" title="操作已确认" body="{{notice}}"/>
    <figma-feedback wx:if="{{!loading && !event}}" type="{{unavailable ? 'pending' : 'error'}}" title="{{unavailable ? '无法为该赛事排赛' : '暂时无法读取'}}" body="请从赛事设置重新进入。"/>

    <block wx:if="{{event}}">
      <figma-feedback wx:if="{{state === 'published'}}" type="success" title="正式赛程已发布" body="共 {{publication.count}} 场 · {{publication.time}}。原发布快照保留；单场调整须从比赛详情正式改期。"/>
      <figma-feedback wx:elif="{{state === 'no-freeze'}}" type="empty" title="名单尚未冻结" body="报名截止并冻结名单后才能生成对阵。" action-label="去报名审核" bind:action="openReview"/>
      <figma-feedback wx:elif="{{state === 'unsupported'}}" type="error" title="当前赛事暂不支持排赛" body="{{supportReason || '请核对赛制与名单'}}"/>
      <figma-feedback wx:elif="{{state === 'readonly'}}" type="pending" title="当前为只读" body="当前身份可查看排赛资料，但不能生成、校验或发布。"/>

      <view id="schedule-groups" class="figma-section">
        <view class="figma-section__title">分组设置</view>
        <view class="schedule-readonly"><view><view class="figma-field-label">冻结球队</view><view class="schedule-readonly__value">{{event.teams}} 支球队</view></view><view class="figma-status {{event.teams ? 'figma-status--green' : 'figma-status--orange'}}">{{event.teamsStatusText || (event.teams ? '已冻结' : '待冻结')}}</view></view><view class="schedule-readonly"><view><view class="figma-field-label">赛制与种子</view><view class="schedule-readonly__value">{{format === 'GROUP_KNOCKOUT' ? (groupCounts.length ? groupCounts[groupIndex].label + ' · 各组至多 1 支种子队' : '冻结球队不足') : format === 'SINGLE_ELIMINATION' ? '固定淘汰签位' : format === 'DOUBLE_ROUND_ROBIN' ? '双循环主客对阵' : '单循环对阵'}}</view></view><view class="figma-status figma-status--orange">{{event.formatStatusText || (state === 'draft' || state === 'published' ? '已生成' : '待核对')}}</view></view>
        <block wx:if="{{state === 'generate' && format === 'GROUP_KNOCKOUT'}}"><picker wx:if="{{groupCounts.length}}" class="figma-field-control schedule-picker" range="{{groupCounts}}" range-key="label" value="{{groupIndex}}" bindchange="pickGroups">{{groupCounts[groupIndex].label}}</picker><view wx:if="{{!groupCounts.length}}" class="schedule-alert">冻结球队不足，分组赛每组至少 2 队。</view><view class="figma-field-label">种子队（每组至多一支）</view><button wx:for="{{seeds}}" wx:key="id" class="schedule-choice" data-index="{{index}}" bindtap="toggleSeed"><view class="figma-row__title">{{item.name}}</view><view class="figma-status {{item.on ? 'figma-status--green' : ''}}">{{item.on ? '种子' : '普通'}}</view></button></block>
        <button wx:if="{{state === 'generate' && (format === 'SINGLE_ELIMINATION' || format === 'GROUP_KNOCKOUT') && event.teams >= 4}}" class="schedule-choice" bindtap="toggleThirdPlace"><view><view class="figma-row__title">安排季军赛</view><view class="figma-row__subtitle">配置随本次抽签锁定</view></view><view class="figma-status">{{form.thirdPlace ? '启用' : '不安排'}}</view></button>
      </view>

      <view wx:if="{{!hideSlotsSummary}}" id="schedule-slots" class="figma-section">
        <view class="figma-section__title">场地与时段</view>
        <block wx:if="{{state === 'generate'}}"><view class="figma-field-label">选择场地</view><view wx:if="{{!courts.length}}" class="figma-section__hint">机构还没有可用场地。</view><button wx:for="{{courts}}" wx:key="id" class="schedule-choice" data-index="{{index}}" bindtap="toggleCourt"><view class="figma-row__title">{{item.name}}</view><view class="figma-status {{item.on ? 'figma-status--green' : ''}}">{{item.on ? '使用' : '不用'}}</view></button><label wx:if="{{canCreateCourt}}" class="figma-field-group"><view class="figma-field-label">新增场地</view><input class="figma-field-control" value="{{newCourt}}" bindinput="courtInput" maxlength="80" placeholder="例如 一号场"/></label><button wx:if="{{canCreateCourt}}" class="figma-action figma-action--ghost" bindtap="addCourt" disabled="{{busy || !newCourt}}">添加场地</button><view class="schedule-pair"><label class="figma-field-group"><view class="figma-field-label">每日开始</view><picker mode="time" class="figma-field-control schedule-picker" value="{{form.dayStart}}" data-field="dayStart" bindchange="formInput">{{form.dayStart}}</picker></label><label class="figma-field-group"><view class="figma-field-label">每日结束</view><picker mode="time" class="figma-field-control schedule-picker" value="{{form.dayEnd}}" data-field="dayEnd" bindchange="formInput">{{form.dayEnd}}</picker></label></view><view class="schedule-trio"><label class="figma-field-group"><view class="figma-field-label">每场分钟</view><input class="figma-field-control" type="number" value="{{form.slot}}" data-field="slot" bindinput="formInput"/></label><label class="figma-field-group"><view class="figma-field-label">最短休息</view><input class="figma-field-control" type="number" value="{{form.rest}}" data-field="rest" bindinput="formInput"/></label><label class="figma-field-group"><view class="figma-field-label">日期间隔</view><input class="figma-field-control" type="number" value="{{form.gap}}" data-field="gap" bindinput="formInput"/></label></view><button class="figma-action figma-action--navy" bindtap="generate" disabled="{{busy}}">生成对阵草稿</button></block>
        <view wx:else class="schedule-readonly"><view><view class="figma-field-label">当前排程阶段</view><view class="schedule-readonly__value">{{state === 'draft' ? '对阵草稿已生成，可继续分配与校验' : state === 'published' ? '正式时段已发布' : '等待生成条件'}}</view></view><view class="figma-status">{{event.statusLabel}}</view></view>
      </view>

      <view id="schedule-draft" class="figma-section">
        <view class="schedule-section-head"><view class="figma-section__title">首日安排</view><view wx:if="{{revision && !hideRevisionBadge}}" class="figma-status figma-status--orange">{{revision.rounds}} 轮 · {{revision.count}} 场</view></view>
        <figma-feedback wx:if="{{state !== 'draft' && state !== 'published'}}" type="empty" title="暂无排程草稿" body="冻结名单并生成对阵后显示真实场次。"/>
        <view wx:for="{{fixtures}}" wx:key="key" class="schedule-fixture"><figma-icon name="schedule" size="18"/><view class="figma-row__copy"><view class="figma-row__title">{{item.home}} vs {{item.away}}</view><view class="figma-row__subtitle">{{item.summaryText || (item.round + ' · ' + item.time + (item.court ? ' · ' + item.court : ''))}}</view></view><view class="figma-status {{item.assigned ? 'figma-status--green' : 'figma-status--orange'}}">{{item.statusText || (item.assigned ? '草稿' : '未安排')}}</view></view>
        <view wx:if="{{byes}}" class="schedule-alert">首轮轮空直接晋级：{{byes}}。轮空不生成比赛。</view>
        <view wx:if="{{draftGroups.length}}" class="schedule-groups"><view wx:for="{{draftGroups}}" wx:key="key" class="schedule-readonly"><view><view class="figma-row__title">{{item.label}}</view><view class="figma-row__subtitle">{{item.teams}}</view></view></view></view>
      </view>

      <view class="figma-section">
        <view class="figma-section__title">发布检查</view>
        <view class="schedule-step"><view class="schedule-step__mark">1</view><view class="schedule-step__copy"><view class="figma-row__title">场地与队伍冲突</view><view class="figma-row__subtitle">与本机构其他正式安排一起核验</view></view><view class="figma-status {{validated && !conflicts.length ? 'figma-status--green' : 'figma-status--orange'}}">{{validated && !conflicts.length ? '已通过' : '待检查'}}</view></view>
        <view class="schedule-step"><view class="schedule-step__mark">2</view><view class="schedule-step__copy"><view class="figma-row__title">休息与日期间隔</view><view class="figma-row__subtitle">按本届规则检查</view></view><view class="figma-status {{validated && !conflicts.length ? 'figma-status--green' : 'figma-status--orange'}}">{{validated && !conflicts.length ? '已通过' : '待检查'}}</view></view>
        <view class="schedule-step"><view class="schedule-step__mark">3</view><view class="schedule-step__copy"><view class="figma-row__title">锁定本届积分规则</view><view class="figma-row__subtitle">正式发布前必须完成</view></view><view class="figma-status figma-status--orange">待核对</view></view>
        <view wx:if="{{validated}}" class="schedule-validation"><view class="figma-row__title">校验结果</view><view wx:if="{{!conflicts.length}}" class="figma-row__subtitle">未发现冲突。</view><view wx:for="{{conflicts}}" wx:key="key" class="schedule-alert">{{item.label}}{{item.external ? '（已有资源安排）' : ''}} · {{item.fixtures}}</view></view>
        <button wx:if="{{state === 'draft' && revision.canPublish}}" class="figma-action figma-action--navy" bindtap="publish" disabled="{{busy}}">发布正式赛程</button>
      </view>

      <view wx:if="{{state === 'draft' && revision.canRedraw}}" class="figma-section"><view class="schedule-section-head"><view class="figma-section__title">重新抽签</view><button class="schedule-inline" bindtap="toggleRedraw">{{redrawOpen ? '收起' : '需要重抽'}}</button></view><block wx:if="{{redrawOpen}}"><label class="figma-field-group"><view class="figma-field-label">原因（必填）</view><input class="figma-field-control" value="{{redrawReason}}" bindinput="redrawInput" placeholder="例如 场地调整后重新抽签"/></label><button class="figma-action schedule-danger" bindtap="redraw" disabled="{{busy}}">重新抽签</button></block></view>

      <view wx:if="{{courtAdmin.length}}" class="figma-section"><view class="figma-section__title">场地管理（本机构共享）</view><view wx:for="{{courtAdmin}}" wx:key="id" class="schedule-court-admin"><view class="schedule-section-head"><view><view class="figma-row__title">{{item.name}}</view><view class="figma-row__subtitle">{{item.active ? '当前可用于排赛' : '已停用，历史安排仍保留'}}</view></view><view class="schedule-command-row"><button data-id="{{item.id}}" bindtap="askRename" disabled="{{busy}}">改名</button><button data-id="{{item.id}}" bindtap="toggleCourtStatus" disabled="{{busy}}">{{item.active ? '停用' : '启用'}}</button></view></view><block wx:if="{{renameId === item.id}}"><input class="figma-field-control" maxlength="80" value="{{renameValue}}" bindinput="renameInput"/><button class="figma-action figma-action--ghost" bindtap="saveRename" disabled="{{busy || !renameValue}}">保存名称</button></block></view></view>

      <view class="figma-section schedule-related"><view class="figma-section__title">相关服务</view><button class="schedule-link" bindtap="openBracket"><figma-icon name="workbench" size="19"/><text>分组与晋级</text></button><button class="schedule-link" bindtap="openSetup"><figma-icon name="settings" size="19"/><text>赛事设置与积分规则</text></button><button class="schedule-link" bindtap="load" disabled="{{loading || busy}}"><figma-icon name="schedule" size="19"/><text>刷新</text></button></view>
    </block>
  </view>

  <view wx:if="{{event}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost" data-mode="preserve" bindtap="autoAssign" disabled="{{busy || state !== 'draft' || !revision.canEdit}}">自动补充缺项</button><button class="figma-action figma-action--orange" bindtap="validate" disabled="{{busy || state !== 'draft' || !revision.canValidate}}">{{busy ? '正在校验…' : '校验冲突'}}</button></view>
</view>
