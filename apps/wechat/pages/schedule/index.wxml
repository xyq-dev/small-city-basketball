<view class="page mgmt-page">
  <view wx:if="{{loading && !event}}" class="card state-panel"><text class="state-label">排赛</text><view class="subtitle">正在读取</view><view class="loading-lines"><view></view><view></view></view></view>
  <view wx:elif="{{!event}}" class="card state-panel">
    <text class="state-label">{{unavailable ? '请核对' : '读取未完成'}}</text>
    <view class="subtitle">{{unavailable ? '无法为该赛事排赛' : '暂时无法读取'}}</view>
    <view class="notice warning">{{error || '请从赛事设置重新进入。'}}</view>
    <button wx:if="{{!unavailable}}" class="primary" bindtap="load">重新读取</button>
  </view>
  <block wx:else>
    <view wx:if="{{error}}" class="notice warning">{{error}}</view>
    <view wx:if="{{notice}}" class="notice success-notice">{{notice}}</view>
    <view class="board">
      <view class="board-meta">{{event.statusLabel}} · {{event.dates}}</view>
      <view class="setup-name">{{event.name}}</view>
      <view class="board-meta">冻结球队 {{event.teams}} 支</view>
    </view>

    <view wx:if="{{state === 'published'}}" class="card">
      <view class="subtitle">正式赛程已发布</view>
      <view class="muted">共 {{publication.count}} 场 · {{publication.time}}。原发布快照保留、不能重抽；单场调整请在比赛详情中正式改期，每次改期单独留存记录。</view>
      <button wx:if="{{format === 'SINGLE_ELIMINATION' || format === 'GROUP_KNOCKOUT'}}" class="primary" bindtap="openBracket">{{format === 'GROUP_KNOCKOUT' ? '分组积分与晋级发布' : '签位与下一轮发布'}}</button>
      <button class="{{format === 'ROUND_ROBIN' || format === 'DOUBLE_ROUND_ROBIN' ? 'primary' : 'secondary'}}" bindtap="openEvent">查看赛程</button>
    </view>
    <view wx:elif="{{state === 'no-freeze'}}" class="card">
      <view class="subtitle">名单尚未冻结</view>
      <view class="muted">报名截止并冻结名单后才能生成对阵。</view>
      <button class="primary" bindtap="openReview">去报名审核</button>
    </view>
    <view wx:elif="{{state === 'unsupported'}}" class="notice warning">当前赛事暂不支持排赛：{{supportReason || '请核对赛制与名单'}}</view>
    <view wx:elif="{{state === 'readonly'}}" class="notice small">当前身份可查看但不能排赛。</view>

    <block wx:if="{{state === 'generate'}}">
      <view wx:if="{{format === 'GROUP_KNOCKOUT'}}" class="card">
        <view class="subtitle">分组与种子</view>
        <view wx:if="{{!groupCounts.length}}" class="notice warning small">冻结球队不足，分组赛每组至少2队。</view>
        <block wx:else>
          <text class="field-label">分组数</text>
          <picker class="field" range="{{groupCounts}}" range-key="label" value="{{groupIndex}}" bindchange="pickGroups">{{groupCounts[groupIndex].label}}</picker>
          <text class="field-label">种子队（可选，每组至多一支，用于分开强队）</text>
          <view wx:for="{{seeds}}" wx:key="id" class="setup-switch" data-index="{{index}}" bindtap="toggleSeed"><text>{{item.name}}</text><text class="setup-flag {{item.on ? 'on' : ''}}">{{item.on ? '种子' : '—'}}</text></view>
          <view class="muted">服务端随机均衡分组（组间人数差至多1队）并生成组内单循环；每组前二按固定交叉进入淘汰赛，不比较跨组第三名。</view>
        </block>
      </view>
      <view wx:elif="{{format === 'SINGLE_ELIMINATION'}}" class="notice small">服务端从冻结名单随机生成固定签位；首轮轮空不生成比赛，下一轮须待来源比赛全部有效独立确认后再发布。</view>
      <view wx:elif="{{format === 'DOUBLE_ROUND_ROBIN'}}" class="notice small">每两队安排两个回合，第二回合交换主客队；两回合均纳入同一积分榜。全部场次通过冲突校验后一起发布。</view>
      <view wx:if="{{(format === 'SINGLE_ELIMINATION' || format === 'GROUP_KNOCKOUT') && event.teams >= 4}}" class="card"><view class="setup-switch" bindtap="toggleThirdPlace"><text>安排季军赛</text><text class="setup-flag {{form.thirdPlace ? 'on' : ''}}">{{form.thirdPlace ? '启用' : '不安排'}}</text></view><view class="muted">启用后半决赛负者进入季军赛；决赛和季军赛均须独立确认才能完赛。配置随本次抽签锁定。</view></view>
      <view class="card">
        <view class="subtitle">选择场地</view>
        <view wx:if="{{!courts.length}}" class="muted">机构还没有可用场地。</view>
        <view wx:for="{{courts}}" wx:key="id" class="setup-switch" data-index="{{index}}" bindtap="toggleCourt"><text>{{item.name}}</text><text class="setup-flag {{item.on ? 'on' : ''}}">{{item.on ? '使用' : '不用'}}</text></view>
        <block wx:if="{{canCreateCourt}}">
          <text class="field-label">新增场地</text>
          <input class="field" value="{{newCourt}}" bindinput="courtInput" maxlength="80" placeholder="例如 一号场"/>
          <button class="secondary" bindtap="addCourt" disabled="{{busy || !newCourt}}">添加场地</button>
        </block>
      </view>
      <view class="card">
        <view class="subtitle">时段与间隔</view>
        <view class="setup-pair">
          <view><text class="field-label">每日开始</text><picker mode="time" class="field" value="{{form.dayStart}}" data-field="dayStart" bindchange="formInput">{{form.dayStart}}</picker></view>
          <view><text class="field-label">每日结束</text><picker mode="time" class="field" value="{{form.dayEnd}}" data-field="dayEnd" bindchange="formInput">{{form.dayEnd}}</picker></view>
        </view>
        <view class="setup-trio">
          <view><text class="field-label">每场分钟</text><input class="field" type="number" value="{{form.slot}}" data-field="slot" bindinput="formInput"/></view>
          <view><text class="field-label">最短休息</text><input class="field" type="number" value="{{form.rest}}" data-field="rest" bindinput="formInput"/></view>
          <view><text class="field-label">日期间隔</text><input class="field" type="number" value="{{form.gap}}" data-field="gap" bindinput="formInput"/></view>
        </view>
        <view class="muted">赛期内每天按所选场地开放上述时段。服务端随机生成{{format === 'GROUP_KNOCKOUT' ? '分组与组内对阵' : format === 'SINGLE_ELIMINATION' ? '签位与首轮对阵' : '单循环对阵'}}并保存随机种子。</view>
        <button class="primary" bindtap="generate" disabled="{{busy}}">生成对阵草稿</button>
      </view>
    </block>

    <block wx:if="{{state === 'draft'}}">
      <view class="card">
        <view class="row-between"><view class="subtitle">对阵草稿</view><text class="badge">{{revision.rounds}} 轮 · {{revision.count}} 场</text></view>
        <view class="muted">草稿不占用正式场地。先自动排入时间，再由服务端校验冲突，通过后一次发布。</view>
        <button wx:if="{{revision.canEdit}}" class="secondary" data-mode="preserve" bindtap="autoAssign" disabled="{{busy}}">保留已排，自动补充缺项</button>
        <button wx:if="{{revision.canEdit}}" class="secondary" data-mode="all" bindtap="autoAssign" disabled="{{busy}}">全稿均衡优化</button>
        <view wx:if="{{revision.canEdit}}" class="muted">服务端考虑本机构跨赛事占用、休息及比赛日间隔，按本稿实际首末场次数均衡；有界建议不保证全局最优，不占用正式场地。</view>
        <button wx:if="{{revision.canValidate}}" class="secondary" bindtap="validate" disabled="{{busy}}">校验冲突</button>
        <button wx:if="{{revision.canPublish}}" class="primary" bindtap="publish" disabled="{{busy}}">发布正式赛程</button>
      </view>
      <view wx:if="{{draftGroups.length}}" class="card">
        <view class="subtitle">分组结果（服务端回放，发布前核对）</view>
        <view wx:for="{{draftGroups}}" wx:key="key" class="row"><view>{{item.label}}</view><view class="muted">{{item.teams}}</view></view>
      </view>
      <view wx:if="{{format === 'GROUP_KNOCKOUT'}}" class="card">
        <view class="subtitle">发布前锁定组内积分规则</view>
        <view class="muted">组内名次与出线按锁定的积分规则计算；未锁定时服务端拒绝发布。</view>
        <button class="secondary" bindtap="openSetup">设置组内积分规则</button>
      </view>
      <view wx:if="{{byes}}" class="notice small">首轮轮空直接晋级：{{byes}}。轮空不生成比赛。</view>
      <view wx:if="{{validated}}" class="card">
        <view class="subtitle">校验结果</view>
        <view wx:if="{{!conflicts.length}}" class="muted">未发现冲突。</view>
        <view wx:for="{{conflicts}}" wx:key="key" class="row"><view>{{item.label}}{{item.external ? '（已有资源安排）' : ''}}</view><view class="muted">{{item.fixtures}}</view></view>
      </view>
      <view wx:for="{{fixtures}}" wx:key="key" class="org-match">
        <view class="org-match-meta">{{item.round}} · {{item.time}}{{item.court ? ' · ' + item.court : ''}}</view>
        <view class="org-match-teams"><text>{{item.home}}</text><text class="org-match-vs">VS</text><text>{{item.away}}</text></view>
        <view wx:if="{{!item.assigned}}" class="org-match-status live">未安排</view>
      </view>
      <view wx:if="{{revision.canRedraw}}" class="card">
        <view class="row-between"><view class="subtitle">重新抽签</view><button class="quiet small-button" bindtap="toggleRedraw">{{redrawOpen ? '收起' : '需要重抽'}}</button></view>
        <block wx:if="{{redrawOpen}}">
          <text class="field-label">原因（必填）</text>
          <input class="field" value="{{redrawReason}}" bindinput="redrawInput" placeholder="例如 场地调整后重新抽签"/>
          <button class="danger" bindtap="redraw" disabled="{{busy}}">重新抽签</button>
        </block>
      </view>
    </block>
    <view wx:if="{{courtAdmin.length}}" class="card">
      <view class="subtitle">场地管理（本机构共享）</view>
      <view wx:for="{{courtAdmin}}" wx:key="id" class="row">
        <view class="row-between"><view>{{item.name}}<text class="badge {{item.active ? 'success' : 'warning'}}">{{item.active ? '可用' : '已停用'}}</text></view><view class="file-actions"><button class="quiet small-button" data-id="{{item.id}}" bindtap="askRename" disabled="{{busy}}">改名</button><button class="quiet small-button" data-id="{{item.id}}" bindtap="toggleCourtStatus" disabled="{{busy}}">{{item.active ? '停用' : '启用'}}</button></view></view>
        <block wx:if="{{renameId === item.id}}">
          <input class="field" maxlength="80" value="{{renameValue}}" bindinput="renameInput"/>
          <button class="secondary" bindtap="saveRename" disabled="{{busy || !renameValue}}">保存名称</button>
        </block>
      </view>
      <view class="muted">场地为本机构所有赛事共享；停用不删除历史安排。</view>
    </view>
    <button class="quiet" bindtap="load" disabled="{{loading || busy}}">刷新</button>
  </block>
</view>
