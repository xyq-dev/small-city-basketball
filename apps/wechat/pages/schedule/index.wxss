.schedule-page { padding:12px 16px calc(112px + env(safe-area-inset-bottom)); }
.schedule-summary { min-height:110px; padding:16px 14px; background:#eaf2fc; }
.fig-summary-icon { display:flex; flex:0 0 44px; width:44px; height:44px; align-items:center; justify-content:center; border-radius:12px; background:#fff; }
.fig-summary-icon image { width:24px; height:24px; }
.schedule-tabs { display:flex; gap:0; padding:3px; margin-bottom:12px; border-radius:12px; background:#fff; }
.schedule-tabs view { flex:1; min-width:0; padding:11px 4px; border-radius:10px; color:#63758b; font-size:13px; line-height:20px; text-align:center; }
.schedule-tabs .selected { color:#fff; background:#164b88; }
.schedule-tabs .selected-secondary { color:#164b88; font-weight:600; }
.schedule-event-card { color:#18283f; background:#fff; }
.schedule-event-card .board-meta { color:#63758b; }
.schedule-event-card .setup-name { margin:5px 0; font-size:18px; line-height:28px; font-weight:700; }
.schedule-section-card { padding:14px; border:0; border-radius:16px; }
.schedule-section-card .subtitle { font-size:18px; line-height:28px; }
.schedule-section-card .field { border:0; background:#f4f6fa; }
.schedule-fixture { min-height:72px; padding:14px; border-radius:16px; }
.schedule-fixture .org-match-meta { margin-bottom:4px; }
.schedule-page .setup-switch { min-height:56px; }
@media (max-width:340px) { .schedule-page { padding-left:12px; padding-right:12px; } .schedule-tabs view { padding-left:1px; padding-right:1px; font-size:12px; } .setup-pair,.setup-trio { grid-template-columns:1fr; } }
