
.ui002-workspace { padding:16px 16px calc(104px + env(safe-area-inset-bottom)); background:#f4f6fa; color:#18283f; }
.ui002-workspace .card { border-radius:16px; padding:16px; margin:0 0 16px; }
.ui002-workspace input,.ui002-workspace textarea,.ui002-workspace button { font-size:16px; line-height:24px; min-height:44px; }
.ui002-workspace .page-intro .title { color:#18283f; font-size:22px; line-height:32px; margin:0 0 8px; }
.ui002-workspace .page-intro { margin-bottom:16px; }
.ui002-workspace .tabs button { min-height:44px; }

.ui002-workspace .notice { font-size:14px; line-height:22px; border-radius:12px; padding:12px; }
.match-media-page { padding:12px 16px calc(112px + env(safe-area-inset-bottom)); }
.match-media-summary { min-height:114px; padding:16px 14px; background:#eaf2fc; }
.match-media-summary .fig-summary-mark { width:128px; height:80px; overflow:hidden; }
.match-media-summary .fig-summary-mark image { width:100%; height:100%; }
.media-tabs { display:flex; gap:0; padding:3px; margin-bottom:12px; border-radius:12px; background:#fff; }
.media-tabs view { flex:1; min-width:0; padding:11px 4px; border-radius:10px; color:#63758b; font-size:14px; line-height:20px; text-align:center; }
.media-tabs .selected { color:#fff; background:#164b88; }
.match-media-page .card { padding:14px; border:0; border-radius:16px; }
.media-files-card .row,.media-publish-card .row { min-height:64px; }
.media-draft-card .field,.media-publish-card .field { border:0; background:#f4f6fa; }
.media-upload-card .mode-choice,.media-publish-card .mode-choice { flex-wrap:wrap; }
.media-upload-card .mode-choice button,.media-publish-card .mode-choice button { flex:1 1 130px; }
@media (max-width:340px) { .match-media-page { padding-left:12px; padding-right:12px; } .match-media-summary .fig-summary-mark { width:104px; height:70px; } .media-tabs view { font-size:13px; } }
