picker{padding:12px;background:#eaf0f8;border:1px solid #e1e7ef;border-radius:12px;font-size:16px;line-height:24px;min-height:48px;box-sizing:border-box}.row input{flex:1;min-width:100px;width:100%}input,textarea{font-size:16px}.training-manage .workflow-tabs{align-items:stretch}.training-manage .hero{padding-top:8px}.training-manage .card>text{word-break:break-word}
