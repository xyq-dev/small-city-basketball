@import "../../styles/figma-pages.wxss";
.title{font-size:24px;line-height:34px}.training-manage .workflow-tabs{align-items:stretch}.danger-action{border-color:#d97474;color:#a83b31}.work-step{display:flex;min-height:110rpx;align-items:center;gap:16rpx;border-top:1rpx solid #e1e7ef}.work-step:first-of-type{border-top:0}.work-step__index{display:flex;width:40rpx;height:40rpx;flex:none;align-items:center;justify-content:center;border-radius:50%;background:#fff;color:#123c73;font-size:22rpx;font-weight:700}
.training-manage-page{padding-bottom:calc(140rpx + env(safe-area-inset-bottom))}.manage-summary{display:flex;align-items:flex-start;gap:24rpx;background:#eaf2fc}.summary-icon{display:flex;width:80rpx;height:80rpx;flex:none;align-items:center;justify-content:center;border-radius:24rpx;background:#fff}.context-section,.form-section,.roster-section,.enrollment-review{display:flex;flex-direction:column;gap:24rpx}.operator-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16rpx}.manage-tabs{display:flex;gap:8rpx;padding:8rpx;border-radius:28rpx;background:#e6ebf2}.manage-tab{min-width:0;min-height:80rpx;flex:1;margin:0;padding:0 6rpx;border-radius:20rpx;background:transparent;color:#51657d;font-size:25rpx}.manage-tab::after,.setup-link::after,.back-action::after,.row-action::after,.row-actions button::after,.session-link::after{border:0}.manage-tab.is-active{background:#fff;color:#123c73;box-shadow:0 2rpx 6rpx rgba(18,60,115,.12)}.setup-link,.back-action{display:flex;width:100%;min-height:88rpx;align-items:center;margin:0;text-align:left;background:transparent;color:#123c73;font-size:28rpx}.setup-link{justify-content:space-between;gap:16rpx}.back-action{gap:8rpx}.setup-link__icon,.back-action__icon{display:block;width:32rpx;height:32rpx;flex:none}.journey{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx}.journey-item{padding:20rpx;border-radius:20rpx;background:#f4f7fb;color:#51657d;font-size:24rpx;line-height:36rpx}.journey-item.is-active{background:#fff5e5;color:#243b57}.journey-dot{display:flex;width:48rpx;height:48rpx;align-items:center;justify-content:center;margin-bottom:12rpx;border-radius:50%;background:#dce3ec;font-weight:700}.journey-item.is-active .journey-dot{background:#f6a623;color:#18283f}.row-action{min-width:112rpx;min-height:72rpx;margin:0;padding:0 16rpx;border-radius:18rpx;background:#e9f2ff;color:#123c73;font-size:24rpx}.inline-actions,.row-actions{display:flex;flex-wrap:wrap;gap:8rpx}.inline-actions>.figma-action{min-width:140rpx;flex:1}.row-actions button{min-height:72rpx;margin:0;padding:0 16rpx;border-radius:18rpx;background:#e9f2ff;color:#123c73;font-size:24rpx}.figma-field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.cohort-card{display:flex;flex-direction:column;gap:16rpx;padding:24rpx 0;border-top:1rpx solid #e1e7ef}.section-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.session-link{width:100%;min-height:80rpx;margin:0;padding:16rpx 20rpx;text-align:left;border-radius:18rpx;background:#f4f7fb;color:#243b57;font-size:26rpx}.learner-row,.record-row{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx;padding:24rpx 0;border-top:1rpx solid #e1e7ef}.price-copy{color:#9a5d0b;font-size:28rpx;font-weight:700}@media(max-width:340px){.operator-row,.figma-field-grid,.journey{grid-template-columns:1fr}.manage-tab{font-size:22rpx}.learner-row,.record-row{display:block}.row-actions{margin-top:16rpx}}

/* Keep narrow-screen touch targets at 44px without replacing the base rpx geometry. */
@media (max-width: 375px) {
  .setup-link, .back-action {
    min-height: 44px;
  }
}
@media (max-width: 412.5px) {
  .manage-tab, .session-link {
    min-height: 44px;
  }
}
@media (max-width: 458.34px) {
  .row-action, .row-actions button {
    min-height: 44px;
  }
  .row-actions button {
    min-width: 44px;
  }
}
