page{background:#f4f6fa;color:#18283f}.screen{padding:16px 16px calc(40px + env(safe-area-inset-bottom));min-height:100vh;box-sizing:border-box;color:#18283f;font-size:16px;line-height:24px;word-break:break-word}.hero{padding:8px 0 16px;display:flex;flex-direction:column;gap:8px}.eyebrow{color:#123c73;font-size:12px;line-height:18px;letter-spacing:1px}.title{font-size:24px;line-height:34px;font-weight:700}.card{background:#fff;border-radius:16px;padding:16px;margin:16px 0;display:flex;flex-direction:column;gap:16px;min-width:0}.heading{font-size:18px;line-height:28px;font-weight:700}.row{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}.row>text,.row>view{min-width:0}.actions{display:flex;flex-wrap:wrap;gap:8px}.actions button{font-size:14px;line-height:22px;min-height:48px;flex:1;min-width:100px;margin:0;padding:12px;white-space:normal}.primary{background:#123c73;color:#fff;width:100%;font-weight:500;min-height:48px;border-radius:12px}.lesson{border-top:1px solid #e1e7ef;padding-top:16px;display:flex;flex-direction:column;gap:12px;word-break:break-word}.terms{white-space:pre-wrap;background:#f4f6fa;padding:12px;border-radius:12px;font-size:14px;line-height:22px}.notice,.status-banner{background:#eaf0f8;color:#123c73;padding:12px;border-radius:12px;margin:12px 0;font-size:14px;line-height:22px}.warning{background:#fff1df;color:#764a0d}.error{background:#fff1ef;color:#a83b31;padding:12px;border-radius:12px;font-size:14px;line-height:22px}.small{font-size:12px;line-height:18px;color:#63758b;word-break:break-word}input,textarea{box-sizing:border-box;width:100%;background:#fff;border:1px solid #e1e7ef;padding:12px;border-radius:12px;font-size:16px;line-height:24px}input{min-height:48px}textarea{height:130px}checkbox-group,label{display:flex;flex-direction:column;gap:12px;font-size:14px;line-height:22px}label{display:block;min-height:44px}button{font-size:14px;line-height:22px;min-height:48px;border-radius:12px;padding:12px;white-space:normal}button::af