<scb-header title="培训工作台" disabled="{{busy}}"/>
<view class="scb-ui-page figma-page training-manage training-manage-page">
  <view class="figma-page__content figma-page__content--actions">
    <view class="figma-summary manage-summary"><view class="summary-icon"><figma-icon name="training" size="24"/></view><view><view class="figma-eyebrow">机构与教练</view><view class="figma-title title">培训工作台</view><view class="figma-subtitle">签到、授课、课次消费与退费分别留有记录。</view></view></view>
    <figma-feedback wx:if="{{loginRequired}}" type="locked" title="登录后进入工作台" body="只展示当前账号获授权的机构、教练资料与课次。" action-label="登录" bind:action="login"/>
    <figma-feedback wx:if="{{pending}}" type="warning" title="原操作结果待核对" body="请先核对回执，避免重复审核、排课或退费。" action-label="核对回执" bind:action="recover"/>
    <button wx:if="{{pending}}" class="figma-action figma-action--ghost" bindtap="retry" disabled="{{busy}}">使用原请求编号重试</button>
    <figma-feedback wx:if="{{error}}" type="error" title="工作台读取失败" body="{{error}}" action-label="重新读取" bind:action="load"/>
    <figma-feedback wx:if="{{message}}" type="success" title="最新结果" body="{{message}}"/>
    <figma-feedback wx:if="{{workspace && !workspace.capabilities.enabled}}" type="closed" title="培训新业务暂未开放" body="历史课次、消费和退费仍按原记录核对。"/>
    <figma-skeleton wx:if="{{loading}}" rows="4"/>

    <view class="manage-tabs workflow-tabs"><button class="manage-tab {{manageTab==='teaching' ? 'is-active' : ''}}" data-key="teaching" bindtap="manageTab" disabled="{{busy}}">课表与签到</button><button wx:if="{{workspace}}" class="manage-tab {{manageTab==='cohorts' ? 'is-active' : ''}}" data-key="cohorts" bindtap="manageTab" disabled="{{busy}}">班期管理</button><button wx:if="{{workspace}}" class="manage-tab {{manageTab==='reviews' ? 'is-active' : ''}}" data-key="reviews" bindtap="manageTab" disabled="{{busy}}">退费与异议</button></view>
    <button wx:if="{{roster || enrollment}}" class="back-action" bindtap="closeDetail" disabled="{{busy}}"><image class="back-action__icon" src="/assets/approved-ui/icon-chevron-left-navy.png" mode="aspectFit" aria-hidden="true"/>返回本工作区列表</button>

    <block wx:if="{{manageTab==='teaching'}}"><view class="figma-section"><view class="figma-section__title">本周课表</view><button wx:for="{{teaching}}" wx:key="id" class="figma-row" data-id="{{item.id}}" bindtap="roster"><view class="figma-row__copy"><view class="figma-row__title">{{item.title}}</view><view class="figma-row__subtitle">{{item.time}}</view></view><view class="figma-status figma-status--orange">{{item.stateLabel}}</view></button><figma-feedback wx:if="{{!loading && !teaching.length}}" type="empty" title="暂无可查看课表" body="仅显示服务器授权给本人的教练资料与课次。"/></view><view class="figma-section"><view class="figma-section__title">本课签到</view><block wx:if="{{roster}}"><view wx:for="{{roster.learners}}" wx:key="id" class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{item.display_name}}</view><view class="figma-row__subtitle">{{item.stateLabel}}</view></view><view class="figma-status {{item.stateLabel==='已签到' ? 'figma-status--orange' : ''}}">{{item.stateLabel}}</view></view></block><block wx:else><view wx:for="{{attendancePreview}}" wx:key="id" class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{item.displayName}}</view><view class="figma-row__subtitle">{{item.note}}</view></view><view class="figma-status {{item.checked ? 'figma-status--orange' : ''}}">{{item.statusText}}</view></view></block><view wx:if="{{!roster && !attendancePreview.length}}" class="figma-caption">选择本周课次后读取有权查看的签到名单。</view></view><view class="figma-section"><view class="figma-section__title">需要处理</view><view class="work-step"><view class="work-step__index">1</view><view class="figma-row__copy"><view class="figma-row__title">实际授课记录</view><view class="figma-row__subtitle">由本课教练提交</view></view><view class="figma-status figma-status--orange">待记录</view></view><view class="work-step"><view class="work-step__index">2</view><view class="figma-row__copy"><view class="figma-row__title">退费申请</view><view class="figma-row__subtitle">逐课独立审核</view></view><view class="figma-status">{{reviewCountText || '1项待核'}}</view></view><view class="work-step"><view class="work-step__index">3</view><view class="figma-row__copy"><view class="figma-row__title">收费退款进展</view><view class="figma-row__subtitle">原资金订单审核和渠道回执</view></view><view class="figma-status">待核对</view></view></view></block>
    <button wx:if="{{workspace && !roster && !enrollment}}" class="setup-link" data-key="setup" bindtap="manageTab" disabled="{{busy}}"><view>{{manageTab==='setup' ? '正在管理资质与排课' : '进入资质与排课设置'}}</view><image class="setup-link__icon" src="/assets/approved-ui/icon-arrow-right-navy.png" mode="aspectFit" aria-hidden="true"/></button>
    <view wx:if="{{organizations.length || isOperator}}" class="figma-section context-section"><view class="figma-section__title">工作区设置</view><view class="figma-field-group"><view class="figma-field-label">当前机构</view><picker class="figma-field-control" range="{{organizations}}" range-key="name" value="{{orgIndex}}" bindchange="pickOrg">{{organizations[orgIndex].name || '选择机构'}}</picker></view><view wx:if="{{isOperator}}" class="operator-row"><input class="figma-field-control" placeholder="需审核的机构编号" data-field="orgId" bindinput="input" value="{{orgId}}"/><button class="figma-action figma-action--ghost" bindtap="load">读取机构</button></view><view class="figma-field-group"><view class="figma-field-label">本次事实依据</view><textarea class="figma-field-control" placeholder="审核、授课、停课、恢复或结课说明" data-field="reason" bindinput="input" value="{{reason}}"/></view></view>

    <block wx:if="{{manageTab==='setup'}}">
      <view wx:if="{{workspace}}" class="figma-section form-section"><view class="figma-eyebrow">资格设置</view><view class="figma-section__title">机构与教练资质</view><picker class="figma-field-control" mode="date" data-field="qualifiedUntil" bindchange="pick">资质到期：{{qualifiedUntil || '请选择'}}</picker><block wx:if="{{!workspace.provider}}"><input class="figma-field-control" placeholder="培训机构名称" data-field="providerName" value="{{providerName}}" bindinput="input"/><input class="figma-field-control" placeholder="资质材料受限存档编号" data-field="providerEvidence" value="{{providerEvidence}}" bindinput="input"/><button class="figma-action figma-action--orange" bindtap="createProvider" disabled="{{busy || pending}}">提交培训机构审核</button></block><block wx:else><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{workspace.provider.name}}</view><view class="figma-row__subtitle">机构培训资格</view></view><view class="figma-status figma-status--orange">{{workspace.provider.status}}</view></view><view wx:if="{{isOperator}}" class="inline-actions"><button class="figma-action figma-action--orange" data-action="APPROVE" bindtap="providerAction" disabled="{{busy || pending}}">审核通过</button><button class="figma-action figma-action--ghost" data-action="REJECT" bindtap="providerAction" disabled="{{busy || pending}}">退回</button><button class="figma-action figma-action--ghost danger-action" data-action="SUSPEND" bindtap="providerAction" disabled="{{busy || pending}}">暂停</button></view><view class="figma-field-grid"><input class="figma-field-control" placeholder="教练账户编号" data-field="coachUserId" value="{{coachUserId}}" bindinput="input"/><input class="figma-field-control" placeholder="教练对外名称" data-field="coachName" value="{{coachName}}" bindinput="input"/></view><input class="figma-field-control" placeholder="教练资质受限存档编号" data-field="coachEvidence" value="{{coachEvidence}}" bindinput="input"/><button class="figma-action figma-action--orange" bindtap="addCoach" disabled="{{busy || pending}}">登记教练并等待本人确认</button><view wx:for="{{workspace.coaches}}" wx:key="id" class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{item.display_name}}</view><view class="figma-row__subtitle">{{item.status}} · 本人确认 {{item.consented ? '已完成' : '未完成'}}</view></view><view class="row-actions"><button data-id="{{item.id}}" data-action="APPROVE" bindtap="coachAction" disabled="{{busy || pending}}">复核</button><button data-id="{{item.id}}" data-action="SUSPEND" bindtap="coachAction" disabled="{{busy || pending}}">暂停</button></view></view></block></view>
      <view wx:if="{{workspace.provider}}" class="figma-section form-section"><view class="figma-eyebrow">课程设置</view><view class="figma-section__title">课程模板</view><input class="figma-field-control" placeholder="课程名称" data-field="courseTitle" value="{{courseTitle}}" bindinput="input"/><textarea class="figma-field-control" placeholder="训练目标与适用成年人群" data-field="courseDescription" value="{{courseDescription}}" bindinput="input"/><button class="figma-action figma-action--orange" bindtap="createCourse" disabled="{{busy || pending}}">保存课程</button></view>
      <view wx:if="{{workspace.courses.length}}" class="figma-section form-section"><view class="figma-eyebrow">固定短班</view><view class="figma-section__title">安排班期与课次</view><picker class="figma-field-control" range="{{workspace.courses}}" range-key="title" value="{{courseIndex}}" data-field="courseIndex" bindchange="pick">课程：{{workspace.courses[courseIndex].title}}</picker><picker class="figma-field-control" range="{{workspace.courts}}" range-key="name" value="{{courtIndex}}" data-field="courtIndex" bindchange="pick">场地：{{workspace.courts[courtIndex].name || '请先配置场地'}}</picker><input class="figma-field-control" placeholder="班期名称" data-field="cohortTitle" value="{{cohortTitle}}" bindinput="input"/><input class="figma-field-control" placeholder="上课详细地址" data-field="address" value="{{address}}" bindinput="input"/><view class="figma-field-grid"><input class="figma-field-control" type="number" placeholder="人数上限" data-field="capacity" value="{{capacity}}" bindinput="input"/><input class="figma-field-control" type="digit" placeholder="课程总价（元）" data-field="price" value="{{price}}" bindinput="input"/></view><view class="figma-caption">最多 8 节、跨度 8 周；发布后冻结。0 元为免费课。</view><view class="figma-field-grid"><picker class="figma-field-control" mode="date" data-field="lessonDate" bindchange="pick">{{lessonDate || '课次日期'}}</picker><picker class="figma-field-control" mode="time" data-field="startTime" bindchange="pick">{{startTime || '开始时间'}}</picker><picker class="figma-field-control" mode="time" data-field="endTime" bindchange="pick">{{endTime || '结束时间'}}</picker><picker class="figma-field-control" range="{{workspace.approvedCoaches}}" range-key="display_name" data-field="coachIndex" value="{{coachIndex}}" bindchange="pick">{{workspace.approvedCoaches[coachIndex].display_name || '需先审核教练'}}</picker></view><view class="inline-actions"><button class="figma-action figma-action--ghost" bindtap="addSession">添加课次</button><button class="figma-action figma-action--ghost" bindtap="clearSessions">清空待建课次</button></view><view wx:for="{{sessions}}" wx:key="startsAt" class="figma-row"><view class="figma-row__title">{{index+1}}. {{item.label}}</view></view><picker class="figma-field-control" range="{{cutoffs}}" value="{{cutoffIndex}}" data-field="cutoffIndex" bindchange="pick">{{cutoffs[cutoffIndex]}}</picker><textarea class="figma-field-control" placeholder="合同：授课范围、逐课退费、请假与补课规则" data-field="termsText" value="{{termsText}}" bindinput="input"/><button class="figma-action figma-action--orange" bindtap="createCohort" disabled="{{busy || pending}}">保存班期草稿</button></view>
    </block>

    <view wx:if="{{manageTab==='cohorts' && !roster && !enrollment}}" class="figma-section"><view class="figma-eyebrow">班期与课次</view><view class="figma-section__title">班期管理</view><view wx:for="{{workspace.cohorts}}" wx:key="id" class="cohort-card"><view class="section-heading"><view><view class="figma-row__title">{{item.title}}</view><view class="figma-row__subtitle">{{item.amount}} · 名额 {{item.available}} / {{item.capacity}}</view></view><view class="figma-status figma-status--orange">{{item.stateLabel}}</view></view><view wx:if="{{item.capabilities.completionBlocker}}" class="figma-caption">结课条件：{{item.capabilities.completionBlocker}}</view><view wx:if="{{item.state==='SUSPENDED' && item.capabilities.resumeBlocker}}" class="figma-caption">恢复条件：{{item.capabilities.resumeBlocker}}</view><view wx:if="{{item.state!=='COMPLETED' && item.state!=='CANCELLED'}}" class="row-actions"><button wx:if="{{item.state==='DRAFT'}}" data-id="{{item.id}}" data-action="PUBLISH" bindtap="cohortAction" disabled="{{busy || pending}}">发布</button><button data-id="{{item.id}}" data-action="COMPLETE" bindtap="cohortAction" disabled="{{busy || pending || !item.capabilities.canComplete}}">正常结课</button><button wx:if="{{item.state==='SUSPENDED'}}" data-id="{{item.id}}" data-action="RESUME" bindtap="cohortAction" disabled="{{busy || pending || !item.capabilities.canResume}}">恢复班期</button><button wx:if="{{item.state==='ENROLLING' || item.state==='RUNNING'}}" data-id="{{item.id}}" data-action="SUSPEND" bindtap="cohortAction" disabled="{{busy || pending}}">暂停班期</button><button data-id="{{item.id}}" data-action="CANCEL" bindtap="cohortAction" disabled="{{busy || pending}}">取消</button></view><button wx:for="{{item.sessions}}" wx:for-item="lesson" wx:key="id" class="session-link" data-id="{{lesson.id}}" bindtap="roster">{{lesson.time}} · 课次名单</button></view><figma-feedback wx:if="{{workspace && !workspace.cohorts.length && !loading}}" type="empty" title="暂无班期" body="先核验机构与教练资格，再到资质与排课建立班期。"/></view>

    <view wx:if="{{roster}}" class="figma-section roster-section"><view class="section-heading"><view><view class="figma-eyebrow">本课名单</view><view class="figma-section__title">{{roster.session.time}}</view></view><view class="figma-status figma-status--orange">{{roster.session.stateLabel}}</view></view><button wx:if="{{roster.session.state==='SCHEDULED'}}" class="figma-action figma-action--orange" bindtap="sessionAction" disabled="{{busy || pending}}">教练提交实际授课记录</button><view wx:for="{{roster.learners}}" wx:key="id" class="learner-row"><view><view class="figma-row__title">{{item.display_name}}</view><view class="figma-row__subtitle">{{item.stateLabel}}</view></view><view class="row-actions"><button data-id="{{item.id}}" data-action="CHECKIN" bindtap="lessonAction" disabled="{{busy || pending}}">签到</button><button data-id="{{item.id}}" data-action="CHECKOUT" bindtap="lessonAction" disabled="{{busy || pending}}">签退</button><button data-id="{{item.id}}" data-action="PROPOSE_CONSUMPTION" bindtap="lessonAction" disabled="{{busy || pending}}">提出消费</button></view></view><view class="figma-row__title">消费复核</view><view wx:for="{{roster.consumptions}}" wx:key="id" class="record-row"><view>{{item.stateLabel}} · {{item.reason}}</view><view wx:if="{{item.status==='PROPOSED'}}" class="row-actions"><button data-id="{{item.id}}" data-action="REVIEW" bindtap="consumptionAction" disabled="{{busy || pending}}">复核</button><button data-id="{{item.id}}" data-action="REJECT" bindtap="consumptionAction" disabled="{{busy || pending}}">驳回</button></view></view></view>

    <view wx:if="{{manageTab==='reviews' && !enrollment}}" class="figma-section"><view class="figma-eyebrow">独立复核</view><view class="figma-section__title">退费与消费异议</view><button wx:for="{{workspace.enrollments}}" wx:key="id" class="figma-row" data-id="{{item.id}}" bindtap="enrollment"><view class="figma-row__copy"><view class="figma-row__title">报名 {{item.id}}</view><view class="figma-row__subtitle">退款、消费与异议分别核对</view></view><view class="figma-status figma-status--orange">{{item.state}}</view></button><figma-feedback wx:if="{{workspace && !workspace.enrollments.length && !loading}}" type="empty" title="暂无待核对报名" body="审核不等于渠道到账，真实退款继续由交易回执确认。"/></view>

    <view wx:if="{{enrollment}}" class="figma-section enrollment-review"><view class="section-heading"><view><view class="figma-eyebrow">报名复核</view><view class="figma-section__title">{{enrollment.stateLabel}}</view></view><view class="price-copy">{{enrollment.amount}}</view></view><view class="figma-row__title">退款申请</view><view wx:for="{{enrollment.refunds}}" wx:key="id" class="record-row"><view><view>{{item.amount}} · {{item.stateLabel}}</view><view class="figma-caption">{{item.reason}}</view></view><view wx:if="{{item.status==='PENDING_REVIEW'}}" class="row-actions"><button data-id="{{item.id}}" data-action="APPROVE" bindtap="refundAction" disabled="{{busy || pending}}">批准</button><button data-id="{{item.id}}" data-action="REJECT" bindtap="refundAction" disabled="{{busy || pending}}">驳回</button></view></view><view class="figma-caption">收费退款批准后还须在统一交易页审核并发送；此处不代表渠道到账。</view><view class="figma-row__title">消费异议</view><view wx:for="{{enrollment.consumptions}}" wx:key="id" class="record-row"><view>{{item.stateLabel}} · {{item.dispute_reason}}</view><view wx:if="{{isOperator && item.status==='DISPUTED'}}" class="row-actions"><button data-id="{{item.id}}" data-action="RESOLVE_UPHOLD" bindtap="consumptionAction" disabled="{{busy || pending}}">维持消费</button><button data-id="{{item.id}}" data-action="RESOLVE_ADJUST" bindtap="consumptionAction" disabled="{{busy || pending}}">返还权益</button></view></view></view>
  </view>
  <view wx:if="{{manageTab==='teaching' && !roster && !enrollment}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost" data-key="cohorts" bindtap="manageTab" disabled="{{busy || !workspace}}">管理班期</button><button class="figma-action figma-action--orange" data-id="{{teaching[0].id}}" bindtap="roster" disabled="{{busy || loading || !teaching.length}}">查看本课签到</button></view>
</view>
