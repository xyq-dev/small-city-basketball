<view class="screen"><view class="hero"><text class="eyebrow">培训工作台</text><text class="title">从排课到课次核对</text><text>签到、授课、消费与退费分别记录。</text></view>
<view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view><button wx:if="{{loginRequired}}" bindtap="login">登录</button>
<view wx:if="{{pending}}" class="notice">上次操作需先核对。<button bindtap="recover">核对回执</button><button bindtap="retry">用原编号重试</button></view>
<view class="card"><picker range="{{organizations}}" range-key="name" value="{{orgIndex}}" bindchange="pickOrg"><view>机构：{{organizations[orgIndex].name || '选择机构'}}</view></picker><view wx:if="{{isOperator}}"><input placeholder="需审核的机构编号" data-field="orgId" bindinput="input" value="{{orgId}}"/><button bindtap="load">读取机构</button></view><textarea placeholder="本次审核、授课、停课、恢复或结课的事实依据" data-field="reason" bindinput="input" value="{{reason}}"/></view>
<view wx:for="{{coachProfiles}}" wx:key="id" class="card"><text>{{item.display_name}} · {{item.status}}</text><button wx:if="{{!item.consented}}" data-id="{{item.id}}" data-action="CONSENT" bindtap="coachAction" disabled="{{busy || pending}}">本人确认承担本机构教练职责</button></view>
<view wx:for="{{teaching}}" wx:key="id" class="card"><text>{{item.title}} · {{item.time}} · {{item.stateLabel}}</text><button data-id="{{item.id}}" bindtap="roster">本课签到与授课</button></view>
<view wx:if="{{workspace}}" class="card"><text class="heading">机构与教练资格</text><picker mode="date" data-field="qualifiedUntil" bindchange="pick"><view>资质到期日期：{{qualifiedUntil || '请选择'}}</view></picker><block wx:if="{{!workspace.provider}}"><input placeholder="培训机构名称" data-field="providerName" value="{{providerName}}" bindinput="input"/><input placeholder="资质材料受限存档编号" data-field="providerEvidence" value="{{providerEvidence}}" bindinput="input"/><button bindtap="createProvider" disabled="{{busy || pending}}">提交培训机构审核</button></block><block wx:else><text>{{workspace.provider.name}} · {{workspace.provider.status}}</text><view wx:if="{{isOperator}}" class="actions"><button data-action="APPROVE" bindtap="providerAction" disabled="{{busy || pending}}">独立审核通过</button><button data-action="REJECT" bindtap="providerAction" disabled="{{busy || pending}}">退回</button><button data-action="SUSPEND" bindtap="providerAction" disabled="{{busy || pending}}">暂停资格</button></view><input placeholder="教练账户编号" data-field="coachUserId" value="{{coachUserId}}" bindinput="input"/><input placeholder="教练对外名称" data-field="coachName" value="{{coachName}}" bindinput="input"/><input placeholder="教练资质受限存档编号" data-field="coachEvidence" value="{{coachEvidence}}" bindinput="input"/><button bindtap="addCoach" disabled="{{busy || pending}}">登记教练，等待本人确认与独立复核</button><view wx:for="{{workspace.coaches}}" wx:key="id" class="lesson"><text>{{item.display_name}} · {{item.status}} · 本人确认 {{item.consented ? '已完成' : '未完成'}}</text><view class="actions"><button data-id="{{item.id}}" data-action="APPROVE" bindtap="coachAction" disabled="{{busy || pending}}">独立复核</button><button data-id="{{item.id}}" data-action="SUSPEND" bindtap="coachAction" disabled="{{busy || pending}}">暂停</button></view></view></block></view>
<view wx:if="{{workspace.provider}}" class="card"><text class="heading">课程模板</text><input placeholder="课程名称" data-field="courseTitle" value="{{courseTitle}}" bindinput="input"/><textarea placeholder="训练目标与适用成年人群" data-field="courseDescription" value="{{courseDescription}}" bindinput="input"/><button bindtap="createCourse" disabled="{{busy || pending}}">保存课程</button></view>
<view wx:if="{{workspace.courses.length}}" class="card"><text class="heading">安排固定短班</text><picker range="{{workspace.courses}}" range-key="title" value="{{courseIndex}}" data-field="courseIndex" bindchange="pick"><view>课程：{{workspace.courses[courseIndex].title}}</view></picker><picker range="{{workspace.courts}}" range-key="name" value="{{courtIndex}}" data-field="courtIndex" bindchange="pick"><view>场地：{{workspace.courts[courtIndex].name || '请先配置场地'}}</view></picker><input placeholder="班期名称" data-field="cohortTitle" value="{{cohortTitle}}" bindinput="input"/><input placeholder="上课详细地址" data-field="address" value="{{address}}" bindinput="input"/><view class="row"><input type="number" placeholder="人数上限" data-field="capacity" value="{{capacity}}" bindinput="input"/><input type="digit" placeholder="课程总价（元）" data-field="price" value="{{price}}" bindinput="input"/></view><text class="small">最多8节、跨度8周。总价按各课等权分摊，发布后冻结；0元为免费课。</text><picker mode="date" data-field="lessonDate" bindchange="pick"><view>课次日期：{{lessonDate || '请选择'}}</view></picker><picker mode="time" data-field="startTime" bindchange="pick"><view>开始时间：{{startTime || '请选择'}}</view></picker><picker mode="time" data-field="endTime" bindchange="pick"><view>结束时间：{{endTime || '请选择'}}</view></picker><picker range="{{workspace.approvedCoaches}}" range-key="display_name" data-field="coachIndex" value="{{coachIndex}}" bindchange="pick"><view>教练：{{workspace.approvedCoaches[coachIndex].display_name || '需先审核教练'}}</view></picker><view class="actions"><button bindtap="addSession">添加这节课</button><button bindtap="clearSessions">清空待建课次</button></view><text wx:for="{{sessions}}" wx:key="startsAt">{{index + 1}}. {{item.label}}</text><picker range="{{cutoffs}}" value="{{cutoffIndex}}" data-field="cutoffIndex" bindchange="pick"><view>{{cutoffs[cutoffIndex]}}</view></picker><textarea placeholder="合同：授课范围、逐课退费、请假与补课规则" data-field="termsText" value="{{termsText}}" bindinput="input"/><button class="primary" bindtap="createCohort" disabled="{{busy || pending}}">保存班期草稿</button></view>
<view wx:for="{{workspace.cohorts}}" wx:key="id" class="card"><text class="heading">{{item.title}} · {{item.stateLabel}}</text><text>{{item.amount}} · 名额 {{item.available}} / {{item.capacity}}</text><text wx:if="{{item.capabilities.completionBlocker}}" class="small">结课条件：{{item.capabilities.completionBlocker}}</text><text wx:if="{{item.state === 'SUSPENDED' && item.capabilities.resumeBlocker}}" class="small">恢复条件：{{item.capabilities.resumeBlocker}}</text><view wx:if="{{item.state !== 'COMPLETED' && item.state !== 'CANCELLED'}}" class="actions"><button wx:if="{{item.state === 'DRAFT'}}" data-id="{{item.id}}" data-action="PUBLISH" bindtap="cohortAction" disabled="{{busy || pending}}">核验资质和档期并发布</button><button data-id="{{item.id}}" data-action="COMPLETE" bindtap="cohortAction" disabled="{{busy || pending || !item.capabilities.canComplete}}">正常结课</button><button wx:if="{{item.state === 'SUSPENDED'}}" data-id="{{item.id}}" data-action="RESUME" bindtap="cohortAction" disabled="{{busy || pending || !item.capabilities.canResume}}">恢复班期</button><button wx:if="{{item.state === 'ENROLLING' || item.state === 'RUNNING'}}" data-id="{{item.id}}" data-action="SUSPEND" bindtap="cohortAction" disabled="{{busy || pending}}">暂停班期</button><button data-id="{{item.id}}" data-action="CANCEL" bindtap="cohortAction" disabled="{{busy || pending}}">取消未授课课次</button></view><button wx:for="{{item.sessions}}" wx:for-item="lesson" wx:key="id" data-id="{{lesson.id}}" bindtap="roster">{{lesson.time}} · 课次名单</button></view>
<view wx:if="{{roster}}" class="card"><text class="heading">本课名单 · {{roster.session.stateLabel}}</text><text>{{roster.session.time}}</text><button wx:if="{{roster.session.state === 'SCHEDULED'}}" bindtap="sessionAction" disabled="{{busy || pending}}">教练提交实际授课记录</button><view wx:for="{{roster.learners}}" wx:key="id" class="lesson"><text>{{item.display_name}} · {{item.stateLabel}}</text><view class="actions"><button data-id="{{item.id}}" data-action="CHECKIN" bindtap="lessonAction" disabled="{{busy || pending}}">现场核验后签到</button><button data-id="{{item.id}}" data-action="CHECKOUT" bindtap="lessonAction" disabled="{{busy || pending}}">签退</button><button data-id="{{item.id}}" data-action="PROPOSE_CONSUMPTION" bindtap="lessonAction" disabled="{{busy || pending}}">提出课次消费</button></view></view><view wx:for="{{roster.consumptions}}" wx:key="id" class="lesson"><text>{{item.stateLabel}} · {{item.reason}}</text><view wx:if="{{item.status === 'PROPOSED'}}" class="actions"><button data-id="{{item.id}}" data-action="REVIEW" bindtap="consumptionAction" disabled="{{busy || pending}}">独立复核消费事实</button><button data-id="{{item.id}}" data-action="REJECT" bindtap="consumptionAction" disabled="{{busy || pending}}">驳回消费</button></view></view></view>
<view wx:for="{{workspace.enrollments}}" wx:key="id" class="card"><text>报名 {{item.id}} · {{item.state}}</text><button data-id="{{item.id}}" bindtap="enrollment">复核退费与消费异议</button></view>
<view wx:if="{{enrollment}}" class="card"><text class="heading">{{enrollment.stateLabel}} · {{enrollment.amount}}</text><view wx:for="{{enrollment.refunds}}" wx:key="id" class="lesson"><text>{{item.amount}} · {{item.stateLabel}} · {{item.reason}}</text><view wx:if="{{item.status === 'PENDING_REVIEW'}}" class="actions"><button data-id="{{item.id}}" data-action="APPROVE" bindtap="refundAction" disabled="{{busy || pending}}">独立批准逐课退费</button><button data-id="{{item.id}}" data-action="REJECT" bindtap="refundAction" disabled="{{busy || pending}}">驳回并保留补课权益</button></view><text class="small">收费退款批准后，还须在统一交易页审核并发送；这里只按真实回执更新。</text></view><view wx:for="{{enrollment.consumptions}}" wx:key="id" class="lesson"><text>{{item.stateLabel}} · {{item.dispute_reason}}</text><view wx:if="{{isOperator && item.status === 'DISPUTED'}}" class="actions"><button data-id="{{item.id}}" data-action="RESOLVE_UPHOLD" bindtap="consumptionAction" disabled="{{busy || pending}}">独立裁决维持消费</button><button data-id="{{item.id}}" data-action="RESOLVE_ADJUST" bindtap="consumptionAction" disabled="{{busy || pending}}">独立裁决返还权益</button></view></view></view>
</view>
