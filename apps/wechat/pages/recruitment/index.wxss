.recruit-page { display:flex; flex-direction:column; gap:12px; padding-bottom:calc(116px + env(safe-area-inset-bottom)); color:#18283f; background:#f4f6fa; }
.recruit-page > .fig-summary,.recruit-page > .card,.recruit-page > .notice,.recruit-page > button { margin:0; }
.recruit-summary-image { overflow:hidden; background:#eaf2fc; }
.recruit-summary-image image { width:100%; height:100%; border-radius:10px; }
.recruit-tabs { display:flex; gap:1px; padding:2px 3px; border-radius:12px; background:#fff; }
.recruit-tabs button { flex:1; min-width:0; min-height:44px; margin:0; padding:8px 4px; border-radius:10px; color:#63758b; background:transparent; font-size:13px; line-height:20px; }
.recruit-tabs button::after { border:0; }
.recruit-tabs button.selected { color:#fff; background:#123c73; }
.recruit-notice { padding:10px 12px; font-size:12px; line-height:20px; }
.recruit-panel { margin:0; padding:14px; border-radius:16px; box-shadow:none; }
.recruit-panel .title { margin:0 0 8px; color:#18283f; font-size:18px; line-height:26px; }
.recruit-panel .field,.recruit-panel input,.recruit-panel textarea { box-sizing:border-box; width:100%; min-height:44px; margin:8px 0 12px; padding:10px 12px; border:0; border-radius:8px; background:#f4f6fa; color:#18283f; font-size:14px; line-height:22px; }
.recruit-panel textarea { min-height:88px; }
.recruit-panel button { min-height:44px; margin:8px 0 0; border-radius:12px; font-size:14px; line-height:22px; }
.recruit-panel .row { padding:12px 0; border-bottom:1px solid #e6ebf2; }
.recruit-panel .row:last-child { border-bottom:0; }
.recruit-panel text { white-space:pre-wrap; overflow-wrap:anywhere; }
.recruit-page > .error { margin:0; padding:12px; border-radius:8px; }
@media(max-width:360px) { .recruit-page { padding-left:12px; padding-right:12px; } .recruit-tabs button { font-size:12px; } }
