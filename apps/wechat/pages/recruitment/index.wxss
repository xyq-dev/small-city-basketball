@import "../../styles/figma-pages.wxss";

.recruitment-hero{display:flex;width:100%;min-height:108px;align-items:center;overflow:hidden;padding:14px;border-radius:16px;background:#123c73;color:#fff}.recruitment-hero__copy{display:flex;min-width:0;flex:1;padding-right:12px;flex-direction:column;justify-content:center}.recruitment-hero .figma-eyebrow{color:#dce7f5}.recruitment-hero__title{font-size:21px;font-weight:700;line-height:30px;overflow-wrap:anywhere}.recruitment-hero__subtitle{margin-top:3px;color:#dce7f5;font-size:12px;line-height:17px}.recruitment-hero image{width:128px;height:80px;flex:none;border-radius:10px}.recruitment-tabs{display:grid;height:48px;padding:2px 3px;grid-template-columns:repeat(3,minmax(0,1fr));border-radius:12px;background:#fff}.recruitment-tab{display:flex;min-width:0;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 4px;border:0;border-radius:10px;background:transparent;color:#51657d;font-size:13px}.recruitment-tab.is-active{background:#123c73;color:#fff;font-weight:700}.recruitment-readonly{display:flex;align-items:center}.process-row,.recruitment-choice{display:flex;width:100%;min-height:55px;align-items:center;gap:8px}.process-row+.process-row,.recruitment-choice+.recruitment-choice{border-top:1px solid #e6ebf2}.process-no{display:flex;width:20px;height:20px;flex:none;align-items:center;justify-content:center;border-radius:10px;background:#eaf2fc;color:#123c73;font-size:11px}.recruitment-choice{margin:0;padding:0;border:0;background:transparent;color:#18283f;text-align:left}.recruitment-description{padding:10px;border-radius:10px;background:#f4f6fa;color:#51657d;font-size:13px;line-height:20px;white-space:pre-wrap}.profile-head{display:flex;min-height:44px;align-items:center;justify-content:space-between;gap:8px}.two-fields{display:grid;grid-template-columns:minmax(0,2fr) minmax(96px,1fr);gap:8px}.bulk-field{height:160px}.section-primary,.section-ghost,.section-danger,.row-action{display:flex;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 12px;border-radius:22px;font-size:14px}.section-primary,.section-ghost,.section-danger{width:100%}.section-primary{border:0;background:#123c73;color:#fff}.section-ghost{border:1px solid #7c8ea5;background:#fff;color:#123c73}.section-danger{border:1px solid #c83f42;background:#fff;color:#c83f42}.row-action{min-width:64px;border:0;background:#eaf2fc;color:#123c73}.recruitment-tab::after,.recruitment-choice::after,.section-primary::after,.section-ghost::after,.section-danger::after,.row-action::after{border:0}.two-actions,.application-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.application-actions{margin-top:8px}.application-row{padding:8px 0;border-top:1px solid #e6ebf2}@media(max-width:360px){.recruitment-hero{padding:12px}.recruitment-hero image{width:104px}.recruitment-hero__title{font-size:18px;line-height:26px}.two-fields{grid-template-columns:1fr}}
