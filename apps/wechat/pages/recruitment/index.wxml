<view class="page">
 <view class="title">{{mode==='manage'?'本届招募与导入':mode==='public'?'赛事公开招募':'我的申请与本届邀请'}}</view>
 <view class="notice">申请通过后仍需补齐本届名单并审核；邀请仅面向指定账号，不授赛事工作人员权限。</view>
 <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view>
 <button wx:if="{{loginRequired}}" bindtap="login">登录后申请／处理邀请</button><button bindtap="load" disabled="{{busy||loading}}">{{loading?'读取中':'重新读取'}}</button>
 <view wx:if="{{pending}}" class="card"><view>存在尚未核对的原请求：{{pending.body.clientRequestId}}</view><button bindtap="recover" disabled="{{busy}}">查询原回执</button><button bindtap="recover" data-replay="yes" disabled="{{busy}}">以原编号和原内容重试</button></view>
 <view wx:if="{{public}}" class="card"><view class="title">{{public.title}}</view><view>{{public.event.name}} · {{public.event.startDate}}—{{public.event.endDate}}</view><view>{{public.event.venueName}}</view><text selectable>{{public.description}}</text><view>截止：{{public.closesAt}}</view><view>每队{{public.requirements.minPlayers}}—{{public.requirements.maxPlayers}}人</view><view>{{public.notice}}</view>
 <input placeholder="队伍名称" value="{{teamName}}" data-field="teamName" bindinput="input" maxlength="80" disabled="{{busy||pending}}"/><input placeholder="已有球队编号（本人须为领队；新队留空）" value="{{teamId}}" data-field="teamId" bindinput="input" disabled="{{busy||pending}}"/><textarea placeholder="申请说明（选填）" value="{{note}}" data-field="note" bindinput="input" maxlength="500" disabled="{{busy||pending}}"/><button bindtap="apply" disabled="{{busy||pending||!userId}}">提交本届参赛申请</button></view>
 <view wx:if="{{workspace}}" class="card"><view class="title">{{workspace.event.name}}</view><view>{{workspace.event.status}} · 版本{{workspace.event.version}}</view><view wx:if="{{workspace.publication}}">招募：{{workspace.publication.title}} · {{workspace.publication.status}}</view>
 <block wx:if="{{workspace.capabilities.canPublish}}"><input placeholder="招募标题" value="{{title}}" data-field="title" bindinput="input" maxlength="80"/><textarea placeholder="招募说明、费用和报名要求" value="{{description}}" data-field="description" bindinput="input" maxlength="2000"/><input placeholder="截止时间，如2026-12-01T18:00:00+08:00" value="{{closesAt}}" data-field="closesAt" bindinput="input"/><input type="number" placeholder="申请容量1—256" value="{{maxApplications}}" data-field="maxApplications" bindinput="input"/><button bindtap="publish" disabled="{{busy||pending}}">发布独立招募页</button></block>
 <button wx:if="{{workspace.publication.status==='ACTIVE'}}" open-type="share">分享招募页</button>
 <textarea placeholder="处理／撤销理由，至少4字" value="{{reason}}" data-field="reason" bindinput="input" maxlength="500"/><button wx:if="{{workspace.capabilities.canRevoke}}" bindtap="revoke" disabled="{{busy||pending}}">撤销招募公开页</button>
 <block wx:if="{{workspace.capabilities.canImport}}"><view class="title">批量录入</view><view>每行：队名 [Tab] 已有球队编号（可空） [Tab] 邀请领队账号编号（可空）；最多32行。先预览逐行错误，再提交。不要填写证件、照片或保单。</view><textarea value="{{bulk}}" data-field="bulk" bindinput="input" maxlength="24000" disabled="{{busy||pending}}" placeholder="可从表格复制三列并粘贴"/><button bindtap="preview" disabled="{{busy||pending}}">生成逐行预览</button><view wx:if="{{preview}}"><view>预览有效至{{preview.expiresAt}} · {{preview.rows.length}}行</view><view wx:for="{{preview.rows}}" wx:key="index" class="row">第{{index+1}}行：{{item.teamName}} · {{item.teamId||'新建球队'}} · {{item.leaderUserId||'暂不邀请领队'}}</view><view wx:for="{{preview.issues}}" wx:key="index" class="error">第{{item.row}}行 · {{item.field}}：{{item.message}}</view><view wx:if="{{preview.blocker}}">尚未开放报名，仅可预览</view><button bindtap="commit" disabled="{{busy||pending||!preview.canCommit}}">确认整批提交</button></view></block>
 <block wx:if="{{workspace.capabilities.canInvite}}"><view class="title">本届专属领队邀请</view><input placeholder="球队编号" value="{{teamId}}" data-field="teamId" bindinput="input"/><input placeholder="接收人账号编号" value="{{targetUserId}}" data-field="targetUserId" bindinput="input"/><input placeholder="7天内截止，如2026-11-02T18:00:00+08:00" value="{{expiresAt}}" data-field="expiresAt" bindinput="input"/><button bindtap="invite" disabled="{{busy||pending}}">发送至本人邀请列表</button></block></view>
 <view wx:if="{{userId}}" class="card"><view class="title">参赛申请</view><textarea wx:if="{{mode!=='manage'}}" placeholder="撤回理由，至少4字" value="{{reason}}" data-field="reason" bindinput="input" maxlength="500"/><view wx:for="{{applications}}" wx:key="id" class="row"><view>{{item.teamName}} · {{item.status}}</view><view>{{item.reviewReason}}</view><block wx:if="{{item.status==='PENDING'}}"><button wx:if="{{mode==='manage'&&item.applicantId!==userId}}" bindtap="review" data-id="{{item.id}}" data-decision="APPROVE" disabled="{{busy||pending}}">批准为待补齐报名</button><button wx:if="{{mode==='manage'&&item.applicantId!==userId}}" bindtap="review" data-id="{{item.id}}" data-decision="REJECT" disabled="{{busy||pending}}">拒绝</button><button wx:if="{{item.applicantId===userId}}" bindtap="review" data-id="{{item.id}}" data-decision="WITHDRAW" disabled="{{busy||pending}}">撤回本人申请</button></block></view><button wx:if="{{applicationCursor}}" bindtap="more" data-kind="applications" disabled="{{busy||loading}}">更多申请</button></view>
 <view wx:if="{{userId}}" class="card"><view class="title">本届邀请</view><view wx:for="{{invitations}}" wx:key="id" class="row"><view>{{item.eventName}} · {{item.teamName}} · {{item.status}}</view><view>到期{{item.expiresAt}}</view><block wx:if="{{item.status==='PENDING'}}"><button wx:if="{{item.targetUserId===userId}}" bindtap="decide" data-id="{{item.id}}" data-decision="ACCEPT" disabled="{{busy||pending}}">本人接受</button><button wx:if="{{item.targetUserId===userId}}" bindtap="decide" data-id="{{item.id}}" data-decision="DECLINE" disabled="{{busy||pending}}">拒绝</button><button wx:if="{{mode==='manage'}}" bindtap="decide" data-id="{{item.id}}" data-decision="REVOKE" disabled="{{busy||pending}}">撤销邀请</button></block></view><button wx:if="{{invitationCursor}}" bindtap="more" data-kind="invitations" disabled="{{busy||loading}}">更多邀请</button></view>
</view>
