<scb-header title="赛事招募" disabled="{{busy || !!pending}}"/>
<view class="figma-page recruitment-page">
  <view class="figma-page__content figma-page__content--actions">
    <view class="recruitment-hero"><view class="recruitment-hero__copy"><view class="figma-eyebrow">{{mode==='manage' ? '机构办赛' : mode==='public' ? '公开招募' : '我的申请'}}</view><view class="recruitment-hero__title">{{mode==='manage' ? '本届招募与导入' : mode==='public' ? (public ? public.title : '城市邀请赛 · 球队招募') : '参赛申请与本届邀请'}}</view><view class="recruitment-hero__subtitle">{{public ? public.event.venueName + ' · 主办方独立发布' : '申请、报名名单与工作人员权限分别管理'}}</view></view><image src="/assets/home/event-court.jpg" mode="aspectFill"/></view>
    <view class="recruitment-tabs"><button class="recruitment-tab is-active">招募详情</button><button class="recruitment-tab" bindtap="scrollApplications">本届申请</button><button class="recruitment-tab" bindtap="scrollInvitations">本届邀请</button></view>
    <figma-feedback wx:if="{{error}}" type="error" title="操作未完成" body="{{error}}" action-label="重新读取" bind:action="load"/>
    <figma-feedback wx:if="{{message}}" type="success" title="状态已更新" body="{{message}}"/>
    <figma-feedback wx:if="{{loginRequired}}" type="empty" title="登录后继续" body="申请和邀请只面向当前登录账号。" action-label="登录并继续" bind:action="login"/>
    <view wx:if="{{loading}}" class="figma-section"><figma-skeleton rows="{{5}}"/></view>
    <view wx:if="{{pending}}" class="figma-section"><figma-feedback type="pending" title="原请求结果待核对" body="请求编号：{{pending.body.clientRequestId}}"/><view class="two-actions"><button class="section-ghost" bindtap="recover" disabled="{{busy}}">查询原回执</button><button class="section-primary" bindtap="recover" data-replay="yes" disabled="{{busy}}">以原编号和原内容重试</button></view></view>

    <block wx:if="{{public}}">
      <view class="figma-section recruitment-rules"><view class="figma-section__title">参赛规程</view><view class="figma-field-group"><view class="figma-field-label">赛事日期</view><view class="figma-field-control recruitment-readonly">{{public.event.startDate}}—{{public.event.endDate}}</view></view><view class="figma-field-group"><view class="figma-field-label">报名截止</view><view class="figma-field-control recruitment-readonly">{{public.closesAt}} · 北京时间</view></view><view class="figma-field-group"><view class="figma-field-label">参赛主体</view><view class="figma-field-control recruitment-readonly">按本届规则提交球队资料</view></view></view>
      <view class="figma-section"><view class="figma-section__title">申请流程</view><view class="process-row"><view class="process-no">1</view><view class="figma-row__copy"><view class="figma-row__title">提交本届申请</view><view class="figma-row__subtitle">填写球队与申请说明</view></view></view><view class="process-row"><view class="process-no">2</view><view class="figma-row__copy"><view class="figma-row__title">主办方审核</view><view class="figma-row__subtitle">批准后进入待补齐报名</view></view></view><view class="process-row"><view class="process-no">3</view><view class="figma-row__copy"><view class="figma-row__title">补齐资料</view><view class="figma-row__subtitle">按本届规则独立核验资格</view></view></view></view>
      <view class="figma-section"><view class="figma-section__title">本人事项</view><button class="recruitment-choice" bindtap="scrollApplications"><view class="figma-row__mark"/><view class="figma-row__copy"><view class="figma-row__title">本届申请</view><view class="figma-row__subtitle">查看或撤回本人申请</view></view></button><button class="recruitment-choice" bindtap="scrollInvitations"><view class="figma-row__mark"/><view class="figma-row__copy"><view class="figma-row__title">本届邀请</view><view class="figma-row__subtitle">核对指定赛事与授权范围</view></view></button></view>
      <view class="figma-section"><view class="figma-section__title">提交本届申请</view><view class="figma-section__hint">{{public.event.name}} · 每队 {{public.requirements.minPlayers}}—{{public.requirements.maxPlayers}} 人</view><view class="recruitment-description">{{public.description}}</view><view class="figma-field-group"><view class="figma-field-label">队伍名称</view><input class="figma-field-control" value="{{teamName}}" data-field="teamName" bindinput="input" maxlength="80" disabled="{{busy || !!pending}}" placeholder="填写本届申请队名"/></view><view class="figma-field-group"><view class="figma-field-label">已有球队编号（可选）</view><input class="figma-field-control" value="{{teamId}}" data-field="teamId" bindinput="input" disabled="{{busy || !!pending}}" placeholder="本人须持有领队授权"/></view><view class="figma-field-group"><view class="figma-field-label">申请说明（可选）</view><textarea class="figma-field-control" value="{{note}}" data-field="note" bindinput="input" maxlength="500" disabled="{{busy || !!pending}}" placeholder="补充队伍与参赛情况"/></view><button class="section-ghost" open-type="share">分享公开招募</button></view>
    </block>

    <block wx:if="{{workspace}}">
      <view class="figma-section"><view class="profile-head"><view><view class="figma-section__title">{{workspace.event.name}}</view><view class="figma-section__hint">{{workspace.event.status}} · 版本 {{workspace.event.version}}</view></view><view wx:if="{{workspace.publication}}" class="figma-status {{workspace.publication.status==='ACTIVE' ? 'figma-status--green' : ''}}">{{workspace.publication.status}}</view></view>
        <block wx:if="{{workspace.capabilities.canPublish}}"><view class="figma-field-group"><view class="figma-field-label">招募标题</view><input class="figma-field-control" value="{{title}}" data-field="title" bindinput="input" maxlength="80"/></view><view class="figma-field-group"><view class="figma-field-label">招募说明、费用和报名要求</view><textarea class="figma-field-control" value="{{description}}" data-field="description" bindinput="input" maxlength="2000"/></view><view class="two-fields"><view class="figma-field-group"><view class="figma-field-label">截止时间</view><input class="figma-field-control" value="{{closesAt}}" data-field="closesAt" bindinput="input" placeholder="ISO 8601"/></view><view class="figma-field-group"><view class="figma-field-label">申请容量</view><input class="figma-field-control" type="number" value="{{maxApplications}}" data-field="maxApplications" bindinput="input"/></view></view><button class="section-primary" bindtap="publish" disabled="{{busy || !!pending}}">发布独立招募页</button></block>
        <button wx:if="{{workspace.publication.status==='ACTIVE'}}" class="section-ghost" open-type="share">分享招募页</button><view wx:if="{{mode==='manage'}}" class="figma-field-group"><view class="figma-field-label">处理或撤销理由</view><textarea class="figma-field-control" value="{{reason}}" data-field="reason" bindinput="input" maxlength="500" disabled="{{busy || !!pending}}" placeholder="至少4字"/></view><button wx:if="{{workspace.capabilities.canRevoke}}" class="section-danger" bindtap="revoke" disabled="{{busy || !!pending}}">撤销招募公开页</button>
      </view>

      <view wx:if="{{workspace.capabilities.canImport}}" class="figma-section"><view class="figma-section__title">批量录入</view><view class="figma-section__hint">每行依次填写队名、已有球队编号和邀请领队账号；最多32行。先预览逐行错误再提交。</view><textarea class="figma-field-control bulk-field" value="{{bulk}}" data-field="bulk" bindinput="input" maxlength="24000" disabled="{{busy || !!pending}}" placeholder="可从表格复制三列并粘贴"/><button class="section-ghost" bindtap="preview" disabled="{{busy || !!pending}}">生成逐行预览</button><view wx:if="{{preview}}"><view class="figma-caption">预览有效至 {{preview.expiresAt}} · {{preview.rows.length}} 行</view><view wx:for="{{preview.rows}}" wx:key="index" class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">第{{index+1}}行 · {{item.teamName}}</view><view class="figma-row__subtitle">{{item.teamId || '新建球队'}} · {{item.leaderUserId || '暂不邀请领队'}}</view></view></view><figma-feedback wx:for="{{preview.issues}}" wx:key="index" type="error" title="第{{item.row}}行 · {{item.field}}" body="{{item.message}}"/><figma-feedback wx:if="{{preview.blocker}}" type="pending" title="尚未开放报名" body="当前仅可预览，不能提交。"/><button class="section-primary" bindtap="commit" disabled="{{busy || !!pending || !preview.canCommit}}">确认整批提交</button></view></view>

      <view wx:if="{{workspace.capabilities.canInvite}}" class="figma-section"><view class="figma-section__title">本届专属领队邀请</view><view class="figma-field-group"><view class="figma-field-label">球队编号</view><input class="figma-field-control" value="{{teamId}}" data-field="teamId" bindinput="input"/></view><view class="figma-field-group"><view class="figma-field-label">接收人账号编号</view><input class="figma-field-control" value="{{targetUserId}}" data-field="targetUserId" bindinput="input"/></view><view class="figma-field-group"><view class="figma-field-label">截止时间</view><input class="figma-field-control" value="{{expiresAt}}" data-field="expiresAt" bindinput="input"/></view><button class="section-primary" bindtap="invite" disabled="{{busy || !!pending}}">发送至本人邀请列表</button></view>
    </block>

    <view id="recruitment-applications" wx:if="{{userId}}" class="figma-section"><view class="figma-section__title">参赛申请</view><view wx:if="{{mode!=='manage'}}" class="figma-field-group"><view class="figma-field-label">撤回理由</view><textarea class="figma-field-control" value="{{reason}}" data-field="reason" bindinput="input" maxlength="500" disabled="{{busy || !!pending}}" placeholder="至少4字"/></view><figma-feedback wx:if="{{!applications.length}}" type="empty" title="暂无参赛申请"/><view wx:for="{{applications}}" wx:key="id" class="application-row"><view class="profile-head"><view><view class="figma-row__title">{{item.teamName}}</view><view class="figma-row__subtitle">{{item.reviewReason || '暂无审核说明'}}</view></view><view class="figma-status">{{item.status}}</view></view><view wx:if="{{item.status==='PENDING'}}" class="application-actions"><button wx:if="{{mode==='manage' && item.applicantId!==userId}}" class="row-action" bindtap="review" data-id="{{item.id}}" data-decision="APPROVE" disabled="{{busy || !!pending}}">批准</button><button wx:if="{{mode==='manage' && item.applicantId!==userId}}" class="row-action" bindtap="review" data-id="{{item.id}}" data-decision="REJECT" disabled="{{busy || !!pending}}">拒绝</button><button wx:if="{{item.applicantId===userId}}" class="row-action" bindtap="review" data-id="{{item.id}}" data-decision="WITHDRAW" disabled="{{busy || !!pending}}">撤回</button></view></view><button wx:if="{{applicationCursor}}" class="section-ghost" bindtap="more" data-kind="applications" disabled="{{busy || loading}}">更多申请</button></view>

    <view id="recruitment-invitations" wx:if="{{userId}}" class="figma-section"><view class="figma-section__title">本届邀请</view><figma-feedback wx:if="{{!invitations.length}}" type="empty" title="暂无本届邀请"/><view wx:for="{{invitations}}" wx:key="id" class="application-row"><view class="profile-head"><view><view class="figma-row__title">{{item.eventName}} · {{item.teamName}}</view><view class="figma-row__subtitle">到期 {{item.expiresAt}}</view></view><view class="figma-status">{{item.status}}</view></view><view wx:if="{{item.status==='PENDING'}}" class="application-actions"><button wx:if="{{item.targetUserId===userId}}" class="row-action" bindtap="decide" data-id="{{item.id}}" data-decision="ACCEPT" disabled="{{busy || !!pending}}">本人接受</button><button wx:if="{{item.targetUserId===userId}}" class="row-action" bindtap="decide" data-id="{{item.id}}" data-decision="DECLINE" disabled="{{busy || !!pending}}">拒绝</button><button wx:if="{{mode==='manage'}}" class="row-action" bindtap="decide" data-id="{{item.id}}" data-decision="REVOKE" disabled="{{busy || !!pending}}">撤销邀请</button></view></view><button wx:if="{{invitationCursor}}" class="section-ghost" bindtap="more" data-kind="invitations" disabled="{{busy || loading}}">更多邀请</button></view>
  </view>
  <view class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="scrollInvitations" disabled="{{busy || loading}}">查看本届邀请</button><button wx:if="{{public}}" class="figma-action figma-action--orange" bindtap="apply" disabled="{{busy || !!pending || !userId || !teamName}}" loading="{{busy}}">提交本届参赛申请</button><button wx:else class="figma-action figma-action--orange" bindtap="scrollApplications" disabled="{{busy || loading}}">查看本届申请</button></view>
</view>
