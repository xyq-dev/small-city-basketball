.search-nav { background:#fff; }
.search-nav-row { height:64px; display:flex; align-items:center; gap:8px; padding-left:8px; box-sizing:border-box; }
.search-nav button.search-back { flex:none; width:44px; min-width:44px; max-width:44px; height:44px; min-height:44px; margin:0; padding:0; display:flex; align-items:center; justify-content:center; background:transparent; }
.search-nav button.search-back::after { border:0; }
.search-nav-title { flex:none; color:#123c73; font-size:16px; line-height:24px; font-weight:500; }
.search-page { max-width:none; padding:12px 16px calc(104px + env(safe-area-inset-bottom)); background:#f4f6fa; }
.search-summary { display:flex; align-items:center; gap:12px; margin-bottom:12px; padding:14px; border-radius:16px; background:#fff; }
.search-mark { width:44px; height:44px; display:flex; align-items:center; justify-content:center; flex:none; border-radius:12px; background:#eaf2fc; }
.search-mark image { width:25px; height:25px; }
.search-summary-copy { min-width:0; flex:1; }
.search-kicker { color:#63758b; font-size:11px; line-height:16px; }
.search-summary-title { margin-top:3px; color:#18283f; font-size:18px; line-height:26px; font-weight:700; }
.search-summary-sub { margin-top:3px; color:#63758b; font-size:12px; line-height:17px; }
.search-tabs { display:flex; gap:1px; margin-bottom:12px; padding:2px 3px; border-radius:12px; background:#fff; }
.search-tabs button { flex:1; min-width:0; height:44px; min-height:44px; margin:0; padding:0; border-radius:10px; background:transparent; color:#63758b; font-size:13px; line-height:19px; font-weight:400; }
.search-tabs button.on { background:#123c73; color:#fff; font-weight:700; }
.search-tabs button::after { border:0; }
.search-card { margin:0 0 12px; padding:14px; border-radius:16px; background:#fff; }
.search-card-title { margin:0 0 8px; color:#18283f; font-size:17px; line-height:24px; font-weight:700; }
.search-card .field { background:#f4f6fa; border-color:transparent; }
.search-row { padding:12px 0; border-top:1px solid #e6ebf2; }
.search-row .subtitle { overflow-wrap:anywhere; }
.search-badge { display:inline-flex; align-items:center; height:23px; margin-top:6px; padding:0 7px; border-radius:7px; background:#fff1e2; color:#18283f; font-size:11px; line-height:23px; }
.search-actions { position:fixed; z-index:12; left:0; right:0; bottom:0; display:flex; align-items:center; gap:8px; padding:6px 16px calc(16px + env(safe-area-inset-bottom)); background:#fff; }
.search-actions button { height:48px; min-height:48px; margin:0; padding:8px 12px; border-radius:24px; font-size:16px; line-height:24px; font-weight:500; white-space:nowrap; }
.search-actions button::after { border:0; }
.search-ghost { flex:none; width:128px; color:#123c73; background:#fff; box-shadow:inset 0 0 0 1px #e6ebf2; }
.search-confirm { flex:1; min-width:0; color:#18283f; background:#f28c28; }
.search-confirm[disabled],.search-ghost[disabled] { color:#63758b; background:#eaf0f7; }
