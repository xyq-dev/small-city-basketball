@import "../../styles/figma-pages.wxss";

.search-tabs { display:flex; width:100%; height:48px; padding:2px 3px; border-radius:12px; background:#ffffff; overflow:hidden; }
.search-rebuild .search-tab { display:flex; min-width:0; min-height:44px; flex:1; align-items:center; justify-content:center; border-radius:10px; color:#51657d; font-size:12px; line-height:18px; }
.search-rebuild .search-tab.is-active { background:#123c73; color:#ffffff; font-weight:700; }
.search-result + .search-result { border-top:1px solid #e6ebf2; }
@media (max-width:360px) { .search-rebuild .figma-action { padding-right:10px; padding-left:10px; font-size:14px; } }
