<scb-header title="全国搜索" back="{{true}}" disabled="{{busy}}"/>
<view class="scb-ui-page figma-page search-rebuild">
  <view class="figma-page__content figma-page__content--actions">
    <view class="figma-summary"><view class="figma-summary__icon"><figma-icon name="search" size="25"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">公开内容</view><view class="figma-title">搜索赛事、球队、球员</view><view class="figma-subtitle">查找赛事及获授权的球队、球员档案</view></view></view>

    <view class="search-tabs" role="tablist"><button wx:for="{{kinds}}" wx:key="key" class="search-tab {{kind===item.key ? 'is-active' : ''}}" data-kind="{{item.key}}" bindtap="filter" disabled="{{busy}}">{{item.label}}</button></view>

    <view class="figma-section">
      <view class="figma-section__title">搜索条件</view>
      <view class="figma-field-group"><view class="figma-field-label">搜索词</view><input class="figma-field-control" data-field="query" value="{{query}}" bindinput="input" bindconfirm="search" maxlength="80" placeholder="赛事、球队或球员名称" cursor-spacing="120"/></view>
      <view class="figma-field-group"><view class="figma-field-label">举办城市（选填）</view><input class="figma-field-control" data-field="city" value="{{city}}" bindinput="input" maxlength="40" placeholder="留空搜索全国" cursor-spacing="120"/></view>
    </view>

    <figma-skeleton wx:if="{{busy && !items.length}}" rows="3"/>
    <figma-feedback wx:if="{{error}}" type="error" title="搜索暂未完成" body="{{error}}" action-label="重新搜索" bind:action="search"/>
    <figma-feedback wx:if="{{notice}}" type="pending" title="搜索范围说明" body="{{notice}}"/>
    <figma-feedback wx:if="{{searched && !items.length && !busy && !error}}" type="empty" title="没有符合条件的公开结果" body="可调整搜索词、城市或内容类型。"/>

    <view wx:if="{{eventItems.length}}" class="figma-section">
      <view class="figma-section__title">赛事结果</view>
      <button wx:for="{{eventItems}}" wx:key="key" class="figma-row search-result" data-key="{{item.key}}" bindtap="open">
        <view class="figma-row__copy"><view class="figma-row__title">{{item.displayName}}</view><view class="figma-row__subtitle">{{item.city || '全国'}}<text wx:if="{{item.startsOn}}"> · {{item.startsOn}}—{{item.endsOn}}</text></view></view><view class="figma-status figma-status--orange">{{item.kindLabel}}</view>
      </button>
    </view>
    <view wx:if="{{teamItems.length}}" class="figma-section">
      <view class="figma-section__title">球队结果</view>
      <button wx:for="{{teamItems}}" wx:key="key" class="figma-row search-result" data-key="{{item.key}}" bindtap="open"><view class="figma-row__copy"><view class="figma-row__title">{{item.displayName}}</view><view class="figma-row__subtitle">{{item.city || '全国'}} · 已授权公开档案</view></view><view class="figma-status figma-status--orange">{{item.kindLabel}}</view></button>
    </view>
    <view wx:if="{{playerItems.length}}" class="figma-section">
      <view class="figma-section__title">球员结果</view>
      <button wx:for="{{playerItems}}" wx:key="key" class="figma-row search-result" data-key="{{item.key}}" bindtap="open"><view class="figma-row__copy"><view class="figma-row__title">{{item.displayName}}</view><view class="figma-row__subtitle">{{item.city || '全国'}} · 已授权公开档案</view></view><view class="figma-status figma-status--orange">{{item.kindLabel}}</view></button>
    </view>
  </view>

  <view class="figma-fixed-actions">
    <button class="figma-action figma-action--ghost" bindtap="more" disabled="{{busy || !cursor}}">继续加载</button>
    <button class="figma-action figma-action--orange" bindtap="search" disabled="{{busy || !query}}">{{busy ? '正在搜索' : '搜索'}}</button>
  </view>
</view>
