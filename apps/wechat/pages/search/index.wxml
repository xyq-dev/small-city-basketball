<view class="page"><scb-header title="搜索赛事、球队与球员"/><view class="card"><view class="field-label">搜索词</view><input class="field" data-field="query" value="{{query}}" bindinput="input" bindconfirm="search" maxlength="80" placeholder="赛事、球队或球员名称"/><view class="field-label">举办城市（选填）</view><input class="field" data-field="city" value="{{city}}" bindinput="input" maxlength="40" placeholder="留空搜索全国"/><button class="primary" bindtap="search" disabled="{{busy || !query}}">搜索</button></view><view class="filters"><button wx:for="{{kinds}}" wx:key="key" class="{{kind===item.key?'primary':'secondary'}}" data-kind="{{item.key}}" bindtap="filter">{{item.label}}</button></view><view wx:if="{{error}}" class="notice warning">{{error}}</view><view wx:if="{{notice}}" class="notice small">{{notice}}</view><view wx:for="{{items}}" wx:key="key" class="card result" data-key="{{item.key}}" bindtap="open"><view class="small muted">{{item.kindLabel}}{{item.city?' · '+item.city:''}}</view><view class="subtitle">{{item.displayName}}</view><view wx:if="{{item.startsOn}}">{{item.startsOn}} 至 {{item.endsOn}}</view><button class="secondary" data-key="{{item.key}}" catchtap="open">查看详情</button></view><view wx:if="{{searched && !items.length && !busy}}" class="card muted">没有符合条件的公开结果，可调整搜索词或城市。</view><button wx:if="{{cursor}}" class="secondary" bindtap="more" disabled="{{busy}}">继续加载</button><view wx:if="{{busy}}" class="notice">正在搜索</view></view>
