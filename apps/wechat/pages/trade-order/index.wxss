.trade .card {
  margin: 24rpx 0;
  padding: 24rpx;
}
.trade button {
  margin-top: 16rpx;
}
.trade .field {
  border: 1rpx solid #ccd3df;
  padding: 16rpx;
  margin: 16rpx 0;
}
.trade .small {
  font-size: 22rpx;
  word-break: break-all;
}
.trade .warning {
  color: #9e4f00;
}

.funds-workspace .card { margin:12px 0; padding:16px; border-radius:16px; }
.funds-workspace .funds-total { padding:12px 0; }
.funds-workspace .funds-total .money { font-size:28px; line-height:38px; }
.funds-workspace .summary-grid { padding:12px 0; }
.funds-workspace .progress-link { display:flex; align-items:center; gap:12px; padding:16px; text-align:left; background:#fff; }
.funds-workspace .progress-link > view { flex:1; min-width:0; }
.funds-workspace .progress-link image { flex:none; }
.funds-workspace .field { font-size:16px; line-height:24px; min-height:44px; }
.funds-workspace { padding-bottom:calc(104px + env(safe-area-inset-bottom)); }
.funds-summary { color:#18283f; }
.funds-summary-icon { display:flex; align-items:center; justify-content:center; flex:0 0 44px; width:44px; height:44px; border-radius:12px; background:#eaf2fc; }
.funds-summary-icon image { width:25px; height:25px; }
.funds-pending-card { padding:14px !important; }
.funds-pending-card .fig-note { margin-bottom:10px; }
.refund-record { padding:14px !important; }
.refund-record-head { display:flex; align-items:flex-start; gap:10px; }
.refund-record-head > view:first-child { flex:1; min-width:0; }
