@import "../../styles/figma-pages.wxss";

.trade-order-page button {
  margin: 0;
}

.trade-pending,
.trade-refund-hero {
  align-items: center;
  text-align: center;
}

.trade-state-icon {
  display: flex;
  width: 50px;
  height: 50px;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 15px;
  background: #fff1e2;
}

.trade-state-icon--small {
  width: 40px;
  height: 40px;
  border-radius: 12px;
}

.trade-request-id,
.trade-code {
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  overflow-wrap: anywhere;
}

.trade-request-id {
  padding: 10px;
  border-radius: 10px;
  background: #f4f6fa;
  color: #123c73;
  font-size: 13px;
  line-height: 18px;
}

.trade-chevron {
  display: flex;
  width: 24px;
  height: 24px;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #123c73;
  transform: rotate(-90deg);
}

.trade-page-check,
.trade-check-group {
  width: 100%;
}

.trade-summary-card {
  gap: 12px;
}

.trade-fee-card {
  gap: 8px;
}

.trade-design-row,
.trade-step {
  display: flex;
  width: 100%;
  min-height: 55px;
  min-width: 0;
  align-items: center;
  gap: 8px;
}

.trade-design-row + .trade-design-row,
.trade-step + .trade-step {
  border-top: 1px solid #e6ebf2;
}

.trade-design-row--total {
  min-height: 55px;
  padding: 0 10px;
  border: 0;
  border-radius: 8px;
  background: #fff1e2;
}

.trade-design-row + .trade-design-row--total {
  border-top: 0;
}

.trade-step__mark {
  display: flex;
  width: 22px;
  height: 22px;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eaf2fc;
  color: #123c73;
  font-size: 12px;
  font-weight: 700;
}

.trade-summary-head,
.trade-record__head {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10px;
}

.trade-status {
  max-width: 108px;
  flex: none;
  color: #51657d;
  font-size: 12px;
  line-height: 18px;
  text-align: right;
  overflow-wrap: anywhere;
}

.trade-total {
  padding: 14px;
  border-radius: 12px;
  background: #123c73;
  color: #ffffff;
  text-align: center;
}

.trade-total .figma-eyebrow {
  color: #d8e5f5;
}

.trade-total__value {
  margin-top: 3px;
  font-size: 29px;
  font-weight: 700;
  line-height: 38px;
}

.trade-metrics,
.trade-progress-grid {
  display: grid;
  width: 100%;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.trade-metric,
.trade-progress-grid > view {
  padding: 10px;
  border-radius: 10px;
  background: #f4f6fa;
  text-align: left;
}

.trade-metric__value {
  margin-top: 3px;
  color: #18283f;
  font-size: 16px;
  font-weight: 700;
  line-height: 22px;
  overflow-wrap: anywhere;
}

.trade-reservations {
  display: grid;
  width: 100%;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  color: #51657d;
  font-size: 12px;
  line-height: 17px;
}

.trade-reservations > view {
  display: flex;
  justify-content: space-between;
  gap: 6px;
}

.trade-terms {
  color: #51657d;
  font-size: 13px;
  line-height: 20px;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.trade-progress-link {
  display: flex;
  width: 100%;
  min-height: 62px;
  align-items: center;
  gap: 10px;
  padding: 8px 0;
  border-top: 1px solid #e6ebf2;
  background: transparent;
  color: #18283f;
  text-align: left;
}

.trade-record {
  display: flex;
  width: 100%;
  min-width: 0;
  flex-direction: column;
  gap: 8px;
  padding-top: 11px;
  border-top: 1px solid #e6ebf2;
}

.trade-record:first-of-type {
  padding-top: 0;
  border-top: 0;
}

.trade-money {
  flex: none;
  color: #123c73;
  font-size: 14px;
  font-weight: 700;
  white-space: nowrap;
}

.trade-action-stack {
  display: grid;
  width: 100%;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.trade-order-page .trade-primary,
.trade-order-page .trade-secondary,
.trade-action-stack button,
.trade-text-action,
.trade-reject-box button {
  display: flex;
  min-width: 0;
  min-height: 44px;
  align-items: center;
  justify-content: center;
  padding: 8px 13px;
  border-radius: 22px;
  font-size: 14px;
  line-height: 20px;
}

.trade-order-page .trade-primary {
  width: 100%;
  background: #f28c28;
  color: #18283f;
  font-weight: 600;
}

.trade-order-page .trade-secondary,
.trade-action-stack button,
.trade-reject-box button {
  border: 1px solid #7c8ea5;
  background: #ffffff;
  color: #123c73;
}

.trade-full {
  width: 100%;
}

.trade-text-action {
  width: 100%;
  background: transparent;
  color: #51657d;
  text-decoration: underline;
}

.trade-refund-hero {
  gap: 9px;
}

.trade-state-hero {
  display: flex;
  width: 100%;
  min-height: 112px;
  flex-direction: column;
  justify-content: center;
  gap: 8px;
  padding: 16px;
  border-radius: 16px;
  background: #fff1e2;
}

.trade-state-hero__body {
  color: #18283f;
  font-size: 14px;
  line-height: 22px;
}

.trade-state-row {
  display: flex;
  width: 100%;
  min-height: 55px;
  align-items: center;
  gap: 8px;
  padding: 0 10px;
  border-radius: 8px;
  background: #eaf2fc;
}

.trade-state-dot {
  width: 7px;
  height: 7px;
  flex: none;
  border-radius: 50%;
  background: #123c73;
}

.trade-reject-box {
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: 8px;
  padding: 10px;
  border-radius: 10px;
  background: #fff1e2;
}

.trade-order-page button[disabled],
.trade-order-page .trade-text-action[disabled] {
  border-color: #e6ebf2;
  background: #e6ebf2;
  color: #7c8ea5;
}

@media (max-width: 360px) {
  .trade-action-stack {
    grid-template-columns: minmax(0, 1fr);
  }

  .trade-metrics,
  .trade-progress-grid {
    gap: 6px;
  }

  .trade-total__value {
    font-size: 25px;
  }
}
