<scb-header title="资金订单" disabled="{{busy}}"/>
<view class="page trade"><view wx:if="{{error}}" class="notice danger">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view><button bindtap="load" disabled="{{busy || loading}}">刷新服务端记录</button><button wx:if="{{loginRequired}}" bindtap="login">登录</button><view wx:if="{{pending}}" class="card warning"><view>上次资金操作待核对，原编号：{{pending.body.clientRequestId}}</view><button bindtap="recover" disabled="{{busy}}">查询原操作回执</button><button wx:if="{{!pending.invalid}}" bindtap="retry" disabled="{{busy}}">使用原编号重试</button><checkbox-group bindchange="pendingConsent"><label><checkbox value="yes" checked="{{pendingAcknowledged}}" disabled="{{busy}}"/>我已核对最新资金记录，选择只移除本机恢复标记；这不会取消服务端原操作</label></checkbox-group><button bindtap="clearPending" disabled="{{busy || !pendingAcknowledged}}">核对后移除本机标记</button></view><view wx:if="{{noCharge}}" class="card">本来源创建时未绑定在线收费，不追溯收取费用。</view><button wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="open">{{item.title}} · {{item.totalText}} · {{item.status}}</button>
<block wx:if="{{order}}"><view class="card"><view class="title">{{order.title}}</view><view>实际收款方：{{order.merchantName}}</view><view>订单金额 {{order.totalText}} · {{order.status}}</view><view>渠道确认实付 {{order.paidText}}</view><view>确认已退 {{order.refundText}} · 可申请退 {{order.refundableText}}</view><view>退款占用 {{order.refundReservedText}} · 扣减占用 {{order.deductionReservedText}}</view><view>渠道确认净分账 {{order.settledText}}</view><view class="muted">付款、报名审核与履约独立核验；未知结果保留原编号查询。</view><view>{{order.terms}}</view><view wx:if="{{order.status==='SOURCE_CONFLICT'}}" class="warning">原服务已失效或冲突。实际付款仍保留，请申请退款或联系管理方处理。</view></view>
<view wx:if="{{order.canStartPayment}}" class="card"><checkbox-group bindchange="consent"><label><checkbox value="yes" checked="{{consent}}" disabled="{{busy || pending}}"/>我已核对金额、实际收款方及以上收费条款</label></checkbox-group><button wx:if="{{order.capabilities.jsapi}}" data-channel="JSAPI" bindtap="pay" disabled="{{busy || pending || !consent}}">微信内支付</button><button wx:if="{{order.capabilities.native}}" data-channel="NATIVE" bindtap="pay" disabled="{{busy || pending || !consent}}">生成扫码付款链接</button></view>
<view class="card" wx:for="{{order.attempts}}" wx:key="id"><view>支付 {{item.status}} · {{item.channel}}</view><view class="small">{{item.id}}</view><button data-type="payments" data-id="{{item.id}}" bindtap="query" disabled="{{busy}}">查询此原支付</button><button wx:if="{{item.checkout.mode==='JSAPI'}}" data-id="{{item.id}}" bindtap="continueJsapi" disabled="{{busy || pending}}">继续原微信支付</button><button wx:if="{{item.checkout.mode==='NATIVE'}}" data-id="{{item.id}}" bindtap="copy">复制原扫码链接</button></view>
<view wx:if="{{order.capabilities.canRequestRefund || order.capabilities.canManage}}" class="card"><input class="field" value="{{amount}}" data-field="amount" bindinput="input" type="number" placeholder="申请金额（整数分，100分=1元）"/><textarea class="field" value="{{reason}}" data-field="reason" bindinput="input" maxlength="1000" placeholder="真实退款、审核或扣减说明（至少4字）"/><button wx:if="{{order.capabilities.canRequestRefund}}" bindtap="refund" disabled="{{busy || pending}}">申请部分或全部退款</button><block wx:if="{{order.capabilities.canManage}}"><input class="field" value="{{evidence}}" data-field="evidence" bindinput="input" placeholder="扣减证据引用编号"/><button wx:if="{{order.kind==='ENTRY_DEPOSIT'}}" bindtap="deduction" disabled="{{busy || pending}}">提出保证金扣减（须独立审核）</button><button wx:if="{{order.capabilities.settlementAvailable}}" bindtap="settlement" disabled="{{busy || pending}}">提出服务端核算分账</button></block></view>
<view wx:for="{{order.refunds}}" wx:key="id" class="card"><view>退款 {{item.amountText}} · {{item.status}}</view><view>{{item.reason}}</view><button data-type="refunds" data-id="{{item.id}}" bindtap="query" disabled="{{busy}}">查询原退款</button><block wx:if="{{order.capabilities.canManage}}"><button data-type="REFUND" data-id="{{item.id}}" data-decision="APPROVE" bindtap="review" disabled="{{busy || pending}}">独立同意退款</button><button data-type="REFUND" data-id="{{item.id}}" data-decision="REJECT" bindtap="review" disabled="{{busy || pending}}">独立拒绝退款</button><button data-type="refunds" data-id="{{item.id}}" data-action="dispatch" bindtap="dispatch" disabled="{{busy || pending}}">执行已批准退款</button></block></view>
<view wx:for="{{order.deductions}}" wx:key="id" class="card"><view>保证金扣减 {{item.amountText}} · {{item.status}}</view><view>{{item.reason}} · {{item.evidenceReference}}</view><block wx:if="{{order.capabilities.canManage}}"><button data-type="DEDUCTION" data-id="{{item.id}}" data-decision="APPROVE" bindtap="review" disabled="{{busy || pending}}">独立同意扣减</button><button data-type="DEDUCTION" data-id="{{item.id}}" data-decision="REJECT" bindtap="review" disabled="{{busy || pending}}">独立拒绝扣减</button><button data-type="DEDUCTION" data-id="{{item.id}}" data-decision="REVERSE" bindtap="review" disabled="{{busy || pending}}">撤销已批准扣减</button></block></view>
<view wx:for="{{order.settlements}}" wx:key="id" class="card"><view>分账 {{item.amountText}} · {{item.status}} · 已回退{{item.returnedText}}</view><button data-type="settlements" data-id="{{item.id}}" bindtap="query" disabled="{{busy}}">查询原分账</button><block wx:if="{{order.capabilities.canManage}}"><button data-type="SETTLEMENT" data-id="{{item.id}}" data-decision="APPROVE" bindtap="review" disabled="{{busy || pending}}">独立同意分账</button><button data-type="SETTLEMENT" data-id="{{item.id}}" data-decision="REJECT" bindtap="review" disabled="{{busy || pending}}">独立拒绝分账</button><button data-type="settlements" data-id="{{item.id}}" data-action="dispatch" bindtap="dispatch" disabled="{{busy || pending}}">执行已批准分账</button><button data-type="settlements" data-id="{{item.id}}" data-action="return" bindtap="dispatch" disabled="{{busy || pending}}">为已批准退款发起分账回退</button><button data-id="{{item.id}}" bindtap="returnQuery" disabled="{{busy}}">查询原回退</button></block></view>
</block></view>
