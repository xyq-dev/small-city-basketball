<scb-header title="{{figmaState==='refund-progress' ? '退款进度' : figmaState==='funds-result-unknown' ? '资金结果待核对' : pending ? '资金结果待核对' : order && activeSection==='resolution' ? '退款进度' : '资金订单'}}" disabled="{{busy || loading}}"/>
<view class="figma-page trade-order-page">
  <view class="figma-page__content figma-page__content--actions">
    <block wx:if="{{figmaState==='refund-progress'}}">
      <view class="figma-summary"><view class="figma-summary__icon"><figma-icon name="refund" size="25"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">资金订单 · 原退款</view><view class="figma-title">退款进度</view><view class="figma-subtitle">只核对本次退款。到账以原渠道回执为准。</view></view></view>
      <view class="figma-section"><view class="figma-section__title">退款申请</view><view class="trade-design-row"><view class="figma-row__copy"><view class="figma-row__title">订单金额</view><view class="figma-row__subtitle">示例 · 场地预约</view></view><view class="trade-money">¥200.00</view></view><view class="trade-design-row"><view class="figma-row__copy"><view class="figma-row__title">本次申请</view><view class="figma-row__subtitle">原时段取消</view></view><view class="trade-money">¥120.00</view></view></view>
      <view class="figma-section"><view class="figma-section__title">原退款记录</view><view class="trade-step"><view class="trade-step__mark">1</view><view class="figma-row__copy"><view class="figma-row__title">申请已提交</view><view class="figma-row__subtitle">11月08日 10:30</view></view><view class="figma-status figma-status--orange">已受理</view></view><view class="trade-step"><view class="trade-step__mark">2</view><view class="figma-row__copy"><view class="figma-row__title">独立审核</view><view class="figma-row__subtitle">11月08日 11:20</view></view><view class="figma-status figma-status--orange">已批准</view></view><view class="trade-step"><view class="trade-step__mark">3</view><view class="figma-row__copy"><view class="figma-row__title">渠道处理</view><view class="figma-row__subtitle">等待原退款结果。</view></view><view class="figma-status figma-status--orange">处理中</view></view></view>
    </block>

    <block wx:elif="{{figmaState==='funds-result-unknown'}}">
      <view class="trade-state-hero"><view class="figma-section__title">资金结果待核对</view><view class="trade-state-hero__body">查询原交易与渠道回执，确认结果前不要重复付款。</view></view>
      <view class="figma-section"><view class="figma-section__title">订单示例 A · 支付待核对</view><view class="trade-state-row"><view class="trade-state-dot"/><view class="figma-row__copy"><view class="figma-row__title">支付结果待核对</view><view class="figma-row__subtitle">查询原支付单和渠道回执。</view></view><view class="figma-status figma-status--orange">待核对</view></view><view class="trade-state-row"><view class="trade-state-dot"/><view class="figma-row__copy"><view class="figma-row__title">本单应付</view><view class="figma-row__subtitle">示例订单 · 篮球场预约</view></view><view class="figma-status figma-status--orange">¥200.00</view></view></view>
      <view class="figma-section"><view class="figma-section__title">订单示例 B · 部分退款</view><view class="trade-step"><view class="trade-step__mark">1</view><view class="figma-row__copy"><view class="figma-row__title">退款申请</view><view class="figma-row__subtitle">已为此前付款成功的订单申请部分退款。</view></view><view class="figma-status figma-status--orange">已受理</view></view><view class="trade-step"><view class="trade-step__mark">2</view><view class="figma-row__copy"><view class="figma-row__title">渠道处理中</view><view class="figma-row__subtitle">等待退款回执后更新结果。</view></view><view class="figma-status figma-status--orange">处理中</view></view></view>
    </block>

    <block wx:else>
    <view class="figma-summary">
      <view class="figma-summary__icon"><figma-icon name="transaction" size="25"/></view>
      <view class="figma-summary__copy">
        <view class="figma-eyebrow">本人资金记录</view>
        <view class="figma-title">{{pending ? '上一笔资金操作等待核对' : order ? order.title : '金额、付款与服务分别核对'}}</view>
        <view class="figma-subtitle">逐项核对原订单、收款主体与渠道结果</view>
      </view>
    </view>

    <figma-feedback wx:if="{{error}}" type="error" title="资金记录处理失败" body="{{error}}" action-label="重新读取" disabled="{{busy || loading}}" bindaction="load"/>
    <figma-feedback wx:if="{{message}}" type="info" title="当前提示" body="{{message}}"/>
    <view wx:if="{{loading}}" class="figma-section"><figma-skeleton rows="{{5}}"/></view>
    <figma-feedback wx:if="{{!loading && loginRequired}}" type="info" title="登录后核对资金记录" body="付款、退款与审核权限按当前账号重新读取。" action-label="登录后继续" disabled="{{busy}}" bindaction="login"/>

    <view wx:if="{{!loading && pending}}" class="figma-section trade-pending">
      <view class="trade-state-icon"><figma-icon name="transaction" size="28"/></view>
      <view class="figma-section__title">资金结果待核对</view>
      <view class="figma-section__hint">原请求编号</view>
      <view class="trade-request-id">{{pending.body.clientRequestId}}</view>
      <view class="figma-section__hint">请先查询原操作回执。未知结果不会当作成功，也不要使用新编号重复提交。</view>
      <button class="trade-primary" bindtap="recover" disabled="{{busy}}">{{busy ? '查询中…' : '查询原操作回执'}}</button>
      <button wx:if="{{!pending.invalid}}" class="trade-secondary trade-full" bindtap="retry" disabled="{{busy || order.balanceConflict}}">使用原编号重试</button>
      <checkbox-group bindchange="pendingConsent" class="trade-check-group"><label class="figma-check"><checkbox value="yes" checked="{{pendingAcknowledged}}" disabled="{{busy}}"/><text>我已核对最新资金记录，只移除本机恢复标记；这不会取消服务端原操作</text></label></checkbox-group>
      <button class="trade-text-action" bindtap="clearPending" disabled="{{busy || !pendingAcknowledged}}">核对后移除本机标记</button>
    </view>

    <block wx:if="{{!loading && !pending && !loginRequired}}">
      <figma-feedback wx:if="{{noCharge}}" type="info" title="此来源未绑定在线收费" body="来源创建时没有在线收费记录，不会追溯收取费用。"/>

      <view wx:if="{{!order}}" class="figma-section">
        <view class="figma-section__title">可读资金订单</view>
        <figma-feedback wx:if="{{!orders.length && !noCharge && !error}}" type="empty" title="暂无当前可读资金订单" body="从本人报名或预约进入后，可核对对应原订单。"/>
        <button wx:for="{{orders}}" wx:key="id" class="figma-row" data-id="{{item.id}}" bindtap="open" disabled="{{busy}}"><view class="figma-row__copy"><view class="figma-row__title">{{item.title}}</view><view class="figma-row__subtitle">{{item.status}}</view></view><view class="trade-money">{{item.totalText}}</view><view class="trade-chevron"><figma-icon name="chevron-down-white" size="12"/></view></button>
      </view>

      <block wx:if="{{order}}">
        <figma-tabs key1="summary" label1="费用" key2="payments" label2="支付" key3="resolution" label3="退款" active="{{activeSection}}" disabled="{{busy}}" bindchange="changeSection"/>

        <block wx:if="{{activeSection==='summary'}}">
          <view id="funds-summary" class="figma-section trade-fee-card">
            <view class="figma-section__title">确定费用</view>
            <view class="trade-design-row"><view class="figma-row__copy"><view class="figma-row__title">{{order.serviceFeeLabel || order.kindText || '订单服务费'}}</view><view class="figma-row__subtitle">{{order.serviceFeeHint || '原订单确定金额'}}</view></view><view class="trade-money">{{order.serviceFeeText || order.totalText}}</view></view>
            <view class="trade-design-row"><view class="figma-row__copy"><view class="figma-row__title">平台服务费</view><view class="figma-row__subtitle">{{order.platformFeeHint || '按原订单条款核对'}}</view></view><view class="trade-money">{{order.platformFeeText || '已计入'}}</view></view>
            <view class="trade-design-row trade-design-row--total"><view class="figma-row__copy"><view class="figma-row__title">原订单应付</view><view class="figma-row__subtitle">人民币</view></view><view class="trade-money">{{order.totalText}}</view></view>
          </view>

          <view class="figma-section">
            <view class="figma-section__title">支付核对</view>
            <view class="trade-step"><view class="trade-step__mark">1</view><view class="figma-row__copy"><view class="figma-row__title">原订单</view><view class="figma-row__subtitle">{{order.orderSummary || order.title}}</view></view><view class="figma-status figma-status--orange">已创建</view></view>
            <view class="trade-step"><view class="trade-step__mark">2</view><view class="figma-row__copy"><view class="figma-row__title">渠道实付</view><view class="figma-row__subtitle">以原交易回执为准</view></view><view class="figma-status figma-status--orange">{{order.paidFen > 0 ? '已确认' : '待核对'}}</view></view>
            <view class="trade-step"><view class="trade-step__mark">3</view><view class="figma-row__copy"><view class="figma-row__title">退款记录</view><view class="figma-row__subtitle">以原退款回执为准</view></view><view class="figma-status figma-status--orange">{{order.refunds.length ? '已有申请' : '暂无申请'}}</view></view>
          </view>

          <view class="figma-section">
            <view class="figma-section__title">收款资料</view>
            <view class="trade-design-row"><view class="figma-row__copy"><view class="figma-row__title">收款主体</view><view class="figma-row__subtitle">{{order.merchantName}}</view></view></view>
            <view class="trade-design-row"><view class="figma-row__copy"><view class="figma-row__title">收费条款</view><view class="figma-row__subtitle trade-terms">{{order.terms}}</view></view></view>
          </view>

          <figma-feedback wx:if="{{order.balanceConflict}}" type="error" title="资金占用冲突待核对" body="历史退款迟到成功。实付、已退与占用金额保留原事实；仅可在明确允许时撤回尚未发送的退款后继。"/>
          <figma-feedback wx:if="{{order.status==='SOURCE_CONFLICT'}}" type="error" title="原服务已失效或冲突" body="实际付款仍保留，请申请退款或联系管理方处理。"/>
        </block>

        <block wx:if="{{activeSection==='payments'}}">
          <view id="funds-payments" wx:if="{{order.canStartPayment}}" class="figma-section">
            <view class="figma-section__title">发起付款</view>
            <checkbox-group bindchange="consent"><label class="figma-check"><checkbox value="yes" checked="{{consent}}" disabled="{{busy}}"/><text>我已核对金额、实际收款方及以上收费条款</text></label></checkbox-group>
            <view class="trade-action-stack"><button wx:if="{{order.capabilities.jsapi}}" data-channel="JSAPI" bindtap="pay" disabled="{{busy || !consent || order.balanceConflict}}">微信内支付</button><button wx:if="{{order.capabilities.native}}" data-channel="NATIVE" bindtap="pay" disabled="{{busy || !consent || order.balanceConflict}}">生成扫码付款链接</button></view>
          </view>
          <view class="figma-section">
            <view class="figma-section__title">原付款与渠道记录</view>
            <figma-feedback wx:if="{{!order.attempts.length}}" type="empty" title="暂无付款记录" body="付款请求建立后会保留原编号。"/>
            <view wx:for="{{order.attempts}}" wx:key="id" class="trade-record">
              <view class="trade-record__head"><view><view class="figma-row__title">{{item.channel}} 支付</view><view class="figma-row__subtitle trade-code">{{item.id}}</view></view><view class="figma-status">{{item.status}}</view></view>
              <view class="trade-action-stack"><button data-type="payments" data-id="{{item.id}}" bindtap="query" disabled="{{busy}}">查询原支付</button><button wx:if="{{item.checkout.mode==='JSAPI'}}" data-id="{{item.id}}" bindtap="continueJsapi" disabled="{{busy || order.balanceConflict}}">继续原微信支付</button><button wx:if="{{item.checkout.mode==='NATIVE'}}" data-id="{{item.id}}" bindtap="copy" disabled="{{order.balanceConflict}}">复制原扫码链接</button></view>
            </view>
          </view>
        </block>

        <block wx:if="{{activeSection==='resolution'}}">
          <view id="funds-resolution" class="figma-section trade-refund-hero">
            <view class="trade-state-icon"><figma-icon name="refund" size="27"/></view>
            <view class="figma-section__title">退款进度</view>
            <view class="figma-section__hint">退款、保证金扣减与分账分别审核；提交申请不代表已经到账。</view>
            <view class="trade-progress-grid"><view><view class="figma-caption">确认已退</view><view class="trade-metric__value">{{order.refundText}}</view></view><view><view class="figma-caption">可申请退</view><view class="trade-metric__value">{{order.refundableText}}</view></view></view>
          </view>

          <view wx:if="{{order.capabilities.canRequestRefund || order.capabilities.canManage}}" class="figma-section">
            <view class="figma-section__title">发起资金处理</view>
            <view class="figma-field-group"><view class="figma-field-label">金额（分）</view><input class="figma-field-control" value="{{amount}}" data-field="amount" bindinput="input" type="number" placeholder="整数分，100分=1元"/></view>
            <view class="figma-field-group"><view class="figma-field-label">真实说明</view><textarea class="figma-field-control" value="{{reason}}" data-field="reason" bindinput="input" maxlength="1000" placeholder="退款、审核或扣减说明，至少4字"/></view>
            <button wx:if="{{order.capabilities.canRequestRefund}}" class="trade-primary" bindtap="refund" disabled="{{busy || order.balanceConflict}}">申请部分或全部退款</button>
            <block wx:if="{{order.capabilities.canManage}}"><view class="figma-field-group"><view class="figma-field-label">扣减证据引用</view><input class="figma-field-control" value="{{evidence}}" data-field="evidence" bindinput="input" placeholder="填写证据引用编号"/></view><view class="trade-action-stack"><button wx:if="{{order.kind==='ENTRY_DEPOSIT'}}" bindtap="deduction" disabled="{{busy || order.balanceConflict}}">提出保证金扣减</button><button wx:if="{{order.capabilities.settlementAvailable}}" bindtap="settlement" disabled="{{busy || order.balanceConflict}}">提出服务端核算分账</button></view></block>
          </view>

          <view class="figma-section">
            <view class="figma-section__title">退款记录</view>
            <figma-feedback wx:if="{{!order.refunds.length}}" type="empty" title="暂无退款申请" body="退款申请、审核和渠道回执会分别保留。"/>
            <view wx:for="{{order.refunds}}" wx:key="id" class="trade-record">
              <view class="trade-record__head"><view><view class="figma-row__title">退款 {{item.amountText}}</view><view class="figma-row__subtitle">{{item.reason}}</view></view><view class="figma-status">{{item.status}}</view></view>
              <button class="trade-secondary trade-full" data-type="refunds" data-id="{{item.id}}" bindtap="query" disabled="{{busy}}">查询原退款</button>
              <block wx:if="{{order.capabilities.canManage}}"><view class="trade-action-stack"><button wx:if="{{item.status==='PENDING_REVIEW'}}" data-type="REFUND" data-id="{{item.id}}" data-decision="APPROVE" bindtap="review" disabled="{{busy || order.balanceConflict}}">独立同意退款</button><button wx:if="{{item.status==='PENDING_REVIEW'}}" data-type="REFUND" data-id="{{item.id}}" data-decision="REJECT" bindtap="review" disabled="{{busy}}">独立拒绝退款</button></view>
                <view wx:if="{{item.status==='APPROVED' && item.canRejectApprovedRefund}}" class="trade-reject-box"><view class="figma-row__subtitle">原退款已确认成功；此后继尚未发送。撤回只释放该后继占用，并保留全部原事实。</view><checkbox-group data-id="{{item.id}}" bindchange="approvedRefundRejectConsent"><label class="figma-check"><checkbox value="yes" checked="{{approvedRefundRejectId===item.id}}" disabled="{{busy}}"/><text>确认撤回尚未发送的后继 {{item.id}}（{{item.amountText}}）</text></label></checkbox-group><button data-type="REFUND" data-id="{{item.id}}" data-decision="REJECT" bindtap="review" disabled="{{busy || approvedRefundRejectId!==item.id}}">独立撤回此后继</button></view>
                <button wx:if="{{item.status==='APPROVED' && !item.canRejectApprovedRefund}}" class="trade-primary" data-type="refunds" data-id="{{item.id}}" data-action="dispatch" bindtap="dispatch" disabled="{{busy || order.balanceConflict}}">执行已批准退款</button>
              </block>
            </view>
          </view>

          <view wx:if="{{order.deductions.length}}" class="figma-section"><view class="figma-section__title">保证金扣减</view><view wx:for="{{order.deductions}}" wx:key="id" class="trade-record"><view class="trade-record__head"><view><view class="figma-row__title">扣减 {{item.amountText}}</view><view class="figma-row__subtitle">{{item.reason}} · {{item.evidenceReference}}</view></view><view class="figma-status">{{item.status}}</view></view><view wx:if="{{order.capabilities.canManage}}" class="trade-action-stack"><button data-type="DEDUCTION" data-id="{{item.id}}" data-decision="APPROVE" bindtap="review" disabled="{{busy || order.balanceConflict}}">独立同意扣减</button><button data-type="DEDUCTION" data-id="{{item.id}}" data-decision="REJECT" bindtap="review" disabled="{{busy || order.balanceConflict}}">独立拒绝扣减</button><button data-type="DEDUCTION" data-id="{{item.id}}" data-decision="REVERSE" bindtap="review" disabled="{{busy || order.balanceConflict}}">撤销已批准扣减</button></view></view></view>

          <view wx:if="{{order.settlements.length}}" class="figma-section"><view class="figma-section__title">分账记录</view><view wx:for="{{order.settlements}}" wx:key="id" class="trade-record"><view class="trade-record__head"><view><view class="figma-row__title">分账 {{item.amountText}}</view><view class="figma-row__subtitle">已回退 {{item.returnedText}}</view></view><view class="figma-status">{{item.status}}</view></view><button class="trade-secondary trade-full" data-type="settlements" data-id="{{item.id}}" bindtap="query" disabled="{{busy}}">查询原分账</button><view wx:if="{{order.capabilities.canManage}}" class="trade-action-stack"><button data-type="SETTLEMENT" data-id="{{item.id}}" data-decision="APPROVE" bindtap="review" disabled="{{busy || order.balanceConflict}}">独立同意分账</button><button data-type="SETTLEMENT" data-id="{{item.id}}" data-decision="REJECT" bindtap="review" disabled="{{busy || order.balanceConflict}}">独立拒绝分账</button><button data-type="settlements" data-id="{{item.id}}" data-action="dispatch" bindtap="dispatch" disabled="{{busy || order.balanceConflict}}">执行已批准分账</button><button data-type="settlements" data-id="{{item.id}}" data-action="return" bindtap="dispatch" disabled="{{busy || order.balanceConflict}}">发起分账回退</button><button data-id="{{item.id}}" bindtap="returnQuery" disabled="{{busy}}">查询原回退</button></view></view></view>
        </block>
      </block>
    </block>
    </block>
  </view>

  <view wx:if="{{figmaState==='refund-progress'}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost">查看原订单</button><button class="figma-action figma-action--orange">查询原退款</button></view>
  <view wx:elif="{{figmaState==='funds-result-unknown'}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost">查看退款进度</button><button class="figma-action figma-action--orange">查询原交易</button></view>
  <view wx:elif="{{order && !pending}}" class="figma-fixed-actions">
    <button class="figma-action figma-action--ghost" bindtap="fundingProgress" disabled="{{busy || loading}}">查看退款记录</button>
    <button class="figma-action figma-action--orange" bindtap="queryLatestPayment" disabled="{{busy || loading}}">查询原支付</button>
  </view>
  <view wx:else class="figma-fixed-actions figma-fixed-actions--single">
    <button class="figma-action figma-action--navy" bindtap="load" disabled="{{busy || loading}}">{{loading ? '读取中…' : '刷新服务端记录'}}</button>
  </view>
</view>
