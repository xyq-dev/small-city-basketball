.media-entry { display:flex; flex-direction:column; gap:20px; padding-bottom:calc(92px + env(safe-area-inset-bottom)); }
.media-entry > button,.media-entry > .notice { margin:0; }
.media-intro { padding:24px; border-radius:16px; background:#132c49; color:#fff; }
.media-intro .title { color:#fff; margin:0 0 12px; }
.media-copy { font-size:14px; line-height:24px; }
.media-panel { display:flex; flex-direction:column; gap:16px; padding:24px; border:1px solid #e8edf2; border-radius:12px; background:#fff; }
.media-panel .subtitle { margin:0; }
.media-strong { font-size:14px; line-height:24px; font-weight:500; }
.media-route { display:flex; flex-direction:column; gap:16px; margin-top:4px; }
.route-step { display:flex; align-items:flex-start; gap:12px; }
.route-step > view:last-child { flex:1; min-width:0; }
.route-number { display:flex; align-items:center; justify-content:center; flex:0 0 28px; width:28px; height:28px; border-radius:50%; background:#eaf0f7; color:#132c49; font-size:12px; line-height:20px; }
.media-note { margin:0; }
.media-note .media-strong { margin-bottom:4px; }
