@import "../../styles/figma-pages.wxss";

.media-hero{display:flex;width:100%;height:108px;align-items:center;gap:12px;overflow:hidden;padding:14px;border-radius:16px;background:#123c73;color:#fff}.media-hero__copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:3px}.media-hero .figma-eyebrow{color:#fff}.media-hero__title{display:-webkit-box;overflow:hidden;font-size:21px;font-weight:700;line-height:30px;-webkit-box-orient:vertical;-webkit-line-clamp:2}.media-hero__subtitle{color:#fff;font-size:12px;line-height:17px}.media-hero image{width:128px;height:80px;flex:none;border-radius:10px}.media-notice{display:flex;width:100%;min-height:55px;align-items:center;gap:9px;padding:0 10px;border-radius:8px;background:#eaf2fc}.media-notice__mark{width:7px;height:7px;flex:none;border-radius:4px;background:#123c73}@media(max-width:360px){.media-hero{padding:12px}.media-hero image{width:108px;height:68px}.media-hero__title{font-size:18px;line-height:26px}}
