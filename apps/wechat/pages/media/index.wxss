.media-entry { display:flex; flex-direction:column; gap:12px; padding-bottom:calc(164px + env(safe-area-inset-bottom)); }
.media-entry > button,.media-entry > .notice { margin:0; }
.media-entry .fig-summary,.media-entry .fig-card { margin:0; }
.media-summary-image { overflow:hidden; background:#eaf2fc; }
.media-summary-image image { width:100%; height:100%; border-radius:10px; }
.media-choice::before { content:''; flex:0 0 18px; width:18px; height:18px; border:1px solid #63758b; border-radius:50%; }
.media-notice { display:flex; align-items:center; gap:8px; min-height:55px; margin-top:0; padding:10px; }
.media-notice::before { content:''; flex:0 0 7px; width:7px; height:7px; border-radius:4px; background:#123c73; }
.media-notice > view { min-width:0; }
.media-entry .fig-row + .fig-row,.media-entry .media-event + .media-event { border-top:1px solid #e6ebf2; }
.media-intro { padding:24px; border-radius:16px; background:#132c49; color:#fff; }
.media-intro .title { color:#fff; margin:0 0 12px; }
.media-copy { font-size:14px; line-height:24px; }
.media-panel { display:flex; flex-direction:column; gap:16px; padding:24px; border:1px solid #e8edf2; border-radius:12px; background:#fff; }
.media-panel .subtitle { margin:0; }
.media-strong { font-size:14px; line-height:24px; font-weight:500; }
.media-route { display:flex; flex-direction:column; gap:16px; margin-top:4px; }
.route-step { display:flex; align-items:flex-start; gap:12px; }
.route-step > view:last-child { flex:1; min-width:0; }
.route-number { display:flex; align-items:center; justify-content:center; flex:0 0 28px; width:28px; height:28px; border-radius:50%; background:#eaf0f7; color:#132c49; font-size:12px; line-height:20px; }
.media-note { margin:0; }
.media-note .media-strong { margin-bottom:4px; }
.media-head .subtitle { margin:0; font-size:16px; line-height:24px; font-weight:700; }
.page.media-entry button { width:100%; margin-left:0; margin-right:0; }
.media-entry > button.media-event { display:flex; align-items:center; gap:12px; margin:0; padding:16px; border-radius:12px; text-align:left; font-weight:400; }
.media-event-main { flex:1; min-width:0; }
.media-event-name { font-size:16px; line-height:24px; font-weight:600; color:#132c49; overflow-wrap:anywhere; }

.ui002-workspace { padding:16px 16px calc(104px + env(safe-area-inset-bottom)); background:#f4f6fa; color:#18283f; }
.ui002-workspace .card { border-radius:16px; padding:16px; margin:0 0 16px; }
.ui002-workspace input,.ui002-workspace textarea,.ui002-workspace button { font-size:16px; line-height:24px; min-height:44px; }
.ui002-workspace .page-intro .title { color:#18283f; font-size:22px; line-height:32px; margin:0 0 8px; }
.ui002-workspace .page-intro { margin-bottom:16px; }
.ui002-workspace .tabs button { min-height:44px; }

.ui002-workspace .notice { font-size:14px; line-height:22px; border-radius:12px; padding:12px; }
