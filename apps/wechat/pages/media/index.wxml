<scb-header title="赛事图片与视频" back="{{true}}"/>
<view class="figma-page media-page">
  <view class="figma-page__content figma-page__content--actions">
    <view class="media-hero"><view class="media-hero__copy"><view class="figma-eyebrow">比赛影像</view><view class="media-hero__title">{{featuredEvent ? featuredEvent.name + ' · 比赛影像' : '城市邀请赛 · 比赛影像'}}</view><view class="media-hero__subtitle">从已公开赛事进入媒体内容</view></view><image src="/assets/home/event-court.jpg" mode="aspectFill"/></view>
    <view class="figma-section">
      <view class="figma-section__title">最近观看的赛事</view>
      <figma-feedback wx:if="{{!recentEvents.length}}" type="empty" title="还没有可查看的赛事" body="打开有效公开赛事后，可从这里进入已发布媒体。" action-label="去赛事页" bind:action="open"/>
      <button wx:for="{{recentEvents}}" wx:key="publicEventId" class="figma-row" data-id="{{item.publicEventId}}" bindtap="openRecent"><view class="figma-row__copy"><view class="figma-row__title">{{item.name}}</view><view class="figma-row__subtitle">{{item.dateLabel}} · 已公开赛事</view></view><view class="figma-status figma-status--orange">查看影像</view></button>
    </view>
    <view class="figma-section"><view class="figma-section__title">赛事媒体</view><view class="figma-row"><view class="figma-row__mark is-active"/><view class="figma-row__copy"><view class="figma-row__title">已发布回放</view><view class="figma-row__subtitle">以主办方实际发布为准</view></view></view><view class="figma-row"><view class="figma-row__mark"/><view class="figma-row__copy"><view class="figma-row__title">图片与视频</view><view class="figma-row__subtitle">按公开赛事查看</view></view></view></view>
    <view class="figma-section"><view class="figma-section__title">播放与分享</view><view class="media-notice"><view class="media-notice__mark"/><view class="figma-row__copy"><view class="figma-row__title">媒体来源</view><view class="figma-row__subtitle">仅呈现当前有效发布</view></view></view><view class="media-notice"><view class="media-notice__mark"/><view class="figma-row__copy"><view class="figma-row__title">外部播放地址</view><view class="figma-row__subtitle">仅提供复制，不保证在微信内播放</view></view></view></view>
  </view>
  <view class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="open">去赛事页</button><button class="figma-action figma-action--orange" bindtap="openFeatured" disabled="{{!featuredEvent}}">查看赛事影像</button></view>
</view>
