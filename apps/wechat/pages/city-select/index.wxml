<view class="city-nav" style="padding-top:{{statusBarHeight}}px">
  <view class="city-nav-row" style="padding-right:{{capsuleGap}}px">
    <button class="city-back" bindtap="goBack" aria-label="返回"><scb-icon name="chevron-left" tone="navy" size="22"/></button>
    <view class="city-nav-title">选择地区</view>
  </view>
</view>
<view class="page city-page">
  <view class="city-summary">
    <view class="city-mark"><image src="/assets/figma/local.svg" mode="aspectFit"/></view>
    <view class="city-summary-copy">
      <view class="city-kicker">浏览范围</view>
      <view class="city-summary-title">{{label}}</view>
      <view class="city-summary-sub">当前浏览 · {{source}}</view>
      <view class="city-summary-note">{{organizer ? '选择赛事标准地区。只用于本次目录设置，不改变首页浏览地区、赛事场馆或订单地点。' : '选择浏览地区。仅筛选公开赛事，不修改个人资料或订单地点。'}}</view>
    </view>
  </view>
  <view wx:if="{{warning && !organizer}}" class="notice warning">{{warning}}</view>
  <view wx:if="{{error}}" class="notice warning">{{error}}</view>
  <view wx:if="{{versionNote}}" class="notice">{{versionNote}}</view>
  <view wx:if="{{!organizer}}" class="city-tabs">
    <button class="{{panel === 'recent' ? '' : 'on'}}" data-panel="catalog" bindtap="switchPanel">标准地区</button>
    <button class="{{panel === 'recent' ? 'on' : ''}}" data-panel="recent" bindtap="switchPanel">最近选择</button>
  </view>
  <block wx:if="{{panel !== 'recent'}}">
    <view wx:if="{{!organizer}}" class="city-card">
      <view class="city-card-title">浏览范围</view>
      <button class="city-choice" bindtap="nationwide">
        <view class="city-radio {{label === '全国' ? 'on' : ''}}"></view>
        <view class="city-choice-copy">
          <view class="city-choice-name">全国内容</view>
          <view class="city-choice-sub">查看全部已公开赛事</view>
        </view>
      </button>
      <view wx:if="{{label !== '全国'}}" class="city-choice">
        <view class="city-radio on"></view>
        <view class="city-choice-copy">
          <view class="city-choice-name">{{label}}</view>
          <view class="city-choice-sub">{{description || '使用本地区及下辖地区'}}</view>
        </view>
        <view class="city-badge">当前</view>
      </view>
    </view>
    <view class="city-card">
      <view class="city-card-title">按地区选择</view>
      <view class="muted small">选择本地区包含其下辖地区；只确定到上级的赛事不会自动进入具体市县。本页手动选城，附近定位请进入同城。</view>
      <view wx:if="{{catalogLoading}}" class="muted">正在读取地区目录…</view>
      <view wx:elif="{{catalogError}}" class="notice warning">{{catalogError}}<button class="secondary" bindtap="loadCatalog">重试读取地区目录</button></view>
      <block wx:else>
        <view class="muted small" wx:if="{{dataDate}}">地区数据截至 {{dataDate}}；港澳台目前只收录省级。</view>
        <input class="field" value="{{search}}" bindinput="searchRegion" placeholder="搜索省、市或区县，核对完整路径" maxlength="80"/>
        <view wx:if="{{parentId}}" class="region-parent">
          <view class="watch-strong">{{parentLabel}}</view>
          <view wx:if="{{partial}}" class="notice small">此地区尚未收录下级，可按省级范围查看，不代表当地服务已开放。</view>
          <button class="primary" bindtap="chooseParent">选择本地区及下辖地区</button>
          <button class="quiet" bindtap="rootRegions">返回全国地区列表</button>
        </view>
        <view wx:if="{{!rows.length}}" class="muted">{{parentId ? '此地区没有已收录的下级，可直接选择本地区。' : '没有匹配地区，请换个名称搜索。'}}</view>
        <view wx:for="{{rows}}" wx:key="id" class="region-row">
          <view class="region-copy">
            <view class="region-name">{{item.name}}</view>
            <view class="muted small">{{item.path}}</view>
            <view wx:if="{{item.partial}}" class="muted small">目前仅收录省级</view>
          </view>
          <view class="region-actions"><button class="secondary" data-id="{{item.id}}" bindtap="selectRegion">选择{{item.hasChildren ? '本地区及下辖地区' : '本地区'}}</button><button wx:if="{{item.hasChildren}}" class="quiet" data-id="{{item.id}}" bindtap="browseRegion">查看下级</button></view>
        </view>
        <button wx:if="{{hasMore}}" class="quiet" bindtap="moreRegions">显示更多地区</button>
      </block>
    </view>
  </block>
  <block wx:if="{{!organizer}}">
    <view class="city-card">
      <view class="city-card-title">其他选择方式</view>
      <view class="city-recent-head"><view class="field-label">最近选择</view><button wx:if="{{recentChoices.length}}" class="quiet city-clear" bindtap="clearHistory">清除记录</button></view>
      <view wx:if="{{!recentChoices.length}}" class="muted">暂无最近选择。</view>
      <view class="city-history"><button wx:for="{{recentChoices}}" wx:key="key" class="secondary" data-key="{{item.key}}" bindtap="pickRecent">{{item.label}}{{item.mode === 'LEGACY_CITY' ? '（历史文字）' : ''}}</button></view>
      <view class="city-field">
        <view class="field-label">定位当前城市</view>
        <view class="city-field-box">本页手动选城，附近定位请进入同城，请手动选城或浏览全国。这里不会读取你的当前位置。</view>
      </view>
      <view class="city-field">
        <view class="field-label">历史城市文字</view>
        <input class="field" value="{{input}}" bindinput="inputCity" bindconfirm="apply" placeholder="输入原有城市标签" maxlength="40"/>
        <view class="muted small">此入口仍精确匹配原城市文字。“高州”和“高州市”在文字模式下不自动合并；选择上方标准地区可查看本地区及下辖赛事。</view>
        <button class="secondary" bindtap="apply">使用此城市文字</button>
      </view>
    </view>
  </block>
</view>
<view wx:if="{{!organizer}}" class="city-actions">
  <button class="city-ghost" bindtap="nationwide">浏览全国</button>
  <button class="city-confirm" bindtap="chooseParent" disabled="{{!parentId}}">选择本地区及下辖地区</button>
</view>
