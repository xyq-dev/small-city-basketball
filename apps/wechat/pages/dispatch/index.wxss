.dispatch-page{padding-bottom:calc(100px + env(safe-area-inset-bottom));word-break:break-word}.dispatch-page .row{text-align:left;width:100%;margin:12px 0;border-radius:16px;padding:16px}.dispatch-page .field{margin:12px 0;font-size:16px;line-height:24px;min-height:48px;box-sizing:border-box;width:100%}.dispatch-page .check{display:block;margin:12px 0;min-height:44px;line-height:24px}.dispatch-page .section-title{margin-top:16px}.dispatch-page .quote{background:#f4f6fa;border:1px solid #e1e7ef;border-radius:12px;padding:12px;margin:16px 0;font-size:14px;line-height:22px}.dispatch-page .small{font-size:12px;line-height:18px;word-break:break-all}.dispatch-page .danger{color:#a83b31}.dispatch-page .workflow-tabs{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0}.dispatch-page .workflow-tabs button{flex:1;min-width:110px;min-height:48px;font-size:14px;line-height:22px;background:#eaf0f8;color:#123c73;padding:12px;white-space:normal}.dispatch-page .workflow-tabs .active{background:#123c73;color:#fff}.dispatch-page .status-banner{padding:12px;background:#eaf0f8;color:#123c73;border-radius:12px;line-height:22px;font-size:14px}.dispatch-page .status-banner .section-title{margin:0 0 8px}.dispatch-page .card{border-radius:16px}.dispatch-page .eyebrow{font-size:12px;line-height:18px;color:#123c73;margin-bottom:8px}.dispatch-fixed-space{padding-bottom:calc(124px + env(safe-area-inset-bottom))}.dispatch-fixed{position:fixed;bottom:0;left:0;right:0;z-index:10;background:#fff;padding:12px 16px calc(12px + env(safe-area-inset-bottom));box-sizing:border-box;border-top:1px solid #e1e7ef}.dispatch-fixed button{width:100%;margin:0;min-height:48px}
