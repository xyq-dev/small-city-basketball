<scb-header title="{{detail ? '跨城需求进度' : '跨城人员派单'}}" disabled="{{busy}}"/>
<view class="scb-ui-page figma-page dispatch-page {{detail && detail.request.status==='REVIEWING' && detail.request.canManage && detail.request.canConfirm ? 'has-confirm-bar' : ''}}">
  <view class="figma-page__content">
    <view wx:if="{{!detail}}" class="figma-summary"><view class="summary-icon"><figma-icon name="dispatch" size="25"/></view><view><view class="figma-eyebrow">工作人员</view><view class="figma-title">跨城人员派单</view><view class="figma-subtitle">服务、差旅和完整报价分别核对，确认后再转真实预约。</view></view></view>
    <figma-feedback wx:if="{{loginRequired}}" type="locked" title="登录后查看派单" body="需求方、受邀服务者和独立审核人权限分别校验。" action-label="登录" bind:action="login"/>
    <figma-feedback wx:if="{{pending || pendingError}}" type="warning" title="原操作结果待核对" body="{{pendingError || '请先查询原操作回执，避免重复邀请或报价。'}}" action-label="查询回执" bind:action="recover"/>
    <button wx:if="{{pending}}" class="figma-action figma-action--ghost" bindtap="retry" disabled="{{busy}}">保持原编号重试</button>
    <figma-feedback wx:if="{{error}}" type="error" title="派单读取失败" body="{{error}}" action-label="重新读取" bind:action="load"/>
    <figma-feedback wx:if="{{message}}" type="success" title="最新结果" body="{{message}}"/>
    <figma-feedback wx:if="{{capabilities && !capabilities.enabled}}" type="closed" title="跨城派单尚未开放" body="历史记录仍可查询，新的派单操作暂停。"/>
    <figma-skeleton wx:if="{{loading}}" rows="4"/>

    <view wx:if="{{!detail}}" class="dispatch-tabs"><button class="dispatch-tab {{dispatchView==='requests' ? 'is-active' : ''}}" data-key="requests" bindtap="workspace" disabled="{{busy || loading}}">我的需求</button><button class="dispatch-tab {{dispatchView==='offers' ? 'is-active' : ''}}" data-key="offers" bindtap="workspace" disabled="{{busy || loading}}">收到邀请</button><button class="dispatch-tab {{dispatchView==='preference' ? 'is-active' : ''}}" data-key="preference" bindtap="workspace" disabled="{{busy || loading}}">接单许可</button></view>
    <button wx:if="{{detail}}" class="back-action" bindtap="closeDetail" disabled="{{busy || loading}}"><image class="back-action__icon" src="/assets/figma/chevron-left.svg" mode="aspectFit" aria-hidden="true"/>返回需求列表</button>

    <view wx:if="{{dispatchView==='requests' && !detail && !selectedOffer}}" class="figma-section"><view class="section-heading"><view><view class="figma-eyebrow">分批邀请</view><view class="figma-section__title">我发布的需求</view></view><button class="section-link" bindtap="load" disabled="{{busy || loading}}">刷新</button></view><button wx:for="{{requests}}" wx:key="id" class="figma-row" data-id="{{item.id}}" bindtap="selectRequest" disabled="{{busy}}"><view class="figma-row__copy"><view class="figma-row__title">{{item.kindText}}</view><view class="figma-row__subtitle">{{item.timeText}} · {{item.serviceAddress}}</view><view class="figma-row__subtitle">已邀 {{item.batchCount}} / {{item.maxBatches}} 批 · 上限 {{item.budget.totalText}}</view></view><view class="figma-status figma-status--orange">{{item.statusText}}</view></button><figma-feedback wx:if="{{!loading && !requests.length}}" type="empty" title="尚无跨城需求" body="机构管理员可建立一项明确岗位、地区、时段与预算的需求。"/></view>

    <view wx:if="{{dispatchView==='offers' && !detail && !selectedOffer}}" class="figma-section"><view class="figma-eyebrow">服务邀请</view><view class="figma-section__title">报价与交通审核</view><button wx:for="{{offers}}" wx:key="id" class="figma-row" data-id="{{item.id}}" bindtap="selectOffer" disabled="{{busy}}"><view class="figma-row__copy"><view class="figma-row__title">{{item.listingTitle}}</view><view class="figma-row__subtitle">{{item.request.timeText}} · {{item.request.serviceAddress}}</view><view class="figma-row__subtitle">邀请截止 {{item.expiresText}}</view></view><view class="figma-status figma-status--orange">{{item.statusText}}</view></button><figma-feedback wx:if="{{!loading && !offers.length}}" type="empty" title="暂无可处理邀请" body="只展示当前账号可报价、确认或独立核验的邀请。"/></view>

    <view wx:if="{{dispatchView==='preference' && !detail && !selectedOffer}}" class="figma-section form-section"><view class="figma-eyebrow">本人授权</view><view class="figma-section__title">跨城接单许可</view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{preference.enabled ? '允许有限批次邀请' : '尚未允许跨城邀请'}}</view><view class="figma-row__subtitle">已保存范围 {{preference.regionIds.length || 0}} 项；不会扩大已审核服务覆盖。</view></view><view class="figma-status {{preference.enabled ? 'figma-status--orange' : ''}}">{{preference.enabled ? '已开启' : '未开启'}}</view></view><button class="figma-action figma-action--ghost" bindtap="chooseCity" disabled="{{busy}}">选择地区（{{selection.label}}）</button><button class="figma-action figma-action--ghost" data-target="preferenceRegions" bindtap="addRegion" disabled="{{busy}}">加入本人接单范围</button><button wx:for="{{preferenceRegions}}" wx:key="regionId" class="region-chip" data-target="preferenceRegions" data-id="{{item.regionId}}" bindtap="removeRegion" disabled="{{busy}}">{{item.label}} ×</button><view class="figma-field-group"><view class="figma-field-label">每日邀请上限（1–9）</view><input class="figma-field-control" type="number" data-field="dailyLimit" value="{{dailyLimit}}" bindinput="input"/></view><view class="inline-actions"><button class="figma-action figma-action--ghost" data-enabled="false" bindtap="preferenceCommand" disabled="{{busy || pending || pendingError || !preference}}">停止新邀请</button><button class="figma-action figma-action--orange" data-enabled="true" bindtap="preferenceCommand" disabled="{{busy || pending || pendingError || !capabilities.enabled}}">确认并启用</button></view></view>

    <view wx:if="{{dispatchView==='create' && organizations.length && !detail && !selectedOffer}}" class="figma-section form-section"><view class="figma-eyebrow">机构需求</view><view class="figma-section__title">建立一项跨城人员需求</view><picker class="figma-field-control" range="{{organizations}}" range-key="name" value="{{orgIndex}}" data-field="orgIndex" bindchange="pick">需求机构：{{organizations[orgIndex].name}}</picker><picker class="figma-field-control" range="{{kinds}}" range-key="label" value="{{kindIndex}}" data-field="kindIndex" bindchange="pick">岗位：{{kinds[kindIndex].label}}（1人）</picker><view class="region-panel"><view class="figma-row__title">服务与邀请地区</view><view class="figma-caption">服务地区：{{formRegion.label || '尚未确认'}} · 当前选择 {{selection.label}}</view><view class="inline-actions"><button class="figma-action figma-action--ghost" bindtap="chooseCity" disabled="{{busy}}">选择地区</button><button class="figma-action figma-action--ghost" bindtap="useRegion" disabled="{{busy}}">确认服务地区</button></view><button class="figma-action figma-action--ghost" data-target="inviteRegions" bindtap="addRegion" disabled="{{busy}}">加入允许邀请范围</button><button wx:for="{{inviteRegions}}" wx:key="regionId" class="region-chip" data-target="inviteRegions" data-id="{{item.regionId}}" bindtap="removeRegion" disabled="{{busy}}">{{item.label}} ×</button></view><view class="figma-field-group"><view class="figma-field-label">真实服务场馆与报到地点</view><input class="figma-field-control" data-field="address" value="{{address}}" bindinput="input" maxlength="200"/></view><view class="figma-field-grid"><picker class="figma-field-control" mode="date" data-field="startDate" value="{{startDate}}" bindchange="input">开始 {{startDate || '日期'}}</picker><picker class="figma-field-control" mode="time" data-field="startTime" value="{{startTime}}" bindchange="input">{{startTime}}</picker><picker class="figma-field-control" mode="date" data-field="endDate" value="{{endDate}}" bindchange="input">结束 {{endDate || '日期'}}</picker><picker class="figma-field-control" mode="time" data-field="endTime" value="{{endTime}}" bindchange="input">{{endTime}}</picker><picker class="figma-field-control" mode="date" data-field="expiryDate" value="{{expiryDate}}" bindchange="input">截止 {{expiryDate || '日期'}}</picker><picker class="figma-field-control" mode="time" data-field="expiryTime" value="{{expiryTime}}" bindchange="input">{{expiryTime}}</picker></view><view class="figma-row__title">分项与总额上限（元）</view><view class="figma-field-grid"><input class="figma-field-control" type="digit" data-field="serviceFee" value="{{serviceFee}}" bindinput="input" placeholder="服务费上限"/><input class="figma-field-control" type="digit" data-field="travelFee" value="{{travelFee}}" bindinput="input" placeholder="交通费上限"/><input class="figma-field-control" type="digit" data-field="lodgingFee" value="{{lodgingFee}}" bindinput="input" placeholder="住宿费上限"/><input class="figma-field-control" type="digit" data-field="totalBudget" value="{{totalBudget}}" bindinput="input" placeholder="完整总额上限"/></view><checkbox-group bindchange="checks"><label class="figma-check"><checkbox value="crossCity" checked="{{allowCrossCity}}" disabled="{{busy}}"/>我确认真实需求、跨城范围和费用上限，知悉报价需再次确认</label></checkbox-group><button class="figma-action figma-action--orange" bindtap="create" disabled="{{busy || pending || pendingError || !allowCrossCity || !capabilities.enabled}}">保存需求并开始邀请</button></view>

    <view wx:if="{{detail}}" class="figma-section detail-section"><view class="section-heading"><view><view class="figma-eyebrow">{{detail.request.kindText}}</view><view class="figma-section__title">跨城需求进度</view></view><view class="figma-status figma-status--orange">{{detail.request.statusText}}</view></view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{detail.request.timeText}}</view><view class="figma-row__subtitle">{{detail.request.serviceAddress}}</view></view></view><view class="budget-grid"><view><view class="figma-field-label">分项上限</view><view>{{detail.request.budget.detailText}}</view></view><view><view class="figma-field-label">总额上限</view><view>{{detail.request.budget.totalText}}</view></view></view><view class="figma-caption">邀请截止 {{detail.request.expiresText}}</view><view wx:if="{{detail.request.reason}}" class="figma-info">{{detail.request.reason}}</view><view class="figma-row__title">已收到的报价</view><view wx:for="{{detail.offers}}" wx:key="id" class="quote-card"><view class="section-heading"><view class="figma-row__title">{{item.listingTitle}}</view><view class="figma-status">{{item.statusText}}</view></view><block wx:if="{{item.quote}}"><view>{{item.quote.detailText}} · 总额 {{item.quote.totalText}}</view><view class="figma-caption">{{item.quote.routeText}} · {{item.quote.travelMethod}}</view><view class="figma-caption">{{item.quote.terms}}</view></block><view wx:if="{{item.holdText}}" class="hold-copy">暂占截止 {{item.holdText}}</view></view><figma-feedback wx:if="{{!detail.offers.length}}" type="empty" title="暂无邀请回执" body="开始后每批最多邀请 3 名符合范围、资质和档期的服务人员。"/><view wx:if="{{detail.request.canManage}}" class="form-section"><view class="figma-field-group"><view class="figma-field-label">本次操作说明</view><textarea class="figma-field-control" data-field="reason" value="{{reason}}" bindinput="input" placeholder="至少4字" maxlength="500" disabled="{{busy}}"/></view><button wx:if="{{detail.request.status==='DRAFT'}}" class="figma-action figma-action--orange" data-type="START" bindtap="requestCommand" disabled="{{busy || pending || pendingError || !capabilities.enabled}}">开始分批邀请</button><button wx:if="{{detail.request.status==='INVITING'}}" class="figma-action figma-action--ghost" data-type="PAUSE" bindtap="requestCommand" disabled="{{busy || pending || pendingError}}">暂停后续邀请</button><button wx:if="{{detail.request.status==='PAUSED'}}" class="figma-action figma-action--orange" data-type="RESUME" bindtap="requestCommand" disabled="{{busy || pending || pendingError}}">重新核验并恢复</button><block wx:if="{{detail.request.status==='REVIEWING'}}"><checkbox-group bindchange="checks"><label class="figma-check"><checkbox value="charge" checked="{{chargeConsent}}" disabled="{{busy}}"/>已核对服务、交通、住宿、平台费用及完整条款</label></checkbox-group><button class="figma-action figma-action--ghost" data-type="REJECT_QUOTE" bindtap="requestCommand" disabled="{{busy || pending || pendingError}}">拒绝报价并重新安排</button></block><button class="figma-action figma-action--ghost danger-action" data-type="CANCEL" bindtap="requestCommand" disabled="{{busy || pending || pendingError}}">取消未转预约需求</button></view><view wx:if="{{detail.request.sourceBookingId}}" class="source-panel"><view class="figma-caption">已生成真实预约；付款、履约、取消、争议和退款继续在源预约处理。</view><view class="inline-actions"><button class="figma-action figma-action--ghost" bindtap="source" disabled="{{busy}}">查看预约费用</button><button class="figma-action figma-action--orange" bindtap="bookings" disabled="{{busy}}">进入服务履约</button></view></view></view>

<block wx:if="{{selectedOffer}}"><view class="figma-section"><view class="figma-section__title">服务邀请</view><view class="figma-row"><figma-icon name="schedule" size="18"/><view class="figma-row__copy"><view class="figma-row__title">岗位</view><view class="figma-row__subtitle">{{selectedOffer.listingTitle}}</view></view><view class="figma-status figma-status--orange">{{selectedOffer.statusText}}</view></view><view class="figma-row"><figma-icon name="schedule" size="18"/><view class="figma-row__copy"><view class="figma-row__title">报到与服务</view><view class="figma-row__subtitle">{{selectedOffer.request.timeText}}</view></view><view class="figma-status">{{selectedOffer.request.serviceAddress}}</view></view></view><view class="figma-section"><view class="figma-section__title">完整报价</view><view class="quote-row"><view><view class="figma-row__title">服务费</view><view class="figma-row__subtitle">{{selectedOffer.serviceHint || '按已审核收费条款'}}</view></view><view>{{selectedOffer.quote ? selectedOffer.quote.serviceText : (quoteService || '待填写')}}</view></view><view class="quote-row"><view><view class="figma-row__title">交通与住宿</view><view class="figma-row__subtitle">{{selectedOffer.travelHint || '交通与住宿分别核对'}}</view></view><view>{{selectedOffer.travelLodgingText || '待填写'}}</view></view><view class="quote-row"><view><view class="figma-row__title">额外平台费</view><view class="figma-row__subtitle">{{selectedOffer.platformHint || '本次不收额外平台费'}}</view></view><view>{{selectedOffer.quote ? selectedOffer.quote.platformText : '¥0'}}</view></view><view class="quote-row quote-row--total"><view><view class="figma-row__title">报价合计</view><view class="figma-row__subtitle">{{selectedOffer.totalHint || '需客户明确确认'}}</view></view><view>{{selectedOffer.quote ? selectedOffer.quote.totalText : selectedOffer.request.budget.totalText}}</view></view></view><view class="figma-section"><view class="figma-section__title">行程与接单</view><view class="dispatch-step"><view class="dispatch-step__index">1</view><view class="figma-row__copy"><view class="figma-row__title">实际路线与返程</view><view class="figma-row__subtitle">保留报到及交通缓冲</view></view><view class="figma-status">待核验</view></view><view class="dispatch-step"><view class="dispatch-step__index">2</view><view class="figma-row__copy"><view class="figma-row__title">独立交通审核</view><view class="figma-row__subtitle">核对凭据与行程可行性</view></view><view class="figma-status">待审核</view></view><view class="dispatch-step"><view class="dispatch-step__index">3</view><view class="figma-row__copy"><view class="figma-row__title">客户确认</view><view class="figma-row__subtitle">按当前完整报价承接</view></view><view class="figma-status">待确认</view></view></view><view wx:if="{{!selectedOffer.previewOnly}}" class="figma-section offer-section supplemental-offer"><view class="figma-section__title">报价与行程明细</view><view class="figma-info">预算：{{selectedOffer.request.budget.detailText}} · 总额 {{selectedOffer.request.budget.totalText}}</view><view wx:if="{{selectedOffer.quote}}" class="quote-card"><view>{{selectedOffer.quote.detailText}} · 总额 {{selectedOffer.quote.totalText}}</view><view class="figma-caption">{{selectedOffer.quote.routeText}}</view><view class="figma-caption">{{selectedOffer.quote.travelMethod}} · {{selectedOffer.quote.travelEvidence}}</view><view class="figma-caption">{{selectedOffer.quote.terms}}</view></view><block wx:if="{{selectedOffer.canQuote}}"><picker class="figma-field-control" range="{{slots}}" range-key="timeText" value="{{slotIndex}}" data-field="slotIndex" bindchange="pick">真实档期：{{slots[slotIndex].timeText || '暂无一致开放档期'}}</picker><button class="figma-action figma-action--ghost" bindtap="manage" disabled="{{busy}}">管理已审核供给与档期</button><view class="figma-field-grid"><input class="figma-field-control" type="digit" data-field="quoteService" value="{{quoteService}}" bindinput="input" placeholder="服务费"/><input class="figma-field-control" type="digit" data-field="quoteTravel" value="{{quoteTravel}}" bindinput="input" placeholder="交通费"/><input class="figma-field-control" type="digit" data-field="quoteLodging" value="{{quoteLodging}}" bindinput="input" placeholder="住宿费"/></view><view class="figma-field-grid"><picker class="figma-field-control" mode="date" data-field="departureDate" value="{{departureDate}}" bindchange="input">出发 {{departureDate || '日期'}}</picker><picker class="figma-field-control" mode="time" data-field="departureTime" value="{{departureTime}}" bindchange="input">{{departureTime}}</picker><picker class="figma-field-control" mode="date" data-field="arrivalDate" value="{{arrivalDate}}" bindchange="input">报到 {{arrivalDate || '日期'}}</picker><picker class="figma-field-control" mode="time" data-field="arrivalTime" value="{{arrivalTime}}" bindchange="input">{{arrivalTime}}</picker><picker class="figma-field-control" mode="date" data-field="returnDate" value="{{returnDate}}" bindchange="input">返回 {{returnDate || '日期'}}</picker><picker class="figma-field-control" mode="time" data-field="returnTime" value="{{returnTime}}" bindchange="input">{{returnTime}}</picker></view><input class="figma-field-control" data-field="travelMethod" value="{{travelMethod}}" bindinput="input" maxlength="100" placeholder="交通方式与接驳安排"/><textarea class="figma-field-control" data-field="travelEvidence" value="{{travelEvidence}}" bindinput="input" maxlength="1000" placeholder="可核验班次、时刻与接驳依据"/><textarea class="figma-field-control" data-field="terms" value="{{terms}}" bindinput="input" maxlength="1000" placeholder="服务、交通、住宿、取消与改期约定"/></block><view wx:if="{{selectedOffer.canQuote || selectedOffer.canReviewTravel || selectedOffer.canAccept || selectedOffer.canWithdraw}}" class="figma-field-group"><view class="figma-field-label">本次操作或审核说明</view><textarea class="figma-field-control" data-field="reason" value="{{reason}}" bindinput="input" maxlength="500" disabled="{{busy}}"/></view><view wx:if="{{selectedOffer.canReviewTravel}}" class="review-panel"><view class="figma-caption">独立审核人须核实交通凭据、接驳、报到与返程保护。</view><checkbox-group bindchange="checks"><label class="figma-check"><checkbox value="evidence" checked="{{evidenceChecked}}" disabled="{{busy}}"/>已通过真实依据核对完整行程可行</label></checkbox-group></view><button wx:if="{{selectedOffer.canWithdraw}}" class="figma-action figma-action--ghost danger-action" data-type="WITHDRAW" bindtap="offerCommand" disabled="{{busy || pending || pendingError}}">拒绝或撤回邀请</button></view></block>
    <view wx:if="{{selectedOffer && selectedOffer.canReviewTravel}}" class="figma-info">路线未知不会自动通过；独立审核人须核实交通凭据、接驳、报到与返程保护。</view>
    <view wx:if="{{selectedOffer && selectedOffer.canAccept}}" class="figma-caption">确认前须核对并同意本次报价的全部分项与条款。</view>
  </view>
  <view wx:if="{{!detail && !selectedOffer}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="bookings">查看服务预约</button><button class="figma-action figma-action--orange" data-key="create" bindtap="workspace" disabled="{{busy || loading || !organizations.length}}">发起新需求</button></view>
  <view wx:if="{{selectedOffer}}" class="figma-fixed-actions"><button wx:if="{{selectedOffer.sourceBookingId}}" class="figma-action figma-action--ghost" bindtap="source" disabled="{{busy}}">查看实际服务预约</button><button wx:else class="figma-action figma-action--ghost" bindtap="bookings" disabled="{{busy}}">查看实际服务预约</button><button wx:if="{{selectedOffer.canQuote}}" class="figma-action figma-action--orange" data-type="SUBMIT_QUOTE" bindtap="offerCommand" disabled="{{busy || pending || pendingError}}">核对并提交本人报价</button><button wx:elif="{{selectedOffer.canReviewTravel}}" class="figma-action figma-action--orange" data-type="VERIFY_TRAVEL" bindtap="offerCommand" disabled="{{busy || pending || pendingError || !evidenceChecked}}">核验行程与报价</button><button wx:elif="{{selectedOffer.canAccept}}" class="figma-action figma-action--orange" data-type="ACCEPT" bindtap="offerCommand" disabled="{{busy || pending || pendingError}}">确认报价并接单</button><button wx:else class="figma-action figma-action--orange" bindtap="closeDetail" disabled="{{busy}}">返回邀请列表</button></view>
  <view wx:if="{{detail && detail.request.status==='REVIEWING' && detail.request.canManage && detail.request.canConfirm}}" class="confirm-bar"><button class="figma-action figma-action--orange" data-type="CONFIRM_QUOTE" bindtap="requestCommand" disabled="{{busy || pending || pendingError || !chargeConsent}}">确认当前报价并创建真实预约</button></view>
</view>
