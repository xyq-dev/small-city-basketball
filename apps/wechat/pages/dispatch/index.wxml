<scb-header title="{{detail ? (detail.request.status==='REVIEWING'?'客户确认跨城报价':'跨城需求进度') : selectedOffer ? '邀请与分项报价' : '跨城人员派单'}}" disabled="{{busy}}"/>
<view class="page dispatch-page {{detail && detail.request.status==='REVIEWING' && detail.request.canManage && detail.request.canConfirm?'dispatch-fixed-space':''}}">
 <view wx:if="{{!detail && !selectedOffer}}" class="page-intro"><view class="eyebrow">跨城协作 · 费用与档期分别核对</view><view class="title">让合适的人按时到场</view><view class="muted">一项岗位一人；双方允许跨城后分批邀请。交通方案需要独立核验，完整报价由客户再次确认。</view></view>
 <button wx:if="{{loginRequired}}" bindtap="login">登录并查看派单</button>
 <button bindtap="load" disabled="{{busy || loading}}">刷新当前进度</button>
 <button bindtap="bookings" disabled="{{busy}}">查看真实服务预约</button>
 <view wx:if="{{pending || pendingError}}" class="notice warning"><view>{{pendingError || '原操作结果尚未核对，请先恢复。'}}</view><button bindtap="recover" disabled="{{busy}}">查询原操作回执</button><button wx:if="{{pending}}" bindtap="retry" disabled="{{busy}}">保持原编号重试</button></view>
 <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view>
 <view wx:if="{{capabilities && !capabilities.enabled}}" class="notice warning">跨城派单尚未开放。已有记录可查看，新的操作暂停。</view>
 <view wx:if="{{loading}}" class="muted">正在读取当前授权和真实进度…</view>
 <view wx:if="{{!detail && !selectedOffer}}" class="workflow-tabs"><button class="{{dispatchView==='requests'?'active':''}}" data-key="requests" bindtap="workspace" disabled="{{busy || loading}}">我发布的需求</button><button class="{{dispatchView==='offers'?'active':''}}" data-key="offers" bindtap="workspace" disabled="{{busy || loading}}">收到的邀请</button><button class="{{dispatchView==='preference'?'active':''}}" data-key="preference" bindtap="workspace" disabled="{{busy || loading}}">本人接单许可</button><button wx:if="{{organizations.length}}" class="{{dispatchView==='create'?'active':''}}" data-key="create" bindtap="workspace" disabled="{{busy || loading}}">发起新需求</button></view>
 <button wx:if="{{detail || selectedOffer}}" bindtap="closeDetail" disabled="{{busy || loading}}">返回{{selectedOffer?'收到的邀请':'需求列表'}}</button>
 <block wx:if="{{dispatchView==='requests' && !detail && !selectedOffer}}"><view class="section-title">我发布的需求</view>
 <button wx:for="{{requests}}" wx:key="id" class="card row" data-id="{{item.id}}" bindtap="selectRequest" disabled="{{busy}}"><view class="subtitle">{{item.kindText}} · {{item.statusText}}</view><view>{{item.timeText}}</view><view>{{item.serviceAddress}}</view><view class="muted">已邀 {{item.batchCount}} / {{item.maxBatches}} 批 · 上限 {{item.budget.totalText}}</view></button>
 <view wx:if="{{!loading && !requests.length}}" class="muted">尚无需求。机构管理员可在下方建立一项明确时段的人员需求。</view>
 </block><view wx:if="{{detail}}" class="card"><view class="status-banner"><view class="section-title">{{detail.request.sourceBookingId?'已转入原预约':detail.request.status==='REVIEWING'?'当前报价待客户再次确认':'分批邀请与资格核验'}}</view><view>需求、报价、预约承接、付款与履约分别记录，当前状态以服务器返回为准。</view></view>
  <view class="subtitle">{{detail.request.kindText}} · {{detail.request.statusText}}</view><view>{{detail.request.timeText}}</view><view>{{detail.request.serviceAddress}}</view><view>邀请截止：{{detail.request.expiresText}}</view><view>费用上限：{{detail.request.budget.detailText}}</view><view>总额上限：{{detail.request.budget.totalText}}</view><view wx:if="{{detail.request.reason}}" class="notice">{{detail.request.reason}}</view>
  <view wx:for="{{detail.offers}}" wx:key="id" class="quote"><view>{{item.listingTitle}} · {{item.statusText}}</view><view wx:if="{{item.quote}}">{{item.quote.detailText}} · 总额 {{item.quote.totalText}}</view><view wx:if="{{item.quote}}">{{item.quote.routeText}}</view><view wx:if="{{item.quote}}">{{item.quote.travelMethod}} · {{item.quote.travelEvidence}}</view><view wx:if="{{item.quote}}">服务约定：{{item.quote.terms}}</view><view wx:if="{{item.holdText}}">暂占截止：{{item.holdText}}</view><view wx:if="{{item.quote}}" class="muted small">报价版本 {{item.quoteHash}}</view></view>
  <view wx:if="{{!detail.offers.length}}" class="muted">暂无邀请回执。开始后每批最多邀请3名符合范围、资质和档期的真实服务人员。</view>
  <block wx:if="{{detail.request.canManage}}"><textarea class="field" data-field="reason" value="{{reason}}" bindinput="input" placeholder="本次操作说明（至少4字）" maxlength="500" disabled="{{busy}}"/>
   <button wx:if="{{detail.request.status==='DRAFT'}}" data-type="START" bindtap="requestCommand" disabled="{{busy || pending || pendingError || !capabilities.enabled}}">开始分批邀请</button>
   <button wx:if="{{detail.request.status==='INVITING'}}" data-type="PAUSE" bindtap="requestCommand" disabled="{{busy || pending || pendingError}}">暂停后续邀请</button>
   <button wx:if="{{detail.request.status==='PAUSED'}}" data-type="RESUME" bindtap="requestCommand" disabled="{{busy || pending || pendingError}}">重新核验并恢复邀请</button>
   <block wx:if="{{detail.request.status==='REVIEWING'}}"><checkbox-group bindchange="checks"><label class="check"><checkbox value="charge" checked="{{chargeConsent}}" disabled="{{busy}}"/>已核对当前服务、交通、住宿、平台费用及完整条款，同意本次报价</label></checkbox-group><view wx:if="{{!detail.request.canConfirm}}" class="notice warning">当前报价暂不能确认预约。请刷新状态或联系工作人员；报价尚未成为预约。</view><button data-type="REJECT_QUOTE" bindtap="requestCommand" disabled="{{busy || pending || pendingError}}">拒绝报价，重新安排邀请</button></block>
   <button class="danger" data-type="CANCEL" bindtap="requestCommand" disabled="{{busy || pending || pendingError}}">取消未转预约的需求</button>
  </block>
  <block wx:if="{{detail.request.sourceBookingId}}"><view class="notice">已生成真实预约。付款、到场、履约、取消、争议与退款继续在源预约办理。不会静默换人。</view><button bindtap="source" disabled="{{busy}}">查看预约费用与支付</button><button bindtap="bookings" disabled="{{busy}}">进入服务履约</button></block>
 </view>
 <block wx:if="{{dispatchView==='offers' && !detail && !selectedOffer}}"><view class="section-title">服务邀请与交通审核</view>
 <button wx:for="{{offers}}" wx:key="id" class="card row" data-id="{{item.id}}" bindtap="selectOffer" disabled="{{busy}}"><view class="subtitle">{{item.listingTitle}} · {{item.statusText}}</view><view>{{item.request.timeText}}</view><view>{{item.request.serviceAddress}}</view><view class="muted">邀请截止 {{item.expiresText}}</view></button>
 <view wx:if="{{!loading && !offers.length}}" class="muted">没有当前账号可处理的邀请或交通审核。</view>
</block><view wx:if="{{selectedOffer}}" class="card">
  <view class="subtitle">{{selectedOffer.listingTitle}}</view><view>{{selectedOffer.statusText}}</view><view>{{selectedOffer.request.timeText}}</view><view>{{selectedOffer.request.serviceAddress}}</view><view>预算：{{selectedOffer.request.budget.detailText}} · 总额 {{selectedOffer.request.budget.totalText}}</view>
  <view wx:if="{{selectedOffer.quote}}" class="quote"><view>{{selectedOffer.quote.detailText}} · 总额 {{selectedOffer.quote.totalText}}</view><view>{{selectedOffer.quote.routeText}}</view><view>交通方式：{{selectedOffer.quote.travelMethod}}</view><view>核验依据：{{selectedOffer.quote.travelEvidence}}</view><view>约定：{{selectedOffer.quote.terms}}</view><view>已独立核验：{{selectedOffer.travelVerified?'是':'否'}}</view><view wx:if="{{selectedOffer.holdText}}">档期暂占至 {{selectedOffer.holdText}}</view></view>
  <block wx:if="{{selectedOffer.canQuote}}">
   <view class="section-title">提交本人的完整报价</view><view class="muted">金额单位为元，每项都须明确填值，免费填0。服务费须与已审核收费条款一致；交通与住宿必须在客户分项和总额上限内。提交后不可改写，同意前先核对。</view>
   <picker class="field" range="{{slots}}" range-key="timeText" value="{{slotIndex}}" data-field="slotIndex" bindchange="pick">真实档期：{{slots[slotIndex].timeText || '暂无完全一致的开放档期'}}</picker><button bindtap="manage" disabled="{{busy}}">管理已审核供给与档期</button>
   <input class="field" type="digit" data-field="quoteService" value="{{quoteService}}" bindinput="input" placeholder="服务费（元）"/><input class="field" type="digit" data-field="quoteTravel" value="{{quoteTravel}}" bindinput="input" placeholder="交通费（元）"/><input class="field" type="digit" data-field="quoteLodging" value="{{quoteLodging}}" bindinput="input" placeholder="住宿费（元）"/><view class="muted">额外平台费用：0元</view>
   <picker class="field" mode="date" data-field="departureDate" value="{{departureDate}}" bindchange="input">出发日期：{{departureDate || '请选择'}}</picker><picker class="field" mode="time" data-field="departureTime" value="{{departureTime}}" bindchange="input">出发时间（北京时间）：{{departureTime}}</picker>
   <picker class="field" mode="date" data-field="arrivalDate" value="{{arrivalDate}}" bindchange="input">报到日期：{{arrivalDate || '请选择'}}</picker><picker class="field" mode="time" data-field="arrivalTime" value="{{arrivalTime}}" bindchange="input">预计报到时间：{{arrivalTime}}</picker>
   <picker class="field" mode="date" data-field="returnDate" value="{{returnDate}}" bindchange="input">返回日期：{{returnDate || '请选择'}}</picker><picker class="field" mode="time" data-field="returnTime" value="{{returnTime}}" bindchange="input">预计返回时间：{{returnTime}}</picker>
   <input class="field" data-field="travelMethod" value="{{travelMethod}}" bindinput="input" maxlength="100" placeholder="交通方式与接驳安排"/><textarea class="field" data-field="travelEvidence" value="{{travelEvidence}}" bindinput="input" maxlength="1000" placeholder="可核验班次、时刻与接驳依据；不要粘贴身份证件、联系方式或凭证密钥"/><textarea class="field" data-field="terms" value="{{terms}}" bindinput="input" maxlength="1000" placeholder="服务、交通、住宿、天气取消与改期约定（至少10字）"/>
  </block>
  <textarea wx:if="{{selectedOffer.canQuote || selectedOffer.canReviewTravel || selectedOffer.canAccept || selectedOffer.canWithdraw}}" class="field" data-field="reason" value="{{reason}}" bindinput="input" maxlength="500" placeholder="本次操作或独立审核说明（至少4字）" disabled="{{busy}}"/>
  <button wx:if="{{selectedOffer.canQuote}}" class="primary" data-type="SUBMIT_QUOTE" bindtap="offerCommand" disabled="{{busy || pending || pendingError}}">核对后提交不可改写报价</button>
  <block wx:if="{{selectedOffer.canReviewTravel}}"><view class="notice">路线未知不会自动通过。独立审核人须核实交通凭据、接驳、报到时间和返程保护，审核说明会保留。</view><checkbox-group bindchange="checks"><label class="check"><checkbox value="evidence" checked="{{evidenceChecked}}" disabled="{{busy}}"/>已通过真实凭据核对完整行程可行，报到早于服务开始，返回与休息保护充分</label></checkbox-group><button data-type="VERIFY_TRAVEL" bindtap="offerCommand" disabled="{{busy || pending || pendingError || !evidenceChecked}}">记录独立核验结论</button></block>
  <button wx:if="{{selectedOffer.canAccept}}" class="primary" data-type="ACCEPT" bindtap="offerCommand" disabled="{{busy || pending || pendingError}}">本人同意报价并暂占完整差旅档期</button><button wx:if="{{selectedOffer.canWithdraw}}" class="danger" data-type="WITHDRAW" bindtap="offerCommand" disabled="{{busy || pending || pendingError}}">拒绝或撤回本次邀请</button>
  <button wx:if="{{selectedOffer.sourceBookingId}}" bindtap="source" disabled="{{busy}}">查看真实预约费用</button>
 </view>
 <view wx:if="{{dispatchView==='preference' && !detail && !selectedOffer}}" class="card"><view class="subtitle">本人跨城接单许可</view><view>当前：{{preference.enabled?'允许有限批次邀请':'尚未允许跨城邀请'}} · 当前已保存范围 {{preference.regionIds.length || 0}} 项</view><view class="muted">接单范围不得扩大已独立审核的服务覆盖。首次启用请明确选择范围；已有订单不会因关闭许可被取消。</view><button bindtap="chooseCity" disabled="{{busy}}">选择地区（当前：{{selection.label}}）</button><button data-target="preferenceRegions" bindtap="addRegion" disabled="{{busy}}">把当前地区加入本人接单范围</button><button wx:for="{{preferenceRegions}}" wx:key="regionId" data-target="preferenceRegions" data-id="{{item.regionId}}" bindtap="removeRegion" disabled="{{busy}}">{{item.label}} · 移除</button><input class="field" type="number" data-field="dailyLimit" value="{{dailyLimit}}" bindinput="input" placeholder="每日邀请上限（1–9）"/><button data-enabled="true" bindtap="preferenceCommand" disabled="{{busy || pending || pendingError || !capabilities.enabled}}">本人确认并启用跨城邀请</button><button data-enabled="false" bindtap="preferenceCommand" disabled="{{busy || pending || pendingError || !preference}}">停止新的跨城邀请</button></view>
 <view wx:if="{{dispatchView==='create' && organizations.length && !detail && !selectedOffer}}" class="card"><view class="subtitle">建立一项跨城人员需求</view><picker class="field" range="{{organizations}}" range-key="name" value="{{orgIndex}}" data-field="orgIndex" bindchange="pick">需求机构：{{organizations[orgIndex].name}}</picker><picker class="field" range="{{kinds}}" range-key="label" value="{{kindIndex}}" data-field="kindIndex" bindchange="pick">岗位：{{kinds[kindIndex].label}}（1人）</picker><button bindtap="chooseCity" disabled="{{busy}}">选择服务或邀请地区</button><button bindtap="useRegion" disabled="{{busy}}">确认服务地区为 {{selection.label}}</button><view>服务地区：{{formRegion.label || '尚未确认'}}</view><button data-target="inviteRegions" bindtap="addRegion" disabled="{{busy}}">把当前地区加入允许邀请的常驻范围</button><button wx:for="{{inviteRegions}}" wx:key="regionId" data-target="inviteRegions" data-id="{{item.regionId}}" bindtap="removeRegion" disabled="{{busy}}">{{item.label}} · 移除</button><input class="field" data-field="address" value="{{address}}" bindinput="input" maxlength="200" placeholder="真实服务场馆与报到地点"/>
  <picker class="field" mode="date" data-field="startDate" value="{{startDate}}" bindchange="input">服务开始日期：{{startDate || '请选择'}}</picker><picker class="field" mode="time" data-field="startTime" value="{{startTime}}" bindchange="input">开始时间（北京时间）：{{startTime}}</picker><picker class="field" mode="date" data-field="endDate" value="{{endDate}}" bindchange="input">服务结束日期：{{endDate || '请选择'}}</picker><picker class="field" mode="time" data-field="endTime" value="{{endTime}}" bindchange="input">结束时间：{{endTime}}</picker><picker class="field" mode="date" data-field="expiryDate" value="{{expiryDate}}" bindchange="input">邀请截止日期：{{expiryDate || '请选择'}}</picker><picker class="field" mode="time" data-field="expiryTime" value="{{expiryTime}}" bindchange="input">截止时间：{{expiryTime}}</picker>
  <view class="section-title">分项与总额上限（元）</view><input class="field" type="digit" data-field="serviceFee" value="{{serviceFee}}" bindinput="input" placeholder="服务费上限；明确免费填0"/><input class="field" type="digit" data-field="travelFee" value="{{travelFee}}" bindinput="input" placeholder="交通费上限"/><input class="field" type="digit" data-field="lodgingFee" value="{{lodgingFee}}" bindinput="input" placeholder="住宿费上限"/><input class="field" type="digit" data-field="totalBudget" value="{{totalBudget}}" bindinput="input" placeholder="完整总额上限"/><view class="muted">额外平台费上限为0。报价须同时满足每项及总额上限。</view><checkbox-group bindchange="checks"><label class="check"><checkbox value="crossCity" checked="{{allowCrossCity}}" disabled="{{busy}}"/>我确认真实需求、允许的跨城范围及费用上限，知悉报价需再次确认</label></checkbox-group><button class="primary" bindtap="create" disabled="{{busy || pending || pendingError || !allowCrossCity || !capabilities.enabled}}">保存需求，随后开始邀请</button>
 </view>
</view><view wx:if="{{detail && detail.request.status==='REVIEWING' && detail.request.canManage && detail.request.canConfirm}}" class="fixed-actions dispatch-fixed"><button class="primary" data-type="CONFIRM_QUOTE" bindtap="requestCommand" disabled="{{busy || pending || pendingError || !chargeConsent}}">确认当前报价并创建真实预约</button></view><scb-nav wx:if="{{!detail && !selectedOffer && (dispatchView==='requests' || dispatchView==='offers')}}" active="Local" disabled="{{busy}}"/>
