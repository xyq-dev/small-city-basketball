.bracket-page { padding:12px 16px calc(112px + env(safe-area-inset-bottom)); }
.bracket-summary { min-height:110px; padding:16px 14px; }
.fig-summary-icon { display:flex; flex:0 0 44px; width:44px; height:44px; align-items:center; justify-content:center; border-radius:12px; background:#eaf2fc; }
.fig-summary-icon image { width:24px; height:24px; }
.bracket-tabs { display:flex; gap:0; padding:3px; margin-bottom:12px; border-radius:12px; background:#fff; }
.bracket-tabs view { flex:1; min-width:0; padding:11px 4px; border-radius:10px; color:#63758b; font-size:13px; line-height:20px; text-align:center; }
.bracket-tabs .selected { color:#fff; background:#164b88; }
.bracket-event-card { color:#18283f; background:#fff; }
.bracket-event-card .board-meta { color:#63758b; }
.bracket-event-card .setup-name { margin:5px 0; font-size:18px; line-height:28px; font-weight:700; }
.bracket-group-card,.bracket-round-card,.bracket-next-card { padding:14px; border:0; border-radius:16px; }
.bracket-group-card .org-table-row:not(.head) { min-height:52px; }
.bracket-round-card .org-match { padding:12px 0; border-radius:0; border-bottom:1px solid #e1e7ef; }
.bracket-round-card .org-match:last-child { border-bottom:0; }
.bracket-next-card .field { border:0; background:#f4f6fa; }
@media (max-width:340px) { .bracket-page { padding-left:12px; padding-right:12px; } .bracket-tabs view { font-size:12px; } .org-table-row { font-size:12px; } }
