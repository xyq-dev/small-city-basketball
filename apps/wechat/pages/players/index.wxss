@import "../../styles/figma-pages.wxss";

.players-tabs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1px; width:100%; height:48px; padding:2px 3px; border-radius:12px; background:#fff; }
.players-tab { display:flex; min-width:0; height:44px; align-items:center; justify-content:center; border-radius:10px; color:#51657d; font-size:13px; line-height:19px; }
.players-tab.is-active { background:#123c73; color:#fff; font-weight:700; }
.players-rebuild .players-tabs>button.players-tab { width:100%; min-width:0; max-width:none; height:44px; min-height:44px; margin:0; padding:0 4px; border:0; justify-self:stretch; box-sizing:border-box; background:transparent; }
.players-rebuild .players-tabs>button.players-tab.is-active { background:#123c73; color:#fff; }
.section-heading { display:flex; align-items:center; justify-content:space-between; gap:8px; }
.section-link,.inline-link { min-width:44px; min-height:44px; color:#123c73; font-size:13px; text-align:right; }
.players-filter-form { display:flex; flex-direction:column; gap:12px; padding-top:4px; border-top:1px solid #e6ebf2; }
.picker-control { display:flex; align-items:center; }
.filter-actions { display:grid; grid-template-columns:140px minmax(0,1fr); gap:8px; }
.player-row { display:flex; align-items:center; gap:8px; border-bottom:1px solid #e6ebf2; }
.player-row:last-of-type { border-bottom:0; }
.player-row__main { min-width:0; flex:1; border:0 !important; }
.player-row__price { display:flex; min-width:70px; min-height:44px; flex:none; align-items:center; justify-content:center; padding:0 10px; }
.player-row__price.is-selected { background:#123c73; color:#fff; }
.compare-chip { min-height:96px !important; background:#eaf2fc !important; }
.player-disclosure { display:flex; flex-direction:column; gap:10px; }
.disclosure-item { padding-top:10px; border-top:1px solid #e6ebf2; }
@media (max-width:360px) { .filter-actions { grid-template-columns:112px minmax(0,1fr); } }
