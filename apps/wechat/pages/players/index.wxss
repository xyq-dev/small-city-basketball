page { background: #f4f6fa; color: #18283f; }
.players-page { padding: 16px; padding-bottom: calc(124px + env(safe-area-inset-bottom)); max-width: 600px; margin: 0 auto; box-sizing: border-box; }
.filter-summary { display: flex; gap: 8px; margin-bottom: 12px; }
.filter-chip { width: 64px; min-width: 64px; height: 44px; min-height: 44px; margin: 0; padding: 0; border-radius: 12px; background: #eaf0f8; color: #123c73; font-size: 14px; line-height: 44px; font-weight: 600; }
.filter-chip.active { background: #123c73; color: #fff; }
.filter-chip::after, .market-field::after, .player-detail::after, .player-select::after { border: none; }
.market-form { display: flex; flex-direction: column; gap: 12px; margin-bottom: 12px; }
.market-field { display: block; width: 100%; min-height: 74px; margin: 0; padding: 12px; border: 1px solid #e1e7ef; border-radius: 12px; background: #fff; color: #18283f; text-align: left; box-sizing: border-box; }
.market-field-label { color: #63758b; font-size: 12px; line-height: 18px; font-weight: 400; }
.market-field-value { margin-top: 8px; font-size: 14px; line-height: 22px; font-weight: 400; overflow-wrap: anywhere; }
.filters { padding: 16px; border-radius: 16px; margin-bottom: 12px; }
.filter-title { display: flex; align-items: center; gap: 8px; }
.filter-title .subtitle { flex: 1; min-width: 0; }
.filter-collapse { width: 64px; min-width: 64px; min-height: 44px; margin: 0; padding: 0 8px; font-size: 14px; }
.field-label { margin: 12px 0 6px; font-size: 14px; line-height: 22px; }
.filters .field { font-size: 16px; }
.picker-value { display: flex; align-items: center; }
.consent { display: flex; align-items: center; margin: 12px 0; font-size: 14px; line-height: 22px; }
.service-profiles { padding: 16px; border-radius: 16px; margin-bottom: 12px; }
.profiles-title { font-size: 18px; line-height: 28px; font-weight: 700; margin-bottom: 8px; }
.player-result + .player-result { margin-top: 8px; }
.player-card { display: flex; align-items: center; gap: 8px; min-height: 58px; }
.player-detail { flex: 1; width: 0; display: flex; align-items: center; gap: 12px; min-height: 58px; margin: 0; padding: 8px 0; border-radius: 0; background: transparent; color: #18283f; text-align: left; font-weight: 400; box-sizing: border-box; }
.player-portrait { width: 22px; height: 22px; flex: 0 0 22px; }
.player-chevron { width: 16px; height: 16px; flex: 0 0 16px; }
.player-identity { flex: 1; min-width: 0; }
.player-name { font-size: 14px; line-height: 22px; font-weight: 400; overflow-wrap: anywhere; }
.player-meta { margin-top: 2px; color: #63758b; font-size: 12px; line-height: 18px; overflow-wrap: anywhere; }
.player-select { width: 44px; min-width: 44px; min-height: 44px; height: 44px; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border-radius: 12px; background: transparent; color: #63758b; }
.selection-box { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 1px solid #e1e7ef; border-radius: 8px; font-size: 18px; line-height: 26px; }
.player-select.selected .selection-box { background: #123c73; color: #fff; border-color: #123c73; }
.money { white-space: nowrap; font-family: Inter, -apple-system, sans-serif; font-variant-numeric: tabular-nums; font-weight: inherit; color: inherit; }
.market-notice { padding: 16px; border-radius: 12px; margin-bottom: 12px; font-size: 12px; line-height: 18px; color: #63758b; background: #eaf0f8; }
.market-information > button { margin: 0 0 12px; }
.market-notes { padding: 16px; border-radius: 16px; }
.source-row { padding: 12px 0; border-bottom: 1px solid #e1e7ef; overflow-wrap: anywhere; }
.small { font-size: 12px; line-height: 18px; }
.market-action { padding: 12px 16px calc(28px + env(safe-area-inset-bottom)); background: #fff; }
.market-action .primary { width: 100%; max-width: 568px; min-height: 48px; margin: 0 auto; padding: 12px; border-radius: 12px; background: #123c73; color: #fff; font-size: 14px; line-height: 22px; font-weight: 600; }
