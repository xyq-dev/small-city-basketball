<scb-header title="找球员" disabled="{{loading}}"/>
<view class="page has-actions players-page">
  <view wx:if="{{loginRequired}}" class="card empty"><view class="subtitle">登录后查看球员服务资料</view><view class="muted">球员目录使用当前应用账号读取，不会用演示资料替代。</view><button class="primary" bindtap="login">登录并返回找球员</button></view>
  <view wx:if="{{error}}" class="card state-panel" role="alert"><view class="state-label">读取失败</view><view class="subtitle">暂时无法读取球员资料</view><view class="notice danger">{{error}}</view><button class="primary" bindtap="load" disabled="{{loading}}">重新读取球员资料</button></view>
  <block wx:if="{{!loginRequired}}">
    <view class="filter-summary" aria-label="当前已应用的筛选条件">
      <button class="filter-chip active" bindtap="filtersToggle" disabled="{{loading}}" aria-label="位置：{{filterSummary.position}}">位置</button><button class="filter-chip" bindtap="filtersToggle" disabled="{{loading}}" aria-label="报价：{{filterSummary.price}}">报价</button><button class="filter-chip" bindtap="filtersToggle" disabled="{{loading}}" aria-label="日期：{{filterSummary.date}}">日期</button>
    </view>
    <view class="market-form">
      <button class="market-field" bindtap="filtersToggle" disabled="{{loading}}"><view class="market-field-label">服务地区</view><view class="market-field-value">{{filters.city || '不限地区，点按设置'}}</view></button>
      <button class="market-field" bindtap="filtersToggle" disabled="{{loading}}"><view class="market-field-label">球员位置</view><view class="market-field-value">{{positionOptions[positionIndex]}}</view></button>
    </view>
    <view wx:if="{{filtersOpen}}" class="card filters">
      <view class="filter-title"><view class="subtitle">筛选位置、价格与档期</view><button class="quiet filter-collapse" bindtap="filtersToggle" aria-label="收起筛选">收起</button></view>
      <view class="field-label">球员姓名</view><input class="field" value="{{filters.search}}" data-field="search" bindinput="input" placeholder="搜索球员姓名" maxlength="80"/>
      <view class="field-label">服务地区</view><input class="field" value="{{filters.city}}" data-field="city" bindinput="input" placeholder="例如高州、石鼓" maxlength="80"/>
      <view class="field-label">球员位置</view><picker range="{{positionOptions}}" value="{{positionIndex}}" bindchange="positionChange"><view class="field picker-value">{{positionOptions[positionIndex]}}</view></picker>
      <view class="field-label">相同参赛服务费</view><input class="field" type="digit" value="{{filters.price}}" data-field="price" bindinput="input" placeholder="不限价格，输入金额如300" maxlength="10"/><view class="muted small">同价只比较参赛服务费，不含平台费、交通和食宿。</view>
      <view class="field-label">比赛日期</view><picker mode="date" value="{{filters.date}}" bindchange="dateChange"><view class="field picker-value">{{filters.date || '不限日期'}}</view></picker><button class="quiet" bindtap="clearDate">不限日期</button><view class="muted small">筛选该日有可约窗口的球员；具体时段仍需提交时核验。</view>
      <view class="field-label">报价排序</view><picker range="{{sortOptions}}" value="{{sortIndex}}" bindchange="sortChange"><view class="field picker-value">{{sortOptions[sortIndex]}}</view></picker>
      <checkbox-group bindchange="samePriceChange"><label class="consent"><checkbox value="same" checked="{{filters.samePrice}}"/>与首位已选球员同价、同位置</label></checkbox-group>
      <button class="primary" bindtap="applyFilters" disabled="{{loading}}">应用筛选</button><button class="quiet" bindtap="clearFilters" disabled="{{loading}}">清空筛选</button>
    </view>
    <view wx:if="{{selectionNotice}}" class="notice warning">{{selectionNotice}}</view><view wx:if="{{statisticsError}}" class="notice warning">统计暂时无法读取：{{statisticsError}}。旧统计已清除，可刷新后重试。</view>
    <view wx:if="{{loading}}" class="card state-panel"><view class="state-label">状态反馈</view><view class="subtitle">正在读取球员与授权统计…</view><view class="muted">读取完成前不展示旧资料或旧统计。</view><view class="loading-lines" aria-hidden="true"><view></view><view></view></view></view>
    <view wx:if="{{!loading && !cards.length && !error}}" class="card empty"><view class="subtitle">暂无匹配球员</view><view class="muted">可以放宽日期、位置或价格，再找一找。</view><button class="secondary" bindtap="filtersToggle">调整筛选条件</button></view>
    <view wx:if="{{cards.length}}" class="card service-profiles">
      <view class="profiles-title">当前可查看的服务档案</view>
      <view wx:for="{{cards}}" wx:key="id" class="player-result"><view class="player-card">
        <button class="player-detail" data-id="{{item.id}}" bindtap="detail" aria-label="{{item.name}}，查看资料"><image class="player-portrait" src="/assets/ui002/avatar-user.svg" mode="aspectFit" aria-hidden="true"/><view class="player-identity"><view class="player-name">{{item.name}} · {{item.position}}</view><view class="player-meta">服务费 <text class="money">{{item.priceLabel || item.price}}</text> / 场</view></view><image class="player-chevron" src="/assets/ui002/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></button>
        <button class="player-select {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="toggle" disabled="{{loading}}" aria-label="{{item.name}}，{{item.selected ? '移出对比' : '加入对比'}}"><view class="selection-box"><scb-icon wx:if="{{item.selected}}" name="check" tone="white" size="18"/><scb-icon wx:else name="plus" tone="gray" size="16"/></view></button>
      </view></view>
    </view>
    <view wx:if="{{!loading && cards.length}}" class="notice market-notice"><view>{{filterSummary.price}} · {{filterSummary.date}}</view><view>已通过入驻资料审核，未核验本场资格或保险。含费报价、档期与记录来源仍需逐项核对。</view></view>
    <button wx:if="{{hasMore}}" class="secondary" bindtap="more" disabled="{{loading}}">加载更多球员</button>
    <view wx:if="{{!loading && cards.length}}" class="market-information">
      <button class="quiet" bindtap="informationToggle">{{informationOpen ? '收起费用与数据说明' : '费用、来源与数据说明'}}</button>
      <view wx:if="{{informationOpen}}" class="card market-notes"><view class="subtitle">按需求选人</view><view class="small">先看位置、档期与数据样本，再比较含费报价。每场记录不代表实力评分，缺少样本不代表能力差。</view>
        <view wx:for="{{cards}}" wx:key="id" class="source-row"><view>{{item.name}} · {{item.position}} · {{item.height}}cm · {{item.city}}</view><view class="small">参赛服务费 <text class="money">{{item.price}}</text> · 平台服务费 <text class="money">{{item.platformFee}}</text></view><view class="small">交通费 <text class="money">{{item.travel}}</text> · 食宿费 <text class="money">{{item.accommodation}}</text> · 含费预计 <text class="money">{{item.total}}</text></view><view class="small">{{item.performance.sample}} 场统计样本 · 每场记录 {{item.performance.points}} 分 / {{item.performance.fouls}} 犯规</view><view class="muted small">完成服务 {{item.performance.services}} 次 · {{item.performance.status}}</view><view class="muted small">授权来源 {{item.performance.sourceCount}} · {{item.performance.source}} · {{item.performance.completeness}}</view><view class="small">已通过入驻资料审核，未核验本场资格或保险。</view><button class="quiet" data-id="{{item.id}}" bindtap="detail">查看{{item.name}}完整资料</button></view>
        <view class="muted small">当前显示 {{showingCount}} / {{filteredCount}} 位匹配球员。目录最多读取最新200位已审核档案，筛选仅在当前目录内进行。</view><button class="quiet" bindtap="bookings">我的预约</button>
      </view>
    </view>
    <view wx:if="{{catalogLimited}}" class="notice warning">目录达到200位上限，不代表全部球员。可联系平台核对其他档案。</view>
  </block>
</view>
<view class="action-bar market-action"><button class="primary" bindtap="compare" disabled="{{loading || selectedCount < 2}}">{{selectedCount >= 2 ? '对比已选' + selectedCount + '位球员' : '请选择至少2位球员对比'}}</button></view>
