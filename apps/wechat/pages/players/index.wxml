<scb-header title="球员广场" disabled="{{loading}}"/>
<view class="page has-actions players-page premium-page">
  <view class="market-search">
    <scb-icon name="search" size="20"/>
    <input value="{{filters.search}}" data-field="search" bindinput="input" bindconfirm="applyFilters" placeholder="搜索球员姓名" maxlength="80" disabled="{{loading}}" aria-label="搜索球员姓名"/>
    <button class="search-submit" bindtap="applyFilters" disabled="{{loading}}" aria-label="搜索球员"><scb-icon name="arrow-right" size="18"/></button>
  </view>
  <view wx:if="{{loginRequired}}" class="card empty">
    <view class="subtitle">登录后查看球员服务资料</view><view class="muted">球员目录使用当前应用账号读取，不会用演示资料替代。</view>
    <button class="primary" bindtap="login">登录并返回找球员</button>
  </view>
  <view wx:if="{{error}}" class="card state-panel" role="alert"><view class="state-label">读取失败</view><view class="subtitle">暂时无法读取球员资料</view><view class="notice danger">{{error}}</view><button class="primary" bindtap="load" disabled="{{loading}}">重新读取球员资料</button></view>
  <block wx:if="{{!loginRequired}}">
    <view class="filter-summary" aria-label="当前已应用的筛选条件">
      <button class="filter-chip active" bindtap="filtersToggle" disabled="{{loading}}">{{filterSummary.position}}<text>⌄</text></button>
      <button class="filter-chip" bindtap="filtersToggle" disabled="{{loading}}">{{filterSummary.price}}<text>⌄</text></button>
      <button class="filter-chip date-chip" bindtap="filtersToggle" disabled="{{loading}}"><scb-icon name="calendar" size="16"/>{{filterSummary.date}}</button>
    </view>
    <view wx:if="{{filtersOpen}}" class="card filters">
      <view class="filter-title"><view class="subtitle">筛选位置、价格与档期</view><button class="quiet filter-collapse" bindtap="filtersToggle" aria-label="收起筛选"><scb-icon name="chevron-up" size="18"/></button></view>
      <view class="field-label">球员姓名</view><input class="field" value="{{filters.search}}" data-field="search" bindinput="input" placeholder="搜索球员姓名" maxlength="80"/>
      <view class="field-label">服务地区</view><input class="field" value="{{filters.city}}" data-field="city" bindinput="input" placeholder="例如高州、石鼓" maxlength="80"/>
      <view class="field-label">球员位置</view><picker range="{{positionOptions}}" value="{{positionIndex}}" bindchange="positionChange"><view class="field picker-value">{{positionOptions[positionIndex]}}<text>⌄</text></view></picker>
      <view class="field-label">相同参赛服务费</view><input class="field" type="digit" value="{{filters.price}}" data-field="price" bindinput="input" placeholder="不限价格，输入金额如300" maxlength="10"/>
      <view class="muted small">同价只比较参赛服务费，不含平台费、交通和食宿。</view>
      <view class="field-label">比赛日期</view><picker mode="date" value="{{filters.date}}" bindchange="dateChange"><view class="field picker-value">{{filters.date || '不限日期'}}<text>⌄</text></view></picker>
      <button class="quiet" bindtap="clearDate">不限日期</button><view class="muted small">筛选该日有可约窗口的球员；具体时段仍需提交时核验。</view>
      <view class="field-label">报价排序</view><picker range="{{sortOptions}}" value="{{sortIndex}}" bindchange="sortChange"><view class="field picker-value">{{sortOptions[sortIndex]}}<text>⌄</text></view></picker>
      <checkbox-group bindchange="samePriceChange"><label class="consent"><checkbox value="same" checked="{{filters.samePrice}}"/>与首位已选球员同价、同位置</label></checkbox-group>
      <button class="primary" bindtap="applyFilters" disabled="{{loading}}">应用筛选</button><button class="quiet" bindtap="clearFilters" disabled="{{loading}}">清空筛选</button>
    </view>
    <view wx:if="{{selectionNotice}}" class="notice warning">{{selectionNotice}}</view>
    <view wx:if="{{statisticsError}}" class="notice warning">统计暂时无法读取：{{statisticsError}}。旧统计已清除，可刷新后重试。</view>
    <view wx:if="{{loading}}" class="card state-panel"><view class="state-label">状态反馈</view><view class="subtitle">正在读取球员与授权统计…</view><view class="muted">读取完成前不展示旧资料或旧统计。</view><view class="loading-lines" aria-hidden="true"><view></view><view></view></view></view>
    <view wx:if="{{!loading &amp;&amp; !cards.length &amp;&amp; !error}}" class="card empty"><view class="subtitle">暂无匹配球员</view><view class="muted">可以放宽日期、位置或价格，再找一找。</view><button class="secondary" bindtap="filtersToggle">调整筛选条件</button></view>
    <view wx:for="{{cards}}" wx:key="id" class="player-result">
      <view class="card player-card">
        <view class="player-head">
          <image class="player-portrait" src="{{item.portrait || '/assets/approved-ui/player-placeholder.svg'}}" mode="aspectFill" aria-label="{{item.portrait ? '示例球员形象' : '球员尚未提供公开头像'}}"/>
          <view class="player-identity"><view class="player-name-row"><text class="player-name">{{item.name}}</text><text class="player-position">· {{item.position}}</text></view><view class="player-bio">{{item.height}}cm · {{item.city}}</view><view class="price">{{item.priceLabel || item.price}}<text class="unit"> / 场</text></view></view>
        </view>
        <button class="player-select {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="toggle" disabled="{{loading}}" aria-label="{{item.name}}，{{item.selected ? '移出对比' : '加入对比'}}"><view class="selection-box">{{item.selected ? '✓' : '＋'}}</view></button>
        <view class="player-metrics-row"><view class="player-metrics"><view class="metric"><view class="metric-value {{item.performance.points === '暂不可用' ? 'textual' : ''}}">{{item.performance.points}}</view><view class="metric-label">得分</view></view><view class="metric"><view class="metric-value {{item.performance.fouls === '暂不可用' ? 'textual' : ''}}">{{item.performance.fouls}}</view><view class="metric-label">犯规</view></view><view class="metric"><view class="metric-value">{{item.performance.sample}}<text class="metric-unit">场</text></view><view class="metric-label">样本</view></view></view><view class="total">含费预计 <text>{{item.totalLabel || item.total}}</text></view></view>
        <view class="player-footer"><view class="player-review"><view class="review-badge"><scb-icon name="shield" tone="green" size="16"/>资料已审核</view><view class="review-note">未核验本场资格或保险</view></view><button class="secondary player-detail" data-id="{{item.id}}" bindtap="detail">查看详情<scb-icon name="chevron-right" size="16"/></button></view>
      </view>
    </view>
    <button wx:if="{{hasMore}}" class="secondary" bindtap="more" disabled="{{loading}}">加载更多球员</button>
    <view wx:if="{{!loading &amp;&amp; cards.length}}" class="market-information">
      <button class="quiet filter-toggle" bindtap="filtersToggle">{{filtersOpen ? '收起筛选' : '筛选位置、价格与档期'}}</button>
      <button class="quiet" bindtap="informationToggle">{{informationOpen ? '收起费用与数据说明' : '费用、来源与数据说明'}}</button>
      <view wx:if="{{informationOpen}}" class="card market-notes"><view class="subtitle">按需求选人</view><view class="small">先看位置、档期与数据样本，再比较含费报价。每场记录不代表实力评分，缺少样本不代表能力差。</view><view wx:for="{{cards}}" wx:key="id" class="source-row"><view>{{item.name}}</view><view class="small">{{item.performance.sample}} 场统计样本 · 每场记录 {{item.performance.points}} 分 / {{item.performance.fouls}} 犯规</view><view class="muted small">完成服务 {{item.performance.services}} 次 · {{item.performance.status}}</view><view class="small">已通过入驻资料审核，未核验本场资格或保险。</view></view><view class="muted small">当前显示 {{showingCount}} / {{filteredCount}} 位匹配球员。目录最多读取最新200位已审核档案，筛选仅在当前目录内进行。</view><button class="quiet" bindtap="bookings">我的预约</button></view>
    </view>
    <view wx:if="{{catalogLimited}}" class="notice warning">目录达到200位上限，不代表全部球员。可联系平台核对其他档案。</view>
  </block>
  <view class="action-bar market-action"><button class="primary" bindtap="compare" disabled="{{loading || selectedCount &lt; 2}}"><view>{{selectedCount &gt;= 2 ? '对比已选' + selectedCount + '位球员 →' : '请选择至少2位球员对比'}}</view><view class="action-caption">同价，也要看样本与实际报价</view></button></view>
</view>
