<scb-header title="找球员" disabled="{{loading}}"/>
<view class="scb-ui-page figma-page players-rebuild">
  <view class="figma-page__content figma-page__content--actions">
    <figma-skeleton wx:if="{{loading}}" rows="4"/>
    <figma-feedback wx:if="{{loginRequired}}" type="permission" title="登录后查看球员服务资料" body="使用当前应用账号读取真实球员目录，不使用演示资料替代。" action-label="登录并返回找球员" bind:action="login"/>
    <figma-feedback wx:if="{{error && !loginRequired}}" type="error" title="暂时无法读取球员资料" body="{{error}}" action-label="重新读取" disabled="{{loading}}" bind:action="load"/>

    <block wx:if="{{!loginRequired}}">
      <view class="figma-summary figma-summary--navy">
        <view class="figma-summary__copy">
          <view class="figma-eyebrow">球员服务</view>
          <view class="figma-title">选择适合本场的球员</view>
          <view class="figma-subtitle">按位置、地区和档期选人，查看每场服务报价。</view>
        </view>
      </view>

      <view class="players-tabs" role="tablist">
        <button class="players-tab is-active" bindtap="filtersToggle" disabled="{{loading}}">综合</button>
        <button class="players-tab" bindtap="filtersToggle" disabled="{{loading}}">同价</button>
        <button class="players-tab" bindtap="filtersToggle" disabled="{{loading}}">档期</button>
      </view>

      <view class="figma-section">
        <view class="figma-section__title">筛选球员</view>
        <button class="figma-row" bindtap="filtersToggle" disabled="{{loading}}">
          <view class="figma-row__mark {{filters.position ? 'is-active' : ''}}"/>
          <view class="figma-row__copy"><view class="figma-row__title">位置</view><view class="figma-row__subtitle">{{filterSummary.position}}</view></view>
          <view class="figma-status figma-status--orange">{{filters.position ? '已选' : '不限'}}</view>
        </button>
        <button class="figma-row" bindtap="filtersToggle" disabled="{{loading}}">
          <view class="figma-row__mark {{filters.city ? 'is-active' : ''}}"/>
          <view class="figma-row__copy"><view class="figma-row__title">服务地区</view><view class="figma-row__subtitle">{{filters.city || '不限地区'}}</view></view>
          <view class="figma-status figma-status--orange">{{filters.city ? '已选' : '不限'}}</view>
        </button>
        <button class="figma-row" bindtap="filtersToggle" disabled="{{loading}}">
          <view class="figma-row__mark {{filters.date ? 'is-active' : ''}}"/>
          <view class="figma-row__copy"><view class="figma-row__title">比赛日期</view><view class="figma-row__subtitle">{{filterSummary.date}}</view></view>
          <view class="figma-status figma-status--orange">可修改</view>
        </button>

        <view wx:if="{{filtersOpen}}" class="players-filter-form">
          <view class="figma-field-group"><view class="figma-field-label">球员姓名</view><input class="figma-field-control" value="{{filters.search}}" data-field="search" bindinput="input" placeholder="搜索球员姓名" maxlength="80"/></view>
          <view class="figma-field-group"><view class="figma-field-label">服务地区</view><input class="figma-field-control" value="{{filters.city}}" data-field="city" bindinput="input" placeholder="例如高州、石鼓" maxlength="80"/></view>
          <view class="figma-field-group"><view class="figma-field-label">球员位置</view><picker range="{{positionOptions}}" value="{{positionIndex}}" bindchange="positionChange"><view class="figma-field-control picker-control">{{positionOptions[positionIndex]}}</view></picker></view>
          <view class="figma-field-group"><view class="figma-field-label">相同参赛服务费</view><input class="figma-field-control" type="digit" value="{{filters.price}}" data-field="price" bindinput="input" placeholder="输入金额，如 300" maxlength="10"/><view class="figma-caption">同价只比较参赛服务费，不含平台费、交通和食宿。</view></view>
          <view class="figma-field-group"><view class="figma-field-label">比赛日期</view><picker mode="date" value="{{filters.date}}" bindchange="dateChange"><view class="figma-field-control picker-control">{{filters.date || '不限日期'}}</view></picker><button class="inline-link" bindtap="clearDate">清除日期</button></view>
          <view class="figma-field-group"><view class="figma-field-label">报价排序</view><picker range="{{sortOptions}}" value="{{sortIndex}}" bindchange="sortChange"><view class="figma-field-control picker-control">{{sortOptions[sortIndex]}}</view></picker></view>
          <checkbox-group bindchange="samePriceChange"><label class="figma-check"><checkbox value="same" checked="{{filters.samePrice}}"/>与首位已选球员同价、同位置</label></checkbox-group>
          <view class="filter-actions"><button class="figma-action figma-action--ghost" bindtap="clearFilters" disabled="{{loading}}">清空</button><button class="figma-action figma-action--navy" bindtap="applyFilters" disabled="{{loading}}">应用筛选</button></view>
        </view>
      </view>

      <figma-feedback wx:if="{{selectionNotice}}" type="info" title="选择已更新" body="{{selectionNotice}}"/>
      <figma-feedback wx:if="{{statisticsError}}" type="error" title="统计暂时无法读取" body="{{statisticsError}}；旧统计已清除，可刷新后重试。"/>
      <figma-feedback wx:if="{{!loading && !cards.length && !error}}" type="empty" title="暂无匹配球员" body="放宽日期、位置或价格后再试。" action-label="调整筛选" bind:action="filtersToggle"/>

      <view wx:if="{{cards.length}}" class="figma-section">
        <view class="figma-section__title">可约球员</view>
        <view wx:for="{{cards}}" wx:key="id" class="player-row">
          <button class="figma-row player-row__main" data-id="{{item.id}}" bindtap="detail">
            <view class="figma-row__copy"><view class="figma-row__title">{{item.name}} · {{item.position}}</view><view class="figma-row__subtitle">{{item.city}} · {{item.availabilityText}}</view></view>
          </button>
          <button class="figma-status figma-status--orange player-row__price {{item.selected ? 'is-selected' : ''}}" data-id="{{item.id}}" bindtap="toggle" disabled="{{loading}}">{{item.priceLabel || item.price}}/场</button>
        </view>
        <button wx:if="{{hasMore}}" class="figma-action figma-action--ghost" bindtap="more" disabled="{{loading}}">加载更多球员</button>
      </view>

      <view wx:if="{{selectedCount}}" class="figma-section">
        <view class="figma-section__title">对比名单</view>
        <view class="figma-grid">
          <block wx:for="{{cards}}" wx:key="id"><view wx:if="{{item.selected}}" class="figma-grid__item compare-chip">
            <view class="figma-row__title">{{item.name}}</view><view class="figma-row__subtitle">参赛服务费 {{item.priceLabel || item.price}}</view><view class="figma-status figma-status--orange">已选</view>
          </view></block>
        </view>
      </view>

      <view wx:if="{{cards.length}}" class="figma-section">
        <button class="figma-row" bindtap="informationToggle"><view class="figma-row__copy"><view class="figma-row__title">费用、来源与数据说明</view><view class="figma-row__subtitle">{{informationOpen ? '收起完整说明' : '查看含费报价和授权样本'}}</view></view><view class="figma-status">{{informationOpen ? '收起' : '展开'}}</view></button>
        <view wx:if="{{informationOpen}}" class="player-disclosure">
          <view wx:for="{{cards}}" wx:key="id" class="disclosure-item"><view class="figma-row__title">{{item.name}} · {{item.position}}</view><view class="figma-caption">参赛 {{item.price}} · 平台 {{item.platformFee}} · 交通 {{item.travel}} · 食宿 {{item.accommodation}} · 含费 {{item.total}}</view><view class="figma-caption">统计样本 {{item.performance.sample}} 场 · 完成服务 {{item.performance.services}} 次 · {{item.performance.source}}</view></view>
          <view class="figma-caption">当前显示 {{showingCount}} / {{filteredCount}} 位匹配球员。目录最多读取最新 200 位已审核档案。</view>
        </view>
      </view>
      <figma-feedback wx:if="{{catalogLimited}}" type="info" title="目录已达 200 位上限" body="这不代表全部球员，可联系平台核对其他档案。"/>
    </block>
  </view>

  <view class="figma-fixed-actions">
    <button class="figma-action figma-action--ghost" bindtap="bookings" disabled="{{loading}}">我的预约</button>
    <button class="figma-action figma-action--orange" bindtap="compare" disabled="{{loading || selectedCount < 2}}">{{selectedCount >= 2 ? '查看同价对比' : '至少选择2位'}}</button>
  </view>
</view>
