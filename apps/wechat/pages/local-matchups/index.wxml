<scb-header title="球队约赛" disabled="{{busy}}"/>
<view class="page local-private"><view class="title">球队约赛</view><view class="muted">真实球场预约 + 双方球队独立确认。约赛不会自动写入正式赛事赛程，支付未开放。</view><button wx:if="{{loginRequired}}" bindtap="login">登录</button><view class="local-actions"><button bindtap="load" disabled="{{busy || loading}}">刷新</button><button bindtap="find">找球场</button><button bindtap="bookings">球场预约</button></view>
 <view wx:if="{{pending || pendingError}}" class="notice warning"><view>{{pendingError || '原操作结果待核对。'}}</view><button bindtap="recover" disabled="{{busy}}">查询原操作回执</button><button wx:if="{{pending}}" bindtap="retry" disabled="{{busy}}">重试原操作</button></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view><view wx:if="{{loading}}">读取中…</view>
 <view wx:if="{{teams.length}}" class="card"><view class="subtitle">发起约赛</view><picker class="field" range="{{teams}}" range-key="name" value="{{teamIndex}}" data-field="teamIndex" bindchange="pick" disabled="{{busy}}">我的球队：{{teams[teamIndex].name}}</picker><button bindtap="card">复制本队名片给对方</button><view class="muted">双方各自从本页复制球队名片并交换，名片只标识球队，不授予管理权限。</view><textarea class="field" data-field="opponentCard" value="{{opponentCard}}" bindinput="input" placeholder="粘贴对方发来的球队名片链接" maxlength="300" disabled="{{busy}}"/><button bindtap="opponent" disabled="{{busy}}">核对对方名片</button><view wx:if="{{opponent}}" class="notice">对方名片已选定，服务器提交后会返回双方真实球队名称，供双方确认。</view><picker class="field" range="{{courtBookings}}" range-key="label" value="{{bookingIndex}}" data-field="bookingIndex" bindchange="pick" disabled="{{busy}}">本次球场：{{courtBookings[bookingIndex].label || '暂无本人已确认球场预约'}}</picker><textarea class="field" data-field="terms" value="{{terms}}" bindinput="input" placeholder="约定人数、到场时间、合作规则、天气与改期处理方式" maxlength="1000" disabled="{{busy}}"/><button class="primary" bindtap="create" disabled="{{busy || pending || pendingError || !opponent || !courtBookings.length}}">发起等待对方确认的约赛</button><view class="muted">邀请30分钟内有效；改期必须双方重新确认，先取消原约赛，再完成球场改期并重新发起。</view></view>
 <button wx:for="{{items}}" wx:key="id" class="card listing" data-id="{{item.id}}" bindtap="select" disabled="{{busy}}"><view class="subtitle">{{item.homeTeamName}} vs {{item.awayTeamName}}</view><view>{{item.statusText}} · {{item.timeText}}</view><view>{{item.address}}</view><view class="muted">{{item.awayConfirmed?'双方已确认':'等待对方独立确认'}}</view></button><view wx:if="{{!loading && !items.length}}" class="card muted">暂无当前可访问约赛；显示最近200项。</view>
 <view wx:if="{{selected}}" class="card"><view class="subtitle">{{selected.homeTeamName}} vs {{selected.awayTeamName}}</view><view>{{selected.statusText}} · {{selected.timeText}}</view><view>{{selected.address}}</view><view class="section-title">本次约定</view><view>{{selected.terms}}</view><textarea class="field" data-field="reason" value="{{reason}}" bindinput="input" placeholder="确认、拒绝、取消或完成的说明（至少4字）" maxlength="500" disabled="{{busy}}"/><block wx:if="{{selected.canConfirm}}"><button class="primary" data-type="CONFIRM" bindtap="command" disabled="{{busy || pending || pendingError}}">作为受邀方确认时间与场地</button><button data-type="DECLINE" bindtap="command" disabled="{{busy || pending || pendingError}}">拒绝邀请</button></block><button wx:if="{{selected.status==='OPEN' || selected.status==='CONFIRMED'}}" class="danger" data-type="CANCEL" bindtap="command" disabled="{{busy || pending || pendingError}}">取消约赛</button><button wx:if="{{selected.status==='CONFIRMED'}}" data-type="COMPLETE" bindtap="command" disabled="{{busy || pending || pendingError}}">时段结束后登记完成</button></view>
</view><scb-nav active="Local" disabled="{{busy}}"/>
