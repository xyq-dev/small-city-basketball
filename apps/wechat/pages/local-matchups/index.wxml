<scb-header title="球队约赛" disabled="{{busy}}"/>
<view class="scb-ui-page figma-page local-private matchup-page">
  <view class="figma-page__content">
    <view class="figma-summary"><view class="figma-summary__icon"><figma-icon name="shield" size="24"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">双方球队领队</view><view class="figma-title">球队约赛</view><view class="figma-subtitle">先确定球场，再交换球队名片并确认约赛。</view></view></view>
    <figma-feedback wx:if="{{loginRequired}}" type="locked" title="登录后管理球队约赛" body="仅当前账号获授权的球队可发起或确认。" action-label="登录" bind:action="login"/>
    <figma-feedback wx:if="{{pending || pendingError}}" type="warning" title="原操作结果待核对" body="{{pendingError || '请先查询原操作回执，避免重复发起约赛。'}}" action-label="查询回执" bind:action="recover"/>
    <button wx:if="{{pending}}" class="figma-action figma-action--ghost" bindtap="retry" disabled="{{busy}}">使用原请求编号重试</button>
    <figma-feedback wx:if="{{error}}" type="error" title="约赛读取失败" body="{{error}}" action-label="重新读取" bind:action="load"/>
    <figma-feedback wx:if="{{message}}" type="success" title="最新结果" body="{{message}}"/>
    <figma-skeleton wx:if="{{loading}}" rows="4"/>

    <view wx:if="{{!selected}}" class="matchup-tabs"><button class="matchup-tab {{matchupView==='list' ? 'is-active' : ''}}" data-key="list" bindtap="matchupView" disabled="{{busy || loading}}">当前约赛</button><button class="matchup-tab {{matchupView==='create' ? 'is-active' : ''}}" data-key="create" bindtap="matchupView" disabled="{{busy || loading || !teams.length}}">发起约赛</button></view>

    <block wx:if="{{matchupView==='list' && !selected}}">
      <figma-feedback wx:if="{{!loading && !items.length}}" type="empty" title="暂无当前可访问约赛" body="先完成本人球场预约，再交换双方球队名片发起约赛。"/>
      <block wx:if="{{items.length}}">
        <view class="figma-section"><view class="figma-section__title">场地预约</view><view class="figma-row"><figma-icon name="court" size="20"/><view class="figma-row__copy"><view class="figma-row__title">{{items[0].venueName || items[0].address}}</view><view class="figma-row__subtitle">{{items[0].timeText}}</view></view><view class="figma-status figma-status--orange">已确认</view></view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">本次约赛时间</view><view class="figma-row__subtitle">与球场预约时段一致</view></view><view class="figma-status figma-status--orange">已核对</view></view></view>
        <view class="figma-section"><view class="figma-section__title">双方球队</view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{items[0].homeTeamName}}</view><view class="figma-row__subtitle">当前有权管理的球队</view></view><view class="figma-status figma-status--orange">发起方</view></view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{items[0].awayTeamName}}</view><view class="figma-row__subtitle">核对对方球队名片</view></view><view class="figma-status">受邀方</view></view></view>
        <view class="figma-section status-banner"><view class="figma-section__title">约赛进度</view><view class="flow-row"><view class="flow-index">1</view><view class="figma-row__copy"><view class="figma-row__title">发起邀请</view><view class="figma-row__subtitle">邀请有效30分钟</view></view><view class="figma-status figma-status--orange">已发出</view></view><view class="flow-row"><view class="flow-index">2</view><view class="figma-row__copy"><view class="figma-row__title">受邀方确认</view><view class="figma-row__subtitle">核对本次时间与场地</view></view><view class="figma-status">待确认</view></view><view class="flow-row"><view class="flow-index">3</view><view class="figma-row__copy"><view class="figma-row__title">约赛完成</view><view class="figma-row__subtitle">时段结束后登记</view></view><view class="figma-status">待办理</view></view></view>
        <view class="figma-section"><view class="figma-section__title">全部约赛</view><button wx:for="{{items}}" wx:key="id" class="figma-row" data-id="{{item.id}}" bindtap="select" disabled="{{busy || loading}}"><view class="figma-row__copy"><view class="figma-row__title">{{item.homeTeamName}} vs {{item.awayTeamName}}</view><view class="figma-row__subtitle">{{item.statusText}} · {{item.timeText}}</view><view class="figma-row__subtitle">{{item.venueName || item.address}}</view></view><view class="figma-status">查看</view></button></view>
      </block>
      <button wx:if="{{teams.length}}" class="figma-row" data-key="create" bindtap="matchupView" disabled="{{busy || loading}}"><view class="figma-row__copy"><view class="figma-row__title">发起新的球队约赛</view><view class="figma-row__subtitle">使用已确认球场预约和双方球队名片</view></view><view class="figma-status">新建</view></button>
    </block>

    <view wx:if="{{matchupView==='create' && teams.length && !selected}}" class="figma-section create-form">
      <view class="figma-eyebrow">新约赛</view><view class="figma-section__title">确认两支球队与球场</view>
      <view class="figma-field-group"><view class="figma-field-label">我的球队</view><picker class="figma-field-control" range="{{teams}}" range-key="name" value="{{teamIndex}}" data-field="teamIndex" bindchange="pick" disabled="{{busy}}">{{teams[teamIndex].name}}</picker></view>
      <button class="figma-action figma-action--ghost" bindtap="card">复制本队名片给对方</button>
      <view class="figma-field-group"><view class="figma-field-label">对方球队名片</view><textarea class="figma-field-control" data-field="opponentCard" value="{{opponentCard}}" bindinput="input" placeholder="粘贴对方发来的球队名片链接" maxlength="300" disabled="{{busy}}"/></view><button class="figma-action figma-action--ghost" bindtap="opponent" disabled="{{busy}}">核对对方名片</button><view wx:if="{{opponent}}" class="figma-info">名片格式已核对；提交后服务器会再次核验球队与双方授权。</view>
      <view class="figma-field-group"><view class="figma-field-label">本次球场预约</view><picker class="figma-field-control" range="{{courtBookings}}" range-key="label" value="{{bookingIndex}}" data-field="bookingIndex" bindchange="pick" disabled="{{busy}}">{{courtBookings[bookingIndex].label || '暂无本人已确认球场预约'}}</picker></view>
      <view class="figma-field-group"><view class="figma-field-label">本次约定</view><textarea class="figma-field-control" data-field="terms" value="{{terms}}" bindinput="input" placeholder="人数、到场、合作规则、天气与改期方式" maxlength="1000" disabled="{{busy}}"/></view>
      <view class="figma-caption">受邀球队须由独立管理人员确认。邀请 30 分钟内有效；改期需先处理球场预约，再由双方重新确认。</view>
      <button class="figma-action figma-action--orange" bindtap="create" disabled="{{busy || pending || pendingError || !opponent || !courtBookings.length}}">发起等待对方确认的约赛</button>
    </view>

    <view wx:if="{{selected}}" class="figma-section matchup-detail">
      <view class="section-heading"><view><view class="figma-eyebrow">约赛详情</view><view class="figma-section__title">{{selected.homeTeamName}} vs {{selected.awayTeamName}}</view></view><button class="section-link" data-key="list" bindtap="matchupView" disabled="{{busy}}">返回</button></view>
      <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{selected.timeText}}</view><view class="figma-row__subtitle">{{selected.address}}</view></view><view class="figma-status figma-status--orange">{{selected.statusText}}</view></view>
      <view class="figma-field-label">本次约定</view><view class="terms-copy">{{selected.terms}}</view>
      <view class="figma-field-group"><view class="figma-field-label">本次操作说明</view><textarea class="figma-field-control" data-field="reason" value="{{reason}}" bindinput="input" placeholder="确认、拒绝、取消或完成说明（至少4字）" maxlength="500" disabled="{{busy}}"/></view>
      <view wx:if="{{selected.canConfirm}}" class="inline-actions"><button class="figma-action figma-action--orange" data-type="CONFIRM" bindtap="command" disabled="{{busy || pending || pendingError}}">确认时间与场地</button><button class="figma-action figma-action--ghost" data-type="DECLINE" bindtap="command" disabled="{{busy || pending || pendingError}}">拒绝邀请</button></view>
      <button wx:if="{{selected.status==='OPEN' || selected.status==='CONFIRMED'}}" class="figma-action figma-action--ghost danger-action" data-type="CANCEL" bindtap="command" disabled="{{busy || pending || pendingError}}">取消约赛</button>
      <button wx:if="{{selected.status==='CONFIRMED'}}" class="figma-action figma-action--ghost" data-type="COMPLETE" bindtap="command" disabled="{{busy || pending || pendingError}}">时段结束后登记完成</button>
    </view>
  </view>
  <view wx:if="{{!selected && matchupView==='list'}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="bookings">查看球场预约</button><button class="figma-action figma-action--orange" bindtap="load" disabled="{{busy || loading}}">刷新约赛进度</button></view>
</view>
