.local-private {
  min-height: 100vh;
  background: #f4f6fa;
  color: #18283f;
  overflow-x: hidden;
}
.local-private .figma-page__content {
  display: flex;
  width: 100%;
  max-width: 600px;
  margin: 0 auto;
  padding: 12px 16px 24px;
  flex-direction: column;
  gap: 12px;
}
.local-private .figma-summary {
  display: flex;
  width: 100%;
  min-height: 92px;
  align-items: center;
  gap: 12px;
  padding: 14px;
  border-radius: 16px;
  background: #fff;
  overflow: hidden;
}
.local-private .figma-summary__icon {
  display: flex;
  width: 44px;
  height: 44px;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: #eaf2fc;
}
.local-private .figma-summary__copy {
  min-width: 0;
  flex: 1;
}
.local-private .figma-eyebrow {
  color: #51657d;
  font-size: 11px;
  line-height: 16px;
}
.local-private .figma-title {
  margin-top: 3px;
  color: #18283f;
  font-size: 18px;
  font-weight: 700;
  line-height: 26px;
  overflow-wrap: anywhere;
}
.local-private .figma-subtitle {
  margin-top: 2px;
  color: #51657d;
  font-size: 12px;
  line-height: 17px;
  overflow-wrap: anywhere;
}
.local-private .figma-section {
  display: flex;
  width: 100%;
  padding: 14px;
  flex-direction: column;
  gap: 8px;
  border-radius: 16px;
  background: #fff;
  overflow: hidden;
}
.local-private .status-banner {
  background: #eaf0f8;
  color: #123c73;
}
.local-private .figma-section__title {
  color: #18283f;
  font-size: 17px;
  font-weight: 700;
  line-height: 24px;
  overflow-wrap: anywhere;
}
.local-private .figma-caption,
.local-private .figma-row__subtitle {
  color: #51657d;
  font-size: 12px;
  line-height: 17px;
  overflow-wrap: anywhere;
}
.local-private .figma-row {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 55px;
  align-items: center;
  gap: 8px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #18283f;
  text-align: left;
}
.local-private .figma-row + .figma-row {
  border-top: 1px solid #e6ebf2;
}
.local-private .figma-row__copy {
  min-width: 0;
  flex: 1;
}
.local-private .figma-row__title {
  color: #18283f;
  font-size: 14px;
  font-weight: 700;
  line-height: 20px;
  overflow-wrap: anywhere;
}
.local-private .figma-status {
  flex: none;
  max-width: 112px;
  padding: 3px 7px;
  border-radius: 7px;
  background: #f4f6fa;
  color: #51657d;
  font-size: 11px;
  line-height: 16px;
  text-align: center;
}
.local-private .figma-status--orange {
  background: #fff1e2;
  color: #18283f;
}
.local-private .figma-field-group {
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: 6px;
}
.local-private .figma-field-label {
  color: #18283f;
  font-size: 14px;
  font-weight: 500;
  line-height: 22px;
}
.local-private .figma-field-control {
  width: 100%;
  min-height: 48px;
  padding: 0 12px;
  border: 1px solid #7c8ea5;
  border-radius: 12px;
  background: #fff;
  color: #18283f;
  font-size: 16px;
  line-height: 24px;
}
.local-private textarea.figma-field-control {
  height: 112px;
  padding-top: 12px;
  padding-bottom: 12px;
}
.local-private .figma-fixed-actions {
  position: fixed;
  z-index: 30;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: minmax(112px, 2fr) minmax(0, 3fr);
  gap: 8px;
  padding: 8px 16px calc(8px + env(safe-area-inset-bottom));
  border-top: 1px solid #e6ebf2;
  background: #fff;
}
.local-private .figma-action {
  display: flex;
  width: 100%;
  min-width: 0;
  height: 48px;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 16px;
  border-radius: 24px;
  font-size: 16px;
  font-weight: 500;
  line-height: 24px;
}
.local-private .figma-action--orange {
  background: #f28c28;
  color: #18283f;
}
.local-private .figma-action--ghost {
  border: 1px solid #7c8ea5;
  background: #fff;
  color: #123c73;
}
.local-private .figma-action[disabled] {
  border-color: #e6ebf2;
  background: #e6ebf2;
  color: #7c8ea5;
}
.local-private .danger-action {
  border-color: #d97474;
  color: #a83b31;
}
.local-private .figma-check {
  display: flex;
  width: 100%;
  min-height: 44px;
  align-items: flex-start;
  gap: 8px;
  color: #18283f;
  font-size: 13px;
  line-height: 20px;
}
.matchup-page {
  padding-bottom: calc(124rpx + env(safe-area-inset-bottom));
}
.matchup-tabs {
  display: flex;
  gap: 2rpx;
  padding: 4rpx 6rpx;
  border-radius: 24rpx;
  background: #fff;
}
.matchup-tab {
  min-height: 88rpx;
  flex: 1;
  margin: 0;
  border-radius: 20rpx;
  background: transparent;
  color: #51657d;
  font-size: 28rpx;
}
.matchup-tab::after,
.section-link::after {
  border: 0;
}
.matchup-tab.is-active {
  background: #123c73;
  color: #fff;
  font-weight: 700;
}
.section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}
.section-link {
  min-width: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #123c73;
  font-size: 26rpx;
}
.team-pair {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  gap: 20rpx;
}
.team-badge {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #123c73;
  color: #fff;
  font-size: 22rpx;
}
.versus {
  margin: 4rpx 0;
  color: #9a5d0b;
  font-size: 22rpx;
  font-weight: 700;
}
.flow-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}
.flow-card {
  min-width: 0;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f4f7fb;
}
.flow-card.is-active {
  background: #fff5e5;
}
.flow-index {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  border-radius: 50%;
  background: #dce3ec;
  color: #51657d;
  font-size: 24rpx;
  font-weight: 700;
}
.figma-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}
.team-card {
  display: flex;
  min-width: 0;
  min-height: 176rpx;
  flex-direction: column;
  justify-content: space-between;
  gap: 8rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #eaf2fc;
}
.flow-row {
  display: flex;
  min-height: 110rpx;
  align-items: center;
  gap: 16rpx;
  border-top: 1rpx solid #d8e1ec;
}
.flow-row:first-of-type {
  border-top: 0;
}
.flow-row .flow-index {
  flex: none;
  margin-bottom: 0;
  background: #fff;
}
.flow-card.is-active .flow-index {
  background: #f6a623;
  color: #18283f;
}
.create-form,
.matchup-detail {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.figma-info {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #e9f2ff;
  color: #123c73;
  font-size: 28rpx;
  line-height: 44rpx;
}
.terms-copy {
  white-space: pre-wrap;
  color: #51657d;
  font-size: 28rpx;
  line-height: 44rpx;
}
.inline-actions {
  display: flex;
  gap: 16rpx;
}
.inline-actions > .figma-action {
  flex: 1;
  min-width: 0;
}
.matchup-detail > .figma-action {
  width: 100%;
}
@media (max-width: 340px) {
  .figma-grid,
  .flow-grid {
    grid-template-columns: 1fr;
  }
  .inline-actions {
    display: grid;
    grid-template-columns: 1fr;
  }
}

/* Keep narrow-screen touch targets at 44px without replacing the base rpx geometry. */
@media (max-width: 375px) {
  .matchup-tab, .section-link {
    min-height: 44px;
  }
  .section-link {
    min-width: 44px;
  }
}
