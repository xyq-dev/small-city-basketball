.setup-page { padding:12px 16px calc(112px + env(safe-area-inset-bottom)); }
.setup-summary { min-height:110px; padding:16px 14px; background:#fff; }
.fig-summary-icon { display:flex; flex:0 0 44px; width:44px; height:44px; align-items:center; justify-content:center; border-radius:12px; background:#eaf2fc; }
.fig-summary-icon image { width:24px; height:24px; }
.setup-page .workflow-tabs { display:flex; flex-wrap:nowrap; gap:0; padding:3px; margin-bottom:12px; border-radius:12px; background:#fff; overflow-x:auto; }
.setup-page .workflow-tabs button { flex:0 0 112px; min-height:44px; margin:0; padding:8px; border-radius:10px; color:#63758b; background:#fff; font-size:13px; line-height:20px; }
.setup-page .workflow-tabs button.selected { color:#fff; background:#164b88; }
.setup-event-card { color:#18283f; background:#fff; }
.setup-event-card .board-meta { color:#63758b; }
.setup-event-card .setup-name { margin:5px 0; font-size:18px; line-height:28px; font-weight:700; overflow-wrap:anywhere; }
.setup-section-card { padding:14px; border:0; border-radius:16px; }
.setup-section-card .subtitle { margin-bottom:10px; font-size:18px; line-height:28px; }
.setup-section-card .field { border:0; background:#f4f6fa; }
.setup-section-card .setup-switch { min-height:56px; }
.setup-page .setup-actions { padding:3px; border-radius:12px; background:#fff; }
.setup-page .setup-actions button { min-height:44px; margin:0; border-radius:10px; }
@media (max-width:340px) { .setup-page { padding-left:12px; padding-right:12px; } .setup-page .workflow-tabs button { flex-basis:104px; } .setup-pair,.setup-trio { grid-template-columns:1fr; } }
