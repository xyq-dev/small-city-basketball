<view class="page mgmt-page setup-page">
  <view wx:if="{{error}}" class="notice warning">{{error}}</view>
  <view wx:if="{{notice}}" class="notice success-notice">{{notice}}</view>
  <view wx:if="{{templatePending}}" class="card"><view class="subtitle">有模板请求待核对</view><view class="muted">原编号和内容已保存在当前账号、机构下。核对完成前不能创建另一个模板或赛事。</view><button class="primary" bindtap="resumeTemplate" disabled="{{busy}}">核对并重试原请求</button></view>

  <block wx:if="{{creating}}">
    <view class="intro-card"><view class="subtitle">创建赛事草稿</view><view class="muted">草稿只对本机构工作人员可见。之后设置报名规则、开放报名、审核并冻结名单，再排赛发布。</view></view>
    <view class="card">
      <view class="subtitle">从模板开始</view>
      <view wx:if="{{templateLoading}}" class="muted">正在读取机构模板</view>
      <view wx:if="{{templateError}}" class="notice small">{{templateError}}</view>
      <picker wx:if="{{templateCanManage}}" class="field" range="{{templateOptions}}" range-key="label" value="{{templateIndex}}" bindchange="pickTemplate" disabled="{{busy || templatePending}}">{{templateOptions[templateIndex].label}}</picker>
      <view wx:if="{{templatePreview}}" class="notice small">
        <view>{{templatePreview.formatLabel}} · {{templatePreview.teams}}</view><view>每队 {{templatePreview.players}}</view><view>{{templatePreview.schedule}}</view>
        <view wx:if="{{templatePreview.groups}}">{{templatePreview.groups}}组，组内循环后固定交叉晋级{{templatePreview.bronze ? '，含季军赛' : ''}}</view>
        <view wx:elif="{{templatePreview.bronze}}">半决赛负者参加季军赛</view>
        <view>只复制配置，报名、球队与人员重新办理。8队2组且保留季军赛时为完整16场；冻结队数须符合模板。</view>
      </view>
      <button class="quiet" bindtap="loadTemplates" disabled="{{busy || templateLoading}}">刷新模板</button>
      <block wx:if="{{templateCanArchive}}"><text class="field-label">归档此模板的原因</text><textarea class="field" value="{{templateArchiveReason}}" data-field="templateArchiveReason" bindinput="templateField" maxlength="500"/><button class="danger" bindtap="archiveTemplate" disabled="{{busy || templatePending}}">归档所选模板</button></block>
    </view>
    <view class="card">
      <text class="field-label">赛事名称</text>
      <input class="field" value="{{draft.name}}" data-section="draft" data-field="name" bindinput="field" maxlength="80" placeholder="例如 青锋杯·冬季赛"/>
      <text class="field-label">开始日期</text>
      <picker mode="date" class="field" value="{{draft.startDate}}" data-section="draft" data-field="startDate" bindchange="field">{{draft.startDate}}</picker>
      <text class="field-label">结束日期</text>
      <picker mode="date" class="field" value="{{draft.endDate}}" data-section="draft" data-field="endDate" bindchange="field">{{draft.endDate}}</picker>
      <text class="field-label">场地（可选）</text>
      <input class="field" value="{{draft.venueName}}" data-section="draft" data-field="venueName" bindinput="field" maxlength="100" placeholder="例如 石鼓公园篮球场"/>
      <text class="field-label">赛制</text>
      <picker wx:if="{{!templatePreview}}" class="field" range="{{formats}}" range-key="label" value="{{draft.formatIndex}}" data-section="draft" data-field="formatIndex" bindchange="field">{{formats[draft.formatIndex].label}}</picker>
      <view wx:else class="field">{{templatePreview.formatLabel}}（使用所选模板）</view>
      <button class="primary" bindtap="create" disabled="{{busy || templatePending}}">{{templatePreview ? '按模板创建草稿' : '创建草稿'}}</button>
    </view>
  </block>

  <view wx:elif="{{loading && !event}}" class="card state-panel"><text class="state-label">赛事设置</text><view class="subtitle">正在读取</view><view class="loading-lines"><view></view><view></view></view></view>
  <view wx:elif="{{!event}}" class="card state-panel">
    <text class="state-label">{{unavailable ? '请核对' : '读取未完成'}}</text>
    <view class="subtitle">{{unavailable ? '无法设置该赛事' : '暂时无法读取赛事'}}</view>
    <button wx:if="{{!unavailable}}" class="primary" bindtap="load">重新读取</button>
  </view>

  <block wx:else>
    <view class="board">
      <view class="board-meta">{{event.statusLabel}} · {{event.formatLabel}}</view>
      <view class="setup-name">{{event.name}}</view>
      <view class="board-meta">{{event.dateLabel}} · {{event.venueName}}</view>
    </view>
    <view class="mode-choice setup-actions">
      <button bindtap="openEvent">赛事详情</button>
      <button bindtap="openReview">报名审核</button>
      <button bindtap="openSchedule">排赛</button>
    </view>
    <view class="card">
      <view class="subtitle">办赛向导</view>
      <view wx:if="{{guideError}}" class="notice small">{{guideError}}。请刷新后核对当前步骤。</view>
      <block wx:if="{{setupGuide}}">
        <view class="muted">已批准 {{setupGuide.counts.approved}} 队 · 已冻结 {{setupGuide.counts.frozen}} 队 · 已排时 {{setupGuide.counts.assigned}} / {{setupGuide.counts.fixtures}} 场</view>
        <view wx:if="{{setupGuide.template}}" class="notice small">使用已保存的模板版本；{{setupGuide.template.expectedTeams ? '预期冻结 ' + setupGuide.template.expectedTeams + ' 队。' : '按实际批准队数办赛。'}}配置变更仍需各自保存和确认。</view>
        <view wx:for="{{setupGuide.steps}}" wx:key="code" class="setup-switch"><view><view>{{index + 1}}. {{item.title}} · {{item.stateLabel}}</view><view wx:for="{{item.blockers}}" wx:for-item="blocker" wx:key="*this" class="muted">{{blocker}}</view></view><button wx:if="{{setupGuide.canManage && item.state !== 'WAITING'}}" class="quiet small-button" data-index="{{index}}" bindtap="openGuideStep">查看</button></view>
      </block>
    </view>

    <view wx:if="{{draft}}" class="card">
      <view class="subtitle">基本信息（草稿可改）</view>
      <text class="field-label">赛事名称</text>
      <input class="field" value="{{draft.name}}" data-section="draft" data-field="name" bindinput="field" maxlength="80"/>
      <text class="field-label">开始日期</text>
      <picker mode="date" class="field" value="{{draft.startDate}}" data-section="draft" data-field="startDate" bindchange="field">{{draft.startDate}}</picker>
      <text class="field-label">结束日期</text>
      <picker mode="date" class="field" value="{{draft.endDate}}" data-section="draft" data-field="endDate" bindchange="field">{{draft.endDate}}</picker>
      <text class="field-label">场地</text>
      <input class="field" value="{{draft.venueName}}" data-section="draft" data-field="venueName" bindinput="field" maxlength="100"/>
      <text class="field-label">赛制</text>
      <picker class="field" range="{{formats}}" range-key="label" value="{{draft.formatIndex}}" data-section="draft" data-field="formatIndex" bindchange="field">{{formats[draft.formatIndex].label}}</picker>
      <button class="primary" bindtap="saveEvent" disabled="{{busy}}">保存基本信息</button>
    </view>

    <view wx:if="{{registration}}" class="card">
      <view class="row-between"><view class="subtitle">报名规则</view><text class="badge">{{registration.saved ? '已设置' : '未设置'}}</text></view>
      <block wx:if="{{registration.editable}}">
        <view class="setup-pair">
          <view><text class="field-label">每队最少人数</text><input class="field" type="number" value="{{registration.minPlayers}}" data-section="registration" data-field="minPlayers" bindinput="field"/></view>
          <view><text class="field-label">每队最多人数</text><input class="field" type="number" value="{{registration.maxPlayers}}" data-section="registration" data-field="maxPlayers" bindinput="field"/></view>
        </view>
        <view class="setup-switch" data-section="registration" data-field="zeroDistinct" bindtap="toggle"><text>0号与00号视为不同号码</text><text class="setup-flag {{registration.zeroDistinct ? 'on' : ''}}">{{registration.zeroDistinct ? '是' : '否'}}</text></view>
        <view class="setup-switch" data-section="registration" data-field="requireIdentity" bindtap="toggle"><text>要求身份资料</text><text class="setup-flag {{registration.requireIdentity ? 'on' : ''}}">{{registration.requireIdentity ? '要求' : '不要求'}}</text></view>
        <view class="setup-switch" data-section="registration" data-field="requireInsurance" bindtap="toggle"><text>要求保险资料</text><text class="setup-flag {{registration.requireInsurance ? 'on' : ''}}">{{registration.requireInsurance ? '要求' : '不要求'}}</text></view>
        <view class="setup-switch" data-section="registration" data-field="requireParticipantMaterials" bindtap="toggle"><text>本人填写、必传照片与人工核验</text><text class="setup-flag {{registration.requireParticipantMaterials ? 'on' : ''}}">{{registration.requireParticipantMaterials ? '启用' : '未启用'}}</text></view>
        <view class="muted">启用后需服务器安全配置就绪，并由本人提交资料与照片。未启用时，身份或保险要求仍阻止开放；在线投保未开放。</view>
        <button class="primary" bindtap="saveRegistration" disabled="{{busy}}">保存报名规则</button>
      </block>
      <view wx:else class="muted">每队 {{registration.minPlayers}}–{{registration.maxPlayers}} 人。报名规则只能在草稿阶段修改。</view>
    </view>

    <view wx:if="{{scoring}}" class="card">
      <view class="row-between"><view class="subtitle">记分规则</view><text class="badge">{{scoring.locked ? '已锁定' : scoring.saved ? '已设置' : '未设置'}}</text></view>
      <block wx:if="{{scoring.editable}}">
        <view class="setup-trio">
          <view><text class="field-label">常规节数</text><input class="field" type="number" value="{{scoring.periods}}" data-section="scoring" data-field="periods" bindinput="field"/></view>
          <view><text class="field-label">每节分钟</text><input class="field" type="number" value="{{scoring.minutes}}" data-section="scoring" data-field="minutes" bindinput="field"/></view>
          <view><text class="field-label">每节秒</text><input class="field" type="number" value="{{scoring.seconds}}" data-section="scoring" data-field="seconds" bindinput="field"/></view>
        </view>
        <text class="field-label">允许的得分分值</text>
        <view class="mode-choice"><button wx:for="{{scoring.scores}}" wx:key="value" class="{{item.on ? 'selected' : ''}}" data-section="scoring" data-field="scores" data-index="{{index}}" bindtap="toggle">{{item.value}}分</button></view>
        <view class="setup-switch" data-section="scoring" data-field="overtime" bindtap="toggle"><text>平分时进入加时</text><text class="setup-flag {{scoring.overtime ? 'on' : ''}}">{{scoring.overtime ? '加时' : '允许平局'}}</text></view>
        <view wx:if="{{scoring.overtime}}" class="setup-pair">
          <view><text class="field-label">加时分钟</text><input class="field" type="number" value="{{scoring.otMinutes}}" data-section="scoring" data-field="otMinutes" bindinput="field"/></view>
          <view><text class="field-label">加时秒</text><input class="field" type="number" value="{{scoring.otSeconds}}" data-section="scoring" data-field="otSeconds" bindinput="field"/></view>
        </view>
        <view class="muted">首场比赛准备后规则永久锁定。</view>
        <button class="primary" bindtap="saveScoring" disabled="{{busy}}">保存记分规则</button>
      </block>
      <view wx:else class="muted">{{scoring.periods}} 节 × {{scoring.durationLabel}} · {{scoring.overtime ? '平分加时 ' + scoring.otLabel : '允许平局'}}{{scoring.locked ? '。比赛已准备，规则已锁定。' : ''}}</view>
    </view>

    <view wx:if="{{standings}}" class="card">
      <view class="row-between"><view class="subtitle">{{event.groups ? '组内积分规则' : '积分规则'}}</view><text class="badge">{{standings.locked ? '已锁定' : standings.saved ? '草稿' : '未设置'}}</text></view>
      <block wx:if="{{standings.editable}}">
        <view class="setup-trio">
          <view><text class="field-label">胜</text><input class="field" type="number" value="{{standings.win}}" data-section="standings" data-field="win" bindinput="field"/></view>
          <view><text class="field-label">平</text><input class="field" type="number" value="{{standings.draw}}" data-section="standings" data-field="draw" bindinput="field"/></view>
          <view><text class="field-label">负</text><input class="field" type="number" value="{{standings.loss}}" data-section="standings" data-field="loss" bindinput="field"/></view>
        </view>
        <text class="field-label">同分时依次比较：{{standings.orderLabel}}</text>
        <view wx:for="{{standings.tiebreakers}}" wx:key="value" class="setup-switch setup-order">
          <text class="setup-rank {{item.on ? 'on' : ''}}">{{item.rank || '–'}}</text>
          <text class="setup-order-name">{{item.label}}</text>
          <button wx:if="{{index > 0}}" class="quiet small-button" data-index="{{index}}" bindtap="moveTiebreaker" disabled="{{busy}}">上移</button>
          <button class="{{item.on ? 'secondary' : 'quiet'}} small-button" data-section="standings" data-field="tiebreakers" data-index="{{index}}" bindtap="toggle" disabled="{{busy}}">{{item.on ? '停用' : '启用'}}</button>
        </view>
        <button class="secondary" bindtap="saveStandings" disabled="{{busy}}">保存积分规则草稿</button>
        <button wx:if="{{standings.canPublish}}" class="primary" bindtap="publishStandings" disabled="{{busy}}">锁定积分规则</button>
      </block>
      <view wx:else class="muted">胜 {{standings.win}} · 平 {{standings.draw}} · 负 {{standings.loss}} · 同分依次比较：{{standings.orderLabel}}。规则已锁定，正式积分只计入独立确认的赛果。</view>
    </view>

    <view wx:if="{{viewing}}" class="card">
      <view class="row-between"><view class="subtitle">公开观赛</view><text class="badge {{viewing.active ? 'success' : ''}}">{{viewing.active ? '已开启' : '未开启'}}</text></view>
      <view class="muted">观众凭链接或分享卡片查看赛程、比分与排名，不含名单、联系方式等私密资料。关闭后旧链接立即失效。</view>
      <button wx:if="{{viewing.active}}" class="secondary" bindtap="openPublic">打开公开观赛页（可分享）</button>
      <button wx:if="{{viewing.canEnable && !viewing.history}}" class="primary" data-type="ENABLE" bindtap="viewing" disabled="{{busy}}">开启公开观赛</button>
      <button wx:if="{{viewing.canEnable && viewing.history}}" class="primary" data-type="ENABLE_HISTORY" bindtap="viewing" disabled="{{busy}}">开启历史观赛</button>
      <button wx:if="{{viewing.canDisable}}" class="danger" data-type="DISABLE" bindtap="viewing" disabled="{{busy}}">关闭公开观赛</button>
      <view wx:if="{{!viewing.active && !viewing.canEnable}}" class="muted">{{event.knockout ? '需先发布正式赛程。' : '需先锁定积分规则并发布正式赛程。'}}{{event.roundRobin ? '' : '每次发布淘汰轮次都会撤销旧链接，需重新开启。'}}</view>
    </view>
    <view wx:if="{{directory}}" class="card">
      <view class="row-between"><view class="subtitle">公开赛事目录</view><text class="badge {{directory.listed ? 'success' : ''}}">{{directory.listed ? '已列入' : '未列入'}}</text></view>
      <view class="muted">开启公开观赛不会自动列入目录。列入后，所有观众都能在“赛事”页的公开赛事中发现本届赛事。</view>
      <view wx:if="{{directory.listed}}" class="muted">当前分组：{{directory.group || '—'}}{{directory.city ? ' · 城市：' + directory.city : ''}}</view>
      <view wx:if="{{directory.lastNote}}" class="notice small">{{directory.lastNote}}</view>
      <view wx:if="{{!directory.publicActive && !directory.listed}}" class="muted">需先开启公开观赛（完赛后为历史观赛），才能列入目录。</view>
      <view wx:elif="{{!directory.canList && !directory.listed && directory.publicActive}}" class="muted">当前赛事状态与公开观赛用途不符，或当前身份无权操作。</view>
      <block wx:if="{{directory.canList || directory.canUnlist}}">
        <view wx:if="{{directory.listed}}" class="muted small">{{directory.currentRegionLabel}}</view>
        <block wx:if="{{directory.catalogVersion && (directory.canList || directory.canReplaceRegion)}}">
          <button class="secondary" bindtap="chooseDirectoryRegion" disabled="{{busy}}">选择标准地区</button>
          <view wx:if="{{directory.selectedRegion}}" class="notice small">已选择：{{directory.selectedRegion.label}}<view wx:if="{{directory.selectedRegion.level === 'PROVINCE'}}">仅按省级归类，不会进入具体市县筛选。</view></view>
          <button wx:if="{{directory.selectedRegion && directory.canList}}" class="quiet" bindtap="clearDirectoryRegion" disabled="{{busy}}">改用历史城市文字</button>
        </block>
        <block wx:if="{{directory.canList && !directory.selectedRegion}}">
          <text class="field-label">历史城市文字（兼容入口，可选，1–20字）</text>
          <input class="field" maxlength="40" value="{{directory.cityInput}}" bindinput="directoryCityInput" placeholder="例如 茂名"/>
        </block>
        <text class="field-label">原因（4–500字，记入审计）</text>
        <textarea class="field" maxlength="500" value="{{directory.reason}}" bindinput="directoryReasonInput" placeholder="{{directory.canList ? '例如：本届赛程已发布，欢迎观众关注' : '例如：赛事信息需更新后再列入'}}"/>
        <button wx:if="{{directory.canList}}" class="primary" bindtap="listDirectory" disabled="{{busy}}">列入公开目录</button>
        <button wx:if="{{directory.canReplaceRegion}}" class="secondary" bindtap="replaceDirectoryRegion" disabled="{{busy || !directory.selectedRegion}}">确认更正标准地区</button>
        <button wx:if="{{directory.canUnlist}}" class="danger" bindtap="unlistDirectory" disabled="{{busy}}">撤出目录（保留分享链接）</button>
      </block>
    </view>
    <view wx:if="{{templateCanManage}}" class="card">
      <view class="subtitle">保存为可复用办赛模板</view>
      <view class="muted">复制服务器上已保存的报名、记分和积分规则。队伍、人员、场地编号、日期、权限与公开状态均不复制。</view>
      <text class="field-label">模板名称</text><input class="field" value="{{templateName}}" data-field="templateName" bindinput="templateField" maxlength="80"/>
      <text class="field-label">预期冻结队数（留空按实际批准队数）</text><input class="field" type="number" value="{{templateExpectedTeams}}" data-field="templateExpectedTeams" bindinput="templateField"/>
      <view class="setup-pair"><view><text class="field-label">每日开始</text><picker mode="time" class="field" value="{{templateScheduling.dailyStart}}" data-field="dailyStart" bindchange="templateField">{{templateScheduling.dailyStart}}</picker></view><view><text class="field-label">每日结束</text><picker mode="time" class="field" value="{{templateScheduling.dailyEnd}}" data-field="dailyEnd" bindchange="templateField">{{templateScheduling.dailyEnd}}</picker></view></view>
      <view class="setup-trio"><view><text class="field-label">每场分钟</text><input class="field" type="number" value="{{templateScheduling.slotDurationMinutes}}" data-field="slotDurationMinutes" bindinput="templateField"/></view><view><text class="field-label">最短休息</text><input class="field" type="number" value="{{templateScheduling.minRestMinutes}}" data-field="minRestMinutes" bindinput="templateField"/></view><view><text class="field-label">日期间隔</text><input class="field" type="number" value="{{templateScheduling.minLocalDayGap}}" data-field="minLocalDayGap" bindinput="templateField"/></view></view>
      <block wx:if="{{event.groups}}"><text class="field-label">分组数（2、4或8组，每组至少2队）</text><input class="field" type="number" value="{{templateScheduling.groupCount}}" data-field="groupCount" bindinput="templateField"/></block>
      <view wx:if="{{event.groups || event.knockout}}" class="setup-switch" bindtap="toggleTemplateBronze"><text>安排季军赛</text><text>{{templateScheduling.thirdPlaceMatch ? '启用' : '不安排'}}</text></view>
      <button class="secondary" bindtap="saveAsTemplate" disabled="{{busy || templatePending}}">保存可复用模板</button>
      <view wx:if="{{templateError}}" class="notice small">{{templateError}}</view>
    </view>
    <button class="quiet" bindtap="load" disabled="{{loading || busy}}">刷新</button>
  </block>
</view>
