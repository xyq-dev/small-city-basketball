@import "../../styles/figma-pages.wxss";
.closure-password{position:relative}.closure-password .figma-field-control{padding-right:82px}.closure-password .figma-status{position:absolute;right:10px;top:13px}.closure-picker{display:flex;align-items:center;justify-content:space-between;gap:8px}
.closure-step{display:flex;min-height:55px;align-items:center;gap:8px}.closure-step__mark{display:flex;width:20px;height:20px;flex:none;align-items:center;justify-content:center;border-radius:50%;background:#eaf2fc;color:#123c73;font-size:11px;font-weight:700}
