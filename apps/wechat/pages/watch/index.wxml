<scb-header mode="{{figmaState==='watch-empty' ? '' : 'account'}}" title="{{figmaState==='watch-empty' ? '暂无公开赛事' : '赛事'}}" back="{{figmaState==='watch-empty'}}" disabled="{{loading}}"/>
<view class="figma-page watch-page">
  <view class="figma-page__content {{figmaState==='watch-empty' ? 'figma-page__content--actions' : 'figma-page__content--nav'}}">
    <block wx:if="{{figmaState==='watch-empty'}}">
      <view class="watch-state-intro"><view class="figma-section__title">暂无公开赛事</view><view class="watch-state-intro__body">目前所选条件下没有已发布赛事，可切换地区或清除筛选。</view></view>
      <view class="figma-section"><view class="figma-section__title">当前条件</view><view class="watch-state-row"><view class="watch-state-dot"/><view class="figma-row__copy"><view class="figma-row__title">浏览地区</view><view class="figma-row__subtitle">广东 · 高州</view></view><view class="figma-status figma-status--orange">已选</view></view><view class="watch-state-row"><view class="watch-state-dot"/><view class="figma-row__copy"><view class="figma-row__title">赛事阶段</view><view class="figma-row__subtitle">进行中</view></view><view class="figma-status figma-status--orange">已选</view></view></view>
      <view class="figma-section"><view class="figma-section__title">调整范围</view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">清除阶段筛选</view><view class="figma-row__subtitle">查看所选地区全部公开赛事。</view></view><view class="figma-status figma-status--orange">可操作</view></view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">查看全国</view><view class="figma-row__subtitle">保留手动选择城市的入口。</view></view><view class="figma-status figma-status--orange">可操作</view></view></view>
    </block>

    <block wx:else>
    <view wx:if="{{!directoryEmpty && dir.loaded && dir.items.length}}" class="watch-hero">
      <view class="watch-hero__copy">
        <view class="figma-eyebrow">公开赛事</view>
        <view class="watch-hero__title">{{citySelection.label}}公开赛事</view>
        <view class="watch-hero__subtitle">{{dir.group==='LIVE' ? '进行中' : dir.group==='UPCOMING' ? '即将开始' : '历史赛事'}} · 公开目录</view>
      </view>
      <image class="watch-hero__image" src="/assets/home/hero.jpg" mode="aspectFill"/>
    </view>

    <view class="watch-tabs" role="tablist">
      <button wx:for="{{dirGroups}}" wx:key="value" class="watch-tab {{dir.group===item.value ? 'is-active' : ''}}" data-group="{{item.value}}" bindtap="pickDirGroup" disabled="{{dir.loading}}" role="tab" aria-selected="{{dir.group===item.value}}">{{item.label}}</button>
    </view>

    <block wx:if="{{directoryEmpty}}">
      <view class="watch-state-intro"><view class="figma-section__title">暂无公开赛事</view><view class="watch-state-intro__body">目前所选条件下没有已发布赛事，可切换地区或清除筛选。</view></view>
      <view class="figma-section"><view class="figma-section__title">当前条件</view><view class="watch-state-row"><view class="watch-state-dot"/><view class="figma-row__copy"><view class="figma-row__title">浏览地区</view><view class="figma-row__subtitle">{{citySelection.label}}</view></view><view class="figma-status figma-status--orange">已选</view></view><view class="watch-state-row"><view class="watch-state-dot"/><view class="figma-row__copy"><view class="figma-row__title">赛事阶段</view><view class="figma-row__subtitle">{{dir.group==='LIVE' ? '进行中' : dir.group==='UPCOMING' ? '即将开始' : '历史赛事'}}</view></view><view class="figma-status figma-status--orange">已选</view></view></view>
      <view class="figma-section"><view class="figma-section__title">调整范围</view><button class="figma-row" bindtap="resetDirGroup"><view class="figma-row__copy"><view class="figma-row__title">清除阶段筛选</view><view class="figma-row__subtitle">回到进行中阶段，仍按当前地区读取。</view></view><view class="figma-status figma-status--orange">可操作</view></button><button class="figma-row" bindtap="clearDirCity"><view class="figma-row__copy"><view class="figma-row__title">查看全国</view><view class="figma-row__subtitle">保留手动选择城市的入口。</view></view><view class="figma-status figma-status--orange">可操作</view></button></view>
      <view class="watch-actions"><button class="figma-action figma-action--ghost" bindtap="clearDirCity">查看全国赛事</button><button class="figma-action figma-action--orange" bindtap="chooseCity">切换浏览城市</button></view>
    </block>
    <block wx:else>
    <view id="watch-directory" class="figma-section">
      <view class="figma-section__title">{{dir.group==='LIVE' ? '正在进行' : dir.group==='UPCOMING' ? '即将开始' : '历史赛事'}}</view>
      <figma-skeleton wx:if="{{dir.loading}}" rows="{{3}}"/>
      <figma-feedback wx:elif="{{dir.error}}" type="error" title="公开赛事读取失败" body="{{dir.error}}" action-label="重新读取" bind:action="loadDirectory"/>
      <view wx:elif="{{dir.loaded && !dir.items.length}}" class="watch-empty">
        <figma-feedback type="empty" title="暂无公开赛事" body="当前条件下没有主办方公开的赛事，可调整地区或赛事阶段。" action-label="调整地区" bind:action="chooseCity"/>
        <button wx:if="{{citySelection.mode!=='NATIONWIDE'}}" class="inline-action" bindtap="clearDirCity">浏览全国赛事</button>
      </view>
      <button wx:for="{{dir.items}}" wx:key="publicEventId" class="figma-row watch-event-row" data-id="{{item.publicEventId}}" bindtap="openDirectory">
        <view class="figma-row__copy">
          <view class="figma-row__title">{{item.name}}</view>
          <view class="figma-row__subtitle">{{item.displayCity}} · {{item.dateLabel}}</view>
        </view>
        <view class="figma-status figma-status--orange">{{item.statusLabel}}</view>
      </button>
      <figma-feedback wx:if="{{dir.moreError}}" type="error" title="后续赛事读取失败" body="{{dir.moreError}}" action-label="重试" bind:action="loadMoreDirectory"/>
      <button wx:if="{{dir.loaded && !dir.done}}" class="inline-action" bindtap="loadMoreDirectory" disabled="{{dir.loadingMore}}" loading="{{dir.loadingMore}}">加载更多赛事</button>
    </view>
    </block>

    <view class="figma-section">
      <view class="figma-section__title">赛事入口</view>
      <view class="figma-grid">
        <button class="figma-grid__item" bindtap="recruitment"><figma-icon name="event" size="{{20}}"/><view class="figma-row__title">公开招募</view><view class="figma-row__subtitle">参赛规程与邀请</view></button>
        <button class="figma-grid__item" bindtap="scrollPrivate"><figma-icon name="event" size="{{20}}"/><view class="figma-row__title">我的赛事</view><view class="figma-row__subtitle">我有权访问的赛事</view></button>
        <button class="figma-grid__item" bindtap="scrollRecent"><figma-icon name="workbench" size="{{20}}"/><view class="figma-row__title">最近观看</view><view class="figma-row__subtitle">返回上次赛事</view></button>
      </view>
    </view>

    <view id="watch-link-entry" class="figma-section">
      <view class="figma-section__title">使用观赛入口</view>
      <view class="figma-field-group"><view class="figma-field-label">观赛链接或公开编号</view><input class="figma-field-control" value="{{value}}" bindinput="input" placeholder="粘贴主办方分享的入口"/></view>
      <view class="figma-field-group"><view class="figma-field-label">浏览范围</view><button class="watch-field-action" bindtap="chooseCity"><text>{{citySelection.label}} · 可切换全国</text><text>选择</text></button></view>
      <figma-feedback wx:if="{{error}}" type="error" title="链接无法打开" body="{{error}}"/>
    </view>

    <view wx:if="{{directoryFiltersOpen}}" class="figma-section">
      <view class="figma-section__title">地区与目录设置</view>
      <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{citySelection.label}}</view><view class="figma-row__subtitle">{{citySelection.source}} · 不自动读取当前位置</view></view><button class="heading-action" bindtap="chooseCity">选择</button></view>
      <view class="figma-field-group"><view class="figma-field-label">历史城市精确筛选</view><input class="figma-field-control" value="{{dir.cityInput}}" bindinput="dirCityInput" bindconfirm="applyDirCity" maxlength="40" placeholder="填写城市名称"/></view>
      <figma-feedback wx:if="{{dir.cityError}}" type="error" title="地区格式不正确" body="{{dir.cityError}}"/>
      <figma-feedback wx:if="{{citySelection.warning}}" type="pending" title="地区资料待核对" body="{{citySelection.warning}}"/>
      <view class="two-actions"><button class="inline-action" bindtap="clearDirCity">全国</button><button class="section-action" bindtap="applyDirCity" disabled="{{dir.loading}}">应用范围</button></view>
    </view>

    <view class="figma-section">
      <view class="figma-section__title">相关服务</view>
      <button class="figma-row" bindtap="scrollPrivate"><figma-icon name="event" size="{{19}}"/><view class="figma-row__copy"><view class="figma-row__title watch-related-title">我的赛事 · 有权赛事</view></view></button>
    </view>

    <view id="watch-private" class="figma-section">
      <view class="section-heading"><view><view class="figma-section__title">我的赛事</view><view class="figma-section__hint">登录账号当前有权访问的赛事</view></view><view wx:if="{{signedIn && total}}" class="figma-status">{{total}} 届</view></view>
      <figma-skeleton wx:if="{{loading && !sections.length}}" rows="{{2}}"/>
      <figma-feedback wx:elif="{{!signedIn}}" type="empty" title="登录后查看你参与的赛事" body="未登录仍可浏览上方公开目录。" action-label="登录并继续" bind:action="login"/>
      <figma-feedback wx:elif="{{eventsError}}" type="error" title="我的赛事读取失败" body="{{eventsError}}" action-label="重新读取" bind:action="load"/>
      <figma-feedback wx:elif="{{!organizations.length}}" type="empty" title="当前账号没有机构赛事身份" body="球队领队授权与机构赛事身份分开，可从我的球队查看本届报名。" action-label="{{teamCount ? '进入我的球队（' + teamCount + '支）' : '进入我的球队'}}" bind:action="teams"/>
      <block wx:else>
        <block wx:for="{{sections}}" wx:key="key" wx:for-item="section">
          <view class="group-label">{{section.label}} · {{section.events.length}}</view>
          <button wx:for="{{section.events}}" wx:key="key" class="figma-row" data-org="{{item.orgId}}" data-id="{{item.id}}" bindtap="openEvent"><view class="figma-row__copy"><view class="figma-row__title">{{item.name}}</view><view class="figma-row__subtitle">{{item.dateLabel}} · {{item.venueName}}</view><view class="figma-row__subtitle">{{item.orgName}} · {{item.roleLabel}}</view></view><view class="figma-status">{{item.statusLabel}}</view></button>
        </block>
        <figma-feedback wx:for="{{failures}}" wx:key="orgId" type="error" title="{{item.orgName}}读取失败" body="{{item.message}}"/>
        <button wx:for="{{creatable}}" wx:key="id" class="inline-action" data-org="{{item.id}}" bindtap="createEvent">在 {{item.name}} 创建赛事</button>
      </block>
    </view>

    <view id="watch-recent" class="figma-section">
      <view class="section-heading"><view class="figma-section__title">最近观看</view><button wx:if="{{recentEvents.length}}" class="heading-action" bindtap="clearRecent">清除</button></view>
      <figma-feedback wx:if="{{!recentEvents.length}}" type="empty" title="暂无最近观看" body="打开有效公开赛事后会保存在本机，撤销公开后自动移除。"/>
      <button wx:for="{{recentEvents}}" wx:key="publicEventId" class="figma-row" data-id="{{item.publicEventId}}" bindtap="openRecent"><view class="figma-row__copy"><view class="figma-row__title">{{item.name}}</view><view class="figma-row__subtitle">{{item.dateLabel}}</view></view><figma-icon name="event" size="{{20}}"/></button>
    </view>

    <view class="watch-actions"><button class="figma-action figma-action--ghost" bindtap="recruitment">查看公开招募</button><button class="figma-action figma-action--orange" bindtap="open" disabled="{{!value}}">查看赛事</button></view>
    </block>
  </view>
  <view wx:if="{{figmaState==='watch-empty'}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost">查看全国赛事</button><button class="figma-action figma-action--orange">切换浏览城市</button></view>
</view>
<scb-nav wx:if="{{!figmaState}}" active="Events"/>
