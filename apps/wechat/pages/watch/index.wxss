.watch-page { display:flex; flex-direction:column; gap:20px; padding-bottom:calc(92px + env(safe-area-inset-bottom)); }
.watch-page > button,.watch-page > .notice { margin:0; }
.watch-intro { padding:24px; border-radius:16px; background:#123c73; color:#fff; }
.watch-intro .title { color:#fff; margin:0 0 12px; }
.watch-copy { font-size:14px; line-height:24px; }
.watch-panel { display:flex; flex-direction:column; gap:16px; padding:24px; border:1px solid #e1e7ef; border-radius:12px; background:#fff; }
.watch-panel .subtitle,.watch-panel .field-label,.watch-panel .field { margin:0; }
.watch-panel .field-label { margin-bottom:-12px; }
.watch-error { margin:0; padding:16px; }
.watch-strong { font-size:14px; line-height:24px; font-weight:500; }
.watch-error .watch-strong,.watch-note .watch-strong { margin-bottom:4px; }
.guide-row { display:flex; gap:12px; align-items:flex-start; }
.guide-row > text { color:#f28c28; flex-shrink:0; }
.guide-row > view { flex:1; min-width:0; }
.watch-note { margin:0; }
.watch-page > .watch-section-head { display:flex; align-items:baseline; justify-content:space-between; margin:4px 0 -8px; }
.watch-section-head .subtitle { margin:0; font-size:16px; line-height:24px; font-weight:700; }
.watch-panel button { margin:0; }
.watch-group-label { margin:0 0 -12px; color:#63758b; font-size:12px; line-height:20px; font-weight:600; }
.watch-page > button.watch-event { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; margin:0; padding:16px; border-radius:12px; text-align:left; font-weight:400; }
.page.watch-page button { width:100%; margin-left:0; margin-right:0; }
.watch-event-main { flex:1; min-width:0; }
.watch-event-name { font-size:16px; line-height:24px; font-weight:600; color:#123c73; overflow-wrap:anywhere; }
.watch-event-status { flex:none; padding:2px 8px; border-radius:24px; background:#eaf0f7; color:#123c73; font-size:12px; line-height:20px; }
.watch-event-status.live { background:#f28c28; color:#fff; }
.watch-event-status.upcoming { background:#e7f5ee; color:#16734b; }
.watch-event-status.cancelled { background:#fdecec; color:#b53333; }
.watch-city-summary { display:flex; align-items:center; gap:12px; margin:8px 0; }
.watch-city-summary > view { flex:1; min-width:0; overflow-wrap:anywhere; }
.watch-page .watch-city-summary button { width:auto; flex:none; margin:0; padding:8px 12px; }

.watch-page { gap:12px; }
.watch-page .mode-choice { display:flex; flex-wrap:wrap; gap:8px; margin:0; }
.watch-page .mode-choice button { width:auto; min-height:44px; margin:0; padding:11px 12px; border-radius:12px; background:#fff; color:#123c73; font-size:14px; line-height:22px; font-weight:500; }
.watch-page .mode-choice button.selected { color:#fff; background:#123c73; }
.watch-public-card { margin:0; padding:16px; border-radius:16px; }
.watch-public-card > .subtitle { margin:0 0 8px; color:#18283f; font-size:18px; line-height:28px; font-weight:700; }
.watch-public-card .public-event-cell { display:flex; align-items:center; gap:12px; min-height:58px; margin:0; padding:8px 0; border-radius:0; background:transparent; text-align:left; }
.public-event-cell::after { border:0; }
.watch-cell-icon { flex:0 0 22px; width:22px; height:22px; }
.watch-chevron { flex:0 0 16px; width:16px; height:16px; }
.public-event-cell .watch-event-name { color:#18283f; font-size:14px; line-height:22px; font-weight:500; }
.public-event-cell .muted { margin-top:2px; font-size:12px; line-height:18px; font-weight:400; }
.watch-main-actions { display:flex; flex-direction:column; gap:8px; }
.watch-main-actions button { min-height:48px; margin:0; padding:12px; border-radius:12px; background:#eaf0f8; font-size:14px; line-height:22px; font-weight:500; }
.watch-discovery-settings > .quiet { margin:0; font-size:14px; line-height:22px; }
.watch-city-row { display:flex; flex-wrap:wrap; align-items:flex-start; gap:8px; }
.watch-city-row .field { flex:1 1 180px; width:auto; min-width:0; margin:0; }
.watch-city-row button { flex:0 0 auto; width:auto; margin:0; }
.watch-page .watch-city-summary { flex-wrap:wrap; }
.watch-city-summary > view { flex:1 1 180px; }
.watch-city-summary button { max-width:100%; }
.watch-page .watch-panel { padding:16px; border-radius:16px; border:0; gap:8px; }
