@import "../../styles/figma-pages.wxss";

.watch-state-intro { display:flex; width:100%; min-height:112px; flex-direction:column; justify-content:center; gap:8px; padding:16px; }
.watch-state-intro__body { color:#18283f; font-size:14px; line-height:22px; }
.watch-state-row { display:flex; width:100%; min-height:55px; align-items:center; gap:8px; padding:0 10px; border-radius:8px; background:#eaf2fc; }
.watch-state-dot { width:7px; height:7px; flex:none; border-radius:50%; background:#123c73; }

.watch-hero{display:flex;width:100%;height:108px;align-items:center;gap:12px;overflow:hidden;padding:14px;border-radius:16px;background:#123c73;color:#fff}.watch-hero__copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:3px}.watch-hero .figma-eyebrow{color:#fff}.watch-hero__title{overflow:hidden;font-size:21px;font-weight:700;line-height:30px;text-overflow:ellipsis;white-space:nowrap}.watch-hero__subtitle{color:#fff;font-size:12px;line-height:17px}.watch-hero__image{width:128px;height:80px;flex:none;border-radius:10px}.watch-tabs{display:grid;height:48px;padding:2px 3px;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;border-radius:12px;background:#fff}.watch-tab{display:flex;min-width:0;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 6px;border:0;border-radius:10px;background:transparent;color:#51657d;font-size:13px;line-height:19px}.watch-tab::after,.heading-action::after,.inline-action::after,.section-action::after,.watch-field-action::after{border:0}.watch-tab.is-active{background:#123c73;color:#fff;font-weight:700}.watch-tab[disabled]{background:#e6ebf2;color:#7c8ea5}.watch-event-row{height:55px}.section-heading{display:flex;min-height:44px;align-items:center;justify-content:space-between;gap:8px}.heading-action{display:flex;min-width:44px;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 4px;border:0;background:transparent;color:#123c73;font-size:13px}.watch-empty{display:flex;flex-direction:column;gap:8px}.inline-action,.section-action{display:flex;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 14px;border-radius:22px;font-size:14px}.inline-action{border:1px solid #7c8ea5;background:#fff;color:#123c73}.section-action{border:0;background:#123c73;color:#fff}.two-actions{display:grid;grid-template-columns:minmax(96px,1fr) minmax(0,2fr);gap:8px}.group-label{padding-top:4px;color:#51657d;font-size:12px;font-weight:700;line-height:17px}.watch-field-action{display:flex;width:100%;height:48px;min-height:48px;align-items:center;justify-content:space-between;margin:0;padding:0 12px;border:1px solid #7c8ea5;border-radius:12px;background:#fff;color:#18283f;font-size:14px;text-align:left}.watch-field-action text:last-child{color:#123c73;font-size:12px}.watch-related-title{color:#123c73}.watch-actions{display:grid;width:100%;height:56px;align-items:center;grid-template-columns:140px minmax(0,1fr);gap:8px}.figma-section figma-feedback{width:100%}@media(max-width:360px){.watch-hero{padding:12px}.watch-hero__image{width:108px;height:68px}.watch-hero__title{font-size:18px;line-height:26px}.watch-actions{grid-template-columns:112px minmax(0,1fr)}}

.watch-page .watch-tabs { width:100%; max-width:100%; box-sizing:border-box; overflow:hidden; }
.watch-page .watch-tabs > .watch-tab { display:flex; width:100%; max-width:100%; min-width:0; height:44px; min-height:44px; margin:0; padding:0 4px; box-sizing:border-box; overflow:hidden; border:0; border-radius:10px; background:transparent; color:#51657d; font-size:13px; font-weight:400; line-height:19px; white-space:nowrap; }
.watch-page .watch-tabs > .watch-tab::after { border:0; border-radius:10px; }
.watch-page .watch-tabs > .watch-tab.is-active { background:#123c73; color:#ffffff; font-weight:700; }
