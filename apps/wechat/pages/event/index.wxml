<view class="page"><view wx:if="{{error}}" class="notice">{{error}} <text wx:if="{{stale}}">现有资料已陈旧</text></view><button bindtap="load">刷新赛事资料</button><block wx:if="{{event}}"><view class="card"><view class="title">{{event.name}}</view><view>{{event.startDate}} — {{event.endDate}}</view><view class="muted">{{event.venueName}} · {{event.status}}</view><view>已确认 {{event.confirmedMatchCount}} / {{event.totalMatchCount}}</view><button open-type="share">分享公开赛事</button></view><view wx:if="{{groups}}" class="card"><view class="title">分组循环与晋级</view><view class="notice">{{groups.qualificationStatus}}；无跨组总排名，组内截线同分需主办方明确抽签。</view><view wx:for="{{groups.groups}}" wx:key="groupKey" wx:for-item="group"><view class="subtitle">{{group.label}}</view><view class="muted">已确认 {{group.confirmedMatchCount}} / {{group.totalMatchCount}}</view><view wx:if="{{group.tieBreakRequired}}">同分待抽签</view><view wx:for="{{group.rows}}" wx:key="teamKey" class="row">{{item.rank || '暂列'}} · {{item.teamName}} · {{item.leaguePoints}}分</view></view></view><view wx:if="{{standings}}" class="card"><view class="title">正式积分</view><view wx:for="{{standings.rows}}" wx:key="teamKey" class="row">{{item.rank || '暂列'}} · {{item.teamName}} · {{item.leaguePoints}}分</view></view><view wx:if="{{bracket}}" class="card"><view class="title">淘汰签位</view><view wx:for="{{bracket.rounds}}" wx:key="roundNo" wx:for-item="round"><view class="subtitle">{{round.label}}</view><view wx:for="{{round.slots}}" wx:key="positionNo" class="row"><block wx:if="{{item.bye}}">{{item.bye.teamName}} · 轮空（不计比赛）</block><block wx:else>{{item.home.teamName || '待晋级'}} 对 {{item.away.teamName || '待晋级'}} · {{item.status}}</block><view wx:if="{{item.winner}}">晋级：{{item.winner.teamName}}</view></view></view><view wx:if="{{bracket.isComplete}}"><view class="subtitle">最终名次</view><view wx:for="{{bracket.placements}}" wx:key="index">{{item.rank}} · {{item.team.teamName}} {{item.tied?'并列':''}}</view></view></view><view class="card"><view class="title">正式赛程</view><view wx:for="{{matches}}" wx:key="publicMatchId" class="row" data-id="{{item.publicMatchId}}" bindtap="match"><view>{{item.home.teamName}} 对 {{item.away.teamName}}</view><view>{{item.score ? item.score.home + ' : ' + item.score.away : '尚未准备'}}</view><view class="muted">{{item.startsAt}} · {{item.courtName}} · {{item.resultStatus}}</view></view></view></block></view>
