<view class="page event-page">
  <view wx:if="{{error}}" class="notice warning">{{error}} <text wx:if="{{stale}}">现有资料已陈旧，请恢复连接后刷新。</text></view>
  <block wx:if="{{event}}">
    <view class="card event-summary"><view class="subtitle">{{event.name}}</view><view class="muted">{{event.startDate}}—{{event.endDate}} · {{event.venueName || '场地待说明'}}</view><view class="badge {{event.status==='RUNNING' ? 'success' : ''}}">{{event.statusLabel}}</view><view class="title">{{event.formatLabel}}</view><view class="muted">已确认 {{event.confirmedMatchCount}} / {{event.totalMatchCount}} 场</view><image class="event-court" src="/assets/court.png" mode="widthFix"/></view>
    <view class="tabs"><button class="chip {{tab==='schedule'?'active':''}}" data-tab="schedule" bindtap="tab">查看赛程</button><button class="chip {{tab==='ranking'?'active':''}}" data-tab="ranking" bindtap="tab">排名与晋级</button><button class="chip {{tab==='media'?'active':''}}" data-tab="media" bindtap="tab">图片与视频</button></view>
    <view wx:if="{{tab==='schedule' || tab==='media'}}" class="card"><view class="subtitle">{{tab==='media' ? '选择比赛查看已发布媒体' : '正式赛程'}}</view><view wx:if="{{!matches.length}}" class="empty">暂无已发布赛程</view><view wx:for="{{matches}}" wx:key="publicMatchId" class="row"><view class="muted">第{{item.roundNo}}轮 · {{item.startLabel}} · {{item.courtName}}</view><view class="subtitle">{{item.home.teamName}} 对 {{item.away.teamName}}</view><view class="match-score">{{item.score ? item.score.home + ' : ' + item.score.away : '尚未准备'}}</view><view class="muted">{{item.statusLabel}} · {{item.resultLabel}}</view><button class="secondary" data-id="{{item.publicMatchId}}" bindtap="match">{{tab==='media' ? '查看本场图片与视频' : '查看本场赛况'}}</button></view></view>
    <block wx:if="{{tab==='ranking'}}">
      <view wx:if="{{groups}}" class="card"><view class="subtitle">分组循环与晋级</view><view class="notice">{{groups.qualificationStatus}}；组内截线同分需主办方明确抽签，无跨组总排名。</view><view wx:for="{{groups.groups}}" wx:key="groupKey" wx:for-item="group"><view class="subtitle">{{group.label}}</view><view class="muted">已确认 {{group.confirmedMatchCount}} / {{group.totalMatchCount}}</view><view wx:if="{{group.tieBreakRequired}}" class="badge warning">同分待抽签</view><view wx:for="{{group.rows}}" wx:key="teamKey" class="row"><view class="row-between"><text>{{item.rank || '暂列'}} · {{item.teamName}}</text><text>{{item.leaguePoints}}分</text></view></view></view></view>
      <view wx:if="{{standings}}" class="card"><view class="subtitle">正式积分</view><view class="muted">仅纳入当前独立确认的正式赛果。</view><view wx:for="{{standings.rows}}" wx:key="teamKey" class="row"><view class="row-between"><text>{{item.rank || '暂列'}} · {{item.teamName}}</text><text>{{item.leaguePoints}}分</text></view></view></view>
      <view wx:if="{{bracket}}" class="card"><view class="subtitle">淘汰签位</view><view wx:for="{{bracket.rounds}}" wx:key="roundNo" wx:for-item="round"><view class="subtitle">{{round.label}}</view><view wx:for="{{round.slots}}" wx:key="positionNo" class="row"><block wx:if="{{item.bye}}">{{item.bye.teamName}} · 轮空（不计比赛）</block><block wx:else>{{item.home.teamName || '待晋级'}} 对 {{item.away.teamName || '待晋级'}} · {{item.status}}</block><view wx:if="{{item.winner}}" class="badge success">晋级：{{item.winner.teamName}}</view></view></view><block wx:if="{{bracket.isComplete}}"><view class="subtitle">最终名次</view><view wx:for="{{bracket.placements}}" wx:key="index" class="row">{{item.rank}} · {{item.team.teamName}} {{item.tied?'并列':''}}</view></block></view>
    </block>
    <button class="secondary" open-type="share">分享此公开赛事</button>
  </block>
  <button class="quiet" bindtap="load" disabled="{{loading}}" loading="{{loading}}">刷新赛事资料</button>
</view>
