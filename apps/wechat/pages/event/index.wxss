@import "../../styles/figma-pages.wxss";

.event-hero { display:flex; width:100%; min-height:108px; align-items:center; gap:12px; padding:14px; overflow:hidden; border-radius:16px; background:#123c73; color:#fff; }
.event-hero__copy { display:flex; min-width:0; flex:1; flex-direction:column; justify-content:center; }
.event-hero__eyebrow { color:#dce7f5; font-size:11px; line-height:16px; }
.event-hero__title { margin-top:3px; color:#fff; font-size:21px; font-weight:700; line-height:30px; overflow-wrap:anywhere; }
.event-hero__subtitle { margin-top:3px; color:#dce7f5; font-size:12px; line-height:17px; overflow-wrap:anywhere; }
.event-hero image { width:128px; height:80px; flex:none; border-radius:10px; }

.event-tabs { display:grid; width:100%; height:48px; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1px; padding:2px 3px; border-radius:12px; background:#fff; }
.event-tab { display:flex; min-width:0; min-height:44px; align-items:center; justify-content:center; margin:0; padding:0 3px; border:0; border-radius:10px; background:transparent; color:#51657d; font-size:11px; line-height:16px; text-align:center; }
.event-tab.is-active { background:#123c73; color:#fff; font-weight:700; }
.standings-summary { background:#fff; }
.standings-tabs { display:grid; width:100%; height:48px; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1px; padding:2px 3px; border-radius:12px; background:#fff; }
.standings-tab { display:flex; min-width:0; min-height:44px; align-items:center; justify-content:center; margin:0; padding:0 4px; border:0; border-radius:10px; background:transparent; color:#51657d; font-size:13px; line-height:19px; }
.standings-tab::after { border:0; }
.standings-tab.is-active { background:#123c73; color:#fff; font-weight:700; }
.standings-schedule-row { height:55px; }
.standings-points .event-point { min-height:86px; }

.event-schedule-row { height:55px; }
.event-points { display:grid; width:100%; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
.event-point { display:flex; min-width:0; min-height:70px; flex-direction:column; justify-content:center; gap:4px; padding:10px; border-radius:10px; background:#f4f6fa; }
.event-point__name { color:#123c73; font-size:21px; font-weight:700; line-height:30px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

.event-services { display:grid; width:100%; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
.event-service { display:flex; width:100%; min-width:0; min-height:85px; flex-direction:column; align-items:flex-start; justify-content:flex-start; gap:4px; margin:0; padding:10px; border:0; border-radius:10px; background:#f4f6fa; color:#18283f; text-align:left; }
.event-service[disabled] { opacity:.62; }
.event-secondary { margin-top:4px; }

.match-row { display:flex; width:100%; min-height:94px; padding:10px 0; flex-direction:column; gap:4px; border:0; border-top:1px solid #e6ebf2; border-radius:0; background:#fff; color:#18283f; text-align:left; }
.match-row__meta,.match-row__status { color:#51657d; font-size:12px; line-height:17px; }
.match-row__body { display:flex; align-items:center; gap:8px; }
.match-row__teams { display:flex; min-width:0; flex:1; align-items:center; gap:6px; font-size:14px; font-weight:700; line-height:20px; overflow-wrap:anywhere; }
.match-row__teams text { color:#7c8ea5; font-size:11px; font-weight:400; }
.match-row__score { flex:none; color:#123c73; font-size:18px; font-weight:700; line-height:26px; }
.ranking-title { padding:8px 0 4px; font-size:14px; font-weight:700; line-height:20px; }
.ranking-row { display:grid; min-height:44px; align-items:center; grid-template-columns:minmax(0,1fr) 52px 42px; gap:6px; border-top:1px solid #e6ebf2; color:#18283f; font-size:12px; line-height:17px; }
.ranking-row text:nth-child(n+2) { text-align:center; }
.ranking-row--head { color:#51657d; font-size:11px; }
.bracket-row { display:flex; min-height:62px; padding:8px 0; flex-direction:column; justify-content:center; gap:2px; border-top:1px solid #e6ebf2; }
.section-action,.section-ghost { display:flex; width:100%; min-height:44px; align-items:center; justify-content:center; margin:0; padding:0 12px; border-radius:22px; font-size:14px; }
.section-action { background:#123c73; color:#fff; }
.section-ghost { border:1px solid #7c8ea5; background:#fff; color:#123c73; }
.event-state-hero { display:flex; width:100%; min-height:112px; flex-direction:column; justify-content:center; gap:8px; padding:16px; border-radius:16px; }
.event-state-hero--error { background:#fdecef; }
.event-state-hero--error .figma-section__title { color:#c83f42; }
.event-state-hero__body { color:#18283f; font-size:14px; line-height:22px; }
.event-state-row { display:flex; width:100%; min-height:55px; align-items:center; gap:8px; padding:0 10px; border-radius:8px; background:#eaf2fc; }
.event-state-dot { width:7px; height:7px; flex:none; border-radius:50%; background:#123c73; }

@media (max-width:360px) {
  .event-hero { gap:8px; padding:12px; }
  .event-hero image { width:104px; height:72px; }
  .event-hero__title { font-size:18px; line-height:26px; }
  .event-tab { padding:0 2px; font-size:10px; }
  .event-point__name { font-size:18px; line-height:26px; }
}
