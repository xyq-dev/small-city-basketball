.event-page {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding-bottom: calc(164px + env(safe-area-inset-bottom));
}
.event-page > button,
.event-page > .notice {
  margin: 0;
}
.event-page > .fig-summary,.event-page > .fig-card { margin:0; }
.public-panel {
  width: 100%;
  padding: 14px;
  border: 0;
  border-radius: 16px;
  background: #fff;
  overflow-wrap: anywhere;
}
.event-summary { margin:0; }
.event-summary .event-court { width:128px; height:80px; overflow:hidden; background:#eaf2fc; }
.event-summary .event-court image { width:100%; height:100%; border-radius:10px; }
.event-summary-meta { margin-top:4px; color:#d9e5f4; font-size:11px; line-height:16px; overflow-wrap:anywhere; }
.event-progress {
  color: #63758b;
  font-size: 14px;
  line-height: 24px;
}
.event-status {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 28px;
  width: 112px;
  max-width: 100%;
  padding: 4px 12px;
  border-radius: 999px;
  color: #63758b;
  background: #f4f6fa;
  font-size: 12px;
  line-height: 20px;
}
.event-status.running {
  color: #16734b;
  background: #e7f5ee;
}
.access-summary,.event-context-summary { margin:0; }
.access-summary .fig-summary-mark,.event-context-summary .fig-summary-mark { order:-1; width:44px; height:44px; border-radius:12px; background:#eaf2fc; }
.access-summary .fig-summary-mark image,.event-context-summary .fig-summary-mark image { width:25px; height:25px; }
.access-summary .fig-summary-title,.event-context-summary .fig-summary-title { margin-top:3px; color:#18283f; font-size:18px; line-height:26px; }
.access-summary .fig-kicker,.access-summary .fig-summary-sub,.event-context-summary .fig-kicker,.event-context-summary .fig-summary-sub { color:#63758b; }
.access-card { margin:0; }
.access-row { display:flex; align-items:center; gap:8px; min-height:55px; margin-top:8px; }
.access-row::before { content:''; flex:0 0 7px; width:7px; height:7px; border-radius:4px; background:#123c73; }
.access-row .fig-row-copy { flex:1; min-width:0; }
.access-error { margin:0; }
.event-menu { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
.event-menu button {
  margin: 0;
  min-height: 76px;
  padding: 12px 10px;
  border-radius: 10px;
  font-size: 14px;
  line-height: 22px;
  white-space: normal;
}
.event-menu button:first-child { grid-column:1 / -1; min-height:44px; }
.public-section-title {
  font-size: 18px;
  line-height: 28px;
  font-weight: 500;
  color: #18283f;
}
.event-tabs {
  display: flex;
  gap: 4px;
  padding:2px 3px;
  border-radius:12px;
  background:#fff;
}
.overview-standings { margin:0; }
.overview-metrics { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
.overview-metrics > view { min-width:0; padding:10px; border-radius:10px; background:#f4f6fa; }
.overview-team { color:#123c73; font-size:18px; line-height:26px; font-weight:700; overflow-wrap:anywhere; }
.event-service-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
.service-tile { min-width:0; min-height:86px; margin:0; padding:10px; border-radius:10px; background:#f4f6fa; color:#18283f; text-align:left; }
.service-tile::after { border:0; }
.service-tile image { width:20px; height:20px; margin-bottom:4px; }
.service-tile view { font-size:14px; line-height:20px; font-weight:700; overflow-wrap:anywhere; }
.service-tile text { display:block; margin-top:2px; color:#63758b; font-size:12px; line-height:17px; font-weight:400; overflow-wrap:anywhere; }
.event-tabs button {
  flex: 1;
  min-width: 0;
  min-height: 44px;
  padding: 10px 3px;
  margin: 0;
  color: #63758b;
  background: transparent;
  font-size: 14px;
  line-height: 24px;
}
.event-tabs button::after {
  border: 0;
}
.event-tabs button.selected {
  background: #123c73;
  color: #fff;
  border-radius:10px;
}
.overview-tabs { gap:1px; }
.overview-tabs button { font-size:11px; line-height:16px; }
.schedule-note {
  margin: 0;
  padding: 16px;
}
.state-strong {
  font-size: 14px;
  line-height: 24px;
  font-weight: 500;
  margin-bottom: 4px;
}
.public-match-card {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 14px;
  border: 0;
  border-radius: 16px;
  background: #fff;
}
.match-teams {
  color: #18283f;
  font-size: 14px;
  line-height: 24px;
  font-weight: 500;
}
.match-score {
  color: #123c73;
  font-family: Inter, Arial, sans-serif;
  font-size: 32px;
  line-height: 42px;
  font-weight: 600;
}
.match-status {
  color: #16734b;
  font-size: 12px;
  line-height: 20px;
}
.standings-panel {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.standings-panel .subtitle,
.standings-panel .notice {
  margin: 0;
}
.standings-table {
  width: 100%;
  border: 1px solid #e1e7ef;
  border-radius: 8px;
  overflow: hidden;
}
.standings-row {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  min-height: 52px;
  padding: 16px 12px;
  font-size: 14px;
  line-height: 20px;
}
.standings-row.table-head {
  color: #63758b;
  background: #f4f6fa;
  font-size: 12px;
  line-height: 20px;
}
.team-cell {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.games-cell {
  flex: 0 0 52px;
  width: 52px;
}
.points-cell {
  flex: 0 0 36px;
  width: 36px;
}
.bracket-card {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.bracket-card .subtitle {
  margin: 0;
}
.placements-panel .subtitle {
  margin-bottom: 16px;
}
.placement-row {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 12px 0;
  border-bottom: 1px solid #e1e7ef;
}
.placement-row:last-child {
  border-bottom: 0;
}
.placement-rank {
  width: 32px;
  flex: 0 0 32px;
  color: #123c73;
  font-family: Inter, Arial, sans-serif;
  font-size: 22px;
  line-height: 28px;
  font-weight: 600;
}
.public-state {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.public-state .title,
.public-state .subtitle,
.public-state .notice,
.public-state button {
  margin: 0;
}
.state-tag {
  align-self: flex-start;
  padding: 4px 16px;
  border-radius: 999px;
  background: #eaf0f7;
  color: #123c73;
  font-size: 12px;
  line-height: 20px;
}
.state-tag.warning {
  background: #fff3dc;
  color: #895500;
}
.public-skeleton {
  height: 12px;
  border-radius: 4px;
  background: #eaf0f7;
}
.public-skeleton.short {
  width: 82%;
}
.compact-state {
  padding: 14px;
}
.follow-panel {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.follow-panel .subtitle,
.follow-panel .notice,
.follow-panel button {
  margin: 0;
}
.follow-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.follow-tag {
  padding: 4px 12px;
  border-radius: 999px;
  background: #e7f5ee;
  color: #16734b;
  font-size: 12px;
  line-height: 20px;
}
.follow-notice {
  padding: 12px 16px;
}
.follow-reminder {
  line-height: 20px;
}
@media (max-width: 360px) {
  .public-panel {
    padding: 12px;
  }
  .event-summary .event-court { width:104px; height:64px; }
  .standings-row {
    gap: 6px;
    padding-left: 8px;
    padding-right: 8px;
  }
  .games-cell {
    flex-basis: 44px;
    width: 44px;
  }
  .points-cell {
    flex-basis: 28px;
    width: 28px;
  }
  .overview-metrics { grid-template-columns:1fr; }
}
