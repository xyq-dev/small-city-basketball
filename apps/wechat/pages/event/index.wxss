.event-page { display:flex; flex-direction:column; gap:20px; padding-bottom:calc(92px + env(safe-area-inset-bottom)); }
.event-page > button,.event-page > .notice { margin:0; }
.public-panel { width:100%; padding:24px; border:1px solid #e8edf2; border-radius:12px; background:#fff; overflow-wrap:anywhere; }
.event-summary { display:flex; flex-direction:column; align-items:flex-start; gap:16px; }
.event-summary .subtitle,.event-summary .title { margin:0; }
.event-progress { color:#617286; font-size:14px; line-height:24px; }
.event-status { display:flex; align-items:center; justify-content:center; min-height:28px; width:112px; max-width:100%; padding:4px 12px; border-radius:999px; color:#617286; background:#f5f7fa; font-size:12px; line-height:20px; }
.event-status.running { color:#16734b; background:#e7f5ee; }
.event-court { display:block; width:100%; height:auto; }
.event-menu { display:flex; flex-direction:column; gap:20px; }
.event-menu button { margin:0; }
.public-section-title { font-size:18px; line-height:28px; font-weight:500; color:#152c43; }
.event-tabs { display:flex; gap:4px; }
.event-tabs button { flex:1; min-width:0; min-height:44px; padding:10px 4px; margin:0; color:#617286; background:transparent; font-size:14px; line-height:24px; }
.event-tabs button::after { border:0; }
.event-tabs button.selected { background:#eaf0f7; color:#132c49; }
.schedule-note { margin:0; padding:16px; }
.state-strong { font-size:14px; line-height:24px; font-weight:500; margin-bottom:4px; }
.public-match-card { display:flex; flex-direction:column; gap:8px; padding:16px; border:1px solid #e8edf2; border-radius:16px; background:#fff; }
.match-teams { color:#152c43; font-size:14px; line-height:24px; font-weight:500; }
.match-score { color:#132c49; font-family:Inter,Arial,sans-serif; font-size:32px; line-height:42px; font-weight:600; }
.match-status { color:#16734b; font-size:12px; line-height:20px; }
.standings-panel { display:flex; flex-direction:column; gap:16px; }
.standings-panel .subtitle,.standings-panel .notice { margin:0; }
.standings-table { width:100%; border:1px solid #e8edf2; border-radius:8px; overflow:hidden; }
.standings-row { display:flex; align-items:flex-start; gap:8px; min-height:52px; padding:16px 12px; font-size:14px; line-height:20px; }
.standings-row.table-head { color:#617286; background:#f5f7fa; font-size:12px; line-height:20px; }
.team-cell { flex:1; min-width:0; overflow-wrap:anywhere; }
.games-cell { flex:0 0 52px; width:52px; }
.points-cell { flex:0 0 36px; width:36px; }
.bracket-card { display:flex; flex-direction:column; gap:16px; }
.bracket-card .subtitle { margin:0; }
.placements-panel .subtitle { margin-bottom:16px; }
.placement-row { display:flex; align-items:flex-start; gap:16px; padding:12px 0; border-bottom:1px solid #e8edf2; }
.placement-row:last-child { border-bottom:0; }
.placement-rank { width:32px; flex:0 0 32px; color:#132c49; font-family:Inter,Arial,sans-serif; font-size:22px; line-height:28px; font-weight:600; }
.public-state { display:flex; flex-direction:column; gap:16px; }
.public-state .title,.public-state .subtitle,.public-state .notice,.public-state button { margin:0; }
.state-tag { align-self:flex-start; padding:4px 16px; border-radius:999px; background:#eaf0f7; color:#132c49; font-size:12px; line-height:20px; }
.state-tag.warning { background:#fff3dc; color:#895500; }
.public-skeleton { height:12px; border-radius:4px; background:#eaf0f7; }
.public-skeleton.short { width:82%; }
.compact-state { padding:24px; }
@media (max-width:360px) { .public-panel { padding:20px; } .standings-row { gap:6px; padding-left:8px; padding-right:8px; } .games-cell { flex-basis:44px; width:44px; } .points-cell { flex-basis:28px; width:28px; } }
