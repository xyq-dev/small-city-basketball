@import "../../styles/figma-pages.wxss";
.notification-check{width:20px;height:20px;flex:none;border:1px solid #7c8ea5;border-radius:4px;background:#fff}.notification-check.is-selected{border:5px solid #123c73}.notification-step{display:flex;min-height:56px;align-items:center;gap:10px}.notification-step__mark{display:flex;width:22px;height:22px;flex:none;align-items:center;justify-content:center;border-radius:50%;background:#eaf2fc;color:#123c73;font-size:12px;font-weight:700}.notification-rebuild .notification-text-action{display:flex;min-height:44px;align-items:center;padding:0;border:0;background:transparent;color:#c83f42;font-size:13px}
