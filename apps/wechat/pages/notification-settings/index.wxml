<scb-header title="微信订阅提醒" disabled="{{busy}}"/>
<view class="figma-page notification-rebuild">
  <view class="figma-page__content figma-page__content--actions">
    <view class="figma-summary"><view class="figma-summary__icon"><figma-icon name="bell" size="28"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">本人微信身份</view><view class="figma-title">本次提醒选择</view><view class="figma-subtitle">每次订阅都由本人选择并确认</view></view></view>
    <figma-tabs key1="settings" label1="提醒设置" key2="history" label2="最近记录" active="{{activeView}}" disabled="{{busy}}" bind:change="changeView"/>
    <figma-feedback wx:if="{{loginRequired}}" type="warning" title="登录并绑定当前微信身份" body="完成后才可逐次选择提醒。" action-label="登录并继续" bind:action="login"/>
    <figma-feedback wx:if="{{!enabled}}" type="closed" title="微信提醒通道尚未配置" body="当前可查看站内消息，不会发送微信提醒。"/>
    <figma-feedback wx:if="{{error}}" type="error" title="订阅操作未完成" body="{{error}}"/>
    <figma-feedback wx:if="{{message}}" type="success" title="订阅状态已更新" body="{{message}}"/>
    <figma-feedback wx:if="{{pending}}" type="warning" title="原请求待核对" body="核对原请求后继续，避免重复申请；身份验证信息不会保存到本机恢复记录。" action-label="核对原请求" disabled="{{busy}}" bind:action="recover"/>

    <block wx:if="{{activeView === 'settings'}}">
      <view class="figma-section"><view class="figma-section__title">选择本次提醒</view><button wx:for="{{kinds}}" wx:key="kind" class="figma-row" data-kind="{{item.kind}}" bindtap="choose" disabled="{{busy || pending || !item.templateId}}"><view class="notification-check {{selected === item.kind ? 'is-selected' : ''}}"/><view class="figma-row__copy"><view class="figma-row__title">{{item.label}}</view><view class="figma-row__subtitle">{{item.subtitle || (item.kind === 'REGISTRATION_REVIEW' ? '本届报名审核有新进度' : item.kind === 'MATCH_RESCHEDULED' ? '已关注或获准接收的赛程变化' : '本人预约或比赛开场提醒')}}</view></view><view class="figma-status figma-status--orange">{{selected === item.kind ? '已选择' : '未选择'}}</view></button></view>
      <view class="figma-section"><view class="figma-section__title">订阅流程</view><view class="notification-step"><view class="notification-step__mark">1</view><view><view class="figma-row__title">绑定当前微信身份</view><view class="figma-row__subtitle">先核验登录账号</view></view></view><view class="notification-step"><view class="notification-step__mark">2</view><view><view class="figma-row__title">准备所选提醒</view><view class="figma-row__subtitle">按模板与用途读取能力</view></view></view><view class="notification-step"><view class="notification-step__mark">3</view><view><view class="figma-row__title">微信弹窗确认</view><view class="figma-row__subtitle">以本次授权结果为准</view></view></view><button class="figma-action figma-action--navy" bindtap="prepare" disabled="{{busy || pending || !enabled}}">准备本次订阅</button><button wx:if="{{intent}}" class="figma-action figma-action--orange" bindtap="subscribe" disabled="{{busy || pending}}">打开微信弹窗，决定本次订阅</button><button class="notification-text-action" bindtap="revoke" disabled="{{busy}}">明确撤销本类许可及待发提醒</button></view>
      <view class="figma-section"><view class="figma-section__title">渠道状态</view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">正式订阅能力</view><view class="figma-row__subtitle">依赖实际模板及正式配置</view></view><view class="figma-status figma-status--orange">{{enabled ? '待核验' : '未开放'}}</view></view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">站内消息</view><view class="figma-row__subtitle">可直接查看本人消息</view></view><view class="figma-status figma-status--green">可用</view></view></view>
    </block>

    <block wx:if="{{activeView === 'history'}}"><view class="figma-section"><view class="figma-section__title">最近订阅记录</view><figma-feedback wx:if="{{!subscriptions.length}}" type="empty" title="暂无订阅许可记录"/><view wx:for="{{subscriptions}}" wx:key="id" class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{item.label}}</view><view class="figma-row__subtitle">每次许可只安排一次提醒</view></view><view class="figma-status">{{item.stateLabel}}</view></view></view></block>
  </view>
  <view wx:if="{{figmaNotificationPreview}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost">核对原请求</button><button class="figma-action figma-action--orange">查看站内消息</button></view>
  <view wx:else class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="recover" disabled="{{busy || !pending}}">核对原请求</button><button class="figma-action figma-action--orange" bindtap="messages">查看站内消息</button></view>
</view>
