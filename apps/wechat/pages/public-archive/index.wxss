@import "../../styles/figma-pages.wxss";

.archive-tabs{display:grid;height:48px;padding:2px 3px;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;border-radius:12px;background:#fff}.archive-tab{display:flex;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 8px;border:0;border-radius:10px;background:transparent;color:#51657d;font-size:13px}.archive-tab::after,.ranking-card::after{border:0}.archive-tab.is-active{background:#123c73;color:#fff;font-weight:700}.archive-metrics{display:grid;width:100%;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.archive-metrics>view{display:flex;min-width:0;padding:10px;flex-direction:column;gap:4px;border-radius:10px;background:#f4f6fa}.archive-metrics text{color:#123c73;font-size:21px;font-weight:700;line-height:30px}.archive-metrics view view{color:#51657d;font-size:12px;line-height:17px}.archive-notice{display:flex;width:100%;min-height:55px;align-items:center;gap:9px;padding:0 10px;border-radius:8px;background:#eaf2fc}.archive-notice__mark{width:7px;height:7px;flex:none;border-radius:4px;background:#123c73}.stats-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;color:#18283f;font-size:12px;line-height:17px}.stats-grid view{padding:10px;border-radius:10px;background:#f4f6fa}.ranking-card{display:flex;width:100%;min-height:76px;align-items:center;gap:10px;margin:0;padding:12px 14px;border:0;border-radius:16px;background:#fff;color:#18283f;text-align:left}.ranking-card__rank{display:flex;width:36px;height:36px;flex:none;align-items:center;justify-content:center;border-radius:10px;background:#eaf2fc;color:#123c73;font-size:16px;font-weight:700}.ranking-card__copy{min-width:0;flex:1}
