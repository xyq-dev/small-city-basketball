<scb-header title="篮球公开档案" disabled="{{busy || pending || uncertain || dirty}}"/>
<view class="page fig-page mgmt-page">
  <view class="fig-summary identity-summary archive-identity">
    <view class="fig-summary-copy">
      <view class="fig-kicker">公开档案</view>
      <view class="fig-summary-title">{{archive ? archive.displayName : '公开跨届榜单'}}</view>
      <view class="fig-summary-sub">{{archive ? (archive.kind==='PLAYER' ? '球员生涯 · 独立公开授权' : '球队跨届 · 独立公开授权') : '只展示已独立授权且当前有效的统计'}}</view>
    </view>
    <view class="fig-summary-mark"><image src="/assets/figma/stats.svg" mode="aspectFit"/></view>
  </view>
  <view class="archive-tabs"><button class="{{archive ? 'selected' : ''}}" bindtap="load">公开主页</button><button class="{{archive ? '' : 'selected'}}" bindtap="rankings">跨届榜单</button></view>
  <view wx:if="{{loading}}" class="card">正在读取当前有效的公开来源</view><view wx:if="{{error}}" class="notice warning">{{error}}</view>
  <block wx:if="{{archive}}"><view class="card sample-card"><view class="fig-card-title">确认样本</view><view class="archive-metrics"><view><view class="archive-total">{{archive.confirmedMatchCount}} 场</view><view class="muted">有效授权场次</view></view><view><view class="archive-total">{{archive.recordedMatchCount}} 场</view><view class="muted">统计样本</view></view></view><view class="archive-name">{{archive.displayName}}</view><view class="muted">{{archive.kind==='PLAYER'?'球员生涯':'球队跨届'}} · 独立公开授权</view><view class="archive-points">{{archive.points===null?'未采集个人得分':archive.points+' 分'}}</view><view>样本场均 {{archive.pointsPerRecordedMatch===null?'未知':archive.pointsPerRecordedMatch}} · 犯规 {{archive.fouls===null?'未知':archive.fouls}}</view><view wx:if="{{archive.kind==='TEAM'}}">胜 {{archive.wins}} · 平 {{archive.draws}} · 负 {{archive.losses}}</view></view>
    <view class="card"><view class="fig-card-title">数据覆盖</view><view class="subtitle">专业数据覆盖</view><block wx:if="{{archive.technical}}"><view>专业样本 {{archive.technical.sampledMatchCount}} 场 · {{archive.kind==='PLAYER'?'明确记录出场':'明确记录比赛'}} {{archive.technical.appearedMatchCount}} 场</view><view>权威累计{{archive.kind==='PLAYER'?'上场':'比赛'}} {{archive.playingTimeLabel}}</view><view>投篮 {{archive.technical.fieldGoalsMade}}/{{archive.technical.fieldGoalsAttempted}} · 命中率 {{archive.technical.fieldGoalPercentage===null?'无出手':archive.technical.fieldGoalPercentage+'%'}}</view><view>三分 {{archive.technical.threePointersMade}}/{{archive.technical.threePointersAttempted}} · 罚球 {{archive.technical.freeThrowsMade}}/{{archive.technical.freeThrowsAttempted}}</view><view>篮板 {{archive.technical.rebounds}} · 助攻 {{archive.technical.assists}} · 抢断 {{archive.technical.steals}} · 盖帽 {{archive.technical.blocks}} · 失误 {{archive.technical.turnovers}}</view></block><view wx:else class="muted">未启用或未授权专业采集，专业数据保持未知。</view></view>
    <view class="card record-card"><view class="fig-card-title">授权有效记录</view><view wx:for="{{archive.recentRecords}}" wx:key="recordKey" class="section record-row"><view><view class="fig-row-title">{{item.eventName}}</view><view class="muted">{{item.date}} · 得分 {{item.points===null?'未逐人采集':item.points}} · 犯规 {{item.fouls===null?'未知':item.fouls}}</view></view><view class="fig-pill">已确认</view></view><view wx:if="{{!archive.recentRecords.length}}" class="muted">暂无当前有效的授权确认样本</view></view>
  </block>
  <block wx:else><view class="card"><view class="subtitle">公开跨届榜单</view><view class="mode-choice"><button data-kind="PLAYER" bindtap="kind">{{kind==='PLAYER'?'已选择：':''}}球员</button><button data-kind="TEAM" bindtap="kind">{{kind==='TEAM'?'已选择：':''}}球队</button></view></view><view wx:for="{{entries}}" wx:key="key" class="card"><view>{{item.rank}} · {{item.archive.displayName}}</view><view class="muted">样本场均 {{item.archive.pointsPerRecordedMatch}} · 总分 {{item.archive.points}} · {{item.archive.recordedMatchCount}} 场统计样本</view><button class="secondary" data-key="{{item.archive.publicKey}}" bindtap="open">查看公开主页</button></view><view wx:if="{{!loading && !entries.length && !error}}" class="card muted">暂无符合独立公开授权和有效统计条件的档案。</view></block>
  <view wx:if="{{notice}}" class="notice small">{{notice}}</view><button wx:if="{{archive}}" class="secondary" bindtap="rankings">公开跨届榜单</button><button class="quiet" bindtap="load">重新读取</button>
</view>
<view class="fig-actions dock">
  <button class="fig-ghost" bindtap="load">重新读取</button>
  <button class="fig-confirm" bindtap="rankings">查看公开跨届榜单</button>
</view>
