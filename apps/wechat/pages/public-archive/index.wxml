<scb-header title="篮球公开档案" disabled="{{loading}}"/>
<view class="figma-page archive-page">
  <view class="figma-page__content figma-page__content--actions">
    <view class="figma-summary figma-summary--navy"><view class="figma-summary__icon"><figma-icon name="team-archive" size="{{25}}"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">{{archive ? '公开档案' : '公开跨届榜单'}}</view><view class="figma-title">{{archive ? archive.displayName : (kind==='PLAYER' ? '球员公开档案' : '球队公开档案')}}</view><view class="figma-subtitle">{{archive ? (archive.locationLabel ? archive.locationLabel + '   获准公开的跨届记录' : '仅统计当前有效的跨届授权记录') : '独立公开授权 · 当前有效来源'}}</view></view></view>
    <view class="archive-tabs"><button class="archive-tab {{archive || kind==='PLAYER' ? 'is-active' : ''}}" data-kind="PLAYER" bindtap="kind" disabled="{{!!archive}}">{{archive ? '公开主页' : '球员'}}</button><button class="archive-tab {{!archive && kind==='TEAM' ? 'is-active' : ''}}" bindtap="secondaryTab">{{archive ? '跨届榜单' : '球队'}}</button></view>
    <view wx:if="{{loading}}" class="figma-section"><figma-skeleton rows="{{5}}"/></view>
    <figma-feedback wx:if="{{error}}" type="error" title="公开档案读取失败" body="{{error}}" action-label="重新读取" bind:action="load"/>
    <block wx:if="{{archive}}">
      <view class="figma-section"><view class="figma-section__title">确认样本</view><view class="archive-metrics"><view><text>{{archive.confirmedMatchCount}} 场</text><view>有效授权场次</view></view><view><text>{{archive.sourceEventCount===undefined ? archive.recordedMatchCount : archive.sourceEventCount}}{{archive.sourceEventCount===undefined ? '' : ' 届'}}</text><view>{{archive.sourceEventCount===undefined ? '统计样本' : '来源赛事'}}</view></view></view></view>
      <view class="figma-section"><view class="figma-section__title">授权有效记录</view><figma-feedback wx:if="{{!archive.recentRecords.length}}" type="empty" title="暂无当前有效的授权确认样本" body="这里只显示当前授权有效的确认记录。"/><view wx:for="{{archive.recentRecords}}" wx:key="recordKey" class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{item.displayName || item.eventName}}</view><view class="figma-row__subtitle">{{item.summaryLabel || (item.date + ' · 得分 ' + (item.points===null ? '未采集' : item.points) + ' · 犯规 ' + (item.fouls===null ? '未知' : item.fouls))}}</view></view><view class="figma-status figma-status--green">已确认</view></view></view>
      <view class="figma-section"><view class="figma-section__title">数据覆盖</view><view class="archive-notice"><view class="archive-notice__mark"/><view class="figma-row__copy"><view class="figma-row__title">长期记录</view><view class="figma-row__subtitle">仅显示当前有效的授权来源</view></view></view><view class="archive-notice"><view class="archive-notice__mark"/><view class="figma-row__copy"><view class="figma-row__title">专业统计</view><view class="figma-row__subtitle">{{archive.technical ? '按明确采集样本统计' : '未启用或未授权时保持未知'}}</view></view></view></view>
      <view class="figma-section"><view class="figma-section__title">公开统计</view><view class="stats-grid"><view>累计得分 {{archive.points===null ? '未统计' : archive.points}}</view><view>样本场均 {{archive.pointsPerRecordedMatch===null ? '未统计' : archive.pointsPerRecordedMatch}}</view><view>犯规 {{archive.fouls===null ? '未统计' : archive.fouls}}</view><view wx:if="{{archive.kind==='TEAM'}}">胜 {{archive.wins}} · 平 {{archive.draws}} · 负 {{archive.losses}}</view></view><view wx:if="{{archive.points===null}}" class="figma-caption">未采集个人得分；没有样本时不推算。</view></view>
      <view class="figma-section"><view class="figma-section__title">专业数据覆盖</view><view wx:if="{{archive.technical}}" class="stats-grid"><view>样本 {{archive.technical.sampledMatchCount}} 场</view><view>明确记录 {{archive.technical.appearedMatchCount}} 场</view><view>投篮 {{archive.technical.fieldGoalsMade}}/{{archive.technical.fieldGoalsAttempted}}</view><view>三分 {{archive.technical.threePointersMade}}/{{archive.technical.threePointersAttempted}}</view><view>罚球 {{archive.technical.freeThrowsMade}}/{{archive.technical.freeThrowsAttempted}}</view><view>篮板 {{archive.technical.rebounds}}</view><view>助攻 {{archive.technical.assists}}</view><view>抢断 {{archive.technical.steals}}</view></view><figma-feedback wx:else type="empty" title="暂无专业采集" body="未启用或未授权专业采集，专业数据保持未知。"/></view>
    </block>
    <block wx:else>
      <figma-feedback wx:if="{{!loading && !entries.length && !error}}" type="empty" title="暂无公开档案" body="当前没有同时满足独立授权和有效统计条件的档案。"/>
      <button wx:for="{{entries}}" wx:key="key" class="ranking-card" data-key="{{item.archive.publicKey}}" bindtap="open"><view class="ranking-card__rank">{{item.rank}}</view><view class="ranking-card__copy"><view class="figma-row__title">{{item.archive.displayName}}</view><view class="figma-row__subtitle">场均 {{item.archive.pointsPerRecordedMatch}} · 总分 {{item.archive.points}} · {{item.archive.recordedMatchCount}} 场样本</view></view><figma-icon name="stats" size="{{20}}"/></button>
    </block>
    <figma-feedback wx:if="{{notice}}" type="pending" title="数据范围说明" body="{{notice}}"/>
  </view>
  <view class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="load" disabled="{{loading}}">重新读取</button><button class="figma-action figma-action--orange" bindtap="rankings">查看公开跨届榜单</button></view>
</view>
