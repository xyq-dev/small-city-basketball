@import "../../styles/figma-pages.wxss";

.account-row{display:flex;min-height:56px;align-items:center;gap:10px}.account-avatar{display:flex;width:44px;height:44px;flex:none;align-items:center;justify-content:center;border-radius:50%;background:#123c73;color:#fff;font-size:16px;font-weight:700}.section-primary{display:flex;width:100%;min-height:48px;align-items:center;justify-content:center;margin:0;padding:0 12px;border:0;border-radius:24px;background:#123c73;color:#fff;font-size:16px}.section-primary::after{border:0}
.invitation-tabs{display:grid;height:48px;padding:2px 3px;grid-template-columns:repeat(2,minmax(0,1fr));border-radius:12px;background:#fff}.invitation-tab{display:flex;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 8px;border:0;border-radius:10px;background:transparent;color:#51657d;font-size:13px}.invitation-tab.is-active{background:#123c73;color:#fff;font-weight:700}.invitation-tab::after{border:0}.invitation-row{display:flex;width:100%;min-height:55px;align-items:center;gap:8px}.invitation-row+.invitation-row{border-top:1px solid #e6ebf2}.invitation-notice{display:flex;width:100%;min-height:55px;align-items:center;gap:8px;padding:0 10px;border-radius:8px;background:#eaf2fc}.invitation-notice__mark{width:7px;height:7px;flex:none;border-radius:4px;background:#123c73}
.invitation-page .invitation-tabs>.invitation-tab{width:100%;min-width:0;max-width:none;justify-self:stretch;box-sizing:border-box}
