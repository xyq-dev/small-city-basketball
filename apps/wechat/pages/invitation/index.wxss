.invitation-page { padding-bottom:calc(164px + env(safe-area-inset-bottom)); }
.invitation-page > .fig-summary { margin-bottom:12px; }
.invitation-panel { padding:14px; border:0; border-radius:16px; margin-bottom:12px; box-shadow:none; }
.identity-summary .fig-summary-mark { order:-1; width:44px; height:44px; border-radius:12px; background:#eaf2fc; }
.identity-summary .fig-summary-mark image { width:25px; height:25px; }
.identity-summary .fig-summary-title { color:#18283f; font-size:18px; line-height:26px; }
.identity-summary .fig-kicker,.identity-summary .fig-summary-sub { color:#63758b; }
.invitation-tabs { display:flex; gap:1px; margin-bottom:12px; padding:2px 3px; border-radius:12px; background:#fff; }
.invitation-tabs > view { flex:1; min-height:40px; padding:10px 4px; border-radius:10px; color:#63758b; font-size:13px; line-height:20px; text-align:center; }
.invitation-tabs > view.selected { color:#fff; background:#123c73; font-weight:700; }
.invitation-page .field { border:0; border-radius:8px; background:#f4f6fa; font-size:14px; line-height:22px; }
.invitation-summary { display:flex; flex-direction:column; gap:16px; }
.invitation-summary .subtitle { margin:0; }
.account-identity { display:flex; align-items:center; gap:12px; font-weight:500; }
.account-identity > view:last-child { min-width:0; overflow-wrap:anywhere; }
.account-avatar { width:40px; height:40px; border-radius:50%; background:#eaf0f8; display:flex; align-items:center; justify-content:center; color:#123c73; flex-shrink:0; }
.invite-details { display:flex; flex-direction:column; gap:20px; }
.detail-row { display:flex; gap:12px; font-weight:500; }
.detail-row > view { min-width:0; }
.detail-row .muted { margin-top:4px; font-weight:400; }
.detail-dot { color:#f28c28; flex:0 0 14px; }
.feedback-title { font-size:14px; line-height:24px; font-weight:500; margin-bottom:4px; }
.invite-form .field-label { margin-top:20px; color:#18283f; }
.secret-note { margin:8px 0 20px; }
.invite-action { margin:20px 0; }
.state-panel .muted { margin:8px 0 16px; }
.skeleton-line { height:12px; border-radius:4px; background:#eaf0f8; margin-top:8px; }
.skeleton-line.short { width:78%; }
