<scb-header title="球员详情" disabled="{{loading}}"/>
<view class="scb-ui-page figma-page player-rebuild">
  <view class="figma-page__content figma-page__content--actions">
    <figma-skeleton wx:if="{{loading}}" rows="4"/>
    <figma-feedback wx:if="{{loginRequired}}" type="permission" title="请登录后继续" body="登录后查看当前可预约的服务资料与有限授权记录。" action-label="登录并返回" bind:action="login"/>
    <figma-feedback wx:if="{{error && !loginRequired}}" type="error" title="暂时无法展示球员资料" body="{{error}}" action-label="重新读取" bind:action="load"/>
    <figma-feedback wx:if="{{!profile && !loading && !loginRequired && !error}}" type="empty" title="暂未读取到球员资料" body="档案停用或访问条件变化后，需要重新核对当前目录。" action-label="返回球员目录" bind:action="market"/>

    <block wx:if="{{profile}}">
      <figma-feedback wx:if="{{statisticsError}}" type="error" title="统计暂时无法读取" body="{{statisticsError}}；旧统计已清除。"/>
      <view class="figma-summary figma-summary--navy">
        <view class="figma-summary__copy"><view class="figma-eyebrow">球员服务档案</view><view class="figma-title">{{profile.name}}</view><view class="figma-subtitle">{{profile.city}} · {{profile.position}}，档期与报价以提交预约时的记录为准。</view></view>
        <image wx:if="{{profile.portrait}}" class="player-summary__image" src="{{profile.portrait}}" mode="aspectFill" aria-label="球员公开头像"/>
      </view>

      <view class="player-tabs" role="tablist">
        <button class="player-tab {{activeTab === 'SERVICE' ? 'is-active' : ''}}" data-tab="SERVICE" bindtap="changeTab">服务</button>
        <button class="player-tab {{activeTab === 'AVAILABILITY' ? 'is-active' : ''}}" data-tab="AVAILABILITY" bindtap="changeTab">档期</button>
        <button class="player-tab {{activeTab === 'RECORDS' ? 'is-active' : ''}}" data-tab="RECORDS" bindtap="changeTab">有限记录</button>
      </view>

      <block wx:if="{{activeTab !== 'RECORDS'}}">
        <view class="figma-section">
          <view class="figma-section__title">可约时间</view>
          <view wx:if="{{!windows.length}}" class="figma-caption">暂无公开可约窗口，请先核对档期。</view>
          <view wx:for="{{windows}}" wx:key="id" class="figma-row"><figma-icon name="schedule" size="20"/><view class="figma-row__copy"><view class="figma-row__title">{{item.dateLabel || item.display || item.start}}</view><view class="figma-row__subtitle" wx:if="{{item.timeLabel || !item.display}}">{{item.timeLabel || ('至 ' + item.end)}}</view></view><view class="figma-status figma-status--orange">可查询</view></view>
        </view>

        <view class="figma-section">
          <view class="figma-section__title">单场报价</view>
          <view class="fee-row"><view><view class="figma-row__title">参赛服务费</view><view class="figma-row__subtitle">一场</view></view><view class="fee-value">{{profile.priceLabel || profile.price}}</view></view>
          <view class="fee-row"><view><view class="figma-row__title">平台服务费</view><view class="figma-row__subtitle">按本次费率预计</view></view><view class="fee-value">{{profile.platformFeeLabel || profile.platformFee}}</view></view>
          <view class="fee-row"><view><view class="figma-row__title">交通与食宿</view><view class="figma-row__subtitle">按本人当前报价</view></view><view class="fee-value">{{profile.travelAccommodationLabel || (profile.travel + ' + ' + profile.accommodation)}}</view></view>
        </view>

        <view class="figma-section">
          <view class="figma-section__title">授权比赛数据</view>
          <view class="metrics-grid">
            <view class="metric-card"><view class="metric-value">{{profile.performance.sample}}</view><view class="figma-caption">个人统计样本</view><view class="figma-status figma-status--orange">{{profile.performance.sourceCount ? '已授权' : '未统计'}}</view></view>
            <view class="metric-card"><view class="metric-value">{{profile.performance.services}}</view><view class="figma-caption">完成服务记录</view><view class="figma-status figma-status--orange">履约</view></view>
            <view class="metric-card"><view class="metric-value">未统计</view><view class="figma-caption">篮板、助攻、上场时间</view><view class="figma-status">未采集</view></view>
          </view>
          <button class="figma-row" bindtap="informationToggle"><view class="figma-row__copy"><view class="figma-row__title">费用与数据来源说明</view><view class="figma-row__subtitle">{{informationOpen ? '收起说明' : '查看统计时间与完整度'}}</view></view><view class="figma-status">{{informationOpen ? '收起' : '展开'}}</view></button>
          <block wx:if="{{informationOpen}}">
            <view class="figma-caption">{{profile.performance.source}} · {{profile.performance.completeness}} · 截至 {{asOfText || '本次读取'}}。未采集项目显示“未统计”，不以 0 代替。</view>
            <view class="figma-caption">{{profile.performance.denominator}}</view>
            <view class="figma-caption">完成服务 {{profile.performance.services}} 次，不代表付费成交；最终按预约报价快照核对。</view>
          </block>
          <button class="figma-row" bindtap="toggle" disabled="{{loading}}"><view class="figma-row__copy"><view class="figma-row__title">同价对比名单</view><view class="figma-row__subtitle">当前已选 {{selectedCount}} 位</view></view><view class="figma-status figma-status--orange">{{selected ? '移出' : '加入'}}</view></button>
          <button wx:if="{{selectedCount >= 2}}" class="figma-action figma-action--ghost" bindtap="compare">查看同价对比</button>
        </view>
      </block>

      <block wx:else>
        <view class="figma-section">
          <view class="figma-section__title">近期记录与来源</view>
          <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">统计样本</view><view class="figma-row__subtitle">{{profile.performance.sample}} 场 · {{profile.performance.status}}</view></view><view class="figma-status figma-status--orange">有限公开</view></view>
          <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">本人得分与犯规</view><view class="figma-row__subtitle">每场 {{profile.performance.points}} 分 / {{profile.performance.fouls}} 犯规</view></view><view class="figma-status">{{profile.performance.completeness}}</view></view>
          <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">完成服务记录</view><view class="figma-row__subtitle">{{profile.performance.services}} 次 · {{profile.performance.source}}</view></view></view>
          <view wx:for="{{profile.performance.records}}" wx:key="id" class="figma-row">
            <view class="figma-row__copy"><view class="figma-row__title">{{item.eventName}}</view><view class="figma-row__subtitle">{{item.date}} · {{item.format}} · 得分 {{item.points}} / 犯规 {{item.fouls}}</view><view class="figma-caption">{{item.note}}</view></view>
          </view>
          <view wx:if="{{!profile.performance.records || !profile.performance.records.length}}" class="figma-caption">暂无当前有效的个人近期记录。</view>
          <view class="figma-caption">{{profile.performance.denominator}}</view>
          <view wx:if="{{asOfText}}" class="figma-caption">统计截至 {{asOfText}}（北京时间）</view>
          <view class="figma-caption">授权来源 {{profile.performance.sourceCount}} · 仅球队记录 {{profile.performance.teamOnly}} · 待确认 {{profile.performance.pending}} · 无法核验 {{profile.performance.invalid}}</view>
          <view class="figma-caption">篮板、助攻、上场时间等未采集项目不会生成综合战力分、胜率或准时率。</view>
        </view>
      </block>
    </block>
  </view>

  <view class="figma-fixed-actions">
    <block wx:if="{{profile}}">
      <button class="figma-action figma-action--ghost" bindtap="load" disabled="{{loading}}">刷新服务档案</button>
      <button class="figma-action figma-action--orange" bindtap="book" disabled="{{loading}}">发起预约</button>
    </block>
    <block wx:elif="{{loginRequired}}">
      <button class="figma-action figma-action--ghost" bindtap="market" disabled="{{loading}}">返回球员目录</button>
      <button class="figma-action figma-action--orange" bindtap="login" disabled="{{loading}}">登录并返回</button>
    </block>
    <block wx:else>
      <button class="figma-action figma-action--ghost" bindtap="market" disabled="{{loading}}">返回球员目录</button>
      <button class="figma-action figma-action--orange" bindtap="load" disabled="{{loading}}">{{loading ? '正在读取…' : '重新读取'}}</button>
    </block>
  </view>
</view>
