<view class="page has-actions">
  <view wx:if="{{loading}}" class="card empty">正在核对球员与授权记录…</view>
  <view wx:if="{{loginRequired}}" class="card empty"><view class="subtitle">请登录后继续</view><button class="primary" bindtap="login">登录并返回球员详情</button></view>
  <view wx:if="{{error}}" class="notice danger" role="alert">{{error}}</view>
  <view wx:if="{{!profile && !loading && !loginRequired}}" class="card"><button class="secondary" bindtap="market">返回球员广场</button><button class="quiet" bindtap="load">重新读取资料</button></view>
  <block wx:if="{{profile}}">
    <view class="hero profile-hero"><view class="title">{{profile.name}}</view><view>{{profile.position}} · {{profile.height}}cm · {{profile.city}}</view><view class="small">服务资料由本人填写</view></view>
    <view class="card">
      <view class="subtitle">参赛服务报价</view>
      <view class="quote-row"><text>参赛服务费</text><text class="quote-amount">{{profile.price}} / 场</text></view>
      <view class="quote-row"><text>当前平台费估算</text><text>{{profile.platformFee}}</text></view>
      <view class="quote-row"><text>交通 / 食宿</text><text>{{profile.travel}} / {{profile.accommodation}}</text></view>
      <view class="quote-row total"><text>预计合计</text><text>{{profile.total}}</text></view>
      <view class="muted small">最终以提交预约时核对的报价快照为准；在线支付未开放。</view>
    </view>
    <view wx:if="{{statisticsError}}" class="notice warning">统计暂时无法读取：{{statisticsError}}。已清除旧统计，可重新读取。</view>
    <view class="card">
      <view class="row-between"><view class="subtitle">每场记录</view><view class="badge">{{profile.performance.status}}</view></view>
      <view class="stat-grid">
        <view class="stat"><view class="stat-value">{{profile.performance.points}}</view><view class="muted small">每场记录得分</view></view>
        <view class="stat"><view class="stat-value">{{profile.performance.fouls}}</view><view class="muted small">每场记录犯规</view></view>
        <view class="stat"><view class="stat-value">{{profile.performance.sample}}</view><view class="muted small">个人统计样本</view></view>
        <view class="stat"><view class="stat-value">{{profile.performance.services}}</view><view class="muted small">完成服务记录</view></view>
      </view>
      <view class="muted small">{{profile.performance.denominator}}</view>
      <view class="muted small">完成服务不代表付费成交；缺少样本不代表球员能力差。</view>
      <button class="secondary" bindtap="recordsToggle">{{recordsOpen ? '收起近期记录与来源' : '查看近期记录与来源'}}</button>
    </view>
    <view wx:if="{{recordsOpen}}" class="card records">
      <view class="subtitle">有限授权记录</view>
      <view class="muted">{{profile.performance.completeness}}</view>
      <view wx:if="{{asOfText}}" class="muted small">统计截至 {{asOfText}}（北京时间）</view>
      <view class="small">授权来源 {{profile.performance.sourceCount}} · 仅球队记录 {{profile.performance.teamOnly}} · 待确认 {{profile.performance.pending}}</view>
      <view class="small">个人归属未完整 {{profile.performance.partial}} · 无法核验 {{profile.performance.invalid}}</view>
      <view wx:if="{{profile.performance.truncated}}" class="notice warning">仅汇总最新1000项授权样本，较早记录未纳入当前均值，不代表全部生涯数据。</view>
      <view wx:if="{{!profile.performance.records.length}}" class="empty muted">暂无当前有效的个人近期记录。</view>
      <view wx:for="{{profile.performance.records}}" wx:key="id" class="record-item">
        <view class="section-title">{{item.eventName}}</view><view class="muted small">{{item.date}} · {{item.format}} · 当前有效独立确认</view>
        <view class="record-score">得分 {{item.points}} / 犯规 {{item.fouls}}</view><view class="muted small">{{item.note}}</view>
      </view>
      <view class="muted small">最多显示最近5条。来源撤销或赛果重开后，下次读取不再纳入旧记录。</view>
      <button class="secondary" bindtap="load" disabled="{{loading}}">刷新统计与资料</button>
    </view>
    <view class="card"><view class="subtitle">尚未采集的项目</view><view class="muted">篮板、助攻、上场时间和命中率：未统计。不估算能力总分、胜率或准时率。</view></view>
    <view class="card"><view class="subtitle">本人填写的服务介绍</view><view class="bio">{{profile.bio || '暂无服务介绍'}}</view><view class="muted small">入驻资料审核不代表实力、实名或本场资格认证。</view></view>
    <view class="card"><view class="subtitle">可约时间</view><view wx:if="{{!windows.length}}" class="muted">暂无公开可约窗口，请先核对档期。</view><view wx:for="{{windows}}" wx:key="id" class="row"><view>{{item.start}}</view><view class="muted">至 {{item.end}}</view></view><view class="muted small">北京时间；接单时再次核验安排与30分钟交通缓冲，不保证已经锁定档期。</view></view>
    <view class="notice">预约不自动加入赛事名单；参赛资格、外援限制与保险仍需主办方核验。</view>
  </block>
  <view class="action-bar">
    <button class="primary" bindtap="book" disabled="{{loading || !profile}}">预约这位球员</button>
    <view class="compare-actions"><button class="quiet" bindtap="toggle" disabled="{{loading || !profile}}">{{selected ? '移出对比' : '加入同价对比'}}</button><button class="quiet" bindtap="compare" disabled="{{loading || !profile}}">对比 {{selectedCount}}/3</button></view>
  </view>
</view>
