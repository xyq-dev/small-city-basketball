@import "../../styles/figma-pages.wxss";

.player-summary__image { width:128px; height:80px; flex:none; border-radius:10px; background:#eaf2fc; }
.player-tabs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1px; width:100%; height:48px; padding:2px 3px; border-radius:12px; background:#fff; }
.player-tab { display:flex; height:44px; align-items:center; justify-content:center; border-radius:10px; color:#51657d; font-size:13px; }
.player-tab.is-active { background:#123c73; color:#fff; font-weight:700; }
.player-rebuild .player-tabs>button.player-tab { width:100%; min-width:0; max-width:none; height:44px; min-height:44px; margin:0; padding:0 4px; border:0; justify-self:stretch; box-sizing:border-box; background:transparent; }
.player-rebuild .player-tabs>button.player-tab.is-active { background:#123c73; color:#fff; }
.fee-row { display:flex; min-height:64px; align-items:center; justify-content:space-between; gap:12px; border-bottom:1px solid #e6ebf2; }
.fee-row:last-child { border-bottom:0; }
.fee-value { flex:none; color:#123c73; font-size:16px; font-weight:700; line-height:24px; text-align:right; }
.metrics-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }
.metric-card { display:flex; min-width:0; min-height:112px; flex-direction:column; gap:4px; padding:10px; border-radius:10px; background:#f4f6fa; }
.metric-value { color:#123c73; font-size:21px; font-weight:700; line-height:30px; overflow-wrap:anywhere; }
@media (max-width:360px) { .player-summary__image { display:none; } .metrics-grid { grid-template-columns:1fr; } .metric-card { min-height:84px; } }
