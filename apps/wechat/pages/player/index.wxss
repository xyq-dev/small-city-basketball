.profile-hero { display:flex; flex-direction:column; gap:12px; padding:24px; }
.profile-hero .title { margin:0; }
.profile-meta { font-size:14px; line-height:24px; }
.profile-card { display:flex; flex-direction:column; gap:8px; }
.profile-card .subtitle { margin:0; }
.profile-copy { color:#617286; font-size:14px; line-height:24px; }
.profile-records-toggle { margin-bottom:16px; }
.quote-note { margin-top:0; }
.record-item { padding:16px 0; border-top:1px solid #e8edf2; margin-top:12px; }
.record-name { color:#132c49; font-size:18px; line-height:28px; font-weight:500; }
.record-score { margin:8px 0; color:#132c49; font-size:18px; line-height:28px; font-weight:500; }
.records > view { margin-bottom:8px; }
.records .subtitle { margin-bottom:8px; }
.window-row { padding:8px 0; border-bottom:1px solid #e8edf2; }
.window-row:last-of-type { border-bottom:0; }
.compare-actions { display:flex; gap:8px; }
.compare-actions button { flex:1; min-width:0; margin:0; }
.bio { white-space:pre-wrap; overflow-wrap:anywhere; }
.state-card .muted { font-size:14px; line-height:24px; }
.state-card button { margin-top:16px; margin-bottom:0; }

.records-stats { gap:12px; }
.records-stats .stat { padding:16px; border-radius:16px; }
.stat-value { color:#132c49; font-family:Inter,Arial,sans-serif; font-size:34px; line-height:44px; font-weight:600; margin-bottom:4px; }
.record-card { display:flex; flex-direction:column; gap:8px; }
.record-card .record-score { margin:0; }
.notice-title { font-size:14px; line-height:24px; font-weight:500; margin-bottom:4px; }
