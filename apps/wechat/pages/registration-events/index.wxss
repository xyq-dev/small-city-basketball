@import "../../styles/figma-pages.wxss";

.registration-hero{display:flex;width:100%;height:128px;overflow:hidden;border-radius:16px;background:#123c73;color:#fff}.registration-hero__copy{display:flex;min-width:0;flex:1;padding:16px;flex-direction:column;justify-content:center}.registration-hero .figma-eyebrow{color:#dce7f5}.registration-hero__title{font-size:18px;font-weight:700;line-height:26px;overflow-wrap:anywhere}.registration-hero__subtitle{margin-top:4px;color:#dce7f5;font-size:12px;line-height:17px}.registration-hero image{width:128px;height:128px;flex:none}.profile-head{display:flex;min-height:44px;align-items:center;justify-content:space-between;gap:8px}.charge-row{display:flex;padding:10px 0;flex-direction:column;gap:5px;border-top:1px solid #e6ebf2}.charge-terms{color:#51657d;font-size:12px;line-height:18px;white-space:pre-wrap}.event-card{overflow:hidden;width:100%;border-radius:16px;background:#fff}.event-card__image{position:relative;width:100%;height:96px}.event-card__image image{width:100%;height:96px}.event-card__image .figma-status{position:absolute;right:10px;bottom:10px}.event-card__body{display:flex;padding:12px 14px 14px;flex-direction:column;gap:8px}.event-card__name{font-size:17px;font-weight:700;line-height:24px;overflow-wrap:anywhere}.entry-status{display:flex;flex-direction:column;gap:4px}.section-primary,.section-ghost{display:flex;width:100%;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 12px;border-radius:22px;font-size:14px}.section-primary{border:0;background:#123c73;color:#fff}.section-ghost{border:1px solid #7c8ea5;background:#fff;color:#123c73}.section-primary::after,.section-ghost::after{border:0}.step-no{display:flex;width:28px;height:28px;flex:none;align-items:center;justify-content:center;border-radius:50%;background:#eaf2fc;color:#123c73;font-size:12px;font-weight:700}@media(max-width:360px){.registration-hero image{width:104px}.registration-hero__copy{padding:12px}}
.registration-hero{height:auto;min-height:108px;align-items:center;padding:14px}.registration-hero__copy{padding:0 12px 0 0}.registration-hero__title{font-size:21px;line-height:30px}.registration-hero image{width:128px;height:80px;border-radius:10px}.registration-tabs{display:grid;height:48px;padding:2px 3px;grid-template-columns:repeat(2,minmax(0,1fr));border-radius:12px;background:#fff}.registration-tab{display:flex;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 8px;border:0;border-radius:10px;background:transparent;color:#51657d;font-size:13px}.registration-tab.is-active{background:#123c73;color:#fff;font-weight:700}.registration-row{display:flex;width:100%;min-height:55px;align-items:center;gap:8px;margin:0;padding:0;border:0;background:transparent;color:#18283f;text-align:left}.registration-row+.registration-row{border-top:1px solid #e6ebf2}.registration-step{display:flex;width:100%;min-height:55px;align-items:center;gap:8px}.registration-step+.registration-step{border-top:1px solid #e6ebf2}.registration-tab::after,.registration-row::after{border:0}@media(max-width:360px){.registration-hero{padding:12px}.registration-hero image{width:104px}.registration-hero__title{font-size:18px;line-height:26px}}
.registration-page .registration-tabs>.registration-tab{width:100%;min-width:0;max-width:none;justify-self:stretch;box-sizing:border-box}
