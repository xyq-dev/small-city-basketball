.registration-page { padding-bottom:calc(164px + env(safe-area-inset-bottom)); }
.registration-page > .fig-summary { margin-bottom:12px; }
.registration-summary-image { overflow:hidden; background:#eaf2fc; }
.registration-summary-image image { width:100%; height:100%; border-radius:10px; }
.registration-tabs { display:flex; gap:1px; margin-bottom:12px; padding:2px 3px; border-radius:12px; background:#fff; }
.registration-tabs > view { flex:1; min-height:40px; padding:10px 4px; border-radius:10px; color:#63758b; font-size:13px; line-height:20px; text-align:center; }
.registration-tabs > view.selected { color:#fff; background:#123c73; font-weight:700; }
.event-panel { padding:14px; border:0; border-radius:16px; margin-bottom:0; background:#fff; }
.event-card { position:relative; display:flex; flex-direction:column; gap:8px; margin-bottom:12px; box-shadow:none; }
.event-card .subtitle,.event-card button,.event-card .notice { margin:0; }
.event-card .badge { margin:0; align-self:flex-start; padding:4px 20px; }
.event-name { padding-right:78px; font-size:14px; line-height:20px; font-weight:700; }
.event-card > .badge { position:absolute; top:14px; right:14px; }
.feedback-title { font-size:14px; font-weight:500; margin-bottom:4px; }
.registration-guide { display:flex; flex-direction:column; gap:12px; }
.guide-row { display:flex; align-items:flex-start; gap:12px; font-weight:500; }
.guide-row > view { min-width:0; }
.guide-row .muted { margin-top:4px; font-weight:400; }
.guide-dot { color:#f28c28; flex:0 0 14px; }
.guide-step { flex:0 0 20px; width:20px; height:20px; border-radius:10px; color:#123c73; background:#eaf2fc; font-size:11px; line-height:20px; text-align:center; }
.state-panel .muted { margin:8px 0 16px; }
.skeleton-line { height:12px; border-radius:4px; background:#eaf0f8; margin-top:8px; }
.skeleton-line.short { width:78%; }
.charge-panel,.charge-item { display:flex; flex-direction:column; gap:12px; font-size:16px; line-height:1.6; }
.charge-item { border-top:1px solid #e1e7ef; padding-top:16px; margin-top:12px; }
.charge-terms { white-space:pre-wrap; overflow-wrap:anywhere; }
.charge-panel .consent { min-height:44px; margin:16px 0; }
@media(max-width:360px) { .registration-summary .fig-summary-mark { width:104px; height:64px; } }
