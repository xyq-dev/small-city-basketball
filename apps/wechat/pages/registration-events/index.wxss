.registration-page { padding-bottom:calc(92px + env(safe-area-inset-bottom)); }
.event-panel { padding:24px; border:1px solid #e8edf2; border-radius:12px; margin-bottom:20px; }
.event-card { display:flex; flex-direction:column; gap:16px; }
.event-card .subtitle,.event-card button,.event-card .notice { margin:0; }
.event-card .badge { margin:0; align-self:flex-start; padding:4px 20px; }
.event-name { font-size:22px; line-height:34px; font-weight:700; }
.feedback-title { font-size:14px; font-weight:500; margin-bottom:4px; }
.registration-guide { display:flex; flex-direction:column; gap:20px; }
.guide-row { display:flex; align-items:flex-start; gap:12px; font-weight:500; }
.guide-row > view { min-width:0; }
.guide-row .muted { margin-top:4px; font-weight:400; }
.guide-dot { color:#ff6b2d; flex:0 0 14px; }
.state-panel .muted { margin:8px 0 16px; }
.skeleton-line { height:12px; border-radius:4px; background:#eaf0f7; margin-top:8px; }
.skeleton-line.short { width:78%; }
