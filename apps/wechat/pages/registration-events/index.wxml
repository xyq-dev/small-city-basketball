<scb-header title="可报名赛事" disabled="{{busy || !!chargeDraft}}"/>
<view class="figma-page registration-page">
  <view class="figma-page__content figma-page__content--actions">
    <view class="registration-hero"><view class="registration-hero__copy"><view class="figma-eyebrow">球队报名</view><view class="registration-hero__title">{{team ? team.name : '可报名赛事'}}</view><view class="registration-hero__subtitle">只显示当前账号可管理球队的报名范围</view></view><image src="/assets/home/event-court.jpg" mode="aspectFill"/></view>
    <view class="registration-tabs"><button class="registration-tab is-active">可报名</button><button class="registration-tab" bindtap="openDraft">已有报名</button></view>
    <figma-feedback wx:if="{{error}}" type="error" title="暂时无法读取可报名赛事" body="{{error}}" action-label="重新读取" bind:action="load"/>
    <figma-feedback wx:if="{{message}}" type="pending" title="报名状态提示" body="{{message}}"/>
    <figma-feedback wx:if="{{loginRequired}}" type="empty" title="登录后继续本队报名" body="只展示当前账号可管理的报名范围。" action-label="登录并继续" bind:action="login"/>
    <view wx:if="{{loading}}" class="figma-section"><figma-skeleton rows="{{5}}"/></view>

    <view wx:if="{{chargeDraft}}" class="figma-section charge-section"><view class="figma-section__title">先核对本届收费条款</view><view class="figma-section__hint">{{chargeDraft.eventName}} · 为 {{team.name}} 创建报名草稿</view><view wx:for="{{chargeDraft.items}}" wx:key="kind" class="charge-row"><view class="profile-head"><view class="figma-row__title">{{item.kindLabel}}</view><view class="figma-status figma-status--orange">{{item.amountLabel}} 元</view></view><view class="figma-row__subtitle">收费主体：{{item.merchantName}}</view><view class="figma-row__title">{{item.title}}</view><text class="charge-terms" selectable="true">{{item.terms}}</text></view><figma-feedback type="pending" title="创建不等于付款或获批" body="创建草稿会绑定以上条款；支付和报名审核仍分别办理。"/><checkbox-group bindchange="chargeAgree"><label class="figma-check"><checkbox value="yes" checked="{{chargeAccepted}}" disabled="{{busy}}"/>我已核对收费主体、金额及每项条款，明确同意本次约定</label></checkbox-group><button class="section-primary" bindtap="confirmCharge" disabled="{{busy || !chargeAccepted}}" loading="{{busy}}">同意条款并创建报名草稿</button><button class="section-ghost" bindtap="cancelCharge" disabled="{{busy}}">暂不接受，返回赛事列表</button></view>

    <view class="figma-section"><view class="figma-section__title">近期开放</view><block wx:for="{{events}}" wx:key="id"><button wx:if="{{!item.entry}}" class="registration-row" data-id="{{item.event.id}}" bindtap="enter" disabled="{{busy || !!chargeDraft || !item.capabilities.canCreateEntry}}"><figma-icon name="schedule" size="{{20}}"/><view class="figma-row__copy"><view class="figma-row__title">{{item.event.name}}</view><view class="figma-row__subtitle">{{item.event.startDate}} 截止 · {{item.event.venueName || '场馆以赛事公布为准'}}</view></view><view class="figma-status figma-status--orange">{{item.capabilities.canCreateEntry ? '报名中' : item.statusLabel}}</view></button></block><figma-feedback wx:if="{{!loading && !events.length && !loginRequired && !error}}" type="empty" title="暂无可报名赛事" body="请等待主办方开放报名，或刷新本队已有报名。"/></view>
    <view id="registration-check" class="figma-section"><view class="figma-section__title">报名前核对</view><view class="registration-step"><view class="step-no">1</view><view class="figma-row__copy"><view class="figma-row__title">查看本届规程</view><view class="figma-row__subtitle">查阅人数与资格规则</view></view></view><view class="registration-step"><view class="step-no">2</view><view class="figma-row__copy"><view class="figma-row__title">核对收费条款</view><view class="figma-row__subtitle">按本届公布条款</view></view></view><view class="registration-step"><view class="step-no">3</view><view class="figma-row__copy"><view class="figma-row__title">创建本队草稿</view><view class="figma-row__subtitle">由领队保存本届名单</view></view></view></view>
    <view class="figma-section"><view class="figma-section__title">已有报名</view><block wx:for="{{events}}" wx:key="id"><button wx:if="{{item.entry}}" class="registration-row" data-id="{{item.event.id}}" bindtap="enter" disabled="{{busy}}"><view class="figma-row__copy"><view class="figma-row__title">{{item.event.name}}</view><view class="figma-row__subtitle">{{team.name}} · 本届名单</view></view><view class="figma-status figma-status--orange">{{item.entryStatus}}</view></button></block><figma-feedback wx:if="{{!hasDraft && !loading}}" type="empty" title="暂无本队草稿" body="从可报名赛事创建后在这里继续填写。"/></view>
    <button wx:if="{{nextCursor}}" class="section-ghost" bindtap="more" disabled="{{loading || busy}}">加载更多赛事</button>
  </view>
  <view class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="openDraft" disabled="{{loading || busy || !hasDraft}}">查看本队草稿</button><button class="figma-action figma-action--orange" bindtap="showRequirements" disabled="{{loading || busy}}">查看本届报名要求</button></view>
</view>
