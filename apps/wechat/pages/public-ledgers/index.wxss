.page {
  padding: 24rpx;
}
.card {
  padding: 24rpx;
  background: #fff;
  margin: 20rpx 0;
  border-radius: 20rpx;
  overflow-wrap: anywhere;
}
.title {
  font-size: 38rpx;
  font-weight: 700;
}
.subtitle {
  font-weight: 600;
  margin: 18rpx 0;
}
.notice {
  padding: 18rpx;
  background: #f1f4f8;
}
.warning {
  color: #933;
}
.small {
  font-size: 24rpx;
}
.muted {
  color: #657184;
}
.entry {
  padding: 18rpx 0;
  border-bottom: 1px solid #e3e8ef;
}
.picker,
input {
  padding: 18rpx;
  background: #f5f7fa;
  margin: 12rpx 0;
}
textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f5f7fa;
  padding: 16rpx;
  font-size: 16px;
  line-height: 24px;
  min-height: 96px;
}
input {
  font-size: 16px;
  line-height: 24px;
  min-height: 44px;
}
button {
  margin-top: 14rpx;
  white-space: normal;
}

.ui002-workspace { padding:16px 16px calc(104px + env(safe-area-inset-bottom)); background:#f4f6fa; color:#18283f; }
.ui002-workspace .card { border-radius:16px; padding:16px; margin:0 0 16px; }
.ui002-workspace input,.ui002-workspace textarea,.ui002-workspace button { font-size:16px; line-height:24px; min-height:44px; }
.ui002-workspace .page-intro .title { color:#18283f; font-size:22px; line-height:32px; margin:0 0 8px; }
.ui002-workspace .page-intro { margin-bottom:16px; }
.ui002-workspace .tabs button { min-height:44px; }

.ui002-workspace .notice { font-size:14px; line-height:22px; border-radius:12px; padding:12px; }
.ledger-summary { color:#18283f; }
.ledger-summary-icon { display:flex; align-items:center; justify-content:center; flex:0 0 44px; width:44px; height:44px; border-radius:12px; background:#fff; }
.ledger-summary-icon image { width:25px; height:25px; }
.ledger-tabs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1px; min-height:44px; margin-bottom:12px; padding:2px 3px; border-radius:12px; background:#fff; color:#63758b; font-size:13px; line-height:40px; text-align:center; }
.ledger-tabs > view { min-width:0; height:40px; border-radius:10px; }
.ledger-tabs .selected { color:#fff; background:#123c73; font-weight:700; }
.ui002-workspace .entry { padding:12px 0; border-bottom:1px solid #e6ebf2; font-size:14px; line-height:22px; }
