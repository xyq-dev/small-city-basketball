.page {
  padding: 24rpx;
}
.card {
  padding: 24rpx;
  background: #fff;
  margin: 20rpx 0;
  border-radius: 20rpx;
  overflow-wrap: anywhere;
}
.title {
  font-size: 38rpx;
  font-weight: 700;
}
.subtitle {
  font-weight: 600;
  margin: 18rpx 0;
}
.notice {
  padding: 18rpx;
  background: #f1f4f8;
}
.warning {
  color: #933;
}
.small {
  font-size: 24rpx;
}
.muted {
  color: #657184;
}
.entry {
  padding: 18rpx 0;
  border-bottom: 1px solid #e3e8ef;
}
.picker,
input {
  padding: 18rpx;
  background: #f5f7fa;
  margin: 12rpx 0;
}
textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f5f7fa;
  padding: 16rpx;
}
button {
  margin-top: 14rpx;
  white-space: normal;
}
