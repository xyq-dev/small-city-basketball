<view class="page"><scb-header title="线下经费记账与公示"/><view wx:if="{{error}}" class="notice warning">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{loading}}">正在核对当前账目…</view><view class="notice">仅记录经授权的线下账目；账面收支差额不是支付余额，不提供募款、钱包或提现。</view>
<block wx:if="{{isPublic}}"><view wx:if="{{publicSnapshot}}" class="card"><view class="title">{{publicSnapshot.title}}</view><view>{{publicSnapshot.description}}</view><view class="subtitle">已审批账面收支差额 {{publicSnapshot.netLabel}}元</view><view class="small muted">快照截至 {{publicSnapshot.asOf}} ／ 发布于 {{publicSnapshot.publishedAt}}，共{{publicSnapshot.entryCount}}条已审批记录。后续记录需重新审批、公示。</view><view wx:for="{{publicSnapshot.entries}}" wx:key="seq" class="entry"><view>第{{item.seq}}条 · {{item.occurredOn}} · {{item.kindLabel}}</view><view>{{item.label}}</view><view>{{item.amountLabel}}元 <text wx:if="{{item.reversesSeq}}">（冲销第{{item.reversesSeq}}条）</text></view></view><button open-type="share">分享当前公示快照</button></view></block>
<block wx:else><view wx:if="{{loginRequired}}"><button bindtap="login">登录查看授权账目</button></view><view wx:if="{{pending}}" class="card">有原操作待核对。<button bindtap="recover">查询原操作</button><button data-cancel="true" bindtap="recover">明确放弃未确认操作</button></view><picker wx:if="{{organizations.length}}" range="{{organizations}}" range-key="name" value="{{orgIndex}}" bindchange="org"><view class="picker">授权机构：{{organizations[orgIndex].name}}</view></picker>
<view wx:if="{{selected}}" class="card"><view class="title">{{selected.title}}</view><view>{{selected.description}}</view><view>{{selected.statusLabel}} · 第{{selected.version}}版</view><view class="subtitle">已审批账面收支差额 {{selected.netLabel}}元</view><view wx:if="{{selected.publicKey}}" class="small muted">当前公示于{{selected.publishedAt}}，包含{{selected.publishedEntryCount}}条审批记录。</view><view wx:for="{{selected.entries}}" wx:key="id" class="entry"><view>{{item.occurredOn}} · {{item.kindLabel}} · {{item.statusLabel}}</view><view>{{item.label}} ／ {{item.amountLabel}}元</view><view wx:if="{{item.reviewReason}}" class="small muted">审批说明：{{item.reviewReason}}</view><block wx:if="{{item.canReview && selected.status==='ACTIVE'}}"><button data-type="APPROVE_ENTRY" data-id="{{item.id}}" bindtap="command" disabled="{{busy || !!pending}}">独立审批通过本条</button><button data-type="REJECT_ENTRY" data-id="{{item.id}}" bindtap="command" disabled="{{busy || !!pending}}">退回本条记录</button></block></view>
<block wx:if="{{selected.status==='ACTIVE'}}"><view class="subtitle">追加记录（原账目不可直接改写）</view><picker range="{{entryKinds}}" value="{{kindIndex}}" data-field="kindIndex" bindchange="picker"><view class="picker">{{entryKinds[kindIndex]}}</view></picker><picker mode="date" value="{{occurredOn}}" data-field="occurredOn" bindchange="field"><view class="picker">实际记账日期：{{occurredOn || '请选择'}}</view></picker><input data-field="label" value="{{label}}" bindinput="field" maxlength="200" placeholder="公开摘要；勿填写银行账号或无关个人资料"/><input wx:if="{{kindIndex!==2}}" data-field="amount" value="{{amount}}" bindinput="field" type="digit" maxlength="12" placeholder="金额（元，最多两位小数，不带正负号）"/><picker wx:if="{{kindIndex===2}}" range="{{selected.reversible}}" range-key="pickerLabel" value="{{reversalIndex}}" data-field="reversalIndex" bindchange="picker"><view class="picker">原审批记录：{{selected.reversible[reversalIndex].pickerLabel || '没有可冲销的原记录'}}</view></picker><view wx:if="{{kindIndex===2}}" class="small muted">系统追加原记录的精确反向金额。审批后如需补记正确事实，再追加新记录。</view><button disabled="{{busy || !!pending}}" bindtap="add">追加待独立审批记录</button><textarea data-field="reason" value="{{reason}}" bindinput="field" maxlength="500" placeholder="审批、公示、撤销或关闭原因，至少4字"/><switch data-field="publicConsent" checked="{{publicConsent}}" bindchange="consent"/>已核对本次公开内容，明确同意公示审批后的快照<button wx:if="{{selected.canPublish}}" data-type="PUBLISH" bindtap="command" disabled="{{busy || !!pending || !publicConsent}}">作为第二人核对并公示新快照</button><view wx:else class="notice">须由另一名当前授权的机构管理员独立核对后公示；本页不授予他人权限。</view><button wx:if="{{selected.publicKey}}" bindtap="openPublic">查看当前公示</button><button wx:if="{{selected.publicKey}}" data-type="REVOKE_PUBLICATION" bindtap="command" disabled="{{busy || !!pending}}">永久撤销当前公开地址</button><button data-type="CLOSE" bindtap="command" disabled="{{busy || !!pending}}">永久关闭账本并撤销公示</button></block><button bindtap="fresh" disabled="{{busy}}">新建另一授权账本</button></view>
<view wx:else><view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="select"><view class="subtitle">{{item.title}} · {{item.statusLabel}}</view><view>已审批账面差额 {{item.netLabel}}元</view></view><button wx:if="{{nextCursor}}" disabled="{{busy}}" bindtap="more">读取更多</button><view wx:if="{{!loading && !items.length && !loginRequired}}" class="notice">当前授权机构没有账本。</view><view wx:if="{{organizations.length}}" class="card"><view class="subtitle">创建经授权的线下账本</view><input data-field="teamQuery" value="{{teamQuery}}" bindinput="field" maxlength="80" placeholder="可按本机构球队名称查询范围"/><button disabled="{{busy}}" bindtap="searchTeams">查询本机构球队</button><picker range="{{teams}}" range-key="name" value="{{teamIndex}}" data-field="teamIndex" bindchange="picker"><view class="picker">范围：{{teams[teamIndex].name}}</view></picker><input data-field="title" value="{{title}}" bindinput="field" maxlength="120" placeholder="账本名称"/><textarea data-field="description" value="{{description}}" bindinput="field" maxlength="1000" placeholder="公开用途说明，勿填写私人银行或证件资料"/><switch data-field="authorizationConfirmed" checked="{{authorizationConfirmed}}" bindchange="consent"/>确认仅记录已经获得授权的线下账目<button disabled="{{busy || !!pending || !authorizationConfirmed}}" bindtap="create">创建线下账本</button></view></view></block><button bindtap="load" disabled="{{busy || loading}}">刷新当前状态</button></view>
