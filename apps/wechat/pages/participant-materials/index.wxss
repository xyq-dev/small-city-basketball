@import "../../styles/figma-pages.wxss";

.materials-rebuild .material-entry {
  min-height: 72px;
}

.material-detail__head,
.material-readonly,
.material-file,
.supplement-callout {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: center;
  gap: 8px;
}

.material-detail__head > view:first-child,
.material-readonly > text:first-child,
.material-file > text:first-child {
  min-width: 0;
  flex: 1;
}

.materials-rebuild .material-close,
.materials-rebuild .material-text-action {
  display: flex;
  min-height: 44px;
  align-items: center;
  padding: 0;
  border: 0;
  background: transparent;
  color: #123c73;
  font-size: 14px;
  font-weight: 500;
  line-height: 20px;
  text-align: left;
}

.material-note,
.material-private,
.material-terms {
  color: #51657d;
  font-size: 13px;
  line-height: 21px;
  overflow-wrap: anywhere;
}

.material-private,
.material-terms,
.material-upload-box,
.supplement-callout {
  padding: 12px;
  border-radius: 10px;
  background: #eaf2fc;
}

.material-actions,
.material-links {
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: 8px;
}

.material-upload-box {
  display: flex;
  min-height: 116px;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8px;
  color: #51657d;
  font-size: 13px;
  text-align: center;
}

.material-date-grid {
  display: grid;
  width: 100%;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.materials-rebuild .material-file {
  align-self: stretch;
  box-sizing: border-box;
  width: auto;
  min-width: 0;
  justify-content: flex-start;
  max-width: 100%;
  margin: 0;
  text-align: left;
}

.supplement-callout {
  min-height: 56px;
}

.supplement-callout + .supplement-callout {
  margin-top: 0;
}

.supplement-dot {
  width: 7px;
  height: 7px;
  flex: none;
  border-radius: 50%;
  background: #123c73;
}

.material-state-control {
  display: flex;
  align-items: center;
}

.material-state-check {
  width: 18px;
  height: 18px;
  flex: none;
  border: 1px solid #7c8ea5;
  border-radius: 3px;
  background: #fff;
}

@media (max-width: 360px) {
  .material-date-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}
