<scb-header title="{{figmaState==='materials-returned' ? '报名资料待补充' : figmaState==='materials-list' ? '我的本人报名' : figmaState==='materials-review' ? '本人资料审核与进度' : mode === 'list' ? '我的本人报名' : mode === 'review' ? '本人资料审核与进度' : material && material.status === 'CHANGES_REQUESTED' ? '报名资料待补充' : '本人报名资料'}}" disabled="{{busy || pending || dirty}}"/>
<view class="figma-page materials-rebuild">
  <view class="figma-page__content {{figmaState || mode === 'mine' && workspace ? 'figma-page__content--actions' : ''}}">
    <block wx:if="{{figmaState==='materials-returned'}}">
      <view class="figma-summary"><view class="figma-summary__icon"><figma-icon name="registration" size="28"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">本人参赛资料</view><view class="figma-title">报名资料待补充</view><view class="figma-subtitle">按退回原因补交，已保存的其他资料可继续使用。</view></view></view>
      <view class="figma-section"><view class="figma-section__title">审核意见</view><view class="supplement-callout"><view class="supplement-dot"/><view class="figma-row__copy"><view class="figma-row__title">照片待补充</view><view class="figma-row__subtitle">面部不清晰，请重新上传正面清晰照。</view></view><view class="figma-status figma-status--orange">需处理</view></view><view class="supplement-callout"><view class="supplement-dot"/><view class="figma-row__copy"><view class="figma-row__title">本届报名</view><view class="figma-row__subtitle">重新提交后等待独立审核。</view></view><view class="figma-status figma-status--orange">待复核</view></view></view>
      <view class="figma-section"><view class="figma-section__title">补交项目</view><view class="figma-field-group"><view class="figma-field-label">本人照片 *</view><view class="figma-field-control material-state-control">选择或拍摄清晰本人照</view></view><view class="figma-field-group"><view class="figma-field-label">已填资料</view><view class="figma-field-control material-readonly"><text>陈一鸣 · 23号 · 已脱敏</text><view class="figma-status figma-status--orange">已保存</view></view></view></view>
      <view class="figma-section"><view class="figma-section__title">宣传使用</view><view class="figma-row"><view class="material-state-check"/><view class="figma-row__copy"><view class="figma-row__title">同意使用照片制作宣传海报</view><view class="figma-row__subtitle">自愿选择，可独立撤回。</view></view><view class="figma-status">未勾选</view></view></view>
      <view class="figma-section"><view class="figma-section__title">参赛材料用途</view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">私有照片供有权审核人核对。</view></view><view class="figma-status">仅审核</view></view></view>
    </block>

    <block wx:elif="{{figmaState==='materials-list'}}">
      <view class="figma-summary"><view class="figma-summary__icon"><figma-icon name="registration" size="28"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">本人报名</view><view class="figma-title">我的本人报名</view><view class="figma-subtitle">选择本届赛事和本队报名，再查看资料与用途授权。</view></view></view>
      <view class="figma-section"><view class="figma-section__title">本人报名</view><view class="figma-row material-entry"><view class="figma-row__copy"><view class="figma-row__title">城市篮球邀请赛</view><view class="figma-row__subtitle">城北篮球队 · 11.01—11.15</view></view><view class="figma-status figma-status--orange">本人报名</view></view></view>
    </block>

    <block wx:elif="{{figmaState==='materials-review'}}">
      <view class="figma-summary"><view class="figma-summary__icon"><figma-icon name="registration" size="28"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">城市篮球邀请赛 · 城北篮球队</view><view class="figma-title">本人资料审核与进度</view><view class="figma-subtitle">领队查看逐人进度。私有材料需独立审核权限。</view></view></view>
      <view class="figma-section"><view class="figma-section__title">逐人填写与审核进度</view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">陈一鸣 · 7号</view><view class="figma-row__subtitle">当前版本 2 · 已提交资料</view></view><view class="figma-status figma-status--orange">待核验</view></view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">林子航 · 23号</view><view class="figma-row__subtitle">当前版本 1 · 保障凭证待补充</view></view><view class="figma-status figma-status--orange">待补齐</view></view></view>
      <view class="figma-section"><view class="figma-section__title">材料访问</view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">查看进度详情</view><view class="figma-row__subtitle">按当前账号与报名权限核对</view></view><view class="figma-status">仅进度</view></view></view>
    </block>

    <block wx:else>
    <view wx:if="{{mode === 'list'}}" class="figma-summary">
      <view class="figma-summary__icon"><figma-icon name="registration" size="28"/></view>
      <view class="figma-summary__copy">
        <view class="figma-eyebrow">本人报名</view>
        <view class="figma-title">我的本人报名</view>
        <view class="figma-subtitle">选择本届赛事和本队报名，再查看资料与用途授权。</view>
      </view>
    </view>

    <view wx:elif="{{workspace}}" class="figma-summary">
      <view class="figma-summary__icon"><figma-icon name="registration" size="28"/></view>
      <view class="figma-summary__copy">
        <view class="figma-eyebrow">{{mode === 'review' ? '城市篮球邀请赛 · ' + workspace.teamName : material && material.status === 'CHANGES_REQUESTED' ? '本人参赛资料' : '仅本人和授权审核人'}}</view>
        <view class="figma-title">{{mode === 'review' ? '本人资料审核与进度' : material && material.status === 'CHANGES_REQUESTED' ? '报名资料待补充' : figmaSummaryTitle || workspace.eventName + ' · ' + (material.memberName || '本人')}}</view>
        <view class="figma-subtitle">{{mode === 'review' ? '领队查看逐人进度。私有材料需独立审核权限。' : material && material.status === 'CHANGES_REQUESTED' ? '按退回原因补交，已保存的其他资料可继续使用。' : '仅限本届赛事使用的私有资料'}}</view>
      </view>
    </view>

    <figma-feedback wx:if="{{error}}" type="error" title="读取或处理未完成" body="{{error}}" action-label="重新读取" disabled="{{busy || loading}}" bind:action="load"/>
    <figma-feedback wx:if="{{message}}" type="success" title="当前操作已记录" body="{{message}}"/>
    <figma-feedback wx:if="{{storageError}}" type="error" title="本机保护记录异常" body="{{storageError}}"/>
    <figma-feedback wx:if="{{pending}}" type="warning" title="原请求结果待核对" body="已保留原请求编号；核对回执前暂停新保存与上传，避免重复建档。" action-label="重新核对原请求回执" disabled="{{busy || loading}}" bind:action="load"/>
    <figma-skeleton wx:if="{{loading && !workspace}}" rows="4"/>

    <view wx:if="{{loginRequired && !loading}}" class="figma-section">
      <view class="figma-section__title">登录后继续本人报名</view>
      <view class="figma-section__hint">仅本人和有权的独立审核人员可查看受保护资料。</view>
      <button class="figma-action figma-action--orange" bindtap="login">登录并继续</button>
    </view>

    <block wx:if="{{mode === 'list' && !loginRequired && !loading}}">
      <figma-feedback wx:if="{{!entries.length}}" type="empty" title="暂无待填写的本人报名" body="先加入或认领本人球队成员，再由领队将你加入本届名单。加入球队本身不代表已报名。"/>
      <view wx:if="{{entries.length}}" class="figma-section">
        <view class="figma-section__title">本人报名</view>
        <button wx:for="{{entries}}" wx:key="entryId" class="figma-row material-entry" data-id="{{item.entryId}}" data-org="{{item.orgId}}" bindtap="openEntry">
          <view class="figma-row__copy">
            <view class="figma-row__title">{{item.eventName}}</view>
            <view class="figma-row__subtitle">{{item.teamName}} · {{item.startDate}}—{{item.endDate}}</view>
          </view>
          <view class="figma-status figma-status--orange">本人报名</view>
        </button>
      </view>
    </block>

    <block wx:if="{{workspace && mode === 'review'}}">
      <view class="figma-section">
        <view class="figma-section__title">逐人填写与审核进度</view>
        <view class="figma-section__hint">本届名单中的每位成员分别核对当前版本与授权。</view>
        <figma-feedback wx:if="{{!members.length}}" type="empty" title="本届名单尚无成员"/>
        <button wx:for="{{members}}" wx:key="memberId" class="figma-row" data-id="{{item.memberId}}" bindtap="openMember" disabled="{{busy}}">
          <view class="figma-row__copy">
            <view class="figma-row__title">{{item.memberName}}</view>
            <view class="figma-row__subtitle">当前版本 {{item.version}} · {{item.blockerText || '已提交资料'}}</view>
          </view>
          <view class="figma-status figma-status--orange">{{item.statusLabel}}</view>
        </button>
      </view>

      <view class="figma-section">
        <view class="figma-section__title">材料访问</view>
        <view class="figma-row">
          <view class="figma-row__copy">
            <view class="figma-row__title">查看进度详情</view>
            <view class="figma-row__subtitle">按当前账号与报名权限核对</view>
          </view>
          <view class="figma-status">仅进度</view>
        </view>
      </view>

      <view wx:if="{{material}}" class="figma-section material-detail">
        <view class="material-detail__head">
          <view>
            <view class="figma-section__title">{{material.memberName}} · {{material.statusLabel}}</view>
            <view class="figma-section__hint">当前材料版本 V{{material.version}}</view>
          </view>
          <button class="material-close" bindtap="closeMember" disabled="{{busy}}">收起</button>
        </view>
        <figma-feedback wx:if="{{material.reviewReason}}" type="warning" title="审核说明" body="{{material.reviewReason}}"/>
        <view wx:if="{{material.blockerText}}" class="material-note">待处理：{{material.blockerText}}</view>
        <view wx:if="{{material.identityMasked}}" class="material-note">身份证 {{material.identityMasked}}</view>
        <view wx:if="{{material.portrait}}" class="material-note">{{material.portraitLabel}}</view>
        <view wx:if="{{material.insurance}}" class="material-note">{{material.insurance.insurer}} · {{material.insurance.policyNumberMasked}} · {{material.insurance.startDate}}—{{material.insurance.endDate}}</view>
        <view class="material-note">{{material.publicityConsent ? '本人已选择允许本届照片宣传用途' : '未授权照片宣传，不影响参赛资格'}}</view>
        <view class="material-actions" wx:if="{{material.capabilities.canReadPrivate}}">
          <button class="figma-action figma-action--ghost" bindtap="revealPrivate" disabled="{{busy || pending}}">明确查看私有文字资料</button>
          <button wx:if="{{material.portrait}}" class="figma-action figma-action--ghost" data-kind="portrait" bindtap="viewFile" disabled="{{busy || pending}}">私有核对本人照片</button>
          <button wx:if="{{material.insurance.document}}" class="figma-action figma-action--ghost" data-kind="insurance" bindtap="viewFile" disabled="{{busy || pending}}">私有核对保单</button>
        </view>
        <view wx:if="{{privateDetails}}" class="material-private">
          <view>姓名：{{privateDetails.realName || '未填写'}}</view>
          <view>身份证：{{privateDetails.identityNumber || '未填写'}}</view>
          <view wx:if="{{privateDetails.insurance}}">保单号：{{privateDetails.insurance.policyNumber}}</view>
          <button class="material-text-action" bindtap="concealPrivate">立即隐藏私有文字</button>
        </view>
      </view>

      <view wx:if="{{material && material.capabilities.canReview}}" class="figma-section">
        <view class="figma-section__title">独立人工审核当前版本</view>
        <view class="figma-section__hint">审核人不得为本人、本队领队、本队活跃成员或最近提交人。</view>
        <checkbox-group data-field="identityChecked" bindchange="checkbox"><label class="figma-check"><checkbox value="yes" checked="{{identityChecked}}" disabled="{{busy}}"/><text>已人工核对身份文字资料</text></label></checkbox-group>
        <checkbox-group data-field="portraitChecked" bindchange="checkbox"><label class="figma-check"><checkbox value="yes" checked="{{portraitChecked}}" disabled="{{busy}}"/><text>已核对清晰本人照片与参赛者相貌</text></label></checkbox-group>
        <checkbox-group data-field="insuranceChecked" bindchange="checkbox"><label class="figma-check"><checkbox value="yes" checked="{{insuranceChecked}}" disabled="{{busy}}"/><text>适用时已核对保障材料</text></label></checkbox-group>
        <view class="figma-field-group"><view class="figma-field-label">审核说明（4—500字）</view><textarea class="figma-field-control" bindinput="reasonInput" value="{{reason}}" maxlength="500" disabled="{{busy}}" placeholder="说明核对结果或需要补齐的材料"/></view>
        <button class="figma-action figma-action--navy" data-decision="APPROVE" bindtap="review" disabled="{{busy || !identityChecked || !portraitChecked}}">通过当前材料版本</button>
        <button class="figma-action figma-action--ghost" data-decision="REQUEST_CHANGES" bindtap="review" disabled="{{busy}}">退回本人补齐</button>
      </view>
    </block>

    <block wx:if="{{workspace && mode === 'mine'}}">
      <figma-tabs key1="profile" label1="身份" key2="portrait" label2="照片" key3="consent" label3="签署" key4="progress" label4="进度" active="{{materialPanel === 'insurance' ? 'progress' : materialPanel}}" disabled="{{busy || loading || pending}}" bind:change="switchMaterialPanel"/>
      <button class="material-text-action" data-panel="insurance" bindtap="switchMaterialPanel" disabled="{{busy || loading || pending}}">已有外部保单</button>

      <figma-feedback wx:if="{{!workspace.enabled}}" type="warning" title="本届尚未开放本人资料流程" body="不能据此放宽身份、照片或保障要求。"/>
      <figma-feedback wx:if="{{workspace.frozen}}" type="warning" title="本届名单已冻结" body="当前资料保持冻结版本；仍可按权限查看进度或撤回宣传许可。"/>
      <figma-feedback wx:if="{{workspace.dataProcessingConsent.required && !workspace.dataProcessingConsent.ready}}" type="warning" title="先完成监护人资料处理同意" body="取得本届必要同意后，才能继续填写身份和照片。" action-label="打开监护确认" disabled="{{busy || pending}}" bind:action="guardian"/>

      <block wx:if="{{material && material.status === 'CHANGES_REQUESTED'}}">
        <view class="figma-section">
          <view class="figma-section__title">审核意见</view>
          <view class="supplement-callout"><view class="supplement-dot"/><view class="figma-row__copy"><view class="figma-row__title">{{material.blockerText || '报名资料待补充'}}</view><view class="figma-row__subtitle">{{material.reviewReason || '请按审核说明更新当前版本。'}}</view></view><view class="figma-status figma-status--orange">需处理</view></view>
          <view class="supplement-callout"><view class="supplement-dot"/><view class="figma-row__copy"><view class="figma-row__title">本届报名</view><view class="figma-row__subtitle">重新提交后等待独立审核。</view></view><view class="figma-status figma-status--orange">待复核</view></view>
        </view>
      </block>

      <block wx:if="{{materialPanel === 'profile'}}">
        <view class="figma-section">
          <view class="figma-section__title">本届身份</view>
          <view class="figma-field-group"><view class="figma-field-label">本人姓名 *</view><input class="figma-field-control" data-field="realName" value="{{form.realName}}" bindinput="field" maxlength="80" disabled="{{busy || pending || !workspace.capabilities.canSave}}" placeholder="请输入真实姓名"/></view>
          <view class="figma-field-group"><view class="figma-field-label">证件号码 *</view><input class="figma-field-control" data-field="identityNumber" value="{{form.identityNumber}}" bindinput="field" maxlength="18" disabled="{{busy || pending || !workspace.capabilities.canSave}}" placeholder="{{material.identityMasked ? '已保存；留空保留原证件号' : '仅授权人员可见'}}"/></view>
          <view class="figma-field-group"><view class="figma-field-label">球衣号码</view><view class="figma-field-control material-readonly"><text>{{figmaJerseyNumber || material.memberName || '本人'}}</text><text class="figma-status figma-status--orange">本届</text></view></view>
        </view>
        <view class="figma-section">
          <view class="figma-section__title">本人照片</view>
          <view class="figma-field-group"><view class="figma-field-label">清晰本人照片</view><button class="figma-field-control material-file" data-kind="portrait" bindtap="upload" disabled="{{busy || pending || storageError || !workspace.capabilities.canSave}}"><text>{{material.portrait ? '替换本人清晰正面照片' : '选择本人清晰正面照片'}}</text><view class="figma-status figma-status--orange">{{material.portrait ? '已保存' : '必传'}}</view></button></view>
          <view class="figma-field-group"><view class="figma-field-label">上传进度</view><view class="figma-field-control material-readonly"><text>{{material ? material.portraitLabel : '等待选择文件'}}</text><view class="figma-status figma-status--orange">{{material && material.portrait ? '已保存' : '待补充'}}</view></view></view>
        </view>
        <view class="figma-section">
          <view class="figma-section__title">用途授权</view>
          <checkbox-group data-field="acceptedTerms" bindchange="checkbox"><label class="figma-check"><checkbox value="yes" checked="{{form.acceptedTerms}}" disabled="{{busy || pending || !workspace.capabilities.canSave}}"/><view class="figma-row__copy"><view class="figma-row__title">本届规程</view><view class="figma-row__subtitle">本人核对并签署</view></view><view class="figma-status {{form.acceptedTerms ? 'figma-status--green' : 'figma-status--orange'}}">{{form.acceptedTerms ? '已确认' : '待确认'}}</view></label></checkbox-group>
          <checkbox-group data-field="publicityConsent" bindchange="checkbox"><label class="figma-check"><checkbox value="yes" checked="{{form.publicityConsent}}" disabled="{{busy || pending || !workspace.capabilities.canSave}}"/><view class="figma-row__copy"><view class="figma-row__title">允许照片宣传</view><view class="figma-row__subtitle">自愿选择，默认未勾选</view></view><view class="figma-status">{{form.publicityConsent ? '已选择' : '可选'}}</view></label></checkbox-group>
        </view>
      </block>

      <view wx:if="{{materialPanel === 'portrait'}}" class="figma-section">
        <view class="figma-section__title">本人照片</view>
        <view class="figma-section__hint">清晰正面单人照片，仅本人及有权独立审核人可查看。支持 JPEG/PNG，不超过 8MiB。</view>
        <view class="material-upload-box"><figma-icon name="camera" size="28"/><view>{{material ? material.portraitLabel : '尚未上传本人照片'}}</view></view>
        <button class="figma-action figma-action--navy" data-kind="portrait" bindtap="upload" disabled="{{busy || pending || storageError || !workspace.capabilities.canSave}}">{{material.portrait ? '选择并替换本人照片' : '拍摄或选择本人照片'}}</button>
      </view>

      <view wx:if="{{materialPanel === 'consent'}}" class="figma-section">
        <view class="figma-section__title">本届规程签署</view>
        <view class="figma-section__hint">确认版本：{{workspace.rules.termsVersion}}</view>
        <view class="material-terms">本人提交真实资料和近期照片，供本届资格、相貌及保障人工核对。球队领队不能代替本人签署。照片私有核对是报名要求，宣传用途另行自愿选择。</view>
        <checkbox-group data-field="acceptedTerms" bindchange="checkbox"><label class="figma-check"><checkbox value="yes" checked="{{form.acceptedTerms}}" disabled="{{busy || pending || !workspace.capabilities.canSave}}"/><text>我本人已核对本届资料、用途和确认内容</text></label></checkbox-group>
        <checkbox-group data-field="publicityConsent" bindchange="checkbox"><label class="figma-check"><checkbox value="yes" checked="{{form.publicityConsent}}" disabled="{{busy || pending || !workspace.capabilities.canSave}}"/><text>我自愿允许本届照片宣传用途（可选）</text></label></checkbox-group>
      </view>

      <view wx:if="{{materialPanel === 'insurance'}}" class="figma-section">
        <view class="figma-section__title">已有保单</view>
        <view class="figma-section__hint">已有保单人工核验；上传不等于已投保、保障有效或审核通过。</view>
        <view class="figma-field-group"><view class="figma-field-label">保险机构</view><input class="figma-field-control" data-field="insurer" value="{{form.insurer}}" bindinput="field" maxlength="120" disabled="{{busy || pending || !workspace.capabilities.canSave}}" placeholder="填写实际保险机构"/></view>
        <view class="figma-field-group"><view class="figma-field-label">保单号</view><input class="figma-field-control" data-field="policyNumber" value="{{form.policyNumber}}" bindinput="field" maxlength="120" disabled="{{busy || pending || !workspace.capabilities.canSave}}" placeholder="{{material.insurance ? '已保存；留空保留原保单号' : '填写实际保单号'}}"/></view>
        <view class="material-date-grid"><view class="figma-field-group"><view class="figma-field-label">保障开始日期</view><input class="figma-field-control" data-field="startDate" value="{{form.startDate}}" bindinput="field" maxlength="10" disabled="{{busy || pending || !workspace.capabilities.canSave}}" placeholder="YYYY-MM-DD"/></view><view class="figma-field-group"><view class="figma-field-label">保障结束日期</view><input class="figma-field-control" data-field="endDate" value="{{form.endDate}}" bindinput="field" maxlength="10" disabled="{{busy || pending || !workspace.capabilities.canSave}}" placeholder="YYYY-MM-DD"/></view></view>
        <button class="figma-action figma-action--ghost" data-kind="insurance" bindtap="upload" disabled="{{busy || pending || storageError || !workspace.capabilities.canSave}}">选择并私有保存保单文件</button>
      </view>

      <view wx:if="{{materialPanel === 'progress'}}" class="figma-section">
        <view class="figma-section__title">提交与审核进度</view>
        <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">当前资料版本</view><view class="figma-row__subtitle">{{material ? 'V' + material.version : '尚未保存'}}</view></view><view class="figma-status figma-status--orange">{{material ? material.statusLabel : '待填写'}}</view></view>
        <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">本人照片</view><view class="figma-row__subtitle">{{material ? material.portraitLabel : '待上传'}}</view></view><view class="figma-status">{{material && material.portrait ? '已保存' : '待补充'}}</view></view>
        <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">本届签署</view><view class="figma-row__subtitle">当前规程版本 {{workspace.rules.termsVersion}}</view></view><view class="figma-status {{form.acceptedTerms ? 'figma-status--green' : 'figma-status--orange'}}">{{form.acceptedTerms ? '已签署' : '待签署'}}</view></view>
        <button wx:if="{{workspace.capabilities.canWithdrawPublicity}}" class="material-text-action" data-action="withdraw" bindtap="command" disabled="{{busy || pending}}">撤回照片宣传授权</button>
      </view>

      <view wx:if="{{!workspace.capabilities.canSave}}" class="figma-section">
        <view class="figma-section__title">本人资料当前不可编辑</view>
        <view class="figma-section__hint">按当前权限与冻结版本查看进度，页面切换不会取得填写或审核权限。</view>
      </view>

      <view class="figma-section material-links">
        <view class="figma-section__title">相关服务</view>
        <button wx:if="{{workspace.dataProcessingConsent.required}}" class="figma-row" bindtap="guardian" disabled="{{busy || pending || dirty}}"><view class="figma-row__copy"><view class="figma-row__title">监护确认</view><view class="figma-row__subtitle">查看本届必要资料处理授权</view></view><view class="figma-status figma-status--orange">查看</view></button>
        <button class="figma-row" bindtap="qualification" disabled="{{busy || pending || dirty}}"><view class="figma-row__copy"><view class="figma-row__title">本届资格预审</view><view class="figma-row__subtitle">按当前资料版本独立核验</view></view><view class="figma-status figma-status--orange">查看</view></button>
        <button class="figma-row" bindtap="insurance" disabled="{{busy || pending || dirty}}"><view class="figma-row__copy"><view class="figma-row__title">本届保险保障</view><view class="figma-row__subtitle">购买、查单与退保进度</view></view><view class="figma-status figma-status--orange">查看</view></button>
      </view>
    </block>
    </block>
  </view>

  <view wx:if="{{figmaState==='materials-returned'}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost">保存草稿</button><button class="figma-action figma-action--orange">重新提交本人资料</button></view>
  <view wx:elif="{{figmaState==='materials-list'}}" class="figma-fixed-actions figma-fixed-actions--single"><button class="figma-action figma-action--orange">查看本人资料与授权</button></view>
  <view wx:elif="{{figmaState==='materials-review'}}" class="figma-fixed-actions figma-fixed-actions--single"><button class="figma-action figma-action--orange">查看进度详情</button></view>
  <view wx:elif="{{mode === 'mine' && workspace}}" class="figma-fixed-actions">
    <button class="figma-action figma-action--ghost" data-panel="progress" bindtap="switchMaterialPanel" disabled="{{busy || loading || pending}}">查看审核进度</button>
    <button wx:if="{{!dirty && workspace.capabilities.canSubmit}}" class="figma-action figma-action--orange" data-action="submit" bindtap="command" disabled="{{busy || loading || pending}}">{{material && material.status === 'CHANGES_REQUESTED' ? '重新提交本人资料' : '提交本人资料审核'}}</button>
    <button wx:else class="figma-action figma-action--orange" bindtap="save" disabled="{{busy || loading || pending || storageError || !workspace.capabilities.canSave}}">保存本人资料</button>
  </view>
</view>
