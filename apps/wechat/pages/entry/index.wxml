<scb-header title="本届报名与资料" disabled="{{busy || uncertain || dirty}}"/>
<view class="figma-page entry-page">
  <view class="figma-page__content figma-page__content--actions">
    <figma-feedback wx:if="{{error}}" type="error" title="本届报名读取失败" body="{{error}}" action-label="重新读取" bind:action="refresh"/>
    <figma-feedback wx:if="{{message}}" type="{{uncertain ? 'pending' : 'success'}}" title="{{uncertain ? '操作结果待核对' : '报名状态已更新'}}" body="{{message}}"/>
    <figma-feedback wx:if="{{loginRequired}}" type="empty" title="登录后查看本队报名" body="本届名单与资料只对当前有权人员展示。" action-label="登录并继续" bind:action="login"/>
    <view wx:if="{{loading}}" class="figma-section"><figma-skeleton rows="{{5}}"/></view>
    <block wx:if="{{entry}}">
      <view class="figma-summary"><view class="figma-summary__icon"><figma-icon name="registration" size="{{28}}"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">球队领队</view><view class="figma-title">{{entry.eventName ? entry.eventName + ' · ' : ''}}{{entry.teamName}}</view><view class="figma-subtitle">长期成员和本届名单分别保存</view></view></view>
      <view class="entry-tabs"><button class="entry-tab {{stage==='roster' ? 'is-active' : ''}}" data-stage="roster" bindtap="switchStage" disabled="{{busy}}">名单</button><button class="entry-tab {{stage==='documents' ? 'is-active' : ''}}" data-stage="documents" bindtap="switchStage" disabled="{{busy}}">资料</button><button class="entry-tab {{stage==='review' ? 'is-active' : ''}}" data-stage="review" bindtap="switchStage" disabled="{{busy}}">提交核对</button><button class="entry-tab {{stage==='history' ? 'is-active' : ''}}" data-stage="history" bindtap="switchStage" disabled="{{busy}}">进度</button></view>
      <figma-feedback wx:if="{{entry.latestReviewReason}}" type="pending" title="独立审核意见" body="{{entry.latestReviewReason}}"/>
      <button wx:if="{{entry.rules.requireParticipantMaterials}}" class="section-ghost" bindtap="participantProgress" disabled="{{busy}}">逐人本人资料与审核进度</button>

      <block wx:if="{{stage==='roster'}}">
        <view class="figma-section"><view class="figma-section__title">本届名单</view><figma-feedback wx:if="{{!entry.players.length}}" type="empty" title="暂无已保存球员"/><view wx:for="{{entry.players}}" wx:key="memberId" class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{item.jerseyNo}}　{{item.name}}</view><view class="figma-row__subtitle">{{item.materialLabel || '本届报名资料已保存'}}</view></view><view class="figma-status figma-status--orange">{{item.statusLabel || '已保存'}}</view></view></view>
        <view class="figma-section"><view class="figma-section__title">本次资料</view><view class="figma-field-group"><view class="figma-field-label">名单版本</view><view class="figma-field-control entry-readonly">第 {{entry.version}} 版 · 保存后上传凭证</view></view><view class="figma-field-group"><view class="figma-field-label">报名私有文件</view><view class="figma-field-control entry-readonly">{{files.length ? '已保存 ' + files.length + ' 份文件' : '选择用途与文件'}}</view></view><view class="figma-field-group"><view class="figma-field-label">本届赛事规程</view><view class="figma-field-control entry-readonly">{{entry.rules.minPlayers}}–{{entry.rules.maxPlayers}} 人 · 逐项核对赛事要求</view></view></view>
        <view class="figma-section"><view class="profile-head"><view><view class="figma-section__title">名单编辑</view><view class="figma-section__hint">赛事要求 {{entry.rules.minPlayers}}–{{entry.rules.maxPlayers}} 人</view></view><view class="figma-status figma-status--orange">已选 {{selectedCount}}</view></view><view class="figma-caption">{{entry.rules.zeroAndDoubleZeroDistinct ? '0与00按不同号码处理。' : '0与00视为同一号码。'}} 本届快照与长期档案分开。</view>
          <block wx:if="{{entry.capabilities.canEditRoster}}"><figma-feedback wx:if="{{!rows.length}}" type="empty" title="球队暂无长期成员" body="请返回球队先添加长期成员。"/><view wx:for="{{rows}}" wx:key="memberId" class="roster-row"><button class="roster-select" data-index="{{index}}" bindtap="togglePlayer" disabled="{{busy || uncertain}}"><view class="select-mark {{item.selected ? 'is-active' : ''}}"></view><view class="roster-name"><view class="figma-row__title">{{item.name}}</view><view wx:if="{{item.archived}}" class="figma-row__subtitle roster-error">该长期成员已归档</view></view></button><input class="jersey-field" maxlength="2" value="{{item.jerseyNo}}" data-index="{{index}}" bindinput="jersey" placeholder="号码" disabled="{{busy || uncertain || !item.selected || item.archived}}"/></view><button class="section-primary" bindtap="saveRoster" disabled="{{busy || uncertain || !dirty}}" loading="{{busy}}">保存本届名单</button></block>
          <figma-feedback wx:else type="pending" title="本届名单当前只读" body="已批准、已锁定或权限变化时不能直接编辑。"/>
        </view>
        <view class="figma-section"><view class="figma-section__title">审核进度</view><view class="entry-step"><view class="step-no">1</view><view class="figma-row__copy"><view class="figma-row__title">{{entry.capabilities.canEditRoster ? '保存本届名单' : '核对本届名单'}}</view><view class="figma-row__subtitle">核对人数和号码</view></view><view class="figma-status figma-status--orange">{{entry.players.length ? '已保存' : '待保存'}}</view></view><view class="entry-step"><view class="step-no">2</view><view class="figma-row__copy"><view class="figma-row__title">补充资料</view><view class="figma-row__subtitle">独立审核意见详见成员项</view></view><view class="figma-status figma-status--orange">{{files.length ? '进行中' : '待补充'}}</view></view><view class="entry-step"><view class="step-no">3</view><view class="figma-row__copy"><view class="figma-row__title">提交本队审核</view><view class="figma-row__subtitle">核对声明后提交</view></view><view class="figma-status figma-status--orange">{{entry.status==='DRAFT' ? '待提交' : entry.statusLabel}}</view></view></view>
        <button class="section-primary" data-stage="documents" bindtap="switchStage" disabled="{{busy}}">下一步：报名资料与保险凭证</button>
      </block>

      <block wx:if="{{stage==='documents'}}">
        <view class="figma-section"><view class="figma-section__title">报名私有文件</view><view class="figma-section__hint">文件只供当前有权人员查看，不进入匿名观赛页。</view><view wx:if="{{fileWorkspace}}" class="figma-caption">本机构已用 {{fileWorkspace.usage.usedBytes}} / {{fileWorkspace.usage.limitBytes}} 字节 · 单文件最多 8MiB</view><figma-feedback wx:if="{{fileError}}" type="error" title="文件资料读取失败" body="{{fileError}}"/><figma-feedback wx:if="{{!files.length}}" type="empty" title="暂无可查看文件"/><view wx:for="{{files}}" wx:key="id" class="file-row"><view class="profile-head"><view><view class="figma-row__title">{{item.fileName}}</view><view class="figma-row__subtitle">{{item.purposeLabel}} · {{item.statusLabel}} · {{item.sizeText}}</view></view><view class="figma-status">{{item.rosterRevisionId ? '已关联名单' : '未关联名单'}}</view></view><view class="file-actions"><button wx:if="{{item.status==='ACTIVE'}}" class="section-ghost" data-id="{{item.id}}" bindtap="viewFile" disabled="{{busy || dirty || uncertain}}">私有查看</button><button wx:if="{{item.status==='ACTIVE' && fileWorkspace.capabilities.canRevoke}}" class="section-danger" data-id="{{item.id}}" bindtap="revoke" disabled="{{busy || uncertain}}">撤销文件</button></view></view></view>
        <figma-feedback type="pending" title="上传不等于投保或审核通过" body="本入口不销售保险，不自动核验身份证或保单。"/>
        <figma-feedback wx:if="{{dirty}}" type="pending" title="请先保存名单" body="文件只能关联服务器已保存的名单版本。"/>
        <view wx:if="{{fileWorkspace.capabilities.canUpload}}" class="figma-section"><view class="figma-field-group"><view class="figma-field-label">文件用途</view><picker range="{{purposes}}" value="{{uploadPurposeIndex}}" bindchange="purpose" disabled="{{busy}}"><view class="figma-field-control picker-control">{{purposes[uploadPurposeIndex]}}</view></picker></view><checkbox-group bindchange="fileConsent"><label class="figma-check"><checkbox value="yes" checked="{{fileConsent}}" disabled="{{busy}}"/>我有权提交此资料，并理解它只作为私有凭证保存</label></checkbox-group><button class="section-primary" bindtap="upload" disabled="{{busy || dirty || uncertain || !fileConsent}}" loading="{{busy}}">选择一份 PDF / PNG / JPEG 并上传</button></view>
        <view wx:if="{{fileWorkspace.capabilities.canRevoke}}" class="figma-section"><view class="figma-field-group"><view class="figma-field-label">撤销原因（4–500字）</view><textarea class="figma-field-control" maxlength="500" value="{{reason}}" bindinput="reason" placeholder="如：保单更新，撤销旧凭证" disabled="{{busy}}"/></view></view>
        <button class="section-primary" data-stage="review" bindtap="switchStage" disabled="{{busy}}">下一步：提交前核对</button>
      </block>

      <block wx:if="{{stage==='review'}}">
        <view class="figma-section"><view class="figma-section__title">提交前核对</view><view class="review-row"><text>球队</text><text>{{entry.teamName}}</text></view><view class="review-row"><text>已保存人数</text><text>{{entry.players.length}} 人</text></view><view class="review-row"><text>赛事要求</text><text>{{entry.rules.minPlayers}}–{{entry.rules.maxPlayers}} 人</text></view><view class="figma-section__hint">请核对已保存名单、球衣号、赛事要求和资料提交范围。</view></view>
        <figma-feedback wx:if="{{entry.rules.requireIdentity || entry.rules.requireInsurance}}" type="pending" title="仍需主办方核验资料" body="上传文件不会解除提交限制；身份或保险资料仍须主办方按实际情况核验。"/>
        <figma-feedback wx:if="{{dirty}}" type="pending" title="还有未保存名单变更" body="先保存新版本后再提交。"/>
        <view class="figma-section"><checkbox-group bindchange="consent"><label class="figma-check"><checkbox value="yes" checked="{{consent}}" disabled="{{busy || !entry.capabilities.canSubmit || dirty}}"/>我已核对本届名单、号码、赛事要求和资料范围</label></checkbox-group><button class="section-primary" data-type="SUBMIT" bindtap="command" disabled="{{busy || uncertain || dirty || !consent || !entry.capabilities.canSubmit}}" loading="{{busy}}">{{entry.status==='CHANGES_REQUESTED' ? '重新提交本届报名审核' : '提交本届报名审核'}}</button><figma-feedback wx:if="{{!entry.capabilities.canSubmit}}" type="pending" title="当前不能提交" body="请核对人数、报名状态、赛事规则及当前授权。"/></view>
        <view class="two-actions"><button class="section-ghost" data-stage="roster" bindtap="switchStage" disabled="{{busy}}">返回名单</button><button class="section-primary" data-stage="history" bindtap="switchStage" disabled="{{busy}}">审核进度</button></view>
      </block>

      <block wx:if="{{stage==='history'}}">
        <view class="figma-section"><view class="profile-head"><view><view class="figma-section__title">审核进度与历史</view><view class="figma-section__hint">{{entry.teamName}}</view></view><view class="figma-status">{{entry.statusLabel}}</view></view><figma-feedback wx:if="{{!entry.history.length}}" type="empty" title="尚无提交或审核记录"/><view wx:for="{{entry.history}}" wx:key="id" class="history-row"><view class="figma-row__title">{{item.typeLabel}}</view><view class="figma-row__subtitle">{{item.timeText}}</view><view wx:if="{{item.reason}}" class="figma-caption">{{item.reason}}</view></view></view>
        <view wx:if="{{entry.capabilities.canWithdraw}}" class="figma-section"><view class="figma-field-group"><view class="figma-field-label">撤回说明（可选）</view><textarea class="figma-field-control" value="{{reason}}" maxlength="500" bindinput="reason" disabled="{{busy}}"/></view><button class="section-danger" data-type="WITHDRAW" bindtap="command" disabled="{{busy || uncertain}}">撤回本队本届报名</button></view>
      </block>
    </block>
    <figma-feedback wx:if="{{!entry && !loading && !error && !loginRequired}}" type="empty" title="暂无可查看的本届报名" body="请从本队已开放的赛事进入，或核对当前账号授权。"/>
    <button wx:if="{{dirty}}" class="section-ghost" bindtap="refresh" disabled="{{busy || uncertain}}">取消未保存名单修改</button>
  </view>
  <view wx:if="{{entry}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost" data-stage="review" bindtap="switchStage" disabled="{{busy || loading}}">提交前核对</button><button wx:if="{{entry.capabilities.canEditRoster}}" class="figma-action figma-action--orange" bindtap="saveRoster" disabled="{{busy || loading || uncertain || !dirty}}" loading="{{busy}}">保存本届名单</button></view>
</view>
