@import "../../styles/figma-pages.wxss";

.entry-tabs{display:grid;height:48px;padding:2px;grid-template-columns:repeat(4,minmax(0,1fr));border-radius:14px;background:#fff}.entry-tab{display:flex;min-width:0;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 4px;border:0;border-radius:12px;background:transparent;color:#51657d;font-size:13px}.entry-tab::after,.roster-select::after,.section-primary::after,.section-ghost::after,.section-danger::after{border:0}.entry-tab.is-active{background:#123c73;color:#fff;font-weight:700}.profile-head{display:flex;min-height:44px;align-items:center;justify-content:space-between;gap:8px}.roster-row{display:grid;min-height:60px;align-items:center;grid-template-columns:minmax(0,1fr) 68px;gap:8px;border-top:1px solid #e6ebf2}.roster-select{display:flex;min-width:0;min-height:44px;align-items:center;gap:8px;margin:0;padding:0;border:0;background:transparent;color:#18283f;text-align:left}.select-mark{width:20px;height:20px;flex:none;border:2px solid #7c8ea5;border-radius:6px;background:#fff}.select-mark.is-active{border:6px solid #123c73;background:#fff}.roster-name{min-width:0;flex:1}.roster-error{color:#c83f42}.jersey-field{width:68px;height:44px;padding:0 8px;border:1px solid #7c8ea5;border-radius:10px;background:#fff;color:#18283f;font-size:14px;text-align:center}.member-avatar{display:flex;width:36px;height:36px;flex:none;align-items:center;justify-content:center;border-radius:10px;background:#eaf2fc;color:#123c73;font-size:12px;font-weight:700}.section-primary,.section-ghost,.section-danger{display:flex;width:100%;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 12px;border-radius:22px;font-size:14px}.section-primary{border:0;background:#123c73;color:#fff}.section-ghost{border:1px solid #7c8ea5;background:#fff;color:#123c73}.section-danger{border:1px solid #c83f42;background:#fff;color:#c83f42}.picker-control{display:flex;align-items:center}.file-row,.history-row{padding:10px 0;border-top:1px solid #e6ebf2}.file-actions,.two-actions{display:grid;margin-top:8px;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.review-row{display:flex;min-height:44px;align-items:center;justify-content:space-between;border-top:1px solid #e6ebf2;color:#51657d;font-size:13px}.review-row text:last-child{color:#18283f;font-weight:700}@media(max-width:360px){.entry-tab{font-size:12px}.roster-row{grid-template-columns:minmax(0,1fr) 60px}.jersey-field{width:60px}}
.entry-readonly{display:flex;align-items:center}.entry-step{display:flex;width:100%;min-height:55px;align-items:center;gap:8px}.entry-step+.entry-step{border-top:1px solid #e6ebf2}.step-no{display:flex;width:20px;height:20px;flex:none;align-items:center;justify-content:center;border-radius:10px;background:#eaf2fc;color:#123c73;font-size:11px}
.entry-page .entry-tabs>.entry-tab{width:100%;min-width:0;max-width:none;justify-self:stretch;box-sizing:border-box}
