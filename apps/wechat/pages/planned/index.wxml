<scb-header title="服务规则" disabled="{{busy}}"/>
<view class="figma-page planned-rebuild">
  <view class="figma-page__content figma-page__content--actions">
    <view class="figma-summary">
      <view class="figma-summary__icon"><figma-icon name="receipt" size="28"/></view>
      <view class="figma-summary__copy"><view class="figma-eyebrow">费用与履约</view><view class="figma-title">预约费用怎样计算</view><view class="figma-subtitle">逐项解释确定报价、原订单与处理进度</view></view>
    </view>
    <figma-tabs key1="funds" label1="费用规则" key2="payment" label2="支付核对" key3="refund" label3="取消退款" key4="settlement" label4="结算" active="{{selected === 'unknown' ? 'payment' : selected}}" bind:change="select"/>

    <block wx:if="{{selected === 'funds'}}">
      <view class="figma-section">
        <view class="figma-section__title">确定场次报价</view>
        <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">参赛服务费</view><view class="figma-row__subtitle">按人、场次展示</view></view><view class="planned-value">按约定</view></view>
        <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">平台费</view><view class="figma-row__subtitle">仅按参赛服务费计算</view></view><view class="planned-value">按原条款</view></view>
        <view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">交通与食宿</view><view class="figma-row__subtitle">单列协商金额</view></view><view class="planned-value">按确认</view></view>
        <view class="figma-section__title">条件意向</view>
        <view class="planned-callout"><view class="planned-dot"/><view><view class="figma-row__title">未确认的需求</view><view class="figma-row__subtitle">暂不占用球员档期</view></view></view>
        <view class="planned-callout"><view class="planned-dot"/><view><view class="figma-row__title">条件报价</view><view class="figma-row__subtitle">和确定场次分别展示</view></view></view>
      </view>
      <view class="figma-section"><view class="figma-section__title">原单查询</view><button class="figma-row" data-page="trade-order" bindtap="go"><view class="figma-row__copy"><view class="figma-row__title">付款状态</view><view class="figma-row__subtitle">核对服务端原订单及渠道记录</view></view><view class="figma-status figma-status--orange">查看</view></button><button class="figma-row" data-page="trade-order" bindtap="go"><view class="figma-row__copy"><view class="figma-row__title">退款进度</view><view class="figma-row__subtitle">关闭合作后另查退款结果</view></view><view class="figma-status figma-status--orange">查看</view></button><view class="figma-section__hint">本页不读取资金，不显示假定实收、退款或结算金额。</view></view>
    </block>

    <block wx:elif="{{selected === 'payment'}}">
      <view class="figma-section"><view class="figma-section__title">支付前核对</view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">费用明细</view><view class="figma-row__subtitle">逐人逐场服务费、平台费与交通食宿</view></view></view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">交易主体</view><view class="figma-row__subtitle">核对收款主体与取消退款规则</view></view></view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">当前渠道</view><view class="figma-row__subtitle">未启用时原订单保留关闭状态</view></view></view></view>
      <view class="planned-warning"><view class="figma-row__title">付款请进入原订单</view><view class="figma-row__subtitle">真实付款入口按本人权限与当前渠道能力开放；本说明不执行支付。</view></view>
      <button class="figma-action figma-action--ghost" data-key="unknown" bindtap="select">查看支付结果待核验状态</button>
    </block>

    <block wx:elif="{{selected === 'unknown'}}">
      <view class="figma-summary figma-summary--navy"><view class="figma-summary__copy"><view class="figma-title">先核对交易结果</view><view class="figma-subtitle">未知结果不等于付款失败</view></view></view>
      <view class="figma-section"><view class="figma-section__title">原付款核对规则</view><view class="figma-row__subtitle">以支付渠道与服务端核验结果为准，不凭客户端返回自行改为已支付。</view></view>
      <view class="planned-warning"><view class="figma-row__title">核对期间避免重复付款</view><view class="figma-row__subtitle">原交易编号关联原订单；查单请进入原订单。</view></view>
    </block>

    <block wx:elif="{{selected === 'refund' && !refundProgress}}">
      <view class="figma-section"><view class="figma-section__title">逐场选择处理范围</view><view class="figma-row__subtitle">按原订单选择要处理的球员与场次，不影响其他有效履约项。</view></view>
      <view class="figma-section"><view class="figma-section__title">退款核对区</view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">实付与可退</view><view class="figma-row__subtitle">已结算部分分别核对</view></view></view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">取消与退款</view><view class="figma-row__subtitle">取消合作不等于退款到账</view></view></view><button class="figma-action figma-action--ghost" bindtap="showRefundProgress">查看退款进度规划</button></view>
    </block>

    <block wx:elif="{{selected === 'refund' && refundProgress}}">
      <view class="figma-summary figma-summary--navy"><view class="figma-summary__copy"><view class="figma-title">退款进度以核验结果为准</view><view class="figma-subtitle">申请 → 审核 → 渠道处理 → 到账核验</view></view></view>
      <view class="figma-section"><view class="figma-section__title">状态设计</view><view class="figma-row__subtitle">处理中展示原交易与退款编号；失败展示原因和可重试入口；到账只在渠道与服务端核验后显示。</view></view>
      <view class="planned-warning"><view class="figma-row__title">本页不读取真实退款</view><view class="figma-row__subtitle">请进入原资金订单核对原退款及渠道记录。</view></view>
    </block>

    <block wx:elif="{{selected === 'settlement'}}">
      <view class="figma-section"><view class="figma-section__title">结算应逐项核对</view><view class="figma-row__subtitle">参赛服务收入、平台费用、交通食宿、退款、争议冻结、待结算与已结算分开。</view><view class="planned-stat-grid"><view><view class="planned-value">以原单为准</view><view class="figma-caption">实际收款</view></view><view><view class="planned-value">以原单为准</view><view class="figma-caption">实际结算</view></view></view></view>
      <view class="planned-warning"><view class="figma-row__title">实际分账按商户能力开放</view><view class="figma-row__subtitle">不显示虚假可提现余额；结算请进入原订单。</view></view>
    </block>

    <block wx:elif="{{selected === 'messages'}}">
      <view class="figma-section"><view class="figma-section__title">预约与赛事动态</view><view class="figma-row__subtitle">收到预约、对方变更提议与处理结果；点击后读取当前真实订单状态。</view><button class="figma-action figma-action--ghost" data-page="follows" bindtap="go">查看我的关注</button><button class="figma-action figma-action--ghost" data-page="messages" bindtap="go">查看本人消息</button></view>
      <view class="planned-warning"><view class="figma-row__title">站内消息可查看，微信提醒按能力开放</view><view class="figma-row__subtitle">收藏赛事不会自动授权微信订阅消息。</view></view>
    </block>

    <block wx:elif="{{selected === 'profile'}}">
      <view class="figma-summary figma-summary--navy"><view class="figma-summary__copy"><view class="figma-title">长期档案与本届数据</view><view class="figma-subtitle">本人资料与已授权来源分别标示</view></view></view>
      <view class="figma-section"><view class="figma-section__title">专业数据边界</view><view class="figma-row__subtitle">篮板、助攻、上场时间与命中率仅展示已采集且当前有权读取的数据；未统计保持未统计。</view><button class="figma-action figma-action--ghost" data-page="performance" bindtap="go">查看本人授权记录</button></view>
    </block>

    <button class="figma-action figma-action--ghost" bindtap="toggleOptions">{{optionsOpen ? '收起规则说明目录' : '查看其他服务规则说明'}}</button>
    <view wx:if="{{optionsOpen}}" class="figma-section"><view class="figma-section__title">规则说明目录</view><view class="figma-section__hint">仅查看说明，不会触发资金或消息操作。</view><view class="planned-directory"><button wx:for="{{options}}" wx:key="key" class="planned-option {{selected === item.key ? 'is-active' : ''}}" data-key="{{item.key}}" bindtap="select">{{item.label}}</button></view></view>
  </view>

  <view class="figma-fixed-actions">
    <button class="figma-action figma-action--ghost" data-key="refund" bindtap="select">查看退款规则</button>
    <button wx:if="{{selected === 'funds' || selected === 'messages'}}" class="figma-action figma-action--orange" data-page="trade-order" bindtap="go">查看本人实际订单</button>
    <button wx:elif="{{selected === 'profile'}}" class="figma-action figma-action--orange" data-page="performance" bindtap="go">查看本人授权记录</button>
    <button wx:else class="figma-action figma-action--orange" disabled>{{selected === 'payment' ? '本说明不执行支付' : selected === 'unknown' ? '查单请进入原订单' : selected === 'refund' ? '退款请进入原订单' : '结算请进入原订单'}}</button>
  </view>
</view>
