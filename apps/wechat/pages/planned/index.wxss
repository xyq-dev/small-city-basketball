@import "../../styles/figma-pages.wxss";

.planned-value {
  flex: none;
  color: #123c73;
  font-size: 15px;
  font-weight: 700;
  line-height: 22px;
}

.planned-callout,
.planned-warning {
  display: flex;
  width: 100%;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 10px;
  background: #eaf2fc;
}

.planned-warning {
  display: block;
  background: #fff1e2;
}

.planned-callout > view:last-child {
  min-width: 0;
  flex: 1;
}

.planned-dot {
  width: 7px;
  height: 7px;
  flex: none;
  border-radius: 50%;
  background: #123c73;
}

.planned-stat-grid,
.planned-directory {
  display: grid;
  width: 100%;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.planned-stat-grid > view {
  padding: 12px;
  border-radius: 10px;
  background: #f4f6fa;
}

.planned-rebuild .planned-option {
  display: flex;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  padding: 8px;
  border: 1px solid #e6ebf2;
  border-radius: 12px;
  background: #ffffff;
  color: #123c73;
  font-size: 13px;
  line-height: 18px;
}

.planned-rebuild .planned-option.is-active {
  border-color: #123c73;
  background: #eaf2fc;
}
