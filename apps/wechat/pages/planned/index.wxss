.plan-card { display:flex; flex-direction:column; gap:8px; padding:16px; margin-bottom:16px; }
.plan-card .subtitle { margin:0; font-size:18px; line-height:28px; font-weight:500; }
.plan-card > view:not(.subtitle) { color:#617286; font-size:14px; line-height:24px; }
.plan-notice { display:flex; flex-direction:column; gap:4px; padding:16px; }
.plan-notice-title { font-size:14px; line-height:24px; font-weight:500; }
.plan-hero { display:flex; flex-direction:column; gap:12px; padding:24px; }
.plan-hero .title { margin:0; font-size:22px; line-height:34px; }
.plan-hero .muted { color:#fff; font-size:14px; line-height:24px; }
.plan-menu-toggle { margin-bottom:16px; }
.plan-menu .subtitle { margin-bottom:8px; }
.plan-options { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; margin-top:16px; }
.plan-options button { width:100%; min-width:0; margin:0; font-size:14px; line-height:24px; }
.plan-options .option-selected { background:#eaf0f7; font-weight:500; }
.plan-stat-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; margin-bottom:16px; }
.plan-stat { padding:24px 16px; border-radius:16px; background:#fff; }
.plan-stat .numeric { font-size:34px; line-height:44px; margin-bottom:8px; }
.plan-categories { display:flex; align-items:center; gap:8px; min-height:44px; margin-bottom:16px; color:#617286; font-size:14px; line-height:24px; }
.plan-categories text { display:block; }
.selected-category { display:flex; align-items:center; align-self:stretch; background:#eaf0f7; border-radius:8px; color:#132c49; }

.ui002-workspace { padding:16px 16px calc(104px + env(safe-area-inset-bottom)); background:#f4f6fa; color:#18283f; }
.ui002-workspace .card { border-radius:16px; padding:16px; margin:0 0 16px; }
.ui002-workspace input,.ui002-workspace textarea,.ui002-workspace button { font-size:16px; line-height:24px; min-height:44px; }
.ui002-workspace .page-intro .title { color:#18283f; font-size:22px; line-height:32px; margin:0 0 8px; }
.ui002-workspace .page-intro { margin-bottom:16px; }
.ui002-workspace .tabs button { min-height:44px; }

.ui002-workspace .notice { font-size:14px; line-height:22px; border-radius:12px; padding:12px; }
.planned-summary { color:#18283f; }
.planned-summary-icon { display:flex; align-items:center; justify-content:center; flex:0 0 44px; width:44px; height:44px; border-radius:12px; background:#eaf2fc; }
.planned-summary-icon image { width:25px; height:25px; }
.planned-tabs { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1px; min-height:44px; margin-bottom:12px; padding:0 3px; border-radius:12px; background:#fff; }
.planned-tabs button { min-width:0; height:44px; min-height:44px; margin:0; padding:0 2px; border-radius:10px; background:#fff; color:#63758b; font-size:11px; line-height:16px; font-weight:400; }
.planned-tabs button::after { border:0; }
.planned-tabs button.selected { color:#fff; background:#123c73; font-weight:700; }
.planned-page { padding-bottom:calc(104px + env(safe-area-inset-bottom)); }
.planned-secondary-actions { margin:0 16px 96px; padding:14px; border-radius:16px; background:#fff; }
.planned-secondary-actions button { width:100%; min-height:44px; margin:0 0 8px; }
.planned-secondary-actions button:last-child { margin-bottom:0; }
@media (max-width:360px) { .fig-actions button { padding-left:6px; padding-right:6px; font-size:13px; } }
