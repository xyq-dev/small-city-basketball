.governance-page {
  padding-bottom: 40rpx;
}
.tabs {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}
.tabs button {
  flex: 1;
  min-width: 160rpx;
}
.message {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e7edf5;
  white-space: pre-wrap;
  word-break: break-all;
}
.picker {
  padding: 24rpx 0;
  color: #123c73;
}
textarea,
input {
  box-sizing: border-box;
  width: 100%;
  margin: 16rpx 0;
  padding: 20rpx;
  background: #f4f6fa;
  border-radius: 12rpx;
  font-size: 16px;
  line-height: 24px;
  min-height: 44px;
}
textarea {
  min-height: 160rpx;
}
.card button {
  margin-top: 12rpx;
  white-space: normal;
  word-break: break-all;
}

.ui002-workspace { padding:16px 16px calc(104px + env(safe-area-inset-bottom)); background:#f4f6fa; color:#18283f; }
.ui002-workspace .card { border-radius:16px; padding:16px; margin:0 0 16px; }
.ui002-workspace input,.ui002-workspace textarea,.ui002-workspace button { font-size:16px; line-height:24px; min-height:44px; }
.ui002-workspace .page-intro .title { color:#18283f; font-size:22px; line-height:32px; margin:0 0 8px; }
.ui002-workspace .page-intro { margin-bottom:16px; }
.ui002-workspace .tabs button { min-height:44px; }

.ui002-workspace .notice { font-size:14px; line-height:22px; border-radius:12px; padding:12px; }
.governance-summary { color:#18283f; }
.governance-summary-icon { display:flex; align-items:center; justify-content:center; flex:0 0 44px; width:44px; height:44px; border-radius:12px; background:#eaf2fc; }
.governance-summary-icon image { width:25px; height:25px; }
.governance-tabs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1px; flex-wrap:nowrap; min-height:44px; margin-bottom:12px; padding:0 3px; border-radius:12px; background:#fff; }
.governance-tabs button { width:auto; min-width:0; height:44px; min-height:44px; margin:0; padding:0 4px; border-radius:10px; font-size:13px; line-height:20px; box-shadow:none; }
.governance-tabs button::after { border:0; }
.governance-create { padding:14px !important; }
