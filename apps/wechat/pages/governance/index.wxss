@import "../../styles/figma-pages.wxss";
.governance-tabs{display:flex;width:100%;min-height:48px;padding:2px;border-radius:12px;background:#fff}.governance-tabs button{display:flex;min-width:0;min-height:44px;flex:1;align-items:center;justify-content:center;padding:0 8px;border:0;border-radius:10px;background:transparent;color:#51657d;font-size:14px}.governance-tabs button.is-active{background:#123c73;color:#fff}.governance-detail-head{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}.governance-detail-head>view{min-width:0;flex:1}.governance-rebuild .governance-text-action{display:flex;width:auto;min-height:44px;align-items:center;padding:0;border:0;background:transparent;color:#123c73;font-size:13px;text-align:left}.governance-message{padding:10px 12px;border-radius:10px;background:#f4f6fa;color:#18283f;font-size:13px;line-height:20px}.governance-switch{display:flex;min-height:44px;align-items:center;gap:8px;color:#18283f;font-size:13px}.governance-picker{display:flex;align-items:center}
