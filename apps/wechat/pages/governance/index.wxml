<scb-header title="客服与治理" disabled="{{busy}}"/>
<view class="figma-page governance-rebuild">
  <view class="figma-page__content figma-page__content--actions">
    <view class="figma-summary"><view class="figma-summary__icon"><figma-icon name="governance" size="28"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">本人事项与分派任务</view><view class="figma-title">服务支持中心</view><view class="figma-subtitle">围绕实际赛事或订单提交支持事项</view></view></view>
    <view wx:if="{{!loginRequired}}" class="governance-tabs"><button class="{{mode === 'mine' ? 'is-active' : ''}}" data-mode="mine" bindtap="changeMode" disabled="{{busy}}">我的工单</button><button class="{{mode === 'assigned' ? 'is-active' : ''}}" data-mode="assigned" bindtap="changeMode" disabled="{{busy}}">分派给我</button><button wx:if="{{isOperator}}" class="{{mode === 'platform' ? 'is-active' : ''}}" data-mode="platform" bindtap="changeMode" disabled="{{busy}}">平台分派</button></view>
    <figma-skeleton wx:if="{{loading && !items.length}}" rows="4"/>
    <figma-feedback wx:if="{{loginRequired}}" type="warning" title="登录后查看支持事项" body="仅显示本人或明确分派给当前账号的工单。" action-label="登录" bind:action="login"/>
    <figma-feedback wx:if="{{error}}" type="error" title="工单读取或操作失败" body="{{error}}" action-label="刷新当前状态" disabled="{{busy}}" bind:action="load"/>
    <figma-feedback wx:if="{{notice}}" type="success" title="工单状态已更新" body="{{notice}}"/>
    <figma-feedback wx:if="{{pending}}" type="warning" title="有原操作待核对" body="不能更换编号重发；先查询或明确放弃原操作。" action-label="查询原操作" disabled="{{busy}}" bind:action="recover"/>
    <button wx:if="{{pending}}" class="figma-action figma-action--ghost" data-cancel="true" bindtap="recover" disabled="{{busy}}">明确放弃原请求</button>

    <block wx:if="{{selected}}">
      <view class="figma-section"><view class="governance-detail-head"><view><view class="figma-section__title">{{selected.title}}</view><view class="figma-section__hint">{{selected.statusLabel}} · 第 {{selected.version}} 版</view></view><button class="governance-text-action" bindtap="load" disabled="{{busy}}">返回列表</button></view><button wx:if="{{selected.messagesBefore}}" class="governance-text-action" bindtap="history" disabled="{{busy}}">读取更早记录</button><view wx:for="{{selected.messages}}" wx:key="id" class="governance-message"><view class="figma-caption">{{item.createdAt}} · {{item.visibility === 'INTERNAL' ? '内部记录' : '双方可见'}}</view><view>{{item.body}}</view></view><button wx:for="{{selected.attachments}}" wx:key="id" class="figma-action figma-action--ghost" data-id="{{item.id}}" bindtap="preview">查看私有附件：{{item.fileName}}</button></view>
      <view wx:if="{{selected.capabilities.canReply}}" class="figma-section"><view class="figma-section__title">补充与回复</view><view class="figma-field-group"><view class="figma-field-label">回复内容</view><textarea class="figma-field-control" data-field="replyText" bindinput="field" value="{{replyText}}" maxlength="4000" placeholder="补充说明或处理回复"/></view><label wx:if="{{selected.capabilities.canResolve || selected.capabilities.canAssign}}" class="governance-switch"><switch checked="{{internal}}" bindchange="internal"/><text>仅处理人员可见</text></label><button class="figma-action figma-action--navy" disabled="{{busy || !!pending}}" bindtap="reply">提交回复</button><button class="figma-action figma-action--ghost" disabled="{{busy || !!pending}}" bindtap="choose">选择 JPEG、PNG 或 PDF 附件</button><view wx:if="{{chosenFile}}" class="figma-caption">{{chosenFile}}</view><button wx:if="{{chosenFile}}" class="figma-action figma-action--ghost" disabled="{{busy || !!pending}}" bindtap="upload">上传私有附件</button></view>
      <view wx:if="{{selected.capabilities.canAssign || selected.capabilities.canResolve || selected.capabilities.canClose || selected.capabilities.canReopen}}" class="figma-section"><view class="figma-section__title">处理工单</view><view class="figma-field-group"><view class="figma-field-label">操作原因（至少 4 字）</view><textarea class="figma-field-control" data-field="reason" bindinput="field" value="{{reason}}" maxlength="500"/></view><block wx:if="{{selected.capabilities.canAssign}}"><picker range="{{assignees}}" range-key="displayName" value="{{assigneeIndex}}" bindchange="assignee"><view class="figma-field-control governance-picker">处理人：{{assignees.length ? assignees[assigneeIndex].displayName : '暂无合格处理人'}}</view></picker><button class="figma-action figma-action--ghost" data-type="ASSIGN" disabled="{{busy || !!pending || !assignees.length}}" bindtap="command">明确分派</button></block><button wx:if="{{selected.capabilities.canResolve}}" class="figma-action figma-action--navy" data-type="RESOLVE" disabled="{{busy || !!pending}}" bindtap="command">提交处理结论</button><button wx:if="{{selected.capabilities.canClose}}" class="figma-action figma-action--ghost" data-type="CLOSE" disabled="{{busy || !!pending}}" bindtap="command">关闭工单</button><button wx:if="{{selected.capabilities.canReopen}}" class="figma-action figma-action--ghost" data-type="REOPEN" disabled="{{busy || !!pending}}" bindtap="command">重新打开</button><button wx:if="{{selected.capabilities.canReopen}}" class="governance-text-action" bindtap="appeal">提交独立申诉</button></view>
    </block>

    <block wx:else>
      <view class="figma-section"><view class="figma-section__title">当前工单</view><figma-feedback wx:if="{{!figmaGovernancePreview && !loading && !items.length && !loginRequired}}" type="empty" title="当前没有可查看的工单"/><button wx:for="{{items}}" wx:key="id" class="figma-row" data-id="{{item.id}}" bindtap="select"><view class="figma-row__copy"><view class="figma-row__title">{{item.title}}</view><view class="figma-row__subtitle">{{item.createdAt}}</view></view><view class="figma-status figma-status--orange">{{item.statusLabel}}</view></button><button wx:if="{{nextCursor}}" class="figma-action figma-action--ghost" disabled="{{loading || busy}}" bindtap="more">读取更多</button></view>
      <view wx:if="{{!loginRequired}}" class="figma-section"><view class="figma-section__title">提交事项</view><block wx:if="{{figmaGovernancePreview}}"><view class="figma-field-group"><view class="figma-field-label">问题类别</view><view class="figma-field-control governance-picker"><text>支持 / 举报 / 申诉</text><view class="figma-status figma-status--orange">必选</view></view></view><view class="figma-field-group"><view class="figma-field-label">关联来源</view><view class="figma-field-control governance-picker">从具体赛事或订单进入</view></view><view class="figma-field-group"><view class="figma-field-label">情况说明 *</view><view class="figma-field-control governance-picker">填写需要核对的信息</view></view></block><block wx:else><view class="figma-field-group"><view class="figma-field-label">问题类别</view><picker range="{{kinds}}" value="{{kindIndex}}" bindchange="kind"><view class="figma-field-control governance-picker">{{kinds[kindIndex]}}</view></picker></view><view class="figma-field-group"><view class="figma-field-label">关联来源</view><view class="figma-field-control governance-picker">从具体赛事或订单进入</view></view><view wx:if="{{organizations.length}}" class="figma-field-group"><view class="figma-field-label">收件机构</view><picker range="{{organizations}}" range-key="name" value="{{orgIndex}}" bindchange="org"><view class="figma-field-control governance-picker">{{organizations[orgIndex].name}}</view></picker></view><view wx:if="{{regions.length}}" class="figma-field-group"><view class="figma-field-label">相关地区</view><picker range="{{regions}}" range-key="path" value="{{regionIndex}}" bindchange="region"><view class="figma-field-control governance-picker">{{regionIndex >= 0 ? regions[regionIndex].path : '可选，用于有限城市分派'}}</view></picker></view><view class="figma-field-group"><view class="figma-field-label">工单标题</view><input class="figma-field-control" data-field="title" value="{{title}}" bindinput="field" maxlength="120" placeholder="关联具体事项"/></view><view class="figma-field-group"><view class="figma-field-label">情况说明 *</view><textarea class="figma-field-control" data-field="body" value="{{body}}" bindinput="field" maxlength="4000" placeholder="填写需要核对的信息；不要填写密码或无关证件"/></view></block></view>
      <view wx:if="{{!loginRequired}}" class="figma-section"><view class="figma-section__title">资料可见性</view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">附件</view><view class="figma-row__subtitle">JPEG、PNG 或 PDF，私有保存</view></view><view class="figma-status">私有</view></view><view class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">处理进度</view><view class="figma-row__subtitle">本人及明确分派的人员查看</view></view><view class="figma-status figma-status--orange">受限</view></view></view>
    </block>
  </view>
  <view wx:if="{{!selected && !loginRequired}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost" data-mode="mine" bindtap="changeMode">查看我的工单</button><button class="figma-action figma-action--orange" bindtap="create" disabled="{{busy || !!pending}}">提交支持事项</button></view>
</view>
