@import "../../styles/figma-pages.wxss";

.join-code{font-family:monospace;letter-spacing:1px}.section-primary,.section-ghost{display:flex;width:100%;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 12px;border-radius:22px;font-size:14px}.section-primary{border:0;background:#123c73;color:#fff}.section-ghost{border:1px solid #7c8ea5;background:#fff;color:#123c73}.section-primary::after,.section-ghost::after{border:0}.two-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.claim-row{padding:10px 0;border-top:1px solid #e6ebf2}.claim-head{display:flex;min-height:44px;align-items:center;justify-content:space-between;gap:8px}
.join-notice{display:flex;width:100%;min-height:55px;align-items:center;gap:9px;padding:0 10px;border-radius:8px;background:#eaf2fc}.join-notice__mark{width:7px;height:7px;flex:none;border-radius:4px;background:#123c73}
