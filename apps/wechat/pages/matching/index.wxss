/* UI001 NM01–NM07: the existing route hosts each step and preserves API state. */
.match-hero{padding:8px 0 16px;margin-bottom:8px}.match-hero .title{font-size:24px;line-height:34px}.match-hero .eyebrow{color:#123c73;font-size:12px;line-height:18px;margin-bottom:8px}.match-actions{display:flex;gap:8px;flex-wrap:wrap}.match-actions button{flex:1;min-width:110px;white-space:normal}.match-row{text-align:left;margin-bottom:12px;width:100%}.match-score{font-size:28px;line-height:34px;font-weight:700;color:#123c73;flex-shrink:0}.match-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px}.match-grid>view{min-width:0}.match-window{padding:12px;border:1px solid #eaf0f8;border-radius:12px;margin:12px 0}.match-card{background:#fff;border-radius:16px;padding:16px;border:1px solid #eaf0f8}.match-check{display:block;padding:12px 0;line-height:24px}.match-sep{border-top:1px solid #eaf0f8;padding-top:16px;margin-top:16px}.match-empty{padding:24px 16px;text-align:center;color:#63758b;font-size:14px;line-height:22px}.match-scope{display:flex;gap:8px;flex-wrap:wrap}.match-scope button{width:auto;font-size:14px;min-height:44px}.match-private{padding-bottom:calc(40px + env(safe-area-inset-bottom));word-break:break-word}.match-back{width:100%;text-align:left;color:#123c73;margin:8px 0 16px;background:#eaf0f8}.match-private .workflow-tabs{display:flex;gap:8px;margin:16px 0;flex-wrap:wrap}.match-private .workflow-tabs button{flex:1;min-width:105px;min-height:48px;font-size:14px;line-height:22px;padding:12px;background:#eaf0f8;color:#123c73;white-space:normal}.match-private .workflow-tabs .active{background:#123c73;color:#fff}.match-private .status-banner{background:#eaf0f8;border-radius:12px;padding:12px;margin:16px 0;color:#123c73;font-size:14px;line-height:22px}.match-private .field{font-size:16px;min-height:48px;box-sizing:border-box;width:100%}.match-private .row-between>view{min-width:0}.match-private .money{white-space:normal}.match-private .card{border-radius:16px}
.match-private{padding:12px 16px calc(124px + env(safe-area-inset-bottom))}.match-private .card{padding:14px;box-shadow:none}.match-private .workflow-tabs{gap:1px;margin:12px 0;padding:2px 3px;border-radius:12px;background:#fff}.match-private .workflow-tabs button{min-height:44px;min-width:0;margin:0;padding:9px 8px;border-radius:10px;background:transparent;color:#63758b;font-size:13px}.match-private .workflow-tabs .active{background:#123c73;color:#fff}.match-intro{margin-bottom:12px}.match-section-title{margin-top:16px}
