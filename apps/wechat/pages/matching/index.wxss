@import "../../styles/figma-pages.wxss";
.danger-action{border-color:#d97474;color:#a83b31}
.display-row{display:flex;min-height:110rpx;align-items:center;justify-content:space-between;gap:16rpx;padding:16rpx 20rpx;border:1rpx solid #7c8ea5;border-radius:24rpx}.display-row__copy{min-width:0;flex:1}.display-row__value{color:#18283f;font-size:30rpx;line-height:44rpx;overflow-wrap:anywhere}.supplemental-controls{margin-top:8rpx}
.matching-page{padding-bottom:calc(124rpx + env(safe-area-inset-bottom))}.matching-summary{display:flex;align-items:flex-start;gap:24rpx}.summary-icon{display:flex;width:80rpx;height:80rpx;flex:none;align-items:center;justify-content:center;border-radius:24rpx;background:#fff}.back-action{display:flex;width:100%;min-height:88rpx;align-items:center;gap:12rpx;margin:0;text-align:left;background:transparent;color:#123c73;font-size:28rpx}.back-action__icon{width:32rpx;height:32rpx;flex:none}.back-action::after,.matching-tab::after,.step-tab::after,.detail-tab::after,.section-link::after,.row-link::after,.scope-chip::after{border:0}.matching-tabs,.step-tabs,.detail-tabs{display:flex;gap:8rpx;padding:8rpx;border-radius:28rpx;background:#e6ebf2}.matching-tab,.step-tab,.detail-tab{min-width:0;min-height:80rpx;flex:1;margin:0;padding:0 10rpx;border-radius:20rpx;background:transparent;color:#51657d;font-size:26rpx}.matching-tab.is-active,.step-tab.is-active,.detail-tab.is-active{background:#fff;color:#123c73;box-shadow:0 2rpx 6rpx rgba(18,60,115,.12)}.section-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.section-link,.row-link{min-width:88rpx;min-height:88rpx;margin:0;padding:0;background:transparent;color:#123c73;font-size:26rpx}.journey{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx}.journey-item{min-width:0;padding:20rpx;border-radius:20rpx;background:#f4f7fb;color:#51657d;font-size:24rpx;line-height:36rpx}.journey-item.is-active{background:#fff5e5;color:#243b57}.journey-dot{display:flex;width:48rpx;height:48rpx;align-items:center;justify-content:center;margin-bottom:12rpx;border-radius:50%;background:#dce3ec;font-weight:700}.journey-item.is-active .journey-dot{background:#f6a623;color:#18283f}.editor-section,.need-detail,.conversion-section{display:flex;flex-direction:column;gap:24rpx}.figma-field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.inline-actions{display:flex;flex-wrap:wrap;gap:16rpx}.inline-actions>.figma-action{min-width:160rpx;flex:1}.subsection,.review-summary,.figma-info{display:flex;flex-direction:column;gap:16rpx;padding:24rpx;border-radius:24rpx;background:#f4f7fb;color:#243b57;font-size:28rpx;line-height:44rpx}.window-card{display:flex;flex-direction:column;gap:16rpx;padding:20rpx;border:1rpx solid #dce3ec;border-radius:20rpx;background:#fff}.scope-chip{width:auto;min-height:72rpx;margin:0 12rpx 12rpx 0;padding:0 20rpx;border-radius:36rpx;background:#e9f2ff;color:#123c73;font-size:24rpx}.figma-check{display:flex;min-height:88rpx;align-items:center;gap:16rpx;font-size:28rpx;line-height:42rpx}.candidate-card{display:flex;align-items:flex-start;gap:24rpx;padding:24rpx;border:1rpx solid #dce3ec;border-radius:24rpx}.candidate-score{display:flex;width:96rpx;height:96rpx;flex:none;flex-direction:column;align-items:center;justify-content:center;border-radius:24rpx;background:#123c73;color:#fff;font-size:34rpx;font-weight:700}.candidate-score text{font-size:18rpx;font-weight:400}.candidate-copy{min-width:0;flex:1}.price-copy,.price-total{color:#9a5d0b;font-size:30rpx;font-weight:700}.cross-city{margin:12rpx 0;padding:16rpx;border-radius:16rpx;background:#fff1df;color:#764a0d;font-size:24rpx;line-height:36rpx}.intent-card{display:flex;flex-direction:column;gap:20rpx;padding:24rpx;border:1rpx solid #dce3ec;border-radius:24rpx}@media(max-width:340px){.figma-field-grid,.journey{grid-template-columns:1fr}.matching-tab,.step-tab,.detail-tab{font-size:23rpx;padding:0 4rpx}.candidate-card{display:block}.candidate-score{margin-bottom:20rpx}.inline-actions{display:grid;grid-template-columns:1fr}}
