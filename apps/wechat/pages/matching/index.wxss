.match-hero{background:linear-gradient(135deg,#132c49,#294969);color:white;border-radius:18px;padding:24px;margin-bottom:20px}.match-hero .title{color:white}.match-hero .muted{color:#dae5ef}.match-actions{display:flex;gap:8px;flex-wrap:wrap}.match-actions button{flex:1;min-width:110px}.match-row{text-align:left;margin-bottom:12px}.match-score{font-size:28px;line-height:34px}.match-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.match-window{padding:12px;border:1px solid #e8edf2;border-radius:10px;margin:10px 0}.match-card{border-left:3px solid #ff6b2d;padding-left:14px}.match-check{display:block;padding:12px 0}.match-sep{border-top:1px solid #e8edf2;padding-top:16px;margin-top:16px}.match-empty{padding:24px;text-align:center;color:#617286}.match-scope{display:flex;gap:6px;flex-wrap:wrap}.match-scope button{width:auto;font-size:12px}.match-private{padding-bottom:calc(100px + env(safe-area-inset-bottom))}
