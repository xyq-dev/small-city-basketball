<scb-header title="{{conversion ? '核对预约条款' : selected ? '候选与双方意向' : creating ? '发布篮球服务需求' : supplyOpen ? '发现与联系授权' : '全国撮合'}}" disabled="{{busy}}"/>
<view class="page match-private">
 <view class="page-intro match-hero"><view class="eyebrow">篮球服务 · 双方自主选择</view><view class="title">让合适的人，出现在合适的球场</view><view class="muted">成人球员 · 工作人员 · 球队约赛</view><view class="muted">先核对档期和预算，再交换意向；正式预约后才占席位。</view></view><button wx:if="{{selected || creating || supplyOpen}}" class="match-back" bindtap="overview" disabled="{{busy || loading}}">返回我的撮合</button>
 <button wx:if="{{loginRequired}}" class="primary" bindtap="login">登录查看我的撮合</button>
 <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view>
 <view wx:if="{{pending || pendingError}}" class="notice warning"><view>{{pendingError || '上次操作结果待核对。请保留原操作编号，避免重复预约。'}}</view><button bindtap="recover" disabled="{{busy || !pending}}">查询原操作回执</button><button bindtap="retry" disabled="{{busy || !pending}}">用原编号重试</button></view>
 <view wx:if="{{!loginRequired && !enabled && !loading}}" class="notice">撮合暂未开放。已保存的需求和意向仍可查询。</view>
 <view wx:if="{{!selected && !creating && !supplyOpen}}" class="match-actions"><button class="primary" bindtap="toggleCreate" disabled="{{busy || !enabled || pending || pendingError}}">发布需求</button><button bindtap="toggleSupply" disabled="{{busy || !enabled || pending || pendingError}}">管理发现与联系授权</button><button bindtap="load" disabled="{{busy || loading}}">刷新</button></view>
 <view wx:if="{{loading}}" class="notice">正在读取最新资料…</view>
 <view wx:if="{{creating || supplyOpen}}" class="card">
  <view class="subtitle">{{creating ? '明确需求，开始匹配' : '选择愿意参与撮合的资料'}}</view>
  <view wx:if="{{creating}}" class="workflow-tabs"><button class="{{formStep==='details'?'active':''}}" bindtap="editNeed" disabled="{{busy}}">1 填写需求</button><button class="{{formStep==='review'?'active':''}}" bindtap="reviewNeed" disabled="{{busy || pending || pendingError}}">2 审阅公开范围</button></view>
  <block wx:if="{{creating && formStep==='details'}}">
   <text class="field-label">需求类型</text><picker class="field" range="{{types}}" range-key="label" value="{{kindIndex}}" bindchange="changeKind" disabled="{{busy}}">{{types[kindIndex].label}}</picker>
   <block wx:if="{{types[kindIndex].value !== 'STAFF_SERVICE'}}"><text class="field-label">需求球队</text><picker class="field" range="{{teams}}" range-key="name" value="{{teamIndex}}" data-field="teamIndex" bindchange="choice" disabled="{{busy}}">{{teams[teamIndex].name || '暂无获得球队授权的球队'}}</picker><view wx:if="{{types[kindIndex].value==='TEAM_MATCHUP'}}" class="notice">球队约赛双方均需有效的球队管理授权。机构所有者或管理员也需先在球队管理中获得该授权，才能发布、接收和确认约赛。</view></block>
   <block wx:else><text class="field-label">需求机构</text><picker class="field" range="{{organizations}}" range-key="name" value="{{orgIndex}}" data-field="orgIndex" bindchange="choice" disabled="{{busy}}">{{organizations[orgIndex].name || '需要机构管理员身份'}}</picker></block>
   <text class="field-label">需求名称</text><input class="field" data-field="title" value="{{form.title}}" bindinput="input" maxlength="100" placeholder="例如：周六晚成人队补一名控卫" disabled="{{busy}}"/>
   <text class="field-label">合作角色</text><picker class="field" range="{{roles}}" range-key="label" value="{{roleIndex}}" data-field="roleIndex" bindchange="choice" disabled="{{busy}}">{{roles[roleIndex].label}}</picker>
   <view class="match-grid"><view><text class="field-label">需要人数 / 席位</text><input class="field" type="number" data-field="quantity" value="{{form.quantity}}" bindinput="input" disabled="{{busy || types[kindIndex].value==='TEAM_MATCHUP'}}"/></view><view><text class="field-label">每席总预算（元）</text><input class="field" type="digit" data-field="unitBudget" value="{{form.unitBudget}}" bindinput="input" disabled="{{busy || types[kindIndex].value==='TEAM_MATCHUP'}}"/></view><view><text class="field-label">整组预算上限（元）</text><input class="field" type="digit" data-field="totalBudget" value="{{form.totalBudget}}" bindinput="input" disabled="{{busy || types[kindIndex].value==='TEAM_MATCHUP'}}"/></view><view><text class="field-label">单程可接受分钟数</text><input class="field" type="number" data-field="travelMinutes" value="{{form.travelMinutes}}" bindinput="input" disabled="{{busy}}"/></view></view>
   <text class="field-label">明确比赛 / 服务场馆地址</text><input class="field" data-field="address" value="{{form.address}}" bindinput="input" maxlength="200" placeholder="只向收到意向的供给方展示" disabled="{{busy}}"/>
  </block>
  <block wx:if="{{supplyOpen}}"><picker class="field" range="{{sources}}" range-key="label" value="{{sourceIndex}}" bindchange="chooseSource" disabled="{{busy}}">{{sources[sourceIndex].label || '暂无已审核的本人资料'}}</picker><view class="muted">历史公开资料不会自动参与撮合。球员与工作人员档期沿用原资料；球队需要有效的球队管理授权，并在下方明确可约赛时段。</view><checkbox-group data-field="discovery" bindchange="check"><label class="match-check"><checkbox value="yes" checked="{{discovery}}" disabled="{{busy}}"/>允许在所选范围内被发现</label></checkbox-group><checkbox-group data-field="contact" bindchange="check"><label class="match-check"><checkbox value="yes" checked="{{contact}}" disabled="{{busy}}"/>允许需求方发送站内合作意向</label></checkbox-group></block>
  <block wx:if="{{supplyOpen || formStep==='details'}}"><view class="match-sep"><view class="section-title">地区与范围</view><view>地点：{{formRegion.label || selection.label}}</view><view class="muted">当前选择：{{selection.label}}。工作人员地点须与原服务资料一致。</view><view class="match-actions"><button bindtap="pickRegion" disabled="{{busy}}">选择地区</button><button bindtap="useRegion" disabled="{{busy}}">将当前地区设为地点</button><button bindtap="addRegion" disabled="{{busy}}">将当前地区加入范围</button></view><view class="muted">明确选择愿意合作的城市或区县；未加入任何范围时仅使用地点所在地区。</view><view class="match-scope"><button wx:for="{{scope}}" wx:key="regionId" data-index="{{index}}" bindtap="removeRegion" disabled="{{busy}}">{{item.label}} ×</button></view></view>
  <block wx:if="{{creating || sources[sourceIndex].kind==='TEAM_MATCHUP'}}"><view class="section-title match-sep">确定档期（北京时间）</view><view class="muted">需求在最早报到前1小时截止。多场需求同一席位由同一人完成，不自动增加预算。</view>
   <view class="match-window" wx:for="{{windows}}" wx:key="index"><view class="match-grid"><view><text class="field-label">报到 / 开赛日期</text><picker class="field" mode="date" value="{{item.date}}" data-index="{{index}}" data-field="date" bindchange="changeWindow">{{item.date}}</picker></view><view><text class="field-label">结束日期</text><picker class="field" mode="date" value="{{item.endDate}}" data-index="{{index}}" data-field="endDate" bindchange="changeWindow">{{item.endDate}}</picker></view><view><text class="field-label">报到</text><picker class="field" mode="time" value="{{item.report}}" data-index="{{index}}" data-field="report" bindchange="changeWindow">{{item.report}}</picker></view><view><text class="field-label">开赛 / 服务开始</text><picker class="field" mode="time" value="{{item.start}}" data-index="{{index}}" data-field="start" bindchange="changeWindow">{{item.start}}</picker></view><view><text class="field-label">结束</text><picker class="field" mode="time" value="{{item.end}}" data-index="{{index}}" data-field="end" bindchange="changeWindow">{{item.end}}</picker></view></view><button wx:if="{{windows.length > 1}}" data-index="{{index}}" bindtap="removeWindow" disabled="{{busy}}">移除此时段</button></view>
   <button wx:if="{{(creating && types[kindIndex].value==='ADULT_PLAYER') || supplyOpen}}" bindtap="addWindow" disabled="{{busy || windows.length>=64}}">增加确定时段</button>
  </block>
  </block><view wx:if="{{creating && formStep==='review'}}" class="status-banner"><view class="section-title">确认需求公开范围</view><view>{{form.title}} · {{types[kindIndex].label}}</view><view>地点：{{formRegion.label || selection.label}}</view><view>明确场馆地址：{{form.address}}</view><view>每席预算 ¥{{form.unitBudget}} · 总预算上限 ¥{{form.totalBudget}}</view><view wx:for="{{scope}}" wx:key="regionId">允许合作地区：{{item.label}}</view><view wx:if="{{!scope.length}}">合作范围仅使用地点所在地区。</view><view class="muted">地点、时段与预算会提供给收到意向的候选。未公开的联系方式不会自动分享，意向不锁位、不付款。</view></view>
  <checkbox-group wx:if="{{supplyOpen || formStep==='review'}}" data-field="adult" bindchange="check"><label class="match-check"><checkbox value="yes" checked="{{adult}}" disabled="{{busy}}"/>我确认参与者为成人，并有权发布本需求或本资料</label></checkbox-group>
  <button wx:if="{{creating && formStep==='details'}}" class="primary" bindtap="reviewNeed" disabled="{{busy || pending || pendingError}}">下一步：审阅公开范围</button><button wx:if="{{creating && formStep==='review'}}" class="primary" bindtap="create" disabled="{{busy || pending || pendingError}}">确认并发布需求</button><button wx:if="{{supplyOpen}}" class="primary" bindtap="savePreference" disabled="{{busy || pending || pendingError}}">保存发现与联系授权</button>
 </view>
 <block wx:if="{{!selected && !creating && !supplyOpen}}"><view class="workflow-tabs"><button class="{{workspaceTab==='needs'?'active':''}}" data-key="needs" bindtap="workspaceTab" disabled="{{busy || loading}}">我发布的需求 {{needs.length}}</button><button class="{{workspaceTab==='inbox'?'active':''}}" data-key="inbox" bindtap="workspaceTab" disabled="{{busy || loading}}">收到的意向 {{inbox.length}}</button></view><block wx:if="{{workspaceTab==='needs'}}"> <view class="subtitle">我发布的需求</view><button wx:for="{{needs}}" wx:key="id" class="card match-row" data-id="{{item.id}}" bindtap="select" disabled="{{busy}}"><view class="badge">{{item.kindText}} · {{item.statusText}}</view><view class="subtitle">{{item.title}}</view></button><view wx:if="{{!needs.length && !loading}}" class="card match-empty">暂无需求。发布一项明确的角色、时段和预算后开始匹配。</view>
</block><block wx:else> <view class="subtitle">收到的合作意向</view><button wx:for="{{inbox}}" wx:key="id" class="card match-row" data-id="{{item.needId}}" bindtap="select" disabled="{{busy}}"><view>{{item.title}}</view><view class="muted">{{item.kindText}} · {{item.statusText}}</view></button><view wx:if="{{!inbox.length && !loading}}" class="card match-empty">暂无收到的意向。可在上方按资料管理发现和联系授权。</view>
</block></block>
 <view wx:if="{{selected && !conversion}}" class="card">
  <view class="badge">{{selected.kindText}} · {{selected.statusText}}</view><view class="title">{{selected.title}}</view><view>{{selected.address}}</view><view class="money">{{selected.quantity}} 个席位 · 总预算 {{selected.budgetText}}</view><view wx:for="{{selected.windows}}" wx:key="reportAt" class="muted">{{item.label}}</view>
  <view wx:if="{{selected.canManage}}" class="match-actions match-sep"><button bindtap="run" disabled="{{busy || pending || selected.status!=='ACTIVE' || !enabled}}">重新匹配候选</button><button wx:if="{{selected.status==='ACTIVE'}}" data-type="PAUSE" bindtap="needCommand" disabled="{{busy || pending}}">暂停需求</button><button wx:if="{{selected.status==='PAUSED'}}" data-type="RESUME" bindtap="needCommand" disabled="{{busy || pending}}">恢复并重新匹配</button><button wx:if="{{selected.status==='ACTIVE' || selected.status==='PAUSED'}}" data-type="CLOSE" bindtap="needCommand" disabled="{{busy || pending}}">关闭需求</button></view>
  <view class="workflow-tabs"><button wx:if="{{selected.canManage}}" class="{{detailTab==='candidates'?'active':''}}" data-key="candidates" bindtap="detailTab" disabled="{{busy || loading}}">候选服务</button><button class="{{detailTab==='intents'?'active':''}}" data-key="intents" bindtap="detailTab" disabled="{{busy || loading}}">双方意向 {{selected.intents.length}}</button></view>
  <block wx:if="{{selected.canManage && detailTab==='candidates'}}"><view class="status-banner"><view class="section-title">{{selected.candidates.length}} 位候选 · 仅作推荐</view><view class="muted">资格、档期、地点和报价需在预约前再次核对。总价未知时不按低总价排序。</view></view>  <view class="section-title match-sep">席位与候选</view><view wx:if="{{selected.truncated}}" class="notice">当前最多展示100位候选。范围过大时采用有种子的抽样，未出现不代表不符合资格；可缩小范围后重新匹配。</view><picker wx:if="{{selected.canManage}}" class="field" range="{{selected.slots}}" range-key="label" value="{{seatIndex}}" data-field="seatIndex" bindchange="choice" disabled="{{busy}}">{{selected.slots[seatIndex].label}}</picker>
  <view wx:for="{{selected.slots}}" wx:key="id" class="row-between"><view>{{item.label}}<view class="muted">第 {{item.generation}} 次安排</view></view><button wx:if="{{selected.canManage && selected.status==='ACTIVE' && item.status==='CONVERTED'}}" class="inline" data-type="REOPEN_SLOT" data-id="{{item.id}}" bindtap="needCommand" disabled="{{busy || pending}}">原单结束后重开</button></view>
  <view wx:for="{{selected.candidates}}" wx:key="id" class="match-card match-sep"><view class="row-between"><view><view class="subtitle">{{item.name}}</view><view class="money">{{item.priceText}}</view><view class="badge">{{item.score.bandText}} · 覆盖 {{item.score.coverage}}%</view></view><view class="match-score">{{item.score.score}}<view class="muted">匹配分</view></view></view><view wx:for="{{item.score.reasons}}" wx:for-item="reason" wx:key="*this" class="muted">{{reason}}</view><view wx:if="{{item.crossCity}}" class="notice warning">跨地区候选：可以交流意向，需完成差旅与派单审核后才能预约。</view><button class="primary" data-id="{{item.id}}" bindtap="send" disabled="{{busy || pending || !enabled || selected.slots[seatIndex].status!=='OPEN'}}">向此候选发送意向</button></view>
  <view wx:if="{{selected.canManage && !selected.candidates.length}}" class="match-empty">暂无符合条件且允许联系的候选。可以确认档期、角色、授权范围和预算后重新匹配。</view>
</block><block wx:if="{{detailTab==='intents'}}">  <view class="section-title match-sep">双方意向</view><view wx:for="{{selected.intents}}" wx:key="id" class="match-sep"><view class="subtitle">{{item.candidate.name || '原候选资料已变化'}}</view><view>{{item.statusText}}</view><view class="muted">{{item.candidate.priceText}}</view><view class="match-actions"><button wx:if="{{item.canAccept}}" data-id="{{item.id}}" data-type="ACCEPT" bindtap="intentCommand" disabled="{{busy || pending || !enabled}}">有意愿合作</button><button wx:if="{{item.canAccept}}" data-id="{{item.id}}" data-type="DECLINE" bindtap="intentCommand" disabled="{{busy || pending || !enabled}}">婉拒</button><button wx:if="{{item.canWithdraw}}" data-id="{{item.id}}" data-type="WITHDRAW" bindtap="intentCommand" disabled="{{busy || pending || !enabled}}">撤回意向</button><button wx:if="{{item.canConvert}}" class="primary" data-id="{{item.id}}" bindtap="reviewConversion" disabled="{{busy || pending || !enabled}}">核对条款并转预约</button><button wx:if="{{item.sourceId}}" data-id="{{item.id}}" bindtap="openSource">查看原预约</button></view><view wx:if="{{item.status==='MUTUAL_INTEREST' && !item.canConvert}}" class="muted">转预约前需要确认当前权限、有效档期及报价；跨地区合作还需差旅派单确认。</view></view>
 <view wx:if="{{!selected.intents.length}}" class="match-empty">双方意向尚未建立。发送意向后，等待对方主动确认。</view></block>
 </view>
 <view wx:if="{{conversion}}" class="card"><button class="match-back" bindtap="closeConversion" disabled="{{busy || loading}}">返回双方意向</button><view class="subtitle">确认 {{conversion.candidate.name}} 的预约申请</view><view class="money">本席位总价 {{conversion.candidate.priceText}}</view><view wx:if="{{preview.enabled}}" class="notice"><view>收款方：{{preview.merchantName}}</view><view>{{preview.terms}}</view><checkbox-group data-field="chargeConsent" bindchange="check"><label class="match-check"><checkbox value="yes" checked="{{chargeConsent}}" disabled="{{busy}}"/>我已阅读并同意本次收费条款</label></checkbox-group></view><view wx:else class="notice">{{selected.kind === 'TEAM_MATCHUP' ? '约赛本身不另收费；场地仍按原预约约定执行。' : '收费准备尚未完成，暂不可转预约。'}}</view><block wx:if="{{selected.kind==='TEAM_MATCHUP'}}"><text class="field-label">本人已确认且时段一致的球场预约</text><picker class="field" range="{{courts}}" range-key="title" value="{{courtIndex}}" data-field="courtIndex" bindchange="choice">{{courts[courtIndex].title || '暂无符合条件的已确认球场预约'}}</picker><textarea class="field" data-field="terms" value="{{terms}}" bindinput="input" maxlength="1000" placeholder="明确比赛规则、人数、迟到、取消及天气约定" disabled="{{busy}}"/></block><checkbox-group data-field="eligibility" bindchange="check"><label class="match-check"><checkbox value="yes" checked="{{eligibility}}" disabled="{{busy}}"/>我已核对成人资格、服务时段与场地约定</label></checkbox-group><button class="primary" bindtap="convert" disabled="{{busy || pending || !enabled || (selected.kind!=='TEAM_MATCHUP' && !preview.enabled)}}">确认转为预约申请</button><view class="muted">原预约成功后占需求席位。接单、支付、退款和取消在原预约中继续处理。</view></view>
</view>
