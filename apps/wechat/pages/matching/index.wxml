<scb-header title="{{conversion ? '核对预约条款' : creating ? '发布服务需求' : supplyOpen ? '发现与联系授权' : '全国撮合'}}" disabled="{{busy}}"/>
<view class="scb-ui-page figma-page matching-page">
  <view class="figma-page__content">
    <view wx:if="{{!creating && !supplyOpen && !conversion}}" class="figma-summary matching-summary"><view class="summary-icon"><figma-icon name="matching" size="24"/></view><view><view class="figma-eyebrow">合作需求</view><view class="figma-title">全国撮合</view><view class="figma-subtitle">按实际地点、时间和预算推荐候选，由双方选择是否合作。</view></view></view>
    <figma-feedback wx:if="{{loginRequired}}" type="locked" title="登录后使用撮合" body="仅展示本人有权发布的需求和收到的意向。" action-label="登录" bind:action="login"/>
    <figma-feedback wx:if="{{pending || pendingError}}" type="warning" title="原操作结果待核对" body="{{pendingError || '请保留原操作编号，避免重复预约。'}}" action-label="查询回执" bind:action="recover"/>
    <button wx:if="{{pending}}" class="figma-action figma-action--ghost" bindtap="retry" disabled="{{busy}}">使用原编号重试</button>
    <figma-feedback wx:if="{{error}}" type="error" title="撮合读取失败" body="{{error}}" action-label="重新读取" bind:action="load"/>
    <figma-feedback wx:if="{{message}}" type="success" title="最新结果" body="{{message}}"/>
    <figma-feedback wx:if="{{!loginRequired && !enabled && !loading}}" type="closed" title="撮合暂未开放" body="已有需求和意向仍可查询，新的发布与转换暂停。"/>
    <figma-skeleton wx:if="{{loading}}" rows="4"/>

    <button wx:if="{{(selected && !conversion) || creating || supplyOpen}}" class="back-action" bindtap="overview" disabled="{{busy || loading}}"><image class="back-action__icon" src="/assets/approved-ui/icon-chevron-left-navy.png" mode="aspectFit" aria-hidden="true"/>返回我的撮合</button>

    <block wx:if="{{!selected && !creating && !supplyOpen}}">
      <view class="matching-tabs"><button class="matching-tab {{workspaceTab==='needs' ? 'is-active' : ''}}" data-key="needs" bindtap="workspaceTab" disabled="{{busy || loading}}">我的需求</button><button class="matching-tab {{workspaceTab==='inbox' ? 'is-active' : ''}}" data-key="inbox" bindtap="workspaceTab" disabled="{{busy || loading}}">收到意向</button><button class="matching-tab" bindtap="toggleSupply" disabled="{{busy || !enabled || pending || pendingError}}">接单授权</button></view>
      <view wx:if="{{workspaceTab==='needs'}}" class="figma-section"><view class="section-heading"><view><view class="figma-eyebrow">已发布 {{needs.length}}</view><view class="figma-section__title">当前需求</view></view><button class="section-link" bindtap="load" disabled="{{busy || loading}}">刷新</button></view><button wx:for="{{needs}}" wx:key="id" class="figma-row" data-id="{{item.id}}" bindtap="select" disabled="{{busy}}"><view class="figma-row__copy"><view class="figma-row__title">{{item.title}}</view><view class="figma-row__subtitle">{{item.kindText}}</view></view><view class="figma-status {{item.status==='ACTIVE' ? 'figma-status--orange' : ''}}">{{item.statusText}}</view></button><figma-feedback wx:if="{{!needs.length && !loading}}" type="empty" title="暂无需求" body="发布明确角色、时段、地区和预算后开始匹配。"/></view>
      <view wx:if="{{workspaceTab==='inbox'}}" class="figma-section"><view class="figma-eyebrow">收到 {{inbox.length}}</view><view class="figma-section__title">合作意向</view><button wx:for="{{inbox}}" wx:key="id" class="figma-row" data-id="{{item.needId}}" bindtap="select" disabled="{{busy}}"><view class="figma-row__copy"><view class="figma-row__title">{{item.title}}</view><view class="figma-row__subtitle">{{item.kindText}}</view></view><view class="figma-status figma-status--orange">{{item.statusText}}</view></button><figma-feedback wx:if="{{!inbox.length && !loading}}" type="empty" title="暂无收到的意向" body="可在接单授权中明确允许发现和站内联系的资料。"/></view>
      <view class="figma-section"><view class="figma-section__title">撮合转预约流程</view><view class="journey"><view class="journey-item is-active"><view class="journey-dot">1</view><view>发布明确需求</view></view><view class="journey-item"><view class="journey-dot">2</view><view>双方表达意向</view></view><view class="journey-item"><view class="journey-dot">3</view><view>再次核对并转预约</view></view></view><view class="figma-caption">意向不锁位、不付款；跨城候选还需完成差旅派单确认。</view></view>
    </block>

    <view wx:if="{{creating || supplyOpen}}" class="figma-section editor-section">
      <view class="figma-eyebrow">{{creating ? '发布需求' : '接单许可'}}</view><view class="figma-section__title">{{creating ? '明确本次合作条件' : '管理发现与联系授权'}}</view>
      <view wx:if="{{creating}}" class="step-tabs"><button class="step-tab {{formStep==='details' ? 'is-active' : ''}}" bindtap="editNeed" disabled="{{busy}}">1 填写需求</button><button class="step-tab {{formStep==='review' ? 'is-active' : ''}}" bindtap="reviewNeed" disabled="{{busy || pending || pendingError}}">2 审阅范围</button></view>
      <block wx:if="{{creating && formStep==='details'}}">
        <view class="figma-field-group"><view class="figma-field-label">需求类型</view><picker class="figma-field-control" range="{{types}}" range-key="label" value="{{kindIndex}}" bindchange="changeKind" disabled="{{busy}}">{{types[kindIndex].label}}</picker></view>
        <view wx:if="{{types[kindIndex].value !== 'STAFF_SERVICE'}}" class="figma-field-group"><view class="figma-field-label">需求球队</view><picker class="figma-field-control" range="{{teams}}" range-key="name" value="{{teamIndex}}" data-field="teamIndex" bindchange="choice" disabled="{{busy}}">{{teams[teamIndex].name || '暂无获得授权的球队'}}</picker></view>
        <view wx:else class="figma-field-group"><view class="figma-field-label">需求机构</view><picker class="figma-field-control" range="{{organizations}}" range-key="name" value="{{orgIndex}}" data-field="orgIndex" bindchange="choice" disabled="{{busy}}">{{organizations[orgIndex].name || '需要机构管理员身份'}}</picker></view>
        <view class="figma-field-group"><view class="figma-field-label">需求名称</view><input class="figma-field-control" data-field="title" value="{{form.title}}" bindinput="input" maxlength="100" placeholder="例如：周六晚成人队补一名控卫" disabled="{{busy}}"/></view>
        <view class="figma-field-group"><view class="figma-field-label">合作角色</view><picker class="figma-field-control" range="{{roles}}" range-key="label" value="{{roleIndex}}" data-field="roleIndex" bindchange="choice" disabled="{{busy}}">{{roles[roleIndex].label}}</picker></view>
        <view wx:if="{{types[kindIndex].value==='TEAM_MATCHUP'}}" class="figma-info">球队约赛双方均需有效的球队管理授权；机构所有者或管理员也需先在球队管理中获得该授权，机构成员身份不能代替球队授权。</view>
        <view class="figma-field-grid"><view class="figma-field-group"><view class="figma-field-label">人数 / 席位</view><input class="figma-field-control" type="number" data-field="quantity" value="{{form.quantity}}" bindinput="input" disabled="{{busy || types[kindIndex].value==='TEAM_MATCHUP'}}"/></view><view class="figma-field-group"><view class="figma-field-label">每席预算</view><input class="figma-field-control" type="digit" data-field="unitBudget" value="{{form.unitBudget}}" bindinput="input" disabled="{{busy || types[kindIndex].value==='TEAM_MATCHUP'}}"/></view><view class="figma-field-group"><view class="figma-field-label">总预算上限</view><input class="figma-field-control" type="digit" data-field="totalBudget" value="{{form.totalBudget}}" bindinput="input" disabled="{{busy || types[kindIndex].value==='TEAM_MATCHUP'}}"/></view><view class="figma-field-group"><view class="figma-field-label">单程分钟上限</view><input class="figma-field-control" type="number" data-field="travelMinutes" value="{{form.travelMinutes}}" bindinput="input" disabled="{{busy}}"/></view></view>
        <view class="figma-field-group"><view class="figma-field-label">比赛 / 服务场馆地址</view><input class="figma-field-control" data-field="address" value="{{form.address}}" bindinput="input" maxlength="200" placeholder="仅向收到意向的供给方展示" disabled="{{busy}}"/></view>
      </block>
      <block wx:if="{{supplyOpen}}"><view class="figma-field-group"><view class="figma-field-label">参与撮合的资料</view><picker class="figma-field-control" range="{{sources}}" range-key="label" value="{{sourceIndex}}" bindchange="chooseSource" disabled="{{busy}}">{{sources[sourceIndex].label || '暂无已审核本人资料'}}</picker></view><checkbox-group data-field="discovery" bindchange="check"><label class="figma-check"><checkbox value="yes" checked="{{discovery}}" disabled="{{busy}}"/>允许在所选范围内被发现</label></checkbox-group><checkbox-group data-field="contact" bindchange="check"><label class="figma-check"><checkbox value="yes" checked="{{contact}}" disabled="{{busy}}"/>允许需求方向我发送站内合作意向</label></checkbox-group></block>
      <block wx:if="{{supplyOpen || formStep==='details'}}"><view class="subsection"><view class="figma-row__title">地区与合作范围</view><view class="figma-caption">地点：{{formRegion.label || selection.label}} · 当前选择 {{selection.label}}</view><view class="inline-actions"><button class="figma-action figma-action--ghost" bindtap="pickRegion" disabled="{{busy}}">选择地区</button><button class="figma-action figma-action--ghost" bindtap="useRegion" disabled="{{busy}}">设为地点</button><button class="figma-action figma-action--ghost" bindtap="addRegion" disabled="{{busy}}">加入范围</button></view><button wx:for="{{scope}}" wx:key="regionId" class="scope-chip" data-index="{{index}}" bindtap="removeRegion" disabled="{{busy}}">{{item.label}} ×</button></view>
        <view wx:if="{{creating || sources[sourceIndex].kind==='TEAM_MATCHUP'}}" class="subsection"><view class="figma-row__title">确定档期（北京时间）</view><view wx:for="{{windows}}" wx:key="index" class="window-card"><view class="figma-field-grid"><picker class="figma-field-control" mode="date" value="{{item.date}}" data-index="{{index}}" data-field="date" bindchange="changeWindow">报到 {{item.date}}</picker><picker class="figma-field-control" mode="date" value="{{item.endDate}}" data-index="{{index}}" data-field="endDate" bindchange="changeWindow">结束 {{item.endDate}}</picker><picker class="figma-field-control" mode="time" value="{{item.report}}" data-index="{{index}}" data-field="report" bindchange="changeWindow">报到 {{item.report}}</picker><picker class="figma-field-control" mode="time" value="{{item.start}}" data-index="{{index}}" data-field="start" bindchange="changeWindow">开始 {{item.start}}</picker><picker class="figma-field-control" mode="time" value="{{item.end}}" data-index="{{index}}" data-field="end" bindchange="changeWindow">结束 {{item.end}}</picker></view><button wx:if="{{windows.length>1}}" class="row-link" data-index="{{index}}" bindtap="removeWindow" disabled="{{busy}}">移除此时段</button></view><button wx:if="{{(creating && types[kindIndex].value==='ADULT_PLAYER') || supplyOpen}}" class="figma-action figma-action--ghost" bindtap="addWindow" disabled="{{busy || windows.length>=64}}">增加确定时段</button></view>
      </block>
      <view wx:if="{{creating && formStep==='review'}}" class="review-summary"><view class="figma-row__title">确认需求公开范围</view><view>{{form.title}} · {{types[kindIndex].label}}</view><view>地点：{{formRegion.label || selection.label}}</view><view>比赛 / 服务场馆：{{form.address}}</view><view>每席 ¥{{form.unitBudget}} · 总预算 ¥{{form.totalBudget}}</view><view wx:for="{{scope}}" wx:key="regionId">合作地区：{{item.label}}</view><view class="figma-caption">意向不锁位、不付款；联系方式不会自动分享。</view></view>
      <checkbox-group wx:if="{{supplyOpen || formStep==='review'}}" data-field="adult" bindchange="check"><label class="figma-check"><checkbox value="yes" checked="{{adult}}" disabled="{{busy}}"/>我确认参与者为成人，并有权发布本需求或资料</label></checkbox-group>
      <button wx:if="{{creating && formStep==='details'}}" class="figma-action figma-action--orange" bindtap="reviewNeed" disabled="{{busy || pending || pendingError}}">下一步：审阅公开范围</button><button wx:if="{{creating && formStep==='review'}}" class="figma-action figma-action--orange" bindtap="create" disabled="{{busy || pending || pendingError}}">确认并发布需求</button><button wx:if="{{supplyOpen}}" class="figma-action figma-action--orange" bindtap="savePreference" disabled="{{busy || pending || pendingError}}">保存发现与联系授权</button>
    </view>

    <block wx:if="{{selected && !conversion}}">
      <view class="matching-tabs"><button class="matching-tab {{selected.kind==='ADULT_PLAYER' ? 'is-active' : ''}}">球员</button><button class="matching-tab {{selected.kind==='STAFF_SERVICE' ? 'is-active' : ''}}">工作人员</button><button class="matching-tab {{selected.kind==='TEAM_MATCHUP' ? 'is-active' : ''}}">球队约赛</button></view>
      <view class="figma-section"><view class="figma-section__title">当前需求</view><view class="display-row"><view class="display-row__copy"><view class="figma-field-label">合作岗位</view><view class="display-row__value">{{selected.roleLabel || selected.kindText}}</view></view><view class="figma-status figma-status--orange">{{selected.roleStatusText || ''}}</view></view><view class="display-row"><view class="display-row__copy"><view class="figma-field-label">地点与时段</view><view class="display-row__value">{{selected.timeLabel || (selected.address + ' · ' + selected.windows[0].label)}}</view></view><view class="figma-status figma-status--orange">{{selected.timeStatusText || ''}}</view></view><view class="display-row"><view class="display-row__copy"><view class="figma-field-label">每席预算</view><view class="display-row__value">{{selected.budgetLabel || selected.budgetText}}</view></view><view class="figma-status figma-status--orange">{{selected.budgetStatusText || ''}}</view></view></view>
      <view wx:if="{{selected.canManage}}" class="figma-section"><view class="figma-section__title">候选球员</view><view class="figma-section__hint">资格、档期、地点和报价需在预约前再次核对。总价未知时不按低总价排序。</view><button wx:for="{{selected.candidates}}" wx:key="id" class="figma-row" data-id="{{item.id}}" bindtap="send" disabled="{{busy || loading || pending || pendingError || !enabled || !selected.slots.length || selected.slots[seatIndex].status!=='OPEN'}}"><view class="figma-row__copy"><view class="figma-row__title">{{item.name}}</view><view class="figma-row__subtitle">{{item.summaryText || (item.priceText + ' · ' + item.score.reasons[0])}}</view></view><view class="figma-status figma-status--orange">{{item.score.bandText}}</view></button><figma-feedback wx:if="{{!selected.candidates.length}}" type="empty" title="暂无符合条件候选" body="确认角色、档期、地区、授权和预算后可重新匹配。"/></view>
      <view class="figma-section"><view class="figma-section__title">合作流程</view><view class="matching-flow"><view class="flow-row"><view class="flow-index">1</view><view class="figma-row__copy"><view class="figma-row__title">发送意向</view><view class="figma-row__subtitle">对方可接受或婉拒</view></view><view class="figma-status figma-status--orange">可发起</view></view><view class="flow-row"><view class="flow-index">2</view><view class="figma-row__copy"><view class="figma-row__title">转为预约</view><view class="figma-row__subtitle">重新核对真实档期、报价及权限</view></view><view class="figma-status">待双方同意</view></view></view></view>
      <view class="figma-section"><view class="figma-section__title">相关服务</view><button class="figma-row" bindtap="toggleSupply" disabled="{{busy || !enabled}}"><view class="figma-row__copy"><view class="figma-row__title">管理接单与联系授权</view><view class="figma-row__subtitle">管理发现与联系授权</view></view><view class="figma-status">进入</view></button></view>
      <view wx:if="{{selected.canManage}}" class="figma-section supplemental-controls">
        <view class="figma-section__title">需求管理</view>
        <picker class="figma-field-control" range="{{selected.slots}}" range-key="label" value="{{seatIndex}}" data-field="seatIndex" bindchange="choice" disabled="{{busy || loading || pending || pendingError}}">{{selected.slots[seatIndex].label}}</picker>
        <view class="inline-actions">
          <button class="figma-action figma-action--ghost" bindtap="run" disabled="{{busy || loading || pending || pendingError || selected.status!=='ACTIVE' || !enabled}}">重新匹配</button>
          <button wx:if="{{selected.status==='ACTIVE'}}" class="figma-action figma-action--ghost" data-type="PAUSE" bindtap="needCommand" disabled="{{busy || loading || pending || pendingError || !enabled}}">暂停</button>
          <button wx:if="{{selected.status==='PAUSED'}}" class="figma-action figma-action--ghost" data-type="RESUME" bindtap="needCommand" disabled="{{busy || loading || pending || pendingError || !enabled}}">恢复</button>
          <button wx:if="{{selected.status==='ACTIVE' || selected.status==='PAUSED'}}" class="figma-action figma-action--ghost danger-action" data-type="CLOSE" bindtap="needCommand" disabled="{{busy || loading || pending || pendingError || !enabled}}">关闭</button>
        </view>
        <view wx:for="{{selected.slots}}" wx:key="id" class="display-row">
          <view class="display-row__copy"><view>{{item.label}}</view><view class="figma-caption">第 {{item.generation}} 次安排</view></view>
          <button wx:if="{{selected.status==='ACTIVE' && item.status==='CONVERTED'}}" class="figma-action figma-action--ghost" data-type="REOPEN_SLOT" data-id="{{item.id}}" bindtap="needCommand" disabled="{{busy || loading || pending || pendingError || !enabled}}">原单结束后重开</button>
        </view>
      </view>
      <view class="figma-section supplemental-controls">
        <view class="figma-section__title">双方意向</view>
        <view wx:for="{{selected.intents}}" wx:key="id" class="intent-card">
          <view class="section-heading"><view><view class="figma-row__title">{{item.candidate.name || '原候选资料已变化'}}</view><view class="figma-row__subtitle">{{item.candidate.priceText}}</view></view><view class="figma-status figma-status--orange">{{item.statusText}}</view></view>
          <view class="inline-actions">
            <button wx:if="{{item.canAccept}}" class="figma-action figma-action--orange" data-id="{{item.id}}" data-type="ACCEPT" bindtap="intentCommand" disabled="{{busy || loading || pending || pendingError || !enabled}}">有意合作</button>
            <button wx:if="{{item.canAccept}}" class="figma-action figma-action--ghost" data-id="{{item.id}}" data-type="DECLINE" bindtap="intentCommand" disabled="{{busy || loading || pending || pendingError || !enabled}}">婉拒</button>
            <button wx:if="{{item.canWithdraw}}" class="figma-action figma-action--ghost" data-id="{{item.id}}" data-type="WITHDRAW" bindtap="intentCommand" disabled="{{busy || loading || pending || pendingError || !enabled}}">撤回</button>
            <button wx:if="{{item.canConvert}}" class="figma-action figma-action--orange" data-id="{{item.id}}" bindtap="reviewConversion" disabled="{{busy || loading || pending || pendingError || !enabled}}">核对条款并转预约</button>
            <button wx:if="{{item.sourceId}}" class="figma-action figma-action--ghost" data-id="{{item.id}}" bindtap="openSource" disabled="{{busy || loading}}">查看原预约</button>
          </view>
          <view wx:if="{{item.status==='MUTUAL_INTEREST' && !item.canConvert}}" class="figma-caption">转预约前需要确认当前权限、有效档期及报价；跨地区合作还需差旅派单确认。</view>
        </view>
        <figma-feedback wx:if="{{!selected.intents.length}}" type="empty" title="双方意向尚未建立" body="发送意向后，等待对方主动确认。"/>
      </view>
    </block>

    <view wx:if="{{conversion}}" class="figma-section conversion-section"><button class="back-action" bindtap="closeConversion" disabled="{{busy || loading}}"><image class="back-action__icon" src="/assets/approved-ui/icon-chevron-left-navy.png" mode="aspectFit" aria-hidden="true"/>返回双方意向</button><view class="figma-eyebrow">转预约前复核</view><view class="figma-section__title">{{conversion.candidate.name}}</view><view class="price-total">本席位总价 {{conversion.candidate.priceText}}</view><view wx:if="{{preview.enabled}}" class="review-summary"><view>收款方：{{preview.merchantName}}</view><view>{{preview.terms}}</view><checkbox-group data-field="chargeConsent" bindchange="check"><label class="figma-check"><checkbox value="yes" checked="{{chargeConsent}}" disabled="{{busy}}"/>我已阅读并同意本次收费条款</label></checkbox-group></view><figma-feedback wx:else type="warning" title="收费准备尚未完成" body="{{selected.kind === 'TEAM_MATCHUP' ? '约赛本身不另收费，场地按原预约执行。' : '当前暂不可转预约。'}}"/><block wx:if="{{selected.kind==='TEAM_MATCHUP'}}"><picker class="figma-field-control" range="{{courts}}" range-key="title" value="{{courtIndex}}" data-field="courtIndex" bindchange="choice">{{courts[courtIndex].title || '暂无符合条件球场预约'}}</picker><textarea class="figma-field-control" data-field="terms" value="{{terms}}" bindinput="input" maxlength="1000" placeholder="比赛规则、人数、迟到、取消与天气约定" disabled="{{busy}}"/></block><checkbox-group data-field="eligibility" bindchange="check"><label class="figma-check"><checkbox value="yes" checked="{{eligibility}}" disabled="{{busy}}"/>我已核对成人资格、服务时段与场地约定</label></checkbox-group><button class="figma-action figma-action--orange" bindtap="convert" disabled="{{busy || loading || pending || pendingError || !enabled || (selected.kind!=='TEAM_MATCHUP' && !preview.enabled)}}">确认转为预约申请</button><view class="figma-caption">接单、支付、退款和取消继续在生成的源预约中处理。</view></view>
  </view>
  <view wx:if="{{!selected && !creating && !supplyOpen && !conversion}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="toggleSupply" disabled="{{busy || !enabled || pending || pendingError}}">管理发现授权</button><button class="figma-action figma-action--orange" bindtap="toggleCreate" disabled="{{busy || !enabled || pending || pendingError}}">发布新需求</button></view>
  <view wx:if="{{selected && !conversion}}" class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="toggleSupply" disabled="{{busy || !enabled || pending || pendingError}}">管理发现授权</button><button wx:if="{{selected.canManage}}" class="figma-action figma-action--orange" data-id="{{selected.candidates[0].id}}" bindtap="send" disabled="{{busy || loading || pending || pendingError || !enabled || !selected.candidates.length || !selected.slots.length || selected.slots[seatIndex].status!=='OPEN'}}">向候选发送意向</button></view>
</view>
