<scb-header title="我的成员关系" disabled="{{busy}}"/>
<view class="figma-page memberships-page">
  <view class="figma-page__content figma-page__content--actions">
    <view class="figma-summary figma-summary--navy"><view class="figma-summary__icon"><figma-icon name="teams" size="{{28}}"/></view><view class="figma-summary__copy"><view class="figma-eyebrow">球员本人</view><view class="figma-title">{{items.length ? items[0].memberName + '的球队' : '我的球队'}}</view><view class="figma-subtitle">查看本人已绑定的长期球队成员</view></view></view>
    <figma-feedback wx:if="{{error}}" type="error" title="请核对后继续" body="{{error}}" action-label="重新读取" bind:action="refresh"/>
    <figma-feedback wx:if="{{message}}" type="{{uncertain ? 'pending' : 'success'}}" title="{{uncertain ? '操作结果待核对' : '成员关系已更新'}}" body="{{message}}"/>
    <figma-feedback wx:if="{{loginRequired}}" type="empty" title="登录后查看成员关系" action-label="登录" bind:action="login"/>
    <view wx:if="{{loading}}" class="figma-section"><figma-skeleton rows="{{3}}"/></view>
    <view wx:if="{{!loginRequired && !loading}}" class="figma-section"><view class="figma-section__title">本人绑定</view><figma-feedback wx:if="{{!items.length}}" type="empty" title="暂无成员关系" body="可使用球队加入码加入或处理定向认领。"/><button wx:for="{{items}}" wx:key="bindingId" class="membership-select {{selectedId===item.bindingId ? 'is-selected' : ''}}" data-id="{{item.bindingId}}" bindtap="select" disabled="{{busy}}"><view class="figma-row__copy"><view class="figma-row__title">{{item.teamName}}</view><view class="figma-row__subtitle">{{item.memberName}}{{item.jerseyNo ? ' · ' + item.jerseyNo + '号' : ''}}</view></view><view class="figma-status figma-status--orange">{{item.status==='ACTIVE' ? '长期成员' : item.stateText}}</view></button></view>
    <view wx:if="{{!loginRequired && !loading}}" class="figma-section"><view class="figma-section__title">球队详情</view><button class="membership-choice" bindtap="openSelected" disabled="{{busy || !selectedId}}"><view class="figma-row__mark"/><view class="figma-row__copy"><view class="figma-row__title">查看球队</view><view class="figma-row__subtitle">读取有权访问的球队资料</view></view></button><button class="membership-choice" bindtap="leaveSelected" disabled="{{busy || !selectedId}}"><view class="figma-row__mark"/><view class="figma-row__copy"><view class="figma-row__title">退出球队</view><view class="figma-row__subtitle">明确确认后结束该关系</view></view></button></view>
    <view wx:if="{{team}}" class="figma-section"><view class="profile-head"><view><view class="figma-section__title">{{team.teamName}}</view><view class="figma-section__hint">{{team.organizationName}} · 只读长期成员名称</view></view><button class="row-action" bindtap="closeTeam">收起</button></view><view wx:for="{{team.members}}" wx:key="memberId" class="figma-row"><view class="figma-row__copy"><view class="figma-row__title">{{item.name}}</view></view><view wx:if="{{item.isSelf}}" class="figma-status figma-status--green">我</view></view></view>
    <view class="figma-section"><view class="figma-section__title">更多操作</view><view class="membership-notice"><view class="membership-notice__mark"/><view class="figma-row__copy"><view class="figma-row__title">加入另一支球队</view><view class="figma-row__subtitle">使用领队提供的加入码</view></view></view><view class="membership-notice"><view class="membership-notice__mark"/><view class="figma-row__copy"><view class="figma-row__title">认领历史成员</view><view class="figma-row__subtitle">只处理发送给本人的邀请</view></view></view></view>
  </view>
  <view class="figma-fixed-actions"><button class="figma-action figma-action--ghost" bindtap="openJoin" disabled="{{busy}}">加入或认领成员</button><button class="figma-action figma-action--orange" bindtap="openSelected" disabled="{{busy || !selectedId}}">查看球队</button></view>
</view>
