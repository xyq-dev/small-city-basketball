@import "../../styles/figma-pages.wxss";

.profile-head{display:flex;min-height:44px;align-items:center;justify-content:space-between;gap:8px}.row-action{display:flex;min-width:56px;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 8px;border:0;border-radius:22px;background:#eaf2fc;color:#123c73;font-size:13px}.section-ghost,.section-danger{display:flex;width:100%;min-height:44px;align-items:center;justify-content:center;margin:0;padding:0 12px;border-radius:22px;font-size:14px}.section-ghost{border:1px solid #7c8ea5;background:#fff;color:#123c73}.section-danger{border:1px solid #c83f42;background:#fff;color:#c83f42}.row-action::after,.section-ghost::after,.section-danger::after{border:0}.two-actions{display:grid;margin-top:8px;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.membership-row{padding:10px 0;border-top:1px solid #e6ebf2}
.membership-select,.membership-choice{display:flex;width:100%;min-height:55px;align-items:center;gap:8px;margin:0;padding:0;border:0;background:transparent;color:#18283f;text-align:left}.membership-select+.membership-select,.membership-choice+.membership-choice{border-top:1px solid #e6ebf2}.membership-select.is-selected .figma-row__title{color:#123c73}.membership-select::after,.membership-choice::after{border:0}.membership-notice{display:flex;width:100%;min-height:55px;align-items:center;gap:9px;padding:0 10px;border-radius:8px;background:#eaf2fc}.membership-notice__mark{width:7px;height:7px;flex:none;border-radius:4px;background:#123c73}
