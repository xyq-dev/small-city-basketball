.page{padding:28rpx}.title{font-size:36rpx;font-weight:600;margin-bottom:24rpx}.card{padding:24rpx;background:#fff;border:1rpx solid #ddd;border-radius:16rpx;margin:24rpx 0}.error{color:#b91c1c}.notice{color:#555;font-size:26rpx;padding:16rpx 0}.target{border-top:1rpx solid #ddd;padding-top:20rpx;margin-top:20rpx}label{display:block;padding:14rpx 0}input{box-sizing:border-box;width:100%;min-height:44px;font-size:16px;line-height:22px;border:1rpx solid #bbb;padding:10px 12px;margin:10rpx 0}live-pusher{width:100%;height:400rpx;margin:20rpx 0}button{margin-top:14rpx}
.hash{word-break:break-all;font-size:22rpx;color:#555}

.media-workspace { padding:16px 16px calc(32px + env(safe-area-inset-bottom)); }
.media-workspace .card { margin:12px 0; padding:16px; border:0; border-radius:16px; }
.media-workspace .hash { overflow-wrap:anywhere; }
.media-workspace button { min-height:48px; font-size:16px; }

.media-workspace .job-heading,.media-workspace .artifact-link { display:flex; align-items:center; gap:12px; }
.media-workspace .job-heading > view,.media-workspace .artifact-link text { flex:1; min-width:0; text-align:left; }
.media-workspace .job-heading image,.media-workspace .artifact-link image { flex:none; }

.ui002-workspace .notice { font-size:14px; line-height:22px; border-radius:12px; padding:12px; }
