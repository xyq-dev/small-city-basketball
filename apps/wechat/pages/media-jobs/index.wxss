.page{padding:28rpx}.title{font-size:36rpx;font-weight:600;margin-bottom:24rpx}.card{padding:24rpx;background:#fff;border:1rpx solid #ddd;border-radius:16rpx;margin:24rpx 0}.error{color:#b91c1c}.notice{color:#555;font-size:26rpx;padding:16rpx 0}.target{border-top:1rpx solid #ddd;padding-top:20rpx;margin-top:20rpx}label{display:block;padding:14rpx 0}input{box-sizing:border-box;width:100%;min-height:44px;font-size:16px;line-height:22px;border:1rpx solid #bbb;padding:10px 12px;margin:10rpx 0}live-pusher{width:100%;height:400rpx;margin:20rpx 0}button{margin-top:14rpx}
.hash{word-break:break-all;font-size:22rpx;color:#555}

.media-workspace { padding:16px 16px calc(32px + env(safe-area-inset-bottom)); }
.media-workspace .card { margin:12px 0; padding:16px; border:0; border-radius:16px; }
.media-workspace .hash { overflow-wrap:anywhere; }
.media-workspace button { min-height:48px; font-size:16px; }

.media-workspace .job-heading,.media-workspace .artifact-link { display:flex; align-items:center; gap:12px; }
.media-workspace .job-heading > view,.media-workspace .artifact-link text { flex:1; min-width:0; text-align:left; }
.media-workspace .job-heading image,.media-workspace .artifact-link image { flex:none; }

.ui002-workspace .notice { font-size:14px; line-height:22px; border-radius:12px; padding:12px; }

/* UI001 V06: actual records first; calibration is an explicit disclosure. */
.media-workspace { padding:16px 16px calc(24px + env(safe-area-inset-bottom)); }
.media-overview { margin-bottom:12px; padding:16px; border-radius:16px; }
.overview-heading { color:#18283f; margin-bottom:8px; font-size:18px; line-height:28px; font-weight:700; }
.media-record + .media-record { margin-top:8px; }
.media-summary { display:flex; align-items:center; gap:12px; min-height:58px; width:100%; padding:8px 0; margin:0; border-radius:0; background:#fff; color:#18283f; text-align:left; font-weight:400; }
.media-summary::after { border:0; }
.overview-icon { flex:0 0 22px; width:22px; height:22px; }
.overview-chevron { flex:0 0 16px; width:16px; height:16px; }
.overview-copy { flex:1; min-width:0; }
.overview-label { color:#18283f; font-size:14px; line-height:22px; font-weight:500; overflow-wrap:anywhere; }
.overview-meta { margin-top:2px; color:#63758b; font-size:12px; line-height:18px; overflow-wrap:anywhere; }
.media-record-detail { padding:12px; margin-top:8px; border-radius:12px; background:#f4f6fa; }
.media-record-detail button:last-child { margin-bottom:0; }
.calibration-editor { margin-top:12px; }
.media-boundary { margin-bottom:12px; }
.notice-title { margin-bottom:8px; font-size:14px; line-height:22px; font-weight:500; }
.artifact-details { margin-bottom:12px; }
.media-generation-actions { display:flex; flex-direction:column; gap:8px; margin-bottom:12px; }
.media-generation-actions button { min-height:48px; margin:0; padding:12px; border-radius:12px; font-size:14px; line-height:22px; color:#123c73; }
.media-generation-actions .secondary { background:#eaf0f8; }
