.media-workspace { padding:12px 16px calc(112px + env(safe-area-inset-bottom)); color:#18283f; }
.media-summary-card { display:flex; align-items:center; gap:12px; margin-bottom:12px; padding:14px; border-radius:16px; background:#fff; }
.media-summary-icon { display:flex; align-items:center; justify-content:center; width:44px; height:44px; flex:none; border-radius:12px; background:#eaf2fc; }
.media-summary-icon image { width:25px; height:25px; }
.media-summary-copy { flex:1; min-width:0; overflow-wrap:anywhere; }
.media-summary-copy view:first-child { color:#51657d; font-size:11px; line-height:16px; }
.media-summary-copy view:nth-child(2) { margin-top:3px; color:#18283f; font-size:18px; line-height:26px; font-weight:700; }
.media-summary-copy view:last-child { margin-top:3px; color:#51657d; font-size:12px; line-height:17px; }
.media-tabs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1px; height:48px; margin-bottom:12px; padding:2px 3px; border-radius:12px; background:#fff; }
.media-tabs button { min-width:0; height:44px; min-height:44px; margin:0; padding:0 4px; border-radius:10px; background:#fff; color:#51657d; font-size:13px; line-height:19px; font-weight:400; }
.media-tabs button::after { border:0; }
.media-tabs button.active { background:#123c73; color:#fff; font-weight:700; }
.media-tabs button[disabled]:not(.active) { background:#fff; color:#9aa9ba; }
.media-design-card,.artifact-details,.media-generation-actions,.media-pending { margin:0 0 12px; padding:14px; border-radius:16px; background:#fff; }
.media-design-card .fig-card-title { margin-bottom:8px; }
.media-field-label { margin:8px 0 4px; color:#51657d; font-size:12px; line-height:17px; font-weight:700; }
.media-field-button,.media-field-display { display:flex; align-items:center; gap:8px; width:100%; min-height:48px; margin:0 0 8px; padding:4px 12px; border:1px solid #7c8ea5; border-radius:12px; background:#fff; text-align:left; }
.media-field-button::after { border:0; }
.media-field-button[disabled] { color:#18283f; background:#fff; }
.media-row-copy { flex:1; min-width:0; color:#18283f; font-size:14px; line-height:20px; font-weight:700; overflow-wrap:anywhere; }
.media-row-copy view + view { margin-top:3px; color:#51657d; font-size:12px; line-height:17px; font-weight:400; }
.media-row-icon { width:22px; height:22px; flex:none; }
.media-pill { flex:none; max-width:112px; min-height:23px; padding:3px 7px; border-radius:7px; background:#fff1e2; color:#18283f; font-size:11px; line-height:17px; text-align:center; overflow-wrap:anywhere; }
.media-pill.ready { background:#e7f5ee; color:#16734b; }
.media-card-caption { margin:-4px 0 4px; }
.media-task + .media-task,.media-task-row + .media-task-row { border-top:1px solid #e6ebf2; }
.media-task-row { display:flex; align-items:center; gap:8px; width:100%; min-height:55px; margin:0; padding:8px 0; border-radius:0; background:#fff; text-align:left; }
.media-task-row::after { border:0; }
.media-task-row[disabled] { color:#18283f; background:#fff; }
.media-step { display:flex; align-items:center; justify-content:center; width:20px; height:20px; flex:none; border-radius:10px; background:#eaf2fc; color:#123c73; font-size:11px; line-height:16px; font-weight:700; }
.media-record-detail { margin:4px 0 8px; padding:12px; border-radius:12px; background:#f4f6fa; }
.media-record-detail button { min-height:44px; margin:8px 0 0; }
.calibration-editor { margin-top:12px; }
.media-empty-row { min-height:55px; padding:16px 0; color:#63758b; font-size:12px; line-height:20px; }
.hash { margin:8px 0; color:#51657d; font-size:11px; line-height:17px; word-break:break-all; }
.artifact-link { display:flex; align-items:center; gap:10px; width:100%; min-height:48px; margin:10px 0 0; padding:8px 0; border-radius:0; background:#fff; color:#123c73; text-align:left; }
.artifact-link::after { border:0; }
.artifact-link image:first-child { width:22px; height:22px; flex:none; }
.artifact-link image:last-child { width:16px; height:16px; flex:none; }
.artifact-link text { flex:1; min-width:0; }
.media-generation-actions { display:flex; flex-direction:column; gap:8px; }
.media-generation-actions button { min-height:48px; margin:0; font-size:14px; line-height:22px; }
.media-boundary { margin:0; }
.notice-title { margin-bottom:6px; font-size:14px; line-height:20px; font-weight:700; }
.media-bottom-actions button { overflow:hidden; text-overflow:ellipsis; }
@media (max-width:340px) {
  .media-workspace { padding-left:12px; padding-right:12px; }
  .media-bottom-actions button { padding-left:7px; padding-right:7px; font-size:13px; }
  .media-pill { max-width:88px; }
}
