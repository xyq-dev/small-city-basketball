@import "../../styles/figma-pages.wxss";

.media-icon { width:20px; height:20px; flex:none; }
.media-summary-icon { width:25px; height:25px; flex:none; }
.media-chevron { width:16px; height:16px; flex:none; }
.media-step__copy { min-width:0; flex:1; }
.media-empty { padding:12px; border-radius:10px; background:#f4f6fa; }

.media-tabs { display: flex; width: 100%; min-height: 48px; padding: 2px 3px; border-radius: 12px; background: #fff; }
.media-tab { display: flex; min-width: 0; min-height: 44px; flex: 1; align-items: center; justify-content: center; margin: 0; padding: 0 6px; border: 0; border-radius: 10px; background: transparent; color: #51657d; font-size: 13px; line-height: 19px; }
.media-tab::after, .media-link::after { border: 0; }
.media-tab.is-active { background: #123c73; color: #fff; font-weight: 700; }
.media-readonly { display: flex; width: 100%; min-height: 48px; align-items: center; justify-content: space-between; gap: 8px; padding: 0 12px; border: 1px solid #7c8ea5; border-radius: 12px; background: #fff; color: #18283f; font-size: 14px; line-height: 22px; }
.media-record { width: 100%; }
.media-expanded { display: flex; width: 100%; padding: 8px 0 12px 28px; flex-direction: column; gap: 8px; }
.media-calibration { display: flex; flex-direction: column; gap: 10px; }
.media-link { display: flex; width: 100%; min-height: 44px; align-items: center; margin: 0; padding: 0; background: transparent; color: #123c73; font-size: 14px; font-weight: 700; text-align: left; }
.media-hash { overflow-wrap: anywhere; color: #51657d; font-family: monospace; font-size: 11px; line-height: 17px; }
.media-command-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.media-command-grid .figma-action { padding: 0 8px; font-size: 14px; }
.media-danger { border: 1px solid #c83f42; background: #fff; color: #c83f42; }
.media-step { display: flex; min-height: 55px; align-items: center; gap: 8px; }
.media-step__number { display: flex; width: 20px; height: 20px; flex: none; align-items: center; justify-content: center; border-radius: 10px; background: #eaf2fc; color: #123c73; font-size: 11px; font-weight: 700; }
@media (max-width: 360px) { .media-tab { padding: 0 2px; font-size: 11px; } .media-command-grid { grid-template-columns: 1fr; } }
