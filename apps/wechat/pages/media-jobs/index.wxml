<scb-header title="录像与媒体作业" disabled="{{busy}}"/>
<view class="page fig-page media-workspace has-actions">
  <view class="media-summary-card">
    <view class="media-summary-icon"><image src="/assets/figma/media.svg" mode="aspectFit" aria-hidden="true"/></view>
    <view class="media-summary-copy"><view>比赛媒体人员</view><view>本场录像工作单</view><view>按已探测的产物与真实处理状态交付</view></view>
  </view>
  <view class="media-tabs" role="tablist">
    <button class="active" data-id="media-calibration" bindtap="scrollPanel" disabled="{{busy}}">录像</button>
    <button data-id="media-processing" bindtap="scrollPanel" disabled="{{busy}}">媒体作业</button>
    <button data-id="media-artifacts" bindtap="scrollPanel" disabled="{{busy}}">可预览产物</button>
  </view>

  <scb-state wx:if="{{loading}}" kind="loading" title="正在读取媒体任务" description="以当前授权和真实产物为准。"/>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view wx:if="{{pending}}" class="fig-card media-pending"><view class="fig-card-title">上次操作结果待核对</view><view class="small muted">保留原请求编号，核对完成前不重复提交。</view><button class="secondary" bindtap="retry" disabled="{{busy}}">核对原操作结果</button></view>
  <scb-state wx:if="{{!loading && !jobs.length && !artifacts.length && !error}}" kind="empty" title="暂无当前可用媒体产物" description="完成有权录制并核验产物后，在这里继续转码、授权发布或下载。"/>

  <view id="media-calibration" wx:if="{{jobs.length || artifacts.length}}" class="fig-card media-design-card">
    <view class="fig-card-title">录像校准</view>
    <view class="media-field-label">本场录像</view>
    <block wx:for="{{jobs}}" wx:key="id">
      <button wx:if="{{item.kind === 'RECORDING'}}" class="media-field-button" data-id="{{item.id}}" bindtap="toggleJob" disabled="{{busy}}"><image class="media-row-icon" src="./assets/play.svg" mode="aspectFit"/><view class="media-row-copy"><view>{{item.kindText}}</view><view>{{item.statusText}}</view></view><view class="media-pill {{item.status === 'READY' ? 'ready' : ''}}">{{item.status === 'READY' ? '已探测' : item.statusText}}</view></button>
      <view wx:if="{{item.kind === 'RECORDING' && expandedJobId === item.id}}" class="media-record-detail">
        <view wx:if="{{item.error}}" class="notice warning">{{item.error}}</view>
        <block wx:if="{{canManage && item.status === 'READY'}}">
          <button class="secondary" bindtap="toggleCalibration" disabled="{{busy || pending}}">{{calibrationOpen ? '收起录像时间校准' : '核对本录像时间校准'}}</button>
          <view wx:if="{{calibrationOpen}}" class="calibration-editor"><view class="subtitle">录像时间校准</view><input class="field" data-field="anchorAt" value="{{anchorAt}}" placeholder="源PTS=0对应时间，如2026-10-31T12:00:00+08:00" bindinput="input" disabled="{{busy || pending}}"/><input class="field" data-field="offsetMs" value="{{offsetMs}}" type="number" placeholder="明确校准的偏移（毫秒）" bindinput="input" disabled="{{busy || pending}}"/><input class="field" data-field="reason" value="{{reason}}" bindinput="input" placeholder="核对依据" disabled="{{busy || pending}}"/><button class="primary" data-type="CALIBRATE" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="command" disabled="{{busy || pending}}">确认此录像的时间锚点</button></view>
        </block>
      </view>
    </block>
    <view class="media-field-label">时间锚点</view>
    <view class="media-field-display"><view class="media-row-copy"><view>{{anchorAt || '对齐场上记分与录像时间'}}</view><view>{{offsetMs ? '当前偏移 ' + offsetMs + ' 毫秒' : '尚未填写明确偏移'}}</view></view><view class="media-pill">待确认</view></view>
  </view>

  <view id="media-processing" wx:if="{{jobs.length || artifacts.length}}" class="fig-card media-design-card">
    <view class="fig-card-title">处理任务</view>
    <view class="small muted media-card-caption">录制产物与任务</view>
    <block wx:for="{{jobs}}" wx:key="id">
      <view wx:if="{{item.kind !== 'RECORDING'}}" class="media-task">
        <button class="media-task-row" data-id="{{item.id}}" bindtap="toggleJob" disabled="{{busy}}"><image class="media-row-icon" src="{{item.kind === 'TRANSCODE' ? './assets/clock.svg' : './assets/bars.svg'}}" mode="aspectFit"/><view class="media-row-copy"><view>{{item.kindText}}</view><view>{{item.error || item.statusText}}</view></view><view class="media-pill {{item.status === 'READY' ? 'ready' : ''}}">{{item.statusText}}</view></button>
        <view wx:if="{{expandedJobId === item.id}}" class="media-record-detail"><view wx:if="{{item.error}}" class="notice warning">{{item.error}}</view><button wx:if="{{canManage && (item.status === 'QUEUED' || item.status === 'RUNNING')}}" class="secondary" data-type="CANCEL_JOB" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="command" disabled="{{busy || pending}}">取消作业</button></view>
      </view>
    </block>
  </view>

  <view id="media-artifacts" wx:if="{{jobs.length || artifacts.length}}" class="fig-card media-design-card media-artifact-card">
    <view class="fig-card-title">授权交付</view>
    <button wx:for="{{artifacts}}" wx:key="id" class="media-task-row" data-id="{{item.id}}" bindtap="toggleArtifact" disabled="{{busy}}"><view class="media-step">{{index + 1}}</view><view class="media-row-copy"><view>{{index ? '可预览产物' : '确认产物'}}</view><view>{{item.durationText}} · {{item.sizeText}}</view></view><view class="media-pill {{item.published ? 'ready' : ''}}">{{item.published ? '已公开' : '待交付'}}</view></button>
    <view wx:if="{{!artifacts.length}}" class="media-empty-row">尚未探测到可授权交付的真实产物。</view>
  </view>

  <block wx:for="{{artifacts}}" wx:key="id">
    <view wx:if="{{expandedArtifactId === item.id || artifacts.length === 1}}" class="artifact-workflow">
      <view class="fig-card artifact-details"><view class="fig-card-title">当前产物 {{item.durationText}}</view><view class="small muted">真实大小 {{item.sizeText}}</view><view class="hash">SHA256 {{item.sha256}}</view><button class="artifact-link" data-id="{{item.id}}" bindtap="download" disabled="{{busy}}"><image src="./assets/play.svg" mode="aspectFit"/><text>授权下载与预览</text><image src="./assets/chevron.svg" mode="aspectFit"/></button></view>
      <view wx:if="{{canManage}}" class="fig-card media-generation-actions"><view class="fig-card-title">媒体作业</view><button class="secondary" data-type="TRANSCODE" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="command" disabled="{{busy || pending}}">申请转码</button><button class="secondary" data-type="HIGHLIGHTS" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="command" disabled="{{busy || pending}}">核对有效得分后生成集锦</button><button class="secondary" data-type="PUBLISH" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="command" disabled="{{busy || pending || item.published}}">独立审核并公开产物</button><button class="quiet" data-type="REVOKE" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="command" disabled="{{busy || pending}}">撤回产物</button><button wx:if="{{item.published}}" class="quiet" data-key="{{item.publicKey}}" bindtap="copyLink">复制公开观看链接</button></view>
    </view>
  </block>

  <view class="notice media-boundary"><view class="notice-title">录像与频道状态分开</view><view class="small">实际时长不等于整场完整；源授权撤回会阻止产物后续访问。自动集锦须核对源PTS与有效在线得分，补录事件不会推造媒体时间。</view></view>
</view>
<view class="fig-actions dock media-bottom-actions"><button class="fig-ghost" bindtap="retry" disabled="{{busy || !pending}}">核对原操作</button><button class="fig-confirm" bindtap="load" disabled="{{busy || loading}}">刷新服务器处理状态</button></view>
