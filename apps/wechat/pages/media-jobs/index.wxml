<view class="page">
  <view class="title">录像与媒体作业</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <button bindtap="load" disabled="{{busy || loading}}">刷新服务器处理状态</button>
  <view wx:if="{{pending}}" class="card"><text>上次操作结果待核对。</text><button bindtap="retry" disabled="{{busy}}">核对原操作结果</button></view>
  <view class="notice">录像独立于各转推频道。显示真实产物时长；中断后可能只有部分片段，不能据此认定整场无缺失。自动集锦使用人工校准的源PTS和有效在线得分事件，补录事件不会推造媒体时间。</view>
  <view wx:if="{{canManage}}" class="card"><view>录像时间校准</view><input data-field="anchorAt" value="{{anchorAt}}" placeholder="源PTS=0对应时间，如2026-10-31T12:00:00+08:00" bindinput="input"/><input data-field="offsetMs" value="{{offsetMs}}" type="number" placeholder="明确校准的偏移（毫秒）" bindinput="input"/><input data-field="reason" value="{{reason}}" bindinput="input" placeholder="核对依据"/></view>
  <view wx:for="{{jobs}}" wx:key="id" class="card"><view>{{item.kindText}} · {{item.statusText}}</view><view wx:if="{{item.error}}">{{item.error}}</view><button wx:if="{{canManage && item.kind === 'RECORDING' && item.status === 'READY'}}" data-type="CALIBRATE" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="command" disabled="{{busy || pending}}">确认此录像的时间锚点</button><button wx:if="{{canManage && (item.status === 'QUEUED' || item.status === 'RUNNING')}}" data-type="CANCEL_JOB" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="command" disabled="{{busy || pending}}">取消作业</button></view>
  <view wx:for="{{artifacts}}" wx:key="id" class="card"><view>真实产物 {{item.durationText}} · {{item.sizeText}}</view><view class="hash">SHA256 {{item.sha256}}</view><button data-id="{{item.id}}" bindtap="download" disabled="{{busy}}">授权下载与预览</button><block wx:if="{{canManage}}"><button data-type="TRANSCODE" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="command" disabled="{{busy || pending}}">生成转码</button><button data-type="HIGHLIGHTS" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="command" disabled="{{busy || pending}}">按有效得分生成集锦</button><button data-type="PUBLISH" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="command" disabled="{{busy || pending || item.published}}">独立审核并公开产物</button><button data-type="REVOKE" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="command" disabled="{{busy || pending}}">撤回产物</button><button wx:if="{{item.published}}" data-key="{{item.publicKey}}" bindtap="copyLink">复制公开观看链接</button></block></view>
</view>
