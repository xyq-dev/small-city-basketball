page { background:#f5f7fa; color:#152c43; font-family:'Noto Sans SC','PingFang SC','Microsoft YaHei',sans-serif; font-size:14px; line-height:1.72; }
view,button,input,textarea,picker,scroll-view { box-sizing:border-box; }
.page { padding:38rpx; padding-bottom:calc(40rpx + env(safe-area-inset-bottom)); max-width:960rpx; margin:0 auto; }
.page.has-actions,.has-actions { padding-bottom:calc(300rpx + env(safe-area-inset-bottom)); }
.card { background:#fff; border-radius:31rpx; padding:31rpx; margin-bottom:31rpx; overflow-wrap:anywhere; }
.hero { background:#132c49; color:#fff; border-radius:31rpx; padding:46rpx; margin-bottom:31rpx; }
.hero .muted { color:#c2d1e0; }
.hero .title { color:#fff; }
.title,.page-title { color:#132c49; font-size:22px; line-height:1.55; font-weight:700; margin:0 0 18rpx; }
.subtitle,.section-title { color:#132c49; font-size:18px; line-height:1.55; font-weight:600; margin:0 0 16rpx; }
.muted { color:#617286; font-size:12px; line-height:1.75; }
.small { font-size:12px; line-height:1.7; }
.money,.numeric { font-family:Inter,'DIN Alternate',Arial,sans-serif; font-variant-numeric:tabular-nums; font-weight:600; color:#132c49; }
.notice { color:#132c49; background:#eaf0f7; padding:25rpx; border-radius:23rpx; margin-bottom:31rpx; overflow-wrap:anywhere; }
.notice.warning,.warning { color:#895500; background:#fff3dc; }
.notice.danger { background:#fdecec; color:#b53333; }
.error { color:#b53333; background:#fdecec; border-radius:16rpx; padding:20rpx; margin-bottom:24rpx; overflow-wrap:anywhere; }
.field-label { display:block; color:#617286; font-size:12px; margin-bottom:10rpx; }
.field,input.field,textarea.field { display:block; border:1rpx solid #e8edf2; border-radius:15rpx; width:100%; min-height:44px; background:white; color:#152c43; padding:18rpx 23rpx; margin:10rpx 0 23rpx; font-size:16px; line-height:1.5; }
textarea.field { min-height:180rpx; }
picker.field { padding:20rpx 23rpx; }
button { min-height:44px; padding:20rpx 23rpx; margin:0 0 18rpx; border-radius:15rpx; font-size:14px; line-height:1.7; font-weight:500; color:#132c49; background:#fff; white-space:normal; overflow-wrap:anywhere; }
button::after { border:1rpx solid #e8edf2; border-radius:15rpx; }
button.primary,.primary { color:#fff; background:#132c49; }
button.primary::after,button.quiet::after { border:none; }
button.accent { color:#132c49; background:#ff6b2d; }
button.secondary { background:#fff; color:#132c49; }
button.quiet { background:transparent; color:#132c49; }
button.danger { color:#b53333; background:#fdecec; }
button[disabled],button.primary[disabled] { color:#617286; background:#eaf0f7; opacity:1; }
button.inline { display:inline-block; width:auto; margin-right:12rpx; }
.action-bar { position:fixed; z-index:10; bottom:0; left:0; right:0; background:#fff; border-radius:31rpx 31rpx 0 0; border-top:1rpx solid #e8edf2; padding:23rpx 38rpx calc(28rpx + env(safe-area-inset-bottom)); }
.action-bar button { width:100%; max-width:884rpx; margin:0 auto 15rpx; }
.action-bar button:last-child { margin-bottom:0; }
.row { padding:19rpx 0; border-bottom:1rpx solid #e8edf2; overflow-wrap:anywhere; }
.row:last-child { border-bottom:0; }
.row-between { display:flex; align-items:flex-start; justify-content:space-between; gap:20rpx; }
.row-between > view,.row-between > text { min-width:0; overflow-wrap:anywhere; }
.stack > view,.stack > button { margin-bottom:20rpx; }
.inline { display:flex; align-items:center; gap:16rpx; flex-wrap:wrap; }
.stat-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:23rpx; margin-bottom:31rpx; }
.stat { padding:30rpx; border-radius:23rpx; background:#fff; min-width:0; }
.stat .numeric { font-size:58rpx; line-height:1.35; }
.badge { display:inline-block; color:#132c49; background:#eaf0f7; padding:4rpx 16rpx; border-radius:50rpx; font-size:12px; margin-bottom:12rpx; }
.badge.success { color:#16734b; background:#e7f5ee; }
.badge.warning { color:#895500; background:#fff3dc; }
.badge.danger { color:#b53333; background:#fdecec; }
.tabs { display:flex; gap:12rpx; flex-wrap:wrap; margin-bottom:24rpx; }
.chip { display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding:15rpx 23rpx; border-radius:15rpx; border:1rpx solid #e8edf2; background:#fff; color:#617286; font-size:12px; }
.chip.active { color:#fff; background:#132c49; border-color:#132c49; }
.empty { text-align:center; padding:54rpx 31rpx; color:#617286; }
.consent { display:flex; gap:16rpx; align-items:flex-start; color:#132c49; background:#fff; padding:23rpx; margin:20rpx 0; border-radius:15rpx; }
checkbox { transform:scale(.85); transform-origin:top left; flex-shrink:0; }
.divider { height:1rpx; background:#e8edf2; margin:24rpx 0; }
.link-row { display:block; min-height:44px; padding:20rpx 0; color:#132c49; border-bottom:1rpx solid #e8edf2; }
.score { color:#132c49; font-family:Inter,Arial,sans-serif; font-size:100rpx; line-height:1.3; font-weight:700; text-align:center; padding:20rpx 0; }
.clock { color:#132c49; font-family:Inter,Arial,sans-serif; font-size:64rpx; text-align:center; }
.media-image,.media-video { width:100%; border-radius:16rpx; margin:16rpx 0; }
.media-image { max-height:900rpx; }
@media (min-width:600px) { .page { max-width:600px; } .action-bar { left:50%; transform:translateX(-50%); width:600px; } }
