page { background:#f5f7fa; color:#152c43; font-family:'Noto Sans SC','Noto Sans CJK SC',-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',Arial,sans-serif; font-size:14px; line-height:24px; }
view,button,input,textarea,picker,scroll-view { box-sizing:border-box; }
.page { padding:20px; padding-bottom:calc(20px + env(safe-area-inset-bottom)); max-width:600px; margin:0 auto; }
.page.has-actions,.has-actions { padding-bottom:calc(152px + env(safe-area-inset-bottom)); }
.card { background:#fff; border-radius:16px; padding:16px; margin-bottom:16px; overflow-wrap:anywhere; }
.hero { background:#132c49; color:#fff; border-radius:16px; padding:24px; margin-bottom:16px; }
.hero .muted { color:#fff; font-size:14px; line-height:24px; }
.hero .title { color:#fff; margin-bottom:12px; }
.title,.page-title { color:#132c49; font-size:22px; line-height:34px; font-weight:700; margin:0 0 12px; }
.subtitle,.section-title { color:#132c49; font-size:18px; line-height:28px; font-weight:500; margin:0 0 8px; }
.muted,.small { font-size:12px; line-height:20px; }
.muted { color:#617286; }
.money,.numeric { font-family:Inter,'DIN Alternate',Arial,sans-serif; font-variant-numeric:tabular-nums; font-weight:600; color:#132c49; }
.notice { color:#132c49; background:#eaf0f7; padding:16px; border-radius:12px; margin-bottom:16px; overflow-wrap:anywhere; }
.notice .section-title { font-size:14px; line-height:24px; margin-bottom:4px; }
.notice.warning,.warning { color:#895500; background:#fff3dc; }
.notice.danger { background:#fdecec; color:#b53333; }
.error { color:#b53333; background:#fdecec; border-radius:8px; padding:12px; margin-bottom:12px; overflow-wrap:anywhere; }
.field-label { display:block; color:#617286; font-size:12px; line-height:20px; margin-bottom:4px; }
.field,input.field,textarea.field { display:block; border:1px solid #e8edf2; border-radius:8px; width:100%; min-height:44px; background:white; color:#152c43; padding:9px 12px; margin:4px 0 12px; font-size:16px; line-height:24px; }
textarea.field { min-height:96px; }
picker.field { padding:9px 12px; font-size:14px; }
button { display:block; width:100%; min-height:44px; padding:10px 12px; margin:0 0 8px; border-radius:8px; font-family:inherit; font-size:14px; line-height:24px; font-weight:500; text-align:center; color:#132c49; background:#fff; white-space:normal; overflow-wrap:anywhere; }
button::after { border:1px solid #e8edf2; border-radius:8px; }
button.primary,.primary { color:#fff; background:#132c49; }
button.primary::after,button.quiet::after,button.accent::after { border:none; }
button.accent { color:#132c49; background:#ff6b2d; }
button.secondary { background:#fff; color:#132c49; }
button.quiet { background:transparent; color:#132c49; }
button.danger { color:#b53333; background:#fdecec; }
button[disabled],button.primary[disabled] { color:#617286; background:#eaf0f7; opacity:1; }
button.inline { display:inline-block; width:auto; margin-right:8px; }
.action-bar { position:fixed; z-index:10; bottom:0; left:0; right:0; background:#fff; border-radius:16px 16px 0 0; padding:12px 20px calc(24px + env(safe-area-inset-bottom)); }
.action-bar button { width:100%; max-width:560px; margin:0 auto 8px; }
.action-bar button:last-child { margin-bottom:0; }
.row { padding:10px 0; border-bottom:1px solid #e8edf2; overflow-wrap:anywhere; }
.row:last-child { border-bottom:0; }
.row-between { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }
.row-between > view,.row-between > text { min-width:0; overflow-wrap:anywhere; }
.stack > view,.stack > button { margin-bottom:12px; }
.inline { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
.stat-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; margin-bottom:16px; }
.stat { padding:16px; border-radius:12px; background:#fff; min-width:0; }
.stat .numeric { font-size:30px; line-height:40px; }
.badge { display:inline-block; color:#132c49; background:#eaf0f7; padding:2px 8px; border-radius:24px; font-size:12px; line-height:20px; margin-bottom:6px; }
.badge.success { color:#16734b; background:#e7f5ee; }
.badge.warning { color:#895500; background:#fff3dc; }
.badge.danger { color:#b53333; background:#fdecec; }
.tabs { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px; }
.chip { display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding:10px 12px; border-radius:8px; border:1px solid #e8edf2; background:#fff; color:#617286; font-size:12px; line-height:20px; }
.chip.active { color:#fff; background:#132c49; border-color:#132c49; }
.empty { text-align:center; padding:28px 16px; color:#617286; }
.state-panel { padding:24px; border:1px solid #e8edf2; }
.state-label { display:block; color:#617286; font-size:12px; line-height:20px; margin-bottom:12px; }
.state-panel .subtitle { margin-bottom:12px; }
.state-panel button { margin-top:16px; margin-bottom:0; }
.state-panel button + button { margin-top:8px; }
.loading-lines { display:flex; flex-direction:column; gap:8px; margin-top:16px; }
.loading-lines > view { height:12px; width:100%; border-radius:4px; background:#eaf0f7; }
.loading-lines > view:last-child { width:82%; }
.consent { display:flex; gap:8px; align-items:flex-start; color:#132c49; background:#fff; padding:12px; margin:12px 0; border-radius:8px; }
checkbox { transform:scale(.85); transform-origin:top left; flex-shrink:0; }
.divider { height:1px; background:#e8edf2; margin:12px 0; }
.link-row { display:block; min-height:44px; padding:10px 0; color:#132c49; border-bottom:1px solid #e8edf2; }
.score { color:#132c49; font-family:Inter,Arial,sans-serif; font-size:52px; line-height:68px; font-weight:700; text-align:center; padding:12px 0; }
.clock { color:#132c49; font-family:Inter,Arial,sans-serif; font-size:34px; line-height:44px; text-align:center; }
.media-image,.media-video { width:100%; border-radius:8px; margin:8px 0; }
.media-image { max-height:468px; }
@media (min-width:600px) { .action-bar { left:50%; transform:translateX(-50%); width:600px; } }
.notice.success-notice { color:#16734b; background:#e7f5ee; }
.intro-card { background:#fff; border-radius:16px; padding:16px; margin-bottom:12px; }
.intro-card .badge { margin:8px 0 0; }
.section-label { margin:16px 0 8px; color:#617286; font-size:12px; line-height:20px; font-weight:600; }
.page.mgmt-page button { width:100%; margin-left:0; margin-right:0; }
.page.mgmt-page button.small-button { width:auto; min-width:44px; min-height:44px; padding:10px; margin:0; font-size:12px; line-height:24px; }
.page.mgmt-page .mode-choice button,.page.mgmt-page .pad button { margin:0; }
.board { padding:16px 16px 14px; border-radius:16px; background:#132c49; color:#fff; margin-bottom:12px; }
.board-meta { color:#d7e0ea; font-size:12px; line-height:20px; overflow-wrap:anywhere; }
.board-row { display:flex; align-items:center; gap:8px; margin-top:12px; }
.board-team { flex:1; min-width:0; text-align:center; }
.board-name { font-size:14px; line-height:20px; font-weight:600; overflow-wrap:anywhere; }
.board-score { font-family:Inter,'DIN Alternate',Arial,sans-serif; font-size:44px; line-height:56px; font-weight:700; font-variant-numeric:tabular-nums; }
.board-mid { flex:none; width:88px; text-align:center; }
.board-status { display:inline-block; padding:2px 8px; border-radius:24px; background:rgba(255,255,255,.16); font-size:12px; line-height:20px; }
.board-status.live { background:#ff6b2d; }
.board-clock { margin-top:6px; font-family:Inter,'DIN Alternate',Arial,sans-serif; font-size:24px; line-height:32px; font-variant-numeric:tabular-nums; }
.board-period { color:#d7e0ea; font-size:12px; line-height:20px; }
.board-sub { margin-top:8px; text-align:center; color:#d7e0ea; font-size:12px; line-height:20px; }
.board-result { margin-top:8px; text-align:center; font-size:12px; line-height:20px; color:#ffd3bf; }
.board-result.final { color:#9fe0bf; }
.mode-choice { display:flex; gap:8px; margin:12px 0; }
.mode-choice button { flex:1; min-width:0; color:#617286; }
.mode-choice button.selected { color:#fff; background:#132c49; }
.mode-choice button.selected::after { border:none; }
@media(max-width:360px) { .board-score { font-size:36px; line-height:48px; } .board-mid { width:76px; } }
/* Shared match rows and tables (event, match, scoring tasks, registration review). */
.org-match { background:#fff; border-radius:12px; padding:12px 16px; margin-bottom:8px; }
.org-match-meta { color:#617286; font-size:12px; line-height:20px; }
.org-match-teams { display:flex; align-items:center; justify-content:space-between; gap:8px; margin:4px 0; font-size:16px; line-height:24px; font-weight:600; color:#132c49; }
.org-match-teams > text { flex:1; min-width:0; overflow-wrap:anywhere; }
.org-match-teams > text:last-child { text-align:right; }
text.org-match-vs { flex:none; color:#7c91a9; font-size:12px; font-weight:500; }
.org-match-status { color:#617286; font-size:12px; line-height:20px; }
.org-match-status.live { color:#ff6b2d; font-weight:600; }
.org-table-card .subtitle { margin:0; }
.org-table { margin-top:8px; }
.org-table-row { display:flex; align-items:center; gap:6px; min-height:40px; padding:6px 0; border-bottom:1px solid #e8edf2; font-size:13px; line-height:20px; }
.org-table-row:last-child { border-bottom:0; }
.org-table-row.head { min-height:32px; color:#617286; font-size:12px; }
.rank-cell { width:40px; flex:none; color:#617286; }
.team-cell { flex:1; min-width:0; overflow-wrap:anywhere; color:#132c49; }
.num-cell { width:52px; flex:none; text-align:right; font-variant-numeric:tabular-nums; }
.num-cell.strong { font-weight:700; color:#132c49; }
@media(max-width:360px) { .num-cell { width:40px; } .rank-cell { width:34px; } }
.org-match-more { color:#7c91a9; font-size:12px; line-height:20px; }
.page.mgmt-page button.small-button { flex:none; white-space:nowrap; }
.num-cell.record { width:56px; white-space:nowrap; }
@media(max-width:360px) { .num-cell.record { width:48px; font-size:12px; } }
/* Shared management forms (event setup, scheduling). */
.setup-block { padding:8px 0 4px; border-bottom:1px solid #e8edf2; }
.setup-block:last-of-type { border-bottom:0; }
.upload-stage { margin:8px 0; padding:8px 12px; border-radius:8px; background:#eaf0f7; color:#132c49; font-size:13px; line-height:20px; overflow-wrap:anywhere; }
.upload-stage.saved { background:#e7f5ee; color:#16734b; }
.upload-stage.failed { background:#fff3dc; color:#895500; }
.setup-name { margin:6px 0 4px; font-size:20px; line-height:30px; font-weight:700; overflow-wrap:anywhere; }
.setup-pair { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
.setup-trio { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }
.setup-switch { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:44px; padding:8px 0; border-bottom:1px solid #e8edf2; color:#132c49; }
.setup-flag { flex:none; padding:2px 10px; border-radius:24px; background:#eaf0f7; color:#617286; font-size:12px; line-height:20px; }
.setup-flag.on { background:#132c49; color:#fff; }
.setup-order { justify-content:flex-start; }
.setup-rank { flex:none; width:24px; height:24px; border-radius:12px; background:#eaf0f7; color:#617286; font-size:12px; line-height:24px; text-align:center; }
.setup-rank.on { background:#132c49; color:#fff; }
.setup-order-name { flex:1; min-width:0; }
.page.mgmt-page .setup-actions { margin:8px 0 12px; }
