page {
  background: #f4f6f9;
  color: #142b48;
  font-size: 30rpx;
}
.page {
  padding: 28rpx;
}
.card {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  overflow-wrap: anywhere;
}
.title {
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
}
.subtitle {
  font-size: 34rpx;
  font-weight: 600;
  margin: 16rpx 0;
}
.muted {
  color: #5d6e81;
  font-size: 26rpx;
  line-height: 1.7;
}
.notice {
  background: #fff1d8;
  padding: 22rpx;
  border-radius: 14rpx;
  margin: 18rpx 0;
}
.error {
  color: #a52b22;
}
.row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e9edf3;
}
.score {
  font-size: 70rpx;
  font-weight: 700;
  text-align: center;
}
.clock {
  font-size: 48rpx;
  text-align: center;
}
.field {
  border: 1rpx solid #ccd5df;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 18rpx 0;
}
button {
  margin: 20rpx 0;
  font-size: 30rpx;
}
button.primary {
  background: #ee622b;
  color: white;
}
.small {
  font-size: 24rpx;
}
.media-image {
  width: 100%;
  max-height: 600rpx;
}
.media-video {
  width: 100%;
}
