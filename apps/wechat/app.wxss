page { background:#f4f6fa; color:#18283f; font-family:'Noto Sans SC','Noto Sans CJK SC',-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',Arial,sans-serif; font-size:16px; line-height:24px; }
view,button,input,textarea,picker,scroll-view { box-sizing:border-box; }
.page { padding:16px; padding-bottom:calc(132px + env(safe-area-inset-bottom)); max-width:600px; margin:0 auto; }
.page.has-actions,.has-actions { padding-bottom:calc(152px + env(safe-area-inset-bottom)); }
.card { background:#fff; border-radius:18px; box-shadow:inset 0 0 0 1px #e7ecf3; padding:16px; margin-bottom:16px; overflow-wrap:anywhere; }
.hero { background:#123c73; color:#fff; border-radius:20px; padding:24px; margin-bottom:16px; }
.hero .muted { color:#fff; font-size:14px; line-height:24px; }
.hero .title { color:#fff; margin-bottom:12px; }
.title,.page-title { color:#123c73; font-size:22px; line-height:34px; font-weight:700; margin:0 0 12px; }
.subtitle,.section-title { color:#123c73; font-size:18px; line-height:28px; font-weight:700; margin:0 0 8px; }
.muted,.small { font-size:12px; line-height:20px; }
.muted { color:#51657d; }
.money,.numeric { font-family:Inter,'DIN Alternate',Arial,sans-serif; font-variant-numeric:tabular-nums; font-weight:600; color:#123c73; }
.notice { color:#123c73; background:#eaf0f7; padding:16px; border-radius:12px; margin-bottom:16px; overflow-wrap:anywhere; }
.notice .section-title { font-size:14px; line-height:24px; margin-bottom:4px; }
.notice.warning,.warning { color:#895500; background:#fff3dc; }
.notice.danger { background:#fdecec; color:#b53333; }
.error { color:#b53333; background:#fdecec; border-radius:8px; padding:12px; margin-bottom:12px; overflow-wrap:anywhere; }
.field-label { display:block; color:#51657d; font-size:12px; line-height:20px; margin-bottom:4px; }
.field,input.field,textarea.field { display:block; border:1px solid #7c8ea5; border-radius:12px; width:100%; min-height:48px; background:white; color:#18283f; padding:11px 12px; margin:4px 0 12px; font-size:16px; line-height:24px; }
textarea.field { min-height:96px; }
picker.field { padding:11px 12px; font-size:16px; }
button { display:block; width:100%; min-height:48px; padding:12px; margin:0 0 8px; border-radius:12px; font-family:inherit; font-size:16px; line-height:24px; font-weight:600; text-align:center; color:#123c73; background:#fff; white-space:normal; overflow-wrap:anywhere; }
button::after { border:1px solid #e1e7ef; border-radius:12px; }
button.button-hover { box-shadow:inset 0 2px 5px rgba(0,0,0,.14); }
button.primary,.primary { color:#fff; background:#123c73; }
button.primary::after,button.quiet::after,button.accent::after { border:none; }
button.accent { color:#123c73; background:#f28c28; }
button.secondary { background:#fff; color:#123c73; }
button.quiet { background:transparent; color:#123c73; }
button.danger { color:#b53333; background:#fdecec; }
button[disabled],button.primary[disabled] { color:#51657d; background:#eaf0f7; opacity:1; box-shadow:none; }
button.inline { display:inline-block; width:auto; margin-right:8px; }
/* UI005 interaction baseline: page-specific visual tabs may be compact, but their touch
   target and native input text must remain usable at every supported viewport. */
.page input.field,.page textarea.field { font-size:16px !important; }
.action-bar { position:fixed; z-index:10; bottom:0; left:0; right:0; background:#fff; border-radius:16px 16px 0 0; padding:12px 20px calc(24px + env(safe-area-inset-bottom)); }
.action-bar button { width:100%; max-width:560px; margin:0 auto 8px; }
.action-bar button:last-child { margin-bottom:0; }
.row { padding:10px 0; border-bottom:1px solid #e1e7ef; overflow-wrap:anywhere; }
.row:last-child { border-bottom:0; }
.row-between { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }
.row-between > view,.row-between > text { min-width:0; overflow-wrap:anywhere; }
.stack > view,.stack > button { margin-bottom:12px; }
.inline { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
.stat-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; margin-bottom:16px; }
.stat { padding:16px; border-radius:12px; background:#fff; min-width:0; }
.stat .numeric { font-size:30px; line-height:40px; }
.badge { display:inline-block; color:#123c73; background:#eaf0f7; padding:2px 8px; border-radius:24px; font-size:12px; line-height:20px; margin-bottom:6px; }
.badge.success { color:#16734b; background:#e7f5ee; }
.badge.warning { color:#895500; background:#fff3dc; }
.badge.danger { color:#b53333; background:#fdecec; }
.tabs { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px; }
.chip { display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding:10px 12px; border-radius:8px; border:1px solid #e1e7ef; background:#fff; color:#63758b; font-size:12px; line-height:20px; }
.chip.active { color:#fff; background:#123c73; border-color:#123c73; }
.empty { text-align:center; padding:28px 16px; color:#63758b; }
.state-panel { padding:24px; border:1px solid #e1e7ef; }
.state-label { display:block; color:#63758b; font-size:12px; line-height:20px; margin-bottom:12px; }
.state-panel .subtitle { margin-bottom:12px; }
.state-panel button { margin-top:16px; margin-bottom:0; }
.state-panel button + button { margin-top:8px; }
.loading-lines { display:flex; flex-direction:column; gap:8px; margin-top:16px; }
.loading-lines > view { height:12px; width:100%; border-radius:4px; background:#eaf0f7; }
.loading-lines > view:last-child { width:82%; }
.consent { display:flex; gap:8px; align-items:flex-start; color:#123c73; background:#fff; padding:12px; margin:12px 0; border-radius:8px; }
checkbox { transform:scale(.85); transform-origin:top left; flex-shrink:0; }
.divider { height:1px; background:#e1e7ef; margin:12px 0; }
.link-row { display:block; min-height:44px; padding:10px 0; color:#123c73; border-bottom:1px solid #e1e7ef; }
.score { color:#123c73; font-family:Inter,Arial,sans-serif; font-size:52px; line-height:68px; font-weight:700; text-align:center; padding:12px 0; }
.clock { color:#123c73; font-family:Inter,Arial,sans-serif; font-size:34px; line-height:44px; text-align:center; }
.media-image,.media-video { width:100%; border-radius:8px; margin:8px 0; }
.media-image { max-height:468px; }
@media (min-width:600px) { .action-bar { left:50%; transform:translateX(-50%); width:600px; } }
.notice.success-notice { color:#16734b; background:#e7f5ee; }
.intro-card { background:#fff; border-radius:16px; padding:16px; margin-bottom:12px; }
.intro-card .badge { margin:8px 0 0; }
.section-label { margin:16px 0 8px; color:#63758b; font-size:12px; line-height:20px; font-weight:600; }
.page.mgmt-page button { width:100%; margin-left:0; margin-right:0; }
.page.mgmt-page button.small-button { width:auto; min-width:44px; min-height:44px; padding:10px; margin:0; font-size:12px; line-height:24px; }
.page.mgmt-page .mode-choice button,.page.mgmt-page .pad button { margin:0; }
.board { padding:16px 16px 14px; border-radius:16px; background:#123c73; color:#fff; margin-bottom:12px; }
.board-meta { color:#d7e0ea; font-size:12px; line-height:20px; overflow-wrap:anywhere; }
.board-row { display:flex; align-items:center; gap:8px; margin-top:12px; }
.board-team { flex:1; min-width:0; text-align:center; }
.board-name { font-size:14px; line-height:20px; font-weight:600; overflow-wrap:anywhere; }
.board-score { font-family:Inter,'DIN Alternate',Arial,sans-serif; font-size:44px; line-height:56px; font-weight:700; font-variant-numeric:tabular-nums; }
.board-mid { flex:none; width:88px; text-align:center; }
.board-status { display:inline-block; padding:2px 8px; border-radius:24px; background:rgba(255,255,255,.16); font-size:12px; line-height:20px; }
.board-status.live { background:#f28c28; }
.board-clock { margin-top:6px; font-family:Inter,'DIN Alternate',Arial,sans-serif; font-size:24px; line-height:32px; font-variant-numeric:tabular-nums; }
.board-period { color:#d7e0ea; font-size:12px; line-height:20px; }
.board-sub { margin-top:8px; text-align:center; color:#d7e0ea; font-size:12px; line-height:20px; }
.board-result { margin-top:8px; text-align:center; font-size:12px; line-height:20px; color:#ffd3bf; }
.board-result.final { color:#9fe0bf; }
.mode-choice { display:flex; gap:8px; margin:12px 0; }
.mode-choice button { flex:1; min-width:0; color:#63758b; }
.mode-choice button.selected { color:#fff; background:#123c73; }
.mode-choice button.selected::after { border:none; }
@media(max-width:360px) { .board-score { font-size:36px; line-height:48px; } .board-mid { width:76px; } }
/* Shared match rows and tables (event, match, scoring tasks, registration review). */
.org-match { background:#fff; border-radius:12px; padding:12px 16px; margin-bottom:8px; }
.org-match-meta { color:#63758b; font-size:12px; line-height:20px; }
.org-match-teams { display:flex; align-items:center; justify-content:space-between; gap:8px; margin:4px 0; font-size:16px; line-height:24px; font-weight:600; color:#123c73; }
.org-match-teams > text { flex:1; min-width:0; overflow-wrap:anywhere; }
.org-match-teams > text:last-child { text-align:right; }
text.org-match-vs { flex:none; color:#7c91a9; font-size:12px; font-weight:500; }
.org-match-status { color:#63758b; font-size:12px; line-height:20px; }
.org-match-status.live { color:#f28c28; font-weight:600; }
.org-table-card .subtitle { margin:0; }
.org-table { margin-top:8px; }
.org-table-row { display:flex; align-items:center; gap:6px; min-height:40px; padding:6px 0; border-bottom:1px solid #e1e7ef; font-size:13px; line-height:20px; }
.org-table-row:last-child { border-bottom:0; }
.org-table-row.head { min-height:32px; color:#63758b; font-size:12px; }
.rank-cell { width:40px; flex:none; color:#63758b; }
.team-cell { flex:1; min-width:0; overflow-wrap:anywhere; color:#123c73; }
.num-cell { width:52px; flex:none; text-align:right; font-variant-numeric:tabular-nums; }
.num-cell.strong { font-weight:700; color:#123c73; }
@media(max-width:360px) { .num-cell { width:40px; } .rank-cell { width:34px; } }
.org-match-more { color:#7c91a9; font-size:12px; line-height:20px; }
.page.mgmt-page button.small-button { flex:none; white-space:nowrap; }
.num-cell.record { width:56px; white-space:nowrap; }
@media(max-width:360px) { .num-cell.record { width:48px; font-size:12px; } }
/* Shared management forms (event setup, scheduling). */
.setup-block { padding:8px 0 4px; border-bottom:1px solid #e1e7ef; }
.setup-block:last-of-type { border-bottom:0; }
.upload-stage { margin:8px 0; padding:8px 12px; border-radius:8px; background:#eaf0f7; color:#123c73; font-size:13px; line-height:20px; overflow-wrap:anywhere; }
.upload-stage.saved { background:#e7f5ee; color:#16734b; }
.upload-stage.failed { background:#fff3dc; color:#895500; }
.media-preview { display:block; width:100%; height:200px; margin:8px 0; border-radius:8px; background:#0b1a2b; }
.file-actions { display:flex; flex:none; gap:6px; }
.watch-city-row { display:flex; align-items:center; gap:8px; margin:0 0 12px; }
.watch-city-row .field { flex:1; min-width:0; margin:0; }
.setup-name { margin:6px 0 4px; font-size:20px; line-height:30px; font-weight:700; overflow-wrap:anywhere; }
.setup-pair { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
.setup-trio { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }
.setup-switch { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:44px; padding:8px 0; border-bottom:1px solid #e1e7ef; color:#123c73; }
.setup-flag { flex:none; padding:2px 10px; border-radius:24px; background:#eaf0f7; color:#63758b; font-size:12px; line-height:20px; }
.setup-flag.on { background:#123c73; color:#fff; }
.setup-order { justify-content:flex-start; }
.setup-rank { flex:none; width:24px; height:24px; border-radius:12px; background:#eaf0f7; color:#63758b; font-size:12px; line-height:24px; text-align:center; }
.setup-rank.on { background:#123c73; color:#fff; }
.setup-order-name { flex:1; min-width:0; }
.page.mgmt-page .setup-actions { margin:8px 0 12px; }

/* UI001 shared content hierarchy */
.page-intro { margin-bottom:16px; }
.page-intro .title { margin-bottom:8px; }
.eyebrow { color:#63758b; font-size:12px; line-height:18px; margin-bottom:4px; }
.workflow-tabs { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:16px; }
.workflow-tabs button { flex:1 1 80px; min-width:0; margin:0; }
.workflow-section { margin-bottom:16px; }
.summary-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
.summary-grid > view { min-width:0; overflow-wrap:anywhere; }
.status-banner { padding:12px 16px; border-radius:12px; margin:0 0 16px; background:#edf3fa; color:#123c73; overflow-wrap:anywhere; }
.fixed-actions { position:fixed; z-index:15; left:0; right:0; bottom:0; padding:12px 16px calc(16px + env(safe-area-inset-bottom)); border-top:1px solid #e1e7ef; background:#fff; }
.fixed-actions button:last-child { margin-bottom:0; }
@media(min-width:600px) { .fixed-actions { width:600px; left:50%; transform:translateX(-50%); } }

.fig-page { max-width:none; background:#f4f6fa; }
.fig-summary { display:flex; align-items:center; gap:12px; margin:0 0 12px; padding:14px; border-radius:16px; background:#123c73; color:#fff; }
.fig-summary.light { background:#fff; color:#18283f; }
.fig-summary.soft { background:#eaf2fc; color:#18283f; }
.fig-summary-copy { flex:1; min-width:0; }
.fig-kicker { font-size:11px; line-height:16px; }
.fig-summary-title { margin-top:3px; font-size:21px; line-height:30px; font-weight:700; overflow-wrap:anywhere; }
.fig-summary-sub { margin-top:3px; font-size:12px; line-height:17px; }
.fig-summary-mark { width:128px; height:80px; flex:none; border-radius:10px; background:rgba(255,255,255,.14); display:flex; align-items:center; justify-content:center; }
.fig-summary.light .fig-summary-mark { background:#eaf2fc; }
.fig-summary-mark image { width:36px; height:36px; }
.fig-card { margin:0 0 12px; padding:14px; border-radius:16px; background:#fff; }
.fig-card-title { margin:0 0 8px; color:#18283f; font-size:17px; line-height:24px; font-weight:700; }
.fig-row { display:flex; align-items:center; gap:8px; min-height:55px; padding:8px 0; border-top:1px solid #e6ebf2; }
.fig-card > .fig-row:first-of-type { border-top:0; }
.fig-row-copy { flex:1; min-width:0; }
.fig-row-title { color:#18283f; font-size:14px; line-height:20px; font-weight:700; overflow-wrap:anywhere; }
.fig-pill { flex:none; height:23px; padding:0 7px; border-radius:7px; background:#fff1e2; color:#18283f; font-size:11px; line-height:23px; }
.fig-note { margin-top:8px; padding:10px; border-radius:8px; background:#eaf2fc; }
.fig-actions { position:fixed; z-index:12; left:0; right:0; bottom:calc(50px + env(safe-area-inset-bottom)); display:flex; align-items:center; gap:8px; padding:6px 16px 10px; background:#fff; }
.fig-actions.dock { bottom:0; padding-bottom:calc(16px + env(safe-area-inset-bottom)); }
.fig-actions button { height:auto; min-height:48px; margin:0; padding:8px 12px; border-radius:24px; font-size:16px; line-height:24px; font-weight:500; white-space:normal; overflow-wrap:anywhere; }
.fig-actions button::after { border:0; }
.fig-ghost { flex:1 1 auto; width:auto; min-width:0; color:#123c73; background:#fff; box-shadow:inset 0 0 0 1px #7c8ea5; }
.fig-confirm { flex:1 1 auto; width:auto; min-width:0; color:#18283f; background:#f28c28; }
.fig-confirm[disabled],.fig-ghost[disabled] { color:#63758b; background:#eaf0f7; }
