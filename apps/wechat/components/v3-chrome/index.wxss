.v3-chrome { margin:0 0 8px; }
.v3-chrome button { width:auto; min-height:44px; margin:0; padding:0; background:transparent; color:#18283f; font-weight:500; }
.v3-chrome button::after { border:0; }
.v3-brand { height:44px; display:flex; align-items:center; gap:8px; }
.v3-mark { width:36px; height:36px; flex:none; }
.v3-name { color:#123c73; font-size:20px; line-height:28px; font-weight:700; }
.v3-tools { display:flex; align-items:center; gap:8px; margin-top:4px; }
.v3-city,.v3-search,.v3-bell { display:flex; align-items:center; }
.v3-city { flex:none; max-width:96px; gap:2px; padding:0 4px; color:#18283f; font-size:16px; line-height:24px; font-weight:600; }
.v3-city view,.v3-search view { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.v3-city image,.v3-search image { width:18px; height:18px; flex:none; }
.v3-search { flex:1 1 120px; width:auto; min-width:120px; height:44px; gap:8px; padding:0 14px; border-radius:999px; background:#f7f8fc; color:#63758b; font-size:14px; line-height:22px; font-weight:400; text-align:left; box-shadow:inset 0 0 0 1px #e6ebf2; }
.v3-chrome button.v3-bell { flex:none; width:44px; min-width:44px; height:44px; justify-content:center; }
.v3-bell image { width:24px; height:24px; }
