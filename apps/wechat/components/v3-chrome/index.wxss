:host { display:block; }
.v3-chrome { margin:0 0 12px; background:#fff; }
.v3-chrome.has-title { margin:-16px -16px 12px; }
.v3-control { box-sizing:border-box; width:auto; min-height:44px; margin:0; padding:0; background:transparent; color:#18283f; font-weight:500; border-radius:12px; }
.v3-control::after { border:0; }
.v3-brand { box-sizing:border-box; height:64px; min-height:64px; display:flex; align-items:center; gap:8px; padding:0 16px; }
.v3-mark { width:28px; height:28px; flex:none; }
.v3-name { color:#123c73; font-size:16px; line-height:24px; font-weight:500; letter-spacing:0; white-space:nowrap; }
.v3-tools { padding:0 16px 10px; }
.v3-tools { display:flex; align-items:center; gap:8px; margin-top:8px; }
.v3-city,.v3-search,.v3-bell { display:flex; align-items:center; }
.v3-city { flex:none; max-width:88px; gap:2px; font-size:14px; line-height:22px; font-weight:600; }
.v3-city-label,.v3-search-label { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.v3-tool-icon { width:18px; height:18px; flex:none; }
.v3-search { flex:1 1 100px; min-width:100px; height:44px; gap:6px; padding:0 12px; background:#fff; color:#63758b; font-size:12px; line-height:20px; text-align:left; box-shadow:inset 0 0 0 1px #e1e7ef; }
.v3-bell { flex:none; width:44px; min-width:44px; height:44px; justify-content:center; background:#fff; box-shadow:inset 0 0 0 1px #e1e7ef; }
.v3-bell-icon { width:22px; height:22px; }
