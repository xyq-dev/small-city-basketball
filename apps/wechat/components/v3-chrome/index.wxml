<view class="v3-chrome {{title ? 'has-title' : ''}}" style="padding-top:{{statusBarHeight}}px">
  <view class="v3-brand" style="padding-right:{{capsuleGap}}px">
    <image class="v3-mark" src="/assets/home/brandmark.svg" mode="aspectFit"/>
    <view class="v3-name">{{title || '小城市篮球'}}</view>
  </view>
  <view wx:if="{{tools}}" class="v3-tools">
    <button class="v3-control v3-city" bindtap="onCity" aria-label="选择城市"><view class="v3-city-label">{{city || '全国'}}</view><image class="v3-tool-icon" src="/assets/home/chevron-down.svg" mode="aspectFit"/></button>
    <button class="v3-control v3-search" bindtap="onSearch" aria-label="搜索"><image class="v3-tool-icon" src="/assets/home/search.svg" mode="aspectFit"/><view class="v3-search-label">{{placeholder}}</view></button>
    <button class="v3-control v3-bell" bindtap="onBell" aria-label="消息"><image class="v3-bell-icon" src="/assets/home/bell.svg" mode="aspectFit"/></button>
  </view>
</view>
