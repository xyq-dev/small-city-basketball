page { background:#f7f8fb; }
.page.watch-page .v3-hero,
.page.local-page .local-brand.v3-hero {
  position:relative;
  height:auto;
  min-height:188px;
  margin:0 0 12px;
  padding:0;
  border-radius:16px;
  overflow:hidden;
  background:#123c73;
  box-shadow:0 10px 24px rgba(18,60,115,.16);
}
.v3-hero-photo,.v3-hero-shade { position:absolute; inset:0; }
.v3-hero-photo { width:100%; height:100%; }
.v3-hero-shade { background:linear-gradient(90deg,rgba(8,28,58,.78) 0%,rgba(8,28,58,.42) 48%,rgba(8,28,58,.08) 78%); }
.v3-hero-copy,.page.local-page .local-brand.v3-hero .local-brand-row {
  position:relative;
  z-index:1;
  min-height:188px;
  display:flex;
  align-items:flex-start;
  justify-content:center;
  flex-direction:column;
  padding:16px;
  color:#fff;
}
.page.local-page .local-brand.v3-hero .local-brand-row { flex-direction:row; align-items:center; }
.v3-eyebrow,.page.local-page .local-brand.v3-hero .local-brand-eyebrow { color:#fff; font-size:11px; line-height:16px; letter-spacing:.4px; font-weight:600; }
.v3-headline,.page.local-page .local-brand.v3-hero .local-brand-title { margin-top:4px; color:#fff; font-size:28px; line-height:34px; font-weight:700; overflow-wrap:anywhere; }
.v3-tagline,.page.local-page .local-brand.v3-hero .local-brand-services { margin-top:4px; color:#fff; font-size:13px; line-height:18px; overflow-wrap:anywhere; }
.page.watch-page button.v3-hero-btn,.page.local-page button.v3-hero-btn {
  width:auto;
  min-height:44px;
  margin:10px 0 0;
  padding:0 16px;
  display:inline-flex;
  align-items:center;
  border-radius:999px;
  background:#f28c28;
  color:#fff;
  font-size:16px;
  line-height:24px;
  font-weight:700;
}
.page.watch-page button.v3-hero-btn::after,.page.local-page button.v3-hero-btn::after { border:0; }
.page.watch-page .mode-choice button.selected { background:#f28c28; color:#fff; }
.page.watch-page .v3-event-card {
  display:flex;
  flex-direction:column;
  gap:8px;
  margin:0 0 12px;
  padding:10px;
  border-radius:16px;
  background:#fff;
  box-shadow:0 8px 24px rgba(18,60,115,.08);
}
.page.watch-page .v3-event-card .public-event-cell {
  display:flex;
  align-items:stretch;
  gap:12px;
  width:100%;
  min-height:96px;
  margin:0;
  padding:0;
  border-radius:0;
  background:transparent;
  text-align:left;
}
.page.watch-page .v3-event-card .public-event-cell::after { border:0; }
.v3-event-photo-wrap { position:relative; width:42%; min-width:84px; height:96px; flex:none; border-radius:12px; overflow:hidden; }
.v3-event-photo { width:100%; height:100%; }
.v3-event-caption { position:absolute; left:6px; bottom:6px; padding:0 6px; border-radius:999px; background:rgba(18,40,63,.72); color:#fff; font-size:10px; line-height:18px; }
.v3-event-status { display:inline-flex; max-width:100%; padding:0 8px; border-radius:999px; background:#fff1e0; color:#e07b12; font-size:12px; line-height:22px; font-weight:600; overflow-wrap:anywhere; }
.page.watch-page .v3-event-actions { display:flex; gap:8px; }
.page.watch-page .v3-event-actions button { flex:1; min-width:0; width:auto; min-height:44px; margin:0; padding:8px; font-size:14px; line-height:22px; }
.page.local-page .local-service-tabs { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px; }
.page.local-page .local-service-tabs button {
  flex:none;
  width:auto;
  min-width:0;
  min-height:74px;
  margin:0;
  padding:6px 2px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:4px;
  border-radius:16px;
  background:#fff;
  color:#18283f;
  font-size:12px;
  line-height:16px;
  box-shadow:0 8px 24px rgba(18,60,115,.06);
}
.page.local-page .local-service-tabs button:first-child { flex-basis:auto; width:auto; }
.page.local-page .local-service-tabs image { width:36px; height:36px; }
.page.local-page .local-service-tabs button.active { background:#fff7ef; color:#e07b12; box-shadow:inset 0 0 0 1px #f28c28; }
.page.local-page .v3-listing-photo { display:block; width:100%; height:96px; border-radius:12px; }
.page.local-page .listing-card { position:relative; }
.page.local-page .court-illustration { position:absolute; top:24px; right:24px; width:36px; height:36px; }
.page.local-page .listing-card .subtitle,.page.watch-page .watch-event-name,.page.teams-page .team-name,.page.account-page .account-name { overflow-wrap:anywhere; }
.page.teams-page .teams-tabs { align-items:center; padding:4px; border-radius:16px; background:#fff; }
.page.teams-page .teams-tabs button.selected { background:transparent; color:#f28c28; }
.page.teams-page .teams-tabs .teams-add {
  width:44px;
  min-width:44px;
  height:44px;
  margin:0 0 0 auto;
  padding:0;
  display:flex;
  align-items:center;
  justify-content:center;
}
.page.teams-page .team-profile { position:relative; overflow:hidden; min-height:160px; background:#123c73; }
.page.teams-page .team-banner,.page.teams-page .team-banner-shade { position:absolute; inset:0; width:100%; height:100%; }
.page.teams-page .team-banner-shade { background:linear-gradient(90deg,rgba(8,28,58,.84),rgba(8,28,58,.28)); }
.page.teams-page .team-person,.page.teams-page .team-copy { position:relative; z-index:1; }
.page.teams-page .team-name,.page.teams-page .team-meta,.page.teams-page .team-copy { color:#fff; }
.page.teams-page .team-avatar { align-items:center; border-radius:16px; background:rgba(255,255,255,.18); }
.page.local-page .local-top-tabs { flex-wrap:wrap; }
.page.local-page .local-top-tabs .local-city-tab { max-width:100%; white-space:normal; overflow:visible; text-overflow:clip; }
.page.account-page .account-avatar { align-items:center; border-radius:50%; }
.page.account-page .account-shortcuts {
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:8px;
  padding:0;
  background:transparent;
}
.page.account-page .account-shortcuts .menu-title { grid-column:1 / -1; margin:0; }
.page.account-page .account-shortcuts .menu-row {
  flex-direction:column;
  align-items:center;
  justify-content:flex-start;
  width:auto;
  min-height:88px;
  margin:0;
  padding:10px 4px;
  border-radius:16px;
  background:#fff;
  text-align:center;
  box-shadow:0 8px 24px rgba(18,60,115,.06);
}
.page.account-page .account-shortcuts .menu-text { align-items:center; text-align:center; }
.page.account-page .account-shortcuts .menu-chevron { display:none; }
.page.account-page .account-shortcuts .menu-icon { width:28px; height:28px; flex-basis:28px; }
.page.account-page .account-workspace { background:#fff7ef; box-shadow:inset 0 0 0 1px #f6d7b0; }
@media (max-width:360px) {
  .page.watch-page .v3-hero,.page.local-page .local-brand.v3-hero,
  .v3-hero-copy,.page.local-page .local-brand.v3-hero .local-brand-row { height:auto; min-height:180px; }
  .v3-headline,.page.local-page .local-brand.v3-hero .local-brand-title { font-size:24px; line-height:30px; }
  .v3-event-photo-wrap { min-width:72px; height:88px; }
  .page.account-page .account-shortcuts { grid-template-columns:repeat(2,minmax(0,1fr)); }
}
