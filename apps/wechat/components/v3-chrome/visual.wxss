/* UI005 shared vocabulary. Each page owns its layout. No cross-page overrides. */
.v3-eyebrow { color:#63758b; font-size:11px; line-height:18px; font-weight:700; letter-spacing:1.2px; }
.v3-headline { color:#123c73; font-size:26px; line-height:34px; font-weight:700; }
.v3-tagline { color:#63758b; font-size:13px; line-height:22px; }
.v3-section-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:24px 0 12px; }
.v3-section-title { color:#18283f; font-size:18px; line-height:28px; font-weight:700; }
.v3-section-action { flex:none; width:auto; min-height:44px; margin:0; padding:8px 0 8px 12px; background:transparent; color:#63758b; font-size:12px; line-height:22px; }
.v3-section-action::after { border:0; }
.v3-event-caption { position:absolute; left:8px; bottom:8px; padding:2px 6px; border-radius:6px; background:rgba(18,40,63,.75); color:#fff; font-size:10px; line-height:16px; }
