:host, .figma-nav, .figma-nav__item, .figma-nav__icon { box-sizing:border-box; }
.figma-nav { position:fixed; z-index:40; right:0; bottom:0; left:0; display:flex; align-items:flex-start; border-top:1px solid #e6ebf2; background:#ffffff; }
.figma-nav__item { display:flex; height:50px; min-width:0; min-height:50px; flex:1; flex-direction:column; align-items:center; justify-content:center; gap:0; margin:0; padding:0; border:0; border-radius:0; background:#ffffff; color:#51657d; font-family:"Noto Sans SC","PingFang SC","Microsoft YaHei",sans-serif; font-size:11px; font-weight:400; line-height:16px; text-align:center; }
.figma-nav__item::after { border:0; }
.figma-nav__item[disabled] { background:#ffffff; color:#7c8ea5; opacity:.6; }
.figma-nav__icon { display:flex; width:46px; height:28px; flex:none; align-items:center; justify-content:center; border-radius:14px; }
.figma-nav__item.is-active { color:#123c73; font-weight:700; }
.figma-nav__item.is-active .figma-nav__icon { background:#fff1e2; }
.figma-nav__label { height:16px; }
