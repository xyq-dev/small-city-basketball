.mobile-nav { position:fixed; z-index:20; bottom:0; left:0; right:0; height:calc(72px + env(safe-area-inset-bottom)); display:flex; align-items:center; justify-content:space-between; background:#fff; border-top:1px solid #e8edf2; padding:12px 12px calc(12px + env(safe-area-inset-bottom)); }
.nav-item { flex:1; min-width:0; min-height:44px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px; padding:0; margin:0; border-radius:0; font-size:12px; line-height:20px; font-weight:400; color:#617286; background:#fff; }
.nav-item::after { border:0; }
.nav-dot { height:20px; font-size:12px; line-height:20px; }
.nav-item.selected { color:#132c49; }
.nav-item[disabled] { background:#fff; color:#a3b2c1; opacity:.65; }
