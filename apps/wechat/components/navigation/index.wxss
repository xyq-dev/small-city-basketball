:host,.mobile-nav,.nav-item { box-sizing:border-box; }
.mobile-nav { position:fixed; z-index:20; bottom:0; left:0; right:0; height:calc(50px + env(safe-area-inset-bottom)); display:flex; align-items:flex-start; justify-content:space-between; background:#fff; border-top:0.6px solid #e6ebf2; padding:0 0 env(safe-area-inset-bottom); }
.nav-item { position:relative; flex:1; min-width:0; height:50px; min-height:50px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px; padding:0; margin:0; border-radius:0; font-size:11px; line-height:16px; font-weight:400; color:#63758b; background:transparent; }
.nav-item::after { border:0; }
.nav-item.selected { color:#123c73; font-weight:700; background:transparent; }
.nav-item.is-disabled { color:#a3b2c1; opacity:.65; }
.nav-glyph { width:46px; height:27px; display:flex; align-items:center; justify-content:center; border-radius:14px; }
.nav-item.selected .nav-glyph { background:#fff1e2; }
.nav-asset { display:block; width:23px; height:23px; flex:none; }
@media(min-width:600px) { .mobile-nav { left:50%; right:auto; width:600px; transform:translateX(-50%); } }
