.mobile-nav { position:fixed; z-index:20; bottom:0; left:0; right:0; display:flex; justify-content:space-around; background:#fff; border-top:1rpx solid #e8edf2; padding:14rpx 8rpx calc(18rpx + env(safe-area-inset-bottom)); }
.nav-item { flex:1; min-width:0; min-height:44px; padding:4rpx 10rpx; margin:0; border-radius:0; font-size:12px; line-height:1.5; color:#617286; background:#fff; }
.nav-item::after { border:0; }
.nav-dot { font-size:28rpx; line-height:1.4; }
.nav-item.selected { color:#132c49; font-weight:600; }
