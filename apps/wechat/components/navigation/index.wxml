<view class="mobile-nav premium-nav" style="height:{{50+safeBottom}}px;padding-bottom:{{safeBottom}}px"><button wx:for="{{items}}" wx:key="key" class="nav-item {{(active==='Video'?'Events':active)===item.key ? 'selected' : ''}}{{disabled ? ' is-disabled' : ''}}" data-key="{{item.key}}" bindtap="go" disabled="{{disabled}}" aria-label="{{item.label}}"><view class="nav-glyph"><image wx:if="{{item.key==='Home' && active==='Home'}}" class="nav-asset" src="/assets/home/home-active.svg" mode="aspectFit" aria-hidden="true"/><image wx:elif="{{item.key==='Home'}}" class="nav-asset" src="/assets/home/home.svg" mode="aspectFit" aria-hidden="true"/><image wx:elif="{{item.key==='Events' && (active==='Events' || active==='Video')}}" class="nav-asset" src="/assets/home/trophy-active.svg" mode="aspectFit" aria-hidden="true"/><image wx:elif="{{item.key==='Events'}}" class="nav-asset" src="/assets/home/trophy.svg" mode="aspectFit" aria-hidden="true"/><image wx:elif="{{item.key==='Local' && active==='Local'}}" class="nav-asset" src="/assets/home/pin-active.svg" mode="aspectFit" aria-hidden="true"/><image wx:elif="{{item.key==='Local'}}" class="nav-asset" src="/assets/home/pin.svg" mode="aspectFit" aria-hidden="true"/><image wx:elif="{{item.key==='Teams' && active==='Teams'}}" class="nav-asset" src="/assets/home/team-active.svg" mode="aspectFit" aria-hidden="true"/><image wx:elif="{{item.key==='Teams'}}" class="nav-asset" src="/assets/home/team.svg" mode="aspectFit" aria-hidden="true"/><image wx:elif="{{item.key==='Account' && active==='Account'}}" class="nav-asset" src="/assets/home/profile-active.svg" mode="aspectFit" aria-hidden="true"/><image wx:else class="nav-asset" src="/assets/home/profile.svg" mode="aspectFit" aria-hidden="true"/></view><view>{{item.label}}</view></button></view>
