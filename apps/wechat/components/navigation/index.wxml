<view class="mobile-nav premium-nav" style="height:{{59+safeBottom}}px;padding-bottom:{{safeBottom}}px"><button wx:for="{{items}}" wx:key="key" class="nav-item {{(active==='Video'?'Events':active)===item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="go" disabled="{{disabled}}" aria-label="{{item.label}}"><image wx:if="{{item.key==='Home' && active==='Home'}}" class="nav-asset" src="/assets/ui002/nav-home-active.svg" mode="aspectFit" aria-hidden="true"/><image wx:elif="{{item.key==='Local' && active!=='Local'}}" class="nav-asset" src="/assets/ui002/nav-local.svg" mode="aspectFit" aria-hidden="true"/><image wx:elif="{{item.key==='Account' && active!=='Account'}}" class="nav-asset" src="/assets/ui002/nav-account.svg" mode="aspectFit" aria-hidden="true"/><scb-icon wx:else name="{{item.icon}}" tone="{{(active==='Video'?'Events':active)===item.key ? 'navy' : 'gray'}}" size="24"/><view>{{item.label}}</view></button></view>
