<view class="mobile-nav {{variant === 'premium' ? 'premium-nav' : ''}}"><button wx:for="{{items}}" wx:key="key" class="nav-item {{active===item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="go" disabled="{{disabled}}"><scb-icon wx:if="{{variant === 'premium'}}" name="{{item.icon}}" tone="{{active===item.key ? 'orange' : 'navy'}}" size="23"/><view wx:else class="nav-dot">{{active===item.key ? '●' : '○'}}</view><view>{{item.label}}</view></button></view>
