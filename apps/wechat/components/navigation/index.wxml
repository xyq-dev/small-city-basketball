<view class="mobile-nav premium-nav"><button wx:for="{{items}}" wx:key="key" class="nav-item {{active===item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="go" disabled="{{disabled}}" aria-label="{{item.label}}"><scb-icon name="{{item.icon}}" tone="{{active===item.key ? 'orange' : 'gray'}}" size="24"/><view>{{item.label}}</view></button></view>
