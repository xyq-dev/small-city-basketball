<view class="figma-nav" style="height:{{50+safeBottom}}px;padding-bottom:{{safeBottom}}px" role="navigation">
  <button wx:for="{{items}}" wx:key="key" class="figma-nav__item {{(active==='Video'?'Events':active)===item.key ? 'is-active' : ''}}" data-key="{{item.key}}" bindtap="go" disabled="{{disabled}}" aria-label="{{item.label}}">
    <view class="figma-nav__icon"><figma-icon name="{{item.icon}}" active="{{(active==='Video'?'Events':active)===item.key}}" size="23"/></view>
    <view class="figma-nav__label">{{item.label}}</view>
  </button>
</view>
