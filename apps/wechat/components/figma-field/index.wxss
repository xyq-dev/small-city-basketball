.figma-field { box-sizing:border-box; display:flex; width:100%; flex-direction:column; gap:6px; }
.figma-field__label { color:#18283f; font-size:14px; font-weight:500; line-height:22px; }
.figma-field__control { box-sizing:border-box; width:100%; height:48px; min-height:48px; padding:0 12px; border:1px solid #7c8ea5; border-radius:12px; background:#ffffff; color:#18283f; font-size:16px; line-height:24px; }
.figma-field__control:focus { border-color:#123c73; box-shadow:0 0 0 2px rgba(18,60,115,.12); }
.figma-field__hint { color:#51657d; font-size:12px; line-height:18px; }
.has-error .figma-field__control { border-color:#c83f42; }
.has-error .figma-field__hint { color:#c83f42; }
.is-disabled .figma-field__control { border-color:#e6ebf2; background:#f4f6fa; color:#7c8ea5; }
