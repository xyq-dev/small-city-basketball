<view class="figma-field {{error ? 'has-error' : ''}} {{disabled ? 'is-disabled' : ''}}"><view class="figma-field__label">{{label}}</view><input class="figma-field__control" value="{{value}}" placeholder="{{placeholder}}" password="{{password}}" disabled="{{disabled}}" maxlength="{{maxlength}}" cursor-spacing="{{cursorSpacing}}" bindinput="input"/><view wx:if="{{error || hint}}" class="figma-field__hint">{{error || hint}}</view></view>
