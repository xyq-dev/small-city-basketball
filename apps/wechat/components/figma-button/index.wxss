:host { display:inline-flex; max-width:100%; }
.figma-button { box-sizing:border-box; display:inline-flex; width:auto; min-width:96px; height:48px; min-height:48px; align-items:center; justify-content:center; gap:8px; margin:0; padding:0 24px; border:0; border-radius:24px; font-family:"Noto Sans SC","PingFang SC","Microsoft YaHei",sans-serif; font-size:16px; font-weight:500; line-height:24px; text-align:center; white-space:normal; }
.figma-button::after { border:0; }
.figma-button.is-block { width:100%; }
.figma-button--orange { background:#f28c28; color:#18283f; }
.figma-button--navy { background:#123c73; color:#ffffff; }
.figma-button--wechat { background:#07c160; color:#18283f; }
.figma-button--ghost { box-shadow:inset 0 0 0 1px #7c8ea5; background:#ffffff; color:#123c73; }
.figma-button[disabled] { background:#e6ebf2; color:#7c8ea5; opacity:1; }
.figma-button__spinner { width:18px; height:18px; flex:none; border:2px solid currentColor; border-right-color:transparent; border-radius:50%; animation:figma-spin .8s linear infinite; }
.figma-button__label { min-width:0; }
@keyframes figma-spin { to { transform:rotate(360deg); } }
