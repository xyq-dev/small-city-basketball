<view class="figma-feedback figma-feedback--{{type}}" role="{{type==='error' ? 'alert' : 'status'}}"><view class="figma-feedback__mark" aria-hidden="true"/><view class="figma-feedback__copy"><view class="figma-feedback__title">{{title}}</view><view wx:if="{{body}}" class="figma-feedback__body">{{body}}</view></view><button wx:if="{{actionLabel}}" class="figma-feedback__action" disabled="{{disabled}}" bindtap="action">{{actionLabel}}</button></view>
