.scb-header { width:100%; background:#fff; color:#132c49; position:relative; z-index:8; box-sizing:border-box; } .header-row { height:56px; width:100%; display:flex; align-items:center; padding:0 12px; position:relative; box-sizing:border-box; } .header-title { position:absolute; left:76px; right:76px; text-align:center; font-size:18px; line-height:28px; font-weight:700; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; pointer-events:none; } .header-location { display:flex; align-items:center; gap:3px; font-size:12px; line-height:20px; } .header-back,.header-search { width:44px; height:44px; min-height:44px; display:flex; align-items:center; justify-content:center; background:transparent; padding:0; margin:0; border:0; border-radius:0; } .header-search { margin-left:auto; } .header-back::after,.header-search::after { border:0; } .dark { color:#fff; background:transparent; } .dark .header-title { font-size:17px; } .header-back[disabled],.header-search[disabled] { background:transparent; opacity:.45; }
