.scb-header { width:100%; background:#fff; color:#123c73; position:relative; z-index:8; box-shadow:inset 0 -1px 0 #edf1f6; box-sizing:border-box; } .header-row { height:64px; width:100%; display:flex; align-items:center; gap:8px; padding:0 8px; position:relative; box-sizing:border-box; } .header-title { position:static; flex:1; min-width:0; text-align:left; font-size:16px; line-height:24px; font-weight:500; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; } .home-header .header-title { position:absolute; left:60px; right:96px; flex:none; } .header-location { display:flex; align-items:center; gap:3px; font-size:12px; line-height:20px; } .header-back,.header-search { width:44px; height:44px; min-height:44px; display:flex; align-items:center; justify-content:center; background:transparent; padding:0; margin:0; border:0; border-radius:0; } .header-search { margin-left:auto; } .header-back::after,.header-search::after { border:0; } .dark { color:#fff; background:transparent; } .dark .header-title { font-size:17px; } .header-back[disabled],.header-search[disabled] { background:transparent; opacity:.45; }
.header-row .header-back,.header-row .header-search { width:44px; margin:0; }
.header-row .header-search { margin-left:auto; }

.header-brand { display:flex; align-items:center; justify-content:center; width:44px; height:44px; } .header-brand-mark { width:24px; height:24px; } .home-header .header-title { left:60px; right:96px; text-align:left; font-size:18px; color:#18283f; }
