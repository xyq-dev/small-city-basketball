.scb-ui-page,
.scb-ui-page view,
.scb-ui-page button,
.scb-ui-page input,
.scb-ui-page textarea,
.scb-ui-page image,
.scb-ui-page scroll-view {
  box-sizing: border-box;
}

.scb-ui-page {
  min-height: 100vh;
  background: #f4f6fa;
  color: #18283f;
  font-family: "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  width: auto;
  min-height: 44px;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: inherit;
  text-align: inherit;
}

button::after {
  border: 0;
}

button[disabled] {
  background: transparent;
  color: inherit;
  opacity: 1;
}

.scb-ui-content {
  width: 100%;
  max-width: 600px;
  margin: 0 auto;
  padding: 16px;
  padding-bottom: calc(66px + env(safe-area-inset-bottom));
}

.scb-ui-content--actions {
  padding-bottom: calc(122px + env(safe-area-inset-bottom));
}

.scb-ui-section-title {
  color: #18283f;
  font-size: 18px;
  font-weight: 700;
  line-height: 26px;
}

.scb-ui-body {
  color: #18283f;
  font-size: 14px;
  font-weight: 400;
  line-height: 22px;
}

.scb-ui-caption {
  color: #51657d;
  font-size: 12px;
  font-weight: 400;
  line-height: 18px;
}

.scb-ui-fixed-actions {
  position: fixed;
  z-index: 30;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 8px 16px calc(8px + env(safe-area-inset-bottom));
  border-top: 1px solid #e6ebf2;
  background: #ffffff;
}

@media (max-width: 360px) {
  .scb-ui-content {
    padding-right: 12px;
    padding-left: 12px;
  }
}
