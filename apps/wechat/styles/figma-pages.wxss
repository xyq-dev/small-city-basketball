@import "./figma-system.wxss";

.figma-page {
  min-height: 100vh;
  background: #f4f6fa;
  color: #18283f;
  font-family: "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
  overflow-x: hidden;
}

.figma-page button {
  margin: 0;
}

.figma-page button::after {
  border: 0;
}

.figma-page__content {
  display: flex;
  width: 100%;
  max-width: 600px;
  margin: 0 auto;
  padding: 12px 16px 24px;
  flex-direction: column;
  gap: 12px;
}

.figma-page__content--actions {
  padding-bottom: calc(80px + env(safe-area-inset-bottom));
}

.figma-page__content--nav {
  padding-bottom: calc(66px + env(safe-area-inset-bottom));
}

.figma-summary {
  display: flex;
  width: 100%;
  min-height: 92px;
  align-items: center;
  gap: 12px;
  padding: 14px;
  border-radius: 16px;
  background: #ffffff;
  overflow: hidden;
}

.figma-summary--navy {
  background: #123c73;
  color: #ffffff;
}

.figma-summary__icon {
  display: flex;
  width: 44px;
  height: 44px;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: #eaf2fc;
}

.figma-summary--navy .figma-summary__icon {
  background: #ffffff;
}

.figma-summary__copy {
  min-width: 0;
  flex: 1;
}

.figma-eyebrow {
  color: #51657d;
  font-size: 11px;
  font-weight: 400;
  line-height: 16px;
}

.figma-title {
  width: 100%;
  margin-top: 3px;
  overflow: hidden;
  color: #18283f;
  font-size: 18px;
  font-weight: 700;
  line-height: 26px;
  text-overflow: ellipsis;
  overflow-wrap: anywhere;
}

.figma-summary--navy .figma-eyebrow,
.figma-summary--navy .figma-title,
.figma-summary--navy .figma-subtitle {
  color: #ffffff;
}

.figma-subtitle {
  margin-top: 2px;
  color: #51657d;
  font-size: 12px;
  font-weight: 400;
  line-height: 17px;
  overflow-wrap: anywhere;
}

.figma-section {
  display: flex;
  width: 100%;
  padding: 14px;
  flex-direction: column;
  gap: 8px;
  border-radius: 16px;
  background: #ffffff;
  overflow: hidden;
}

.figma-section__title {
  color: #18283f;
  font-size: 17px;
  font-weight: 700;
  line-height: 24px;
  overflow-wrap: anywhere;
}

.figma-section__hint,
.figma-row__subtitle,
.figma-caption {
  color: #51657d;
  font-size: 12px;
  font-weight: 400;
  line-height: 17px;
  overflow-wrap: anywhere;
}

.figma-page .figma-row {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 55px;
  align-items: center;
  gap: 8px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #18283f;
  text-align: left;
}

.figma-row + .figma-row {
  border-top: 1px solid #e6ebf2;
}

.figma-row__copy {
  min-width: 0;
  flex: 1;
}

.figma-row__title {
  color: #18283f;
  font-size: 14px;
  font-weight: 700;
  line-height: 20px;
  overflow-wrap: anywhere;
}

.figma-row__mark {
  width: 18px;
  height: 18px;
  flex: none;
  border: 1px solid #7c8ea5;
  border-radius: 50%;
  background: #ffffff;
}

.figma-row__mark.is-active {
  border: 5px solid #123c73;
}

.figma-status {
  flex: none;
  max-width: 112px;
  padding: 3px 7px;
  border-radius: 7px;
  background: #f4f6fa;
  color: #51657d;
  font-size: 11px;
  font-weight: 400;
  line-height: 16px;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.figma-status--orange {
  background: #fff1e2;
  color: #18283f;
}

.figma-status--green {
  background: #e5f7ee;
  color: #166b47;
}

.figma-status--error {
  background: #fdecef;
  color: #c83f42;
}

.figma-grid {
  display: grid;
  width: 100%;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.figma-page .figma-grid__item {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 84px;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 4px;
  padding: 10px;
  border-radius: 10px;
  background: #f4f6fa;
  color: #18283f;
  text-align: left;
}

.figma-field-group {
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: 6px;
}

.figma-field-label {
  color: #18283f;
  font-size: 14px;
  font-weight: 500;
  line-height: 22px;
}

.figma-field-control {
  width: 100%;
  min-height: 48px;
  padding: 0 12px;
  border: 1px solid #7c8ea5;
  border-radius: 12px;
  background: #ffffff;
  color: #18283f;
  font-size: 16px;
  line-height: 24px;
}

textarea.figma-field-control {
  height: 112px;
  padding-top: 12px;
  padding-bottom: 12px;
}

.figma-fixed-actions {
  position: fixed;
  z-index: 30;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  width: 100%;
  grid-template-columns: minmax(112px, 2fr) minmax(0, 3fr);
  gap: 8px;
  padding: 8px 16px calc(8px + env(safe-area-inset-bottom));
  border-top: 1px solid #e6ebf2;
  background: #ffffff;
}

.figma-fixed-actions--single {
  grid-template-columns: minmax(0, 1fr);
}

.figma-page .figma-action {
  display: flex;
  width: 100%;
  min-width: 0;
  height: 48px;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 16px;
  border-radius: 24px;
  font-size: 16px;
  font-weight: 500;
  line-height: 24px;
  text-align: center;
}

.figma-action--orange {
  background: #f28c28;
  color: #18283f;
}

.figma-action--navy {
  background: #123c73;
  color: #ffffff;
}

.figma-action--ghost {
  border: 1px solid #7c8ea5;
  background: #ffffff;
  color: #123c73;
}

.figma-page .figma-action[disabled] {
  border-color: #e6ebf2;
  background: #e6ebf2;
  color: #7c8ea5;
}

.figma-check {
  display: flex;
  width: 100%;
  min-height: 44px;
  align-items: flex-start;
  gap: 8px;
  color: #18283f;
  font-size: 13px;
  line-height: 20px;
}

.figma-check checkbox {
  width: 20px;
  height: 20px;
  flex: none;
  transform: none;
}

@media (max-width: 360px) {
  .figma-page__content {
    padding-right: 12px;
    padding-left: 12px;
  }

  .figma-section,
  .figma-summary {
    padding: 12px;
  }

  .figma-fixed-actions {
    padding-right: 12px;
    padding-left: 12px;
  }

  .figma-page .figma-action {
    padding-right: 8px;
    padding-left: 8px;
  }
}
