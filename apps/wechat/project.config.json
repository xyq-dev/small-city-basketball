{
  "miniprogramRoot": "./",
  "projectname": "small-city-basketball",
  "description": "小城市篮球，赛事观赛、球队报名与球员预约",
  "appid": "touristappid",
  "compileType": "miniprogram",
  "setting": {
    "es6": true,
    "minified": true,
    "urlCheck": true
  },
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "test" },
      { "type": "suffix", "value": ".md" },
      { "type": "file", "value": "assets/approved-ui/court-night.jpg" },
      { "type": "file", "value": "assets/approved-ui/player-sample-a.jpg" },
      { "type": "file", "value": "assets/approved-ui/player-sample-b.jpg" },
      { "type": "file", "value": "assets/approved-ui/player-sample-a-hero.jpg" },
      { "type": "file", "value": "assets/approved-ui/player-sample-b-hero.jpg" }
    ]
  },
  "condition": {
    "miniprogram": {
      "list": [
        {
          "name": "Figma UI预览 · 首页",
          "pathName": "pages/home/index",
          "query": "uiPreview=figma",
          "scene": null
        },
        {
          "name": "Figma UI预览 · 我的游客",
          "pathName": "pages/account/index",
          "query": "uiPreview=figma&state=closed",
          "scene": null
        },
        {
          "name": "Figma UI预览 · 微信读取失败",
          "pathName": "pages/account/index",
          "query": "uiPreview=figma&state=unknown",
          "scene": null
        }
      ]
    }
  }
}
