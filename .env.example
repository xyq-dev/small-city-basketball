# Local development placeholders only. Replace passwords before use; never commit .env.
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://scb:replace-with-a-random-local-password@127.0.0.1:5432/small_city_basketball
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
PORT=3000
VITE_DATA_MODE=api
API_PROXY_TARGET=http://127.0.0.1:3000
DEV_SEED_PASSWORD=replace-with-your-own-demo-password

# Per-event software billing only. OFF preserves existing publication flows.
COMMERCE_MODE=OFF
# Providers remain disabled until actual operator-owned credentials are available.
WECHAT_MINI_LOGIN_ENABLED=false
WECHAT_PAY_ENABLED=false

# COS01: opt in only after configuring an existing private, never-versioned bucket.
# See docs/operations/tencent-cos.md. The default performs no COS requests.
SCB_MEDIA_STORAGE=DATABASE
# SCB_COS_BUCKET=your-private-bucket-with-appid
# SCB_COS_REGION=ap-guangzhou
# SCB_COS_PREFIX=scb-media/v1
# SCB_COS_SECRET_ID_FILE=/absolute/private/cos_secret_id
# SCB_COS_SECRET_KEY_FILE=/absolute/private/cos_secret_key
